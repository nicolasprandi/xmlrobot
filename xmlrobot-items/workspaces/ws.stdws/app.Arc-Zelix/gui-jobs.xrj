     <call_job job="tk_para_print_values_tips"/>
</job>

<job id="Edit Configuration" pri="10">
     <call_job job="tk_conf_edit"/>
</job>

<job id="Edit Configuration?">
     <call_job job="tk_conf_print_values_tips"/>
</job>

