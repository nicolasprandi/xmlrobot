<job id="1. Edit Parameters" tip="Edit the parameters">
      <create_file file="(file,project-exists)">yes</create_file>
      <call_job job="tk_para_edit"/>
      
</job>

<job id="2. &gt; Collect Zelix-Inputs ">
     
     <call_job job="core-operation-collect-zelix-inputs"/>
     
     <create_file file="(file,project-exists)">yes</create_file>
</job>



<job id="3. &gt; Open CONSOLE Zelix">
<call_job job="tk_para_read"/>
    <call_service job="Panorama-Dir-Activity-TERMINAL" explain="-&gt; OPEN TERMIAL" label=" ">
      <dir id="with">(dir,para_zelix_scripts)</dir>
    </call_service>   
    <ti>write eg reco.bat or recolib.bat</ti>    

</job>

<job id="4.  Delete Zelix-Outputs">
<call_job job="tk_para_read"/>
    <call_service job="Dir-Delete" explain="-&gt; OPEN TERMIAL" label=" ">
      <dir id="with">(dir,para_zelix_output)</dir>
    </call_service>       

</job>


  

<job id="5. &gt; Integrate Zelix-Outputs">
     
     <call_job job="core-operation-integrate-zelix-outputs"/>
     
    
</job>

<job id="Obfuriscation Info" pri="10">
     
  <call_job job="core-obfuriscation"/>
</job>

<job id="5. Distribute Zelix-Outputs to Server" role="hidden">
     
     <call_job job="core-distribute"/>
     
    
</job>
