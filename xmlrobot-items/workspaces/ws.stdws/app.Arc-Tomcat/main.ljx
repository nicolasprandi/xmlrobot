  <prop id="kong_in_type_rex">dir|file|prop</prop>
  <prop id="kong_in_id_rex">.*</prop>
  <prop id="kingkong_groups_flags">servicios</prop>

  <call_job job="kong"/>

</job>


<job id="is-running" role="hidden">
  
  <prop id="kong_in_type_rex">dir|file|prop</prop>
  <prop id="kong_in_id_rex">.*</prop>
  <prop id="kingkong_groups_flags">important</prop>

  <call_job job="kong"/>

</job>
