<job id="show-snippets" role="dev">

  <ti label="1(e:c) Insert User and Role">
    <ti type="file">(file,usersxml)</ti>
    <ti><![CDATA[<role rolename="manager"/>
    <user username="wallace" password="gromit" roles="manager"/>   
    ]]></ti>
    <ti><![CDATA[# groupadd tomcat
# useradd -g tomcat -d /opt/tomcat tomcat
# passwd tomcat   
    ]]></ti>    
    
    
  </ti>
  

  <ti label="2(e:c) Reload dynamic">
    <ti type="file">(file,contextxml)</ti>
    <ti><![CDATA[<Context reloadable="true">   
    ]]></ti>
    <ti><![CDATA[]]></ti>        
  </ti>
  
  <ti label="3(e:c) Scripts on Linux/Mac">
    <ti type="file">(file,contextxml)</ti>
    <ti><![CDATA[Funktioniert wahrscheinlich nicht:
<target name="startTomcat_DebugLinux" if="isLinux">
  <exec executable="gnome-terminal" spawn="true">
    <arg line="--window-with-profile=Tomcat --geometry=120x60 -e '${env.CATALINA_HOME}/bin/catalina.sh jpda run'" />
  </exec>
</target>

<target name="startTomcat_DebugMac" if="isMac">
  <exec executable="/usr/X11R6/bin/xterm" spawn="true">
    <arg  line="-geometry 180x65 -e ${env.CATALINA_HOME}/bin/catalina.sh jpda run" />
  </exec>
</target>    
    ]]></ti>
    <ti><![CDATA[]]></ti>        
  </ti>  
    
  <ti label="4(e:c) Linux: Setting JAVA_HOME (Terminal)">

    <ti><![CDATA[JAVA_HOME="usr/lib/jvm/java-1.7.0-openjdk-i386"
export JAVA_HOME    
    ]]></ti>
    <ti><![CDATA[or add this path to etc/environment
and restart linux!]]></ti>        
  </ti> 

</job>
