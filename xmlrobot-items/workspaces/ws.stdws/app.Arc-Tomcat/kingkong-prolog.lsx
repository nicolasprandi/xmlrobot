<file id="sh_shutdown" x="(dir,bin)shutdown.sh"/>
<prop id="srv_catalina" x="catalina"/>
<prop id="srv_startup" x="startup"/>
<prop id="srv_shutdown" x="shutdown"/>
<prop id="srv_digest" x="digest"/>
<file id="webxml" x="(dir,loc)conf(prop,fs)web.xml"/>
<file id="indexjsp" x="(dir,loc)webapps(prop,fs)ROOT(prop,fs)index.jsp"/>
<prop id="servicios" x="digest startup catalina"/>
<file id="usersxml" x="(dir,loc)conf(prop,fs)tomcat-users.xml"/>
<file id="contextxml" x="(dir,loc)conf(prop,fs)context.xml"/>
<file id="serverxml" x="(dir,loc)conf(prop,fs)server.xml"/>
<file id="catalinapolicy" x="(dir,loc)conf(prop,fs)catalina.policy"/>
<file id="loggingprops" x="(dir,loc)conf(prop,fs)logging.properties"/>
