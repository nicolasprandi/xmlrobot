<?xml version="1.0" ?>
<jobs>
<call_job job="prolog" />
<job id="encrypt-password" role="hidden">

  <file id="joe-in-store">(dir,memo)asdfj.xml</file> 
  <call_job job="go-joe-read"/>
  
  <tk label="Encrypt a password">
    <tk id="algo" label="Algorithm" type="sel" flag="nono" tip="The Algorigthm to be used, its something mathematical ;-)">
      <sel>MD2</sel>
      <sel>MD5</sel>
      <sel>sha1</sel>
    </tk>
    <tk id="password" flag="nono" label="Password" tip="This text is going to be encrypted"/>
  </tk>
  <file id="content">(dir,temp)xy.txt</file>
  
  <ant export="encrypted" level="info">
    <echo file="(file,content)">(prop,password)</echo>
    <checksum file="(file,content)" property="encrypted" algorithm="(prop,algo)"/>
    <delete file="(file,content)" />
  </ant>
  
  <ti label="Password Encryption">
    <ti label="Result:">(prop,encrypted)</ti>
    <ti label="Request:">(prop,algo) of '(prop,password)'</ti>
  </ti>


  <prop id="joe-in-regex">algo</prop> 
  <call_job job="go-joe-write"/> 
  
  </job>

</jobs>