<?xml version="1.0" ?>

<jobs>
<call_job job="prolog" />


<job id="generate-pro-selector" pri="10">

<call_job job="tk_run_read"/>



      <file id="appask" x="(dir,pro)psi-ask.xml"/>
<scan dir="(dir,run_customers_delivery)" out="(file,appask)"/>
      <ti type="file">(file,appask)</ti>
    
      <xslt 
          xml="(file,appask)" 
          out="(dir,pro)app-selector-gui.xml"
          xsl="(dir,app)delivery-apps.xsl"/>
     
     
      <ti type="file">(dir,pro)app-selector-gui.xml</ti>
</job>

