<!-- setting the default-values -->
<job id="tk_fut_default" role="hidden">
  <need default="regex">(prop,fut_type)</need>
  <need default="(dir,temp)">(dir,fut_dir)</need>
</job>


<!-- fut-core, make your changes here -->
<job id="tk_fut_core" role="hidden" tip="fut_: Tk Internal">

  <need default="">(prop,tk_fut_add_flag)</need>

  <tk label="Default Parameters/Future" 
      flag="(prop,tk_fut_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 


        
   <tk id="fut_futures"
        type="sel"  
        label="Future" 
        test_first="1"        
        tip="()()"
        flag="multi dynamo">
        <sel xlabel="">p1</sel>
        <sel xlabel="">p2</sel>
        <sel xlabel="">p3</sel>
        <sel xlabel="">p4</sel>
        <sel xlabel="">p5</sel>
        <sel xlabel="">p6</sel>
