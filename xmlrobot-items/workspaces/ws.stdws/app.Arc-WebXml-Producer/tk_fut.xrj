        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="fut_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,fut-sel2)"/>
        
    <tk 
      id="fut_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="fut_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="fut_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="fut_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="fut_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="fut_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_fut_edit" tip="fut_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,fut-data))">
      <!-- data exists already -->
      <prop id="tk_fut_add_flag" x="sum_only print"/>
      <call_job job="tk_fut_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_fut_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_fut_default"/>
  <!-- doing input -->
  <call_job job="tk_fut_core"/>
  
  <!-- writing data -->
  <call_job job="tk_fut_write"/>

</job>



<job id="tk_fut_print_values" tip="fut_: Prints the entered values" role="hidden">
  
  <call_job job="tk_fut_read"/>
  
  <call_job job="tk_fut_core">
    <prop id="tk_fut_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_fut_print_values_tips" tip="fut_: Prints values and tips" role="hidden">
  
  <call_job job="tk_fut_read"/>
  
  <call_job job="tk_fut_core">
    <prop id="tk_fut_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_fut_print_help" tip="fut_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_fut_core">
    <prop id="tk_fut_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_fut_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,fut-data)" />
    <prop id="joe-in-regex" x="(prop,fut-regex)" />
  </call_job>
  <call_job job="tk_fut_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_fut_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,fut-data)" />
    <prop id="joe-in-regex" x="(prop,fut-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_fut_clear"  tip="fut_: Clears the data" role="hidden">
  <delete file="(file,fut-data)"/>
</job>


</jobs>