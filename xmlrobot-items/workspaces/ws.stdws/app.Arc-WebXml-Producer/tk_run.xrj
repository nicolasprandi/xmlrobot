<!-- setting the default-values -->
<job id="tk_run_default" role="hidden">
    <need default="1">(prop,run_askoverwrite)</need>
    <need default="eclipse">(prop,run_action)</need>
    <need default="0">(prop,run_produce_css)</need>
    <need default="0">(prop,run_produce_services)</need>
    <need default="0">(prop,run_produce_serviceapps)</need>
    <need default="-">(prop,run_trans_garant)</need>
    <need default="0">(prop,run_db_selector)</need>
    
    
    
</job>


<!-- run-core, make your changes here -->
<job id="tk_run_core" role="hidden" tip="run_: Tk Internal">

  <need default="">(prop,tk_run_add_flag)</need>

  <tk label="Create WebWml" 
      flag="(prop,tk_run_add_flag)"
      tip="()x.()"> 

     <tk id="run_webapps" 
        type="sel" 
        label="()WebApps 2 produce()"
        test_first="1"                  
        tip="WebApps to include in production"
        flag="multi" 
        xml="(file,selector)"/>

    <tk type="sel"
        id="run_action"
        label="Aktion"
        test_first="1">
        <sel>eclipse</sel>
        <sel>tomcat</sel>
    </tk>
    
    <tk type="sel"
        id="run_trans_garant"
        label="Pwd &amp; TransportGuarantee"
        test_first="0"
        flag="nono"
        tip="Alles ausser [No Password at all] verlangt nach autentifizierung bzw eingabe eines passwortes fuer tomcat. NONE=keine transport guarantee. INTEGRAL=Unchanged-SSL Redirect CONFIDENTIAL=Unobserved/Unchanged-SSL Redirect. INTEGRAL am besten">
        <sel>CONFIDENTIAL</sel>
        <sel>INTEGRAL</sel>
        <sel>NONE</sel>
        <sel label="No Password at all">-</sel>
    </tk>    
    
    <tk type="msg" x="Global Database File Home" test_first="0"/>  
    <tk type="sel"
        id="run_db_selector"
        label="Db-Selector"
        test_first="1">
        <sel label="-none-">0</sel>
        <sel label="one">1</sel>
        <sel label="two">2</sel>
    </tk>    
    <tk id="run_db_add_one" 
        label="Db Selector one:"
        test_first="0"
        tip="db_dir='file:///var/www/formix.at/private/formixDd/' style='fs1' This textblock will be added to the parameter ExcentedCnf: CheckIn/Out Project:" 
        type="textblock"
        />   
    <tk id="run_db_add_two" 
        label="Db Selector two:"
        test_first="0"
        tip="style='fs1' db_dir='C:\wow1\db\' This textblock will be added to the parameter ExcentedCnf: CheckIn/Out Project:" 
        type="textblock"/>             
        -->       
    <!-- 
    <tk type="msg" x="Takeoff-File"/>        
    <tk id="run_takeoff_eclipse" 
        label="Takeoff-File Eclipse"
        test_first="0"
        tip="The takeoff-file to use in all webapps" 
        type="textblock"/>
    <tk id="run_takeoff_tomcat" 
        label="Takeoff-File Tomcat"
        test_first="0"
        tip="The takeoff-file to use in all webapps" 
        type="textblock"/>     
        -->   
        

    <tk type="msg" x="home-locations"/>    
    <tk id="run_eclipsews" 
        type="dir" 
        label="Eclipse Workspace"  
        flag="nono"   
        test_first="0"              
        tip="()()"/>   
        
    <tk id="run_tomcat_home" 
        type="dir" 
        label="Tomcat-Home-Dir"  
        flagx="nono"   
        test_first="0"              
        tip="()()"/>           

  <tk type="msg" x="Customers Delivery"/> 
    <tk id="run_customers_delivery" 
        type="dir" 
        label="Customers Delivery"  
        flagx="nono"   
        test_first="0"              
        tip="()()"/>   
                  
  <tk type="msg" x="css"/> 
          
    <tk id="run_produce_css" 
        type="bool" 
        label="Create Css-Files"  
        flagx="nono"   
        test_first="0"              
        tip="()Copys the css-resource-files to the server-app()"/> 
        
    <tk id="run_css_resources" 
        type="dir" 
        label="Css-Resources"  
        flagx="nono"   
        test_first="0"              
        tip="()Directory with css-files()"/>     
  <!--       
  <tk type="msg" x="Services"/> 
          
    <tk id="run_produce_services" 
        type="bool" 
        label="Create services.zip"  
        flagx="nono"   
        test_first="0"              
        tip="()Zips the content of the given folder and puts it in the web-app()"/> 
        
    <tk id="run_services_resources" 
        type="dir" 
        label="Service-Dir"  
        flagx="nono"   
        test_first="0"              
        tip="()Directory with service-scripts()"/>    
        
  <tk type="msg" x="ServiceApps"/> 
          
    <tk id="run_produce_serviceapps" 
        type="bool" 
        label="Create service_apps"  
        flagx="nono"   
        test_first="0"              
        tip="()Copys the files of the folder into the web-app()"/> 
        
    <tk id="run_serviceapps_resources" 
        type="dir" 
        label="ServiceApps-Dir"  
        flagx="nono"   
        test_first="0"              
        tip="()Directory with zipped service-apps()"/>                
        
  -->       
        
            
  <tk type="msg" x="Options"/>               
  <tk id="run_askoverwrite"
        type="bool"
        label="Ask when overwrite"       
      	test_first="0"       
        flag="nono"        
        tip="()Triggers to ask for every update of web.xml in the Eclipse-Workspace()"/>
    <!--    
    <tk id="run_file_read"
        type="file"  
      	label="File to read" 
        flag="nono"          
        tip="()This file will be read()"/> 
        
    <tk id="run_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
    <tk id="run_type"
        type="sel"  
        label="Selection 1" 
        x="text"
        test_first="0"        
        tip="()text versus regular expression; text will search for exaclty that defined search text, regex will apply the regular-expression syntax to search for a piece of text in the files()">
        <sel label="Text">text</sel>
        <sel label="Regular Expression">regex</sel>    
    </tk>            
         
    <tk id="run_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="run_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="run_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="run_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="run_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,run-sel2)"/>
        
    <tk 
      id="run_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="run_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="run_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="run_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="run_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="run_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_run_edit" tip="run_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,run-data))">
      <!-- data exists already -->
      <prop id="tk_run_add_flag" x="sum_only print"/>
      <call_job job="tk_run_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_run_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_run_default"/>
  <!-- doing input -->
  <call_job job="tk_run_core"/>
  
  <!-- writing data -->
  <call_job job="tk_run_write"/>

</job>



<job id="tk_run_print_values" tip="run_: Prints the entered values" role="hidden">
  
  <call_job job="tk_run_read"/>
  
  <call_job job="tk_run_core">
    <prop id="tk_run_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_run_print_values_tips" tip="run_: Prints values and tips" role="hidden">
  
  <call_job job="tk_run_read"/>
  
  <call_job job="tk_run_core">
    <prop id="tk_run_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_run_print_help" tip="run_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_run_core">
    <prop id="tk_run_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_run_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,run-data)" />
    <prop id="joe-in-regex" x="(prop,run-regex)" />
  </call_job>
  <call_job job="tk_run_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_run_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,run-data)" />
    <prop id="joe-in-regex" x="(prop,run-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_run_clear"  tip="run_: Clears the data" role="hidden">
  <delete file="(file,run-data)"/>
</job>


</jobs>