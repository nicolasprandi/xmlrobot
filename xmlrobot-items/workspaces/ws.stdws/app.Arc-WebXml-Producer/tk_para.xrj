<call_job job="prolog" />
<!-- setting the default-values -->
<job id="tk_para_default" role="hidden">

<need default="sys_project_setup">(prop,para_firstjob)</need>
<need default="1">(prop,para_header)</need>
<need default="0">(prop,para_footer)</need> 
  
  
</job>

<!-- para-core, make your changes here -->
<job id="tk_para_core" role="hidden" tip="para_: Tk Internal">

  <need default="">(prop,tk_para_add_flag)</need>

  <tk label="Default Parameters/Principal" 
      flag="(prop,tk_para_add_flag)"
      tip="()Bon Jour Parameters()"> 
    
                           
    <tk type="msg"
        x="Special Project"
        test_first="0"/> 

    <tk id="para_project_dir"
        type="text"
        label="Used Project Dir"
        tip="absolute directory"             
      	test_first="0"/>            
    <tk id="para_clone_project_dir_on"
        type="bool"
        label="Clone project dir"       
      	test_first="0"              
        tip="()Used Project Dir will be copied()"/>  
        
    <tk id="para_login"
        xtype="bool"
        label="Role"       
      	test_first="0"              
        tip="()Used Project Dir will be copied()"/>          
        
    <tk type="msg"
        x="Design"
        test_first="0"/> 

    <tk id="para_css"
