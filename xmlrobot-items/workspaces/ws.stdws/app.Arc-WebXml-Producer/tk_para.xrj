        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,para-sel2)"/>
        
    <tk 
      id="para_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="para_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="para_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="para_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="para_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="para_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_para_edit" tip="para_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,para-data))">
      <!-- data exists already -->
      <prop id="tk_para_add_flag" x="sum_only print"/>
      <call_job job="tk_para_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_para_add_flag" x="sum_only print"/>
    </otherwise>
  </choose>
  <call_job job="tk_para_default"/>
  <!-- doing input -->
  <call_job job="tk_para_core"/>
  
  <!-- writing data -->
  <call_job job="tk_para_write"/>

</job>



<job id="tk_para_print_values" tip="para_: Prints the entered values" role="hidden">
  
  <call_job job="tk_para_read"/>
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_para_print_values_tips" tip="para_: Prints values and tips" role="hidden">
  
  <call_job job="tk_para_read"/>
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_para_print_values_tips_all" tip="para_: Prints values and tips" role="hidden">
  
  <call_job job="tk_para_read"/>
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  
</job>

<job id="tk_para_print_help" tip="para_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_para_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,para-data)" />
    <prop id="joe-in-regex" x="(prop,para-regex)" />
  </call_job>
  <call_job job="tk_para_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_para_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,para-data)" />
    <prop id="joe-in-regex" x="(prop,para-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_para_clear"  tip="para_: Clears the data" role="hidden">
  <delete file="(file,para-data)"/>
</job>

