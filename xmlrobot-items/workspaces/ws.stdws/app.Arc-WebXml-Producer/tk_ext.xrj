<!-- setting the default-values -->
<job id="tk_ext_default" role="hidden">
  <need default="regex">(prop,ext_type)</need>
  <need default="(dir,temp)">(dir,ext_dir)</need>
</job>


<!-- ext-core, make your changes here -->
<job id="tk_ext_core" role="hidden" tip="ext_: Tk Internal">

  <need default="">(prop,tk_ext_add_flag)</need>

  <tk label="Default Parameters/Extended" 
      flag="(prop,tk_ext_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 

   
   <tk id="ext_ons"
        type="sel"  
        label="Ons" 
        test_first="1"        
        tip="()()"
        flag="multi dynamo"
        xml="(dir,app)sel-ons.xml">

                  
    </tk>  
    <tk id="ext_pro_check_string"
        type="textblock"
        label="Cnf: CheckIn/Out Project"
        tip="Parameters for Project CheckIn and CheckOut"               
      	test_first="0"        
        test_dyn="()(f,or,(f,has_flag,(f,vob,prop,ext_ons),mayCheckinProject),(f,has_flag,(f,vob,prop,ext_ons),mayCheckoutProject))()"/> 
        
     <tk id="ext_pro_load_string"
        type="textblock"
        label="Cnf: Down/Upload Proj-Zip"
        tip="Parameters for upload and download the project-zip"               
      	test_first="0"
        test_dyn="()(f,or,(f,has_flag,(f,vob,prop,ext_ons),mayUploadProject),(f,has_flag,(f,vob,prop,ext_ons),mayDownloadProject))()"/>   
        
        
     <tk id="ext_password_string"
        type="textblock"
        label="Cnf: Passwords"
        tip="Password Configuration"               
      	test_first="0"
        test_dyn="()(f,has_flag,(f,vob,prop,ext_ons),pwd)()"/>         
        
     <tk id="ext_passwords"
        type="textblock"
        label="Passwords"
        tip="Passwords separated with whitespace"               
      	test_first="0"
        test_dyn="()(f,has_flag,(f,vob,prop,ext_ons),pwd)()"/>  
        
     <tk id="ext_mediathek_string"
        type="textblock"
        label="Cnf: Mediathek"
        tip="Mediathek configuration"               
      	test_first="0"
        test_dyn="()(f,has_flag,(f,vob,prop,ext_ons),mediathek)()"/>                           
        
     <tk id="ext_runtime_string"
        type="textblock"
        label="Cnf: Runtimes"
        tip="maxJobRuntimeMs='' ... Maximal Job Runtime in Milliseconds"               
      	test_first="0"
        test_dyn="()(f,has_flag,(f,vob,prop,ext_ons),runtime)()"/>                         
        
     <tk id="ext_embedjs_string"
        type="textblock"
        label="Cnf: JavaScript Embed"
        tip="What to include in java-script html"               
      	test_first="0"
        test_dyn="()(f,has_flag,(f,vob,prop,ext_ons),embedjs)()"/>      
        
     <tk id="ext_mydata_string"
        type="textblock"
        label="Cnf: My Data"
        tip="Specifies the personal data in the project"               
      	test_first="0"
        test_dyn="()(f,has_flag,(f,vob,prop,ext_ons),mydata)()"/>    
        
     <tk id="ext_file_load_string"
        type="textblock"
        label="Cnf: Down/Upload Files"
        tip="Parameters for upload and downloading files"               
      	test_first="0"
        test_dyn="()(f,or,(f,has_flag,(f,vob,prop,ext_ons),uploadfiles),(f,has_flag,(f,vob,prop,ext_ons),downloadfiles))()"/>                       
    
     <tk id="ext_tk_string"
        type="textblock"
        label="Cnf: Tk"
        tip="Tk Configuration"               
      	test_first="0"
        test_dyn="()(f,has_flag,(f,vob,prop,ext_ons),tk)()"/>   
        
     <tk id="ext_interpreter_string"
        type="textblock"
        label="Cnf: Interpreter"
        tip="Interpreter Configuration"               
      	test_first="0"
        test_dyn="()(f,has_flag,(f,vob,prop,ext_ons),interpreter)()"/>  
        
     <tk id="ext_ws_string"
        type="textblock"
        label="Cnf: Workspace"
        tip="Workspace Configuration"               
      	test_first="0"
        test_dyn="()(f,has_flag,(f,vob,prop,ext_ons),ws)()"/>         
        
   <tk id="ext_ebits"
        type="sel"  
        label="Extended Bits" 
        test_first="0"        
        tip="()()"
        flag="multi"
        xml="(dir,app)sel-ebits.xml"/>                

    <!--    
    <tk id="ext_file_read"
        type="file"  
      	label="File to read" 
        flag="nono"          
        tip="()This file will be read()"/> 
        
    <tk id="ext_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
    <tk id="ext_type"
        type="sel"  
        label="Selection 1" 
        x="text"
        test_first="0"        
        tip="()text versus regular expression; text will search for exaclty that defined search text, regex will apply the regular-expression syntax to search for a piece of text in the files()">
        <sel label="Text">text</sel>
        <sel label="Regular Expression">regex</sel>    
    </tk>            
         
    <tk id="ext_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="ext_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="ext_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="ext_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="ext_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,ext-sel2)"/>
        
    <tk 
      id="ext_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="ext_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="ext_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="ext_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="ext_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="ext_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_ext_edit" tip="ext_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,ext-data))">
      <!-- data exists already -->
      <prop id="tk_ext_add_flag" x="sum_only print"/>
      <call_job job="tk_ext_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_ext_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_ext_default"/>
  <!-- doing input -->
  <call_job job="tk_ext_core"/>
  
  <!-- writing data -->
  <call_job job="tk_ext_write"/>

</job>



<job id="tk_ext_print_values" tip="ext_: Prints the entered values" role="hidden">
  
  <call_job job="tk_ext_read"/>
  
  <call_job job="tk_ext_core">
    <prop id="tk_ext_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_ext_print_values_tips" tip="ext_: Prints values and tips" role="hidden">
  
  <call_job job="tk_ext_read"/>
  
  <call_job job="tk_ext_core">
    <prop id="tk_ext_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_ext_print_help" tip="ext_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_ext_core">
    <prop id="tk_ext_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_ext_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,ext-data)" />
    <prop id="joe-in-regex" x="(prop,ext-regex)" />
  </call_job>
  <call_job job="tk_ext_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_ext_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,ext-data)" />
    <prop id="joe-in-regex" x="(prop,ext-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_ext_clear"  tip="ext_: Clears the data" role="hidden">
  <delete file="(file,ext-data)"/>
</job>


</jobs>