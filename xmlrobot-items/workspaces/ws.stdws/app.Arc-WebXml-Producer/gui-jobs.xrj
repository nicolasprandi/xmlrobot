<job id="Edit &amp; Run">
    <call_job job="generate-selector" />
     <call_job job="tk_run_edit"/>

     <call_job job="core-operation"/>

     <create_file file="(file,project-exists)">yes</create_file>
</job>

<job id="Edit &amp; Run?">
    <call_job job="generate-selector" />
    
    
   
  <call_job job="tk_run_print_values"/>
  <ti label=" " explain="Edit Run Parameters" type="call_job" job="tk_run_edit"/> 
  <ti xlabel=" " explain="See all tips" type="call_job" job="tk_run_print_values_tips" test="0"/>  

</job>

<job id="Edit Only">
    <call_job job="generate-selector" />
     <call_job job="tk_run_edit"/>

  <call_job job="tk_run_print_values_tips"/>
  <ti label=" " explain="Edit Run Parameters" type="call_job" job="tk_run_edit"/> 
  <ti xlabel=" " explain="See all tips" type="call_job" job="tk_run_print_values_tips" test="0"/>  
</job>

<job id="Run Only">


     <call_job job="core-operation"/>

     <create_file file="(file,project-exists)">yes</create_file>
</job>

<job id="List of webapps">
     <call_job job="appconf-see-all" />

</job>





