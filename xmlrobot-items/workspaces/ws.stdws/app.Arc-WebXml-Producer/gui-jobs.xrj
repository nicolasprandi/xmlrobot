<job id="Default-App-Conf" xrole="hidden">
  <create_file file="(file,project-exists)">yes</create_file>
  <call_job job="tk_para_print_values"/>
  <ti label=" " explain="Edit Principal Defaults" type="call_job" job="tk_para_edit"/>

  <call_job job="tk_ext_print_values"/>
  <ti label=" " explain="Edit Extended Defaults" type="call_job" job="tk_ext_edit"/>  

  <call_job job="tk_fut_print_values"/>
  <ti label=" " explain="Edit Future Defaults" type="call_job" job="tk_fut_edit"/>
    
  <ti xlabel=" " explain="See all tips" type="call_job" job="Default-App-Conf-Tips" test="1"/>
      
</job>

<job id="Default-App-Conf?" role="hidden">
  <create_file file="(file,project-exists)">yes</create_file>
  <call_job job="tk_para_print_values_tips"/>
  <ti label=" " explain="Edit Principal Defaults" type="call_job" job="tk_para_edit"/>

  <call_job job="tk_ext_print_values_tips"/>
  <ti label=" " explain="Edit Extended Defaults" type="call_job" job="tk_ext_edit"/>  

  <call_job job="tk_fut_print_values_tips"/>
  <ti label=" " explain="Edit Future Defaults" type="call_job" job="tk_fut_edit"/>
    
  <ti xlabel=" " explain="See all help" type="call_job" job="Default-App-Conf-Help" test="1"/>
      
</job>

<job id="Default-App-Conf-Help" role="hidden">
  <create_file file="(file,project-exists)">yes</create_file>
  <call_job job="tk_para_print_help"/>
  <ti label=" " explain="Edit Principal Defaults" type="call_job" job="tk_para_edit"/>

  <call_job job="tk_ext_print_help"/>
  <ti label=" " explain="Edit Extended Defaults" type="call_job" job="tk_ext_edit"/>  

  <call_job job="tk_fut_print_help"/>
  <ti label=" " explain="Edit Future Defaults" type="call_job" job="tk_fut_edit"/>
    
      
</job>
