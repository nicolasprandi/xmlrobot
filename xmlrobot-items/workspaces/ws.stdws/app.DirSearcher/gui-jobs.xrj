<job id="Edit &amp; Run">
     <call_job job="tk_para_edit"/>
     <call_job job="core-operation"/>
     <ti>Did run</ti>
     <create_file file="(file,project-exists)">yes</create_file>
</job>

<job id="Run">
     <!-- <call_job job="tk_para_edit"/> -->
     <call_job job="core-operation"/>
     <ti>Did run</ti>
     <create_file file="(file,project-exists)">yes</create_file>
</job>

<job id="Run?">
   <call_job job="tk_para_print_values_tips"/>
   <call_job job="tk_stat_print_values_tips"/>
</job>

<job id="Edit Parameters">
      <create_file file="(file,project-exists)">yes</create_file>
      <call_job job="tk_para_edit"/>
      
</job>

<job id="Edit Parameters?">
     <call_job job="tk_para_print_values_tips"/>
</job>

<job id="Edit Configuration" pri="10" role="hidden">
     <call_job job="tk_conf_edit"/>
</job>

<job id="Edit Configuration?">
     <call_job job="tk_conf_print_values_tips"/>
</job>

