<?xml version="1.0" ?>

<jobs>

<job id="core-operation" role="hidden">

  <call_job job="tk_para_read"/>
  <call_job job="tk_para_read"/>
    <ti_hr style="2"/>
  <dump_ti_all label="Greetings from core-operation" test="0"/>
  <create_file file="(file,project-exists)">yes</create_file>
  
  <prop id="stat_begin" x="(f,time,yyyyMMdd_HHmmss)"/>
  
  <dir id="starter" x="(dir,services)" />
  <choose>
    <when test="(f,or,(f,not,(f,exists_file,(file,scan))),(f,not,(prop,para_reuse_scan)))">
      <tp>Scanning directory ...</tp>
      <ti>Scanning directory ...</ti>
      <scan dir="(dir,para_dir)" 
            level_limit="(f,when,(f,has,prop,para_level_limit),(f,vob,prop,para_level_limit),999)"
            out="(file,scan)"
            field="level"
            flag="no_files"/>
    </when>
    <otherwise>
      <ti>Reusing scan.</ti>
    </otherwise>
  </choose>

  <ti type="file" label="Scan:" x="(file,scan)"/>
        
  
  
  <prop id="counter" x="0" />
  <prop id="found" x="0"/> 

  <ti label="Xpath">(prop,para_xpath)</ti>
  <prop id="p2" x="(f,try,(prop,para_xpath))"/>
  <ti label=" ">(f,html,b,o)(prop,p2)(f,html,b,c)</ti>
  
  <choose>
    <when test="(f,eq_text,(prop,para_style),xpath)">
      <prop id="p3" x="(prop,p2)"/>
    </when>
    
    <when test="(f,eq_text,(prop,para_style),starts_with)">
      <prop id="p3" x="dir//dir[starts-with(e:o)@rpath(e:s)(f,xpath_string,(prop,para_starts_with))(e:c)]"/>
    </when>   
    
    <when test="(f,eq_text,(prop,para_style),contains)">
      <prop id="p3" x="dir//dir[contains(e:o)@rpath(e:s)(f,xpath_string,(prop,para_starts_with))(e:c)]"/>
    </when>    
    
    <when test="(f,eq_text,(prop,para_style),contains_ignore_case)">
      <prop id="p3" x="dir//dir[contains(e:o)upper(e:o)@rpath(e:c)(e:s)upper(e:o)(f,xpath_string,(prop,para_starts_with))(e:c)(e:c)]"/>
    </when>       
    
    <otherwise>
      <ti>Unknown style (prop,para_style)</ti>
    </otherwise>
  </choose>
  
  <ti_break/>      
  
  <ti_hr/>
  
    <ti type="rec">
      <ti></ti>
      <ti>0</ti>
      <!-- <ti type="dir" xlabel=" " x="(dir,para_dir)(loop,scan,@ipath)"/>  -->
        <ti type="call_service"
            job="Goto-Panorama"
            explain="[ (f,substring_after,(dir,para_dir),(f,dir_of_dir,(dir,para_dir))) ]"
            >
            <dir id="with" x="(dir,para_dir)"/>
        </ti>      
                                                 
      <ti type="call_service" xlabel=" " 
          job="Goto-Panorama"
          explain="(dir,para_dir)" flag="wrap">
          <dir id="with" x="(dir,para_dir)"/>
      </ti>
        
    </ti> 
    <ti_hr style="2"/>
        
  <!-- <tx_style ti_border="1"/> -->  
  <loop id="scan" missing_strategy="empty" xml="(file,scan)" 
        xpath="(prop,p3)" flag="sys_debug">
    <prop id="counter" x="(f,add,1,(prop,counter))"/>
    <prop id="c1"></prop>
    <prop id="c2"></prop>
    <choose>
    <when test="(f,and,(loop,scan,exists?,@ipath),(loop,scan,exists?,@rpath))" flag="catch">
      <choose>
        <when test="(f,eq_num,(loop,scan,@level),2)">
          <prop id="c1">(f,html,b,o)</prop>
          <prop id="c2">(f,html,b,c)</prop> 
          <ti type="rec" test="(f,and,(loop,scan,exists?,@ipath),(loop,scan,exists?,@rpath))">
            <ti>(f,text,fill_left,,(f,sub,(loop,scan,@level),1),|)</ti>
            <ti>(f,sub,(loop,scan,@level),1)</ti>
            <ti type="call_service"  
                job="Goto-Panorama"
                explain="(prop,c1)(loop,scan,@rpath)(prop,c2)">
                <dir id="with" x="(dir,para_dir)(loop,scan,@ipath)"/>
            </ti>                                             

            <ti test="(f,eq_num,(loop,scan,@level),2)"
                 type="call_service"
                job="Goto-Panorama"        
                explain="[ (f,name_of_dir,(dir,para_dir)) ]">
                <dir id="with" x="(dir,para_dir)"/>
            </ti>
            <ti></ti>      
          </ti>               
        </when>
        <otherwise>
        
          <ti type="rec" test="(f,and,(loop,scan,exists?,@ipath),(loop,scan,exists?,@rpath))">
            <ti>(f,text,fill_left,,(f,sub,(loop,scan,@level),1),|)</ti>
            <ti>(f,sub,(loop,scan,@level),1)</ti>
            <ti type="call_service"  
                job="Goto-Panorama"
                explain="(prop,c1)(loop,scan,@rpath)(prop,c2)">
                <dir id="with" x="(dir,para_dir)(loop,scan,@ipath)"/>
            </ti>                                             
            <ti type="call_service" xlabel=" " 
                job="Goto-Panorama"
                test="(loop,scan,exists?,..,@ipath)"        
                explain="(loop,scan,..,@ipath)">
                <dir id="with" x="(dir,para_dir)(loop,scan,..,@ipath)"/>
            </ti>

            <ti></ti>      
          </ti>
                  
        </otherwise>
      </choose>
    
    </when>
    <otherwise>
      <ti type="rec">
      <ti></ti>
      <ti>0</ti>
      <!-- <ti type="dir" xlabel=" " x="(dir,para_dir)(loop,scan,@ipath)"/>  -->
        <ti type="call_service"
            job="Goto-Panorama"
            explain="[ (f,substring_after,(dir,para_dir),(f,dir_of_dir,(dir,para_dir))) ]"
            >
            <dir id="with" x="(dir,para_dir)"/>
        </ti>      
                                                 
      <ti type="call_service" xlabel=" " 
          job="Goto-Panorama"
          xtest="x"
          explain="(dir,para_dir)" flag="wrap">
          <dir id="with" x="(dir,para_dir)(loop,scan,@ipath)"/>
      </ti>
        
      </ti>    
    </otherwise>
    </choose>
    
    

    <prop id="found" x="1"/> 
    
    <!--
      <choose>
        <when test="1">
        </when>
        <when test="0">
        </when>
        <otherwise>
        </otherwise>
      </choose>
    -->     
  
  </loop>
  <ti flag="catch">Did find (prop,counter) record(f,plural,(prop,counter))</ti>
  <prop id="stat_end" x="(f,time,yyyyMMdd_HHmmss)"/>
  <prop id="stat_counter" x="(prop,counter)"/>  
  <call_job job="tk_stat_write" />
  <!-- 
  <ti label="Summary"/>
  <ti type="dir" x="(dir,services)" label="Eben"/>
  <ti type="file" x="(file,takeoff)" label="Dort"/>
  
  <throw>Good By</throw>             -->

</job>

