   <ti_hr/>
   <ti label=" " type="call_job" job="aspect-see-all" explain="See all aspects"/>
   
</job>



<job id="hook-aspect-view-end" role="hidden">
   
   <ti labelx="Ready:" type="call_job" job="??" explain="Go home again"/>
   

         
</job>

<job id="hook-gen-aspect-selector" role="hidden">

      
      <!--          <dump_ti/>
      <file id="appask" x="(dir,pro)psi-ask.xml"/>
      <ask what="apps" out="(file,appask)" style="natural"/>
      <ti type="file">(file,appask)</ti>
      -->
      <xslt 
          xml="(file,aspects)" 
          out="(dir,pro)aspect-selector-gui.xml">
                    <inline attribute="xsl"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet 
  version="1.0" 
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml"/>

<xsl:template match="/">
  <sels>
   <xsl:apply-templates select="//aspects/aspect"/>
  </sels>
</xsl:template>

<xsl:template match="aspect">
   <sel>
    <xsl:attribute name="label">
      <xsl:value-of select="@titel"/>
    </xsl:attribute>
   <xsl:value-of select="@row"/></sel>
</xsl:template>

</xsl:stylesheet>
  ]]></inline>       
      </xslt>
      <ti type="file" label="did update" x="(dir,pro)aspect-selector-gui.xml"/>
      
      <ti_hr/>
      <call_job job="??" />
</job>

<job id="hook-gen-user-selector" role="hidden">

      
      <!--  <dump_ti_all />
      <throw/>        <dump_ti/>
      <file id="appask" x="(dir,pro)psi-ask.xml"/>
      <ask what="apps" out="(file,appask)" style="natural"/>
      <ti type="file">(file,appask)</ti>
      -->
      <ti type="file">(dir,pro)myCheckApp/users.xml</ti>
      <xslt 
          xml="(dir,pro)myCheckApp/users.xml" 
          out="(dir,pro)user-selector-gui.xml">
                    <inline attribute="xsl"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet 
  version="1.0" 
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml"/>

<xsl:template match="/">
  <sels>
   <xsl:apply-templates select="//users/user"/>
  </sels>
</xsl:template>

<xsl:template match="user">
   <sel>
    <xsl:attribute name="label">
      <xsl:value-of select="@userid"/>
    </xsl:attribute>
   <xsl:value-of select="@row"/></sel>
</xsl:template>

</xsl:stylesheet>
  ]]></inline>       
      </xslt>
      <ti type="file" label="did update" x="(dir,pro)user-selector-gui.xml"/>
      
      <ti_hr/>
      <call_job job="??" />
</job>



