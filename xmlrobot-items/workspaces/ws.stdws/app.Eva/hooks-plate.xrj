<?xml version="1.0" ?>

<jobs>
<call_job job="prolog"/>


<job id="hook-plate-view-begin" role="hidden">

  <ti label="Gerichte"/>

</job>

<job id="hook-plate-details-end" role="hidden">

   <ti_hr/>
   <ti label=" " type="call_job" job="plate-see-all" explain="See all plates"/>
   
</job>



<job id="hook-plate-view-end" role="hidden">
   
 
   

         
</job>

<job id="hook-gen-plate-selector" role="hidden">

      
      <xslt 
          xml="(file,plates)" 
          out="(dir,pro)plate-selector-gui.xml">
                    <inline attribute="xsl"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet 
  version="1.0" 
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml"/>

<xsl:template match="/">
  <sels>
   <xsl:apply-templates select="//blocks/block/plate"/>
  </sels>
</xsl:template>

<xsl:template match="plate">
   <sel>
    <xsl:attribute name="label">
      <xsl:value-of select="@name"/>
      <xsl:text> - </xsl:text>
      <xsl:value-of select="../@blockid"/>
    </xsl:attribute>
   <xsl:value-of select="@row"/></sel>
</xsl:template>

</xsl:stylesheet>
  ]]></inline>       
      </xslt>
      <ti type="file" label="did update" x="(dir,pro)plate-selector-gui.xml"/>
      
      <ti_hr/>
      <call_job job="??" />
</job>

<job id="hook-gen-user-selector" role="hidden">

      
      <!--  <dump_ti_all />
      <throw/>        <dump_ti/>
      <file id="appask" x="(dir,pro)psi-ask.xml"/>
      <ask what="apps" out="(file,appask)" style="natural"/>
      <ti type="file">(file,appask)</ti>
      -->
      <ti type="file">(dir,pro)myCheckApp/users.xml</ti>
      <xslt 
          xml="(dir,pro)myCheckApp/users.xml" 
          out="(dir,pro)user-selector-gui.xml">
                    <inline attribute="xsl"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet 
  version="1.0" 
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml"/>

<xsl:template match="/">
  <sels>
   <xsl:apply-templates select="//users/user"/>
  </sels>
</xsl:template>

<xsl:template match="user">
   <sel>
    <xsl:attribute name="label">
      <xsl:value-of select="@userid"/>
    </xsl:attribute>
   <xsl:value-of select="@row"/></sel>
</xsl:template>

</xsl:stylesheet>
  ]]></inline>       
      </xslt>
      <ti type="file" label="did update" x="(dir,pro)user-selector-gui.xml"/>
      
      <ti_hr/>
      <call_job job="??" />
</job>



