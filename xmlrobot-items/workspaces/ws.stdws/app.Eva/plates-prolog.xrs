<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="plates">(dir,pro)plates.xml</file>
<when test="(f,not,(f,exists_file,(file,plates)))">
<create_file out="(file,plates)">&lt;plates/&gt;</create_file>
<i>Created: (file,plates)</i>
</when>
<prop id="plates_offset">./</prop>
<prop id="plates_offset_label"/>
<prop id="plates_offset_new_key">//</prop>
<prop id="plates_sort_attribute"/>
<prop id="plates_sort_number"/>
<prop id="plates_sort_ignore_case"/>
<prop id="plates_sort_desc"/>
<prop id="plates_where"/>
<prop id="plates_return_job">plate-see-all</prop>
</prolog>
