<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="tasks">(dir,pro)tasks.xml</file>
<when test="(f,not,(f,exists_file,(file,tasks)))">
<create_file out="(file,tasks)">&lt;tasks/&gt;</create_file>
<i>Created: (file,tasks)</i>
</when>
<prop id="tasks_offset">./</prop>
<prop id="tasks_offset_label"/>
<prop id="tasks_offset_new_key">//</prop>
<prop id="tasks_sort_attribute"/>
<prop id="tasks_sort_number"/>
<prop id="tasks_sort_ignore_case"/>
<prop id="tasks_sort_desc"/>
<prop id="tasks_where"/>
<prop id="tasks_return_job">task-see-all</prop>
</prolog>
