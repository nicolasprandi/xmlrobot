<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="tastes">(dir,pro)tastes.xml</file>
<when test="(f,not,(f,exists_file,(file,tastes)))">
<create_file out="(file,tastes)">&lt;tastes/&gt;</create_file>
<i>Created: (file,tastes)</i>
</when>
<prop id="tastes_offset">./</prop>
<prop id="tastes_offset_label"/>
<prop id="tastes_offset_new_key">//</prop>
<prop id="tastes_sort_attribute"/>
<prop id="tastes_sort_number"/>
<prop id="tastes_sort_ignore_case"/>
<prop id="tastes_sort_desc"/>
<prop id="tastes_where"/>
<prop id="tastes_return_job">taste-see-all</prop>
</prolog>
