<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="notes">(dir,pro)notes.xml</file>
<when test="(f,not,(f,exists_file,(file,notes)))">
<create_file out="(file,notes)">&lt;notes/&gt;</create_file>
<i>Created: (file,notes)</i>
</when>
<prop id="notes_offset">./</prop>
<prop id="notes_offset_label"/>
<prop id="notes_offset_new_key">//</prop>
<prop id="notes_sort_attribute"/>
<prop id="notes_sort_number"/>
<prop id="notes_sort_ignore_case"/>
<prop id="notes_sort_desc"/>
<prop id="notes_where"/>
<prop id="notes_return_job">note-see-all</prop>
</prolog>
