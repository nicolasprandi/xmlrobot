   -->
</job>



<job id="hook-block-view-end" role="hidden">
   
   <!-- 
   <ti type="rec" test="(f,role,admin)">
   <ti/><ti/>
   <ti label="Ready:" type="call_job" job="hook-gen-block-selector" explain="&gt;&gt; Update block-Selector for Gui"/>
   </ti>
   -->
</job>

<job id="hook-gen-block-selector" role="hidden">
      
      <!-- 
      <file id="appask" x="(dir,pro)psi-ask.xml"/>
      <ask what="apps" out="(file,appask)" style="natural"/>
      <ti type="file">(file,appask)</ti>
      -->
      <xslt 
          xml="(file,blocks)" 
          out="(dir,pro)block-selector-gui.xml">
                    <inline attribute="xsl"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet 
  version="1.0" 
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml"/>

<xsl:template match="/">
  <sels>
   <xsl:apply-templates select="//blocks/block"/>
  </sels>
</xsl:template>

<xsl:template match="block">
   <sel>
    <xsl:attribute name="label">
      <xsl:value-of select="@titel"/>
      <xsl:text> - </xsl:text>
      <xsl:value-of select="@blockid"/>
    </xsl:attribute>
   <xsl:value-of select="@blockid"/></sel>
</xsl:template>

</xsl:stylesheet>
  ]]></inline>       
      </xslt>
      <ti type="file" label="did update" x="(dir,pro)block-selector-gui.xml"/>
      
      <ti_hr/>
      <call_job job="??" />
</job>





