<?xml version="1.0" ?>

<jobs>
<call_job job="prolog"/>


<job id="hook-block-view-loop" role="hidden">
  <try_catch><try>
  
  <prop id="summi">Teller: </prop>
  <loop missing_strategy="empty" id="xx" xml="(file,blocks)" xpath="(prop,blocks_offset)block[@row='(loop,block_loop,@row)']/plate">
      <prop id="add">(loop,xx,@name)</prop>
      
         <prop id="summi">(prop,summi)(prop,add)</prop>
         
         <prop id="summi" test="(f,not,(f,eq_num,(loop,xx,#max),(loop,xx,#i)))">(prop,summi); </prop>
  </loop>
  <ti type="rec">
    <ti/>

    <ti flag="wrap">(prop,summi)</ti>
  </ti>
  </try><catch/></try_catch>
 

</job>

<job id="hook-block-view-begin" role="hidden">

  <ti label="Rezeptbuecher"/>

</job>

<job id="hook-block-details-end" role="hidden">
  <prop id="plates_offset">block[@row='(prop,block_key)']/</prop>
   <call_job job="plate-see-all"/>

   <ti_hr/>
   <ti label=" " type="call_job" job="block-see-all" explain="Alle Rezeptbloecke sehen ..."/>  
   <!-- 
   <dir id="homeblock">(dir,pro)block-data/(prop,block_blockid)/</dir>
   
   <choose>
    <when test="(f,guicontroller,general,is-web,)">
      <prop id="targetapp">Rezepte</prop>
    </when>
    <otherwise>
      <prop id="targetapp">Formix-Rezeptblock</prop>
    </otherwise>
   
   </choose>
   
      <call_app     app="(prop,targetapp)" 
                    job="??" 
                    pro_dir="(dir,homeblock)" 
