<need>(prop,block_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="block-read" />
<prop id="isAdd">0</prop>
<call_job job="block-editor" />
<call_job job="block-write" />
<ti align="right" x="Did update Block '(prop,block_name)'" />
<call_job job="block-see" />
</job><job role="hidden" id="block-del">
<need>(prop,block_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="block-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Block [ (prop,block_name) (prop,blocks_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,blocks)" where="(prop,blocks_offset)block[@row='(prop,block_key)']" />
<tp>Deleted (prop,block_name) #(prop,block_key)</tp>
<ti label="Did delete Block:" x="(f,html,bold,open)(f,html,bold,open)(prop,block_name)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="block-see-all" />
</job><job role="hidden" id="block-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Block(prop,blocks_offset_label)" />
<prop x="sum" id="blocks_tk_control" />
</when>
<otherwise>
<need>(prop,block_key)</need>
<prop id="label" x="Block [(prop,block_name)](prop,blocks_offset_label)" />
<prop x="sum_only" id="blocks_tk_control" />
</otherwise>
</choose>
<call_job job="block-tk" />
</job><job id="block-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="block-editor" />
<prop id="block_key">1</prop>
<when test="(f,not,(f,exists,prop,blocks_offset_new_key))">
<prop id="blocks_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,blocks)" sort="@row" number="@row" xpath="(prop,blocks_offset_new_key)block">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="block_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Block: #(prop,block_key)</i>
<call_job job="block-write" />
<ti align="right" x="Did add Block '(prop,block_name)'" />
<choose>
<when test="(f,has,prop,post_add_script_block)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_block)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="block-see" />
</otherwise>
</choose>
</job><job role="hidden" id="block-write">
<need>(prop,block_key) (prop,isAdd)</need>
<spirit act="open" id="blocks_spirit_tc" xml="(file,blocks)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,blocks_offset),/)">
<prop id="offset2" x="(f,substring,(prop,blocks_offset),0,(f,sub,(f,len,(prop,blocks_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,blocks_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="blocks_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;block row="(prop,block_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="blocks_spirit_tc" where="(prop,blocks_offset)block[@row='(prop,block_key)']" attribute="name" value="(f,vob,prop,block_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="blocks_spirit_tc" where="(prop,blocks_offset)block[@row='(prop,block_key)']" attribute="docu" value="(f,vob,prop,block_docu)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="blocks_spirit_tc" where="(prop,blocks_offset)block[@row='(prop,block_key)']" attribute="blockid" value="(f,vob,prop,block_blockid)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="blocks_spirit_tc" where="(prop,blocks_offset)block[@row='(prop,block_key)']" attribute="type" value="(f,vob,prop,block_type)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="blocks_spirit_tc" where="(prop,blocks_offset)block[@row='(prop,block_key)']" attribute="lokal" value="(f,vob,prop,block_lokal)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="blocks_spirit_tc" where="(prop,blocks_offset)block[@row='(prop,block_key)']" attribute="topic" value="(f,vob,prop,block_topic)" />
<spirit act="close" flag="save pretty" id="blocks_spirit_tc" />
</job></jobs>
