<?xml version="1.0" ?>

<jobs>

<call_job job="prolog"/>

<job id="configuration" role="hidden">

<ti label="Update of Gui Selectors"/>
<ti type="call_job" job="hook-gen-all-selector" explain="&gt;&gt; ALL"/>
  <ti type="call_job" job="hook-gen-block-selector" explain="&gt;&gt; Rezeptbuecher"/>


  <ti type="call_job" job="hook-gen-aspect-selector" explain="&gt;&gt; Aspekte"/>

   
  <ti type="call_job" job="hook-gen-person-selector" explain="&gt;&gt; Restaurants und Personen"/>
   
  <ti type="call_job" job="hook-gen-task-selector" explain="&gt;&gt; Aufgaben"/>
  
  <ti type="call_job" job="hook-gen-plate-selector" explain="&gt;&gt; Rezepte zur Verkostung"/>
  <!-- 
  <ti type="call_job" job="hook-gen-rezept-selector" explain="&gt;&gt; Rezepte zur verkostung"/>
  -->
  
  <call_job job="aspect-see-all" flag="catch"/>   

</job>
<job id="hook-gen-all-selector" role="hidden">
  <call_job job="hook-gen-block-selector"/>
  <call_job job="hook-gen-aspect-selector"/>
  <call_job job="hook-gen-person-selector"/>
  <call_job job="hook-gen-task-selector"/>
  <call_job job="hook-gen-plate-selector"/>
</job>
<job id="hook-gen-rezept-selector" role="hidden">

  <file id="coll">(dir,filetemp)collector.xml</file>
  <file id="scan">(dir,filetemp)scan.xml</file>
<create_file out="(file,coll)"><![CDATA[<?xml version="1.0" encoding="UTF-8"?><coll/>]]></create_file>

<quick_scan dir="(dir,pro)block-data/" xfield="md5 kb fn" out="(file,scan)" level_limit="2" />

 <loop id="bl" xml="(file,scan)" xpath="dir">
  <ti>(loop,bl,@rpath)</ti>
  <file id="look">(dir,pro)block-data/(loop,bl,@ipath)rezs.xml</file>
  <file id="coll2">(dir,filetemp)collector2.xml</file>
<create_file out="(file,coll2)"><![CDATA[<?xml version="1.0" encoding="UTF-8"?><block id="(x,(loop,bl,@rpath))"/>]]></create_file>
  
  <xml_update xflag="catch" how="append" with_what="root" what="(file,coll2)" with="(file,look)"/>
  <xml_update xflag="catch" how="append" xwith_what="root" what="(file,coll)" with="(file,coll2)"/>
 </loop>
 
 
      <xslt 
          xml="(file,coll)" 
          out="(dir,pro)rezept-selector-gui.xml">
                    <inline attribute="xsl"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet 
  version="1.0" 
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml"/>

<xsl:template match="/">
  <sels>
   <xsl:apply-templates select="//coll/block/rezs/rez"/>
  </sels>
</xsl:template>

<xsl:template match="rez">
   <sel>
    <xsl:attribute name="block">
      <xsl:value-of select="../../@id"/>
    </xsl:attribute>
            
    <xsl:attribute name="label">
      <xsl:value-of select="@bez"/>
      <xsl:text>-</xsl:text>
      <xsl:value-of select="../../@id"/>
    </xsl:attribute>
   <xsl:value-of select="../../@id"/> 
   <xsl:text>-</xsl:text>
   <xsl:value-of select="@row"/></sel>
</xsl:template>

</xsl:stylesheet>
  ]]></inline>       
      </xslt>
      <ti type="file" label="did update" x="(dir,pro)rezept-selector-gui.xml"/>
      
      <ti_hr/>
      <call_job job="??" /> 
 
<dump_ti/>
 </job>
