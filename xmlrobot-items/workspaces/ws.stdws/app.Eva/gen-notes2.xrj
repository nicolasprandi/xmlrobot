<need>(prop,note_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="note-read" />
<prop id="isAdd">0</prop>
<call_job job="note-editor" />
<call_job job="note-write" />
<ti align="right" x="Did update Note '(f,tk_sel_translate,(prop,note_aspect),(dir,pro)aspect-selector-gui.xml)'" />
<call_job job="note-see-all" />
</job><job role="hidden" id="note-del">
<need>(prop,note_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="note-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Note [ (f,tk_sel_translate,(prop,note_aspect),(dir,pro)aspect-selector-gui.xml) (prop,notes_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,notes)" where="(prop,notes_offset)note[@row='(prop,note_key)']" />
<tp>Deleted (f,tk_sel_translate,(prop,note_aspect),(dir,pro)aspect-selector-gui.xml) #(prop,note_key)</tp>
<ti label="Did delete Note:" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,note_aspect),(dir,pro)aspect-selector-gui.xml)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="note-see-all" />
</job><job role="hidden" id="note-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Note(prop,notes_offset_label)" />
<prop x="sum" id="notes_tk_control" />
</when>
<otherwise>
<need>(prop,note_key)</need>
<prop id="label" x="Note [(f,tk_sel_translate,(prop,note_aspect),(dir,pro)aspect-selector-gui.xml)](prop,notes_offset_label)" />
<prop x="sum_only" id="notes_tk_control" />
</otherwise>
</choose>
<call_job job="note-tk" />
</job><job id="note-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="note-editor" />
<prop id="note_key">1</prop>
<when test="(f,not,(f,exists,prop,notes_offset_new_key))">
<prop id="notes_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,notes)" sort="@row" number="@row" xpath="(prop,notes_offset_new_key)note">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="note_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Note: #(prop,note_key)</i>
<call_job job="note-write" />
<ti align="right" x="Did add Note '(f,tk_sel_translate,(prop,note_aspect),(dir,pro)aspect-selector-gui.xml)'" />
<choose>
<when test="(f,has,prop,post_add_script_note)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_note)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="note-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="note-write">
<need>(prop,note_key) (prop,isAdd)</need>
<spirit act="open" id="notes_spirit_tc" xml="(file,notes)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,notes_offset),/)">
<prop id="offset2" x="(f,substring,(prop,notes_offset),0,(f,sub,(f,len,(prop,notes_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,notes_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="notes_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;note row="(prop,note_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="notes_spirit_tc" where="(prop,notes_offset)note[@row='(prop,note_key)']" attribute="aspect" value="(f,vob,prop,note_aspect)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="notes_spirit_tc" where="(prop,notes_offset)note[@row='(prop,note_key)']" attribute="note" value="(f,vob,prop,note_note)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="notes_spirit_tc" where="(prop,notes_offset)note[@row='(prop,note_key)']" attribute="note_verbal" value="(f,vob,prop,note_note_verbal)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="notes_spirit_tc" where="(prop,notes_offset)note[@row='(prop,note_key)']" attribute="urteil" value="(f,vob,prop,note_urteil)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="notes_spirit_tc" where="(prop,notes_offset)note[@row='(prop,note_key)']" attribute="grund" value="(f,vob,prop,note_grund)" />
<spirit act="close" flag="save pretty" id="notes_spirit_tc" />
</job></jobs>
