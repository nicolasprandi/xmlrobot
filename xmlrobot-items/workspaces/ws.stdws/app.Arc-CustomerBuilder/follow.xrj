<?xml version="1.0" ?>

<jobs>

<!-- <call_job job="prolog" />   <call_job job="tk_base_read"/> -->

<job id="follow_job_name" role="hidden">
  
  <file id="base-data" x="(dir,pro)base-data.xrs"/>
  <prop id="base-regex" x="base_.+"/>
 
  
  <dir id="the-customer-dd">(dir,base_delivery)</dir>
  <choose>
    <when test="(f,has,prop,custset_serial)">             
      <!-- nicht neu -->
      <dir id="the-customer-dd">(dir,the-customer-dd)(f,text,fill_left,(prop,custset_serial),5,0)-(f,text,filename,(prop,custset_name))</dir>
    </when>
    <otherwise>
      <!-- neu -->
      <dir id="the-customer-dd">(dir,the-customer-dd)(f,text,fill_left,(f,add,0,(f,sequence,serial)),5,0)-(f,text,filename,(prop,custset_name))</dir>      
    </otherwise>
  </choose>


  <when test="(f,not,(f,exists_dir,(dir,the-customer-dd)))">
    <mkdir dir="(dir,the-customer-dd)" />
    <ti label="CREATED" type="dir">(dir,the-customer-dd)</ti>
  </when>

</job>

