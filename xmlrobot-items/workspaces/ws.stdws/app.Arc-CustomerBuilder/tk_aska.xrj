  <call_job job="tk_aska_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_aska_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: aska_">
  <tk type="msg" x="Sure to clear data of aska_ ?" msg_type="w"/>
  <call_job job="tk_aska_clear"/>
</job>

<job id="Print Values:  aska_">
  <call_job job="tk_aska_print_values"/>
</job>
<job id="Print Help: aska_" role="dev">
  <call_job job="tk_aska_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_aska_edit" tip="aska_: Edit the Data" role="hidden">

  <!-- preparing -->
  <call_job job="aska-get-data" />
  <choose>
    <when test="(f,exists_file,(file,aska-data))">
      <!-- data exists already -->
      <prop id="tk_aska_add_flag" x="sum_only print"/>
      <call_job job="tk_aska_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_aska_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_aska_default"/>
  <!-- doing input -->
  <call_job job="tk_aska_core"/>
  
  <!-- writing data -->
  <call_job job="tk_aska_write"/>

</job>



<job id="tk_aska_print_values" tip="aska_: Prints the entered values" role="hidden">
  
  <call_job job="tk_aska_read"/>
  
  <call_job job="tk_aska_core">
    <prop id="tk_aska_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_aska_print_values_tips" tip="aska_: Prints values and tips" role="hidden">
  
  <call_job job="tk_aska_read"/>
  
  <call_job job="tk_aska_core">
    <prop id="tk_aska_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_aska_print_help" tip="aska_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_aska_core">
    <prop id="tk_aska_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_aska_read" role="hidden">
<call_job job="aska-get-data" />
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,aska-data)" />
    <prop id="joe-in-regex" x="(prop,aska-regex)" />    
  </call_job>
  <call_job job="tk_aska_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_aska_write" role="hidden">
  <call_job job="aska-get-data" />
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,aska-data)" />
    <prop id="joe-in-regex" x="(prop,aska-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_aska_clear"  tip="aska_: Clears the data" role="hidden">
  <call_job job="aska-get-data" />
  <delete file="(file,aska-data)"/>
</job>

<job id="aska-get-data" role="hidden">

<file id="aska-data" x="(dir,pro)aska-data-(prop,custset_product).xrs"/>

</job>


</jobs>