<!-- setting the default-values -->
<job id="tk_aska_default" role="hidden">
 
  <need default="1">(prop,aska_p1_intro)</need>
  <need default="1">(prop,aska_p2_intro)</need>
  <need default="1">(prop,aska_p2_std)</need>
  <need default="1">(prop,aska_p2_indiv)</need>
  <need default="1">(prop,aska_p3_intro)</need>
  <need default="1">(prop,aska_p3_review)</need>
  <need default="1">(prop,aska_p4_intro)</need>
  <need default="1">(prop,aska_p4_libs)</need>
  
</job>


<!-- aska-core, make your changes here -->
<job id="tk_aska_core" role="hidden" tip="aska_: Tk Internal">

  <need default="1">(prop,do-aska-p1)</need>
  <need default="1">(prop,do-aska-p2)</need>
  <need default="1">(prop,do-aska-p3)</need>
  <need default="1">(prop,do-aska-p4)</need>
  
  <need default="">(prop,tk_aska_add_flag)</need>

  <tk label="Asking Questions during Product-Build" 
      flag="(prop,tk_aska_add_flag)"
      tip="()x()"> 
      
    <tk type="msg"
        x="Application Builder (e:o)P1(e:c)"
        test="(prop,do-aska-p1)"
        test_first="0"/> 
    <tk id="aska_p1_intro"
        type="bool"
        label="Phase Intro"
        flag="no_is_0"     
        tip="()Intro für den AppBuilder dieser Arc-CustomerBuilder-App()"
        test="(prop,do-aska-p1)"
        test_first="0"/>           
        
    <tk type="msg"
        x="Compile (e:o)P2(e:c)"
        test="(prop,do-aska-p2)"
        test_first="0"/>  
    <tk id="aska_p2_intro"
        type="bool"
        label="Phase Intro"
        flag="no_is_0"     
        tip="()Intro für den Compiler dieser Arc-CustomerBuilder-App()"
        test="(prop,do-aska-p2)"
        test_first="0"/>           
    <tk id="aska_p2_std"
        type="bool"
        label="All Libs (e:o)Download &amp; Extract(e:c)"
        flag="no_is_0"     
        tip="()Standard Compile-Parameter: Download Material, Java-Sources, Libs; Extract Libs; Package, Build()"
        test="(prop,do-aska-p2)"
        test_first="0"/>     
        
    <tk id="aska_p2_indiv"
        type="bool"
        label="Individual Java-Source-Updates (e:o)reco-core(e:s)echnaton(e:s)echnaton-web(e:s)echnaton-lib(e:s)echnaton-hibiscus(e:c)"
        flag="no_is_0"     
        tip="()()"
        test="(prop,do-aska-p2)"
        test_first="0"/>        
        
    <tk type="msg"
        x="Obfuriscate (e:o)P3(e:c)"
        test="(prop,do-aska-p3)"
        test_first="0"/>  
        
    <tk id="aska_p3_intro"
        type="bool"
        label="Phase Intro"
        flag="no_is_0"     
        tip="()Intro für den Java-Obfuriscator dieser Arc-CustomerBuilder-App()"
        test="(prop,do-aska-p3)"
        test_first="0"/>          
        
    <tk id="aska_p3_review"
        type="bool"
        label="Review Zelix-Script"
        flag="no_is_0"     
        tip="()()"
        test="(prop,do-aska-p3)"
        test_first="0"/>          
        
    <tk type="msg"
        x="Finalize (e:o)P4(e:c)"
        test="(prop,do-aska-p4)"
        test_first="0"/>  
        
    <tk id="aska_p4_intro"
        type="bool"
        label="Phase Intro"
        flag="no_is_0"     
        tip="()Intro für den Finalizing dieser Arc-CustomerBuilder-App()"
        test="(prop,do-aska-p4)"
        test_first="0"/>     
        
    <tk id="aska_p4_libs"
        type="bool"
        label="Rebuild Libs"
        flag="no_is_0"     
        tip="()()"
        test="(prop,do-aska-p4)"
        test_first="0"/>                              
        
 
                          
  </tk>   
</job>
