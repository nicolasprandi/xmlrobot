</catch>
</try_catch>
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Arcadia-Compilation(prop,compis_offset_label)" />
<prop x="sum" id="compis_tk_control" />
</when>
<otherwise>
<need>(prop,compi_key)</need>
<prop id="label" x="Arcadia-Compilation [(f,text,cut_nice,(f,tk_sel_translate,(prop,compi_compilation),(dir,pro)current-compi-compile-selection.xml),50)](prop,compis_offset_label)" />
<prop x="sum_only" id="compis_tk_control" />
</otherwise>
</choose>
<call_job job="compi-tk" />
</job><job id="compi-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="compi-editor" />
<prop id="compi_key">1</prop>
<when test="(f,not,(f,exists,prop,compis_offset_new_key))">
<prop id="compis_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,compis)" sort="@row" number="@row" xpath="(prop,compis_offset_new_key)compi">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="compi_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Arcadia-Compilation: #(prop,compi_key)</i>
<call_job job="compi-write" />
<ti align="right" x="Did add Arcadia-Compilation '(f,text,cut_nice,(f,tk_sel_translate,(prop,compi_compilation),(dir,pro)current-compi-compile-selection.xml),50)'" />
<choose>
<when test="(f,has,prop,post_add_script_compi)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_compi)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="compi-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="compi-write">
<need>(prop,compi_key) (prop,isAdd)</need>
<spirit act="open" id="compis_spirit_tc" xml="(file,compis)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,compis_offset),/)">
<prop id="offset2" x="(f,substring,(prop,compis_offset),0,(f,sub,(f,len,(prop,compis_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,compis_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="compis_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;compi row="(prop,compi_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="compis_spirit_tc" where="(prop,compis_offset)compi[@row='(prop,compi_key)']" attribute="compilation" value="(f,vob,prop,compi_compilation)" />
<spirit act="close" flag="save pretty" id="compis_spirit_tc" />
</job></jobs>
