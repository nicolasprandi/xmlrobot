<need>(prop,compi_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="compi-read" />
<prop id="isAdd">0</prop>
<call_job job="compi-editor" />
<call_job job="compi-write" />
<ti align="right" x="Did update Arcadia-Compilation '(f,text,cut_nice,(f,tk_sel_translate,(prop,compi_compilation),(dir,pro)current-compi-compile-selection.xml),50)'" />
<call_job job="compi-see" />
</job><job role="hidden" id="compi-del">
<need>(prop,compi_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="compi-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Arcadia-Compilation [ (f,text,cut_nice,(f,tk_sel_translate,(prop,compi_compilation),(dir,pro)current-compi-compile-selection.xml),50) (prop,compis_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,compis)" where="(prop,compis_offset)compi[@row='(prop,compi_key)']" />
<tp>Deleted (f,text,cut_nice,(f,tk_sel_translate,(prop,compi_compilation),(dir,pro)current-compi-compile-selection.xml),50) #(prop,compi_key)</tp>
<ti label="Did delete Arcadia-Compilation:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(f,tk_sel_translate,(prop,compi_compilation),(dir,pro)current-compi-compile-selection.xml),50)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="compi-see-all" />
</job><job role="hidden" id="compi-editor">
<try_catch>
<try>
<call_job job="hook_compi_editor_begin" />
</try>
<catch>
