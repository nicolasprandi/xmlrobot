<!-- edit data: read, userinput, write -->
<job id="tk_base_edit" tip="base_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,base-data))">
      <!-- data exists already -->
      <prop id="tk_base_add_flag" x="sum_only print"/>
      <call_job job="tk_base_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_base_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_base_default"/>
  <!-- doing input -->
  <call_job job="tk_base_core"/>
  
  <!-- writing data -->
  <call_job job="tk_base_write"/>

</job>



<job id="tk_base_print_values" tip="base_: Prints the entered values" role="hidden">
  
  <call_job job="tk_base_read"/>
  
  <call_job job="tk_base_core">
    <prop id="tk_base_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_base_print_values_tips" tip="base_: Prints values and tips" role="hidden">
  
  <call_job job="tk_base_read"/>
  
  <call_job job="tk_base_core">
    <prop id="tk_base_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_base_print_help" tip="base_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_base_core">
    <prop id="tk_base_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_base_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,base-data)" />
    <prop id="joe-in-regex" x="(prop,base-regex)" />    
  </call_job>
  <call_job job="tk_base_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_base_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,base-data)" />
    <prop id="joe-in-regex" x="(prop,base-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_base_clear"  tip="base_: Clears the data" role="hidden">
  <delete file="(file,base-data)"/>
</job>


</jobs>