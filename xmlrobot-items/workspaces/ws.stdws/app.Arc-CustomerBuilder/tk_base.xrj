<!-- gui Adapters: to copy in the app  take the edit to your gui.... -->





<!-- setting the default-values -->
<job id="tk_base_default" role="hidden">
  <!--
  <need default="regex">(prop,base_type)</need>
  <need default="(dir,filetemp)">(dir,base_dir)</need>
  -->
  <need default="Arcadia">(prop,base_appid_arcadia)</need>
  <need default="Arc-App-Dark">(prop,base_appid_appdark)</need>
  <need default="file:///C:/delivery/">(dir,base_delivery)</need>
  <need default="20210101">(prop,base_default_final)</need>

</job>


<!-- base-core, make your changes here -->
<job id="tk_base_core" role="hidden" tip="base_: Tk Internal">

  <need default="">(prop,tk_base_add_flag)</need>

  <tk label="Configuration" 
      flag="(prop,tk_base_add_flag)"
      tip="()Hier werden die benutzen app-namen konfiguriert. sollten eigentlich fix sein. sicher ist sicher.()"> 
    <tk type="msg"
        x="Id of referenced applications"
        test_first="0"/>  
    <tk id="base_appid_arcadia"
        type="text"
        label="App Id of [Arcadia]"               
      	test_first="0"
        tip="()()" /> 
        
    <tk id="base_appid_appdark"
        type="text"
        label="App Id of [Arc-App-Dark]"               
      	test_first="0"
        tip="()()" />    
        
    <tk id="base_delivery"
        type="dir"
        label="Delivery Root"               
      	test_first="0"
        flag="nono"
        tip="()Das delivery verzeichnis()" /> 
        
    <tk id="base_default_final"
        type="text"
        label="Final-Date-Default"               
      	test_first="0"
        flag="nono"
        tip="()in YYYYMMDD 20200301; Der LETZTE Tag an dem die app funktioniert und davon der DEFAULT-WERT()"
        regex="()(?&lt;!\d)(?:(?:20\d{2})(?:(?:(?:0[13578]|1[02])31)|(?:(?:0[1,3-9]|1[0-2])(?:29|30)))|(?:(?:20(?:0[48]|[2468][048]|[13579][26]))0229)|(?:20\d{2})(?:(?:0?[1-9])|(?:1[0-2]))(?:0?[1-9]|1\d|2[0-8]))(?!\d)()" regex_msg="Das muss ein Datum im format JJJJMMTT sein." />                
        
            
        

