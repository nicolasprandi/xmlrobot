<job id="guided-setup-simple" tip="connecting to a existing database" role="hidden" pri="10">
    <need default="00">(prop,from-sender)</need>
    <prop id="guided-setup-job">guided-setup-simple</prop>
    <prop id="next-sender">(f,add,1,(prop,from-sender))</prop>
    <call_job job="tr_gs"/>
    <!-- 
    <ti label="from-sender">(prop,from-sender)</ti>
    <ti label="next-sender">(prop,next-sender)</ti>    -->
    <choose>
      <when test="(f,eq_num,0,(prop,from-sender))">
        <ti label="(prop,_ex_gs_setup_simple)"/>
        <ti flag="wrap">(prop,_ex_gs_follow)</ti>
      </when>
      <otherwise>
        <prop id="simple-ist-fertig">0</prop>
        <choose>
          <when test="(f,and,(prop,bpRepo),(prop,bpDb))">
              <prop id="simple-ist-fertig" test="(f,eq_num,(prop,next-sender),22)">1</prop>
          </when>      
          <when test="(prop,bpDb)">
              <prop id="simple-ist-fertig" test="(f,eq_num,(prop,next-sender),13)">1</prop>
          </when>     
          <when test="(prop,bpRepo)">
              <prop id="simple-ist-fertig" test="(f,eq_num,(prop,next-sender),22)">1</prop>
          </when>                                 
        </choose>
        <choose>
          <when test="(prop,simple-ist-fertig)">
            <ti label="(prop,_ex_gs_5_fertig)" />
            <ti>(prop,_ex_gs_5_liste):</ti>
            <call_job job="_objects"/>
            <ti_hr/>     
          
             <ti label="(prop,_ex_gs_5al)" type="call_job" job="_objects" xflag="label_right" explain="(prop,_ex_gs_5at)"/>
             <ti label="(prop,_ex_gs_5bl)" type="call_job" job="_search" explain="(prop,_ex_gs_5bt)"
                  />
             <ti label="(prop,_ex_gs_6bl)" type="call_job" job="_new_stat" explain="(prop,_ex_gs_6bt)"
                  test="(f,or,(f,right,stat),(f,right,clear))"/>
          </when>
          <otherwise>
            <ti label="(prop,_ex_gs_continue_simple) (prop,_ex_gs_next)"/>
    
            <ti_hr_break/>          
          </otherwise>
        
        </choose>
        <remove id="simple-ist-fertig" type="prop"/>
      </otherwise>
    </choose>
    
    
  <when test="(prop,bpDb)">  
  <when test="(f,lt_num,(prop,next-sender),13)">
    <ti>(f,html,b,o)(prop,_ex_gs_1)(f,html,b,c)</ti>
    <when test="(f,lt_num,(prop,next-sender),12)">
       <ti label="a(e:c) (f,html,i,o)(prop,_ex_gs_1cl)(f,html,i,c)" type="call_job" job="Db Conf" explain="(prop,_ex_gs_1ct)">
        <prop id="from-sender">11</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
       </ti>
       <ti label=" " type="ul">(prop,_ex_gs_1ct2)</ti>  
    </when>
    <when test="(f,lt_num,(prop,next-sender),13)">
       <ti label="b(e:c) (f,html,i,o)(prop,_ex_gs_1dl)(f,html,i,c)" type="call_job" job="-db-verify-" explain="(prop,_ex_gs_1dt)">
        <prop id="from-sender">12</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
       </ti>
       <ti label=" " type="ul">(prop,_ex_gs_1dt2)</ti>  
       <!-- 
       <ti label=" " type="ul">(prop,_ex_gs_1dt3)</ti>
       <ti label=" " type="ul">(prop,_ex_gs_1dt4)</ti>        -->
    
       <ti> </ti>
     </when>
  </when>
  </when>
  
  <when test="(prop,bpRepo)">
    <when test="(f,lt_num,(prop,next-sender),22)">
       <ti>(f,html,b,o)2. (prop,_ex_gs_2)(f,html,b,c)</ti>
       <when test="(f,lt_num,(prop,next-sender),21)">   
         <ti label="a(e:c) (f,html,i,o)(prop,_ex_gs_2al)(f,html,i,c)" type="call_job" job="Select Excel" explain="(prop,_ex_gs_2at)">
          <prop id="from-sender">20</prop>
          <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
         </ti>
         <ti label=" " type="ul">(prop,_ex_gs_2at2)</ti>
         <ti label=" " type="ul">(prop,_ex_gs_2at3)</ti>
         <ti label=" " type="file"  >(dir,app)vokabular.xls</ti>        
       </when>
       <when test="(f,lt_num,(prop,next-sender),22)"> 
         <ti label="b(e:c) (f,html,i,o)(prop,_ex_gs_2bl)(f,html,i,c)" type="call_job" job="Import Excel-Vokabular" explain="(prop,_ex_gs_2bt)">
          <prop id="from-sender">21</prop>
          <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
         </ti>
         <ti label=" " type="ul">(prop,_ex_gs_2bt2)</ti>
       </when> 
       <ti> </ti>
    </when>
    
        
  </when>


</job>

     
<job id="guided-setup" tip="setup a complete new database" role="hidden" pri="10">
    <need default="00">(prop,from-sender)</need>
    <need default="0">(prop,from-shortcut)</need>
    <prop id="guided-setup-job">guided-setup</prop>
    <prop id="next-sender">(f,add,1,(prop,from-sender))</prop>
    <!-- <ti>next-sender=(prop,next-sender)</ti> -->
    <call_job job="tr_gs"/>

    <choose>
      <when test="(f,eq_num,0,(prop,from-sender))">
        <ti label="(prop,_ex_gs_setup_full)"/>
        <ti flag="wrap">(prop,_ex_gs_follow)</ti>
      </when>
      <otherwise>
        
        <ti label="(prop,_ex_gs_continue) (f,when,(prop,from-shortcut), (e:o)(prop,_ex_gs_continue_shortcut)(e:c),) ... (prop,_ex_gs_next)"/>

        <ti_hr_break/>
      </otherwise>
    </choose>
    
   <when test="(f,lt_num,(prop,next-sender),13)">
     <ti test="(f,or,(f,lt_num,(prop,next-sender),11),(f,and,(prop,bpDb),(f,or,(f,lt_num,(prop,next-sender),12),(f,lt_num,(prop,next-sender),13))))">(f,html,b,o)(prop,_ex_gs_1)(f,html,b,c)</ti>
     
     <when test="(f,lt_num,(prop,next-sender),11)">
       <ti label="a(e:c) (f,html,i,o)(prop,_ex_gs_1al)(f,html,i,c)">(prop,_ex_gs_1at)</ti>

       <ti label="b(e:c) (f,html,i,o)(prop,_ex_gs_1bl)(f,html,i,c)" >(prop,_ex_gs_sc_2moeg):</ti>
              
       <ti label="(e:o)b1(e:c)" type="call_job" job="setup-define-database" explain="(prop,_ex_gs_1bt)" flag="label_right wrap">
        <prop id="from-sender">10</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
       </ti>
       
       <ti label=" " type="ul">(prop,_ex_gs_1bt2)</ti>
       <ti label=" " type="ul">(prop,_ex_gs_1bt3)</ti>
       
       <ti label="(prop,_ex_gs_sc_oder) (e:o)b2(e:c):" type="call_job" job="setup-define-database-shortcut" 
           explain="(prop,_ex_gs_sc_header)" flag="label_right wrap">
        <prop id="from-sender">10</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
       </ti>

       <ti label=" " type="ul">(prop,_ex_gs_sc_tip1)</ti>
       <ti label=" " type="ul">(prop,_ex_gs_sc_tip2)</ti>
              
    </when>
    
    <when test="(prop,bpDb)">
    <when test="(f,lt_num,(prop,next-sender),12)">
       <ti label="c(e:c) (f,html,i,o)(prop,_ex_gs_1cl)(f,html,i,c)" type="call_job" job="Db Conf" explain="(prop,_ex_gs_1ct)" flag="wrap">
        <prop id="from-sender">11</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
        <prop id="from-shortcut">(prop,from-shortcut)</prop>
       </ti>
       <ti label=" " type="ul">(prop,_ex_gs_1ct2)</ti>  
    </when>
    <when test="(f,lt_num,(prop,next-sender),13)">
       <ti label="d(e:c) (f,html,i,o)(prop,_ex_gs_1dl)(f,html,i,c)" type="call_job" job="-db-verify-" explain="(prop,_ex_gs_1dt)" flag="wrap">
        <prop id="from-sender">12</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
        <prop id="from-shortcut">(prop,from-shortcut)</prop>
       </ti>                                                             
       <ti label=" " type="ul">(prop,_ex_gs_1dt2)</ti>  
       <!-- 
       <ti label=" " type="ul">(prop,_ex_gs_1dt3)</ti>
       <ti label=" " type="ul">(prop,_ex_gs_1dt4)</ti>        -->
    
       <ti> </ti>
     </when>
  </when>
  </when>
  
  <when test="(prop,bpRepo)">
  <when test="(f,lt_num,(prop,next-sender),23)">
    <choose>
      <when test="(f,not,(prop,from-shortcut))">
        <ti>(f,html,b,o)2. (prop,_ex_gs_2)(f,html,b,c)</ti>
      </when>
      <otherwise>
        <when test="(f,lt_num,(prop,next-sender),22)">
          <ti>(f,html,b,o)2. (prop,_ex_gs_2)(f,html,b,c)</ti>
        </when>
      </otherwise>
    </choose>
    
     <when test="(f,lt_num,(prop,next-sender),21)">   
       <ti label="a(e:c) (f,html,i,o)(prop,_ex_gs_2al)(f,html,i,c)" type="call_job" job="Select Excel" 
          explain="(prop,_ex_gs_2at)" flag="wrap">
        <prop id="from-sender">20</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
        <prop id="from-shortcut">(prop,from-shortcut)</prop>
       </ti>
       <ti label=" " type="ul">(prop,_ex_gs_2at2)</ti>
       <ti label=" " type="ul">(prop,_ex_gs_2at3)</ti>
       <ti label=" " type="file"  >(dir,app)vokabular.xls</ti>
     </when>
     <when test="(f,lt_num,(prop,next-sender),22)"> 
       <ti label="b(e:c) (f,html,i,o)(prop,_ex_gs_2bl)(f,html,i,c)" type="call_job" job="Import Excel-Vokabular" 
          explain="(prop,_ex_gs_2bt)" flag="wrap">
        <prop id="from-sender">(f,when,(prop,from-shortcut),22,21)</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
        <prop id="from-shortcut">(prop,from-shortcut)</prop>
       </ti>
       <ti label=" " type="ul">(prop,_ex_gs_2bt2)</ti>
     </when> 
     <when test="(f,right,load)">
     <when test="(f,not,(prop,from-shortcut))">
     <when test="(f,lt_num,(prop,next-sender),23)">
      <ti type="call_job" job="run-etl-vok-byinst" label="c(e:c) (f,html,i,o)(prop,_ex_gs_4bt3B)(f,html,i,c)" 
        explain="(prop,_ex_gs_4bt3)"  flag="wrap">
        <prop id="from-sender">22</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
      </ti>
      <ti label=" " type="ul">(prop,_ex_gs_4bt3C)</ti>
      
     </when>
     </when>     
     </when>
     <ti> </ti>
     
  </when>
  </when>
  
  <when test="(f,right,load)">
  <when test="(f,not,(prop,from-shortcut))">
  <when test="(f,lt_num,(prop,next-sender),30)">
    
    <call_job job="tk_db_read_dbms">
      <prop id="ask-user-for-dbms">0</prop>
    </call_job>
    
    <ti>(f,html,b,o)3. (prop,_ex_gs_3)(f,html,b,c)</ti>
    <choose>
    
      <when test="(f,not,(f,has,prop,db_dbms))">
        <ti>(prop,_ex_gs_3_wait)</ti>
        <ti> </ti>
      </when>
      
      <otherwise>
      
       <ti label="a(e:c) (f,html,i,o)(prop,_ex_gs_3al)(f,html,i,c)" xtype="ul" x="(prop,_ex_gs_3at)"/>
       <ti label="b(e:c) (f,html,i,o)(prop,_ex_gs_4al)(f,html,i,c)" type="call_job" job="internal-kitchen-conf" explain="(prop,_ex_gs_4at)">
        <prop id="from-sender">30</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
       </ti>
       <ti label=" " type="ul">(prop,_ex_gs_4at2)</ti>
       <ti label=" " type="ul">(prop,_ex_gs_4at3)</ti> 
              
       <ti> </ti>      
      </otherwise>
    
    </choose>
        
  </when>
  <!-- <ti label="next-sender">(prop,next-sender)</ti>   -->
  <when test="(f,lt_num,(prop,next-sender),42)">   
   <ti>(f,html,b,o)4. (prop,_ex_gs_4)(f,html,b,c)</ti>
   
          
    <when test="(f,lt_num,(prop,next-sender),41)">    
      <ti type="call_job" job="run-etl-all-byinst" label="a(e:c) (f,html,i,o)(prop,_ex_gs_4bt4_td_load)(f,html,i,c)" explain="(prop,_ex_gs_4bt4)" >
        <prop id="from-sender">40</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
      </ti>
      <ti label=" " type="ul">(prop,_ex_gs_4bt4_td_info)</ti>      
    </when>
    
    <when test="(f,right,int)"> 
    <when test="(f,lt_num,(prop,next-sender),42)">        
      <ti type="call_job" job="do-the-integration" label="b(e:c) (f,html,i,o)(prop,_ex_gs_4bt5_merge)(f,html,i,c)" 
          explain="(prop,_ex_gs_4bt5)" flag="wrap">
        <prop id="from-sender">41</prop>
        <prop id="guided-setup-job">(prop,guided-setup-job)</prop>
        <tk label="(prop,_ex_gs_4bt5_close)">
        <tk type="msg">(prop,_ex_gs_4bt6)</tk>
        </tk>
      </ti>
   
  
   <!-- 
   </when>
    
   
   <when test="(f,lt_num,(prop,next-sender),43)">     -->

       <ti label=" " type="ul">(prop,_ex_gs_4bt)</ti>
       <ti label=" " type="ul">(prop,_ex_gs_4bt2)</ti>
             
       <ti> </ti>
    </when>
    </when>
    </when>
       
  </when>
  </when>
  
  <when test="(f,lte_num,(prop,next-sender),50)">  
  <ti>(f,html,b,o)5. (prop,_ex_gs_5)(f,html,b,c)</ti>     

   <ti label="(prop,_ex_gs_5al)" type="call_job" job="_objects" xflag="label_right" explain="(prop,_ex_gs_5at)"/>
   <ti label="(prop,_ex_gs_5bl)" type="call_job" job="_search" explain="(prop,_ex_gs_5bt)"
        />
   <ti label="(prop,_ex_gs_6bl)" type="call_job" job="_new_stat" explain="(prop,_ex_gs_6bt)"
        test="(f,or,(f,right,stat),(f,right,clear))"/>
  </when>
  
   
</job>



