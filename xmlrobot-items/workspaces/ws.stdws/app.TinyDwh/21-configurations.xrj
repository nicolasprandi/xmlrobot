<job id="Configuration-Paras-2" pri="10" role="hidden">
  

  <call_job job="tk_db_read_dbms"/>
  <choose>
    <when test="(f,not,(f,has,prop,db_dbms))">
      <prop id="dbms-to-print"></prop>
    </when>  
    <when test="(f,eq_text,(prop,db_dbms),maria)">
      <prop id="dbms-to-print">: MariaDb</prop>
    </when>
    <when test="(f,eq_text,(prop,db_dbms),mysql)">
      <prop id="dbms-to-print">: MySql</prop>
    </when>    
    <when test="(f,eq_text,(prop,db_dbms),postgres)">
      <prop id="dbms-to-print">: Postgres</prop>
    </when>       
    <otherwise>
