              flag="button" class="fb fbAsk" />
        </ti> 
       </when>         
    <when  test="(f,role,user)">>
    
      <ti type="menu">
          <ti type="call_job" job="vok-report-obj" explain="Stat: Obj" flag="button block" class="fb fbEdit cstat"/>
          <ti type="call_job" job="vok-report-attr" explain="Stat: Attr" flag="button" class="fb fbEdit cstat"/>
          <ti type="call_job" job="vok-report-bez" explain="Stat: Bez" flag="button" class="fb fbEdit cstat"/>  
      </ti>    
    
    </when>

  <ti label="(prop,_sl_conf_config_db_explain)(prop,dbms-to-print)"
      test="(f,or,(prop,bpDb),(f,right,stat))"/>
   

    <when test="(prop,bpDb)" >

        <ti type="menu">      
