<job id="_vokabular"  role="hidden">

 <call_job job="tk_para_read"/>
 <call_job job="tr_vokabulary"/>
 <choose>
 
  <when test="(f,not,(f,has,file,para_file_vok))">
    <ti label="(prop,_vok_problem)">(prop,_vok_novokdefined)</ti>
    <ti label="(prop,_vok_repair)" type="call_job" job="Select Excel"/>
  </when>
  <otherwise>
     <ti label="(prop,_vok_vok_files)"/>
     
      <ti type="file" label="(prop,_vok_excel_input_l)" x="(f,vob,file,para_file_vok)" test="(f,file_exists,(file,para_file_vok))"/>
      <ti             label="(prop,_vok_excel_input_l)" x="(prop,_vok_noexcel)" test="(f,not,(f,file_exists,(file,para_file_vok)))"/>
         
      <ti type="file" label="(prop,_vok_xml_vok_l)" x="(f,vob,file,vok)" test="(f,file_exists,(file,vok))"/>
      <ti             label="(prop,_vok_xml_vok_l):" x="(prop,_vok_noxml)" test="(f,not,(f,file_exists,(file,vok)))"/>
  

  </otherwise>
  </choose>


  <call_job job="vok-aktionen">
    <prop id="vok-aktionen-typ">1</prop>
  </call_job>

</job>   

<job id="vok-aktionen" xpri="10" role="hidden">
  <need>(prop,vok-aktionen-typ)</need>    <!--  1 = alle 3
                                                2 = letzten 2 
                                                3 = letzten -->
  <call_job job="tr_vokabulary"/>
  
  
  <prop id="had-aktionen-header">0</prop>
  

  
  <when test="(f,lte_num,(prop,vok-aktionen-typ),1)">   
      <when test="(f,not,(prop,had-aktionen-header))">
          <ti label="(prop,_vok_aktionen)"/>
          <prop id="had-aktionen-header">1</prop>
      </when>    
     <ti type="call_job" job="Select Excel" label="1. " flag="label_right" explain="(prop,_vok_select_excel_l)">
      <prop id="tk-para-edit-and-links">1</prop>
     </ti> 
  </when> 
  
  <when test="(f,lte_num,(prop,vok-aktionen-typ),2)">    
      <when test="(f,not,(prop,had-aktionen-header))">
          <ti label="(prop,_vok_aktionen)"/>
          <prop id="had-aktionen-header">1</prop>
      </when>   
     <ti type="call_job" job="Import Excel-Vokabular" label="2. " flag="label_right" explain="(prop,_vok_import_excel_l)">
      <prop id="import-excel-and-links">1</prop>
     </ti> 
     
  </when>   
                                                             
  <when test="(f,and,(f,lte_num,(prop,vok-aktionen-typ),3),(f,right,load))">     
      <when test="(f,not,(prop,had-aktionen-header))">
          <ti label="(prop,_vok_aktionen)"/>
          <prop id="had-aktionen-header">1</prop>
      </when>                                                  
      

            
      <ti type="call_job" job="vok-upload" label="3." explain="(prop,_vok_load_l)" flag="label_right">
        <!-- <file id="pentaho-job-to-run">(dir,app_pdi)job-LOAD-VOK.kjb</file> -->
      </ti> 
  </when>     
  
  <remove type="prop" id="had-aktionen-header"/>
 
</job>



