<?xml version="1.0" ?>
<jobs>
<call_job job="prolog"/>

<job id="_configurations_header2" role="hidden">
  <prop id="return-job">_configurations_header2</prop>
   

   <call_job job="-db-close-on-purpose-" />
  <call_job job="tr_dwi"/>
  <prop id="xblock"></prop>
  <prop id="xblock" test="(f,not,(f,implement,online))">block</prop>

  <choose>
  <when test="(f,exists_file,(dir,pro)icl.xrs)">
    <ti type="rec" >   
      <ti></ti>
                         
      <ti type="call_job" explain="(f,when,(f,eq_text,(f,interpreter,lang),de),Verbindung zur Db trennen,Disconnect from Db)" flxag="button"  job="stop-dbc-real">  
      <prop id="return-job">(f,vob,prop,return-job)</prop>
      </ti> 
    </ti>  
    <ti label="(prop,_dwi_last_int)"/>
    <remove type="file" id="integration-log" flag="catch" />
    <remove type="prop" id="explain-para" flag="catch" />
    
    <call_job job="go-joe-read">
      <file id="joe-in-store" x="(dir,pro)icl.xrs" />
      <prop id="joe-in-regex" x="integration-log|explain-para" />
    </call_job>  
    
    <when test="(f,has,file,integration-log)">
      <ti type="rec" xlabel="(prop,_dwi_int_log)">
        <ti type="call_job" job="see-log-file" explain="(prop,_dwi_see_log)" flag="button (prop,xblock)" class="fx"> 
          <file id="logging">(file,integration-log)</file>
        </ti>    
        <ti type="file" >(file,integration-log)</ti>
        <ti >(f,name_of_dir,(f,dir_of_file,(file,integration-log)))</ti>
      </ti>    
    </when>
    
    <when test="(f,has,prop,explain-para)">
    
      <ti xlabel="(prop,_dwi_expl_report)" type="rec">
        <ti type="call_job" job="see-explain" explain="(prop,_dwi_explain_expl)" flag="button (prop,xblock)" 
            class="fx fxAdd">
          <file id="explain-to-see">(prop,explain-para)</file>
        </ti>
        <ti type="file" >(prop,explain-para)</ti>  
        <ti >(f,name_of_dir,(f,dir_of_file,(prop,explain-para)))</ti>             
      </ti>
          
    </when>    
      
  </when> 
  <otherwise> 
  <call_job job="stop-dbc-gui"/>
 
  </otherwise>       
  </choose>
   
  <ti label="Integration" />   
  <ti type="rec"> 
    <ti type="call_job" job="_integrate"  flag="button (prop,xblock) "    
        explain="(prop,_dwi_integrate)"  class="fx fxEdit justgo" test="(f,right,int)"/>
  </ti>    

  <ti type="rec">

        <ti type="call_job" explain="Laufende Prozesse"  flag="button (prop,xblock)" 
            job="process-admin"
             class="fx redButton" />   

  </ti> 


  
   <when test="(prop,bpRebuild)">     
   <ti label="Parameter-Datei" />    
    <ti type="rec">
   
        <ti type="call_job" job="ipaxx-print"  flag="button  (prop,xblock)" explain="(f,when,(f,eq_text,(prop,ling),de),Speicherort der Parameter der Massen-Integration,Location of Full-Integration-Parameters)" 
              class="fx fxAdd" />     
   
     </ti>
     </when>  


 
  <ti label="Dies und Das" />   
                   
    <ti type="rec">
    
      <ti type="call_job" job="-db-request-import-return"   test="(f,right,import)"
          explain="(prop,_dwi_requ_import)"  class="fx fxAdd" flag="button  (prop,xblock)">
          <prop id="db-import-post-job">_dwh</prop>
      </ti>   
          
        
    </ti>
    
  <ti type="rec">
      <ti type="call_job" job="-db-giveback-import-return"  flag="button (prop,xblock)"   
          test="(f,right,import)"
          explain="(prop,_dwi_fin_import)"  class="fx fxAdd" >
          <prop id="db-import-post-job">_dwh</prop>
      </ti>          

  </ti>
  
   
<when test="(f,right,explain)">     
  <ti type="rec">
    <ti type="call_job" job="Explain-Report"  flag="button  (prop,xblock)" explain="Alten Explain-Bericht anzeigen" 
        class="fx fxAdd" />     
  </ti>
</when>   
