<job id="_configurations" role="hidden">

  <prop id="return-job">_configurations</prop>
   <call_job job="stop-dbc-gui"/>

   <call_job job="-db-close-on-purpose-" />
  
  <when test="(f,or,(prop,bpDb),(f,right,stat))">  
        <ti type="menu" >
        <ti type="call_job" explain="DBCI-Connectoren"  flag="button block" 
            job="_credits"
             class="fb " />     
     </ti> 
  </when>

  <when test="(f,and,(f,right,mymenu),(f,exists_file,(dir,pro)mysystem.xml))">
    <try_catch>
      <try>
        <prop id="turbo-antes">(f,interpreter,turbo)</prop>
        <interpreter turbo="0"/>
        <include file="(dir,pro)mysystem.xml"  />
        <interpreter turbo="(prop,turbo-antes)"/>      
        
      </try>
      <catch>
        <ti label="Problem with mysystem.xml"/>
        <ti label="Error:">(prop,catched_msg)</ti>
        <ti label="File" type="file">(dir,pro)myhome.xml</ti>
      </catch>
    </try_catch>
  
  </when>
        
  <prop id="techhead">(f,or,(f,right,index),(f,right,mv),(f,right,stat),(f,right,clear))</prop>

  <call_job job="tr_conf"/>

  
  <ti_break />
  <ti label="(prop,_sl_conf_main_interface)"/> 
  
    
  <ti type="menu" >
    <ti type="call_job" job="Nav Conf" flag="button block" class="fb fbEdit " explain="(prop,_sl_conf_conf_navi)" />
    <ti type="call_job" job="Nav Conf?" explain="(prop,_label_ask)"  
        flag="button" class="fb fbAsk"/>        
  </ti>        
  <ti type="menu">  
    <ti type="call_job" job="Limit Conf" flag="button block" class="fb fbEdit " explain="(prop,_sl_conf_conf_limits)" />
    <ti type="call_job" job="Limit Conf?" explain="(prop,_label_ask)" 
        flag="button" class="fb fbAsk"/>
  </ti>   
  
                        
   
  

  
 
  <call_job job="tr_first" />

  <call_job job="tr_setup" />  
         
  
  <when  test="(f,role,user)" >
  <ti label="(prop,_sl_conf_spec_gui)"/>
      
    <ti type="menu" test="(f,role,expert)">    
      <ti type="call_job" flag="button block"   class="fb fbEdit xjustgui justswitch"                       
          job="conf-swap-wide"  explain="(f,when,(f,exists_file,(dir,pro)gui/wideoff.txt),(prop,_sl_conf_widewrap_goon),(prop,_sl_conf_widewrap_gooff))">
      </ti>       
    </ti>        
    
  
    
    <ti type="menu">
    
      <ti test="(f,role,expert2)"
          type="call_job" flag="button block"   
          class="fb fbEdit xjustgui justswitch"                       
          job="conf-swap-allja" 
          explain="(f,when,(f,exists_file,(dir,pro)gui/allja.txt),(prop,_sl_conf_allja_goon),(prop,_sl_conf_allja_gooff))" >
      </ti> 
      <ti test="(f,not,(f,role,expert2))"
          type="call_job" flag="button block"   
          class="fb fbEdit xjustgui justswitch"                       
          job="conf-swap-allja" 
          explain="(f,when,(f,exists_file,(dir,pro)gui/allja.txt),(prop,_sl_conf_allja_goon_exp),(prop,_sl_conf_allja_gooff_exp))" >
      </ti>       
      
    </ti>      
  </when>
  <!-- <call_job job="conf-stat-intro" test="(f,role,user)"/>   -->

    
  <when test="(f,and,(f,right,dev),(f,role,expert))" >
    <ti_hr/>
    <ti label="(prop,_ex_dev_bulk)"/>
    <!--
    <ti label="(prop,_ex_dev_all)"/>
    <ti >(f,html,b,o)(prop,_ex_dev_bulk)(f,html,b,c)</ti>
    -->
    <ti label="(prop,_ex_dev_prop)" type="rec">
      <ti type="menu">
        <ti  type="call_job"                 
        job="bulk-create-all" explain="(prop,_fresh)" flag="button" class="fb fbEdit">
        <prop id="refresh-back-job">_configurations</prop>
    </ti>           
      </ti>
    </ti>   
    <!--
    <ti label="(prop,_ex_dev_prop)" type="call_job"                 
        job="bulk-create-all" explain="(prop,_fresh)" flag="button block" class="fx fxEdit">
        <prop id="refresh-back-job">_configurations</prop>
    </ti>          
    -->
        
    <ti label="(prop,_ex_dev_pub)" type="rec">
      <ti type="menu">
        <ti  type="call_job" flag="button"   class="fb fbEdit"              
            job="sqli-build-zeppelin" explain="(prop,_sl_conf_spec_zeppelin)">
        </ti>         
      </ti>
    </ti>   
    <ti label="(prop,_ex_dev_all)"/>
   <ti label="Warten" type="rec"> 
      <ti type="menu" >
        <ti type="call_job" explain="(prop,_ex_pid_explain)"  flag="button " 
            job="process-admin"
             class="fb redButton" />     
     </ti>    
     </ti>           
    <ti label="(prop,_ex_run_label)" type="rec">
      <ti type="menu">
      <!--
        <ti 
        type="call_job" 
        job="run-script-file" 
         class="fb fbEdit"  flag="button"
        explain="(prop,_ex_run_explain)" />           -->
        
        <ti 
        type="call_job" 
        job="run-script-file?" 
         class="fb fbEdit "  flag="button"         
        explain="(prop,_ex_run_explain)" />         
      </ti>
    </ti>    
    <ti label="(prop,_ex_dev_learn)" type="rec">
      <ti type="menu">
       <ti type="call_job" 
          job="dev-help" 
           class="fb fbAdd"  flag="button"
          explain="(prop,_ex_setup_snip)" />       
      </ti>
    </ti>   
    
  </when>
             
  <when test="(f,role,user)">
    <ti_hr/> 
    <when test="(f,or,(f,right,repo),(f,right,db),(f,right,dev),(f,right,ref),(f,right,ipr))" >
      <call_job job="Competence Center Conf?" />
    </when>  
      
    <call_job job="ps-privilegien" />
    
    

    <ti_hr/>
    <call_job job="Configuration-Paras-2"/>      
  </when>
  
  <ti_hr/>
  <call_job job="ps-sprachen" />
  <call_job job="ps-welcome" test="(f,not,(f,has,prop,conf-redo))"/>
  
  <when test="(f,role,user)">
    <call_job job="ps-install"  test="(f,not,(f,has,prop,conf-redo))"/>     
   </when>  
   
  <call_job job="ps-file-report"  test="(f,role,user)"/>  
    <ti_hr_break/>
     <ti type="menu" test="(f,role,expert)" >    
      <ti type="call_job" flag="button "   class="fb fbEdit xjustgui justswitch"                       
          job="conf-swap-pk"  explain="(f,when,(f,exists_file,(dir,pro)pk.txt),Turn Passwords On,Turn Passwords Off)">
      </ti>       
    </ti>     

     <ti type="menu" test="(f,role,expert)" >    
      <ti type="call_job" flag="button "   class="fb fbEdit xjustgui justswitch"                       
          job="conf-swap-dc"  explain="(f,when,(f,exists_file,(dir,pro)dc.txt),TURN db-purpose-close Off,TURN db-purpose-close ON)">
      </ti>       
    </ti>        
</job>
