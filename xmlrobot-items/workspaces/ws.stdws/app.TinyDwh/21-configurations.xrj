<job id="get-ddl" role="hidden">
  <need>(prop,get-ddl-dbms)</need>
  <tk type="msg">get-ddl recieves (prop,get-ddl-dbms)</tk>
  <prop id="get-ddl-dbms2">(prop,get-ddl-dbms)</prop>
  <tk id="get-ddl-dbms2" type="sel">
    <sel>postgres</sel>
    <sel>mysql</sel>
    <sel>maria</sel>
  </tk>
  <prop id="get-ddl-dbms">(prop,get-ddl-dbms2)</prop>
  <choose>
    <when test="(f,eq_text,postgres,(prop,get-ddl-dbms))">
      <prop id="ddl">()-- Copyright © 2023 Red-Shark-Formation. All rights reserved.
-- postgres
-- beziehungstypen
CREATE TABLE t_b (
                bez_typ smallint NOT NULL
);

-- objekttypen
CREATE TABLE t_o (
                obj_typ smallint NOT NULL,
                kopf_attr_typ smallint
);

-- attributtypen
CREATE TABLE t_a (
                attr_typ smallint NOT NULL,  
                final_typ smallint NOT NULL         
);

-- attribute usage    object x attribute
CREATE SEQUENCE t_u_seq;      
CREATE TABLE t_u (
                attr_usg_id INTEGER NOT NULL DEFAULT nextval('t_u_seq'),
                attr_typ smallint NOT NULL,
                obj_typ smallint NOT NULL,
                ident smallint  NOT NULL
);

-- objekt report
CREATE TABLE r_o (
                obj_typ smallint NOT NULL,
                anzahl INTEGER NOT NULL
);


()</prop>
      <prop id="ddl-import">()-- Copyright © 2023 Red-Shark-Formation. All rights reserved.
-- box noch zu testen
CREATE SEQUENCE #box_seq;
CREATE TABLE #box (
                box_id INTEGER NOT NULL DEFAULT nextval('#box_seq'),
                zustand smallint NOT NULL DEFAULT 1,                   
                kurzname CHAR(20),
                titel CHAR(60),
                beschreibung VARCHAR,
                uri VARCHAR,
                werte VARCHAR,              
                qualitaet smallint,             
                zeit_import TIMESTAMP,
                zeit_qk TIMESTAMP,
                zeit_export TIMESTAMP,                 
                CONSTRAINT #box_pk PRIMARY KEY (box_id)
);

-- attr
CREATE SEQUENCE #attr_seq;
CREATE TABLE #attr (
                attr_id INTEGER NOT NULL DEFAULT nextval('#attr_seq'),
                obj_id INTEGER NOT NULL,
                attr_typ smallint NOT NULL,
                top_aktuell smallint DEFAULT 0,                  
                box_id INTEGER NOT NULL,               
                CONSTRAINT #attr_pk PRIMARY KEY (attr_id)
);


-- wert
CREATE SEQUENCE #wert_seq;
CREATE TABLE #wert (
                wert_id INTEGER NOT NULL DEFAULT nextval('#wert_seq'),
                attr_id INTEGER NOT NULL,
                syntax_art smallint,
                inhalt CHAR(60) NOT NULL,
                inhalt2 CHAR(60),
                von TIMESTAMP,
                bis TIMESTAMP,
                wann TIMESTAMP DEFAULT now()(e:o)(e:c)() NOT NULL,
                ist_top smallint DEFAULT 0 NOT NULL,
                hat_mehr smallint DEFAULT 0 NOT NULL,
                box_id INTEGER NOT NULL,                   
                CONSTRAINT #wert_pk PRIMARY KEY (wert_id)
);

-- schlecht
CREATE SEQUENCE #schlecht_seq;
CREATE TABLE #schlecht (
                schlecht_id INTEGER NOT NULL DEFAULT nextval('#schlecht_seq'),
                wert_id INTEGER NOT NULL,
                datum TIMESTAMP DEFAULT now()(e:o)(e:c)() NOT NULL,
                grund varchar(200),
                box_id INTEGER NOT NULL,                   
                CONSTRAINT #schlecht_pk PRIMARY KEY (schlecht_id)
);

-- mehr
CREATE TABLE #mehr (
                wert_id INTEGER NOT NULL,
                inhalt VARCHAR,
                box_id INTEGER NOT NULL,                  
                CONSTRAINT #mehr_pk PRIMARY KEY (wert_id)
);

-- obj
CREATE SEQUENCE #obj_seq;
CREATE TABLE #obj (
                obj_id INTEGER NOT NULL DEFAULT nextval('#obj_seq'),
                obj_typ smallint NOT NULL,              
                box_id INTEGER NOT NULL,               
                CONSTRAINT #obj_pk PRIMARY KEY (obj_id)
);


-- bez
CREATE SEQUENCE #bez_seq;
CREATE TABLE #bez (
                bez_id INTEGER NOT NULL DEFAULT nextval('#bez_seq'),
                bez_typ smallint NOT NULL,
                obj_id_a INTEGER NOT NULL,
                obj_id_b INTEGER NOT NULL,
                box_id INTEGER NOT NULL,                
                CONSTRAINT #bez_pk PRIMARY KEY (bez_id)
);

-- qk-attr-wert
CREATE SEQUENCE #qk_attr_wert_seq;
CREATE TABLE #qk_attr_wert (
                id INTEGER NOT NULL DEFAULT nextval('#qk_attr_wert_seq'),
                attr_typ smallint NOT NULL,
                syntax_art smallint,                
                inhalt VARCHAR,
                von TIMESTAMP,
                bis TIMESTAMP,
                wann TIMESTAMP NOT NULL DEFAULT now()(e:o)(e:c)(),
                box_id INTEGER NOT NULL, 
                obj_id INTEGER NOT NULL,                                                               
                attr_id INTEGER,
                wert_id INTEGER,
                done smallint NOT NULL DEFAULT 0,                 
                CONSTRAINT #qk_attr_wert_pk PRIMARY KEY (id)
);

-- mig_obj
CREATE SEQUENCE #mig_obj_seq;
CREATE TABLE #mig_obj (               
                mig_obj_id INTEGER NOT NULL DEFAULT nextval('#mig_obj_seq'),
                obj_typ smallint NOT NULL,
                ison smallint NOT NULL DEFAULT 1,
                datum TIMESTAMP NOT NULL DEFAULT now()(e:o)(e:c)(),
                uk VARCHAR NOT NULL,
                uk_attr_usg_id INTEGER NOT NULL,
                uk_inhalt VARCHAR NOT NULL,
                master_obj_id INTEGER NOT NULL,
                slave_obj_id INTEGER NOT NULL,
                slave_wert_id INTEGER NOT NULL,
                CONSTRAINT #mig_obj_pk PRIMARY KEY (mig_obj_id)
);

-- mig_obj_hist
CREATE TABLE #mig_obj_hist (               
                mig_obj_id INTEGER,
                obj_typ smallint NOT NULL,
                ison smallint NOT NULL DEFAULT 1,
                datum TIMESTAMP,
                uk VARCHAR NOT NULL,
                uk_attr_usg_id INTEGER NOT NULL,
                uk_inhalt VARCHAR NOT NULL,
                master_obj_id INTEGER NOT NULL,
                slave_obj_id INTEGER NOT NULL,
                slave_wert_id INTEGER NOT NULL,
                CONSTRAINT #mig_obj_hist_pk PRIMARY KEY (mig_obj_id)
);

-- attr
CREATE INDEX #idx_attr_obj_id ON #attr (obj_id);
CREATE INDEX #idx_attr_attr_typ ON #attr (attr_typ);
CREATE INDEX #idx_attr_top_aktuell ON #attr (top_aktuell);

-- wert
CREATE INDEX #idx_wert_attr_id ON #wert (attr_id);
CREATE INDEX #idx_wert_wann ON #wert (wann);
CREATE INDEX #idx_wert_heal_double_werte ON #wert (attr_id, inhalt, von, bis);
CREATE INDEX #idx_wert_top ON #wert (attr_id, wann desc);

-- obj


-- qk_attr_wert
-- CREATE INDEX  #idx_qk_attr_wert_done ON  #qk_attr_wert (done);
                                                         
CREATE INDEX  #idx_qk_attr_wert_sort ON  #qk_attr_wert (done,obj_id, attr_typ);

-- index auf box_id
-- box: obj
CREATE INDEX #idx_obj_box_id ON #obj (box_id);

-- box: bez
CREATE INDEX #idx_bez_box_id ON #bez (box_id);

-- box: attr
CREATE INDEX #idx_attr_box_id ON #attr (box_id);

-- box: wert
CREATE INDEX #idx_wert_box_id ON #wert (box_id, attr_id);

-- box: mehr
CREATE INDEX #idx_mehr_box_id ON #mehr (box_id);


()</prop>    
<!-- gibts nicht mehr: war oben bei postgres 

CREATE VIEW #kopf AS
 SELECT n1.obj_id,
    n1.obj_typ,
    n2.kopf
   FROM ( SELECT obj.obj_id,
            obj.obj_typ,
            ot.kopf_attr_typ
           FROM #obj obj,
            t_o ot
          WHERE obj.obj_typ = ot.obj_typ) n1
     LEFT JOIN ( SELECT attr.obj_id,
            attr.attr_typ,
            wert.inhalt AS kopf
           FROM #attr attr,
            #wert wert
          WHERE attr.attr_id = wert.attr_id AND wert.ist_top = 1) n2 ON n1.obj_id = n2.obj_id AND n1.kopf_attr_typ = n2.attr_typ;
-->
    </when>
    <when test="(f,or,(f,eq_text,mysql,(prop,get-ddl-dbms)),(f,eq_text,maria,(prop,get-ddl-dbms)))">
      <!-- kopf gibts nur noch als feld im objekt
      <prop id="ddl-kopf-allin">()CREATE VIEW kopf AS
 SELECT n1.obj_id,
    n1.obj_typ,
    n2.kopf
   FROM ( SELECT obj.obj_id,
            obj.obj_typ,
            ot.kopf_attr_typ
           FROM obj obj,
            t_o ot
          WHERE obj.obj_typ = ot.obj_typ) n1
     LEFT JOIN ( SELECT attr.obj_id,
            attr.attr_typ,
            wert.inhalt AS kopf
           FROM attr attr,
            wert wert
          WHERE attr.attr_id = wert.attr_id AND wert.ist_top = 1) n2 ON n1.obj_id = n2.obj_id AND n1.kopf_attr_typ = n2.attr_typ;()</prop>
          
      <choose>
        <when test="(f,eq_text,maria,(prop,get-ddl-dbms))">
          <tk type="bool" id="q-all-in" label="All-In-Version inkl Kopf-view" flag="nono" x="1"/>
          <choose>
            <when test="(prop,q-all-in)">
              <prop id="ddl-kopf">(prop,ddl-kopf-allin)</prop>
            </when>
            <otherwise>
                <prop id="ddl-kopf">()CREATE VIEW kopf1 AS   
     SELECT obj.obj_id,
            obj.obj_typ,
            ot.kopf_attr_typ
           FROM obj obj,
            t_o ot
          WHERE obj.obj_typ = ot.obj_typ;      
          
 CREATE VIEW kopf2 AS
 SELECT attr.obj_id,
            attr.attr_typ,
            wert.inhalt AS kopf
           FROM attr attr,
            wert wert
          WHERE attr.attr_id = wert.attr_id AND wert.ist_top = 1;
                                                        
CREATE VIEW kopf3 AS
 SELECT n1.obj_id as obj_id,
    n1.obj_typ as obj_typ,
    n2.kopf as kopf
   FROM kopf1 n1
     LEFT JOIN kopf2 n2 ON n1.obj_id = n2.obj_id AND n1.kopf_attr_typ = n2.attr_typ;      
     
CREATE TABLE kopf (
  obj_id INTEGER NOT NULL,
  obj_typ smallint NOT NULL,
  kopf TEXT(60) NOT NULL DEFAULT '?'       
);
         
          ()</prop>
            </otherwise>          
          </choose>          
          <remove id="q-all-in" type="prop"/>
        </when>
        <otherwise>
            <prop id="ddl-kopf">(prop,ddl-kopf-allin)</prop>
        </otherwise>
      
      </choose>
      
      <remove id="ddl-kopf-allin" type="prop"/>
      -->
      <prop id="ddl">()-- Copyright © 2023 Red-Shark-Formation. All rights reserved.
-- beziehungstypen mysql

CREATE TABLE t_b (
                bez_typ smallint NOT NULL
);

-- objekttypen
CREATE TABLE t_o (
                obj_typ smallint NOT NULL,
                kopf_attr_typ smallint
);

-- attributtypen
CREATE TABLE t_a (
                attr_typ smallint NOT NULL,  
                final_typ smallint  NOT NULL       
);

-- attribute usage    object x attribute
CREATE TABLE t_u (
                attr_usg_id INTEGER NOT NULL AUTO_INCREMENT,
                attr_typ smallint NOT NULL,
                obj_typ smallint NOT NULL,
                ident smallint  NOT NULL,
                PRIMARY KEY (attr_usg_id)
);

-- objekt report
CREATE TABLE r_o (
                obj_typ smallint NOT NULL,
                anzahl INTEGER NOT NULL
);



-- qk-attr-wert
CREATE TABLE i_qk_attr_wert (
                id INTEGER NOT NULL AUTO_INCREMENT,
                attr_typ smallint NOT NULL,
                syntax_art smallint,                
                inhalt VARCHAR(5000),
                von TIMESTAMP,
                bis TIMESTAMP,
                wann TIMESTAMP NOT NULL DEFAULT now()(e:o)(e:c)(),
                box_id INTEGER NOT NULL, 
                obj_id INTEGER NOT NULL,                                                               
                attr_id INTEGER,
                wert_id INTEGER,
                done smallint NOT NULL DEFAULT 0,                 
                PRIMARY KEY (id)
);

-- indizies import
                                                    
CREATE INDEX i_idx_qk_attr_wert_sort ON i_qk_attr_wert (done,obj_id, attr_typ);
CREATE INDEX i_idx_obj_box_id ON i_obj (box_id);
CREATE INDEX i_idx_bez_box_id ON i_bez (box_id);
CREATE INDEX i_idx_attr_box_id ON i_attr (box_id);
CREATE INDEX i_idx_wert_box_id ON i_wert (box_id, attr_id);
CREATE INDEX i_idx_mehr_box_id ON i_mehr (box_id);   

-- indizes central

-- attr
CREATE INDEX idx_attr_obj_id ON attr (obj_id);
CREATE INDEX idx_attr_attr_typ ON attr (attr_typ);
CREATE INDEX idx_attr_top_aktuell ON attr (top_aktuell);

-- wert
CREATE INDEX idx_wert_attr_id ON wert (attr_id);
CREATE INDEX idx_wert_wann ON wert (wann);
CREATE INDEX idx_wert_heal_double_werte ON wert (attr_id, inhalt(60), von, bis);
CREATE INDEX idx_wert_top ON wert (attr_id, wann desc);

-- obj
CREATE INDEX idx_obj_obj_typ ON obj (obj_typ);

-- singles
CREATE TABLE integration_running (
                beginningWas VARCHAR(50));
CREATE TABLE import_running (
                beginningWas VARCHAR(50));      
                
CREATE TABLE frisch (
                obj_id INTEGER NOT NULL,
                obj_typ smallint NOT NULL
);    
CREATE INDEX idx_frisch_obj_id ON frisch (obj_id);         

-- mig_obj
CREATE TABLE mig_obj (               
                mig_obj_id INTEGER NOT NULL AUTO_INCREMENT,
                obj_typ smallint NOT NULL, 
                ison smallint NOT NULL DEFAULT 1,
                datum TIMESTAMP NOT NULL DEFAULT now()(e:o)(e:c)(),
                uk TEXT(80) NOT NULL,
                uk_attr_usg_id INTEGER NOT NULL,
                uk_inhalt TEXT(80) NOT NULL,
                master_obj_id INTEGER NOT NULL,
                slave_obj_id INTEGER NOT NULL,
                slave_wert_id INTEGER NOT NULL,
                PRIMARY KEY (mig_obj_id)
);

-- mig_obj_hist
CREATE TABLE mig_obj_hist (               
                mig_obj_id INTEGER,
                obj_typ smallint NOT NULL, 
                ison smallint NOT NULL DEFAULT 1,
                datum TIMESTAMP,
                uk TEXT(80) NOT NULL,
                uk_attr_usg_id INTEGER NOT NULL,
                uk_inhalt TEXT(80) NOT NULL,
                master_obj_id INTEGER NOT NULL,
                slave_obj_id INTEGER NOT NULL,
                slave_wert_id INTEGER NOT NULL,
                PRIMARY KEY (mig_obj_id)
);     


-- schlecht
CREATE TABLE i_schlecht (
                schlecht_id INTEGER NOT NULL AUTO_INCREMENT,
                wert_id INTEGER NOT NULL,
                datum TIMESTAMP DEFAULT now()(e:o)(e:c)() NOT NULL,
                grund varchar(200),
                box_id INTEGER NOT NULL,                   
                PRIMARY KEY (schlecht_id)
);           
    
()</prop>
  <!-- <remove id="ddl-kopf" type="prop" />  -->
  <when test="(f,gt_num,(prop,pronto),0)">
    <prop id="ddl">(prop,ddl)()CREATE INDEX idx_wert_pronto1 ON wert (attr_usg_id, inhalt2(60), obj_id);()</prop>
  </when>
      <prop id="ddl-import">()-- Copyright © 2023 Red-Shark-Formation. All rights reserved.
-- box
CREATE TABLE #box (
                box_id INTEGER NOT NULL AUTO_INCREMENT,
                zustand smallint NOT NULL DEFAULT 1,                 
                kurzname TEXT(20),
                titel TEXT(60),
                beschreibung VARCHAR(500),
                uri VARCHAR(500),                               
                werte VARCHAR(500),
                qualitaet smallint,
                zeit_import TIMESTAMP,
                zeit_qk TIMESTAMP,
                zeit_export TIMESTAMP,                
                PRIMARY KEY (box_id)
);

-- attr
CREATE TABLE #attr (
                attr_id INTEGER NOT NULL AUTO_INCREMENT,
                obj_id INTEGER NOT NULL,
                attr_typ smallint NOT NULL,
                box_id INTEGER NOT NULL,   
                top_aktuell smallint DEFAULT 0,                             
                PRIMARY KEY (attr_id)
);





-- mehr
CREATE TABLE #mehr (
                wert_id INTEGER NOT NULL,
                inhalt TEXT,
                box_id INTEGER NOT NULL,                  
                PRIMARY KEY (wert_id)
);

-- obj
CREATE TABLE #obj (
                obj_id INTEGER NOT NULL AUTO_INCREMENT,
                obj_typ smallint NOT NULL,     
                kopf VARCHAR(60) NOT NULL DEFAULT '_?_',          
                box_id INTEGER NOT NULL,               
                PRIMARY KEY (obj_id)
);


-- bez
CREATE TABLE #bez (
                bez_id INTEGER NOT NULL AUTO_INCREMENT,
                bez_typ smallint NOT NULL,
                obj_id_a INTEGER NOT NULL,
                obj_id_b INTEGER NOT NULL,
                box_id INTEGER NOT NULL,                
                PRIMARY KEY (bez_id)
);



()</prop>
  <choose>
    <when test="(f,gt_num,(prop,pronto),0)">
      <prop id="ddl-import">(prop,ddl-import)()
-- wert
CREATE TABLE #wert (
                wert_id INTEGER NOT NULL AUTO_INCREMENT,
                attr_id INTEGER NOT NULL,
                syntax_art smallint,
                inhalt TEXT(60) NOT NULL,
                inhalt2 TEXT(60),
                von TIMESTAMP,
                bis TIMESTAMP,
                wann TIMESTAMP DEFAULT now()(e:o)(e:c)() NOT NULL,
                ist_top smallint DEFAULT 0 NOT NULL,
                hat_mehr smallint DEFAULT 0 NOT NULL,
                box_id INTEGER NOT NULL,
                attr_usg_id INTEGER,
                obj_id INTEGER,
                ident smallint NOT NULL DEFAULT 0,                                   
                PRIMARY KEY (wert_id)
);
()</prop>
    </when>   
    <otherwise>
      <prop id="ddl-import">(prop,ddl-import)()
-- wert
CREATE TABLE #wert (
                wert_id INTEGER NOT NULL AUTO_INCREMENT,
                attr_id INTEGER NOT NULL,
                syntax_art smallint,
                inhalt TEXT(60) NOT NULL,
                inhalt2 TEXT(60),
                von TIMESTAMP,
                bis TIMESTAMP,
                wann TIMESTAMP DEFAULT now()(e:o)(e:c)() NOT NULL,
                ist_top smallint DEFAULT 0 NOT NULL,
                hat_mehr smallint DEFAULT 0 NOT NULL,
                box_id INTEGER NOT NULL,                   
                PRIMARY KEY (wert_id)
);
()</prop>    
    </otherwise>
   </choose>    

    </when>    
    <otherwise>
      <throw>get-ddl mit unbekanntem  dbms aufgerufen:(prop,get-ddl-dbms) </throw>
    </otherwise>
  </choose>
  
  
  <prop id="ddl-int">(prop,ddl-import)</prop>
  
  <prop id="ddl-import" x="(f,replace,(prop,ddl-import),#,i_)" />
  <prop id="ddl-int" x="(f,replace,(prop,ddl-int),#,)" />
  <prop id="ddl">(prop,ddl-int)  
(prop,ddl-import)
(prop,ddl)
</prop>

  <when test="(f,eq_text,maria,(prop,get-ddl-dbms))">
    <prop id="ddl-maria-search">()(?i)timestamp(\s*)\,()</prop>            
    <prop id="ddl-maria-count">(f,count_regex,(prop,ddl),(prop,ddl-maria-search))</prop>
    <throw test="(f,not,(f,eq_num,14,(prop,ddl-maria-count)))">Internes Problem bei der Generierung der der MariaDb-Ddl. Anzahl der gefundenen timestamps=(prop,ddl-maria-count)(e:s) erwartet wurden jedoch 14 timestamps!</throw>
    <prop id="ddl">(f,replace_regex,(prop,ddl),(prop,ddl-maria-search),timestamp NOT NULL DEFAULT '0000-00-00 00:00:00'(e:s))</prop>
    <remove id="ddl-maria-search" type="prop"/>
    <remove id="ddl-maria-count" type="prop"/>
  </when>

  <remove id="ddl-import" type="prop"/>
  <remove id="ddl-int" type="prop"/>
  
  

  <need>(prop,ddl)</need>

</job>


<job id="Configuration-Paras-v1" pri="10" role="hidden">
  <call_job job="tr_conf"/>
  
  <ti_break />
  <ti label="(prop,_sl_conf_main_interface)"/> 

  
  <ti type="rec" label="(prop,_sl_conf_conf_navi_explain)">
    <ti type="menu">
      <ti type="call_job" job="Nav Conf" flag="button" class="fb fbEdit" explain="(prop,_sl_conf_conf_navi)" />
      <ti type="call_job" job="Nav Conf?" explain="(prop,_label_askask)"  
          flag="button" class="fb fbAskAsk"/>        
    </ti>
  </ti>   

  
  <ti type="rec" label="(prop,_sl_conf_sprache_begriffe_explain)">
    <ti type="menu">  
      <ti type="call_job" job="Lingua Conf" flag="button" class="fb fbEdit" explain="(prop,_sl_conf_sprache_begriffe)" />
      <ti type="call_job" job="Lingua Conf?" explain="(prop,_label_askask)"
          flag="button" class="fb fbAskAsk" />
    </ti>    
  </ti>   
  
  <ti type="rec" label="(prop,_sl_conf_conf_limits_explain)">
    <ti type="menu">  
      <ti type="call_job" job="Limit Conf" flag="button" class="fb fbEdit" explain="(prop,_sl_conf_conf_limits)" />
      <ti type="call_job" job="Limit Conf?" explain="(prop,_label_askask)" 
          flag="button" class="fb fbAskAsk"/>
    </ti>    
  </ti>                                 
    
  
  <ti label="(prop,_sl_conf_main_systems)"/>

  <call_job job="tk_db_read_dbms"/>
  <prop id="dbms-to-print">(prop,_sl_conf_config_db_explain):</prop>
  <choose>
    <when test="(f,not,(f,has,prop,db_dbms))">
      <prop id="dbms-to-print">(prop,dbms-to-print) ???</prop>
    </when>  
    <when test="(f,eq_text,(prop,db_dbms),maria)">
      <prop id="dbms-to-print">(prop,dbms-to-print) MariaDb</prop>
    </when>
    <when test="(f,eq_text,(prop,db_dbms),mysql)">
      <prop id="dbms-to-print">(prop,dbms-to-print) MySql</prop>
    </when>    
    <when test="(f,eq_text,(prop,db_dbms),postgres)">
      <prop id="dbms-to-print">(prop,dbms-to-print) Postgres</prop>
    </when>       
    <otherwise>
      <prop id="dbms-to-print">(prop,dbms-to-print) (prop,db_dbms)</prop>
    </otherwise>
  </choose>

  
    <ti type="rec" label="(prop,_sl_conf_select_excel_explain)" test="(prop,bpRepo)">                            
      <ti type="call_job" job="_vokabular" xxjob="Select Excel" 
          explain="(prop,_sl_conf_select_excel)"  flag="button" class="fx fxEdit">
        <prop id="tk-para-edit-and-links">1</prop>
        <prop id="sel-excel-from-conf">1</prop>
      </ti>
     
      <!-- 
      <ti type="call_job" job="Help-Vocabular" xxjob="Select Excel?" flag="button" class="fx fxAsk fxAskConf" explain="(prop,_label_ask)" />      -->
    </ti>
    
    <ti type="rec" label="(prop,_sl_conf_config_kitchen_explain)"  test="(f,right,load)">
      <ti type="menu"> 
        <ti type="call_job" job="Kitchen Conf" flag="button" class="fb fbEdit" explain="(prop,_sl_conf_config_kitchen)"/>
        <ti type="call_job" job="Kitchen Conf?" explain="(prop,_label_askask)"        
        flag="button" class="fb fbAskAsk"/>
    </ti>         
      
    </ti> 
    <prop id="inhalte-to-print">(prop,_sl_conf_config_inhalte)</prop>
    <when test="(f,right,load)">
    
      <ti type="rec" label="(prop,inhalte-to-print)" >
        <ti type="call_job" job="_load_data"  flag="button"
            explain="(prop,_sl_conf_config_pjobs)"  class="fx fxEdit"/>
      
      </ti>    
      <prop id="inhalte-to-print"> </prop>   
    
    </when>
    
    <when test="(f,right,int)">
    
      <ti type="rec" label="(prop,inhalte-to-print)" >
        <ti type="call_job" job="_integrate"  flag="button" 
            explain="Integration"  class="fx fxEdit"/>
       
      </ti>    
      <prop id="inhalte-to-print"> </prop>   
    
    </when>    

<!-- 
    <ti type="menu">  
      <ti type="call_job" job="Limit Conf" flag="button" class="fb fbEdit" explain="(prop,_sl_conf_conf_limits)" />
      <ti type="call_job" job="Limit Conf?" explain="(prop,_label_askask)" 
          flag="button" class="fb fbAskAsk"/>
    </ti>   
--> 
    
    <when test="(prop,bpDb)" >
      <ti type="rec" label="(prop,dbms-to-print)">
        <ti type="menu">      
          <ti type="call_job" job="Db Conf" flag="button wrap" class="fb fbEdit" explain="(prop,_sl_conf_config_db)" />
          <ti type="call_job" job="Db Conf?" explain="(prop,_label_askask)" 
          flag="button" class="fb fbAskAsk"/>
        </ti>
        
      </ti>
      <prop id="dbms-to-print"> </prop>     
    </when> 
    
    <when test="(f,or,(f,right,stat),(f,right,clear))">
      <ti type="rec" label="(prop,dbms-to-print)" >
        <ti type="call_job" job="_admin_db"  flag="button" 
            explain="(prop,_sl_conf_config_db_tab_mgmt)"  class="fx fxEdit"/>
     
      </ti>        
      <ti type="rec" label=" " test="(f,right,stat)">
        <ti type="call_job" job="_new_stat"  flag="button" 
            explain="(prop,_sl_conf_config_stats)"  class="fx fxEdit"/>
    
      </ti>          

            
      <prop id="dbms-to-print"> </prop>
    </when> 
    <ti type="rec" label="(prop,dbms-to-print)">
      <ti type="call_job" 
          job="-db-close-on-purpose-" 
           class="fx fxEdit"  flag="button"
          explain="(prop,_closedb)" />       
   
    </ti>
    <prop id="dbms-to-print"> </prop>

  <when test="(f,right,import)">
    <ti type="rec" label="Import-Update">
      <ti  type="call_job" 
          explain="(prop,_sl_conf_config_imp_r)"
          job="-db-request-import-" 
          flag="button"
       class="fx fxEdit"/> 
  
    </ti>    
    <ti type="rec" label=" ">
      <ti  type="call_job" 
          explain="(prop,_sl_conf_config_imp_g)"
          job="-db-giveback-import-" 
          flag="button"
       class="fx fxEdit"/> 
      <ti> </ti>
    </ti>        
  </when>


</job>

<job id="dev-help" pri="10" role="hidden">

    <ti label="Developer-Snippets"/>
    <scan dir="(dir,app)dev-help" out="(dir,filetemp)dev-help.xml" level_limit="1" field="fn"/>
    
    <loop id="dh" xml="(dir,filetemp)dev-help.xml" xpath="file" sort="text" ignore_case="text">
      <!-- <ti_space height="5px"/> -->
      <ti_hr xtest="(f,gt_num,(loop,dh,#i),1)"/>
      <ti label="(f,substring_before,(loop,dh),.txt)"/>
      <!-- <ti flag="wrap_word">(f,file_content,(loop,dh,@fn))</ti>  -->
      
      <ti flag="html" x="&lt;font face=&quot;Courier&quot;&gt;(f,escape,_htmlb,(f,file_content,(loop,dh,@fn),UTF-8))&lt;font&gt;" />
      
     
    </loop>

</job>

<job id="conf-stat-intro" role="hidden">
  <ti label="Statistics"/>
  <ti type="menu">
      <ti type="call_job" job="vok-report-obj" explain="Vok: Obj" flag="button block" class="fb fbEdit cstat"/>
      <ti type="call_job" job="vok-report-attr" explain="Vok: Attr" flag="button" class="fb fbEdit cstat"/>
      <ti type="call_job" job="vok-report-bez" explain="Vok: Bez" flag="button" class="fb fbEdit cstat"/>  
  </ti>  
  <ti type="menu">
      <ti type="call_job" job="_new_stat" 
          test="(f,right,stat)"
          explain="Stat: Datenbank"  flag="button block" class="fb fbEdit cstat" />    
    
  </ti>


</job>

<job id="conf-stat-intro-hori" role="hidden">

  <ti type="menu">
      <ti type="call_job" job="vok-report-obj" explain="Vok: Obj" flag="button" class="fb fbEdit cstat"/>
      <ti type="call_job" job="vok-report-attr" explain="Vok: Attr" flag="button" class="fb fbEdit cstat"/>
      <ti type="call_job" job="vok-report-bez" explain="Vok: Bez" flag="button" class="fb fbEdit cstat"/>  
      <ti type="call_job" job="_new_stat" 
          test="(f,right,stat)"
          explain="Db-Stats"  flag="button" class="fb fbEdit cstat" /> 
  </ti>
  <ti_hr_break/>
  <!-- <ti_space height="6px"/> -->
</job>
</jobs>