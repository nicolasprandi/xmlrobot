   <call_job job="setup-define-database-inner"/>

   <call_job job="return-to-sender" />
</job> 

<job id="setup-define-database-inner"  role="hidden"> 

   <call_job job="tr_gs"/>
      
   <prop id="t2">(prop,_ex_dbset_alltip)</prop>
   <prop id="create_database">(prop,_ex_dbset_intro1)</prop>
	 <tk label="(prop,_ex_dbset_dbdef)">	
    	<tk label="(prop,_ex_dbset_todo1of5)" 
					type="accept" 
					id="donex" 
					x="(prop,create_database)" 
					label_accept="(prop,_ex_dbset_weiter)" 
					label_decline="(prop,_ex_dbset_abbruch)" 
					width="600" height="300">
			</tk>
    </tk>
   <throw test="(f,not,(prop,donex))">(prop,_ex_dbset_stopped)</throw>

    <call_job job="tk_db_read_dbms">
      <prop id="ask-user-for-dbms">1</prop>
      <prop id="ask-user-always-for-dbms">1</prop>
      
    </call_job>
    
  <call_job job="get-ddl">
    <prop id="get-ddl-dbms">(prop,db_dbms)</prop>
  </call_job>    
  
  <tk label="(prop,_ex_dbset_dbdef)">
    <tk type="msg" tip="(prop,t2)" msg_type="c" label="(prop,_ex_dbset_todo2of5)">(prop,ddl)</tk>
  </tk>  
   
</job> 


<job id="setup-define-database-shortcut" role="hidden">
  <call_job job="setup-define-database-inner"/>
  
  <call_job job="tr_shorty"/>
  <ti label="(prop,_shorty_todo)"/>
  <ti test="(f,implement,online)" xtype="ul">(prop,_shorty_waehlensie):</ti>
  <ti  xtype="(f,when,(f,implement,online),ul,text)">(prop,_shorty_waehlensie2):</ti>
  <ti_space height="5px" />
  
