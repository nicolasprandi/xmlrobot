<job id="process-kill-pid" role="hidden">
  <tk label="#(prop,pid)">
  <tk type="msg">Stop background-process 
#(prop,pid) 
really?</tk>    </tk>
  <ti_hr_break/>
  <process act="kill" pid="(prop,pid)"/>
  <ti label="Process #(prop,pid) will be stopped at next occasion" />
  <ti_hr_break/>
  <call_job job="process-admin"/>
</job>
<job id="process-admin" role="hidden">
  <ti label="List of Processes"/>
  <file id="plist">(dir,pro)cache/processlist.xml</file>
  <process act="list_all" file="(file,plist)"/>
  <prop id="found">0</prop>
  <prop id="now"></prop>
  <loop id="plist" xpath="proc" missing_strategy="empty" xml="(file,plist)">
    <prop id="found">(loop,plist,#i)</prop>
    <when test="(f,eq_num,1,(loop,plist,#i))">
      
      <prop id="now">(loop,plist,..,@now)</prop>
      <ti type="rec">
        <ti> </ti>
        <ti>(f,html,b,o)pid(f,html,b,c)</ti>
        <ti>(f,html,b,o)state(f,html,b,c)</ti>
        <ti>(f,html,b,o)type(f,html,b,c)</ti>
        <ti>(f,html,b,o)started(f,html,b,c)</ti>
        <ti>(f,html,b,o)user(f,html,b,c)</ti>
        <ti>(f,html,b,o)details(f,html,b,c)</ti>
        
        
      </ti>    
    </when>
    <ti type="rec">
      <ti type="call_job" job="process-kill-pid" explain="stop" flag="block button" class="fx redButton">
        <prop id="pid">(loop,plist,@pid)</prop>
      </ti>
      <ti>(loop,plist,@pid)</ti>
      <ti flag="wrap_xword">(f,html,i,o)(loop,plist,@state)(f,html,i,c)</ti>
      
      <ti>(loop,plist,@type)</ti>
      <ti>(loop,plist,@start)</ti>   
      <ti>(loop,plist,@user)</ti>  
      <ti>(loop,plist,@details)</ti>
      
      <ti test="(f,eq,0,(loop,plist,@alive))">process not alive!</ti>
    </ti>
  </loop>
  <ti_hr />
  <ti label="Found:">(f,html,b,o)(prop,found)(f,html,b,c) process(f,plural,(prop,found),es)</ti>
  <ti label="Now:" test="(f,has,prop,now)">(prop,now)</ti>
  <ti label="File:" type="rec" test="(f,role,test)">
    <ti type="file">(file,plist)</ti>
  </ti>
  <ti_hr style="2"/>                                              
  <ti label=" " type="call_job" job="process-admin" explain="Refresh" flag="button" class="fx"/>

</job>
<job id="run-script-file-editrun" role="hidden">
  <call_job job="File-Edit">
    <file id="with">(file,with)</file>
    <prop id="file-edit-encoding">UTF-8</prop>
  </call_job>
  <ti_hr_break/>
  <call_job job="run-script-file">
    <prop id="do-not-input">1</prop>
  </call_job>

</job>

<job id="edit-script-file" role="hidden">
  <call_job job="File-Edit">
    <file id="with">(file,with)</file>
    <prop id="file-edit-encoding">UTF-8</prop>
  </call_job>
  <ti_hr_break/>
  <call_job job="run-script-file?">
  
  </call_job>

</job>
<job id="run-script-file-but" role="hidden">

    <ti type="call_job" job="run-script-file" explain="Run Script-File" class="fx fxEdit justgo"  flag="button"     />    
<ti_space height="5px" /> 

    <ti type="call_job" job="edit-script-file" explain="Edit content of this file" class="fx fxEdit "  flag="button"  >
      <file id="with">(file,scriptFile)</file>
      <prop id="file-edit-encoding">UTF-8</prop>
    </ti>
<ti_space height="5px" /> 
    <ti type="call_job" job="run-script-file-editrun" explain="Edit content &amp; Run" class="fx fxEdit justgo"  flag="button"  >
      <file id="with">(file,scriptFile)</file>
    </ti>    
<ti_space height="5px" />    
    <ti type="call_job" job="run-script-file" explain="Just change File-Reference" class="fx fxEdit "  flag="button"  >
     <prop id="do-not-run">1</prop>
    </ti> 
    
</job>
<job id="run-script-file?" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(dir,pro)run-script-file.xml" />
    <prop id="joe-in-regex" x="scriptFile" />
  </call_job>  
  
    <tk flag="print_only" label="Run Script-File" tk_id="0">
    <tk type="file" id="scriptFile" label="Script to run" tip="*.xrs" flag="nono"/>
    </tk>
    <ti_hr/>  

    <call_job job="run-script-file-but"/>



</job>

<job id="run-script-file" role="hidden">
  <need default="0">(prop,do-not-input)</need>
  <need default="0">(prop,do-not-run)</need>
  
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(dir,pro)run-script-file.xml" />
    <prop id="joe-in-regex" x="scriptFile" />
  </call_job>   
  
  <when test="(f,not,(prop,do-not-input))">
    <prop id="top-flag">(f,when,(f,exists_file,(dir,pro)run-script-file.xml),sum_only,sum)</prop>
    <tk flag="(prop,top-flag) print" label="Run">
    <tk type="file" id="scriptFile" label="Script to run" tip="*.xrs" flag="nono"/>
    </tk>
    <ti_hr/>
    <call_job job="go-joe-write">
      <file id="joe-in-store" x="(dir,pro)run-script-file.xml" />         
      <prop id="joe-in-regex" x="scriptFile" />
    </call_job>     
  </when>

  <call_job job="run-script-file-but"/>
  <!-- 
    <ti type="call_job" job="run-script-file" explain="Run Script-File again" class="fx fxEdit justgo"  flag="button" />


    <ti type="call_job" job="File-Edit" explain="Edit content of this file" >
      <file id="with">(file,scriptFile)</file>
      <prop id="file-edit-encoding">UTF-8</prop>
    </ti>

    <ti type="call_job" job="run-script-file-editrun" explain="Edit content &amp; Run" >
      <file id="with">(file,scriptFile)</file>
    </ti>
     
    <ti type="call_job" job="run-script-file" explain="Just change File-Reference" >
     <prop id="do-not-run">1</prop>
    </ti> 

    -->
 
   <when test="(f,not,(prop,do-not-run))">
  <ti_hr_break/>
  
  
        <choose>
          <when test="(f,right,fork)">
          
            <call_job job="go-joe-read">
              <file id="joe-in-store" x="(dir,pro)run-script-how.xml" />
              <prop id="joe-in-regex" x="run-sqli-as-fork" />
            </call_job>   
            
            <tk label="Run: (f,name_of_file,(file,scriptFile))" flag="sum">
            <tk type="sel" id="run-sqli-as-fork" x="0" flag="nono" label="Execution-Mode"
                tip="ForeGround will make you wait. &#xA;BackGround runs the script in kind of 'parallel' mode. That means you can do meanwhile other things. BackGround-Mode will ignore all user-dialogs within the script. Use the Process-Administration to stop background-processes.">
               <sel label="Run in Foreground">0</sel>
               <sel label="Run in Background">2</sel>
            </tk>
            </tk>
            
            <call_job job="go-joe-write"/>
            
            <choose>
              <when test="(f,eq_num,0,(prop,run-sqli-as-fork))">
                <prop id="turbo-antes">(f,interpreter,turbo)</prop>
                <interpreter turbo="0"/>
                <include file="(file,scriptFile)"/>
                <interpreter turbo="(prop,turbo-antes)"/>              
                
              </when>
              
              <when test="(f,eq_num,1,(prop,run-sqli-as-fork))">
                <call_app 
                  app="(prop,app)"
                  pro_id="(prop,pro)"
                  pro_dir="(dir,pro)"
                  job="do-fork-include">
                  <file id="to-include">(file,scriptFile)</file>
                </call_app>
              </when>
                            
              <otherwise>
                <!-- <tk type="msg">Going to do the fork ...</tk>   -->
                <call_app 
                  app="(prop,app)"
                  pro_id="(prop,pro)"
                  pro_dir="(dir,pro)"
                  job="do-fork-include"
                  flag="fork">
                  <file id="to-include">(file,scriptFile)</file>
                </call_app>
                
                <call_job job="process-admin" />
              </otherwise>
            </choose>
          </when>
          <otherwise>
            <prop id="turbo-antes">(f,interpreter,turbo)</prop>
            <interpreter turbo="0"/>
            <include file="(file,scriptFile)"/>
            <interpreter turbo="(prop,turbo-antes)"/>          
            
          </otherwise>
        </choose>
     </when>
</job>

<job id="File-Edit" role="hidden" joblevel="ws">
  <need>(file,with)</need>
  <call_job job="tr_fedit"/>
  <prop id="encoding">UTF-8</prop>
  
  <prop id="content" x="(f,file_content,(file,with),(prop,encoding))"/>
  <prop id="content_before" x="(prop,content)"/>
  <tk>
  <tk type="textblock" flag="big bigbig wrap wide" id="content" label="(prop,_fedit_edit_label) (f,name_of_file,(file,with))"/>
  </tk>
  <choose>
  <when test="(f,not,(f,eq_text,(prop,content),(prop,content_before)))">
    
     <prop id="delete-pro-2" x="1"/>                
    <tk label="(prop,_fedit_sure)" 
    	type="accept" 
    	id="delete-pro-1" 
    	x="(prop,_fedit_sure2)&#xA;(file,with)&#xA;(prop,_fedit_sure3)" 
    	label_accept="(prop,_fedit_overwrite)" 
    	label_decline="(prop,_fedit_forget)" 
    	width="300" height="150">
    	<q id="delete-pro-2" label="(prop,_fedit_iknow)"  flag="load"/>
    </tk>
    
    <!-- fail if question not answered properly -->
    <when test="(f,not,(f,and,(prop,delete-pro-1),(prop,delete-pro-2)))">
      <ti>(prop,_fedit_terminated)</ti>
    	<throw>(prop,_fedit_terminated)</throw>
    </when> 
    <create_file out="(file,with)">(prop,content)</create_file>

    <ti>(prop,content)</ti>   
  </when>
  <otherwise>
    <ti>(prop,_fedit_not_updated)</ti>
  </otherwise>
  </choose>
  
</job>

<job id="tr_fedit" role="hidden">
 <!--
 (prop,) (prop,_fedit_) (prop,_fedit__) 
 <call_service job="tr_fedit"/> -->
 <choose>           
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_fedit_edit">Bearbeiten</prop>
      <prop id="_fedit_encoding">Encoding</prop>
      <prop id="_fedit_edit_label">Bearbeiten Sie den Inhalt der Datei</prop>
      <prop id="_fedit_before">Original:</prop>
      <prop id="_fedit_new">Neu:</prop>
      <prop id="_fedit_sure">Sind Sie sich betreffend der &#196;nderungen sicher?</prop>
      <prop id="_fedit_sure2">Sie haben eine Ver&#228;nderung der folgenden Datei angestossen</prop>
      <prop id="_fedit_sure3">Sind Sie sich sicher???</prop>
      <prop id="_fedit_overwrite">&#220;berschreiben</prop>
      <prop id="_fedit_forget">Vergiss es</prop>
      <prop id="_fedit_iknow">()Ja, mir ist bewusst, dass die alten Inhalte der Datei f&#252;r immer verloren sein werden.()</prop>
      <prop id="_fedit_terminated">Vorgang auf Wunsch abgebrochen.</prop>
      <prop id="_fedit_created">Erzeugt</prop>
      <prop id="_fedit_not_updated">Die Datei wurde nicht ver&#228;ndert und bleibt erhalten.</prop>
   
            
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(f,interpreter,lang),es)" lang="es">
    
    </when>  -->  
    <when test="1" lang="en">   
      <!-- e=englisch -->
      <prop id="_fedit_edit">Edit</prop>
      <prop id="_fedit_encoding">Encoding</prop>
      <prop id="_fedit_edit_label">Edit the files content</prop>
      <prop id="_fedit_before">Original:</prop>
      <prop id="_fedit_new">New:</prop>
      <prop id="_fedit_sure">Sure about updating?</prop>
      <prop id="_fedit_sure2">You commanded to update the file</prop>
      <prop id="_fedit_sure3">Are you sure about that???</prop>
      <prop id="_fedit_overwrite">Overwrite it</prop>
      <prop id="_fedit_forget">Forget it</prop>
      <prop id="_fedit_iknow">()Yes, I know that the old content of the updated files will be gone forever()</prop>
      <prop id="_fedit_terminated">Operation terminated on request.</prop>
      <prop id="_fedit_created">Created</prop>
      <prop id="_fedit_not_updated">File was not updated and not saved</prop>
    </when>
  </choose>
</job>

<job id="_configurations_header" role="hidden">
   <call_job job="-db-close-on-purpose-" />
  <call_job job="tr_dwi"/>
  <prop id="xblock"></prop>
  <prop id="xblock" test="(f,not,(f,implement,online))">block</prop>


  <when test="(f,exists_file,(dir,pro)icl.xrs)">
    <ti label="(prop,_dwi_last_int)"/>
    <remove type="file" id="integration-log" flag="catch" />
    <remove type="prop" id="explain-para" flag="catch" />
    
    <call_job job="go-joe-read">
      <file id="joe-in-store" x="(dir,pro)icl.xrs" />
      <prop id="joe-in-regex" x="integration-log|explain-para" />
    </call_job>  
    
    <when test="(f,has,file,integration-log)">
      <ti type="rec" label="(prop,_dwi_int_log)">
        <ti type="call_job" job="see-log-file" explain="(prop,_dwi_see_log)" flag="silent button" class="fx"> 
          <file id="logging">(file,integration-log)</file>
        </ti>    
        <ti type="file" >(file,integration-log)</ti>
        <ti >(f,name_of_dir,(f,dir_of_file,(file,integration-log)))</ti>
      </ti>    
    </when>
    
    <when test="(f,has,prop,explain-para)">
    
      <ti label="(prop,_dwi_expl_report)" type="rec">
        <ti type="call_job" job="see-explain" explain="(prop,_dwi_explain_expl)" >
          <file id="explain-to-see">(prop,explain-para)</file>
        </ti>
        <ti type="file" >(prop,explain-para)</ti>  
        <ti >(f,name_of_dir,(f,dir_of_file,(prop,explain-para)))</ti>             
      </ti>
          
    </when>    
      
  </when>       
    
  <ti label="(prop,_dwi_panel)" /> 
  <ti type="rec"> 
    <ti type="call_job" job="_integrate"  flag="button (prop,xblock) "    
        explain="(prop,_dwi_integrate)"  class="fx fxEdit justgo" test="(f,right,int)"/>

      <ti type="call_job" 
          job="sql-run" 
          flag="button  (f,when,(f,not,(f,right,int)),(prop,xblock),)" class="fx fxEdit cstat"
          explain="Boxen-Liste (e:o)Objektanzahl(e:c)" >
          <file id="sr-file">(dir,app)sql-boxes/1-Count-ObjectsPerBox.sql</file>   
          <dir id="sr-dir">(dir,app)sql-boxes</dir>     
          <prop id="sr-label">Import-Boxen</prop>   
          <prop id="sr-translator">sql-box</prop> 
          <prop id="sr-class">c</prop> 
          <prop id="sr-file-name">Liste der Boxen</prop>      
      </ti>    

  </ti>      
    
    <ti type="rec">
          
      <ti type="call_job" 
          job="stop-dbc-real" 
          class="fx fxEdit "  flag="button (prop,xblock)"
          explain="(prop,_closedb)" ></ti>    
                    
      <ti type="call_job" 
          job="sql-run" 
          flag="button" class="fx fxEdit cstat"
          explain="Anzahl der Boxen je Zustand" >
          <file id="sr-file">(dir,app)sql-boxes/2-Count-BoxStatus.sql</file>   
          <dir id="sr-dir">(dir,app)sql-boxes/</dir>     
          <prop id="sr-label">Import-Boxen</prop>  
          <prop id="sr-translator">sql-box</prop> 
          <prop id="sr-class">c</prop> 
          <prop id="sr-file-name">Anzahl der Boxen je Zustand</prop>
          
          <!-- <prop id="sr-no-stat-menu">1</prop> -->         
      </ti>         
              
           
    </ti>
    
    <ti type="rec">
    
      <ti type="call_job" job="-db-request-import-return"   test="(f,right,import)"
          explain="(prop,_dwi_requ_import)"  class="fx fxAdd" flag="button  (prop,xblock)">
          <prop id="db-import-post-job">_dwh</prop>
      </ti>   
          
      <ti type="call_job" job="-db-giveback-import-return"  flag="button"   
          test="(f,right,import)"
          explain="(prop,_dwi_fin_import)"  class="fx fxAdd" >
          <prop id="db-import-post-job">_dwh</prop>
      </ti>                  
    </ti>    
    <!-- 
    <ti type="rec">
    
      <ti explain="(prop,_dwi_trunc_central)"
          flag="(prop,xblock) button" class="fx fxEdit"
          type="call_job"
          job="clear-tables"
          test="(f,right,clear)">
            <prop id="clear-this">int</prop>
            <prop id="clear-this-explain">(prop,_dwi_d_lab)</prop>
      </ti>                      

      <ti type="call_job" job="_mat_views" explain="Materialized Views" test="(f,role,expert)"
          flag="button " class="fx fxEdit" />            
      
      
    </ti>            
    <remove type="file" id="the-last-integration" />  --> 
    <remove type="prop" id="xblock" />


</job>

 


