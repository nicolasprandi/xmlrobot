          flag="button" class="fb fbAsk"/>
        </ti>

    </when> 
  
     <when test="(f,right,stat)" >
    <ti type="menu">
        <ti type="call_job" job="_new_stat" 
            explain="Db-Stats"  flag="button block " class="fb fbEdit cstat" />         
    </ti>
    </when>     

      <ti type="menu" >
        <ti type="call_job" explain="DBCI-Connectoren"  flag="button block" 
            job="_credits"
             class="fb " />     
     </ti>      


     <!-- 
    <ti type="menu">
          
      <ti type="call_job" 
          job="stop-dbc-real" 
          class="fb fbEdit "  flag="button block"
          explain="(prop,_closedb)" ></ti>    
                              
    </ti>            -->
          


    
     
    <ti label="(prop,_sl_conf_config_kitchen_explain)" test="(f,or,(f,right,load),(f,right,pdi))"/>    
    <when test="(f,right,load)">

        <ti type="menu"> 
          <ti type="call_job" job="Kitchen Conf" flag="button block" class="fb fbEdit" explain="(prop,_sl_conf_config_kitchen)"/>
          <ti type="call_job" job="Kitchen Conf?" explain="(prop,_label_ask)"        
          flag="button" class="fb fbAsk"/>
        </ti>
   
    
      <ti type="menu" >
        <ti type="call_job" job="_load_data"  flag="button block"
            explain="(prop,_sl_conf_config_pjobs)"  class="fb fbEdit"/>
      
      </ti> 
   </when>            
