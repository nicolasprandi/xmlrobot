<job id="see-my-rights"  role="hidden">
  <call_job job="tr_setup" />
  <ti label="(prop,_ex_setup_aktrights)"/>
  <loop id="r" xml="(dir,app)rights.xml" xpath="r" missing_strategy="empty">
    <prop id="hasit">(f,when,(f,right,(loop,r,@id)),ok,x)</prop>
    <ti label="(loop,r,@id)" type="rec">
      <ti>(prop,hasit)</ti>
      <ti flag="wrap_word">(loop,r,(prop,ling))</ti>
    </ti>
  
  </loop>

</job>

