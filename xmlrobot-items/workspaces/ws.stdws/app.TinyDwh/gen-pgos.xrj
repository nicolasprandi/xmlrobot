<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_pgo) [ (f,tk_sel_translate,(prop,pgo_objekttyp),(dir,repo)osel-(prop,tip-term-class).xml) (prop,pgos_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,pgos)" where="(prop,pgos_offset)pgo[@row='(prop,pgo_key)']" />
<tp>Deleted (f,tk_sel_translate,(prop,pgo_objekttyp),(dir,repo)osel-(prop,tip-term-class).xml) #(prop,pgo_key)</tp>
<ti label="- (prop,_sl_pgo):" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,pgo_objekttyp),(dir,repo)osel-(prop,tip-term-class).xml)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="pgo-see-all" />
</job><job role="hidden" id="pgo-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="pgo_default_label_class" x="+ (prop,_sl_pgo)" />
<prop id="pgo_default_label_name" x="(f,when,(f,has,(prop,pgos_offset_label)), - (prop,pgos_offset_label),)" />
<prop id="pgos_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,pgo_key)</need>
<prop id="pgo_default_label_class" x="(prop,_sl_pgo)" />
<prop id="pgo_default_label_name" x="(f,tk_sel_translate,(prop,pgo_objekttyp),(dir,repo)osel-(prop,tip-term-class).xml)(f,when,(f,has,(prop,pgos_offset_label)), - (prop,pgos_offset_label),)" />
<prop id="pgos_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="pgo-tk" />
</job><job id="pgo-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="pgo-editor" />
<prop id="pgo_key">1</prop>
<when test="(f,not,(f,exists,prop,pgos_offset_new_key))">
<prop id="pgos_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,pgos)" sort="@row" number="@row" xpath="(prop,pgos_offset_new_key)pgo">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="pgo_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_pgo): #(prop,pgo_key)</i>
<call_job job="pgo-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_pgo) '(f,tk_sel_translate,(prop,pgo_objekttyp),(dir,repo)osel-(prop,tip-term-class).xml)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_pgo)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_pgo)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="pgo-insert-done" />
</otherwise>
</choose>
</job><job role="hidden" id="pgo-write">
<need>(prop,pgo_key) (prop,isAdd)</need>
<need default="./">(prop,pgos_offset)</need>
<spirit act="open" id="pgos_spirit_tc" xml="(file,pgos)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,pgos_offset),/)">
<prop id="offset2" x="(f,substring,(prop,pgos_offset),0,(f,sub,(f,len,(prop,pgos_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,pgos_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="pgos_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;pgo row="(prop,pgo_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="pgos_spirit_tc" where="(prop,pgos_offset)pgo[@row='(prop,pgo_key)']" attribute="objekttyp" value="(f,vob,prop,pgo_objekttyp)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="pgos_spirit_tc" where="(prop,pgos_offset)pgo[@row='(prop,pgo_key)']" attribute="detail" value="(f,vob,prop,pgo_detail)" />
<spirit act="close" flag="save pretty" id="pgos_spirit_tc" />
</job></jobs>
