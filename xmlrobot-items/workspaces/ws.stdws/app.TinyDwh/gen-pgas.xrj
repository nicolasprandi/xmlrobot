</job><job role="hidden" id="pga-del">
<need>(prop,pga_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="pga-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_pga) [ (f,tk_sel_translate,(prop,pga_attributtyp),(file,pdi-sel-attr)) (prop,pgas_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,pgas)" where="(prop,pgas_offset)pga[@row='(prop,pga_key)']" />
<tp>Deleted (f,tk_sel_translate,(prop,pga_attributtyp),(file,pdi-sel-attr)) #(prop,pga_key)</tp>
<ti label="- (prop,_sl_pga):" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,pga_attributtyp),(file,pdi-sel-attr))(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="pgo-see-all" />
</job><job role="hidden" id="pga-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="pga_default_label_class" x="+ (prop,_sl_pga)" />
<prop id="pga_default_label_name" x="(f,when,(f,has,(prop,pgas_offset_label)), - (prop,pgas_offset_label),)" />
<prop id="pgas_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,pga_key)</need>
<prop id="pga_default_label_class" x="(prop,_sl_pga)" />
<prop id="pga_default_label_name" x="(f,tk_sel_translate,(prop,pga_attributtyp),(file,pdi-sel-attr))(f,when,(f,has,(prop,pgas_offset_label)), - (prop,pgas_offset_label),)" />
<prop id="pgas_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="pga-tk" />
</job><job id="pga-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<prop id="parent-objekttyp">(f,xpath,(file,pgas),pgo[@row=(prop,pgo_key)],@objekttyp)</prop>
<file id="pdi-sel-attr">(dir,repo)ot-(prop,parent-objekttyp)-asel-(prop,tip-term-class).xml</file>
<remove id="parent-objekttyp" type="prop" />
<call_job job="pga-editor" />
<prop id="pga_key">1</prop>
<when test="(f,not,(f,exists,prop,pgas_offset_new_key))">
<prop id="pgas_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,pgas)" sort="@row" number="@row" xpath="(prop,pgas_offset_new_key)pga">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="pga_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_pga): #(prop,pga_key)</i>
<call_job job="pga-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_pga) '(f,tk_sel_translate,(prop,pga_attributtyp),(file,pdi-sel-attr))'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_pga)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_pga)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="pgo-see" />
</otherwise>
</choose>
</job><job role="hidden" id="pga-write">
<need>(prop,pga_key) (prop,isAdd)</need>
<need default="./">(prop,pgas_offset)</need>
<spirit act="open" id="pgas_spirit_tc" xml="(file,pgas)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,pgas_offset),/)">
<prop id="offset2" x="(f,substring,(prop,pgas_offset),0,(f,sub,(f,len,(prop,pgas_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,pgas_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="pgas_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;pga row="(prop,pga_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="pgas_spirit_tc" where="(prop,pgas_offset)pga[@row='(prop,pga_key)']" attribute="attributtyp" value="(f,vob,prop,pga_attributtyp)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="pgas_spirit_tc" where="(prop,pgas_offset)pga[@row='(prop,pga_key)']" attribute="detail" value="(f,vob,prop,pga_detail)" />
<spirit act="close" flag="save pretty" id="pgas_spirit_tc" />
</job></jobs>
