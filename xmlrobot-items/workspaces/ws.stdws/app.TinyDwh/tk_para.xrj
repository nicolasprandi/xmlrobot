<jobs>
<call_job job="prolog"/>

<!-- para-core, make your changes here -->
<job id="tk_para_default" role="hidden" tip="para_: Tk Internal">

  <need default="(dir,app)vokabular(f,when,(f,eq_text,en,(prop,ling)),-en,).xls">(file,para_file_vok)</need>
  
</job>
<job id="tk_para_core" role="hidden" tip="para_: Tk Internal">

  <need default="">(prop,tk_para_add_flag)</need>
  <call_job job="tr_para" />
  
  <tk label="(f,when,(f,has_flag,(prop,tk_para_add_flag),print_tips_only),(prop,_para_l_desc),(prop,_para_l))" 
      xlabel="(prop,_para_l)" 
      flag="(prop,tk_para_add_flag)"
      tip="(prop,_para_t)"> 
        
    <tk id="para_file_vok"
        type="file"  
      	label="(prop,_para_file_vok_l)" 
        flag="nono upload"          
        tip="(prop,_para_file_vok_t)"
        extensionn=".xls .xlsx"/>                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_para_edit" tip="para_: Edit the Data" role="hidden">

  <need default="0">(prop,tk-para-edit-and-links)</need>
  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,para-data))">
      <!-- data exists already -->
      <prop id="tk_para_add_flag" x="sum_only print"/>
      <call_job job="tk_para_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_para_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  
  <!-- doing input -->
  <call_job job="tk_para_default"/>
  <call_job job="tk_para_core"/>
  
  <!-- writing data -->
  <call_job job="tk_para_write"/>
  
  <when test="(prop,tk-para-edit-and-links)">
    <call_job job="vok-aktionen">
      <prop id="vok-aktionen-typ">2</prop>
    </call_job>  
  </when>  
  

</job>



<job id="tk_para_print_values" tip="para_: Prints the entered values" role="hidden">
  
  <call_job job="tk_para_read"/>
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_para_print_values_tips" tip="para_: Prints values and tips" role="hidden">
  
  <call_job job="tk_para_read"/>
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  <ti_hr/>
    <ti type="rec" label=" " > 
      <ti type="call_job" job="Select Excel" explain="(prop,_x_edit)" flag="button" class="fx fxEdit fxEditDetail fxEditDetailConf fxEditDetailConfPara" label=" "/>
      <ti> </ti>

    </ti>  
  
</job>

<job id="tk_para_print_help" tip="para_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_para_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,para-data)" />
    <prop id="joe-in-regex" x="(prop,para-regex)" />
  </call_job>
  
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_para_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,para-data)" />
    <prop id="joe-in-regex" x="(prop,para-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_para_clear"  tip="para_: Clears the data" role="hidden">
  <delete file="(file,para-data)"/>
</job>


</jobs>