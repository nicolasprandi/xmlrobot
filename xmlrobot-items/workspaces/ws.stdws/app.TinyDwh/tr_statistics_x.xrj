<job id="tr_statistics_clear" role="hidden">
  <need>(prop,trsn-in)</need>
  
  <prop id="trsn-out"></prop>

  <choose>
    <when test="(f,eq_text,0-trunc-import-int,(prop,trsn-in))">
      <choose>
        <when test="(f,eq_text,en,(prop,ling))">
          <prop id="trsn-out">Truncate [ IMPORT ] and [ INT ] Tables</prop>
        </when>
        <when test="(f,eq_text,de,(prop,ling))">
          <prop id="trsn-out">[ IMPORT ] und [ INT ] Tabellen entleeren</prop>
        </when>        
      </choose>    
    </when>  
    <when test="(f,eq_text,1-trunc-import,(prop,trsn-in))">
      <choose>
        <when test="(f,eq_text,en,(prop,ling))">
          <prop id="trsn-out">Truncate [ IMPORT ] Tables</prop>
        </when>
        <when test="(f,eq_text,de,(prop,ling))">
          <prop id="trsn-out">[ IMPORT ] Tabellen entleeren</prop>
        </when>        
      </choose>    
    </when>
    <when test="(f,eq_text,2-trunc-int,(prop,trsn-in))">
      <choose>
        <when test="(f,eq_text,en,(prop,ling))">
          <prop id="trsn-out">Truncate [ INT ] Tables</prop>
        </when>
        <when test="(f,eq_text,de,(prop,ling))">
          <prop id="trsn-out">[ INT ] Tabellen entleeren</prop>
        </when>        
      </choose>    
    </when>    
    
    <when test="(f,eq_text,5-clear-boxes,(prop,trsn-in))">
      <choose>
        <when test="(f,eq_text,en,(prop,ling))">
          <prop id="trsn-out">Reset all boxes to 'NOT IMPORTED yet'</prop>
        </when>
        <when test="(f,eq_text,de,(prop,ling))">
          <prop id="trsn-out">Setze alle Boxen auf 'noch NICHT IMPORTIERT'</prop>
        </when>        
      </choose>    
    </when>   
    

    
    
    <when test="(f,eq_text,9-trunc-mig-obj-hist,(prop,trsn-in))">
      <choose>
        <when test="(f,eq_text,en,(prop,ling))">
          <prop id="trsn-out">Delete the Report of Object-Migrations</prop>
        </when>
        <when test="(f,eq_text,de,(prop,ling))">
          <prop id="trsn-out">Loeschen des Berichts der Objekt-Migrationen</prop>
        </when>        
         
      </choose>    
    </when>                  
        
  </choose>
  
  

  <prop id="trsn-out" test="(f,not,(f,has,prop,trsn-out))">(prop,trsn-in)</prop>

</job>




</jobs>