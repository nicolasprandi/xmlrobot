<?xml version="1.0" ?>

<jobs>
<call_job job="prolog" />

<job id="see-boxinfo" role="hidden">
  <need>(prop,sbi-box-id)</need>

  <ti label="iBox-Info" />
  <dir id="cache">(dir,pro)cache</dir>    
  <file id="detBox" xx="(dir,cache)detBox.xml" x="(dir,filetemp)detBox.xml"/>
  <call_job job="-db-open-"/>

  <dbc id="(prop,mydbc)"
    out="(file,detBox)"
    style="a"
    root_name="root"
    row_name="detail"    
    act="select"
    flag="trim">select * from i_box where box_id=(prop,sbi-box-id);</dbc>

  <spirit id="detBox" act="open" xml="(file,detBox)" missing_strategy="empty"/>
  <ti label="titel" x="(f,html,b,o)(f,spirit,detBox,detail,@titel)(f,html,b,c)"/>  
  <ti label="box_id" x="(f,spirit,detBox,detail,@box_id)"/>
  <ti label="zustand" x="(f,spirit,detBox,detail,@zustand)"/>
  
  <ti label="kurzname" x="(f,spirit,detBox,detail,@kurzname)"/>
  <ti label="werte" x="(f,spirit,detBox,detail,@werte)"/>
  <ti label="beschreibung" x="(f,spirit,detBox,detail,@beschreibung)"/>
  <ti label="uri" x="(f,spirit,detBox,detail,@uri)"/>
  <ti label="qualitaet" x="(f,spirit,detBox,detail,@qualitaet)"/>
  <ti label="zeit_import" x="(f,spirit,detBox,detail,@zeit_import)"/>
  <ti label="zeit_qk" x="(f,spirit,detBox,detail,@zeit_qk)"/>
  <ti label="zeit_export" x="(f,spirit,detBox,detail,@zeit_export)"/>
    

  <spirit id="detBox" act="close" />
</job>

<job id="hook_dsi_details_top" role="hidden">

  <ti_break class_table="tabNavigator"/>  
  <ti type="rec">
  <ti type="menu" span="10" align="right">

    <ti flag="button obutton " label=" " type="call_job" 
        explain_nix="dso-add" class="fb fbAdd" explain="+ (prop,_sl_dso)" 
        job="dso-add"
        align="right">
        
      <file id="dsis">(file,dsis)</file>
      <prop id="dsi_key">(prop,dsi_key)</prop>   
      <file id="dsos">(file,dsis)</file>
      <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>   
      
    </ti>   
    
  <ti flag="button obutton " type="call_job" explain_nix="dsb-add" class="fb fbAdd" explain="+ (prop,_sl_dsb)" job="dsb-add">
  
      <file id="dsis">(file,dsis)</file>
      <prop id="dsi_key">(prop,dsi_key)</prop>   
      <file id="dsbs">(file,dsis)</file>
      <prop id="dsbs_offset">dsi[@row='(prop,dsi_key)']/</prop>     
 
      <prop id="back-to-blatt">1</prop>
  </ti>    
  </ti>
  </ti>
  <ti_break/>
  
    <ti type="rec" >
      <ti>(prop,_sl_dsi)</ti>
      <ti x="(f,html,b,o)(prop,dsi_name)(f,html,b,c)"/>
    </ti>  
    

   <ti type="rec" label="in (prop,_sl_buch): ">
    <ti >(f,name_of_dir,(f,dir_of_file,(file,dsis)))</ti>
   </ti>  
   <ti_hr style="2"/>
   

    
</job>

<job id="testdata-see-record-details" role="hidden">   


  
  <call_job job="tr_dsi" />
  <call_job job="tr_komp" />
  <call_job job="tr_dsa" />
  <call_job job="tr_dsb" />
  <prop id="has-one-dso">0</prop>
  <file id="dsos">(file,dsis)</file>
  <ti_hr_break/>
  <ti label="1(e:c) Objekte und Werte"/>
  <ti_space height="3px" />
  
  <prop id="das-w">(f,when,(f,eq_text,(prop,ling),de),w,v)</prop>

    
  <loop missing_strategy="empty" 
        id="objos" 
        xml="(file,dsis)" 
        xpath="dsi[@row=(f,xpath_string,(prop,dsi_key))]/dso">
        <prop id="has-one-dso">1</prop>
        
        <ti_hr test="(f,not,(f,eq_num,1,(loop,objos,#i)))" />
        
        <!-- das objekt -->
        <ti type="rec">
        
          <ti type="call_job" label=" " job="dso-see" explain="(f,html,b,o)(f,tk_sel_translate,(loop,objos,@objekttyp),(dir,repo)osel-(prop,tip-term-class).xml)(f,html,b,c) {(loop,objos,@row)}">
            <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>
            <file id="dsis">(file,dsis)</file>
            <prop id="dsi_key">(prop,dsi_key)</prop>
             <file id="dsos">(file,dsis)</file>
             <prop id="dso_key">(loop,objos,@row)</prop>
          </ti>        
          
          <ti type="call_job" job="dso-edit" explain="(loop,objos,@name)" flag="button obutton" class="fx fxAction justedit justeditobjekt" span="2">
            <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>
            <file id="dsos">(file,dsis)</file>
            <prop id="dso_key">(loop,objos,@row)</prop>
            <file id="dsis">(file,dsis)</file>
            <prop id="dsi_key">(prop,dsi_key)</prop> 
            <prop id="back-to-blatt">1</prop>         
          </ti>                                                        
            
        </ti>
        <!-- <ti label="(loop,objos,@name) {(loop,objos,@row)}" />   -->
        <prop id="dso_key">(loop,objos,@row)</prop>
        <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>
        <file id="dsas">(file,dsis)</file>
        <prop id="dsas_no_header">1</prop>
        <prop id="dsas_offset">dsi[@row='(prop,dsi_key)']/dso[@row='(loop,objos,@row)']/</prop>

        <!-- das ist die kopie von dsa-see-all-->
        


        <need default="">(prop,dsas_offset_label)</need>
        <need default="./">(prop,dsas_offset)</need>
        <need default="">(prop,dsas_return_job)</need>
        <need default="//">(prop,dsas_offset_new_key)</need>
        <need default="0">(prop,dsas_no_header)</need>
        
        <prop id="nothing">1</prop>
        
        <loop missing_strategy="empty" id="dsa_loop" xml="(file,dsas)" xpath="(prop,dsas_offset)dsa">
        
          <prop id="nothing" test="(prop,nothing)">0</prop>
          
          <prop id="parent-objekttyp">(loop,dsa_loop,..,@objekttyp)</prop>
          <file id="pdi-sel-attr">(dir,repo)ot-(prop,parent-objekttyp)-asel-(prop,tip-term-class).xml</file>
          
          <remove id="parent-objekttyp" type="prop" />
          
<prop id="dsa-plus-translated">(f,tk_sel_translate,(loop,dsa_loop,@attributtyp),(file,pdi-sel-attr))</prop>
<choose>
  <when test="(f,ends_with,(prop,dsa-plus-translated), *)">
    <prop id="dsa-plus-translated">(f,substring_before,(prop,dsa-plus-translated), *)</prop>
    <prop id="dsa-plus-postfix">*</prop>
  </when>
  <otherwise>
    <prop id="dsa-plus-postfix"></prop>
  </otherwise>
</choose>                

          <ti type="rec" >
            <ti flag="block" type="call_job" prefix="(prop,das-w) &gt; " postfix="(prop,dsa-plus-postfix)" explain="(prop,dsa-plus-translated)" job="dsa-see">
              <prop id="dsa_key">(loop,dsa_loop,@row)</prop>
              <file id="dsas">(file,dsas)</file>
              <prop id="dsas_offset">(prop,dsas_offset)</prop>
              <prop id="dsas_offset_label">(prop,dsas_offset_label)</prop>
              <prop id="dsas_offset_new_key">(prop,dsas_offset_new_key)</prop>
              <prop id="dsas_sort_attribute">(prop,dsas_sort_attribute)</prop>
              <prop id="dsas_sort_number">(prop,dsas_sort_number)</prop>
              <prop id="dsas_sort_ignore_case">(prop,dsas_sort_ignore_case)</prop>
              <prop id="dsas_sort_desc">(prop,dsas_sort_desc)</prop>
              <prop id="dsas_where">(prop,dsas_where)</prop>
              <prop id="dsas_return_job">(prop,dsas_return_job)</prop>
              <file id="dsis">(file,dsis)</file>
              <prop id="dsis_offset">(prop,dsis_offset)</prop>
              <prop id="dsis_offset_label">(prop,dsis_offset_label)</prop>
              <prop id="dsis_offset_new_key">(prop,dsis_offset_new_key)</prop>
              <prop id="dsis_sort_attribute">(prop,dsis_sort_attribute)</prop>
              <prop id="dsis_sort_number">(prop,dsis_sort_number)</prop>
              <prop id="dsis_sort_ignore_case">(prop,dsis_sort_ignore_case)</prop>
              <prop id="dsis_sort_desc">(prop,dsis_sort_desc)</prop>
              <prop id="dsis_where">(prop,dsis_where)</prop>
              <prop id="dsis_return_job">(prop,dsis_return_job)</prop>
              <prop id="dsi_key">(prop,dsi_key)</prop>
              <file id="dsos">(file,dsos)</file>
              <prop id="dsos_offset">(prop,dsos_offset)</prop>
              <prop id="dsos_offset_label">(prop,dsos_offset_label)</prop>
              <prop id="dsos_offset_new_key">(prop,dsos_offset_new_key)</prop>
              <prop id="dsos_sort_attribute">(prop,dsos_sort_attribute)</prop>
              <prop id="dsos_sort_number">(prop,dsos_sort_number)</prop>
              <prop id="dsos_sort_ignore_case">(prop,dsos_sort_ignore_case)</prop>
              <prop id="dsos_sort_desc">(prop,dsos_sort_desc)</prop>
              <prop id="dsos_where">(prop,dsos_where)</prop>
              <prop id="dsos_return_job">(prop,dsos_return_job)</prop>
              <prop id="dso_key">(prop,dso_key)</prop>
              
            </ti>
            <ti type="call_job" flag="button obutton" span="2" explain="(loop,dsa_loop,@wert)" class="fx fxAction justedit justeditwert" job="dsa-edit">
              <prop id="dsa_key">(loop,dsa_loop,@row)</prop>
              <file id="dsas">(file,dsas)</file>
              <prop id="dsas_offset">(prop,dsas_offset)</prop>
              <prop id="dsas_offset_label">(prop,dsas_offset_label)</prop>
              <prop id="dsas_offset_new_key">(prop,dsas_offset_new_key)</prop>
              <prop id="dsas_sort_attribute">(prop,dsas_sort_attribute)</prop>
              <prop id="dsas_sort_number">(prop,dsas_sort_number)</prop>
              <prop id="dsas_sort_ignore_case">(prop,dsas_sort_ignore_case)</prop>
              <prop id="dsas_sort_desc">(prop,dsas_sort_desc)</prop>
              <prop id="dsas_where">(prop,dsas_where)</prop>
              <prop id="dsas_return_job">(prop,dsas_return_job)</prop>
              <file id="dsis">(file,dsis)</file>
              <prop id="dsis_offset">(prop,dsis_offset)</prop>
              <prop id="dsis_offset_label">(prop,dsis_offset_label)</prop>
              <prop id="dsis_offset_new_key">(prop,dsis_offset_new_key)</prop>
              <prop id="dsis_sort_attribute">(prop,dsis_sort_attribute)</prop>
              <prop id="dsis_sort_number">(prop,dsis_sort_number)</prop>
              <prop id="dsis_sort_ignore_case">(prop,dsis_sort_ignore_case)</prop>
              <prop id="dsis_sort_desc">(prop,dsis_sort_desc)</prop>
              <prop id="dsis_where">(prop,dsis_where)</prop>
              <prop id="dsis_return_job">(prop,dsis_return_job)</prop>
              <prop id="dsi_key">(prop,dsi_key)</prop>
              <file id="dsos">(file,dsos)</file>
              <prop id="dsos_offset">(prop,dsos_offset)</prop>
              <prop id="dsos_offset_label">(prop,dsos_offset_label)</prop>
              <prop id="dsos_offset_new_key">(prop,dsos_offset_new_key)</prop>
              <prop id="dsos_sort_attribute">(prop,dsos_sort_attribute)</prop>
              <prop id="dsos_sort_number">(prop,dsos_sort_number)</prop>
              <prop id="dsos_sort_ignore_case">(prop,dsos_sort_ignore_case)</prop>
              <prop id="dsos_sort_desc">(prop,dsos_sort_desc)</prop>
              <prop id="dsos_where">(prop,dsos_where)</prop>
              <prop id="dsos_return_job">(prop,dsos_return_job)</prop>
              <prop id="dso_key">(prop,dso_key)</prop>
              <prop id="back-to-blatt">1</prop>
            </ti>
          </ti>
      </loop>
      
      <when test="(prop,nothing)">
        <ti type="rec">
        <ti span="1"> </ti>
        <ti flag="wrap_word">(prop,_dsa_nothing_l)</ti>
        </ti>
      </when>
      
      <when test="(f,not,(f,contains,(prop,dsas_offset),node(e:o)(e:c)))">
        <ti type="menu" first_cell="2"  >
          <ti flag="button obutton "  type="call_job"  class="fb fbAdd" explain="+ (prop,_sl_dsa)" job="dsa-add">
            <file id="dsas">(file,dsas)</file>
            <prop id="dsas_offset">(prop,dsas_offset)</prop>
            <prop id="dsas_offset_label">(prop,dsas_offset_label)</prop>
            <prop id="dsas_offset_new_key">(prop,dsas_offset_new_key)</prop>
            <prop id="dsas_sort_attribute">(prop,dsas_sort_attribute)</prop>
            <prop id="dsas_sort_number">(prop,dsas_sort_number)</prop>
            <prop id="dsas_sort_ignore_case">(prop,dsas_sort_ignore_case)</prop>
            <prop id="dsas_sort_desc">(prop,dsas_sort_desc)</prop>
            <prop id="dsas_where">(prop,dsas_where)</prop>
            <prop id="dsas_return_job">(prop,dsas_return_job)</prop>
            <file id="dsis">(file,dsis)</file>
            <prop id="dsis_offset">(prop,dsis_offset)</prop>
            <prop id="dsis_offset_label">(prop,dsis_offset_label)</prop>
            <prop id="dsis_offset_new_key">(prop,dsis_offset_new_key)</prop>
            <prop id="dsis_sort_attribute">(prop,dsis_sort_attribute)</prop>
            <prop id="dsis_sort_number">(prop,dsis_sort_number)</prop>
            <prop id="dsis_sort_ignore_case">(prop,dsis_sort_ignore_case)</prop>
            <prop id="dsis_sort_desc">(prop,dsis_sort_desc)</prop>
            <prop id="dsis_where">(prop,dsis_where)</prop>
            <prop id="dsis_return_job">(prop,dsis_return_job)</prop>
            <prop id="dsi_key">(prop,dsi_key)</prop>
            <file id="dsos">(file,dsos)</file>
            <prop id="dsos_offset">(prop,dsos_offset)</prop>
            <prop id="dsos_offset_label">(prop,dsos_offset_label)</prop>
            <prop id="dsos_offset_new_key">(prop,dsos_offset_new_key)</prop>
            <prop id="dsos_sort_attribute">(prop,dsos_sort_attribute)</prop>
            <prop id="dsos_sort_number">(prop,dsos_sort_number)</prop>
            <prop id="dsos_sort_ignore_case">(prop,dsos_sort_ignore_case)</prop>
            <prop id="dsos_sort_desc">(prop,dsos_sort_desc)</prop>
            <prop id="dsos_where">(prop,dsos_where)</prop>
            <prop id="dsos_return_job">(prop,dsos_return_job)</prop>
            <prop id="dso_key">(prop,dso_key)</prop>
            <prop id="back-to-blatt">1</prop>
          </ti>
          
          <ti flag="button" test="(f,not,(prop,nothing))" type="call_job" class="fb fbOrg" explain="(prop,_dsa_org)" job="do-org-me">
            <file id="orga">(file,dsas)</file>
            <prop id="orga_where">(prop,dsas_where)</prop>
            <prop id="orga_view_loop_id">dsa_loop</prop>
            <prop id="orga_finished_job">ready-and-done-dsa</prop>
            <prop id="orga_offset">(prop,dsas_offset)</prop>
            <prop id="orga_offset_label">(prop,dsas_offset_label)</prop>
            <prop id="orga_offset_new_key">(prop,dsas_offset_new_key)</prop>
            <prop id="orga_segment_plural">dsas</prop>
            <prop id="orga_segment_singular">dsa</prop>
            <prop id="orga_segment_plural_label">(prop,_pl_dsa)</prop>
            <prop id="orga_segment_singular_label">(prop,_sl_dsa)</prop>
            <prop id="orga_sort_attribute">(prop,dsas_sort_attribute)</prop>
            <prop id="orga_sort_number">(prop,dsas_sort_number)</prop>
            <prop id="orga_where">(prop,dsas_where)</prop>
            <prop id="orga_name_expression_loop">()(f,tk_sel_translate,(loop,dsa_loop,@attributtyp),(file,pdi-sel-attr))()</prop>
            <prop id="orga_desc_expression_loop">()()</prop>
            <file id="dsis">(file,dsis)</file>
            <prop id="dsis_offset">(prop,dsis_offset)</prop>
            <prop id="dsis_offset_label">(prop,dsis_offset_label)</prop>
            <prop id="dsis_offset_new_key">(prop,dsis_offset_new_key)</prop>
            <prop id="dsis_sort_attribute">(prop,dsis_sort_attribute)</prop>
            <prop id="dsis_sort_number">(prop,dsis_sort_number)</prop>
            <prop id="dsis_sort_ignore_case">(prop,dsis_sort_ignore_case)</prop>
            <prop id="dsis_sort_desc">(prop,dsis_sort_desc)</prop>
            <prop id="dsis_where">(prop,dsis_where)</prop>
            <prop id="dsis_return_job">(prop,dsis_return_job)</prop>
            <prop id="dsi_key">(prop,dsi_key)</prop>
            <file id="dsos">(file,dsos)</file>
            <prop id="dsos_offset">(prop,dsos_offset)</prop>
            <prop id="dsos_offset_label">(prop,dsos_offset_label)</prop>
            <prop id="dsos_offset_new_key">(prop,dsos_offset_new_key)</prop>
            <prop id="dsos_sort_attribute">(prop,dsos_sort_attribute)</prop>
            <prop id="dsos_sort_number">(prop,dsos_sort_number)</prop>
            <prop id="dsos_sort_ignore_case">(prop,dsos_sort_ignore_case)</prop>
            <prop id="dsos_sort_desc">(prop,dsos_sort_desc)</prop>
            <prop id="dsos_where">(prop,dsos_where)</prop>
            <prop id="dsos_return_job">(prop,dsos_return_job)</prop>
            <prop id="dso_key">(prop,dso_key)</prop>
            <prop id="back-to-blatt">1</prop>
          </ti>
        </ti>
      </when>
    
        
        
  </loop>
  
  <when test="(f,not,(prop,has-one-dso))">
    <ti type="rec">
      <ti >(prop,_komp_dso_nothing)</ti>
    </ti>
  </when>
    
  <ti_hr />  

  
<ti type="menu">

  <ti flag="button obutton " label=" " type="call_job" explain_nix="dso-add" class="fb fbAdd" explain="+ (prop,_sl_dso)" job="dso-add">
    <file id="dsis">(file,dsis)</file>
    <prop id="dsi_key">(prop,dsi_key)</prop>   
    <file id="dsos">(file,dsis)</file>
    <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>   
    
  </ti>
  
  <ti flag="button" test="(prop,has-one-dso)"  type="call_job" class="fb fbOrg" explain="(prop,_komp_dso_org)" job="do-org-me">
    <file id="orga">(file,dsis)</file>
    <prop id="orga_where"></prop>
    <prop id="orga_view_loop_id">dso_loop</prop>
    <prop id="orga_finished_job">ready-and-done-dso</prop>
    <prop id="orga_offset">dsi[@row='(prop,dsi_key)']/</prop>
    <prop id="orga_offset_label"></prop>
    <prop id="orga_offset_new_key">//</prop>
    <prop id="orga_segment_plural">dsos</prop>
    <prop id="orga_segment_singular">dso</prop>
    <prop id="orga_segment_plural_label">(prop,_pl_dso)</prop>
    <prop id="orga_segment_singular_label">(prop,_sl_dso)</prop>
    <prop id="orga_sort_attribute"></prop>
    <prop id="orga_sort_number"></prop>                                             
    <prop id="orga_name_expression_loop">()(f,text,cut_nice,(loop,dso_loop,@name),25) {(loop,dso_loop,@row)}()</prop>
    <prop id="orga_desc_expression_loop">()()</prop>

  </ti>  
  

</ti>

  
  <ti_hr_break/>
  
    <!--      <ti_space height="5px"/>
    <ti type="rec">
    <ti x="(f,html,b,o)(prop,_pl_dsb):(f,html,b,c)" span="7"/>

    <ti x="{a}" align="center" />
    <ti x="{b}" align="center" />
    <ti />
    </ti>       -->
  
  <ti label="2(e:c) (prop,_pl_dsb)"/>
  <ti_space height="3px" />
  <!-- 
  <ti type="rec">
    <ti x="2(e:c) (f,html,b,o)(prop,_pl_dsb):(f,html,b,c)" /> 
    <ti x="{a} -&gt; {b}" span="2"/>
    <ti x="explain"  />
    <ti> </ti>
              
  </ti>          -->

    
  <file id="dsbs">(file,dsis)</file> 
  <prop id="dsbs_offset">dsi[@row='(prop,dsi_key)']/</prop>
  
  <prop id="dsbs_return_job">dsb-see-all</prop>
  
  <!-- hier die geaenderte kopie von dsb-see-all -->

  <need default="//">(prop,dsbs_offset_new_key)</need>
  <prop id="nothing_dsb">1</prop>
  <loop missing_strategy="empty" id="dsb_loop" xml="(file,dsbs)" xpath="(prop,dsbs_offset)dsb">

  <prop id="nothing_dsb" test="(prop,nothing_dsb)">0</prop>

  <ti type="rec">
  
    <ti type="call_job"  explain="(f,text,cut_nice,(loop,dsb_loop,@name),50)" job="dsb-see" xflag="block">
      <prop id="dsb_key">(loop,dsb_loop,@row)</prop>
      <file id="dsbs">(file,dsbs)</file>
      <prop id="dsbs_offset">(prop,dsbs_offset)</prop>
      <prop id="dsbs_offset_label">(prop,dsbs_offset_label)</prop>
      <prop id="dsbs_offset_new_key">(prop,dsbs_offset_new_key)</prop>
      <prop id="dsbs_sort_attribute">(prop,dsbs_sort_attribute)</prop>
      <prop id="dsbs_sort_number">(prop,dsbs_sort_number)</prop>
      <prop id="dsbs_sort_ignore_case">(prop,dsbs_sort_ignore_case)</prop>
      <prop id="dsbs_sort_desc">(prop,dsbs_sort_desc)</prop>
      <prop id="dsbs_where">(prop,dsbs_where)</prop>
      <prop id="dsbs_return_job">(prop,dsbs_return_job)</prop>
      <file id="dsis">(file,dsis)</file>
      <prop id="dsis_offset">(prop,dsis_offset)</prop>
      <prop id="dsis_offset_label">(prop,dsis_offset_label)</prop>
      <prop id="dsis_offset_new_key">(prop,dsis_offset_new_key)</prop>
      <prop id="dsis_sort_attribute">(prop,dsis_sort_attribute)</prop>
      <prop id="dsis_sort_number">(prop,dsis_sort_number)</prop>
      <prop id="dsis_sort_ignore_case">(prop,dsis_sort_ignore_case)</prop>
      <prop id="dsis_sort_desc">(prop,dsis_sort_desc)</prop>
      <prop id="dsis_where">(prop,dsis_where)</prop>
      <prop id="dsis_return_job">(prop,dsis_return_job)</prop>
      <prop id="dsi_key">(prop,dsi_key)</prop>
    </ti>  
                                                                                                     <!-- pfeil -->
    <ti type="call_job" flag="button obutton" span="2" explain="(loop,dsb_loop,@dso_from_row) &#8594; (loop,dsb_loop,@dso_to_row)" 
    class="fx fxAction justedit justeditbeziehung" job="dsb-edit">
      <prop id="dsb_key">(loop,dsb_loop,@row)</prop>
      <file id="dsbs">(file,dsbs)</file>
      <prop id="dsbs_offset">(prop,dsbs_offset)</prop>
      <prop id="dsbs_offset_label">(prop,dsbs_offset_label)</prop>
      <prop id="dsbs_offset_new_key">(prop,dsbs_offset_new_key)</prop>
      <prop id="dsbs_sort_attribute">(prop,dsbs_sort_attribute)</prop>
      <prop id="dsbs_sort_number">(prop,dsbs_sort_number)</prop>
      <prop id="dsbs_sort_ignore_case">(prop,dsbs_sort_ignore_case)</prop>
      <prop id="dsbs_sort_desc">(prop,dsbs_sort_desc)</prop>
      <prop id="dsbs_where">(prop,dsbs_where)</prop>
      <prop id="dsbs_return_job">(prop,dsbs_return_job)</prop>
      <file id="dsis">(file,dsis)</file>
      <prop id="dsis_offset">(prop,dsis_offset)</prop>
      <prop id="dsis_offset_label">(prop,dsis_offset_label)</prop>
      <prop id="dsis_offset_new_key">(prop,dsis_offset_new_key)</prop>
      <prop id="dsis_sort_attribute">(prop,dsis_sort_attribute)</prop>
      <prop id="dsis_sort_number">(prop,dsis_sort_number)</prop>
      <prop id="dsis_sort_ignore_case">(prop,dsis_sort_ignore_case)</prop>
      <prop id="dsis_sort_desc">(prop,dsis_sort_desc)</prop>
      <prop id="dsis_where">(prop,dsis_where)</prop>
      <prop id="dsis_return_job">(prop,dsis_return_job)</prop>
      <prop id="dsi_key">(prop,dsi_key)</prop>
      <prop id="back-to-blatt">1</prop>
    </ti>
  </ti>
</loop>

<when test="(prop,nothing_dsb)">

    <ti type="rec">
      <ti flag="wrap_word">(prop,_dsb_nothing_l)</ti>
    </ti>
    
</when>

<when test="(f,not,(f,contains,(prop,dsbs_offset),node(e:o)(e:c)))">
  <ti type="menu" >
  <ti flag="button obutton " type="call_job" explain_nix="dsb-add" class="fb fbAdd" explain="+ (prop,_sl_dsb)" job="dsb-add">
  <file id="dsbs">(file,dsbs)</file>
  <prop id="dsbs_offset">(prop,dsbs_offset)</prop>
  <prop id="dsbs_offset_label">(prop,dsbs_offset_label)</prop>
  <prop id="dsbs_offset_new_key">(prop,dsbs_offset_new_key)</prop>
  <prop id="dsbs_sort_attribute">(prop,dsbs_sort_attribute)</prop>
  <prop id="dsbs_sort_number">(prop,dsbs_sort_number)</prop>
  <prop id="dsbs_sort_ignore_case">(prop,dsbs_sort_ignore_case)</prop>
  <prop id="dsbs_sort_desc">(prop,dsbs_sort_desc)</prop>
  <prop id="dsbs_where">(prop,dsbs_where)</prop>
  <prop id="dsbs_return_job">(prop,dsbs_return_job)</prop>
  <file id="dsis">(file,dsis)</file>
  <prop id="dsis_offset">(prop,dsis_offset)</prop>
  <prop id="dsis_offset_label">(prop,dsis_offset_label)</prop>
  <prop id="dsis_offset_new_key">(prop,dsis_offset_new_key)</prop>
  <prop id="dsis_sort_attribute">(prop,dsis_sort_attribute)</prop>
  <prop id="dsis_sort_number">(prop,dsis_sort_number)</prop>
  <prop id="dsis_sort_ignore_case">(prop,dsis_sort_ignore_case)</prop>
  <prop id="dsis_sort_desc">(prop,dsis_sort_desc)</prop>
  <prop id="dsis_where">(prop,dsis_where)</prop>
  <prop id="dsis_return_job">(prop,dsis_return_job)</prop>
  <prop id="dsi_key">(prop,dsi_key)</prop>
  <prop id="back-to-blatt">1</prop>
  </ti>
  <ti flag="button" test="(f,not,(prop,nothing_dsb))" type="call_job" class="fb fbOrg" explain="(prop,_x_organize)" job="do-org-me">
  <file id="orga">(file,dsbs)</file>
  <prop id="orga_where">(prop,dsbs_where)</prop>
  <prop id="orga_view_loop_id">dsb_loop</prop>
  <prop id="orga_finished_job">ready-and-done-dsb</prop>
  <prop id="orga_offset">(prop,dsbs_offset)</prop>
  <prop id="orga_offset_label">(prop,dsbs_offset_label)</prop>
  <prop id="orga_offset_new_key">(prop,dsbs_offset_new_key)</prop>
  <prop id="orga_segment_plural">dsbs</prop>
  <prop id="orga_segment_singular">dsb</prop>
  <prop id="orga_segment_plural_label">(prop,_pl_dsb)</prop>
  <prop id="orga_segment_singular_label">(prop,_sl_dsb)</prop>
  <prop id="orga_sort_attribute">(prop,dsbs_sort_attribute)</prop>
  <prop id="orga_sort_number">(prop,dsbs_sort_number)</prop>
  <prop id="orga_where">(prop,dsbs_where)</prop>
  <prop id="orga_name_expression_loop">()(f,text,cut_nice,(loop,dsb_loop,@name),20)()</prop>
  <prop id="orga_desc_expression_loop">()()</prop>
  <file id="dsis">(file,dsis)</file>
  <prop id="dsis_offset">(prop,dsis_offset)</prop>
  <prop id="dsis_offset_label">(prop,dsis_offset_label)</prop>
  <prop id="dsis_offset_new_key">(prop,dsis_offset_new_key)</prop>
  <prop id="dsis_sort_attribute">(prop,dsis_sort_attribute)</prop>
  <prop id="dsis_sort_number">(prop,dsis_sort_number)</prop>
  <prop id="dsis_sort_ignore_case">(prop,dsis_sort_ignore_case)</prop>
  <prop id="dsis_sort_desc">(prop,dsis_sort_desc)</prop>
  <prop id="dsis_where">(prop,dsis_where)</prop>
  <prop id="dsis_return_job">(prop,dsis_return_job)</prop>
  <prop id="dsi_key">(prop,dsi_key)</prop>
  </ti>
  </ti>
</when>  
  
  <!-- dsb-see-all ende -->

  
    
  <ti_hr/>  
  
  <ti type="rec" test="(f,right,import)">
   
   
    <ti type="call_job" job="testdata-prod-record" explain="(prop,_komp_send_db)" flag="button" class="fx fxAction justgo">         
    
        <!-- <prop id="dsi_key">(prop,dsi_key)</prop>  -->
        <file id="dsis">(file,dsis)</file>
        
        <prop id="dsi_key">(prop,dsi_key)</prop>
    </ti>
  </ti>    
  
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(dir,pro)cache/chg-dsi-style.xrs" />
    <prop id="joe-in-regex" x="dsi_key|dsis" />
  </call_job>
    
  <prop id="what_gpref">teststyle</prop>
  <prop id="ready_job">hook_dsi_changed_pref</prop>
  <prop id="with_hr">0</prop>
  <call_job job="tk_gpref_show_button"/>
  
  <prop id="what_gpref">testformat</prop>
  <prop id="ready_job">hook_dsi_changed_pref</prop>
  <prop id="with_hr">0</prop>
  <call_job job="tk_gpref_show_button"/>  

</job>

