<job id="hook_dsi_details" role="hidden">

  <call_job job="blatt_get"/>
  
  <choose>
  
  <when test="(f,not,(prop,blatt))">
  

    <try_catch>
    <try>
      <ti_hr/>
      <ti label="(prop,_pl_dso):"/>
      <!-- 
      <ti type="rec">
        <ti x="(f,html,i,o)(prop,_pl_dso):(f,html,i,c)" xalign="right"/>
        <ti/>
      </ti>             -->
      <file id="dsos">(file,dsis)</file>    
      <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>
        <prop id="dsos_where">[@dsi_key='(prop,dsi_key)']</prop>
      <prop id="dsos_offset_label"/>
      <prop id="dsos_offset_new_key">//</prop>
      <prop id="dsos_sort_attribute"/>
      <prop id="dsos_sort_number"/>
      <prop id="dsos_sort_ignore_case"/>
      <prop id="dsos_sort_desc"/>
      <prop id="dsos_where"/>
      <prop id="dsos_return_job">dso-see-all</prop>
  
      <call_job job="dso-see-all"/>
    
  
      
      <ti_hr/>
      <ti type="rec">
      <ti x="(f,html,b,o)(prop,_pl_dsb):(f,html,b,c)" span="2"/>
   
      <ti x="{a}" align="center" />
      <ti x="{b}" align="center" />
      <ti />               
      </ti>    
      
      <file id="dsbs">(file,dsis)</file> 
      <prop id="dsbs_offset">dsi[@row='(prop,dsi_key)']/</prop>
      
      <prop id="dsbs_offset_label"/>
      <prop id="dsbs_offset_new_key">//</prop>
      <prop id="dsbs_sort_attribute"/>
      <prop id="dsbs_sort_number"/>
      <prop id="dsbs_sort_ignore_case"/>
      <prop id="dsbs_sort_desc"/>
      <prop id="dsbs_where"/>
      <prop id="dsbs_return_job">dsb-see-all</prop>
  
      <call_job job="dsb-see-all"/>
    
    </try>
    <catch>
      <dump_ti label="fehler"/>
    </catch>
    </try_catch>  
    <ti_hr/>
  
    <ti type="rec">
  
     
      <ti type="call_job" job="testdata-prod-record" explain="(prop,_dsi_insert_record)" 
      xalign="right" flag="button" class="fx fxAction justgo" test="(f,right,import)" >               
          <file id="dsis">(file,dsis)</file>          
          <prop id="dsi_key">(prop,dsi_key)</prop>
      </ti>
    </ti>                                                                 


    <!-- changer -->
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(dir,pro)cache/chg-dsi-style.xrs" />
    <prop id="joe-in-regex" x="dsi_key|dsis" />
  </call_job>
    
  <prop id="what_gpref">teststyle</prop>
  <prop id="ready_job">hook_dsi_changed_pref</prop>
  <prop id="with_hr">0</prop>
  <call_job job="tk_gpref_show_button"/>

  
  </when>        
  <otherwise>
    <call_job job="testdata-see-record-details" />  
  </otherwise>
  </choose>
    
</job>

<job id="testdata-did-edit-value" role="hidden">
  <need>(file,dsas) (prop,dsa_key) (prop,dsi_key) (prop,dso_key)</need>
  <call_job job="testdata-see-record">
  <file id="dsis">(file,dsas)</file>
  <prop id="dsi_key">(prop,dsi_key)</prop>
</call_job>

</job>

<job id="testdata-did-edit-value-object" role="hidden">
  <need>(file,dsos) (prop,dso_key) (prop,dsi_key) (prop,dso_key)</need>
  <call_job job="testdata-see-record">
    <file id="dsis">(file,dsos)</file>
    <prop id="dsi_key">(prop,dsi_key)</prop>
  </call_job>

</job>

<job id="testdata-did-edit-value-bez" role="hidden">
  <need>(file,dsbs) (prop,dsi_key)</need>
  <call_job job="testdata-see-record">
    <file id="dsis">(file,dsbs)</file>
    <prop id="dsi_key">(prop,dsi_key)</prop>
  </call_job>

</job>
                              
<job id="testdata-see-record" role="hidden">             
  <need>(file,dsis) (prop,dsi_key)</need>
  <need default="1">(prop,testdata-see-record-with-links)</need>
  
  <!-- <call_job test="(prop,testdata-see-record-with-links)" job="hook_dsi_see_nav_links" />    -->
  
  <file id="dsos">(file,dsis)</file>
  <file id="dsas">(file,dsis)</file>
  <!-- <prop id="_x_edit_a">- Edit</prop> -->
  <prop id="dsa_do_align_right">right</prop>
  <call_job job="dsi-see"/>
</job>
  


<job id="dsi-hook-fullEdit" role="hidden">
  <call_job job="testdata-see-record" />
</job>



<job id="Gen Pdi/Pentaho" role="hidden">
  <interpreter watch="1" test="0"/>
  <file id="s1" x="(dir,filetemp)scan1.xml"/>
  <scan out="(file,s1)" 
        dir="(dir,app)samples/import/"
        level_limit="1"/>
        
  <loop id="s1" xml="(file,s1)" xpath="file">
    <ti type="call_job" job="pdi-sample-choose" explain="(loop,s1)">
      <prop id="psc-filename" x="(loop,s1)"/>
    </ti>
  </loop>
</job>

<job id="pdi-sample-choose" role="hidden">
  <need>(prop,psc-filename)</need> 
  
  <file id="pdi-target-store" x="(dir,pro)pdi-target-store.xml"/>
  
  <call_job job="go-joe-read" >
    <file id="joe-in-store" x="(file,pdi-target-store)" />
  </call_job>
  
  <when test="(f,not,(f,has,dir,targetd))">
      <dir id="targetd" x="(dir,pro)"/>
  </when>
  
  <file id="target" x="(dir,targetd)(f,time)-(prop,psc-filename)"/>
  
  <tk flag="sum" label="Target of duplicate">
    <tk type="file" id="target" flag="save nono" label="Target-file"/>
  </tk>
  <dir id="targetd" x="(f,dir_of_file,(file,target))"/>
  
  <call_job job="go-joe-write" >
    <file id="joe-in-store" x="(file,pdi-target-store)" />
    <prop id="joe-in-regex">targetd</prop>
  </call_job>  
  
  <copy file="(dir,app)samples/import/(prop,psc-filename)"
        tofile="(file,target)"/>
        
  <ti label="Created"/>
  <ti label="File" type="file" x="(file,target)"/>
  <ti label=" ">You have to replace the db-connection-pwd and the filename with pdi</ti>
  
  

</job>

<job id="ready-and-done-dsi" role="hidden">
    
    <file id="dsis">(file,orga)</file>
    
    <call_job job="dsi-see-all"/>  
</job>

<job id="ready-and-done-dso" role="hidden">

  <call_job job="blatt_get"/>
  
  <prop id="dsi_key">(f,substring_after,(prop,orga_offset),dsi[@row=')</prop> 
  <prop id="dsi_key">(f,substring_before,(prop,dsi_key),')</prop>   
  
  <file id="dsis">(file,orga)</file>  
  
  <choose>
    <when test="(prop,blatt)">        
      <prop id="testdata-see-record-with-links">0</prop>
      <call_job job="testdata-see-record"/>        
    </when>
    
    <otherwise>
      <call_job job="dsi-see"/>
    </otherwise>
    
  </choose>
  
</job>

<job id="ready-and-done-dsb" role="hidden">

  <call_job job="blatt_get"/>
  
  <prop id="dsi_key">(f,substring_after,(prop,orga_offset),dsi[@row=')</prop> 
  <prop id="dsi_key">(f,substring_before,(prop,dsi_key),')</prop>   
  
  <file id="dsis">(file,orga)</file>  
  
  <choose>
    <when test="(prop,blatt)">        
      <prop id="testdata-see-record-with-links">0</prop>
      <call_job job="testdata-see-record"/>        
    </when>
    
    <otherwise>
      <call_job job="dsi-see"/>
    </otherwise>
    
  </choose>
  
</job>

<job id="ready-and-done-dsa" role="hidden">
  <!-- <ti>orga_offset = (prop,orga_offset)</ti> -->
  <prop id="dsi_key">(f,substring_after,(prop,orga_offset),dsi[@row=')</prop> 
  <prop id="dsi_key">(f,substring_before,(prop,dsi_key),')</prop>    
  
  <prop id="dso_key">(f,substring_after,(prop,orga_offset),dso[@row=')</prop> 
  <prop id="dso_key">(f,substring_before,(prop,dso_key),')</prop>   

  <file id="dsis">(file,orga)</file>
    
  <call_job job="blatt_get"/>  
  
  <choose>
    <when test="(prop,blatt)">        
      <prop id="testdata-see-record-with-links">0</prop>
      <call_job job="testdata-see-record"/>        
    </when>
    
    <otherwise>

        <call_job job="dso-see" >
          
            <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>
            <file id="dsis">(file,orga)</file>
            <prop id="dsi_key">(prop,dsi_key)</prop>
            <file id="dsos">(file,orga)</file>
            <prop id="dso_key">(prop,dso_key)</prop>
                       
        </call_job>   
    
    </otherwise>
    
  </choose>  
    
     
     
     <!--   
    <file id="dsos">(file,orga)</file>
      <prop id="dsos_offset">(f,substring_before,(prop,orga_offset),/dso[@row=')/</prop>                               
      <prop id="dsos_offset_label"></prop>
      <prop id="dsos_offset_new_key"></prop>
      <prop id="dsos_sort_attribute"></prop>
      <prop id="dsos_sort_number"></prop>
      <prop id="dsos_sort_ignore_case"></prop>
      <prop id="dsos_sort_desc"></prop>
      <prop id="dsos_where"></prop>
    <prop id="dsos_return_job">dso-see-all</prop>  
   
    <call_job job="dso-see"/>          -->
</job>          

<job id="testdata-see-record-details-V1" role="hidden">   
  <ti_hr style="2"/>

  
  <call_job job="tr_dsi" />
  <call_job job="tr_komp" />
  <prop id="has-one-dso">0</prop>
  <loop missing_strategy="empty" 
        id="objos" 
        xml="(file,dsis)" 
        xpath="dsi[@row=(f,xpath_string,(prop,dsi_key))]/dso">
        <prop id="has-one-dso">1</prop>
        <!-- 
        <when test="(f,eq_num,1,(loop,objos,#i))">
          <ti label="(loop,objos,..,@name)" />
        </when>     <ti_space height="4px"/>     -->
        
        
        <ti_hr style="2"  test="(f,gt_num,(loop,objos,#i),1)"/>
        <ti type="rec">
          <ti type="call_job" job="dso-edit" explain="(prop,_komp_dso_edit)" flag="button" class="fx fxAction">
            <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>
            <file id="dsos">(file,dsis)</file>
            <prop id="dso_key">(loop,objos,@row)</prop>
            <file id="dsis">(file,dsis)</file>
            <prop id="dsi_key">(prop,dsi_key)</prop>          
          </ti>                                                   
          
          
          <ti type="call_job" label=" " job="dso-see" explain="(f,html,b,o)(f,tk_sel_translate,(loop,objos,@objekttyp),(dir,repo)osel-(prop,tip-term-class).xml)(f,html,b,c) &apos;(loop,objos,@name)&apos; (f,html,b,o){(loop,objos,@row)}(f,html,b,c)">
            <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>
            <file id="dsis">(file,dsis)</file>
            <prop id="dsi_key">(prop,dsi_key)</prop>
             <file id="dsos">(file,dsis)</file>
             <prop id="dso_key">(loop,objos,@row)</prop>
          </ti>          
        </ti>
        <!-- <ti label="(loop,objos,@name) {(loop,objos,@row)}" />   -->
        <prop id="dso_key">(loop,objos,@row)</prop>
        <file id="dsas">(file,dsis)</file>
        <prop id="dsas_no_header">1</prop>
        <prop id="dsas_offset">dsi[@row='(prop,dsi_key)']/dso[@row='(loop,objos,@row)']/</prop>
        <call_job job="dsa-see-all"/>
        
        
  </loop>
  
  <when test="(f,not,(prop,has-one-dso))">
    <ti label=" ">(prop,_komp_dso_nothing)</ti>
  </when>
    
  <ti_hr style="2"/>  

  
<ti type="rec" label=" ">
  <ti flag="button obutton " label=" " type="call_job" explain_nix="dso-add" class="fx fxAdd fxAddDso" explain="+ (prop,_sl_dso)" job="dso-add">
    <file id="dsis">(file,dsis)</file>
    <prop id="dsi_key">(prop,dsi_key)</prop>   
    <file id="dsos">(file,dsis)</file>
    <prop id="dsos_offset">dsi[@row='(prop,dsi_key)']/</prop>   
  </ti>
  
  <ti flag="button" test="(prop,has-one-dso)"  type="call_job" class="fx fxOrga fxOrgaDso" explain="(prop,_komp_dso_org)" job="do-org-me">
    <file id="orga">(file,dsis)</file>
    <prop id="orga_where"></prop>
    <prop id="orga_view_loop_id">dso_loop</prop>
    <prop id="orga_finished_job">ready-and-done-dso</prop>
    <prop id="orga_offset">dsi[@row='(prop,dsi_key)']/</prop>
    <prop id="orga_offset_label"></prop>
    <prop id="orga_offset_new_key">//</prop>
    <prop id="orga_segment_plural">dsos</prop>
    <prop id="orga_segment_singular">dso</prop>
    <prop id="orga_segment_plural_label">(prop,_pl_dso)</prop>
    <prop id="orga_segment_singular_label">(prop,_sl_dso)</prop>
    <prop id="orga_sort_attribute"></prop>
    <prop id="orga_sort_number"></prop>                                             
    <prop id="orga_name_expression_loop">()(f,text,cut_nice,(loop,dso_loop,@name),25) {(loop,dso_loop,@row)}()</prop>
    <prop id="orga_desc_expression_loop">()()</prop>

  </ti>  
  

</ti>

  
  <ti_hr/>
  
    <!--      <ti_space height="5px"/>
    <ti type="rec">
    <ti x="(f,html,b,o)(prop,_pl_dsb):(f,html,b,c)" span="7"/>

    <ti x="{a}" align="center" />
    <ti x="{b}" align="center" />
    <ti />
    </ti>       -->
  
  
    <ti type="rec">
    <ti x="(f,html,b,o)(prop,_pl_dsb):(f,html,b,c)" span="2"/> 
    <ti x="{a}" align="center" />
    <ti x="{b}" align="center" />
    <ti />               
    </ti>      

    
  <file id="dsbs">(file,dsis)</file> 
  <prop id="dsbs_offset">dsi[@row='(prop,dsi_key)']/</prop>
  
  <prop id="dsbs_return_job">dsb-see-all</prop>

  <call_job job="dsb-see-all"/>  
    
  <ti_hr/>  
  
  <ti type="rec" test="(f,right,import)">
    <ti/>
   
    <ti type="call_job" job="testdata-prod-record" explain="(prop,_komp_send_db)" flag="button obutton" class="fx fxAction justgo"
        >         
    
        <!-- <prop id="dsi_key">(prop,dsi_key)</prop>  -->
        <file id="dsis">(file,dsis)</file>
        
        <prop id="dsi_key">(prop,dsi_key)</prop>
    </ti>
  </ti>    
  <!-- 
  <call_job job="gbt">
    <file id="gbt-in">(file,dsis)</file>
  </call_job>
  
  <ti type="rec" label=" ">                                                                                               
    <ti type="call_job" job="mm-op-testdata" explain="(prop,gbt-out)" flag="button obutton"  class="fx fxAction justblack">
      <prop id="mm-what">all</prop>
      <file id="mm-liste">(file,dsis)</file>
    </ti>          
  </ti>             -->
        

</job>     
        
</jobs>