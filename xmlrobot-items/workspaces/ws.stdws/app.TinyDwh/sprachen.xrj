      <prop id="_sl_object">Objekt</prop>
      
      
      <prop id="_sl_object_search_tip">Die Objekt-Suche durchsucht die Attribut-Werte nach den gegebenen Suchargumenten.</prop>
      <prop id="_sl_search_for_tip">Das Suchargument (e:o)bzw. der Text(e:c) nach dem die Datenbank durchsucht werden soll.</prop>
      <prop id="_sl_surf_id_tip">Es wird nach dieser Objekt-Id gesucht</prop>
