<job id="tr_basic_terms" role="hidden">             
   <!-- muss noch eingearbeitet werden (prop,_scripthelper)-->
   <prop id="_scripthelper">()<![CDATA[
Help:
<ti>Halli</ti>
<ti>Hallo (loop,rec,#i)</ti>
<tk type="msg" msg_type="w">Achtung</tk>

<ti_hr/><ti_break/><ti_hr_break/><ti_space heigth="3px"/>
<ti label="Hase=">(loop,rec,@hase)</ti>
<ti type="rec" label="header">
   <ti>a</ti>
   <ti>b</ti>
</ti>

<call_job job="go-joe-read">
  <file id="joe-in-store" x="(file,query-paras) (file,sqli-paras) (file,script-paras) (file,bscript-paras)" />
  <prop id="joe-in-regex" x="\$a|\$b" />
</call_job>
<call_job job="go-joe-write"/>

