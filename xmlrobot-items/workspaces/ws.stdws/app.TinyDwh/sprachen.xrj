      <prop id="_pgen_gen_define">Definieren Sie die Ktr-Ausgabe-Datei im Dataset!</prop> 
      <prop id="_pgen_gen_goingoverwrite">Wird &#252;berschrieben: </prop>
      <prop id="_pgen_gen_created">Erzeugte Fragment-Datei:</prop>      
      <prop id="_pgen_justdoku_l">Zur Dokumentation</prop>
      
    </when>
