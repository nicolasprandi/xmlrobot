<job id="tr_sqli" role="hidden">
<!--
<call_job job="tr_sqli"/>
(prop,_sqli_)
-->

 <choose>
    <when test="(f,eq_text,(prop,ling),de)">
      <!-- d=deutsch -->
       <prop id="_sqli_jump_impl">Den Quellcode des referenzierten iFace-Types ansehen</prop>
       <prop id="_sqli_type_docu">iFace-Type-Doku</prop>                                
      <prop id="_sqli_tip">Ein Interface ist eine Aktion(e:s) die auf die Ergebnisse einer Abfrage angewendet wird.</prop>
      
        
      <prop id="_sqli_nodata_l">Interfaces f&#252;hren Verarbeitungsschritte basierend auf den Ergebnissen einer Abfragen aus ...</prop>
      <prop id="_sqli_act_run">Run iFace</prop>
      <prop id="_sqli_act_editnrun">Edit &amp; Run</prop>

      <prop id="_sqli_l_type">Typ</prop>
      <prop id="_sqli_t_type">Typ des Sql-Interfaces. Der Typ &apos;Private Script&apos; l&#228;sst sie Ihr eigenes Script definieren. Alle anderen Typen werden dem Stapel 'zeppelin' entnommen.</prop>
      
      <prop id="_sqli_l_name">Name</prop>
      <prop id="_sqli_t_name">Bezeichnung</prop>
      
      <prop id="_sqli_l_docu">Doku</prop>
      <prop id="_sqli_t_docu"></prop>
      
      <prop id="_sqli_l_commit">Commit</prop>
      <prop id="_sqli_t_commit">Definitionen bez&#252;glich des Umgangs mit Commits. Commits werden nur gebraucht wenn Sie Updates auf die Datenbank machen.</prop>
      
      <prop id="_sqli_l_cmt_style">Commit absetzen</prop>
      <prop id="_sqli_t_cmt_style">Soll ein Commit abgesetzt werden</prop>           
    
      <prop id="_sqli_l_cmt_size">Commit Gr&#246;sse</prop>
      <prop id="_sqli_t_cmt_size">Anzahl der Datens&#228;tze nach denen jeweils ein Commit abgesetzt werden soll</prop>
      
      <prop id="_sqli_l_db_open">Db-Er&#246;ffung</prop>
      <prop id="_sqli_t_db_open">Anforderungen an die Datenbank-Sitzung und ben&#246;tigte Schreib-Berechtigungen</prop>
      
      <prop id="_sqli_l_cmt_session">Commit-Sitzung anfordern</prop>
      <prop id="_sqli_t_cmt_session">Fordert eine commitierbare Db-Sitzung an</prop>
      
      <prop id="_sqli_l_rq_import">Import-Token anfordern</prop>
      <prop id="_sqli_t_rq_import">Fordert das systemweite Token f&#252;r die Schreibberechtigung auf den Import-Bereich an.</prop>      
      
      <prop id="_sqli_l_rq_central">Zentrale-Token anfordern</prop>
      <prop id="_sqli_t_rq_central">Fordert das systemweite Token f&#252;r die Schreibberechtigung auf den Zentral-Bereich an.</prop>
      
      <prop id="_sqli_l_max_ids">Max-Ids bereitstellen</prop>
      <prop id="_sqli_t_max_ids">Wenn Sie neue Daten in die Db einspielen wollen</prop>
      
      <prop id="_sqli_l_starters">Anfangs-Scripts</prop>
      <prop id="_sqli_t_starters">Diese Scripts werden in der Anfangs-Phase ausgef&#252;hrt.</prop>
         
      <prop id="_sqli_l_sc_top">Zu Allererst</prop>
      <prop id="_sqli_t_sc_top">Dieses Script l&#228;uft ganz am Anfang</prop>      
      
      <prop id="_sqli_l_sc_intro">Erster Datensatz</prop>
      <prop id="_sqli_t_sc_intro">Das Script l&#228;uft einmal mit dem ersten Datensatz der Abfrage</prop>
      
      <prop id="_sqli_l_main">Haupt-Script</prop>
      <prop id="_sqli_t_main">F&#252;r jeden Datensatz</prop>
      
      <prop id="_sqli_l_sc_main">Je Datensatz</prop>
      <prop id="_sqli_t_sc_main">Script l&#228;uft f&#252;r jeden Datensatz.
Die aktuellen Daten liegen in einer loop genannt &apos;rec&apos;.</prop>        
      
      <prop id="_sqli_l_dessert">End-Scripts</prop>
      <prop id="_sqli_t_dessert">Diese Scripts werden in der End-Phase ausgef&#252;hrt.</prop>
      
      <prop id="_sqli_l_sc_extro">Abschluss</prop>
      <prop id="_sqli_t_sc_extro">Das Script l&#228;uft nachdem alle Datens&#228;tze abgearbeitet wurden</prop>
      
      <prop id="_sqli_l_sc_fin">Generelles Ende</prop>
      <prop id="_sqli_t_sc_fin">Aktionen beim Ende oder im Fehlerfall. Sofern das Script definiert ist wird es immer ausgef&#252;rt.
Stellen Sie sicher(e:s) dass dieses Script immer fehlerfrei abl&#228;uft.</prop>

      <prop id="_sqli_l_db_close">Db-Abschluss</prop>
      <prop id="_sqli_t_db_close">Umgang mit der Datenbank-Sitzung nach Durchf&#252;hrung.</prop>
            
      <prop id="_sqli_l_gb_central">Zentrale freigeben</prop>
      <prop id="_sqli_t_gb_central">Das angeforderte Token f&#252;r das Update der Zentrale wird zur&#252;ckgegeben.</prop>        
      
      <prop id="_sqli_l_gb_import">Import freigeben</prop>
      <prop id="_sqli_t_gb_import">Das angeforderte Token f&#252;r das Update des Imports wird zur&#252;ckgegeben</prop>  
      
      <prop id="_sqli_l_close_session">Sitzung schliessen</prop>
      <prop id="_sqli_t_close_session">Die Datenbanksitzung wird geschlossen.</prop>  
      
      <prop id="_sqli_t_3_al">Ja(e:s) mit Commit</prop>  
      <prop id="_sqli_t_3_if">Ja(e:s) bei commitierbarer Db-Sitzung</prop>  
      <prop id="_sqli_t_3_no">Nein</prop>   
      <prop id="_sqli_goto_query">Zur Abfrage</prop>    
      
      <prop id="_sqli_done1">Erledigt. Ausf&#252;hrung von </prop> 
      <prop id="_sqli_done2"> beendet.</prop>  
      
                              
                        
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(prop,ling),es)">
      <prop id="_pl_a">A</prop>
      <prop id="_sl_a">A</prop>  
      <prop id="_ex_b">B</prop>      
    </when>  -->  
    <otherwise>
      <!-- e=englisch -->
       <prop id="_sqli_jump_impl">Jump to source-code of referenced iFace-type</prop>
       <prop id="_sqli_type_docu">iFace-Type-Docu</prop>      
      <prop id="_sqli_done1">Done. Did run </prop> 
      <prop id="_sqli_done2">.</prop>
      
      <prop id="_sqli_tip">An Interface is an action which is applied on the results of a query.</prop>
      <prop id="_sqli_nodata_l">Interfaces perform an individual process based on the results of a query ...</prop>
      <prop id="_sqli_act_run">Run iFace</prop>
      <prop id="_sqli_act_editnrun">Edit &amp; Run</prop>

      <prop id="_sqli_l_type">Type</prop>
      <prop id="_sqli_t_type">Type of Sql-Interface. The type &apos;Private Script&apos; lets you specify your own script. Everything else is a reference to bulk named zeppelin</prop>
      
      <prop id="_sqli_l_name">Name</prop>
      <prop id="_sqli_t_name">A short and easy to remember word</prop>
      
      <prop id="_sqli_l_docu">Docu</prop>
      <prop id="_sqli_t_docu"></prop>
      
      <prop id="_sqli_l_commit">Commit</prop>
      <prop id="_sqli_t_commit">Specifications how to apply commits. Commits are only usefull if you write to the database</prop>
      
      <prop id="_sqli_l_cmt_style">Do commit</prop>
      <prop id="_sqli_t_cmt_style">Should a commit be performed</prop>           
      
      <prop id="_sqli_l_cmt_size">Commit Size</prop>
      <prop id="_sqli_t_cmt_size">Number of records for doing the commit</prop>
      
      <prop id="_sqli_l_db_open">Db-Opening</prop>
      <prop id="_sqli_t_db_open">Requirements on the database-session and requests for update-tokens</prop>
      
      <prop id="_sqli_l_cmt_session">Request Commit-Session</prop>
      <prop id="_sqli_t_cmt_session">Request a commitable db-session</prop>
      
      <prop id="_sqli_l_rq_import">Request Import-Token</prop>
      <prop id="_sqli_t_rq_import">Requests the systemwide token to update the import-area.</prop>      
      
      <prop id="_sqli_l_rq_central">Request Central-Token</prop>
      <prop id="_sqli_t_rq_central">Requests the systemwide token to update the central-area.</prop>
      
      <prop id="_sqli_l_max_ids">Provide Max-Ids</prop>
      <prop id="_sqli_t_max_ids">If you want to make inserts</prop>
      
      <prop id="_sqli_l_starters">Starting Scripts</prop>
      <prop id="_sqli_t_starters">Scripts for the inital phase of exection</prop>
      
      <prop id="_sqli_l_sc_top">Very beginning</prop>
      <prop id="_sqli_t_sc_top">Script to execute at the very beginning</prop>      
      
      <prop id="_sqli_l_sc_intro">First Record</prop>
      <prop id="_sqli_t_sc_intro">Script to execute once with the first record received</prop>
      
      <prop id="_sqli_l_main">Main Script</prop>
      <prop id="_sqli_t_main">For every Record</prop>
      
      <prop id="_sqli_l_sc_main">Each Record</prop>
      <prop id="_sqli_t_sc_main">Script to be executed for every record.
Find the data in a loop called &apos;rec&apos;.</prop>        
      
      <prop id="_sqli_l_dessert">Ending Scripts</prop>
      <prop id="_sqli_t_dessert">Scripts for the clearup-phase of the execution</prop>
      
      <prop id="_sqli_l_sc_extro">End</prop>
      <prop id="_sqli_t_sc_extro">Script to execute when all records are processed</prop>
      
      <prop id="_sqli_l_sc_fin">After all</prop>
      <prop id="_sqli_t_sc_fin">Finally(e:s) applied at the end and in case of failure. If defnied(e:s) the script will always be executed.
Make sure that it runs without any error!</prop>
      
      <prop id="_sqli_l_db_close">Db-Termination</prop>
      <prop id="_sqli_t_db_close">How to deal with the database-session when everything is done</prop>
            
      <prop id="_sqli_l_gb_central">Free Central</prop>
      <prop id="_sqli_t_gb_central">Gives back the update-token for the central area</prop>        
      
      <prop id="_sqli_l_gb_import">Free Import</prop>
      <prop id="_sqli_t_gb_import">Gives back the update-token for the import-area</prop>  
      
      <prop id="_sqli_l_close_session">Close Session</prop>
      <prop id="_sqli_t_close_session">Will close the database-session</prop>    
      
      <prop id="_sqli_t_3_al">Yes(e:s) with commit</prop>  
      <prop id="_sqli_t_3_if">Yes(e:s) when commitable db-session</prop>  
      <prop id="_sqli_t_3_no">No</prop>     
      
      <prop id="_sqli_goto_query">See query</prop>   
      
     
    </otherwise>
  </choose>

</job>
