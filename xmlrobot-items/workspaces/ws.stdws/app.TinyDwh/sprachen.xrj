      <prop id="_shorty_waehlensie2">Run this sql-script in your database-console</prop>      
      <prop id="_shorty_inorig">In Original Manner</prop>
      <prop id="_shorty_from_pg_bu">From Postgres-Backup</prop>
      <prop id="_shorty_from_ms_bu">From MySql-Backup</prop>
      <prop id="_shorty_erklaer">Explainations</prop>
