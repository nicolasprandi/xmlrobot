<job id="tr_sql" role="hidden">


 <choose>
    <when test="(f,eq_text,(prop,ling),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_sql_l">Konfiguration der Limits</prop>
      <prop id="_sql_l_desc">Parameter der Limit-Konfiguration</prop>
      <prop id="_sql_t">Diverse Mengen-Beschr&#228;nkungen auf der Benutzeroberfl&#228;che um Resourcen zu sparen.</prop>
      
      <prop id="_sql_msg_db_l">Datenbank-Anfragen</prop>
      <prop id="_sql_msg_db_t">Beschr&#228;nkung der Ergebnisse von Datenbank-Abfragen mit einer maximalen Anzahl von zur&#252;ckgelieferten Zeilen.</prop>
      
      <prop id="_sql_limit_staticstics_l">Statistiken</prop>
      <prop id="_sql_limit_staticstics_t">Beschr&#228;nkung der Abfrage-Ergebnisse bei den Statistiken (e:o)Men&#252;punkt Statistics(e:c). &#xA;Wird das Limit bei einer konkreten Ausf&#252;hrung erreicht(e:s) so erfolgt keine Mitteilung an den Benutzer.</prop>

      <prop id="_sql_limit_tabs_l">Tabellen-List</prop>
      <prop id="_sql_limit_tabs_t">Anzahl der gelisteten Datens&#228;tze im Men&#252;punkt 'Tabellen'</prop>
      
      <prop id="_sql_limit_queries_l">Sql-Abfrage</prop>
      <prop id="_sql_limit_queries_t">Beschr&#228;nkung der Abfrage-Ergebnisse bei den eigenen Db-Abfragen &#xA;Wird das Limit bei einer konkreten Ausf&#252;hrung erreicht(e:s) so erfolgt keine Mitteilung an den Benutzer.</prop>
      
      <prop id="_sql_limit_mv_l">Mat.Views</prop>
      <prop id="_sql_limit_mv_t">Beschr&#228;nkung der Abfrage-Ergebnisse bei einem 'Abfragen' auf die Materialized Views. Hier wird nur die Vorschau limitiert(e:s) nicht die Materialized View an sich. &#xA;Wird das Limit bei einer konkreten Ausf&#252;hrung erreicht(e:s) so erfolgt keine Mitteilung an den Benutzer.</prop>
      
      <prop id="_sql_msg_ui_l">Benutzer-Oberfl&#228;che</prop>  
      <prop id="_sql_numval_msg">Zahl</prop> 

      <prop id="_sql_limit_bez_l">Beziehungen</prop>
      <prop id="_sql_limit_bez_t">Limitiert die Anzahl der angezeigten Beziehungen pro Beziehungstyps bei der Objekt-Darstellung. &#xA;Wurde das Limit bei einer konkreten Ausf&#252;hrung erreicht(e:s) so k&#246;nnen die &#252;bergangenen Beziehungen per Link angezeigt werden.</prop>
      
      <prop id="_sql_limit_obj_l">Objekte</prop>
      <prop id="_sql_limit_obj_t">Limitiert die Anzahl der angezeigten Objekte je Objekttyp bei der &#220;bersichtsdarstellung (e:o)Men&#252;punkt Objekte(e:c). &#xA;Wurde das Limit bei einer konkreten Ausf&#252;hrung erreicht(e:s) so k&#246;nnen die &#252;bergangenen Objekte per Link angezeigt werden.</prop>
      
      <prop id="_sql_limit_print_l">Druck-Zeilen/Print</prop>
      <prop id="_sql_limit_print_t">Limitiert die Anzahl der angezeigten Zeilen beim Andrucken von Dateien</prop>      
      
                                   
      <prop id="_sql_limit_search_l">Suche</prop>
      <prop id="_sql_limit_search_t">Limitiert die Anzahl der angezeigten Suchergebnisse. Wird das Limit bei einer konkreten Ausf&#252;hrung erreicht(e:s) so erfolgt keine Mitteilung an den Benutzer.</prop>
  
      
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(prop,ling),es)" lang="es">
      <prop id="_pl_a">A</prop>
      <prop id="_sl_a">A</prop>  
      <prop id="_ex_b">B</prop>      
    </when>  -->  
    <when test="1" lang="en">
      <!-- e=englisch -->
      <prop id="_sql_l">Configuration of Limits</prop>
      <prop id="_sql_l_desc">Parameters of the Limit-Configuration</prop>
      <prop id="_sql_t">Some limitations regarding amount of data in order to save resources.</prop>
      
      <prop id="_sql_msg_db_l">Database-Requests</prop>
      <prop id="_sql_msg_db_t">Limitation of database-requests based on a maximum number of result-records.</prop>      

      <prop id="_sql_limit_tabs_l">Tables-List</prop>
      <prop id="_sql_limit_tabs_t">Number of listed rows in menu 'Tables'</prop>
            
      <prop id="_sql_limit_staticstics_l">Statistics</prop>
      <prop id="_sql_limit_staticstics_t">Limitation of result-rows of the statistics (e:o)Menu Statistics(e:c). &#xA;There will be no information in case a request did reach the limit.</prop>
      
      <prop id="_sql_limit_queries_l">Sql-Queries</prop>
      <prop id="_sql_limit_queries_t">Limitation of result-rows of your queries  (e:o)Menu Search(e:c). &#xA;There will be no information in case a request did reach the limit.</prop>
      
      <prop id="_sql_limit_mv_l">Mat.Views</prop>
      <prop id="_sql_limit_mv_t">Limitation of result-rows of the 'Select' on the Menu 'Materialized Views'. This will only limit the preview(e:s) real data stays as it is. &#xA;There will be no information in case a request did reach the limit.</prop>
      
      <prop id="_sql_msg_ui_l">User-Interface</prop>  
      <prop id="_sql_numval_msg">Number</prop> 

      <prop id="_sql_limit_bez_l">Relations</prop>
      <prop id="_sql_limit_bez_t">Limits the number of relations which are listed in the displayment of an object. The limit applies to each type of relation. &#xA;As soon as the limit is reached in a specific request(e:s) neglected relations can be viewed by clicking on a link.</prop>
      
      <prop id="_sql_limit_obj_l">Objects</prop>
      <prop id="_sql_limit_obj_t">Limits the number of objects listed for one type of object in the overview (e:o)Menu Objects(e:c). &#xA;As soon as the limit has been reached in a specific request(e:s) neglected objects can be viewed by clicking on a link.</prop>
      
      <prop id="_sql_limit_print_l">Printed rows/Print</prop>
      <prop id="_sql_limit_print_t">Limits the number of printed rows when displaying an entire file</prop>       
      
      <prop id="_sql_limit_search_l">Search</prop>
      <prop id="_sql_limit_search_t">Limits the number of results of a search. As soon as a specific search-request reaches this limit(e:s) a message will be provided for the user.</prop>      
    </when>
  </choose>

</job>


