<job id="tr_mvc" role="hidden">

  <choose>
    <when test="(f,eq_text,(prop,ling),de)">
      <!-- d=deutsch -->

      <!-- words -->
      <prop id="_mvc_tk_l">Regeln der Namensgebung</prop>

      <!-- fields -->
      <prop id="_mvc_s_style_name">Technische Kurz-NAMEN</prop>
      <prop id="_mvc_s_style_incog">NUMERIsche Typen (e:o)Inkognito(e:c)</prop> 
      
 

      <prop id="_mvc_l_style">Namenskern</prop>
      <prop id="_mvc_t_style">W&#228;hlen Sie [(prop,_mvc_s_style_name)](e:s) um mit lesbaren Namen zu arbeiten.
W&#228;hlen Sie [(prop,_mvc_s_style_incog)] um mit den internen(e:s) technischen Typen-Nummern auf die Daten zuzugreifen.</prop>

      <prop id="_mvc_tk_t">Diese Parameter beeinflussen die Benennung von Tabellen und Feldern der generierten Materialized Views.
Bei den Materialized Views werden sowohl die effektiv verwendeten Materialized Views als auch gewissse 'Vorstufen' dieser MV's in Form von klassischen Views erzeugt.
Verwenden Sie die Option [(prop,_mvc_s_style_incog)] um eine unerw&#252;nschte Interpretetation der Daten auf dem Db-Server zu hintanzustellen.
</prop>
      
      <prop id="_mvc_l_prefix">Mv-Prefix</prop>
      <prop id="_mvc_t_prefix">Dieser Text wird den Namen der Materialized Views an den Anfang gestellt.</prop>

      <prop id="_mvc_l_prefix_view">View-Prefix</prop>
      <prop id="_mvc_t_prefix_view">Dieser Text wird den Namen der internen Views an den Anfang gestellt.</prop>

    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(prop,ling),es)">
      <prop id="_pl_a">A</prop>
      <prop id="_sl_a">A</prop>  
      <prop id="_ex_b">B</prop>      
    </when>  -->  
    <otherwise>
      <!-- e=englisch -->
      <!-- words -->
      <prop id="_mvc_tk_l">Rules for names</prop>

      <!-- fields -->
  
      <prop id="_mvc_s_style_name">Technical Short-CUTS</prop>
      <prop id="_mvc_s_style_incog">NUMERIcal Types (e:o)Incognito(e:c)</prop>       

      <prop id="_mvc_l_style">Cernel of Name</prop>
      <prop id="_mvc_t_style">Select [(prop,_mvc_s_style_name)] in order to work with human-readable names.
Select [(prop,_mvc_s_style_incog)] in order to work with the internal(e:s) technical(e:s) numerical types.</prop>

      <prop id="_mvc_tk_t">These parameters determine the given names of tables and fields of the generated Materialized Views.
The configured process of generation creates the effectively used Materialized Views as well as certain 'prestages' in the form of classical views.
Use the option [(prop,_mvc_s_style_incog)] if you want to minimize the capabilities of 3rd-parties to interpret the data of the db-server.
</prop>
      
      <prop id="_mvc_l_prefix">Mv-Prefix</prop>
      <prop id="_mvc_t_prefix">This text will be put at the beginning of the names of the Materialized Views.</prop>

      <prop id="_mvc_l_prefix_view">View-Prefix</prop>
      <prop id="_mvc_t_prefix_view">This text will be put at the beginning of the names of the internal prestaged views.</prop>
    </otherwise>
  </choose>

</job>

