<job id="tr_dsi" role="hidden">
 <choose>
    <when test="(f,eq_text,(prop,ling),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_dsi_d">Beschreibung der Paramater eines Datensatzes:</prop>
      <prop id="_dsi_t">Ein Datensatz steht f&#252;r einen zu importierenden Datenbestand. Ein Dataset wird durch einen Import-Job und eine Import-Transformation eingebracht. F&#252;r diesen Import-Job werden Kettle-Fragmente erzeugt. Diese Fragemente unterst&#252;tzen bei der Programmierung der Transformation(e:s) sie ersetzen jedoch nicht das Programmieren.</prop>
      <prop id="_dsi_nothing_l">Ein Datensatz stellt eine Zeile Ihrer Eingabeliste dar und kann mehrere Objekte beinhalten ...</prop>
      
      <prop id="_dsi_name_l">Name</prop>
      <prop id="_dsi_name_t">Kurze Bezeichnung</prop>   
      <!-- 
Ue &#220;
ue &#252;
Oe &#214;
oe &#246;                                      
Ae &#196;
ae &#228;         -->
      <prop id="_dsi_cat_l">Kategorie</prop>
      <prop id="_dsi_cat_t">()Ordnen Sie hier Ihre Datens&#228;tze nach Kategorien bzw. nach den F&#228;llen, die dieser Datensatz abdeckt.()</prop>   
      
      <prop id="_dsi_stat_l">Status</prop>
      <prop id="_dsi_stat_t">()In welchem Arbeits-Status befindet sich dieser Datensatz. zb: Idee, In Vorbereitung, In Arbeit, Zur&#252;ckgestellt, Fertiggestellt.()</prop>       
                     
      <prop id="_dsi_docu_l">Doku</prop>
      <prop id="_dsi_docu_t">Beschreibungstext</prop> 
      
      <prop id="_dsi_insert_all">Alle Datens&#228;tze an Db senden</prop>   
      <prop id="_dsi_insert_record">Schicke Datensatz zur Db</prop> 
      
             
      <prop id="_dsi_act_db">An Db senden</prop>
      
      <!-- 
      <prop id="_dsi_act_fulledit">Zum Kompakt-Modus</prop>  
      <prop id="_dsi_act_simple">Zum Stufen-Modus</prop> 
      <prop id="_dsi_act_full">Zum Kompakt-Modus</prop>      -->              
      
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(prop,ling),es)" lang="es">
      <prop id="_pl_a">A</prop>
      <prop id="_sl_a">A</prop>  
      <prop id="_ex_b">B</prop>      
    </when>  -->  
    <when test="1" lang="en">
      <!-- e=englisch -->
      <prop id="_dsi_d">Parameters of a record:</prop>
      <prop id="_dsi_t">A record is regarded as a file which should be importet into Hibiscus. A dataset will be imported by one Import-Job and one Import-Transformation. For this transformation (e:o)which you are working on(e:c) some Kettle-Fragments will be generated and in order to support the development of the transformation.</prop>
      <prop id="_dsi_nothing_l">A record consists of a number of objects and is similar to a row in a input-list ...</prop>
              
      <prop id="_dsi_name_l">Name</prop>
      <prop id="_dsi_name_t">A short term</prop>      

      <prop id="_dsi_cat_l">Category</prop>
      <prop id="_dsi_cat_t"></prop>   
      
      <prop id="_dsi_stat_l">State</prop>
      <prop id="_dsi_stat_t">()In which state is the progress of your work on this record. ()</prop>      
            
      <prop id="_dsi_docu_l">Docu</prop>
      <prop id="_dsi_docu_t"></prop>   
      
      
      <prop id="_dsi_insert_all">Send all records to Db</prop>   
                        
      <prop id="_dsi_act_db">Send to Db</prop> 
      <prop id="_dsi_insert_record">Send record to db</prop>
      <!-- 
      <prop id="_dsi_act_fulledit">Go Compact-Mode</prop> 
