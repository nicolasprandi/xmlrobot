ae &#228; -->
  <choose>
    <when test="(f,eq_text,(prop,ling),de)">
      <!-- d=deutsch -->

      <!-- formix general -->
      <prop id="_past_tip">Historische Suche</prop>
      <prop id="_past_nodata_l">Keine historischen Suchdaten</prop>
      <prop id="_past_singular_l">Historische Suche</prop>
      <prop id="_past_plural_l">Historische Suchen</prop>
      
      <prop id="_past_goto">Alle Suchen</prop>  
      <prop id="_past_delall">Alle historischen Suchen l&#246;schen</prop>

      <!-- actions -->
      <prop id="_past_act_defnrun">Edit &amp; Go</prop>
      <prop id="_past_act_run">Suchen</prop>
      <prop id="_past_act_classic">Suche</prop>

      <!-- tk -->

      
      <prop id="_past_args">Such-Argumente</prop>

      <!-- fields -->      
      <prop id="_past_for_l">Suche nach</prop>
      <prop id="_past_for_t">Das Suchargument (e:o)bzw. der Text(e:c) nach dem die Datenbank durchsucht werden soll.</prop>   
         
      <prop id="_past_s_type_contains">Beinhaltet Text</prop>
      <prop id="_past_s_type_equals">Ist Text</prop>
      <prop id="_past_s_type_numeric">Ist Zahl</prop>
      <prop id="_past_s_type_objid">Ist Objekt-Id</prop>  
                 
      <prop id="_past_type_l">Art der Suche</prop>
      <prop id="_past_type_t">()Definiert, wie das Suchargument interpretiert wird.()
[(prop,_past_s_type_contains)] - &#220;berpr&#252;ft(e:s) ob das Suchargument in einem Begriff enthalten ist
[(prop,_past_s_type_equals)] - Sucht genau nach dem gegebenen Suchargument
[(prop,_past_s_type_numeric)] - Sucht nach einer Zahl(e:s) das Suchargument muss numerisch sein</prop>
      
    
                  
      <prop id="_past_only_in">Suche nur in ...</prop>
            
      <prop id="_past_otyp_l">in Objekt-Typen</prop>
      <prop id="_past_otyp_t">Die Suche erfolgt nur in diesen Objekt-Typen</prop>
      
      <prop id="_past_atyp_l">in Attribut-Typen</prop>
      <prop id="_past_atyp_t">Die Suche erfolgt nur in diesen Attribut-Typen</prop>      

    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(prop,ling),es)">
      <prop id="_pl_a">A</prop>
      <prop id="_sl_a">A</prop>  
      <prop id="_ex_b">B</prop>      
    </when>  -->  
    <otherwise>
      <!-- e=englisch -->
      
      <prop id="_past_tip">Historical Search</prop>
      <prop id="_past_nodata_l">No historical searches</prop>
      <prop id="_past_singular_l">Historical Search</prop>
      <prop id="_past_plural_l">Historical Searches</prop>
      
      <prop id="_past_goto">All searches</prop>  
      <prop id="_past_delall">Delete all historical Searches</prop>

      <!-- actions -->
      <prop id="_past_act_defnrun">Edit &amp; Go</prop>
      <prop id="_past_act_run">Search</prop>
      <prop id="_past_act_classic">Search</prop>

      <!-- tk -->

      <!-- fields -->      
      
      <prop id="_past_for_l">Search for</prop>
      <prop id="_past_for_t">The search-argument (e:o)eg. a text(e:c) which will be looked up for in the database.</prop>       

      <prop id="_past_s_type_contains">Contains Text</prop>
      <prop id="_past_s_type_equals">Is Text</prop>
      <prop id="_past_s_type_numeric">Is Numer</prop>
      <prop id="_past_s_type_objid">Is Object-Id</prop>  
                 
      <prop id="_past_type_l">Type of search</prop>
      <prop id="_past_type_t">()Specifies, how the search-argument is interpreted.()
[(prop,_past_s_type_contains)] - Checks(e:s) if the search-argument is part of something or included      
[(prop,_past_s_type_equals)] - Searches exactly for the search-argument
[(prop,_past_s_type_numeric)] - Searches for a number(e:s) the search-argument has to be numeric</prop>
                       
      <prop id="_past_only_in">Search only in ...</prop>
            
      <prop id="_past_otyp_l">in object-types</prop>
      <prop id="_past_otyp_t">The search happens only in these types of objects</prop>
      
      <prop id="_past_atyp_l">in attribute-types</prop>
      <prop id="_past_atyp_t">The search happens only in these types of attributes</prop>           
      <prop id="_past_args">Search-Arguments</prop>

    </otherwise>
  </choose>

</job>

