    </when>
  </choose>
</job>


<job id="tr_dsb" role="hidden">

 <choose>
    <when test="(f,eq_text,(prop,ling),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_dsb_d">Parameter einer Dataset-Beziehung:</prop>
      <prop id="_dsb_t">Eine Beziehung(e:s) die durch den Import des Datasets erzeugt wird. Durch ein Dataset werden mit aller Wahrscheinlichkeit mehrere Beziehungen entstehen.</prop>
      <prop id="_dsb_nothing_l">Verkn&#252;pfen Sie 2 Objekte durch eine Beziehung.</prop>
            
      <prop id="_dsb_btyp_l">Beziehungs-Typ</prop>
