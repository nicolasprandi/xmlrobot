      <prop id="_sl_reached">wurde erreicht.</prop>  
      <prop id="_sl_no_repo">Kein Repository gefunden. Dieses wird f&#252;r die Suche ben&#246;tigt.</prop>  
      <prop id="_sl_search_args">Such-Argumente</prop>   
    </when>
