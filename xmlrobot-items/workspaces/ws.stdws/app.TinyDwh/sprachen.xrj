      <!-- d=deutsch -->
                                
      <prop id="_cc_tk_l">Privilegien aktivieren</prop>      
<prop id="_cc_tk_t">()Verwenden Sie diese Parameterleiste um die folgenden zwei Berechtigungen letztendlich zur Anwendung zu bringen. Entsprechend Ihrer gew&#228;hlten Privilegien wird sich die App anders verhalten.()</prop>        
      
      <!-- formix fields -->
      <prop id="_cc_l_db">Meine Db</prop>
      <prop id="_cc_t_db">()Verbinden Sie sich zu einer eigenen Datenbank indem Sie die Datenbankverbindung, den Benutzernamen und das Kennwort eingeben.()</prop>
      
      <prop id="_cc_l_repo">Mein Vokabular</prop>
      <prop id="_cc_t_repo">()Definieren Sie eigene Feld-Typen, Objekt-Typen und Beziehungs-Typen in der Datenbank. Bearbeiten Sie dazu das Excel-Vokabular, importieren Sie es und spielen Sie es in die Datenbank ein.()</prop>                                                 

      <prop id="_cc_l_dev">Meine Scripts</prop>
      <prop id="_cc_t_dev">()Script-Entwicklung im Projekt. Definieren Sie Abfragen, Programmieren Sie Sql-Interfaces und Automatisieren Sie die Abl&#228;ufe mit Stapel-Aktionen.()</prop>                                                 

      <prop id="_cc_l_ref">Mein Script-Ort</prop>
      <prop id="_cc_t_ref">(e:o)dir(e:s)goMoon(e:c) Speicherort der Abfragen und Stapel.</prop>                                                 

      <prop id="_cc_l_rebuild">Erm&#246;gliche Index-Rebuild</prop>
      <prop id="_cc_t_rebuild">()Erm&#246;glicht den Neuaufbau der Indizies w&#228;hrend der Integration.()</prop>                                                 

      <prop id="_cc_l_rebuild">Integration</prop>
      <prop id="_cc_l_rebuild_fast">()Nur Schnell-Integration()</prop>                                                 
      <prop id="_cc_l_rebuild_full">()Schnell- &amp; Massen-Integration()</prop>       
      <prop id="_cc_t_rebuild">[(prop,_cc_l_rebuild_full)]: ()Erm&#246;glicht den Neuaufbau der Indizies w&#228;hrend der Integration. Ist f&#252;r die Integration grosser Datenmengen geeignet.()
[(prop,_cc_l_rebuild_fast)]: ()L&#228;sst nur die Schnell-Integration zu. Dabei kommt es zu keinem performanten Management der Indizes und es k&#246;nnen nur kleine Datenmengen integriert werden.()</prop>                                                 
                                                

    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(prop,ling),es)">
      <prop id="_pl_a">A</prop>
      <prop id="_sl_a">A</prop>  
      <prop id="_ex_b">B</prop>      
    </when>  -->  
    <otherwise>
      <!-- e=englisch -->
     
      <prop id="_cc_tk_l">Activate privilegs</prop>      
<prop id="_cc_tk_t">()Use these Parameters to apply the following two privilegs. Depending on your specifications the app will react differentely.()</prop>        
      
      <!-- formix fields -->
      <prop id="_cc_l_db">My Db</prop>
      <prop id="_cc_t_db">()Connect to your own database by specifying the connection, the user-name and the password.()</prop>
      
      <prop id="_cc_l_repo">My Vocabulary</prop>
      <prop id="_cc_t_repo">()Define your own field-types, object-types and relation-type in the database. Therefore edit the Excel-Vocabulary, import it and load it to the database.()</prop> 
      
      <prop id="_cc_l_dev">My Scripts</prop>
      <prop id="_cc_t_dev">()Develope scripts within the project. 
Specify query, programm Sql-Interfaces and configure automation with bulks.()</prop>                                                 
      <prop id="_cc_l_ref">My Script-Location</prop>
      <prop id="_cc_t_ref">(e:o)dir(e:s)goMoon(e:c) Home of Queries and Bulks</prop>                                                 

      <prop id="_cc_l_rebuild">Integration</prop>
      <prop id="_cc_l_rebuild_fast">()Only Fast-Integration()</prop>                                                 
      <prop id="_cc_l_rebuild_full">()Fast- &amp; Mass-Integration()</prop>       
      <prop id="_cc_t_rebuild">[(prop,_cc_l_rebuild_full)]: ()Enables the entire setup of the Indizes during Integration. This allows the integration of high-volume data-amounts.()
[(prop,_cc_l_rebuild_fast)]: ()Allows only the Fast-Integration. The performant management of indizes will not be applied and therefore only small amounts of data may be integrated.()</prop>                                                 
     
    </otherwise>
  </choose>

</job>
