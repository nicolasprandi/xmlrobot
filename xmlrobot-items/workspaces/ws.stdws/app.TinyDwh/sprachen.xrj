</job>


<job id="tr_nav" role="hidden">

 <choose>
    <when test="(f,eq_text,(prop,ling),de)" lang="de">
      <!-- d=deutsch -->
      
      <prop id="_nav_naming_attribute_l">Vokabular-Begriffe</prop>

      
      <prop id="_nav_naming_attribute_name_l">Reale Namen</prop>
      <prop id="_nav_naming_attribute_tech_l">Technische Kurznamen</prop>
      
      <prop id="_nav_naming_attribute_t">Die Art der Bezeichnung f&#252;r die Benennung von Datenfeldern der Hibiscus-Datenbank.
[(prop,_nav_naming_attribute_name_l)] - Es werden Ihnen f&#252;r Menschen verst&#228;ndliche Begriffe angezeigt.
[(prop,_nav_naming_attribute_tech_l)] - Es werden Ihnen die Spaltennamen der Materialized Views angezeigt.</prop> 
      
      <prop id="_nav_l">Konfiguration der Objekt-Darstellung</prop>
      <prop id="_nav_l_desc">Parameter der Objekt-Darstellung</prop>
      <prop id="_nav_t">()Die sogenannte 'Objekt-Darstellung' ist f&#252;r die Anzeige eines Objektes in der Hibiscus-Applikation zust&#228;ndig. Sie listet die Attribute mit den Werten. Sie listet auch die Beziehungen zu anderen Objekten.()</prop>
      
      <prop id="_nav_msg_werte_l">Mehrfach-Werte</prop>
      <!-- 
      <prop id="_nav_msg_werte_t">jsaldf kasjfljf lakjdfjkdfl kldfjjalfj alkdfjlsjf ladjfklsadjf ladjflajsdlkfj lakdjflajdfj lskadfjlkaf</prop>                   -->

      <prop id="_nav_only_latest_values_0_l">Alle Werte je Attribut anzeigen</prop>	
      <prop id="_nav_only_latest_values_1_l">Nur letztg&#252;ltigen Wert zeigen (e:o)Top-Wert(e:c)</prop>
      
      <prop id="_nav_only_latest_values_l">Zu listende Werte</prop>
      <prop id="_nav_only_latest_values_t">Steuert das Verhalten f&#252;r den Fall(e:s) dass mehrere Werte zu einem Attribut vorhanden sind.
[(prop,_nav_only_latest_values_1_l)] - Nur der letzt-g&#252;ltige Wert wird angezeigt(e:s) der mit dem [Top-Kennzeichen] 
[(prop,_nav_only_latest_values_0_l)] - Es wird alles gelistet</prop>



      <prop id="_nav_msg_props_l">Dat&#252;mer</prop>
      <prop id="_nav_msg_props_t">Angezeigte Informationen je Wert</prop>
      
      <prop id="_nav_vonbis_l">Von/Bis-Datum</prop>
      <prop id="_nav_vonbis_t">Entscheidet(e:s) ob das [Von-Datum] und das [Bis-Datum] angezeigt werden. Die beiden Dat&#252;mer beschreiben f&#252;r welchen Zeitraum ein Wert G&#252;ltigkeit besitzt.</prop>
      
      <prop id="_nav_wann_l">Import-Zeit</prop>
      <prop id="_nav_wann_t">Entscheidet(e:s) ob die [Import-Zeit] des Wertes angezeigt wird. Die [Import-Zeit] beschreibt jenen Zeitpunkt(e:s) zu dem der Wert in die Hibiscus-Datenbank eingebracht wurde.</prop>
      
      <prop id="_nav_top_l">Top-Kennzeichen</prop>
      <prop id="_nav_top_t">Entscheidet(e:s) ob das [Top-Kennzeichen] angezeigt wird. Das [Top-Kennzeichen] ist von Relevanz(e:s) wenn mehrere Werte zu einem einzigen Attribut vorhanden sind. In diesem Fall muss ein sogenannter 'letztg&#252;liger' Wert auserkoren werden. Dieser letztg&#252;ltige(e:s) mit dem [Top-Kennzeichen] markierte Wert wird immer dann verwendet(e:s) wenn nur eine einziger Wert gebraucht wird. Dies ist bei den Materialized-Views der Fall. Dies ist auch  in der Objekt-Darstellung der Fall(e:s) sofern bei der Option '(prop,_nav_only_latest_values_l)'  die Variante '(prop,_nav_only_latest_values_0_l)' gew&#228;hlt wurde.</prop>                        
      
      <prop id="_nav_keys_l">ID's der Datenbank</prop>
      <prop id="_nav_keys_t">Die in der Datenbank verwendeten technischen(e:s) datensatz-identifizierenden(e:s) numerischen Schl&#252;ssel.</prop>
      
      <prop id="_nav_msg_detailinfos_l">Details</prop>
      <prop id="_nav_msg_tech_l">Technisches</prop>
      <prop id="_nav_msg_terms_l">Begriffe</prop>
      
      <prop id="_nav_link_wert_l">Doku-Link je Wert</prop>
      <prop id="_nav_link_wert_t">Entscheidet(e:s) ob ein weiterf&#252;hrender Link pro Wert angezeigt wird. Unter dem Link sind zus&#228;tzliche(e:s) technische Informationen verf&#252;gbar.</prop>
  
      
      
      <prop id="_nav_msg_others_l">Weiters ...</prop>

      
      <prop id="_nav_msg_zahlenformat_l">Zahlenformatierung</prop>
                                      
      <prop id="_nav_vk_l">Trennungszeichen</prop>
      <prop id="_nav_vk_t">Regelt(e:s) wie mit der Tausender-Darstellungen und dem Dezimal-Zeichen umgegangen werden soll</prop>  
      <prop id="_nav_vk_de">1.210.000(e:s)12 = Europ&#228;isch</prop>
      <prop id="_nav_vk_us">1(e:s)210(e:s)000.12 = Us/Britisch</prop> 

      <prop id="_nav_nk_l">Nachkommastellen</prop>
      <prop id="_nav_nk_t">Regelt(e:s) wieviele Nachkommastellen dargestellt werden sollen</prop>  
      <prop id="_nav_nk_4">4 Nachkommastellen</prop>
      <prop id="_nav_nk_3">3 Nachkommastellen</prop>
      <prop id="_nav_nk_2">2 Nachkommastellen</prop>
      <prop id="_nav_nk_1">1 Nachkommastellen</prop>
      <prop id="_nav_nk_0">Keine Nachkommastellen</prop>

      <prop id="_nav_iwn_l">Alle Zahlen gleich</prop> 
      <prop id="_nav_iwn_t">Veranlasst(e:s) dass ganze Zahlen (e:o)=Integer-Werte ohne Nachkommastellen(e:c) so(e:s) wie alle anderen Zahlen dargestellt werden. Zweck ist die verbesserte &#220;bersichtlichkeit in die Darstellung.</prop>

            
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(prop,ling),es)" lang="es">
      <prop id="_pl_a">A</prop>
      <prop id="_sl_a">A</prop>  
      <prop id="_ex_b">B</prop>      
    </when>  -->  

    <when test="1" lang="en">
      <!-- e=englisch -->
      
      <prop id="_nav_naming_attribute_l">Vocabulary-Terms</prop>

      
      <prop id="_nav_naming_attribute_name_l">Realworld terms</prop>
      <prop id="_nav_naming_attribute_tech_l">Technical shortcuts</prop>
      <prop id="_nav_naming_attribute_t">The sort of term to be used when the applikation refers to a specific field of the  hibiscus-database.
[(prop,_nav_naming_attribute_name_l)] - A human-readable term is displayed
[(prop,_nav_naming_attribute_tech_l)] - The column-name of the Materialized View will be displayed.</prop> 
      
      <prop id="_nav_msg_tech_l">Technicals</prop>          
      <prop id="_nav_l">Displayment of Objects</prop>
      <prop id="_nav_l_desc">Parameters of the displayment of objects</prop>
      <prop id="_nav_t">()Parameters for the displayment of objects()</prop>
      
      <prop id="_nav_msg_werte_l">Multiple Values</prop>
      <!-- 
      <prop id="_nav_msg_werte_t">jsaldf kasjfljf lakjdfjkdfl kldfjjalfj alkdfjlsjf ladjfklsadjf ladjflajsdlkfj lakdjflajdfj lskadfjlkaf</prop>                  -->

      <prop id="_nav_only_latest_values_0_l">All available values</prop>	
      <prop id="_nav_only_latest_values_1_l">Only the actual value (e:o)Top-Value(e:c)</prop>
            
      <prop id="_nav_only_latest_values_l">Values to see</prop>
      <prop id="_nav_only_latest_values_t">Controls the behavour if there are several values for one attribute.
[(prop,_nav_only_latest_values_1_l)] - Shows only one value - that with the [Top-Flag]
[(prop,_nav_only_latest_values_0_l)] - Shows everything</prop>



      <prop id="_nav_msg_props_l">Dates</prop>
      <prop id="_nav_msg_props_t">Dates to display</prop>
      
      <prop id="_nav_vonbis_l">From/To-Date</prop>
      <prop id="_nav_vonbis_t">The [From-Date] and the [To-Date] specify a period during which a value is valid.</prop>
      
      <prop id="_nav_wann_l">Import-Time</prop>
      <prop id="_nav_wann_t">The [Import-Time] specifies the moment when a value was stored technically in the Hibuscus-Database.</prop>
      
      <prop id="_nav_top_l">Top-Flag</prop>
      <prop id="_nav_top_t">()The [Top-Flag] gets relevant whenever there are several values for just one attribute. In this case, there has to be a so-called 'actual' value which is marked by the [Top-Flag]. This Top-Value is used whenever just one value is needed. That is the case with the Materialized-Views. It is also the case when '()(prop,_nav_only_latest_values_0_l)()' is choosen for the option '()(prop,_nav_only_latest_values_l)()'.()</prop>                        
      
      <prop id="_nav_keys_l">ID's of the Database</prop>
      <prop id="_nav_keys_t">The technical keys of the database which are used for the identification of data-records.</prop>
      
      <prop id="_nav_msg_detailinfos_l">Details</prop>
      <prop id="_nav_msg_terms_l">Terms</prop>
      
      <prop id="_nav_link_wert_l">Docu-Link per Value</prop>
      <prop id="_nav_link_wert_t">A link for each value will be offered(e:s) which provides additional(e:s) technical information.</prop>
      
      <prop id="_nav_msg_zahlenformat_l">Number Formats</prop>

      <prop id="_nav_vk_l">Separation</prop>
      <prop id="_nav_vk_t">Rules how thousend-separation and decimal-separation is handeled.</prop>  
      <prop id="_nav_vk_de">1.210.000(e:s)12 = European</prop>
      <prop id="_nav_vk_us">1(e:s)210(e:s)000.12 = Us/British</prop> 

      <prop id="_nav_nk_l">Decimal-Values</prop>
      <prop id="_nav_nk_t">Rules how many decimal-values are displayed.</prop>  
      <prop id="_nav_nk_4">4 Decimals</prop>
      <prop id="_nav_nk_3">3 Decimals</prop>
      <prop id="_nav_nk_2">2 Decimals</prop>
      <prop id="_nav_nk_1">1 Decimal</prop>
      <prop id="_nav_nk_0">No Decimal-Value</prop>

      <prop id="_nav_iwn_l">All numbers same</prop> 
      <prop id="_nav_iwn_t">Triggers that integer-values are displayed the same way like number-values. That looks a bit more organized on the display.</prop>
            
    </when>
  </choose>


</job>

<job id="tr_shorty" role="hidden">
<!--
<call_job job="tr_shorty"/>
(prop,_shorty_)
-->

 <choose>
    <when test="(f,eq_text,(prop,ling),de)">
      <!-- d=deutsch -->
      <prop id="_shorty_todo">1(e:c) N&#228;chster Arbeitsschritt: Ausf&#252;hren der Insert-Befehle</prop>
      <prop id="_shorty_waehlensie">Laden Sie die folgende Sql-Datei herunter.</prop>
      <prop id="_shorty_waehlensie2">F&#252;hren Sie das sql-Script in Ihrer Datenbank-Konsole aus</prop>      
      <prop id="_shorty_inorig">Im urspr&#252;nglichen Stil</prop>
      <prop id="_shorty_from_pg_bu">Auf Basis Postgres-Backup</prop>
      <prop id="_shorty_from_ms_bu">Auf Basis MySql-Backup</prop>
      <prop id="_shorty_erklaer">Erkl&#228;rungen</prop>
      <prop id="_shorty_erklaer_orig">()Finden Sie hier eine Kombination aus 
(a) dem original Hibiscus-Script zur Erzeugung der Datenbank-Strukturen und 
