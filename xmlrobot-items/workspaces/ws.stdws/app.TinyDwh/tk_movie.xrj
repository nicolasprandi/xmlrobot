<jobs>

<call_job job="prolog" />

<!-- <when test="(f,has,prop,pro)"> take 2 things to the prolog --> 
  <!-- 

  -->
<!-- </when>       -->

<!-- gui Adapters: to copy in the app  take the edit to your gui.... -->

<job id="Movie" role="test">
  <call_job job="tk_movie_edit"/>
 <mkdir dir="(dir,pro)movie" /> 
 <file id="target">(dir,pro)movie/target-(prop,movie_what).xml</file>
  
  <excel_table 
    excel="(file,movie_excel)" 
    out="(file,target)"
    sheet="functions"
    root_name="root"
    row_name="row"
    style="short"
    filler="gruppe"/> 

<ti_hr/>
<prop id="last-gruppe"></prop>
<loop 
    id="l" 
    xml="(file,target)" 
    xpath="row[string-length(e:o)@m(prop,movie_what)(e:c)&gt;0]"
    missing_strategy="empty">
    
    <when test="(f,not,(f,eq_text,(loop,l,@gruppe),(prop,last-gruppe)))">
        <prop id="last-gruppe">(loop,l,@gruppe)</prop>
        <ti label="(prop,last-gruppe)" />
    </when>
    <ti x="(loop,l,@thema)" test="(f,has,(loop,l,@thema))"/>
</loop>  
<ti_hr/>
<ti type="call_job" job="Movie" flag="button" class="fx fxAction "/>
</job>

<job id="Edit: movie_?">
  <call_job job="tk_movie_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_movie_clear" explain="Clear this data"/>
</job>



<!-- setting the default-values -->
<job id="tk_movie_default" role="hidden">
  <!--
  <need default="regex">(prop,movie_type)</need>
  <need default="(dir,filetemp)">(dir,movie_dir)</need>
  -->
</job>


<!-- movie-core, make your changes here -->
<job id="tk_movie_core" role="hidden" tip="movie_: Tk Internal">

  <need default="">(prop,tk_movie_add_flag)</need>

  <tk label="Movie" 
      flag="(prop,tk_movie_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 

    <tk id="movie_excel"
        type="file"  
      	label="Excel-Def" 
        flag="nono"          
        base="(dir,app)"
        tip="()This file will be read()"
        test_first="(prop,tk_movie_add_excel)"/>  
        
    <tk id="movie_what" 
        label="Movie to print"
        flag="nono"
        cols="10"
        tip="()()" />        

                          
  </tk>   
</job>
<!-- 
<job id="See Values: movie_" role="dev">
  <call_job job="tk_movie_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_movie_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: movie_">
  <tk type="msg" x="Sure to clear data of movie_ ?" msg_type="w"/>
  <call_job job="tk_movie_clear"/>
</job>

<job id="Print Values:  movie_">
  <call_job job="tk_movie_print_values"/>
</job>
<job id="Print Help: movie_" role="dev">
  <call_job job="tk_movie_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_movie_edit" tip="movie_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,movie-data))">
      <!-- data exists already -->
      <prop id="tk_movie_add_flag" x="sum print"/>
      <prop id="tk_movie_add_excel" x="0"/>
      <call_job job="tk_movie_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_movie_add_flag" x="sum print"/>
      <prop id="tk_movie_add_excel" x="1"/>
    </otherwise>
  </choose>
  <call_job job="tk_movie_default"/>
  <!-- doing input -->
  <call_job job="tk_movie_core"/>
  
  <!-- writing data -->
  <call_job job="tk_movie_write"/>

</job>



<job id="tk_movie_print_values" tip="movie_: Prints the entered values" role="hidden">
  
  <call_job job="tk_movie_read"/>
  
  <call_job job="tk_movie_core">
    <prop id="tk_movie_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_movie_print_values_tips" tip="movie_: Prints values and tips" role="hidden">
  
  <call_job job="tk_movie_read"/>
  
  <call_job job="tk_movie_core">
    <prop id="tk_movie_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_movie_print_help" tip="movie_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_movie_core">
    <prop id="tk_movie_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_movie_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,movie-data)" />
    <prop id="joe-in-regex" x="(prop,movie-regex)" />    
  </call_job>
  <call_job job="tk_movie_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_movie_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,movie-data)" />
    <prop id="joe-in-regex" x="(prop,movie-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_movie_clear"  tip="movie_: Clears the data" role="hidden">
  <delete file="(file,movie-data)"/>
</job>


</jobs>
