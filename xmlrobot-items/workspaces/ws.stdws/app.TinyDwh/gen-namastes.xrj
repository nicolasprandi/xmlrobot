<ti type="rec">
<ti align="right" x="+/- (prop,_sl_namaste) '(f,tk_sel_translate,(prop,namaste_attributtyp),(file,pdi-sel-attr))'" />
</ti>
<call_job job="hint-see" />
</job><job role="hidden" id="namaste-del">
<need>(prop,namaste_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="namaste-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_namaste) [ (f,tk_sel_translate,(prop,namaste_attributtyp),(file,pdi-sel-attr)) (prop,namastes_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,namastes)" where="(prop,namastes_offset)namaste[@row='(prop,namaste_key)']" />
<tp>Deleted (f,tk_sel_translate,(prop,namaste_attributtyp),(file,pdi-sel-attr)) #(prop,namaste_key)</tp>
<ti label="- (prop,_sl_namaste):" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,namaste_attributtyp),(file,pdi-sel-attr))(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="hint-see" />
</job><job role="hidden" id="namaste-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="namaste_default_label_class" x="+ (prop,_sl_namaste)" />
<prop id="namaste_default_label_name" x="(f,when,(f,has,(prop,namastes_offset_label)), | (prop,namastes_offset_label),)" />
<prop id="namastes_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,namaste_key)</need>
<prop id="namaste_default_label_class" x="(prop,_sl_namaste)" />
<prop id="namaste_default_label_name" x="(f,tk_sel_translate,(prop,namaste_attributtyp),(file,pdi-sel-attr))(f,when,(f,has,(prop,namastes_offset_label)), - (prop,namastes_offset_label),)" />
<prop id="namastes_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="namaste-tk" />
</job><job id="namaste-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<prop id="parent-objekttyp">(f,xpath,(file,namastes),hint[@row=(prop,hint_key)],@objekt_typ)</prop>
<file id="pdi-sel-attr">(dir,repo)ot-(prop,parent-objekttyp)-asel-(prop,tip-term-class)-ident.xml</file>
<remove id="parent-objekttyp" type="prop" />
<call_job job="namaste-editor" />
<prop id="namaste_key">1</prop>
<when test="(f,not,(f,exists,prop,namastes_offset_new_key))">
<prop id="namastes_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,namastes)" sort="@row" number="@row" xpath="(prop,namastes_offset_new_key)namaste">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="namaste_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_namaste): #(prop,namaste_key)</i>
<call_job job="namaste-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_namaste) '(f,tk_sel_translate,(prop,namaste_attributtyp),(file,pdi-sel-attr))'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_namaste)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_namaste)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="hint-see" />
</otherwise>
</choose>
</job><job role="hidden" id="namaste-write">
<need>(prop,namaste_key) (prop,isAdd)</need>
<need default="./">(prop,namastes_offset)</need>
<spirit act="open" id="namastes_spirit_tc" xml="(file,namastes)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,namastes_offset),/)">
<prop id="offset2" x="(f,substring,(prop,namastes_offset),0,(f,sub,(f,len,(prop,namastes_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,namastes_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="namastes_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;namaste row="(prop,namaste_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="namastes_spirit_tc" where="(prop,namastes_offset)namaste[@row='(prop,namaste_key)']" attribute="attributtyp" value="(f,vob,prop,namaste_attributtyp)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="namastes_spirit_tc" where="(prop,namastes_offset)namaste[@row='(prop,namaste_key)']" attribute="value" value="(f,vob,prop,namaste_value)" />
<spirit act="close" flag="save pretty" id="namastes_spirit_tc" />
</job></jobs>
