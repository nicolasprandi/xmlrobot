  <step>
    <name>visitors ohne staat</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>hibiscus</connection>
    <sql>select
visit.obj_id as visitor_obj_id,
rng.obj_id as range_obj_id
from (
  select
    obj_id,
    ip_adr
  from 
    stat.visitor_mv as obj_visitor
  where
    not exists (
      select bez.bez_id
      from int.bez bez
      where
        bez.bez_typ = 26 and
        bez.obj_id_a = obj_visitor.obj_id
    ) 
) as visit
left join stat.ip_range_mv as rng 
on 
rng.ip_range_begin &lt;= visit.ip_adr and
rng.ip_range_end &gt;= visit.ip_adr;</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
     <cluster_schema/>
 <remotesteps>   <input>   </input>   <output>   </output> </remotesteps>    <GUI>
      <xloc>362</xloc>
      <yloc>48</yloc>
      <draw>Y</draw>
      </GUI>
    </step>

