<job id="See Values: gpref_" role="dev">
  <call_job job="tk_gpref_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_gpref_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: gpref_">
  <tk type="msg" x="Sure to clear data of gpref_ ?" msg_type="w"/>
  <call_job job="tk_gpref_clear"/>
</job>

<job id="Print Values:  gpref_">
  <call_job job="tk_gpref_print_values"/>
</job>
<job id="Print Help: gpref_" role="dev">
  <call_job job="tk_gpref_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_gpref_edit" tip="gpref_: Edit the Data" role="hidden">
  <need default="teststyle testformat bulkstyle querystyle pastrem countless">(prop,what_gpref)</need>

  
  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,gpref-data))">
      <!-- data exists already -->
      <prop id="tk_gpref_add_flag" x="(f,when,(f,contains,(prop,what_gpref), ),sum_only,) print"/>
      <call_job job="tk_gpref_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_gpref_add_flag" x="(f,when,(f,contains,(prop,what_gpref), ),sum,) print"/>
    </otherwise>
  </choose>
  <call_job job="tk_gpref_default"/>
  <!-- doing input -->
  <call_job job="tk_gpref_core"/>
  
  <!-- writing data -->
  <call_job job="tk_gpref_write"/>

</job>



<job id="tk_gpref_print_values" tip="gpref_: Prints the entered values" role="hidden">
  
  <call_job job="tk_gpref_read"/>
  
  <call_job job="tk_gpref_core">
    <prop id="tk_gpref_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_gpref_print_values_tips" tip="gpref_: Prints values and tips" role="hidden">
  
  <call_job job="tk_gpref_read"/>
  
  <call_job job="tk_gpref_core">
    <prop id="tk_gpref_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_gpref_print_help" tip="gpref_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_gpref_core">
    <prop id="tk_gpref_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_gpref_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,gpref-data)" />
    <prop id="joe-in-regex" x="(prop,gpref-regex)" />    
  </call_job>
  <call_job job="tk_gpref_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_gpref_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,gpref-data)" />
    <prop id="joe-in-regex" x="(prop,gpref-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_gpref_clear"  tip="gpref_: Clears the data" role="hidden">
  <delete file="(file,gpref-data)"/>
</job>


</jobs>