<jobs>

<!--

-->
<call_job job="prolog"/>


<!-- setting the default-values -->
<job id="tk_lingua_default" role="hidden">
  <need default="de">(prop,lingua_lang)</need>
  
  <need default="(dir,myrepo)">(dir,lingua_repo)</need>
</job>


<!-- lingua-core, make your changes here -->
<job id="tk_lingua_core" role="hidden" tip="lingua_: Tk Internal">

  <need default="">(prop,tk_lingua_add_flag)</need>
  <call_job job="tr_lingua"/>
  
  <tk label="(f,when,(f,has_flag,(prop,tk_lingua_add_flag),print_tips_only),(prop,_lingua_l_desc),(prop,_lingua_l))" 
      flag="(prop,tk_lingua_add_flag)" tk_id="22"> 

    <tk id="lingua_repo"
        test="(prop,bpRepo)"
        label="(prop,_lingua_repo_l)"
        tip="(prop,_lingua_repo_t)"
        test_first="0" 
        type="dir"
        flag="nono" />                                        
    
    <tk id="lingua_lang"
        label="(prop,_lingua_lang_l)" 
        tip="(prop,_lingua_lang_t)"      
      	test_first="0" type="sel" flag="nono">
        <sel label="English">en</sel>        
        <sel label="German-Deutsch">de</sel>
    </tk>    
  </tk>           
  <!-- 
  <choose>
    <when test="(prop,bpRepo)">

    
    </when>
    <otherwise>
    
      <tk label="(f,when,(f,has_flag,(prop,tk_lingua_add_flag),print_tips_only),(prop,_lingua_l_desc),(prop,_lingua_l))" 
          flag="(prop,tk_lingua_add_flag)" tk_id="22"> 
    

        <tk id="lingua_lang"
            label="(prop,_lingua_lang_l)" 
            tip="(prop,_lingua_lang_t)"      
          	test_first="0" type="sel" flag="nono">
            <sel label="English">en</sel>        
            <sel label="German-Deutsch">de</sel>
        </tk>          
        
        
        <tk id="nav_naming_attribute"
            label="(prop,_nav_naming_attribute_l)" 
            tip="(prop,_nav_naming_attribute_t)"      
          	test_first="0" type="sel" flag="nono">
            <sel label="(prop,_nav_naming_attribute_name_l)">1</sel>        
            <sel label="(prop,_nav_naming_attribute_tech_l)">0</sel>
        </tk>     
                
                                  
      </tk>       
    
    </otherwise>
  
  </choose>
    -->  

  
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_lingua_edit" tip="lingua_: Edit the Data" role="hidden">
  <need default="1">(prop,edit-lingua-and-print)</need>
  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,lingua-data))">
      <!-- data exists already -->
      <prop id="tk_lingua_add_flag" x="sum_only (f,when,(prop,edit-lingua-and-print),print,)"/>
      <call_job job="tk_lingua_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_lingua_add_flag" x="sum (f,when,(prop,edit-lingua-and-print),print,)"/>
    </otherwise>
  </choose>
  <call_job job="tk_lingua_default"/>
  <!-- doing input -->
  <call_job job="tk_lingua_core"/>
  
  <!-- writing data -->
  <call_job job="tk_lingua_write"/>

</job>



<job id="tk_lingua_print_values" tip="lingua_: Prints the entered values" role="hidden">
  
  <call_job job="tk_lingua_read"/>
  
  <call_job job="tk_lingua_core">
    <prop id="tk_lingua_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_lingua_print_values_tips" tip="lingua_: Prints values and tips" role="hidden">
  
  <call_job job="tk_lingua_read"/>
  
  <call_job job="tk_lingua_core">
    <prop id="tk_lingua_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  
    <ti_hr/>
    <ti type="rec" label=" " > 
      <ti type="call_job" job="Lingua Conf" explain="(prop,_x_edit)" flag="button" class="fx fxEdit fxEditDetail fxEditDetailConf fxEditDetailConfLingua" label=" "/>
      <ti> </ti>

    </ti>    
  
</job>

<job id="tk_lingua_print_help" tip="lingua_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_lingua_core">
    <prop id="tk_lingua_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_lingua_read" role="hidden">

  <file id="joe-in-store" x="(file,lingua-data)" />
  <prop id="joe-in-regex" x="(prop,lingua-regex)" />
    
  <call_job job="go-joe-read"/>
  <call_job job="tk_lingua_default"/>

</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_lingua_write" role="hidden">
  <file id="joe-in-store" x="(file,lingua-data)" />
  <prop id="joe-in-regex" x="(prop,lingua-regex)" />
  <call_job job="go-joe-write"/>
                                       
  <!-- <create_file file="(file,mylanguage)">(prop,lingua_lang)</create_file> -->
  <prop id="ling">(prop,lingua_lang)</prop>
  <call_job job="set-sys-lang" />
  
</job>

<!-- cleares data -->
<job id="tk_lingua_clear"  tip="lingua_: Clears the data" role="hidden">
  <delete file="(file,lingua-data)"/>
</job>


</jobs>