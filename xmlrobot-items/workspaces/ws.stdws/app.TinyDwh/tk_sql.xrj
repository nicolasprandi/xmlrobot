<jobs>
<call_job job="prolog"/>
<job id="tk_limit_apply_max" role="hidden">
</job>
<job id="tk_limit_apply_max_naja" role="hidden">

  <choose>
    <when test="(f,role,boss2)">
      <prop id="sql_limit_staticstics|" prodconf="ls9">40000</prop>
      <prop id="sql_limit_queries|" prodconf="lq9">40000</prop>
      <prop id="sql_limit_mv|" prodconf="lm9">40000</prop>
      <prop id="sql_limit_bez|" prodconf="lb9">12000</prop>
      <prop id="sql_limit_obj|" prodconf="lo9">40000</prop>
      <prop id="sql_limit_search|" prodconf="le9">40000</prop>                                       
    </when>  
    
    <when test="(f,role,boss)">
      <prop id="sql_limit_staticstics|" prodconf="ls3">800</prop>
      <prop id="sql_limit_queries|" prodconf="lq3">800</prop>
      <prop id="sql_limit_mv|" prodconf="lm3">800</prop>
      <prop id="sql_limit_bez|" prodconf="lb3">240</prop>
      <prop id="sql_limit_obj|" prodconf="lo3">800</prop>
      <prop id="sql_limit_search|" prodconf="le3">800</prop>                                       
    </when> 
    
    <when test="(f,role,expert)">
      <prop id="sql_limit_staticstics|" prodconf="ls3">400</prop>
      <prop id="sql_limit_queries|" prodconf="lq3">400</prop>
      <prop id="sql_limit_mv|" prodconf="lm3">400</prop>
      <prop id="sql_limit_bez|" prodconf="lb3">120</prop>
      <prop id="sql_limit_obj|" prodconf="lo3">400</prop>
      <prop id="sql_limit_search|" prodconf="le3">400</prop>                                       
    </when>      
            
    <when test="(f,role,user)">
      <prop id="sql_limit_staticstics|" prodconf="ls2">200</prop>
      <prop id="sql_limit_queries|" prodconf="lq2">200</prop>
      <prop id="sql_limit_mv|" prodconf="lm2">200</prop>
      <prop id="sql_limit_bez|" prodconf="lb2">60</prop>
      <prop id="sql_limit_obj|" prodconf="lo2">200</prop>
      <prop id="sql_limit_search|" prodconf="le2">200</prop>                                       
    </when>
    
    <otherwise>
      <prop id="sql_limit_staticstics|" prodconf="ls1">100</prop>
      <prop id="sql_limit_queries|" prodconf="lq1">100</prop>
      <prop id="sql_limit_mv|" prodconf="lm1">100</prop>
      <prop id="sql_limit_bez|" prodconf="lb1">30</prop>
      <prop id="sql_limit_obj|" prodconf="lo1">100</prop>
      <prop id="sql_limit_search|" prodconf="le1">100</prop>                                           
    </otherwise> 
     
  </choose>
  

  <when test="(f,gt_num,(prop,sql_limit_staticstics),(prop,sql_limit_staticstics|))">
    <call_job job="tr_lmax" />
    <prop id="sql_limit_staticstics">(prop,sql_limit_staticstics|)</prop>
    <ti label="(prop,_lmax_info)"/>
    <ti>(prop,_lmax_of_stats): (prop,sql_limit_staticstics|)</ti>
  </when>
    
  <when test="(f,gt_num,(prop,sql_limit_queries),(prop,sql_limit_queries|))">
    <call_job job="tr_lmax" />
    <prop id="sql_limit_queries">(prop,sql_limit_queries|)</prop>
    <ti label="(prop,_lmax_info)"/>
    <ti>(prop,_lmax_of_queries): (prop,sql_limit_queries|)</ti>
  </when>      
  
  <when test="(f,gt_num,(prop,sql_limit_mv),(prop,sql_limit_mv|))">
    <call_job job="tr_lmax" />
    <prop id="sql_limit_mv">(prop,sql_limit_mv|)</prop>
    <ti label="(prop,_lmax_info)"/>
    <ti>(prop,_lmax_of_mv): (prop,sql_limit_mv|)</ti>
  </when>  
  
  <when test="(f,gt_num,(prop,sql_limit_bez),(prop,sql_limit_bez|))">
    <call_job job="tr_lmax" />
    <prop id="sql_limit_bez">(prop,sql_limit_bez|)</prop>
    <ti label="(prop,_lmax_info)"/>
    <ti>(prop,_lmax_of_bez): (prop,sql_limit_bez|)</ti>
  </when>
    
  <when test="(f,gt_num,(prop,sql_limit_obj),(prop,sql_limit_obj|))">
    <call_job job="tr_lmax" />
    <prop id="sql_limit_obj">(prop,sql_limit_obj|)</prop>
    <ti label="(prop,_lmax_info)"/>
    <ti>(prop,_lmax_of_obj): (prop,sql_limit_obj|)</ti>
  </when>      
  
  <when test="(f,gt_num,(prop,sql_limit_search),(prop,sql_limit_search|))">
    <call_job job="tr_lmax" />
    <prop id="sql_limit_search">(prop,sql_limit_search|)</prop>
    <ti label="(prop,_lmax_info)"/>
    <ti>(prop,_lmax_of_search): (prop,sql_limit_search|)</ti>
  </when>    
  
  <remove id="sql_limit_staticstics|" type="prop"/>
  <remove id="sql_limit_queries|" type="prop"/>
  <remove id="sql_limit_mv|" type="prop"/>
  <remove id="sql_limit_bez|" type="prop"/>
  <remove id="sql_limit_obj|" type="prop"/>
  <remove id="sql_limit_search|" type="prop"/>    


</job>

<job id="tk_limit_default" role="hidden">
  <need default="100">(prop,sql_limit_staticstics)</need> 
  <need default="100">(prop,sql_limit_queries)</need>
  <need default="100">(prop,sql_limit_mv)</need> 
  <need default="30">(prop,sql_limit_bez)</need> 
  <need default="100">(prop,sql_limit_obj)</need>
  <need default="100">(prop,sql_limit_search)</need>  
  <need default="100">(prop,sql_limit_print)</need>
  <need default="100">(prop,sql_limit_dwh)</need>
  
  
</job>

<!-- sql-core, make your changes here -->
<job id="tk_limit_core" role="hidden" tip="sql_: Tk Internal">

  <need default="">(prop,tk_sql_add_flag)</need>
  <call_job job="tk_limit_default"/>  
  <call_job job="tr_sql"/>  
  
  <tk label="(f,when,(f,has_flag,(prop,tk_limit_add_flag),print_tips_only),(prop,_sql_l_desc),(prop,_sql_l))" 
      labelx="(prop,_sql_l)"
      flag="(prop,tk_limit_add_flag)"
      tip="(prop,_sql_t)"
       tk_id="23"> 
       
   <tk type="msg" msg="(prop,_sql_msg_ui_l)"
        test_first="0"
        />   
   
        
    <tk id="sql_limit_obj" 
        label="(prop,_sql_limit_obj_l)" 
        flag="nono"
        regex="\d+"
        regex_msg="(prop,_sql_numval_msg)"
        tip="(prop,_sql_limit_obj_t)"      
      	test_first="0"  
        cols="5"/>         
        
    <tk id="sql_limit_bez"
        label="(prop,_sql_limit_bez_l)" 
        flag="nono"
        regex="\d+"
        regex_msg="(prop,_sql_numval_msg)"
        tip="(prop,_sql_limit_bez_t)"      
      	test_first="0"  
        cols="5"/>  
            
    <tk id="sql_limit_search" 
        label="(prop,_sql_limit_search_l)"
        tip="(prop,_sql_limit_search_t)"
        flag="nono" 
        test_first="0"  
        cols="5"      />                 

    <tk type="msg" msg="(prop,_sql_msg_db_l)"   tip="(prop,_sql_msg_db_t)"    
        test_first="0"/> 
        


    <tk id="sql_limit_queries" 
        label="(prop,_sql_limit_queries_l)"
        tip="(prop,_sql_limit_queries_t)"
        flag="nono" 
        test_first="0"  
        cols="5"      />  
                                      
   
        
        
        
    <tk id="sql_limit_mv" 
        label="(prop,_sql_limit_mv_l)"
        tip="(prop,_sql_limit_mv_t)"
        flag="nono" 
        test_first="0"  
        cols="5"      />    
        
    <tk id="sql_limit_staticstics" 
        label="(prop,_sql_limit_staticstics_l)"
        tip="(prop,_sql_limit_staticstics_t)"
        flag="nono" 
        test_first="0"  
        cols="5"    />      
        
    <tk id="sql_limit_dwh" 
        label="(prop,_sql_limit_tabs_l)"
        tip="(prop,_sql_limit_tabs_t)"
        flag="nono" 
        test_first="0"  
        cols="5"    />                  
               
    <tk id="sql_limit_print" 
        label="(prop,_sql_limit_print_l)" 
        flag="nono"
        regex="\d+"
        regex_msg="(prop,_sql_numval_msg)"
        tip="(prop,_sql_limit_print_t)"      
      	test_first="0"  
        cols="5"/>             
     
                                                       
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_limit_edit" tip="sql_: Edit the Data" role="hidden">
  <need default="1">(prop,edit-limit-and-print)</need>
  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,sql-data))">
      <!-- data exists already -->
      <prop id="tk_limit_add_flag" x="sum_only (f,when,(prop,edit-limit-and-print),print,)"/>
      <call_job job="tk_limit_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_limit_add_flag" x="sum (f,when,(prop,edit-limit-and-print),print,)"/>
    </otherwise>
  </choose>
  
  <!-- doing input -->
  <call_job job="tk_limit_core"/>
  
  <!-- writing data -->
  <call_job job="tk_limit_write"/>

</job>



<job id="tk_limit_print_values" tip="sql_: Prints the entered values" role="hidden">
  
  <call_job job="tk_limit_read"/>
  
  <call_job job="tk_limit_core">
    <prop id="tk_limit_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_limit_print_values_tips" tip="sql_: Prints values and tips" role="hidden">
  
  <call_job job="tk_limit_read"/>
  
  <call_job job="tk_limit_core">
    <prop id="tk_limit_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  
    <ti_hr/>  
    <ti type="rec" label=" " > 
      <ti type="call_job" job="Limit Conf" flag="button" class="fx fxEdit fxEditDetail fxEditDetailConf fxEditDetailConfLimit" explain="(prop,_x_edit)" />
      <ti> </ti>

    </ti>  
  
</job>

<job id="tk_limit_print_help" tip="sql_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_limit_core">
    <prop id="tk_limit_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_limit_read" role="hidden">
 
  <call_job job="go-joe-read">
    <prop id="joe-in-regex" x="(prop,sql-regex)" />
    <file id="joe-in-store" x="(file,sql-data)" />
  </call_job>
  <call_job job="tk_limit_default"/>
  <call_job job="tk_limit_apply_max"/>
  
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_limit_write" role="hidden">
  <call_job job="tk_limit_apply_max"/>
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,sql-data)" />
    <prop id="joe-in-regex" x="(prop,sql-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_limit_clear"  tip="sql_: Clears the data" role="hidden">
  <delete file="(file,sql-data)"/>
</job>


</jobs>