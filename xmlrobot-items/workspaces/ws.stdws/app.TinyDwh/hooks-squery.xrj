<ti type="menu" first_cell="2">
  <ti type="call_job" page="details" flag="button" class="fb fbQueryService" 
  explain="(prop,_squery_act_count)" job="event_squery_count"
   test="(f,eq_text,(prop,squery_class1),select)" >
    <prop id="greetings_from_page">details</prop>
    <prop id="greetings_from_action">count</prop>
    <prop page="details" id="squery_key">(prop,squery_key)</prop>
    <file id="squerys">(file,squerys)</file>
    <prop id="squerys_return_job">(prop,squerys_return_job)</prop>
