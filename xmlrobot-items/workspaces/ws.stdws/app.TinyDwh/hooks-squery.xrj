<call_job job="go-joe-write">
  <file id="joe-in-store" x="(dir,pro)cache/current-squery.xml" />
  <prop id="joe-in-regex" x="squerys|squery_key" />
</call_job>

  
<call_job job="tk_gpref_show_button" >       
  <prop id="what_gpref">ifacestyle</prop>
  <prop id="ready_job">hook_changed_isql_position</prop>
  <prop id="with_hr">1</prop>
  <prop id="do_align">right</prop>
  <prop id="do_break">0</prop>
  
  
</call_job> 
