<job id="squery-pre-action-buttons" role="hidden">

  <when test="(f,not,(f,starts_with,(prop,qra-from),b))">  

    <ti type="menu" flag="block">
      <ti type="call_job" job="event_squery_run" explain="(prop,_squery_act_run)" flag="button block"  class="fb fbGoQuery">
        <prop id="squery_key">(prop,squery_key)</prop>
        <file id="squerys">(file,squerys)</file>
        <prop id="squerys_offset">(prop,squerys_offset)</prop>
        <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop> 
      </ti>         
                     
      <ti type="call_job" job="event_squery_defnrun" explain="(prop,_squery_act_defnrun)" flag="button "  class="fb fbQuery" test="(prop,bpDev)">
        <prop id="squery_key">(prop,squery_key)</prop>
        <file id="squerys">(file,squerys)</file>
      <prop id="squerys_offset">(prop,squerys_offset)</prop>
      <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop> 
      </ti>     
      <ti type="call_job" job="squery-edit" explain="(prop,_x_edit)" flag="button "  class="fb fbEdit fbEditDetail fbEditDetailSquery" test="(prop,bpDev)">
        <prop id="squery_key">(prop,squery_key)</prop>
        <file id="squerys">(file,squerys)</file>
       
        <prop id="squerys_offset">(prop,squerys_offset)</prop>
        <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop>        
      </ti>              
    </ti>
    
    <call_job job="squery-pre-post-export-button" test="(f,exists,prop,qra-export)"/>  
  </when>


  <ti_break/>

</job>
<job id="squery-pre-post-export-button" role="hidden">

<ti type="menu" flag="block">


  

  
  <ti type="call_job" page="details" flag="button block" class="fb fbQueryService" 
  explain="(prop,_squery_act_count)" job="event_squery_count" test="(f,eq_text,(prop,squery_class1),select)">
    <prop id="greetings_from_page">details</prop>
    <prop id="greetings_from_action">count</prop>
    <prop page="details" id="squery_key">(prop,squery_key)</prop>
    <file id="squerys">(file,squerys)</file>
    <prop id="squerys_return_job">(prop,squerys_return_job)</prop>
    <prop id="squerys_offset">(prop,squerys_offset)</prop>
    <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop>
  </ti>

  <ti type="call_job" page="details" flag="button (f,when,(f,not,(f,eq_text,(prop,squery_class1),select)),block,)" class="fb fbQueryService" explain="(prop,_squery_act_explain)" job="event_squery_explain">
    <prop id="greetings_from_page">details</prop>
    <prop id="greetings_from_action">defnrun</prop>
    <prop page="details" id="squery_key">(prop,squery_key)</prop>
    <file id="squerys">(file,squerys)</file>
    <prop id="squerys_return_job">(prop,squerys_return_job)</prop>
    <prop id="squerys_offset">(prop,squerys_offset)</prop>
    <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop>
  </ti>
</ti>    
<ti type="menu" flag="block">
  <ti type="call_job" page="details" flag="button block" class="fb fbQuery" explain="(prop,_squery_act_runby2)" job="event_squery_run_as">
    <prop id="greetings_from_page">details</prop>
    <prop id="greetings_from_action">runas</prop>
    <prop page="details" id="squery_key">(prop,squery_key)</prop>
    <file id="squerys">(file,squerys)</file>
    <prop id="squerys_return_job">(prop,squerys_return_job)</prop>
    <prop id="squerys_offset">(prop,squerys_offset)</prop>
    <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop>
  </ti> 
  </ti>
</job>

<job id="squery-action-see-back-button" role="hidden">  

<when test="(f,not,(prop,qra-no-back-button))">
 <ti_break class_table="tabNavigator"/>

  <choose>
    <when test="(f,eq_text,x,(prop,qra-from))">  

      <ti type="rec" >
                
            
             <ti type="call_job" job="squery-see" explain="(prop,_x_go_back_sys)" flag="button " class="justback"
                align="right" >
              <prop id="squery_key">(prop,squery_key)</prop>
              
              <prop id="squerys_offset">./</prop>
              <file id="squerys">(file,squerys)</file>       
            </ti>             
         
      </ti>      
      
      <choose>
        <when test="(f,has,prop,qra-headline)">
        
          <ti type="rec" >
            <ti x="(prop,qra-headline)" />
            <ti type="call_job" job="_select" explain="(prop,_x_go_up_sys)" flag="button " class="justup"
            align="right" ></ti>  
          </ti>  
          
          <remove id="qra-headline" type="prop" />
                  
        </when>
        <otherwise>
        
          <ti type="rec" >
<ti type="call_job" job="_select" explain="(prop,_x_go_up_sys)" flag="button " class="justup"
            align="right" ></ti>  
          </ti>  
                  
        </otherwise>
      
      </choose>
      
      <!--          
      <ti type="rec" >
        <ti type="menu" align="right" span="10">
        <ti type="call_job" job="_select" explain="(prop,_x_go_up_sys)" flag="button " class="justback"
            xalign="right" >          
        </ti>  
        
         <ti type="call_job" job="squery-see" explain="(prop,_x_go_back_sys)" flag="button " class="justback"
            xalign="right" >
          <prop id="squery_key">(prop,squery_key)</prop>
          
          <prop id="squerys_offset">./</prop>
          <file id="squerys">(file,squerys)</file>       
        </ti>         
        </ti>
      </ti>    -->      
    </when>
    
    <when test="(f,eq_text,ql,(prop,qra-from))">
      <ti type="rec" >
        <ti type="call_job" job="_select" explain="(prop,_x_go_up_sys)" xxexplain="(prop,_x_go_back_sys)" flag="button " class="justback"
            align="right" >          
        </ti>  
      </ti>       
    </when>
    <!-- 
    <when test="(f,eq_text,bl,(prop,qra-from))">
      <ti type="rec" >
        <ti type="call_job" job="_bulk" explain="(prop,_x_go_back_sys)" flag="button " class="fx fxAction justup"
            align="right" >          
        </ti>  
      </ti>       
    </when>  
    
    <when test="(f,eq_text,bd,(prop,qra-from))">
      <ti type="rec" >
        <ti type="call_job" job="bulk-see" explain="(prop,_x_go_back_sys)" flag="button " class="fx fxAction justup"
            align="right" >        
           <prop id="bulk_key">(prop,bulk_key)</prop>
           <file id="bulks">(file,bulks)</file>  
        </ti>  
      </ti>       
    </when>      
    -->
  </choose>   
  
</when>
    <!-- 
    <when test="(f,starts_with,(prop,qra-from),b)">  
      <ti type="rec" >
        <ti type="call_job" job="squery-see" explain="(prop,_qres_zur_abfrage)" flag="button " class="fx fxAction justup"
            align="right" >
          <prop id="squery_key">(prop,squery_key)</prop>
          <file id="squerys">(file,squerys)</file>       
        </ti>  
      </ti>      
    </when>      -->

<ti_break/>   



</job>

<job id="squery-post-action-buttons" role="hidden">

  <need>(prop,see-sql-limit)</need>
  <need default="1">(prop,see-any-limit)</need>
  <need default="0">(prop,see-back-first)</need>
  
  <call_job job="squery-action-see-back-button" test="(prop,see-back-first)"/>       
  
  <when test="(f,not,(f,starts_with,(prop,qra-from),b))">  

    <ti type="menu" flag="block">
      <ti type="call_job" job="event_squery_run" explain="(prop,_squery_act_run)" flag="button block"  class="fb fbGoQuery">
        <prop id="squery_key">(prop,squery_key)</prop>
        <file id="squerys">(file,squerys)</file>
        <prop id="squerys_offset">(prop,squerys_offset)</prop>
        <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop> 
      </ti>         
                     
      <ti type="call_job" job="event_squery_defnrun" explain="(prop,_squery_act_defnrun)" flag="button "  class="fb fbQuery" test="(prop,bpDev)">
        <prop id="squery_key">(prop,squery_key)</prop>
        <file id="squerys">(file,squerys)</file>
      <prop id="squerys_offset">(prop,squerys_offset)</prop>
      <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop> 
      </ti>     
      <ti type="call_job" job="squery-edit" explain="(prop,_x_edit)" flag="button "  class="fb fbEdit fbEditDetail fbEditDetailSquery" test="(prop,bpDev)">
        <prop id="squery_key">(prop,squery_key)</prop>
        <file id="squerys">(file,squerys)</file>
       
        <prop id="squerys_offset">(prop,squerys_offset)</prop>
        <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop>        
      </ti>              
    </ti> 
    
    <call_job job="squery-pre-post-export-button" test="(f,exists,prop,qra-export)"/>
  </when>
  
  <when test="(prop,see-any-limit)">   
  <when test="(f,not,(f,has,prop,limit-from-bulk))">                                                                                           
     
      
      <ti type="call_job" job="limit-conf-called-by-query" 
      explain="(prop,_sl_change_limit) (e:o)(f,when,(prop,see-sql-limit),Sql:(prop,sql_limit_queries)(e:s) ,)(f,when,(f,eq_text,(prop,ling),de),Druck,Print):(prop,sql_limit_print)(e:c)"  
      flag="button " class="fx fxAction justlimit " >
        <file id="squerys">(file,squerys)</file>
        <prop id="squery_key">(prop,squery_key)</prop>
      </ti>      
    
  </when>  
  </when>      

  <call_job job="squery-action-see-back-button" test="(f,not,(prop,see-back-first))"/> 
 
</job>

<job id="squery-post-action-buttons-limit" role="hidden">

  <need>(prop,see-sql-limit)</need>
  <need default="1">(prop,see-any-limit)</need>
  
  <when test="(prop,see-any-limit)">                                                                                              
  <ti type="rec">     

    <ti type="call_job" job="limit-conf-called-by-query" explain="(prop,_sl_change_limit) (e:o)(f,when,(prop,see-sql-limit),Sql:(prop,sql_limit_queries)(e:s) ,)(f,when,(f,eq_text,(prop,ling),de),Druck,Print):(prop,sql_limit_print)(e:c)"  flag="button block" class="fx fxAction justlimit" >
      <file id="squerys">(file,squerys)</file>
      <prop id="squery_key">(prop,squery_key)</prop>
    </ti>      
  </ti>    
  </when>  
  
</job>  

</jobs>                                
