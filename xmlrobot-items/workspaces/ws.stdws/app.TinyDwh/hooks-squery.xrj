<job id="hook_changed_isql_position" role="hidden">
<call_job job="go-joe-read">
  <file id="joe-in-store" x="(dir,pro)cache/current-squery.xml" />
  <prop id="joe-in-regex" x=".*" />
</call_job>
<call_job job="squery-see" />
</job>

