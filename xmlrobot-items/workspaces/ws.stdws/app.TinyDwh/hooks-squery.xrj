   <call_job job="tk_gpref_read"/>
 
   <ti type="rec" label="in (prop,_sl_buch): " xflag="label_right">
    <ti >(f,name_of_dir,(f,dir_of_file,(file,squerys)))</ti>
   </ti>  
   
<choose>                         
  <when test="(prop,gpref_ifacestyle)">
    
      <when test="(f,right,sqli)">
        
        <ti_hr_break/>
        <call_job job="sqli-see-all">
          <file id="sqlis">(file,squerys)</file>
          <prop id="sqlis_offset">squery[@row='(prop,squery_key)']/</prop>
