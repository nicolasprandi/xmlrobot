    <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop>
  </ti>

  <ti type="call_job" page="details" flag="button" class="fb fbQueryService" explain="(prop,_squery_act_explain)" job="event_squery_explain">
    <prop id="greetings_from_page">details</prop>
    <prop id="greetings_from_action">defnrun</prop>
    <prop page="details" id="squery_key">(prop,squery_key)</prop>
    <file id="squerys">(file,squerys)</file>
    <prop id="squerys_return_job">(prop,squerys_return_job)</prop>
    <prop id="squerys_offset">(prop,squerys_offset)</prop>
    <prop id="squerys_offset_label">(prop,squerys_offset_label)</prop>
  </ti>
</ti>
<!-- 
</when>
<otherwise>
<ti type="rec" label=" ">
  <ti>(prop,_squery_act_none)</ti>
</ti>     </otherwise>
</choose> -->







</job>

<job id="event_squery_details_ende" role="hidden">

    <when test="(f,not,(prop,gpref_ifacestyle))">
    <when test="(f,right,sqli)">
      <ti_hr_break/>
      
      <call_job job="sqli-see-all">
        <file id="sqlis">(file,squerys)</file>
        <prop id="sqlis_offset">squery[@row='(prop,squery_key)']/</prop>
        <prop id="sqlis_offset_label"></prop>      
        
      </call_job>
      
    </when>      
    </when> 
  
    

