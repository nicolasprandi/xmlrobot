<!-- gui Adapters: to copy in the app  take the edit to your gui.... 

<job id="Edit: miro_">
  <call_job job="tk_miro_edit"/>
</job>

<job id="Edit: miro_?">
  <call_job job="tk_miro_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_miro_clear" explain="Clear this data"/>
