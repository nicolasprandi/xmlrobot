  <tk type="msg" x="Sure to clear data of miro_ ?" msg_type="w"/>
  <call_job job="tk_miro_clear"/>
</job>

<job id="Print Values:  miro_">
  <call_job job="tk_miro_print_values"/>
</job>
<job id="Print Help: miro_" role="dev">
  <call_job job="tk_miro_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_miro_edit" tip="miro_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,miro-data))">
      <!-- data exists already -->
      <prop id="tk_miro_add_flag" x="sum_only xprint"/>
      <call_job job="tk_miro_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_miro_add_flag" x="sum xprint"/>
    </otherwise>
  </choose>
  <call_job job="tk_miro_default"/>
  <!-- doing input -->
  <call_job job="tk_miro_core"/>
  
  <!-- writing data -->
  <call_job job="tk_miro_write"/>

</job>



<job id="tk_miro_print_values" tip="miro_: Prints the entered values" role="hidden">
  
  <call_job job="tk_miro_read"/>
  
  <call_job job="tk_miro_core">
    <prop id="tk_miro_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_miro_print_values_tips" tip="miro_: Prints values and tips" role="hidden">
  
  <call_job job="tk_miro_read"/>
  
  <call_job job="tk_miro_core">
    <prop id="tk_miro_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_miro_print_help" tip="miro_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_miro_core">
    <prop id="tk_miro_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_miro_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,miro-data)" />
    <prop id="joe-in-regex" x="(prop,miro-regex)" />    
  </call_job>
  <call_job job="tk_miro_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_miro_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,miro-data)" />
    <prop id="joe-in-regex" x="(prop,miro-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_miro_clear"  tip="miro_: Clears the data" role="hidden">
  <delete file="(file,miro-data)"/>
</job>


</jobs>