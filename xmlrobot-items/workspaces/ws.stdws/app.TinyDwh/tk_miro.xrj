<!-- setting the default-values -->
<job id="tk_miro_default" role="hidden">
  <need default="keep">(prop,miro_limit_style)</need>
</job>


<!-- miro-core, make your changes here -->
<job id="tk_miro_core" role="hidden" tip="miro_: Tk Internal">
<call_job job="tr_miro"/>
  <need default="">(prop,tk_miro_add_flag)</need>

  <tk label="(prop,head-for-miro)" 
      flag="(prop,tk_miro_add_flag)"
      tip="(prop,_miro_t_all)" tk_id="0"> 
    <tk type="msg"
        x="(prop,_miro_l_limit_msg)"
        test_first="0"/>   
        
    <tk id="miro_limit_style"
        type="sel"
        label="(prop,_miro_l_limit_style)" 
        test_first="0"        
        cols="10"
        tip="(prop,_miro_t_limit_style)"
        flag="nono">
        
        <!-- <sel label="(prop,_qura_s_limit_style_config1): (prop,sql_limit_queries) (prop,_qura_s_limit_style_config2)">config</sel>      -->
        <sel label="(prop,_miro_s_limit_style_keep)">keep</sel>
        <sel label="(prop,_miro_s_limit_style_no)">no</sel>
        <sel label="(prop,_miro_s_limit_style_indiv) ...">indiv</sel>                
    </tk>              
    <tk id="miro_limit_indiv"
        type="text"      	
      	label="(prop,_miro_l_limit)"      	
      	regex="\d+"
        cols="5"
      	regex_msg="()A Number()"
      	test_first="0"
        tip="(prop,_miro_t_limit)"/>  
                          
  </tk>   
</job>
