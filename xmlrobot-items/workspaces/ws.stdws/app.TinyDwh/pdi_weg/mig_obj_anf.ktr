  <notepads>
    <notepad>
      <note>select&#xd;&#xa; usg.attr_usg_id &#x7c;&#x7c; &#x27;&#x7c;&#x27; &#x7c;&#x7c; replace&#x28;upper&#x28;wert.inhalt&#x29;,&#x27; &#x27;,&#x27;&#x27;&#x29; as uk,&#xd;&#xa; obj.obj_id,&#xd;&#xa; obj.info_id,&#xd;&#xa; obj.obj_typ,&#xd;&#xa; attr.attr_id,&#xd;&#xa; attr.attr_typ,&#xd;&#xa; wert.wert_id,&#xd;&#xa; usg.attr_usg_id as uk_attr_usg_id, &#xd;&#xa; wert.inhalt as uk_inhalt&#xd;&#xa;from &#xd;&#xa;  int.wert as wert,&#xd;&#xa;  int.attr as attr,  &#xd;&#xa;  int.obj as obj,&#xd;&#xa;  vok.attr_usg as usg&#xd;&#xa;where&#xd;&#xa;  obj.info_id &#x3d; attr.info_id and&#xd;&#xa;  attr.attr_id &#x3d; wert.attr_id and&#xd;&#xa;  wert.ist_top &#x3d; 1 and&#xd;&#xa;  attr.attr_typ &#x3d; usg.attr_typ and&#xd;&#xa;  usg.obj_typ &#x3d; obj.obj_typ and&#xd;&#xa;  &#x28; wert.hat_mehr &#x3d; 0  or usg.ident_mehr&#x3d;1 &#x29; and&#xd;&#xa;  usg.ident &#x3d; 1&#xd;&#xa;order by&#xd;&#xa;  obj.obj_typ,&#xd;&#xa;  usg.attr_usg_id,&#xd;&#xa;  wert.inhalt&#x3b;</note>
      <xloc>860</xloc>
      <yloc>46</yloc>
      <width>320</width>
      <heigth>442</heigth>
