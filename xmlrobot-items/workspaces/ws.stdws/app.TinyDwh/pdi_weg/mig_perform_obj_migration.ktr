      <note>QUATSCH&#x3a;&#xd;&#xa;select&#xd;&#xa; x.mig_obj_id,&#xd;&#xa; master.obj_id_m,&#xd;&#xa; master.attr_typ_m,&#xd;&#xa; master.attr_id_m,&#xd;&#xa; master.obj_typ_m,&#xd;&#xa; slave.mig_id_s,&#xd;&#xa; slave.obj_id_s,&#xd;&#xa; slave.obj_id_m4s,    &#xd;&#xa; slave.attr_typ_s, &#xd;&#xa; slave.attr_id_s&#xd;&#xa; from &#x28;&#xd;&#xa;   select&#xd;&#xa;     mig_obj.mig_obj_id&#xd;&#xa;   from int.mig_obj &#x29; x &#xd;&#xa;left outer join &#x28;&#xd;&#xa;select&#xd;&#xa; mig_obj.mig_obj_id as mig_id_m,&#xd;&#xa; mig_obj.master_obj_id as obj_id_m,&#xd;&#xa; attr.attr_typ as attr_typ_m, &#xd;&#xa; attr.attr_id as attr_id_m,&#xd;&#xa; obj.obj_typ as obj_typ_m&#xd;&#xa;from &#xd;&#xa;  int.mig_obj as mig_obj,&#xd;&#xa;  int.attr as attr,&#xd;&#xa;  int.obj as obj&#xd;&#xa;WHERE &#xd;&#xa;  attr.obj_id &#x3d; mig_obj.master_obj_id and&#xd;&#xa;  obj.obj_id &#x3d; mig_obj.master_obj_id&#x29; master&#xd;&#xa;on &#xd;&#xa;  &#x28; x.mig_obj_id &#x3d; master.mig_id_m &#x29;&#xd;&#xa;left outer join &#x28;&#xd;&#xa;select&#xd;&#xa; mig_obj.mig_obj_id as mig_id_s,&#xd;&#xa; mig_obj.slave_obj_id as obj_id_s,&#xd;&#xa; mig_obj.master_obj_id as obj_id_m4s,    &#xd;&#xa; attr.attr_typ as attr_typ_s, &#xd;&#xa; attr.attr_id as attr_id_s&#xd;&#xa;from &#xd;&#xa;  int.mig_obj as mig_obj,&#xd;&#xa;  int.attr as attr,&#xd;&#xa;  int.obj as obj&#xd;&#xa;WHERE &#xd;&#xa;  attr.obj_id &#x3d; mig_obj.slave_obj_id and&#xd;&#xa;  obj.obj_id &#x3d; mig_obj.slave_obj_id&#x29; slave&#xd;&#xa;on &#xd;&#xa;  &#x28; x.mig_obj_id &#x3d; slave.mig_id_s &#x29;  &#xd;&#xa;order by&#xd;&#xa; x.mig_obj_id,&#xd;&#xa; master.attr_typ_m&#x3b;</note>
