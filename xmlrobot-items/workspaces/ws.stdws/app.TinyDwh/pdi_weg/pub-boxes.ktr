    <jsScripts>      <jsScript>        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>&#x2f;&#x2f;Script here&#xd;&#xa;&#xd;&#xa;var ok &#x3d; true&#x3b;&#xd;&#xa;var schlecht_grund &#x3d; &#x27;&#x27;&#x3b;&#xd;&#xa;var int_inhalt &#x3d; &#x27;&#x27;&#x3b;&#xd;&#xa;var int_inhalt2 &#x3d; &#x27;&#x27;&#x3b;&#xd;&#xa;&#xd;&#xa;var convert_itn &#x3d; false&#x3b;&#xd;&#xa;&#xd;&#xa;if &#x28; final_typ &#x3d;&#x3d; 1 &#x29; &#x7b;&#xd;&#xa;  &#x2f;&#x2f; varchar&#xd;&#xa;  int_inhalt &#x3d; inhalt&#x3b;&#xd;&#xa;  int_inhalt2 &#x3d; &#x28;inhalt.toUpperCase&#x28;&#x29;&#x29;.replace&#x28;&#x2f;&#x5c;s&#x2f;g,&#x27;&#x27;&#x29;&#x3b;&#xd;&#xa;&#x7d; else if &#x28; final_typ &#x3d;&#x3d; 2 &#x29; &#x7b;&#xd;&#xa;  &#x2f;&#x2f; char&#xd;&#xa;  int_inhalt &#x3d; inhalt&#x3b;&#xd;&#xa;  int_inhalt2 &#x3d; &#x28;inhalt.toUpperCase&#x28;&#x29;&#x29;.replace&#x28;&#x2f;&#x5c;s&#x2f;g,&#x27;&#x27;&#x29;&#x3b;&#xd;&#xa;&#x7d; else if &#x28; final_typ &#x3d;&#x3d; 3 &#x29; &#x7b;&#xd;&#xa;  &#x2f;&#x2f; integer&#xd;&#xa;  convert_itn &#x3d; true&#x3b;&#xd;&#xa;&#x7d; else if &#x28; final_typ &#x3d;&#x3d; 4 &#x29; &#x7b;&#xd;&#xa;  &#x2f;&#x2f; number&#xd;&#xa;  convert_itn &#x3d; true&#x3b;&#xd;&#xa;&#x7d; else if &#x28; final_typ &#x3d;&#x3d; 5 &#x29; &#x7b;&#xd;&#xa;  &#x2f;&#x2f; bool&#xd;&#xa;  var numBool &#x3d; Number&#x28;inhalt&#x29;&#x3b;&#xd;&#xa;  if &#x28; numBool &#x3d;&#x3d; NaN &#x29; &#x7b;&#xd;&#xa;    ok &#x3d; false&#x3b;&#xd;&#xa;    schlecht_grund &#x3d; &#x27;Das ist kein Bool&#x3a; &#x5b;&#x27;&#x2b;inhalt&#x2b;&#x27;&#x5d;&#x27;&#x3b;&#xd;&#xa;  &#x7d; else &#x7b;&#xd;&#xa;    if &#x28; numBool &#x3d;&#x3d; 1&#x29; &#x7b;&#xd;&#xa;      int_inhalt &#x3d; &#x27;1&#x27;&#x3b;&#xd;&#xa;      int_inhalt2 &#x3d; &#x27;1&#x27;&#x3b;&#xd;&#xa;    &#x7d; else if &#x28; numBool&#x3d;&#x3d;0&#x29; &#x7b;&#xd;&#xa;      int_inhalt &#x3d; &#x27;0&#x27;&#x3b;&#xd;&#xa;      int_inhalt2 &#x3d; &#x27;0&#x27;&#x3b;&#xd;&#xa;    &#x7d; else &#x7b;&#xd;&#xa;      ok &#x3d; false&#x3b;&#xd;&#xa;      schlecht_grund &#x3d; &#x27;Das ist kein Bool&#x3a; &#x5b;&#x27;&#x2b;inhalt&#x2b;&#x27;&#x5d;&#x27;&#x3b;&#xd;&#xa;    &#x7d;&#xd;&#xa;  &#x7d;&#xd;&#xa;&#xd;&#xa;&#x7d; else if &#x28; final_typ &#x3d;&#x3d; 6 &#x29; &#x7b;&#xd;&#xa;  &#x2f;&#x2f; date&#xd;&#xa;  var i2 &#x3d; inhalt.trim&#x28;&#x29;&#x3b;&#xd;&#xa;  var regexDate &#x3d; new RegExp&#x28;&#x27;&#x5e;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c;-&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c;-&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x24;&#x27;&#x29;&#x3b;&#xd;&#xa;  var isOk &#x3d; regexDate.test&#x28;i2&#x29;&#x3b;&#xd;&#xa;  if &#x28; isOk &#x29; &#x7b;&#xd;&#xa;    int_inhalt &#x3d; i2&#x3b;&#xd;&#xa;    int_inhalt2 &#x3d; i2&#x3b;&#xd;&#xa;  &#x7d; else &#x7b;&#xd;&#xa;    ok &#x3d; false&#x3b;&#xd;&#xa;    schlecht_grund &#x3d; &#x27;Das ist kein Datum&#x3a; &#x5b;&#x27;&#x2b;i2&#x2b;&#x27;&#x5d; Format soll sein &#x5b;YYYY-MM-DD&#x5d;&#x27;&#x3b;&#xd;&#xa;  &#x7d;&#xd;&#xa;&#x7d; else if &#x28; final_typ &#x3d;&#x3d; 7 &#x29; &#x7b;&#xd;&#xa;  &#x2f;&#x2f; ts&#xd;&#xa;  var i2 &#x3d; inhalt.trim&#x28;&#x29;&#x3b;&#xd;&#xa;  var regexTs1 &#x3d; new RegExp&#x28;&#x27;&#x5e;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c;-&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c;-&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c; &#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c;&#x3a;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x3a;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;.&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x24;&#x27;&#x29;&#x3b;&#xd;&#xa;  var isOk &#x3d; regexTs1.test&#x28;i2&#x29;&#x3b;&#xd;&#xa;  if &#x28; isOk &#x29; &#x7b;&#xd;&#xa;    int_inhalt &#x3d; i2&#x3b;&#xd;&#xa;    int_inhalt2 &#x3d; i2&#x3b;&#xd;&#xa;  &#x7d; else &#x7b;&#xd;&#xa;    var regexTs2 &#x3d; new RegExp&#x28;&#x27;&#x5e;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c;-&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c;-&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c; &#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x5c;&#x3a;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x3a;&#x5b;0-9&#x5d;&#x5b;0-9&#x5d;&#x24;&#x27;&#x29;&#x3b;&#xd;&#xa;    var isOk2 &#x3d; regexTs2.test&#x28;i2&#x29;&#x3b;&#xd;&#xa;    if &#x28; isOk2 &#x29; &#x7b;&#xd;&#xa;      int_inhalt &#x3d; i2&#x2b;&#x27;.000&#x27;&#x3b;&#xd;&#xa;      int_inhalt2 &#x3d; i2&#x2b;&#x27;.000&#x27;&#x3b;&#xd;&#xa;    &#x7d; else &#x7b;&#xd;&#xa;      ok &#x3d; false&#x3b;&#xd;&#xa;      schlecht_grund &#x3d; &#x27;Das ist kein Zeitstempel&#x3a; &#x5b;&#x27;&#x2b;i2&#x2b;&#x27;&#x5d; Format soll sein &#x5b;YYYY-MM-DD HH&#x3a;MM&#x3a;SS.sss&#x5d;&#x27;&#x3b;&#xd;&#xa;  &#x7d;&#xd;&#xa;  &#x7d;&#xd;&#xa;&#x7d; else &#x7b;&#xd;&#xa;  ok &#x3d; false&#x3b;&#xd;&#xa;  schlecht_grund &#x3d; &#x27;final typ &#x27;&#x2b;final_typ&#x2b;&#x27; noch nicht implementiert&#x27;&#x3b;&#xd;&#xa;&#x7d;&#xd;&#xa;&#xd;&#xa;if &#x28; convert_itn &#x29; &#x7b;&#xd;&#xa;  var num &#x3d; Number&#x28;inhalt&#x29;&#x3b;&#xd;&#xa;  if &#x28; num &#x3d;&#x3d; NaN &#x29; &#x7b;&#xd;&#xa;    ok &#x3d; false&#x3b;&#xd;&#xa;    schlecht_grund &#x3d; &#x27;Das ist keine Zahl&#x3a; &#x5b;&#x27;&#x2b;inhalt&#x2b;&#x27;&#x5d;&#x27;&#x3b;&#xd;&#xa;  &#x7d; else &#x7b;&#xd;&#xa;    if &#x28; num &#x3e;&#x3d; 1000000000000000 &#x7c;&#x7c; num &#x3c;&#x3d; -1000000000000000&#x29; &#x7b;&#xd;&#xa;      ok &#x3d; false&#x3b;&#xd;&#xa;      if &#x28; num &#x3e;&#x3d; 1000000000000000 &#x29; &#xd;&#xa;        schlecht_grund &#x3d; &#x27;Die Zahl ist zu gross&#x3a; &#x5b;&#x27;&#x2b;inhalt&#x2b;&#x27;&#x5d;&#x27;&#x3b;&#xd;&#xa;      else &#xd;&#xa;        schlecht_grund &#x3d; &#x27;Die Zahl ist zu klein&#x3a; &#x5b;&#x27;&#x2b;inhalt&#x2b;&#x27;&#x5d;&#x27;&#x3b;&#xd;&#xa;    &#x7d; else &#x7b;&#xd;&#xa;    &#xd;&#xa;      num &#x3d; num &#x2a; 10000&#x3b;&#xd;&#xa;      var neg &#x3d; false&#x3b;&#xd;&#xa;      if &#x28; num &#x3c; 0 &#x29; &#x7b; &#xd;&#xa;        neg &#x3d; true&#x3b;&#xd;&#xa;        num &#x3d; abs&#x28;num&#x29;&#x3b;&#xd;&#xa;      &#x7d;&#xd;&#xa;      var vorkomma &#x3d; trunc&#x28;num&#x29;&#x3b;&#xd;&#xa;&#xd;&#xa;      var pad_vork &#x3d; &#x28;&#x27;0000000000000000000&#x27;&#x2b;vorkomma&#x29;.slice&#x28;-19&#x29;&#x3b;&#xd;&#xa;&#xd;&#xa;      erg &#x3d; pad_vork.substring&#x28;0,15&#x29;&#x2b;&#x27;.&#x27;&#x2b;pad_vork.substring&#x28;15&#x29;&#x3b;&#xd;&#xa;      if &#x28; neg &#x29; erg &#x3d; &#x27;-&#x27;&#x2b;erg&#x3b;&#xd;&#xa;      else erg &#x3d;&#x27;&#x2b;&#x27;&#x2b;erg&#x3b;&#xd;&#xa;  &#xd;&#xa;      int_inhalt &#x3d; erg&#x3b;&#xd;&#xa;      int_inhalt2 &#x3d; erg&#x3b;&#xd;&#xa;    &#x7d;&#xd;&#xa;  &#x7d;&#xd;&#xa;&#xd;&#xa;&#x7d;&#xd;&#xa;</jsScript_script>
      </jsScript>    </jsScripts>    <fields>      <field>        <name>ok</name>
        <rename>ok</rename>
