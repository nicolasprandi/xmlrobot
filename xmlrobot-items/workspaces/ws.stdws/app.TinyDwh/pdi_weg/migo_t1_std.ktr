  <step>
    <name>werte mit uk</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <copies>1</copies>
         <partitioning>
           <method>none</method>
           <schema_name/>
           </partitioning>
    <connection>couronne</connection>
    <sql>select
 usg.attr_usg_id || &apos;|&apos; || trim(from wert.inhalt2) as uk,
 obj.obj_id,
 obj.obj_typ,
 attr.attr_id,
 attr.attr_typ,
 wert.wert_id,
 usg.attr_usg_id as uk_attr_usg_id, 
 wert.inhalt as uk_inhalt
from 
  int.wert as wert,
  int.attr as attr,  
  int.obj as obj,
  vok.attr_usg as usg
where
  obj.obj_id = attr.obj_id and
  attr.attr_id = wert.attr_id and
  attr.attr_typ = usg.attr_typ and
  usg.obj_typ = obj.obj_typ and
  usg.ident_club is null and
  ( wert.hat_mehr = 0  or usg.ident_mehr=1 ) and
  usg.ident = 1;</sql>
