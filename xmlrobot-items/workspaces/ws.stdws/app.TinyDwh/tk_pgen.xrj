<!-- setting the default-values -->
<job id="tk_pgen_default" role="hidden">
  <!--
  <need default="regex">(prop,pgen_type)</need>
  <need default="(dir,filetemp)">(dir,pgen_dir)</need>
  -->
</job>


<!-- pgen-core, make your changes here -->
<job id="tk_pgen_core" role="hidden" tip="pgen_: Tk Internal">

  <need default="">(prop,tk_pgen_add_flag)</need>
  <call_job job="tr_pgen" />
  
  <tk label="(prop,_pgen_l): (f,name_of_dir,(f,dir_of_file,(file,mm-liste)))" tip="(prop,_pgen_t)" flag="(prop,tk_pgen_add_flag)">

        
    <tk label="(prop,_pgen_ktr_l)" 
        id="pgen_created-ktr" 
        test_first="1" 
        tip="(prop,_pgen_ktr_t)" 
        base="(dir,pro)" 
        base2="(dir,pro)" 
        type="file" 
        extension=".ktr"
        flag="  save " />
        
    <tk type="msg" test_first="0">(prop,_pgen_justdoku_l)</tk>
    <tk label="(prop,_pgen_import_l) 1" 
        id="pgen_importfile1" 
        test_first="0" 
        tip="(prop,_pgen_import_t)" 
        type="file" />
        
    <tk label="(prop,_pgen_import_l) 2" 
        id="pgen_importfile2" 
        test_first="0" 
        tip="(prop,_pgen_import_t)" 
        type="file" />
        
    <tk label="(prop,_pgen_import_l) 3" 
        id="pgen_importfile3" 
        test_first="0" 
        tip="(prop,_pgen_import_t)" 
        type="file" />
                           
        
    <tk label="(prop,_pgen_detail_l)" 
        id="pgen_detail" 
        test_first="0" 
        tip="(prop,_pgen_detail_t)" 
        type="textblock" />
  </tk>
 
                           
</job>
