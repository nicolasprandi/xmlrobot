<!-- edit data: read, userinput, write -->
<job id="tk_pgen_edit" tip="pgen_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,pgen-data))">
      <!-- data exists already -->
      <prop id="tk_pgen_add_flag" x="sum_only "/>
      <call_job job="tk_pgen_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_pgen_add_flag" x="sum "/>
    </otherwise>
  </choose>
  <call_job job="tk_pgen_default"/>
  <!-- doing input -->
  <call_job job="tk_pgen_core"/>
  
  <!-- writing data -->
  <call_job job="tk_pgen_write"/>

</job>



<job id="tk_pgen_print_values" tip="pgen_: Prints the entered values" role="hidden">
  
  <call_job job="tk_pgen_read"/>
  
  <call_job job="tk_pgen_core">
    <prop id="tk_pgen_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_pgen_print_values_tips" tip="pgen_: Prints values and tips" role="hidden">
  
  <call_job job="tk_pgen_read"/>
  
  <call_job job="tk_pgen_core">
    <prop id="tk_pgen_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  
</job>

<job id="tk_pgen_print_help" tip="pgen_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_pgen_core">
    <prop id="tk_pgen_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_pgen_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,pgen-data)" />
    <prop id="joe-in-regex" x="(prop,pgen-regex)" />    
  </call_job>
  <call_job job="tk_pgen_default"/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_pgen_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,pgen-data)" />
    <prop id="joe-in-regex" x="(prop,pgen-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_pgen_clear"  tip="pgen_: Clears the data" role="hidden">
  <delete file="(file,pgen-data)"/>
</job>


</jobs>