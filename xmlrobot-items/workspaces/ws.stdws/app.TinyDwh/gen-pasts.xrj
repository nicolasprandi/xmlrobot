</job><job role="hidden" id="past-edit">
<need>(prop,past_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="past-read" />
<prop id="isAdd">0</prop>
<call_job job="past-editor" />
<call_job job="past-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+/- (prop,_sl_past) '(prop,past_for)'" />
</ti>
<call_job job="past-see" />
</job><job role="hidden" id="past-del">
<need>(prop,past_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="past-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_past) [ (prop,past_for) (prop,pasts_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,pasts)" where="(prop,pasts_offset)past[@row='(prop,past_key)']" />
<tp>Deleted (prop,past_for) #(prop,past_key)</tp>
<ti label="- (prop,_sl_past):" x="(f,html,bold,open)(f,html,bold,open)(prop,past_for)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="past-see-all" />
</job><job role="hidden" id="past-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="past_default_label_class" x="+ (prop,_sl_past)" />
<prop id="past_default_label_name" x="(f,when,(f,has,(prop,pasts_offset_label)), - (prop,pasts_offset_label),)" />
<prop id="pasts_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,past_key)</need>
<prop id="past_default_label_class" x="(prop,_sl_past)" />
<prop id="past_default_label_name" x="(prop,past_for)(f,when,(f,has,(prop,pasts_offset_label)), - (prop,pasts_offset_label),)" />
<prop id="pasts_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="past-tk" />
</job><job id="past-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="past-editor" />
<prop id="past_key">1</prop>
<when test="(f,not,(f,exists,prop,pasts_offset_new_key))">
<prop id="pasts_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,pasts)" sort="@row" number="@row" xpath="(prop,pasts_offset_new_key)past">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="past_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_past): #(prop,past_key)</i>
<call_job job="past-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_past) '(prop,past_for)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_past)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_past)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="past-see" />
</otherwise>
</choose>
</job><job role="hidden" id="past-write">
<need>(prop,past_key) (prop,isAdd)</need>
<need default="./">(prop,pasts_offset)</need>
<spirit act="open" id="pasts_spirit_tc" xml="(file,pasts)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,pasts_offset),/)">
<prop id="offset2" x="(f,substring,(prop,pasts_offset),0,(f,sub,(f,len,(prop,pasts_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,pasts_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="pasts_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;past row="(prop,past_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="pasts_spirit_tc" where="(prop,pasts_offset)past[@row='(prop,past_key)']" attribute="for" value="(f,vob,prop,past_for)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="pasts_spirit_tc" where="(prop,pasts_offset)past[@row='(prop,past_key)']" attribute="type" value="(f,vob,prop,past_type)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="pasts_spirit_tc" where="(prop,pasts_offset)past[@row='(prop,past_key)']" attribute="obj_tech_name" value="(f,vob,prop,past_obj_tech_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="pasts_spirit_tc" where="(prop,pasts_offset)past[@row='(prop,past_key)']" attribute="attr_tech_name" value="(f,vob,prop,past_attr_tech_name)" />
<spirit act="close" flag="save pretty" id="pasts_spirit_tc" />
</job></jobs>
