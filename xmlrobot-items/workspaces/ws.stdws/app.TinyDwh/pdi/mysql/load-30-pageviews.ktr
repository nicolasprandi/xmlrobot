    <optimizationLevel>9</optimizationLevel>
    <jsScripts>      <jsScript>        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>&#x2f;&#x2f;Script here&#xa;var zeit &#x3d; new Date&#x28;timestamp&#x2a;1000&#x29;&#x3b;&#xa;&#xa;var hosi &#x3d; hostname2&#x3b;&#xa;var count &#x3d; &#x28;hosi.match&#x28;&#x2f;&#x5c;.&#x2f;g&#x29; &#x7c;&#x7c; &#x5b;&#x5d;&#x29;.length&#x3b;&#xa;if &#x28; count &#x3d;&#x3d; 0 &#x29; &#x7b;&#xa;  hosi &#x3d; &#x27;0.0.0.&#x27;&#x2b;hosi&#x3b;&#xa;&#x7d; else if &#x28; count &#x3d;&#x3d; 1 &#x29; &#x7b;&#xa;  hosi &#x3d; &#x27;0.0.&#x27;&#x2b;hosi&#x3b;&#xa;&#x7d; else if &#x28; count &#x3d;&#x3d; 2 &#x29; &#x7b;&#xa;  hosi &#x3d; &#x27;0.&#x27;&#x2b;hosi&#x3b;&#xa;&#x7d;&#xa;var p1 &#x3d; hosi.indexOf&#x28;&#x27;.&#x27;,0&#x29;&#x3b;&#xa;var p2 &#x3d; hosi.indexOf&#x28;&#x27;.&#x27;,p1&#x2b;1&#x29;&#x3b;&#xa;var p3 &#x3d; hosi.indexOf&#x28;&#x27;.&#x27;,p2&#x2b;1&#x29;&#x3b;&#xa;&#xa;var n1 &#x3d; hosi.substring&#x28;0,p1&#x29;&#x3b;&#xa;var n2 &#x3d; hosi.substring&#x28;p1&#x2b;1,p2&#x29;&#x3b;&#xa;var n3 &#x3d; hosi.substring&#x28;p2&#x2b;1,p3&#x29;&#x3b;&#xa;var n4 &#x3d; hosi.substring&#x28;p3&#x2b;1&#x29;&#x3b;&#xa;&#xa;var m1 &#x3d; &#x28;&#x27;000&#x27;&#x2b;n1&#x29;.slice&#x28;-3&#x29;&#x3b;&#xa;var m2 &#x3d; &#x28;&#x27;000&#x27;&#x2b;n2&#x29;.slice&#x28;-3&#x29;&#x3b;&#xa;var m3 &#x3d; &#x28;&#x27;000&#x27;&#x2b;n3&#x29;.slice&#x28;-3&#x29;&#x3b;&#xa;var m4 &#x3d; &#x28;&#x27;000&#x27;&#x2b;n4&#x29;.slice&#x28;-3&#x29;&#x3b;&#xa;&#xa;var hoso &#x3d; m1&#x2b;&#x27;.&#x27;&#x2b;m2&#x2b;&#x27;.&#x27;&#x2b;m3&#x2b;&#x27;.&#x27;&#x2b;m4&#x3b;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;&#xa;</jsScript_script>
      </jsScript>    </jsScripts>    <fields>      <field>        <name>zeit</name>
        <rename>zeit</rename>
        <type>Date</type>
