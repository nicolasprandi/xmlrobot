  <step>
    <name>hat: sepa, da, auftrag, filiale, automat</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var hat_auftrag = false;
var hat_auftrags_nummer = "";
var hat_auftrags_code = "";

var hat_sepa = false;
if ( mein_sepa != null &amp;&amp; mein_sepa != "") { 
  hat_sepa = true;
  hat_auftrag = true;
  hat_auftrags_nummer = "sepa ?";
}

var hat_da = false;
if ( mein_da != null &amp;&amp; mein_da != "") {
  hat_da = true;
  hat_auftrag = true;
  hat_auftrags_nummer = "dauf "+mein_da_nummer;
  hat_auftrags_code = "dauf|"+ ich_bankname + "|" +mein_da_nummer;
}

var hat_filiale = false;
if ( mein_filiale != null &amp;&amp; mein_filiale != "") {
  hat_filiale = true;
}

var hat_automat = false;
if ( mein_automat2 != null &amp;&amp; mein_automat2 != "") { 
  hat_automat = true;
}

var hat_geg_partner = false;
if ( geg_name != null &amp;&amp; geg_name != "") { 
  hat_geg_partner = true;
}
    
var hat_geg_kto = false;
if ( geg_kto != null &amp;&amp; geg_kto != "") { 
  hat_geg_kto = true;
}

var hat_geg_partner_mit_kto = false;
if ( geg_name != null &amp;&amp; geg_kto != null &amp;&amp; geg_name != "" &amp;&amp; geg_kto != "" ) { 
  hat_geg_partner_mit_kto = true;
}

var hat_kontoverwendung = false;   
var hat_kontoverwendung_id_obj_konto = -1;  
var hat_kontoverwendung_typ = -1;
// wir gehen mal von einem positiven betrag aus
var ktbw_belastet_obj_id = -1;
var ktbw_beguenstigt_obj_id = -1;



  ktbw_beguenstigt_obj_id = id_obj_konto_ich;
  if ( hat_geg_partner &amp;&amp; hat_geg_kto ) {
    ktbw_belastet_obj_id = id_obj_partner_geg;
    hat_kontoverwendung = true;
    hat_kontoverwendung_id_obj_konto = id_obj_konto_geg;
    hat_kontoverwendung_typ = typ_bez_ktbw_viakonto_belastet;
    if ( Betrag &lt; 0 ) hat_kontoverwendung_typ = typ_bez_ktbw_viakonto_beguenstigt;
  } else if ( hat_geg_partner ) {
    ktbw_belastet_obj_id = id_obj_partner_geg;
  } else if ( hat_geg_kto ) {
    ktbw_belastet_obj_id = id_obj_konto_geg;
  } 

if ( Betrag &lt; 0 ) {
 var x = ktbw_belastet_obj_id;
 ktbw_belastet_obj_id = ktbw_beguenstigt_obj_id;
 ktbw_beguenstigt_obj_id = x;
} 

var betragAbs2 = Betrag;
if ( betragAbs2 &lt; 0 )
  betragAbs2 = Betrag * -1;



</jsScript_script>
      </jsScript>
    </jsScripts>
