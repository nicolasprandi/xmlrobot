kontoverwendung &#x3d; false&#x3b;   &#xa;var hat_kontoverwendung_id_obj_konto &#x3d; -1&#x3b;  &#xa;var hat_kontoverwendung_typ &#x3d; -1&#x3b;&#xa;&#x2f;&#x2f; wir gehen mal von einem positiven betrag aus&#xa;var ktbw_belastet_obj_id &#x3d; -1&#x3b;&#xa;var ktbw_beguenstigt_obj_id &#x3d; -1&#x3b;&#xa;&#xa;&#xa;&#xa;  ktbw_beguenstigt_obj_id &#x3d; id_obj_konto_ich&#x3b;&#xa;  if &#x28; hat_geg_partner &#x26;&#x26; hat_geg_kto &#x29; &#x7b;&#xa;    ktbw_belastet_obj_id &#x3d; id_obj_partner_geg&#x3b;&#xa;    hat_kontoverwendung &#x3d; true&#x3b;&#xa;    hat_kontoverwendung_id_obj_konto &#x3d; id_obj_konto_geg&#x3b;&#xa;    hat_kontoverwendung_typ &#x3d; typ_bez_ktbw_viakonto_belastet&#x3b;&#xa;    if &#x28; Betrag &#x3c; 0 &#x29; hat_kontoverwendung_typ &#x3d; typ_bez_ktbw_viakonto_beguenstigt&#x3b;&#xa;  &#x7d; else if &#x28; hat_geg_partner &#x29; &#x7b;&#xa;    ktbw_belastet_obj_id &#x3d; id_obj_partner_geg&#x3b;&#xa;  &#x7d; else if &#x28; hat_geg_kto &#x29; &#x7b;&#xa;    ktbw_belastet_obj_id &#x3d; id_obj_konto_geg&#x3b;&#xa;  &#x7d; &#xa;&#xa;if &#x28; Betrag &#x3c; 0 &#x29; &#x7b;&#xa; var x &#x3d; ktbw_belastet_obj_id&#x3b;&#xa; ktbw_belastet_obj_id &#x3d; ktbw_beguenstigt_obj_id&#x3b;&#xa; ktbw_beguenstigt_obj_id &#x3d; x&#x3b;&#xa;&#x7d; &#xa;&#xa;var betragAbs2 &#x3d; Betrag&#x3b;&#xa;if &#x28; betragAbs2 &#x3c; 0 &#x29;&#xa;  betragAbs2 &#x3d; Betrag &#x2a; -1&#x3b;&#xa;&#xa;&#xa;&#xa;</jsScript_script>
