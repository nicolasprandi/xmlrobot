<?xml version="1.0" ?>

<jobs>
<call_job job="prolog"/>

<job id="_statistics" role="hidden">
<call_job job="conf-stat-intro-hori" />

<ti_break class_table="tabLinklist" />
<call_job job="tr_stats" />
<!-- 

  <call_job
      job="sql-list-them" >
      <dir id="sr-dir" x="(dir,my-statistics)"/>
      <prop id="sr-label" x="My Stats"/>                         sd
  </call_job>              -->
  
  <call_job job="tr_stats"/>
  <ti_break class_table="tabLinklistSmall" />
  <!-- 
  <ti_space height="2px"/>
  <ti label="(prop,_stats_main_statistiken)"/>
  <ti_space height="3px"/>
  <ti_hr/>
  <ti_space height="2px"/>      -->
  
  <call_job
      job="sql-list-them" >
    <dir id="sr-dir" x="(dir,app)sql-boxes"/>
    <prop id="sr-label" x="(prop,_stats_main_boxes_i)"/>
    <prop id="sr-translator" x="sql-box"/>
    <prop id="sr-class" x="c"/>
  </call_job>
  
  <ti_space height="6px"/>
    
  <call_job
      job="sql-list-them" >
    <dir id="sr-dir" x="(dir,app)sql-usages"/>
    <prop id="sr-label" x="(prop,_stats_main_usages)"/>
    <prop id="sr-translator" x="sql-list-all"/>
    <prop id="sr-class" x="c"/>
  </call_job>
  
  <ti_space height="6px"/>
  <call_job
      job="sql-list-them" >
    <dir id="sr-dir" x="(dir,app)sql-unused"/>
    <prop id="sr-label" x="(prop,_stats_main_unused)"/>
    <prop id="sr-translator" x="sql-list-all"/>
    <prop id="sr-class" x="c"/>
  </call_job>  
  
  <ti_space height="6px"/>
  <call_job
      job="sql-list-them" >
    <dir id="sr-dir" x="(dir,app)sql-unknown"/>
    <prop id="sr-label" x="(prop,_stats_main_unknown)"/>
    <prop id="sr-translator" x="sql-list-all"/>
    <prop id="sr-class" x="c"/>
  </call_job>    
  <ti_space height="2px"/>
  <ti_hr/>
  <ti_space height="2px"/>
  <call_job
      job="sql-list-them" >
    <dir id="sr-dir" x="(dir,app)sql-usages-import"/>
    <prop id="sr-label" x="(prop,_stats_main_usages_i)"/>
    <prop id="sr-translator" x="sql-list-all"/>
    <prop id="sr-class" x="i"/>
  </call_job>
  
  <ti_space height="6px"/>
  <call_job
      job="sql-list-them" >
    <dir id="sr-dir" x="(dir,app)sql-unused-import"/>
    <prop id="sr-label" x="(prop,_stats_main_unused_i)"/>
    <prop id="sr-translator" x="sql-list-all"/>
    <prop id="sr-class" x="i"/>
  </call_job>  
  
  <ti_space height="6px"/>
  <call_job
      job="sql-list-them" >
    <dir id="sr-dir" x="(dir,app)sql-unknown-import"/>
    <prop id="sr-label" x="(prop,_stats_main_unknown_i)"/>
    <prop id="sr-translator" x="sql-list-all"/>
    <prop id="sr-class" x="i"/>
  </call_job>   
  <ti_space height="2px"/>   
  <ti_hr/>
  <ti_space height="2px"/>
  <call_job
      job="sql-list-them" >
    <dir id="sr-dir" x="(dir,app)sql-diverse"/>
    <prop id="sr-label" x="(prop,_stats_main_divers)"/>
    <prop id="sr-translator" x="sql-list-all"/>
  </call_job>
 <!--   
 <call_job job="sql-list-them">
  <prop id="sr-label" x="(prop,_stats_main_vokabular)"/>
  <dir id="sr-dir" x="(dir,app)sql-vok"/>
  <prop id="sr-translator" x="vok"/>
 </call_job>
 -->
   
 <!-- nicolas -->
    <when test="(f,exists_dir,(dir,app)sql-schlecht)">
    <ti_space height="6px"/>
    <ti_break/>
      <ti label="(prop,_stats_main_add)"/>
   
      <ti type="call_job"
          job="sql-list-them" 
          explain="Schlecht"
          label="Super-Admin"
          xkey="">
        <dir id="sr-dir" x="(dir,app)sql-schlecht"/>
        <prop id="sr-label" x="Schlecht"/>
      </ti>
      
         
      <ti type="call_job"
          job="sql-list-them" 
          explain="Diverse"
          label="Super-Admin"
          key="diverse sqls">
        <dir id="sr-dir" x="(dir,app)sql-1"/>
