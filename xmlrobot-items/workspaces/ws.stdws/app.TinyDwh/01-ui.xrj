<?xml version="1.0" ?>      

<jobs>

<call_job job="prolog"/>                    

<throw test="(f,gt_num,(f,time,yyyyMMdd),30000101)">Out of service is this great app</throw>
 <job id="Stapel-Aktion" role="expert" 
      lang="de" 
      tip="Stapeln erm&#246;glichen die Kombination von Abfragen und Sql-Interfaces um diese in weiterer folge als Gruppe auszuf&#252;hren." 
      class_menu="amBulks">

    <call_job job="_bulk"/>          
</job>

 <job id="Bulk-Actions" role="expert" 
      lang="en" 
      tip="Bulks allow the combination of Queries and Sql-Interfaces for further execution as a group." 
      class_menu="amBulks">

    <call_job job="_bulk"/>
</job>

<job  id="Queries" role="expert" lang="en" xpri="10" 
