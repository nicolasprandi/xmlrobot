<jobs>

<call_job job="prolog" />


<!-- gui Adapters: to copy in the app  take the edit to your gui.... -->

<job id="Mvc Conf?" role="hidden">

    <call_job job="tk_mvc_print_values_tips" />
    <ti_hr/>  
    <ti type="rec" xlabel=" " > 
      <ti> </ti>
      <ti type="call_job" job="Mvc Conf" explain="(prop,_x_edit)" flag="button" class="fx fxEdit" label=" "/>
    </ti>
        
</job>

<job id="Mvc Conf" role="hidden">
  <call_job job="tk_mvc_edit"/>
  <call_job job="_mat_views"/>
</job>

<!-- setting the default-values -->
<job id="tk_mvc_default" role="hidden">
  <need default="name">(prop,mvc_style)</need>
  <need default="f_">(prop,mvc_prefix_view)</need>  
</job>

<!-- mvc-core, make your changes here -->
<job id="tk_mvc_core" role="hidden" tip="mvc_: Tk Internal">
  <call_job job="tr_mvc"/>
  
  <need default="">(prop,tk_mvc_add_flag)</need>

  <tk label="(prop,_mvc_tk_l)" 
      flag="(prop,tk_mvc_add_flag)"
      tip="(prop,_mvc_tk_t)"
      tk_id="29"> 

    <tk id="mvc_style"
        type="sel"  
        flag="nono"
        label="(prop,_mvc_l_style)" 
        test_first="0"        
        tip="(prop,_mvc_t_style)">
        <sel label="(prop,_mvc_s_style_name)">name</sel>
        <sel label="(prop,_mvc_s_style_incog)">incog</sel>   
    </tk>
            
    <tk id="mvc_prefix" 
        label="(prop,_mvc_l_prefix)"
        rule="filename"
        test_first="0"
        tip="(prop,_mvc_t_prefix)" 
        cols="15"/>         
        
    <tk id="mvc_prefix_view" 
        label="(prop,_mvc_l_prefix_view)"
        flag="nono"
        rule="filename"
        test_first="0"
        cols="15"
        tip="(prop,_mvc_t_prefix_view)" /> 
                                 
  </tk>   
</job>
<!-- 
<job id="See Values: mvc_" role="dev">
  <call_job job="tk_mvc_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_mvc_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: mvc_">
  <tk type="msg" x="Sure to clear data of mvc_ ?" msg_type="w"/>
  <call_job job="tk_mvc_clear"/>
</job>

<job id="Print Values:  mvc_">
  <call_job job="tk_mvc_print_values"/>
</job>
<job id="Print Help: mvc_" role="dev">
  <call_job job="tk_mvc_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_mvc_edit" tip="mvc_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,mvc-data))">
      <!-- data exists already -->
      <prop id="tk_mvc_add_flag" x="sum_only xprint"/>
      <call_job job="tk_mvc_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_mvc_add_flag" x="sum xprint"/>
    </otherwise>
  </choose>
  <call_job job="tk_mvc_default"/>
  <!-- doing input -->
  <call_job job="tk_mvc_core"/>
  
  <!-- writing data -->
  <call_job job="tk_mvc_write"/>

</job>



<job id="tk_mvc_print_values" tip="mvc_: Prints the entered values" role="hidden">
  
  <call_job job="tk_mvc_read"/>
  
  <call_job job="tk_mvc_core">
    <prop id="tk_mvc_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_mvc_print_values_tips" tip="mvc_: Prints values and tips" role="hidden">
  
  <call_job job="tk_mvc_read"/>
  
  <call_job job="tk_mvc_core">
    <prop id="tk_mvc_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  
</job>

<job id="tk_mvc_print_help" tip="mvc_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_mvc_core">
    <prop id="tk_mvc_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_mvc_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,mvc-data)" />
    <prop id="joe-in-regex" x="(prop,mvc-regex)" />    
  </call_job>
  <call_job job="tk_mvc_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_mvc_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,mvc-data)" />
    <prop id="joe-in-regex" x="(prop,mvc-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_mvc_clear"  tip="mvc_: Clears the data" role="hidden">
  <delete file="(file,mvc-data)"/>
</job>


</jobs>