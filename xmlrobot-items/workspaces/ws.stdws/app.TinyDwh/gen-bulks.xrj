</job><job role="hidden" id="bulk-edit">
<need>(prop,bulk_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="bulk-read" />
<prop id="isAdd">0</prop>
<call_job job="bulk-editor" />
<call_job job="bulk-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+/- (prop,_sl_bulk) '(f,text,cut_nice,(prop,bulk_name),38)'" />
</ti>
<call_job job="bulk_event_post_update" />
</job><job role="hidden" id="bulk-del">
<need>(prop,bulk_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="bulk-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_bulk) [ (f,text,cut_nice,(prop,bulk_name),38) (prop,bulks_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,bulks)" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,bulk_name),38) #(prop,bulk_key)</tp>
<ti label="- (prop,_sl_bulk):" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,bulk_name),38)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="bulk-see-all" />
</job><job role="hidden" id="bulk-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="bulk_default_label_class" x="+ (prop,_sl_bulk)" />
<prop id="bulk_default_label_name" x="(f,when,(f,has,(prop,bulks_offset_label)), | (prop,bulks_offset_label),)" />
<prop id="bulks_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,bulk_key)</need>
<prop id="bulk_default_label_class" x="(prop,_sl_bulk)" />
<prop id="bulk_default_label_name" x="(f,text,cut_nice,(prop,bulk_name),38)(f,when,(f,has,(prop,bulks_offset_label)), - (prop,bulks_offset_label),)" />
<prop id="bulks_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="bulk-tk" />
</job><job id="bulk-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="bulk-editor" />
<prop id="bulk_key">1</prop>
<when test="(f,not,(f,exists,prop,bulks_offset_new_key))">
<prop id="bulks_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,bulks)" sort="@row" number="@row" xpath="(prop,bulks_offset_new_key)bulk">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="bulk_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_bulk): #(prop,bulk_key)</i>
<call_job job="bulk-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_bulk) '(f,text,cut_nice,(prop,bulk_name),38)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_bulk)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_bulk)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="bulk_event_post_insert" />
</otherwise>
</choose>
</job><job role="hidden" id="bulk-write">
<need>(prop,bulk_key) (prop,isAdd)</need>
<need default="./">(prop,bulks_offset)</need>
<spirit act="open" id="bulks_spirit_tc" xml="(file,bulks)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,bulks_offset),/)">
<prop id="offset2" x="(f,substring,(prop,bulks_offset),0,(f,sub,(f,len,(prop,bulks_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,bulks_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="bulks_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;bulk row="(prop,bulk_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="type" value="(f,vob,prop,bulk_type)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="name" value="(f,vob,prop,bulk_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="doku" value="(f,vob,prop,bulk_doku)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="bscript" value="(f,vob,prop,bulk_bscript)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="flags" value="(f,vob,prop,bulk_flags)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="qu_file" value="(f,vob,prop,bulk_qu_file)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="qu_row" value="(f,vob,prop,bulk_qu_row)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="sqli_file" value="(f,vob,prop,bulk_sqli_file)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="sqli_row" value="(f,vob,prop,bulk_sqli_row)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="bulks_spirit_tc" where="(prop,bulks_offset)bulk[@row='(prop,bulk_key)']" attribute="script" value="(f,vob,prop,bulk_script)" />
<spirit act="close" flag="save pretty" id="bulks_spirit_tc" />
</job></jobs>
