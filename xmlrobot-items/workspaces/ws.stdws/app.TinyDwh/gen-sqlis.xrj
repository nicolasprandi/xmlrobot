</job><job role="hidden" id="sqli-edit">
<need>(prop,sqli_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="sqli-read" />
<prop id="isAdd">0</prop>
<call_job job="sqli-editor" />
<call_job job="sqli-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+/- (prop,_sl_sqli) '(prop,sqli_name)'" />
</ti>
<call_job job="sqli_event_post_update" />
</job><job role="hidden" id="sqli-del">
<need>(prop,sqli_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="sqli-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_sqli) [ (prop,sqli_name) (prop,sqlis_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,sqlis)" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" />
<tp>Deleted (prop,sqli_name) #(prop,sqli_key)</tp>
<ti label="- (prop,_sl_sqli):" x="(f,html,bold,open)(f,html,bold,open)(prop,sqli_name)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="sqli-see-all" />
</job><job role="hidden" id="sqli-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="sqli_default_label_class" x="+ (prop,_sl_sqli)" />
<prop id="sqli_default_label_name" x="(f,when,(f,has,(prop,sqlis_offset_label)), | (prop,sqlis_offset_label),)" />
<prop id="sqlis_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,sqli_key)</need>
<prop id="sqli_default_label_class" x="(prop,_sl_sqli)" />
<prop id="sqli_default_label_name" x="(prop,sqli_name)(f,when,(f,has,(prop,sqlis_offset_label)), - (prop,sqlis_offset_label),)" />
<prop id="sqlis_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="sqli-tk" />
</job><job id="sqli-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="sqli-editor" />
<prop id="sqli_key">1</prop>
<when test="(f,not,(f,exists,prop,sqlis_offset_new_key))">
<prop id="sqlis_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,sqlis)" sort="@row" number="@row" xpath="(prop,sqlis_offset_new_key)sqli">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="sqli_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_sqli): #(prop,sqli_key)</i>
<call_job job="sqli-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_sqli) '(prop,sqli_name)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_sqli)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_sqli)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="sqli_event_post_update" />
</otherwise>
</choose>
</job><job role="hidden" id="sqli-write">
<need>(prop,sqli_key) (prop,isAdd)</need>
<need default="./">(prop,sqlis_offset)</need>
<spirit act="open" id="sqlis_spirit_tc" xml="(file,sqlis)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,sqlis_offset),/)">
<prop id="offset2" x="(f,substring,(prop,sqlis_offset),0,(f,sub,(f,len,(prop,sqlis_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,sqlis_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="sqlis_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;sqli row="(prop,sqli_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="type" value="(f,vob,prop,sqli_type)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="name" value="(f,vob,prop,sqli_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="docu" value="(f,vob,prop,sqli_docu)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="cmt_session" value="(f,vob,prop,sqli_cmt_session)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="rq_import" value="(f,vob,prop,sqli_rq_import)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="rq_central" value="(f,vob,prop,sqli_rq_central)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="max_ids" value="(f,vob,prop,sqli_max_ids)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="cmt_style" value="(f,vob,prop,sqli_cmt_style)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="cmt_size" value="(f,vob,prop,sqli_cmt_size)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="sc_top" value="(f,vob,prop,sqli_sc_top)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="sc_intro" value="(f,vob,prop,sqli_sc_intro)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="sc_main" value="(f,vob,prop,sqli_sc_main)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="sc_extro" value="(f,vob,prop,sqli_sc_extro)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="sc_fin" value="(f,vob,prop,sqli_sc_fin)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="close_session" value="(f,vob,prop,sqli_close_session)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="gb_import" value="(f,vob,prop,sqli_gb_import)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sqlis_spirit_tc" where="(prop,sqlis_offset)sqli[@row='(prop,sqli_key)']" attribute="gb_central" value="(f,vob,prop,sqli_gb_central)" />
<spirit act="close" flag="save pretty" id="sqlis_spirit_tc" />
</job></jobs>
