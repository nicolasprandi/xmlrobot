        <jsScript_name>VerifyEmail</jsScript_name>
        <jsScript_script>var request &#x3d; new XML&#x28;&#x29;&#xd;&#xa;&#xd;&#xa;request &#x3d; &#x3c;soap&#x3a;Envelope xmlns&#x3a;xsi&#x3d;&#x22;http&#x3a;&#x2f;&#x2f;www.w3.org&#x2f;2001&#x2f;XMLSchema-instance&#x22; xmlns&#x3a;xsd&#x3d;&#x22;http&#x3a;&#x2f;&#x2f;www.w3.org&#x2f;2001&#x2f;XMLSchema&#x22; xmlns&#x3a;soap&#x3d;&#x22;http&#x3a;&#x2f;&#x2f;schemas.xmlsoap.org&#x2f;soap&#x2f;envelope&#x2f;&#x22;&#x3e;&#xd;&#xa;  &#x3c;soap&#x3a;Body&#x3e;&#xd;&#xa;    &#x3c;GetISOCountryCodeByCountyName xmlns&#x3d;&#x22;http&#x3a;&#x2f;&#x2f;www.webserviceX.NET&#x22;&#x3e;&#xd;&#xa;      &#x3c;CountryName&#x3e;&#x7b;country&#x7d;&#x3c;&#x2f;CountryName&#x3e;&#xd;&#xa;    &#x3c;&#x2f;GetISOCountryCodeByCountyName&#x3e;&#xd;&#xa;  &#x3c;&#x2f;soap&#x3a;Body&#x3e;&#xd;&#xa;&#x3c;&#x2f;soap&#x3a;Envelope&#x3e;&#x3b;&#xd;&#xa;&#xd;&#xa;var requestXml&#x3d;request.toXMLString&#x28;&#x29;&#x3b;</jsScript_script>
      </jsScript>    </jsScripts>    <fields>      <field>        <name>requestXml</name>
        <rename>requestXml</rename>
        <type>String</type>
        <length>100000</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>    </fields>     <cluster_schema/>
