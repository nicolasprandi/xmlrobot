<need>(prop,ima_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="ima-read" />
<prop id="isAdd">0</prop>
<call_job job="ima-editor" />
<call_job job="ima-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+/- Statement '(f,text,cut_nice,(prop,ima_cmd),100)'" />
</ti>
<call_job job="imp-see" />
</job><job role="hidden" id="ima-del">
<need>(prop,ima_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="ima-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Statement [ (f,text,cut_nice,(prop,ima_cmd),100) (prop,imas_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,imas)" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,ima_cmd),100) #(prop,ima_key)</tp>
<ti label="- Statement:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,ima_cmd),100)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="imp-see" />
</job><job role="hidden" id="ima-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="ima_default_label_class" x="+ Statement" />
<prop id="ima_default_label_name" x="(f,when,(f,has,(prop,imas_offset_label)), | (prop,imas_offset_label),)" />
<prop id="imas_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,ima_key)</need>
<prop id="ima_default_label_class" x="Statement" />
<prop id="ima_default_label_name" x="(f,text,cut_nice,(prop,ima_cmd),100)(f,when,(f,has,(prop,imas_offset_label)), - (prop,imas_offset_label),)" />
<prop id="imas_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="ima-tk" />
</job><job id="ima-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="ima-editor" />
<prop id="ima_key">1</prop>
<when test="(f,not,(f,exists,prop,imas_offset_new_key))">
<prop id="imas_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,imas)" sort="@row" number="@row" xpath="(prop,imas_offset_new_key)ima">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="ima_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Statement: #(prop,ima_key)</i>
<call_job job="ima-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ Statement '(f,text,cut_nice,(prop,ima_cmd),100)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_ima)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_ima)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="imp-see" />
</otherwise>
</choose>
</job><job role="hidden" id="ima-write">
<need>(prop,ima_key) (prop,isAdd)</need>
<need default="./">(prop,imas_offset)</need>
<spirit act="open" id="imas_spirit_tc" xml="(file,imas)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,imas_offset),/)">
<prop id="offset2" x="(f,substring,(prop,imas_offset),0,(f,sub,(f,len,(prop,imas_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,imas_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="imas_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;ima row="(prop,ima_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="cmd" value="(f,vob,prop,ima_cmd)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="type" value="(f,vob,prop,ima_type)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="catch" value="(f,vob,prop,ima_catch)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="on" value="(f,vob,prop,ima_on)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="cond" value="(f,vob,prop,ima_cond)" />
<when test="(f,exists,prop,ima_pronto)">
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="pronto" value="(f,vob,prop,ima_pronto)" />
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="dbms" value="(f,vob,prop,ima_dbms)" />
<when test="(f,exists,prop,ima_cust_flag)">
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="cust_flag" value="(f,vob,prop,ima_cust_flag)" />
</when>
<when test="(f,exists,prop,ima_cust_how)">
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="cust_how" value="(f,vob,prop,ima_cust_how)" />
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="name" value="(f,vob,prop,ima_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="desc" value="(f,vob,prop,ima_desc)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="imas_spirit_tc" where="(prop,imas_offset)ima[@row='(prop,ima_key)']" attribute="work" value="(f,vob,prop,ima_work)" />
<spirit act="close" flag="save pretty" id="imas_spirit_tc" />
</job></jobs>
