<jobs>

<!--
     <when test="(f,has,prop,pro)">  
  <file id="dosi-data" x="(dir,pro)dosi-data.xrs"/>
  <prop id="dosi-regex" x="dosi_.+"/>
</when>
-->
<call_job job="prolog"/>


<!-- gui Adapters: to copy in the app .... 

<job id="See Values: dosi_" role="dev">
  <call_job job="tk_dosi_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_dosi_clear" explain="Clear this data"/>  
</job>

<job id="Edit: dosi_">
  <call_job job="tk_dosi_edit"/>
</job>

<job id="Edit: dosi_?">
  <call_job job="tk_dosi_print_values_tips"/>
