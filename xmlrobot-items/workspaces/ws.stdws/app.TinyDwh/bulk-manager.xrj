<?xml version="1.0" ?>

<jobs>

<call_job job="prolog"/>

<job id="call-convert-bulk-to-ms" role="hidden">
   <file id="bulk-file"></file>
   <file id="new-ims-file">(dir,pro)new-ims-file.xml</file> 
   
  <tk flag="print">
   <tk type="file" id="bulk-file" flag="print"/>
   <tk type="file" id="new-ims-file" flag="print"/>
  </tk>
     
   <call_job job="convert-bulk-to-ims"/>
</job>
<job id="convert-bulk-to-ims" role="hidden">
  <file id="naming" x="(dir,pro)gui/naming.xml"/>
  <create_file file="(file,naming)"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<sps>
  <sp sn="1" name="PubBox"/>
  <sp sn="2" name="PubObj"/>
  <sp sn="3" name="PubAttr"/>
  <sp sn="4" name="PubWert"/>
  <sp sn="5" name="PubMehr"/>        
  <sp sn="6" name="PubBez"/>
  <sp sn="7" name="MigProduceMigs"/>
  <sp sn="8" name="MigOptiEquals"/>
  <sp sn="9" name="MigOptiCyles"/>
  <sp sn="10" name="MigOptiDouble"/>       
  <sp sn="11" name="MigSmart"/>
  <sp sn="12" name="MigDoAttrMigs"/>
  <sp sn="13" name="MigDoBezBMigs"/>
  <sp sn="14" name="MigDoBezAMigs"/>
  <sp sn="15" name="MigUntop"/>       
  <sp sn="16" name="MigRemoveObjects"/>
  <sp sn="17" name="HealRelations"/>
  <sp sn="18" name="HealAttributes"/>
  <sp sn="19" name="HealWert"/>
  <sp sn="20" name="TopSolo"/>       
  <sp sn="21" name="TopWerte"/>

</sps>
]]></create_file>

  <spirit id="naming"
          file="(file,naming)"
          act="open"/>     
  
  <create_file file="(file,new-ims-file)">&lt;sps/&gt;</create_file>
  <spirit id="ok"
          file="(file,new-ims-file)"
          act="open"/>           
   <!--        
   <ti type="file">(file,new-ims-file)</ti>       -->
   <ti label="Going into analysing Selection-Update" />
   <prop id="sumi"></prop>
   <prop id="total">0</prop>
   <prop id="total_selects"></prop>
   
   <dir id="queries-xdb">(f,dir_of_dir,(f,dir_of_dir,(f,dir_of_file,(file,bulk-file))))queries/</dir>
   <ti label="Home of queries" type="dir">(dir,queries-xdb)</ti>
   
   <loop id="bulk" xml="(file,bulk-file)" xpath="bulk[@type='qu' or @type='qu_sqli']">      <!-- [@type='qu']
   <interpreter watch="1" />
   (dir,pro)xDb/             (dir,goMoon)               (dir,pro)xDb/         <ti>(loop,bulk,xml?)</ti> 
    -->
                  
    
    <prop id="sumi">(loop,bulk,#i)</prop>
    <file id="source-queries">(dir,queries-xdb)(loop,bulk,@qu_file)/queries-list.xml</file>
                                             
                                             
                                             
    
    <prop id="the-query">(f,xpath,(file,source-queries),squery[@row='(loop,bulk,@qu_row)'],@sql)</prop> 
    <prop id="this-one-ok">0</prop>
    <when test="(f,has,prop,the-query)">
    
    <when test="(f,starts_with,(loop,bulk,@name),sn=)">
    <prop id="the-number">(loop,bulk,@name)</prop> 
    <prop id="the-number">(f,substring_before,(prop,the-number),:)</prop> 
    
    <prop id="the-number" test="(f,not,(f,has,prop,the-number))">(loop,bulk,@name)</prop> 
    
    <prop id="the-number">(f,substring_after,(prop,the-number),sn=)</prop> 
    <prop id="the-number" test="(f,eq_text,(prop,the-number),(loop,bulk,@name))"></prop> 
    

    <when test="(f,has,prop,the-number)">                
      <try_catch><try>
        <prop id="the-name">(f,spirit,naming,//sp[@sn='(prop,the-number)'],@name)</prop>
        <prop id="my-name">(loop,bulk,@name)</prop>
        <prop id="my-name">(f,substring_after,(prop,my-name),:)</prop>
        <when test="(f,eq_text,(prop,my-name),(loop,bulk,@name))">
          <prop id="my-name"></prop>
        </when>
        <prop id="this-one-ok">1</prop>
        <ti label="(f,html,b,o)(prop,the-name)(f,html,b,c)" x="(f,html,b,o)#(prop,the-number) Accepted(f,html,b,c)"/>
        <ti label=" ">(f,html,b,o)(loop,bulk,@name)(f,html,b,c) sn=(prop,the-number)</ti>
        <!-- <ti label="accepted sn=(prop,the-number)">(prop,the-name) :: (loop,bulk,@name)</ti> 
        <ti label=" ">(f,html,i,o)sn=(prop,the-number):(f,html,i,c)</ti>             -->
        <ti label=" " flag="wide">(prop,the-query)</ti>   
        <prop id="total">(f,add,1,(prop,total))</prop>  
        <prop id="total_selects" x="(prop,total_selects)(prop,total)(e:c) (prop,the-name) #(prop,the-number)&#xA;" />
        <spirit id="ok"
                act="xml_update"
                how="append">               
                <inline attribute="with">&lt;sp sn=&quot;(x,(prop,the-number))&quot; 
                (f,when,(f,has,prop,my-name),name=&quot;(f,x,(prop,my-name))&quot;,)
                originalName=&quot;(x,(loop,bulk,@name))&quot;
                sql=&quot;(x,(prop,the-query))&quot; /&gt;&#xA;</inline>
                
        </spirit>           
        
      </try>
      <catch>
        <ti label="Exception">(prop,catched_msg)</ti>
      </catch>
      </try_catch> 
     </when>
     </when>
     
     </when>
     
     <when test="(f,not,(prop,this-one-ok))">
        <ti label="(f,html,b,o)!! rejected !!(f,html,b,c)">bulk with name &apos;(f,html,b,o)(loop,bulk,@name)(f,html,b,c)&apos;</ti>
     </when> 
   
   </loop>
  <spirit id="ok"
          act="close" flag="save write"/>     
          
  <spirit id="naming"
          act="close"/> 
  <ti label="Analyzing Selection-Update done" />        
  <ti label="total">(prop,total)</ti>           
  <ti label="records found">(prop,sumi)</ti>
<ti type="file" label="Updated Selects">(file,new-ims-file)</ti>  
  <prop id="kick_confirm">(f,replace,(f,file_content,(file,new-ims-file)),&amp;#xA;,
)</prop> 
  <prop id="kick_confirm">(f,replace,(prop,kick_confirm),/&gt;,/&gt;
)</prop>
  <prop id="kick_confirm">(f,replace,(prop,kick_confirm),&lt;sps&gt;,&lt;sps&gt;
)</prop> 
 
 
  <ti>(prop,kick_confirm)</ti> 


      <when test="(prop,ip_dokickconfirm)">  
        <tk label="Replaced Selects: (prop,total) Select(f,plural,(prop,total),s)">
        <tk type="msg" label="Selection Update to confirm">(prop,total_selects)
(prop,kick_confirm)</tk>      
        </tk>     
      </when>
    <remove id="kick_confirm" type="prop" />
<ti_hr/>
  <!--
  <tk type="msg">replacing selects
(f,file_content,(file,new-ims-file))</tk>     -->
     
</job>

<job id="bulk-tk" role="hidden">
<need default="">(prop,bulks_tk_control)</need>
<choose>
  <when test="(f,and,(f,has_flag,(prop,bulks_tk_control),print_only),(f,not,(f,has_flag,(prop,bulks_tk_control),print_all_fields)))">
    <call_job job="bulk-tk-alternat"/>
  </when>
  <otherwise>
    <call_job job="bulk-tk-plain"/>
  </otherwise>
</choose>

</job>

<job role="hidden" id="bulk-tk-alternat">
<call_job job="tr_bulk"/>
<need default="">(prop,bulks_tk_control)</need>
<call_job job="bulk_event_tk_core"/>
<when test="(f,has_flag,(prop,bulks_tk_control),print_only)">
<choose>
<when test="(f,has_flag,(prop,bulks_tk_control),print_all_fields)">
<ti label="(prop,bulk_default_label_class): (prop,bulk_default_label_name)"/>
</when>
<otherwise>
<ti label=" " x="(f,html,b,o)(prop,bulk_default_label_class)(f,html,b,c)"/>
</otherwise>
</choose>
</when>
<tk label="(f,when,(f,has_flag,(prop,bulks_tk_control),print_only),,(prop,bulk_default_label_class)(f,when,(f,has,prop,bulk_default_label_name),: (prop,bulk_default_label_name),))" tip="(prop,_bulk_tip)" tk_id="28" flag="(prop,bulks_tk_control) wrap ">
<tk label="(prop,_bulk_l_type)" id="bulk_type" x="" test_first="1" tip="(prop,_bulk_t_type)" type="sel" follow_job="bulk_follow_type" flag=" nono  dynamo ">
<sel label="(prop,_bulk_s_typ_qu_sqli)">qu_sqli</sel>
<sel label="(prop,_bulk_s_typ_qu)">qu</sel>
<sel label="(prop,_bulk_s_typ_sqli)">sqli</sel>
<sel label="Script">script</sel>
</tk>
<tk label="(prop,_bulk_l_name)" id="bulk_name" x="(f,time)" test_first="1" tip="(prop,_bulk_t_name)" type="text" cols="30" flag=" nono "/>
<tk label="(prop,_bulk_l_doku)" id="bulk_doku" x="" test_first="0" tip="(prop,_bulk_t_doku)" type="textblock" cols="30" flag=" "/>
<tk label="(prop,_bulk_l_bscript)" id="bulk_bscript" x="" test_first="0" tip="(prop,_bulk_t_bscript)&#xA;(prop,_scripthelper)" type="textblock" cols="50" flag="  big bigbig wide " />

<!--
<tk label="(prop,_bulk_l_qu)" x="(prop,_bulk_l_qu)" test_first="0" tip="(prop,_bulk_t_qu)" test_dyn="()(f,starts_with,(prop,bulk_type),qu)()" type="msg" flag=" "/>
<tk label="(prop,_bulk_l_qu_file)" id="bulk_qu_file" x="" test_first="1" tip="(prop,_bulk_t_qu_file)" test_dyn="()(f,starts_with,(prop,bulk_type),qu)()" type="sel" follow_job="bulk_follow_query" flag="  fresh_xml " xml="(file,bulksel_query_file)"/>
<tk label="(prop,_bulk_l_qu_row)" id="bulk_qu_row" x="" test_first="1" tip="(prop,_bulk_t_qu_row)" test_dyn="()(f,starts_with,(prop,bulk_type),qu)()" type="sel" flag="  fresh_xml " xml="(file,bulksel_query_id)"/>
<tk label="(prop,_bulk_l_sqli)" x="(prop,_bulk_l_sqli)" test_first="1" tip="(prop,_bulk_t_sqli)" test_dyn="()(f,ends_with,(prop,bulk_type),sqli)()" type="msg" flag=" "/>
<tk label="(prop,_bulk_l_sqli_file)" id="bulk_sqli_file" x="" test_first="1" tip="(prop,_bulk_t_sqli_file)" test_dyn="()(f,ends_with,(prop,bulk_type),sqli)()" type="sel" follow_job="bulk_follow_sqli" flag="  fresh_xml " xml="(file,bulksel_query_file)"/>
<tk label="(prop,_bulk_l_sqli_row)" id="bulk_sqli_row" x="" test_first="1" tip="(prop,_bulk_t_sqli_row)" test_dyn="()(f,ends_with,(prop,bulk_type),sqli)()" regex="\d+" type="sel" flag="  fresh_xml " xml="(file,bulksel_sqli_id)"/>
-->
<tk label="Script" x="Script" test_first="0" test_dyn="()(f,starts_with,(prop,bulk_type),script)()" type="msg" flag=" "/>
<tk label="(prop,_bulk_l_script)" id="bulk_script" x="" test_first="1" tip="(prop,_scripthelper)" test_dyn="()(f,starts_with,(prop,bulk_type),script)()" type="textblock" cols="50" flag="  big bigbig wide "/>
</tk>
</job>


<job id="bulk-see-all" role="hidden">

<call_job job="tr_bulk" />

<call_job job="tk_gpref_read" />
                                                                                  
  <prop id="book-name">(f,name_of_dir,(f,dir_of_file,(file,bulks)))</prop>
  <ti_break class_table="tabNavigator"/>  
  
  <ti type="rec" >   
    <ti flag="block wrap_word" span="8">(f,html,b,o)(prop,book-name)(f,html,b,c) (e:o)(prop,_sl_bulk2)-(prop,_sl_buch)(e:c)</ti>
                         
    <ti type="call_job" explain="(prop,_x_go_up_sys)" flag="button" align="right" class="justup" job="mm-tester-bulks"/>  
  </ti>  

  <call_job job="tk_bd_intro">
      <dir id="book-master">(dir,goMoon)bulks/</dir>
      <prop id="book-type">bulks</prop>
      <prop id="book-type-name">(prop,_sl_bulk2)</prop>
      <!-- book name schon oben festgelegt -->
      <prop id="book-home-job">_bulk</prop>  
  </call_job>
  
  <!-- <ti_hr_break class_table="tabNavigator"/>    -->
  <create_file out="(dir,ghome)last-books/bulks_last.txt">(prop,book-name)</create_file> 
   <!-- 
   <ti type="rec" test="(prop,bpDev)" >

    <ti flag="button" align="right" type="call_job" explain_nix="bulk-add" 
        class="fb fbAdd" explain="+ (prop,_sl_bulk)" job="bulk-add">
      <file id="bulks">(file,bulks)</file>
      <prop id="bulks_offset_label"></prop>

    </ti>   
  </ti>                                -->

  <when test="(f,eq_text,zeppelin,(prop,book-name))">
    <ti type="rec">
    <ti  type="call_job" flag="button block"   class="fx fxEdit"  align="right"          
        job="sqli-build-zeppelin" explain="zeppelin: (f,when,(f,eq_text,(prop,ling),de),Generiere iFace-Typen,Generate iFace-Types)">
        <prop id="return-job-to-do">_bulk</prop>
    </ti>    
    </ti>   
  
</when>   

