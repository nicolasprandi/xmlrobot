<job id="bulk-create-all" role="hidden">
  <!-- <ti type="dir" label="dir xdbQb">(dir,goMoon)</ti>   -->
  <call_job job="bulk-create-book"/>

  <loop id="dlist" xml="(file,mm-scanner)" xpath="dir">
   
    <!--<ti label="(loop,dlist,#i).">(loop,dlist,@rpath)</ti>
    <ti>(loop,dlist,#i) going into bulk-create-query (loop,dlist,@rpath)</ti>     -->
    <call_job job="bulk-create-query">
      <prop id="query-book">(loop,dlist,@rpath)</prop>
    </call_job>
    
    <call_job job="bulk-create-sqli">
      <prop id="sqli-book">(loop,dlist,@rpath)</prop>
    </call_job>    
      
  </loop>    
  <ti label="Done with Ui-Refresh" />
  <ti label="Selectors in" type="dir">(dir,goMoon)queries/</ti>
  
  <when test="(f,has,prop,refresh-back-job)">
    <ti_hr_break/>
    <call_job job="(prop,refresh-back-job)"/>
  
  </when>   
          
</job>

<job id="bulk-create-sqli" role="hidden">
  <need>(prop,sqli-book)</need>
  
  <call_job job="bulk-get-sqli"/>
  
  <when test="(f,exists_file,(dir,goMoon)queries/(prop,sqli-book)/queries-list.xml)">
    <xslt 
      xml="(dir,goMoon)queries/(prop,sqli-book)/queries-list.xml" 
      xsl="(dir,app)bulk-sqli-sel-id.xsl" 
      out="(file,sqli-book)"
      home="(dir,app)">
      <params>offline='(f,not,(f,implement,online))' sql_len='110' script_len='120' doku='(prop,_x_doku)' dokuw1='100' dokuw2='30'
      each='(f,when,(f,eq_text,(prop,ling),de),je Datensatz,each Record)' 
      head='(f,when,(f,eq_text,(prop,ling),de),Kopf,Head)' 
      first='(f,when,(f,eq_text,(prop,ling),de),erster Datensatz,first Record)'</params>
    </xslt>
    <!--               -->
    <ti type="file" label="created sqli-sel" xtest="(f,role,test)">(file,sqli-book)</ti>           
  </when>
      
</job>

<job id="bulk-get-sqli" role="hidden">
  <need>(prop,sqli-book)</need>
  <file id="sqli-book">(dir,goMoon)queries/(prop,sqli-book)/sqli-sel.xml</file>
  <need>(file,sqli-book)</need>
</job>

<job id="bulk-create-query" role="hidden">                   
  <need>(prop,query-book)</need>
  
  <call_job job="bulk-get-query"/>
  
  <when test="(f,exists_file,(dir,goMoon)queries/(prop,query-book)/queries-list.xml)">
   
    <xslt 
      xml="(dir,goMoon)queries/(prop,query-book)/queries-list.xml" 
      xsl="(dir,app)bulk-query-sel-id.xsl" 
      out="(file,query-book)"
      home="(dir,app)">
      <params>offline='(f,not,(f,implement,online))' sql_len='110' script_len='80' doku='(prop,_x_doku)' dokuw1='100' dokuw2='30'</params>
    </xslt>
    <ti type="file" label="created query-sel"  xtest="(f,role,test)">(file,query-book)</ti>
    
    <xslt 
      xml="(dir,goMoon)queries/(prop,query-book)/queries-list.xml" 
      xsl="(dir,app)bulk-query-sel-id.xsl" 
      out="(file,query-book)-3"
      home="(dir,app)">
      <params>offline='(f,not,(f,implement,online))' sql_len='330' script_len='80' doku='(prop,_x_doku)' dokuw1='100' dokuw2='30'</params>
    </xslt>      
    <ti type="file" label="created query-sel-3"  xtest="(f,role,test)">(file,query-book)-3</ti>
    <!--                   -->
                
   
  </when>
      
</job>

<job id="bulk-get-query" role="hidden">
  <need>(prop,query-book)</need>
  <file id="query-book">(dir,goMoon)queries/(prop,query-book)/query-sel.xml</file>
  <need>(file,query-book)</need>
</job>

<job id="bulk-create-book" role="hidden">
 <!-- create book start <interpreter watch="1"/>-->
  
  
  <file id="mm-scanner" x="(dir,filetemp)mm-scanner.xml"/>
  <scan out="(file,mm-scanner)" 
        dir="(dir,goMoon)queries/"
        level_limit="2"
        field="fn pre" />  
     
  <xslt 
    xml="(file,mm-scanner)" 
    xsl="(dir,app)bulk-query-sel.xsl" 
    out="(file,bulksel_query_file)">
  </xslt>          
 
  <!--   -->  
  <ti label="Books" type="file" x="(file,bulksel_query_file)" xtest="(f,role,test)"/>  
  
    
</job>

<job id="prepare_bulk_display" role="hidden">    
<!-- <ti>... im prepare_bulk_display</ti>  -->

<when test="(f,has,prop,bulk_qu_file)">
  <call_job job="bulk-get-query">
    <prop id="query-book">(prop,bulk_qu_file)</prop>
  </call_job>
  
  <choose>
    <when test="(f,exists_file,(file,query-book))">
      <copy file="(file,query-book)-3" tofile="(file,bulksel_query_id)"/>
    </when>
    <otherwise>  
      <ti>ATTENTION: Requested Query-Book '(prop,bulk_qu_file)' does not exist</ti>
      <copy 
          file="(dir,app)dummy-sel.xml" 
          tofile="(file,bulksel_query_id)"/>
    </otherwise>
  </choose>
  
  
</when>

<when test="(f,has,prop,bulk_sqli_file)">
  <call_job job="bulk-get-sqli">
    <prop id="sqli-book">(prop,bulk_sqli_file)</prop>
  </call_job>
  
  <choose>
    <when test="(f,exists_file,(file,sqli-book))">
      <copy file="(file,sqli-book)" tofile="(file,bulksel_sqli_id)"/>
    </when>
    <otherwise>  
      <ti>ATTENTION: Requested sqli-Book '(prop,bulk_sqli_file)' does not exist</ti>
      <copy 
          file="(dir,app)dummy-sel.xml" 
          tofile="(file,bulksel_sqli_id)"/>
    </otherwise>
  </choose>  
  
  
</when>  




</job>

<job id="bulk_event_tk_core" role="hidden">

</job> 

<job id="cd" role="hidden">
  <need>(prop,cd-in)</need>
  <prop id="cd-out" x="" />
  
  <when test="(f,gt_num,(f,len,(prop,cd-in)),0)">
    <prop id="cd-out">(prop,_x_doku): </prop>
    
    <choose>                               ,
      <when test="(f,contains,(f,substring,(prop,cd-in),0,100),.)">
        <!-- es gibt einen punkt in dokuw1-->    
        <prop id="cd-out">(prop,cd-out)(f,substring_before,(prop,cd-in),.)</prop>
      </when>    
      <when test="(f,gt_num,(f,len,(prop,cd-in)),30)">
        <prop id="cd-out">(prop,cd-out)(f,substring,(prop,cd-in),0,30) ...</prop>
      </when>
      <otherwise>
        <prop id="cd-out">(prop,cd-out)(prop,cd-in)</prop>
      </otherwise>
    </choose>
    
  </when>
    

</job>

</jobs>