<job id="do_link_bulk" role="hidden">
  <ti_break class_table="tabNavigator"/>
  <ti type="rec" label=" ">
  <ti type="call_job" job="bulk-see" align="right" explain="(prop,_x_go_back_sys)" label=" " flag="button" class="justback">
     <file id="bulks">(file,bulks)</file>
     <prop id="bulk_key">(prop,bulk_key)</prop>
  </ti>
  </ti>
     

</job> 

<job id="do_link_bulks" role="hidden">
  <ti_break class_table="tabNavigator"/>
  <ti type="rec" label=" ">
  <ti type="call_job" job="bulk-see-all" align="right" explain="(prop,_x_go_back_sys)" label=" " flag="button" class="justback">
     <file id="bulks">(file,bulks)</file>
  </ti>
   </ti>
    

</job> 

<job id="bulk-see-all-details" role="hidden">
  

<need default="">(prop,bulks_sort_attribute)</need>
<need default="">(prop,bulks_sort_number)</need>
<need default="">(prop,bulks_sort_ignore_case)</need>
<need default="">(prop,bulks_sort_desc)</need>
<need default="">(prop,bulks_where)</need>
<need default="">(prop,bulks_offset_label)</need>
<need default="./">(prop,bulks_offset)</need>
<need default="">(prop,bulks_return_job)</need>
<need default="//">(prop,bulks_offset_new_key)</need>
<need default="0">(prop,bulks_no_header)</need>
<call_job job="tr_bulk"/>


<prop id="nothing">1</prop>
<loop missing_strategy="empty" id="bulk_loop" xml="(file,bulks)"
       xpath="(prop,bulks_offset)bulk(prop,bulks_where)" sort="(prop,bulks_sort_attribute)" number="(prop,bulks_sort_number)" ignore_case="(prop,bulks_sort_ignore_case)" desc="(prop,bulks_sort_desc)">
                                                                              
 <call_job job="prepare_bulk_display">
  <prop id="bulk_qu_file">(f,when,(f,has,(loop,bulk_loop,@qu_file)),(loop,bulk_loop,@qu_file),)</prop>
  <prop id="bulk_sqli_file">(f,when,(f,has,(loop,bulk_loop,@sqli_file)),(loop,bulk_loop,@sqli_file),)</prop> 
 </call_job>

  
 <when test="(f,gt_num,(loop,bulk_loop,#i),1)">
    <ti_hr xstyle="2"/>
  </when>  


<when test="(prop,nothing)">
  <when test="(f,gt,(f,len,(prop,bulks_offset_label)),0)">
    <ti label="(prop,bulks_offset_label)"/>
    <ti x=" "/>
  </when>
      
  <prop id="nothing">0</prop>
</when>

<!-- daten vorbereiten -->
<prop id="bulk-query-has">0</prop>
<prop id="bulk-query-failed">0</prop>
<prop id="bulk-query-text"></prop>


<when test="(f,has,(loop,bulk_loop,@qu_row))">
  <prop id="bulk-query-text">(prop,bulk-query-text)(f,tk_sel_translate,(loop,bulk_loop,@qu_row),(file,bulksel_query_id))
</prop>
    <prop id="bulk-query-text" test="(f,not,(f,has,prop,bulk-query-text))">#(loop,bulk_loop,@qu_row)
</prop>
  <prop id="bulk-query-has">1</prop>
</when>

<when test="(f,has,(loop,bulk_loop,@qu_file))">
  <choose>
    <when test="(prop,bulk-query-has)">
      <try_catch><try>
        <prop id="second-apos">(f,index_of,(prop,bulk-query-text),&apos;,1)</prop>
        <prop id="bulk-query-text">(f,html,b,o)(f,substring,(prop,bulk-query-text),1,(prop,second-apos))(f,html,b,c) (f,substring,(prop,bulk-query-text),(f,add,1,(prop,second-apos))) &lt;&lt;(loop,bulk_loop,@qu_file)&gt;&gt;</prop>
      </try><catch>
        <prop id="bulk-query-text">(f,html,b,o)(f,when,(f,has,(loop,bulk_loop,@qu_row)),#(loop,bulk_loop,@qu_row),?)(f,html,b,c) &lt;&lt;(loop,bulk_loop,@qu_file)&gt;&gt;</prop>            
      </catch></try_catch>
    </when>
    <otherwise>
        <prop id="bulk-query-text">(f,html,b,o)(f,when,(f,has,(loop,bulk_loop,@qu_row)),#(loop,bulk_loop,@qu_row),?)(f,html,b,c) &lt;&lt;(loop,bulk_loop,@qu_file)&gt;&gt;</prop>            
        <prop id="bulk-query-failed">1</prop>
    </otherwise>
  </choose>
</when>

<prop id="bulk-sqli-has">0</prop>
<prop id="bulk-sqli-failed">0</prop>
<prop id="bulk-sqli-text"></prop>

<when test="(f,has,(loop,bulk_loop,@sqli_row))">

    <prop id="bulk-sqli-text">(f,tk_sel_translate,(loop,bulk_loop,@sqli_row),(file,bulksel_sqli_id))
</prop>
    <prop id="bulk-sqli-text" test="(f,not,(f,has,prop,bulk-sqli-text))">#(loop,bulk_loop,@sqli_row)
</prop>
    <prop id="bulk-sqli-has">1</prop>
</when>      

<when test="(f,has,(loop,bulk_loop,@sqli_file))">
  <choose>
    <when test="(prop,bulk-sqli-has)">
      <try_catch><try>
        <prop id="second-apos">(f,index_of,(prop,bulk-sqli-text),&apos;,1)</prop>
        <prop id="bulk-sqli-text">(f,html,b,o)(f,substring,(prop,bulk-sqli-text),1,(prop,second-apos))(f,html,b,c) (f,substring,(prop,bulk-sqli-text),(f,add,1,(prop,second-apos))) &lt;&lt;(loop,bulk_loop,@sqli_file)&gt;&gt;</prop>      
      </try><catch>
        <prop id="bulk-sqli-text">(f,html,b,o)(f,when,(f,has,(loop,bulk_loop,@sqli_row)),#(loop,bulk_loop,@sqli_row),?)(f,html,b,c) &lt;&lt;(loop,bulk_loop,@sqli_file)&gt;&gt;</prop>            
      </catch></try_catch>
    </when>
    <otherwise>
        <prop id="bulk-sqli-text">(f,html,b,o)(f,when,(f,has,(loop,bulk_loop,@sqli_row)),#(loop,bulk_loop,@sqli_row),?)(f,html,b,c) &lt;&lt;(loop,bulk_loop,@sqli_file)&gt;&gt;</prop>                
        <prop id="bulk-sqli-failed">1</prop>
    </otherwise>
  </choose>
  

  <!-- <prop id="bulk-sqli-text">(prop,bulk-sqli-text)&lt;&lt;(loop,bulk_loop,@sqli_file)&gt;&gt;
</prop>                                                       -->
  
</when>


<!-- das neue -->
<!-- link mit namen -->
<prop id="theAlign"></prop>
<prop id="thePref"></prop>
<when test="(f,eq_text,script,(loop,bulk_loop,@type))">
<prop id="theAlign">center</prop>
<prop id="thePref">script: </prop>
</when>
<prop id="theAlign">center</prop>



<ti type="rec"  >
                                   
  <ti flag="block" class="justmaiXnBulk" type="call_job" spxan="9" 
    explain="(f,html,b,o)(loop,bulk_loop,@name)(f,html,b,c)" 
    xalign="(prop,theAlign)"
    job="bulk-see"       >
    
    <prop id="bulk_key">(loop,bulk_loop,@row)</prop>
    <file id="bulks">(file,bulks)</file>
    <prop id="bulks_offset">(prop,bulks_offset)</prop>
    <prop id="bulks_offset_label">(prop,bulks_offset_label)</prop>
    <prop id="bulks_offset_new_key">(prop,bulks_offset_new_key)</prop>
    <prop id="bulks_sort_attribute">(prop,bulks_sort_attribute)</prop>
    <prop id="bulks_sort_number">(prop,bulks_sort_number)</prop>
    <prop id="bulks_sort_ignore_case">(prop,bulks_sort_ignore_case)</prop>
    <prop id="bulks_sort_desc">(prop,bulks_sort_desc)</prop>
    <prop id="bulks_where">(prop,bulks_where)</prop>
    <prop id="bulks_return_job">(prop,bulks_return_job)</prop>
  </ti>   
  
  <!-- <ti align="right">(f,html,i,o)(loop,bulk_loop,@type)(f,html,i,c)</ti>  
    
    xprefix="(prop,thePref)"
    xpostfix_class="bulkHeaderType"
    postfix=" (f,when,(f,has_flag,(loop,bulk_loop,@type),qu_sqli),(prop,_bulk_s_typ_qu_sqli),)(f,when,(f,has_flag,(loop,bulk_loop,@type),qu),(prop,_bulk_s_typ_qu),)(f,when,(f,has_flag,(loop,bulk_loop,@type),sqli),(prop,_bulk_s_typ_sqli),)(f,when,(f,has_flag,(loop,bulk_loop,@type),script),Script,)"
  
  
    -->

</ti>

<ti type="rec">
   <ti flag="block">(e:o)(loop,bulk_loop,#i). (f,when,(f,has_flag,(loop,bulk_loop,@type),qu_sqli),(prop,_bulk_s_typ_qu_sqli),)(f,when,(f,has_flag,(loop,bulk_loop,@type),qu),(prop,_bulk_s_typ_qu),)(f,when,(f,has_flag,(loop,bulk_loop,@type),sqli),(prop,_bulk_s_typ_sqli),)(f,when,(f,has_flag,(loop,bulk_loop,@type),script),Script,)(e:c)</ti>
</ti>


 <ti_space height="2px" />
 
 <!-- <ti>hieristwer</ti>  -->
 <when test="(f,has,(loop,bulk_loop,@doku))">
  <call_job job="cd">
    <prop id="cd-in">(loop,bulk_loop,@doku)</prop>
  </call_job>
  <ti type="rec" >
    <ti  x="(prop,cd-out)" flag="wrap_word block"  />
  </ti>  
 </when>

<ti type="rec">
<ti type="menu" span="10" flag="block">
 
  <ti  type="call_job" explain="(prop,_bulk_act_run)" job="bulk-hook-run" flag="button  xblock" class="fb fbGoBulk"  >
    <prop id="bulk_key">(loop,bulk_loop,@row)</prop>
    <file id="bulks">(file,bulks)</file>
    <prop id="bulks_offset">(prop,bulks_offset)</prop>
    <prop id="bulks_offset_label">(prop,bulks_offset_label)</prop>
    <prop id="bulks_offset_new_key">(prop,bulks_offset_new_key)</prop>
    <prop id="bulks_sort_attribute">(prop,bulks_sort_attribute)</prop>
    <prop id="bulks_sort_number">(prop,bulks_sort_number)</prop>
    <prop id="bulks_sort_ignore_case">(prop,bulks_sort_ignore_case)</prop>
    <prop id="bulks_sort_desc">(prop,bulks_sort_desc)</prop>
    <prop id="bulks_where">(prop,bulks_where)</prop>
    <prop id="bulks_return_job">(prop,bulks_return_job)</prop>
    <prop id="qra-from">bl</prop>
  </ti>    

  <ti  type="call_job" explain="(prop,_bulk_act_editnrun)" job="bulk-hook-edit-run" flag="button" class="fb fbBulk"  test="(prop,bpDev)"  >
    <prop id="bulk_key">(loop,bulk_loop,@row)</prop>
    <file id="bulks">(file,bulks)</file>
    <prop id="bulks_offset">(prop,bulks_offset)</prop>
    <prop id="bulks_offset_label">(prop,bulks_offset_label)</prop>
    <prop id="bulks_offset_new_key">(prop,bulks_offset_new_key)</prop>
    <prop id="bulks_sort_attribute">(prop,bulks_sort_attribute)</prop>
    <prop id="bulks_sort_number">(prop,bulks_sort_number)</prop>
    <prop id="bulks_sort_ignore_case">(prop,bulks_sort_ignore_case)</prop>
    <prop id="bulks_sort_desc">(prop,bulks_sort_desc)</prop>
    <prop id="bulks_where">(prop,bulks_where)</prop>
    <prop id="bulks_return_job">(prop,bulks_return_job)</prop>
    <prop id="qra-from">bl</prop>
  </ti> 
  <ti  type="call_job" explain="(prop,_x_edit)"  job="bulk-edit-by-view" flag="button "  test="(prop,bpDev)" class="fb fbEdit fbEditDetail fbEditDetailBulk "  >
    <prop id="bulk_key">(loop,bulk_loop,@row)</prop>
    <file id="bulks">(file,bulks)</file>
    <prop id="bulks_offset">(prop,bulks_offset)</prop>
    <prop id="bulks_offset_label">(prop,bulks_offset_label)</prop>
    <prop id="bulks_offset_new_key">(prop,bulks_offset_new_key)</prop>
    <prop id="bulks_sort_attribute">(prop,bulks_sort_attribute)</prop>
    <prop id="bulks_sort_number">(prop,bulks_sort_number)</prop>
    <prop id="bulks_sort_ignore_case">(prop,bulks_sort_ignore_case)</prop>
    <prop id="bulks_sort_desc">(prop,bulks_sort_desc)</prop>
    <prop id="bulks_where">(prop,bulks_where)</prop>
    <prop id="bulks_return_job">(prop,bulks_return_job)</prop>
  </ti>      
</ti>   
</ti>


 
<ti_space height="7px" />



<try_catch>
  <try>
  
  <choose>
    <when test="(prop,bulk-sqli-has)">
        <prop 
        id="upper_squery_row"
        >(f,xpath,(dir,goMoon)queries/(loop,bulk_loop,@sqli_file)/queries-list.xml,//sqli[@row=(loop,bulk_loop,@sqli_row)]/..,@row)</prop>
    </when>
    <otherwise>
      <prop id="upper_squery_row"></prop>
    </otherwise>
  </choose>
  

  </try>
  <catch>
    <prop id="upper_squery_row"></prop>
  </catch>
</try_catch>

                                                       
<choose>
  <when test="(f,eq_text,script,(loop,bulk_loop,@type))">  
  <ti flag="catch">(f,text,cut_nice,(loop,bulk_loop,@script),230)</ti>
  </when>
  <otherwise>

<ti type="rec" >
  <ti type="call_job"
      test="(prop,bulk-query-has)"
      span="2" 
      job="squery-see" 
      explain="(prop,_bulk_l_go_query)"
      class="fx fxEditSquery "
      flag="block button">
    <file id="squerys">(dir,goMoon)queries/(loop,bulk_loop,@qu_file)/queries-list.xml</file>
    <prop id="squery_key">(loop,bulk_loop,@qu_row)</prop>
    <prop id="squerys_offset">./</prop>
    <file id="bulks">(file,bulks)</file>
    <prop id="bulk_key">(loop,bulk_loop,@row)</prop>
    <prop id="do_link_bulks">1</prop>

    
  </ti>    
  
  <ti span="2" 
      test="(prop,bulk-query-failed)" flag="block">(prop,_sl_squery)-Link not possible</ti>    
  <ti span="2"  test="(f,and,(f,not,(prop,bulk-query-has)),(f,not,(prop,bulk-query-failed)))" > </ti>
    
                                                                 
  <ti type="call_job" 
      span="2" 
      test="(prop,bulk-sqli-has)" 
      job="sqli-see"  
      class="fx fxJumpSqli"
      flag="button"
      explain="(prop,_bulk_l_go_sqli)">
              
    <file id="sqlis">(dir,goMoon)queries/(loop,bulk_loop,@sqli_file)/queries-list.xml</file>
    <prop id="sqli_key">(loop,bulk_loop,@sqli_row)</prop>
    <prop id="sqlis_offset">squery[@row='(prop,upper_squery_row)']/</prop>
                        
    <file id="squerys">(dir,goMoon)queries/(loop,bulk_loop,@sqli_file)/queries-list.xml</file>
    <prop id="squery_key">(prop,upper_squery_row)</prop>
    <prop id="squerys_offset">./</prop>
    
    <file id="bulks">(file,bulks)</file>
    <prop id="bulk_key">(loop,bulk_loop,@row)</prop>

    <prop id="do_link_bulks">1</prop>  
    
  </ti>    
  <ti span="2" 
      test="(prop,bulk-sqli-failed)">(prop,_sl_sqli)-Link not possible</ti>    
  <ti span="2"  test="(f,and,(f,not,(prop,bulk-sqli-has)),(f,not,(prop,bulk-sqli-failed)))" > </ti>
</ti> 



<ti type="rec" xlabel=" ">
  <ti span="2" flag="wrap block" test="(f,or,(prop,bulk-query-has),(prop,bulk-query-failed))">(prop,bulk-query-text)</ti>
  <ti span="2"  flag="wrap" test="(f,not,(f,or,(prop,bulk-query-has),(prop,bulk-query-failed)))"> </ti>
  <ti span="2"  flag="wrap" test="(prop,bulk-sqli-has)" >(prop,bulk-sqli-text) </ti>
  <ti span="2"  flag="wrap" test="(prop,bulk-sqli-failed)" >(prop,bulk-sqli-text) </ti>
</ti> 

</otherwise>
</choose>
           

  <when test="(loop,bulk_loop,exists?,@bscript)">      
  <ti flag="catch">[ (prop,_bulk_l_bscript) ]
(f,text,cut_nice,(loop,bulk_loop,@bscript),200)</ti>
  </when>
  
</loop>
<ti_break/>
<when test="(prop,nothing)">
  <ti type="rec">
    <ti flag="wrap">(prop,_bulk_nodata_l)</ti>
  </ti>
</when>     


<when test="(f,not,(f,contains,(prop,bulks_offset),node(e:o)(e:c)))">
  
  <ti_hr_break xstyle="2"/>
  <ti type="menu" flag="block" first_cell="1" last_cell="10">
    <ti flag="button obutton block"  type="call_job" explain_nix="bulk-add" class="fb fbAdd" explain="+ (prop,_sl_bulk)" job="bulk-add"  test="(prop,bpDev)" >
      <file id="bulks">(file,bulks)</file>
      <prop id="bulks_offset">(prop,bulks_offset)</prop>
      <prop id="bulks_offset_label">(prop,bulks_offset_label)</prop>
      <prop id="bulks_offset_new_key">(prop,bulks_offset_new_key)</prop>
      <prop id="bulks_sort_attribute">(prop,bulks_sort_attribute)</prop>
      <prop id="bulks_sort_number">(prop,bulks_sort_number)</prop>
      <prop id="bulks_sort_ignore_case">(prop,bulks_sort_ignore_case)</prop>
      <prop id="bulks_sort_desc">(prop,bulks_sort_desc)</prop>
      <prop id="bulks_where">(prop,bulks_where)</prop>
      <prop id="bulks_return_job">(prop,bulks_return_job)</prop>
    </ti>
    <ti flag="button" test="(f,not,(prop,nothing))" type="call_job" class="fb fbOrg" explain="(prop,_x_organize)" job="do-org-me">
      <file id="orga">(file,bulks)</file>
      <prop id="orga_where">(prop,bulks_where)</prop>
      <prop id="orga_view_loop_id">bulk_loop</prop>
      <prop id="orga_finished_job">bulk-orga-finished</prop>
      <prop id="orga_offset">(prop,bulks_offset)</prop>
      <prop id="orga_offset_label">(prop,bulks_offset_label)</prop>
      <prop id="orga_offset_new_key">(prop,bulks_offset_new_key)</prop>
      <prop id="orga_segment_plural">bulks</prop>
      <prop id="orga_segment_singular">bulk</prop>
      <prop id="orga_segment_plural_label">(prop,_pl_bulk)</prop>
      <prop id="orga_segment_singular_label">(prop,_sl_bulk)</prop>
      <prop id="orga_sort_attribute">(prop,bulks_sort_attribute)</prop>
      <prop id="orga_sort_number">(prop,bulks_sort_number)</prop>
      <prop id="orga_where">(prop,bulks_where)</prop>
      <prop id="orga_name_expression_loop">()(loop,bulk_loop,@name)()</prop>
      <prop id="orga_desc_expression_loop">()()</prop>
    </ti>     
  </ti>
</when>



<call_job job="bulk_event_view_end"/>

</job>

<!-- bulk events 

<job id="bulk_follow_type_test" xrole="hidden">
  <interpreter watch="1" />
    <prop id="bulk_type">qu</prop>
    <call_job job="bulk_follow_type" />
</job>          -->


<job id="bulk_event_post_print" role="hidden">

  <when test="(f,or,(f,starts_with,(prop,bulk_type),qu),(f,ends_with,(prop,bulk_type),sqli))">
  <!-- <ti_hr style="2" /> -->
 
  
  <when test="(f,starts_with,(prop,bulk_type),qu)">
    <choose>
      <when test="(f,and,(f,has,prop,bulk_qu_file),(f,has,prop,bulk_qu_row))">
      <!-- 
        <ti label="query mit bulk_qu_file und bulk_qu_row"/>
        <ti label="bulk_qu_file">(prop,bulk_qu_file)</ti>
        <ti label="bulk_qu_row">(prop,bulk_qu_row)</ti>
        <ti label="file bulksel_query_id">(file,bulksel_query_id)</ti>
        <ti label=""></ti>                  -->
        <ti type="call_job" 
            job="squery-see" 
            label="(f,html,b,o)(prop,_bulk_l_go_query):(f,html,b,c)" 
            flag=" button wrap_word"
            explain="(f,xpathx,?,(file,bulksel_query_id),sel[text(e:o)(e:c)=(prop,bulk_qu_row)],@label)&#xA;&lt;&lt;(prop,bulk_qu_file)&gt;&gt;"
            class="fx fxRef fxRefQuery">
          <file id="squerys">(dir,goMoon)queries/(prop,bulk_qu_file)/queries-list.xml</file>
          <prop id="squery_key">(prop,bulk_qu_row)</prop>
          <prop id="squerys_offset">./</prop>
          
          <file id="bulks">(file,bulks)</file>
          <prop id="bulk_key">(prop,bulk_key)</prop>
          <prop id="do_link_bulk">1</prop>          
        </ti>      
      
      </when>
      <when test="(f,has,prop,bulk_qu_file)">
        <ti type="call_job" job="squery-see-all" 
            label="(f,html,b,o)(prop,_bulk_l_go_query):(f,html,b,c)" 
            flag=" button wrap_word"    
            class="fx fxRef fxRefQuery"
            explain="Abfrage-Buch: (prop,bulk_qu_file)">
          <file id="squerys">(dir,goMoon)queries/(prop,bulk_qu_file)/queries-list.xml</file>
          <file id="bulks">(file,bulks)</file>
          <prop id="bulk_key">(prop,bulk_key)</prop>
          <prop id="do_link_bulk">1</prop>                
        </ti>
      </when>         
    </choose>  
  </when>

  <when test="(f,ends_with,(prop,bulk_type),sqli)">
  
    <choose>
      <when test="(f,and,(f,has,prop,bulk_sqli_file),(f,has,prop,bulk_sqli_row))">
      
        <ti_space height="3px" test="(f,starts_with,(prop,bulk_type),qu)"/>

        <prop id="upper_squery_row">(f,xpath,(dir,goMoon)queries/(prop,bulk_sqli_file)/queries-list.xml,//sqli[@row=(prop,bulk_sqli_row)]/..,@row)</prop>

        <ti type="call_job" 
            job="sqli-see" 
            label="(f,html,b,o)(prop,_bulk_l_go_sqli):(f,html,b,c)" 
            flag=" button wrap_word"  
            class="fx fxRef fxRefSqli"
            explain="(f,xpathx,?,(file,bulksel_sqli_id),sel[text(e:o)(e:c)=(prop,bulk_sqli_row)],@label)&#xA;&lt;&lt;(prop,bulk_sqli_file)&gt;&gt;">          
          <file id="sqlis">(dir,goMoon)queries/(prop,bulk_sqli_file)/queries-list.xml</file>
          <prop id="sqli_key">(prop,bulk_sqli_row)</prop>
          <prop id="sqlis_offset">squery[@row='(prop,upper_squery_row)']/</prop>
                              
          <file id="squerys">(dir,goMoon)queries/(prop,bulk_sqli_file)/queries-list.xml</file>
          <prop id="squery_key">(prop,upper_squery_row)</prop>
          <prop id="squerys_offset">./</prop>
          
          <file id="bulks">(file,bulks)</file>
          <prop id="bulk_key">(prop,bulk_key)</prop>
          
          <prop id="do_link_bulk">1</prop>
          
        </ti>      
      
      </when>
      <when test="(f,has,prop,bulk_sqli_file)">
        <ti type="call_job" job="squery-see-all" 
            label="(f,html,b,o)(prop,_bulk_l_go_sqli):(f,html,b,c)"
            flag=" button wrap_word" 
            class="fx fxRef fxRefSqli"
            explain="Interface-Buch: (prop,bulk_sqli_file)">
          <file id="squerys">(dir,goMoon)queries/(prop,bulk_sqli_file)/queries-list.xml</file>
          <file id="bulks">(file,bulks)</file>
          <prop id="bulk_key">(prop,bulk_key)</prop>
          <prop id="do_link_bulk">1</prop>             
        </ti>
      </when>         
    </choose>   
  </when>  

  <ti_hr style="2" />
  </when>  
  <!--<dump_ti label="ende bulk_event_post_print"/>
   <dump_ti label="bulk_event_post_print" /> -->
</job>

<job id="bulksel_create_query_file" role="hidden">

    <!-- erzeuge: (file,bulksel_query_file)-->
    
    <file id="qu-scanner" x="(dir,filetemp)qu-scanner.xml"/>
    <!-- <file id="qu-scanner" x="(dir,pro)qu-scanner.xml"/>  -->
    <scan out="(file,qu-scanner)" 
          dir="(dir,goMoon)queries/"
          level_limit="1"
          field="fn pre" />      
    
    <xslt 
      xml="(file,qu-scanner)" 
      xsl="(dir,app)bulk-query-sel.xsl" 
      out="(file,bulksel_query_file)">
    </xslt>    
    
</job>

<job id="bulksel_create_query_id" role="hidden">
    <need>(prop,c_query_file)</need>
    <!-- erzeuge: (file,bulksel_query_id)-->
                                                   
    
    <xslt 
      xml="(dir,goMoon)queries/(prop,c_query_file)/queries-list.xml" 
      xsl="(dir,app)bulk-query-sel-id.xsl" 
      out="(file,bulksel_query_id)"
      home="(dir,app)">
    
 <params>offline='(f,not,(f,implement,online))' sql_len='110' script_len='80' doku='(prop,_x_doku)' dokuw1='100' dokuw2='30'</params>      
    </xslt>
    
</job>

<job id="bulksel_create_sqli_id" role="hidden">
    <need>(prop,c_query_file)</need>
    <!-- erzeuge: (file,bulksel_query_id)-->
                                                    
    
    <xslt 
      xml="(dir,goMoon)queries/(prop,c_query_file)/queries-list.xml" 
      xsl="(dir,app)bulk-sqli-sel-id.xsl" 
      out="(file,bulksel_sqli_id)"
      home="(dir,app)">
      <params>offline='(f,not,(f,implement,online))' sql_len='110' script_len='120' doku='(prop,_x_doku)' dokuw1='100' dokuw2='30'
      each='(f,when,(f,eq_text,(prop,ling),de),je Datensatz,each Record)' 
      head='(f,when,(f,eq_text,(prop,ling),de),Kopf,Head)' 
      first='(f,when,(f,eq_text,(prop,ling),de),erster Datensatz,first Record)'</params>
    </xslt>
    
</job>

<!-- follower nach der eingabe eines types -->
<job id="bulk_follow_type" role="hidden">
  <!-- rausgenommen 
  <i>im bulk_follow_type: (prop,bulk_type)</i>
  
  <when test="(f,or,(f,starts_with,(prop,bulk_type),qu),(f,ends_with,(prop,bulk_type),sqli))">
    <call_job job="bulksel_create_query_file" />            
  </when>                 -->
</job>

<!-- follower nach der auswahl eines query-files fuer queries-->
  <!-- rausgenommen 
  <i>im bulk_follow_type: (prop,bulk_type)</i>
  
  <when test="(f,starts_with,(prop,bulk_type),qu)">
    <call_job job="bulksel_create_query_id">
      <prop id="c_query_file">(prop,bulk_qu_file)</prop>
    </call_job>            
  </when>
  
<job id="bulk-get-query" role="hidden">
  <need>(prop,query-book)</need>
  <file id="query-book">(dir,goMoon)queries/(prop,query-book)/query-sel.xml</file>
  <need>(file,query-book)</need>
</job>  
  -->
<job id="bulk_follow_query" role="hidden">
  <when test="(f,starts_with,(prop,bulk_type),qu)">
  <call_job job="bulk-get-query">
    <prop id="query-book">(prop,bulk_qu_file)</prop>
  </call_job>
  
    <copy file="(file,query-book)" tofile="(file,bulksel_query_id)"/>
            
  </when>
  
</job>


<!-- follower nach der auswahl eines query-files fuer sqlis-->
<job id="bulk_follow_sqli" role="hidden">

          
  <when test="(f,ends_with,(prop,bulk_type),sqli)">
  <call_job job="bulk-get-sqli">
    <prop id="sqli-book">(prop,bulk_sqli_file)</prop>
  </call_job>
  
    <copy file="(file,sqli-book)" tofile="(file,bulksel_sqli_id)"/>

  </when>  
  <!-- 
  <i>im bulk_follow_type: (prop,bulk_type)</i>
  
  <when test="(f,ends_with,(prop,bulk_type),sqli)">
    <call_job job="bulksel_create_sqli_id">
      <prop id="c_query_file">(prop,bulk_sqli_file)</prop>
    </call_job>            
  </when>
  -->
</job>



<job id="bulk-orga-finished" role="hidden">
  <!-- 
  <ti label="orga_offset">(prop,orga_offset)</ti>
  <interpreter watch="1"/>
  <interpreter watch="0"/>
  -->

  <file id="bulks">(file,orga)</file>  
  
  <call_job job="bulk-see-all"/> 
   

</job>

<job id="bulk-edit-by-view" role="hidden">  
                                     
  <call_job job="bulk-edit" />
 
  <ti_hr_break class_table="tabNavigator"/>
  <ti type="rec"><ti>|</ti><ti align="right">|</ti></ti>
  <ti type="rec"><ti>|</ti><ti align="right">|</ti></ti> 
  <ti type="rec"><ti>|</ti><ti span="10" align="center">(f,html,i,o)Zurück zum Stapel-Buch(f,html,i,c)</ti><ti align="right">|</ti></ti>
  <ti type="rec"><ti>|</ti><ti span="10" align="center">(f,html,i,o)Back to the book of bulks(f,html,i,c)</ti><ti align="right">|</ti></ti>
  <ti type="rec"><ti>|</ti><ti align="right">|</ti></ti> 
  <ti type="rec"><ti>|</ti><ti align="right">|</ti></ti>   
  <ti_hr_break/>  
  
  <call_job 
        job="_bulk" />   
    

</job>

<job id="bulk_event_post_update" role="hidden">                                         
  <call_job job="bulk-see" test="(f,not,(f,exists,prop,dont-see-bulk-see-after-edit))"/>

</job>

<job id="bulk_event_post_insert" role="hidden">
  <prop id="bulkFromInsert">1</prop>
  <call_job job="bulk-see" />

</job>







<job id="bulk_event_details_begin2" role="hidden">

 <call_job job="prepare_bulk_display">
  <prop id="bulk_qu_file">(f,when,(f,has,(prop,bulk_qu_file)),(prop,bulk_qu_file),)</prop>
  <prop id="bulk_sqli_file">(f,when,(f,has,(prop,bulk_sqli_file)),(prop,bulk_sqli_file),)</prop> 
 </call_job>  
 
 <!-- 
 
 <call_job job="prepare_bulk_display">
  <prop id="bulk_qu_file">(f,when,(f,has,(loop,bulk_loop,@qu_file)),(loop,bulk_loop,@qu_file),)</prop>
  <prop id="bulk_sqli_file">(f,when,(f,has,(loop,bulk_loop,@sqli_file)),(loop,bulk_loop,@sqli_file),)</prop> 
 </call_job>
  

              -->
   <ti type="rec">
    <ti>(prop,_sl_bulk)</ti>
    <ti >(f,html,b,o)(prop,bulk_name)(f,html,b,c)</ti>
   </ti>             
   <ti type="rec" label="in (prop,_sl_buch):" >
    <ti >(f,name_of_dir,(f,dir_of_file,(file,bulks)))</ti>
   </ti>  
   
   <ti_hr style="2"/>
    
</job>
                       
<job id="bulk_event_details_end" role="hidden">
 
  <call_job job="bulk_event_post_print" />
  
  


