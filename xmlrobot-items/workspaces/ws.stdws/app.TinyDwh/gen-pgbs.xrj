<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_pgb) [ (f,tk_sel_translate,(prop,pgb_beztyp),(file,pdi-sel-bez)) (prop,pgbs_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,pgbs)" where="(prop,pgbs_offset)pgb[@row='(prop,pgb_key)']" />
<tp>Deleted (f,tk_sel_translate,(prop,pgb_beztyp),(file,pdi-sel-bez)) #(prop,pgb_key)</tp>
<ti label="- (prop,_sl_pgb):" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,pgb_beztyp),(file,pdi-sel-bez))(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="pgb-done-some" />
</job><job role="hidden" id="pgb-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="pgb_default_label_class" x="+ (prop,_sl_pgb)" />
<prop id="pgb_default_label_name" x="(f,when,(f,has,(prop,pgbs_offset_label)), - (prop,pgbs_offset_label),)" />
<prop id="pgbs_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,pgb_key)</need>
<prop id="pgb_default_label_class" x="(prop,_sl_pgb)" />
<prop id="pgb_default_label_name" x="(f,tk_sel_translate,(prop,pgb_beztyp),(file,pdi-sel-bez))(f,when,(f,has,(prop,pgbs_offset_label)), - (prop,pgbs_offset_label),)" />
<prop id="pgbs_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="pgb-tk" />
</job><job id="pgb-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="pgb-editor" />
<prop id="pgb_key">1</prop>
<when test="(f,not,(f,exists,prop,pgbs_offset_new_key))">
<prop id="pgbs_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,pgbs)" sort="@row" number="@row" xpath="(prop,pgbs_offset_new_key)pgb">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="pgb_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_pgb): #(prop,pgb_key)</i>
<call_job job="pgb-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_pgb) '(f,tk_sel_translate,(prop,pgb_beztyp),(file,pdi-sel-bez))'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_pgb)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_pgb)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="pgb-done-some" />
</otherwise>
</choose>
</job><job role="hidden" id="pgb-write">
<need>(prop,pgb_key) (prop,isAdd)</need>
<need default="./">(prop,pgbs_offset)</need>
<spirit act="open" id="pgbs_spirit_tc" xml="(file,pgbs)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,pgbs_offset),/)">
<prop id="offset2" x="(f,substring,(prop,pgbs_offset),0,(f,sub,(f,len,(prop,pgbs_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,pgbs_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="pgbs_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;pgb row="(prop,pgb_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="pgbs_spirit_tc" where="(prop,pgbs_offset)pgb[@row='(prop,pgb_key)']" attribute="beztyp" value="(f,vob,prop,pgb_beztyp)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="pgbs_spirit_tc" where="(prop,pgbs_offset)pgb[@row='(prop,pgb_key)']" attribute="detail" value="(f,vob,prop,pgb_detail)" />
<spirit act="close" flag="save pretty" id="pgbs_spirit_tc" />
</job></jobs>
