  <ti type="rec" label=" ">
    
    <ti type="call_job" job="squery-see" explain="(prop,_sqli_goto_query) ..." flag="button" class="fx fxAction justblack" >
      
      <file id="squerys">(file,sqlis)</file>
      <prop id="squerys_offset">./</prop>  
      <prop id="squery_key">(prop,squery_key)</prop>
    </ti>
  </ti>  
  -->

</job>

<job id="sqli_event_view_end" role="hidden">


</job>



</jobs>
