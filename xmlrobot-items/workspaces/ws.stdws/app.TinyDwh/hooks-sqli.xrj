  <ti type="menu" flag="block">

  
    
     
    

    <ti type="call_job" flag="button" class="fb fbEdit" explain="(prop,_x_edit)" job="stew-edit" test="(prop,bpDev)">
      <file id="stews">(file,stews)</file>
      <prop id="stews_offset">(prop,stews_offset)</prop>
      <prop id="stew_key">(prop,stew_key)</prop>
      <prop id="stews_offset_label"></prop>
      
      <file id="squerys">(file,stews)</file>
      <prop id="squery_key">(prop,squery_key)</prop>    
      <prop id="sqli_key">(prop,sqli_key)</prop>
      
