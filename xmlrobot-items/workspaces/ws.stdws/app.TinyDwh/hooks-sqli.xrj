<job id="sqli_event_details_top" role="hidden">

 <ti type="rec">
  <ti>(prop,_sl_sqli)</ti>
  <ti >(f,html,b,o)(prop,sqli_name)(f,html,b,o)</ti>
 </ti>   

<ti label="in (prop,_sl_squery):" >(f,xpath,(file,sqlis),squery[@row=(f,xpath_string,(prop,squery_key))],@id)</ti>

   <ti type="rec" label="in (prop,_sl_buch): ">
    <ti >(f,name_of_dir,(f,dir_of_file,(file,sqlis)))</ti>
   </ti>  

<ti_hr style="2" />

</job>                       

<job id="sqli_event_details_begin" role="hidden">

 

   <!-- 
   <ti type="rec" label="in (prop,_sl_squery)" flag="label_right">

    <ti >(e:o)(f,xpath,(file,sqlis),squery[@row=(prop,squery_key)],@id)(f,html,b,c)(e:c)</ti>
   </ti>   -->   
    
  
</job>

<job id="sqli-build-zeppelin" role="hidden">
  <file id="zeppelin">(dir,goMoon)bulks/zeppelin/bulks-list.xml</file>
  <delete dir="(dir,goMoon)sqli-types/" test="(f,exists_dir,(dir,goMoon)sqli-types/)"/>
  <mkdir dir="(dir,goMoon)sqli-types/"/>
  <choose>
    <when test="(f,exists_file,(file,zeppelin))">
    
      <xslt 
        xml="(file,zeppelin)" 
        xsl="(dir,app)sqli-type-sel.xsl" 
        out="(file,sqlisel_type)">
      </xslt> 
      <loop missing_strategy="empty" id="bulk_loop" xml="(file,zeppelin)" xpath="bulk">
      
        <create_file file="(dir,goMoon)sqli-types/(loop,bulk_loop,@row).txt" test="(loop,bulk_loop,exists?,@doku)"
          >(loop,bulk_loop,@doku)</create_file>
       
      </loop>

        
    </when>
    <otherwise>
        <copy 
          file="(dir,app)dummy-sqlisel-type.xml" 
          tofile="(file,sqlisel_type)"/>  
    </otherwise>
  </choose>
  
  <ti label="Done"/>
  <ti>(f,file_content,(file,sqlisel_type))</ti>
  <ti_hr_break/>
  <choose>
    <when test="(f,has,prop,return-job-to-do)">
      <call_job job="(prop,return-job-to-do)" />
    </when>
    <otherwise>
      <call_job job="_configurations" />
    </otherwise>
  </choose>
  

</job>





<!-- stew events -->

<job id="stew-orga-finished" role="hidden">
  <!-- 
  <ti label="orga_offset">(prop,orga_offset)</ti>
  <interpreter watch="1"/>
  <interpreter watch="0"/>
  -->

  
  <prop id="squery_key">(f,substring_after,(prop,orga_offset),squery[@row=')</prop> 
  <prop id="squery_key">(f,substring_before,(prop,squery_key),')</prop>
  <prop id="squerys_offset">./</prop>
  <file id="squerys">(file,orga)</file>  
  
  <prop id="sqli_key">(f,substring_after,(prop,orga_offset),sqli[@row=')</prop> 
  <prop id="sqli_key">(f,substring_before,(prop,sqli_key),')</prop>
  <prop id="sqlis_offset">squery[@row='(prop,squery_key)']/</prop>
  <file id="sqlis">(file,orga)</file>  
  
  <call_job job="sqli-see"/> 
   

</job>


<job id="stew_event_details_top" role="hidden">
                                               
 <ti type="rec" label="(prop,_pl_stew)" >
  <ti>(f,html,bold,open)(f,when,(f,has_flag,(prop,stew_type),top),(prop,_stew_s_1_top),)(f,when,(f,has_flag,(prop,stew_type),intro),(prop,_stew_s_1_intro),)(f,when,(f,has_flag,(prop,stew_type),main),(prop,_stew_s_1_main),)(f,when,(f,has_flag,(prop,stew_type),extro),(prop,_stew_s_1_extro),)(f,when,(f,has_flag,(prop,stew_type),fin),(prop,_stew_s_1_fin),)(f,html,bold,close)</ti>
 </ti>   
 
 <ti label="in (prop,_sl_sqli):" >(f,xpath,(file,stews),squery[@row=(f,xpath_string,(prop,squery_key))]/sqli[@row=(f,xpath_string,(prop,sqli_key))],@name)</ti>
 <ti label="in (prop,_sl_squery):" >(f,xpath,(file,stews),squery[@row=(f,xpath_string,(prop,squery_key))],@id)</ti>
 <ti type="rec" label="in (prop,_sl_buch): ">
  <ti >(f,name_of_dir,(f,dir_of_file,(file,stews)))</ti>
 </ti> 
   

 <ti_hr style="2" />
 <!-- <ti label="in Abfrage" flag="label_right">(e:o)(f,xpath,(file,sqlis),squery[@row=(f,xpath_string,(prop,squery_key))],@id)(e:c)</ti>    -->

</job>   

<job id="stew_event_post_update" role="hidden">
  <call_job job="stew-see" 
    test="(f,not,(f,exists,prop,no-post-see))"/>

</job>

<job id="stew_event_view_begin" role="hidden">
  <ti label="(prop,_pl_stew)" />

</job>

<job id="stew_event_details_end" role="hidden">
  <!-- 
  <prop id="squery_key">(f,substring_after,(prop,stew_offset),squery[@row=')</prop> 
  <prop id="squery_key">(f,substring_before,(prop,squery_key),')</prop>
  -->  
  
  <ti_hr/>
  <ti type="rec" label=" ">
  <ti type="call_job" job="sqli-see" explain="(prop,_stew_goto_sqli) ..."  flag="button" class="fx fxAction justblack" >
      <file id="sqlis">(file,stews)</file>

      <prop id="sqlis_offset">squery[@row='(prop,squery_key)']/</prop>  
      <prop id="sqli_key">(prop,sqli_key)</prop>
      
      <file id="squerys">(file,stews)</file>      
      <prop id="squery_key">(prop,squery_key)</prop>
      <prop id="squerys_offset">./</prop>  
  </ti>
  </ti>  

</job>

<job id="stew_event_view_end" role="hidden">


</job>

<!-- sqli events -->

<job id="sqli-orga-finished" role="hidden">
  
  <prop id="squery_key">(f,substring_after,(prop,orga_offset),squery[@row=')</prop> 
  <prop id="squery_key">(f,substring_before,(prop,squery_key),')</prop>
  <file id="squerys">(file,orga)</file>
  <call_job job="squery-see"/> 
   

</job>

<job id="sqli_event_post_update" role="hidden">

  <when test="(f,not,(f,exists,prop,no-post-see))">
    <choose>
      <when test="(f,exists,prop,sqli-add-back-special)">
        <call_job 
        job="_select" />
      </when>
      <otherwise>
        <call_job 
        job="sqli-see" />      
      </otherwise>
    </choose>
  
  </when>


</job>



<job id="sqli_event_view_begin" role="hidden">
  <ti label="(prop,_pl_sqli)" />

</job>

<job id="sqli_event_details_end" role="hidden">
  <!-- 
  <prop id="squery_key">(f,substring_after,(prop,sqli_offset),squery[@row=')</prop> 
  <prop id="squery_key">(f,substring_before,(prop,squery_key),')</prop>
  -->  
  
  <when test="(f,right,sqli)">
    <ti_hr/>
    <call_job job="stew-see-all">
      <file id="stews">(file,sqlis)</file>
      <prop id="stews_offset">squery[@row='(prop,squery_key)']/sqli[@row='(prop,sqli_key)']/</prop>
      <prop id="stews_offset_label"></prop>
    </call_job>
    <ti_hr/>
  </when>
  <!-- <ti_break /> -->    
