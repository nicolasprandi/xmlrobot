<?xml version="1.0" ?>

<jobs>

<call_job job="prolog"/>


<job id="sqli_jump_sqli_implementation" role="hidden"> 
  <need>(prop,ref_sqli_type)</need>
  
      <file id="zeppelin">(dir,goMoon)bulks/zeppelin/bulks-list.xml</file>
      <!-- hier mal die sqli-daten rausholen , und zwar zum (prop,ir8-type)-->
      <spirit id="zep" act="open" xml="(file,zeppelin)"/>
      
      <prop id="zep_sqli_file">(f,spirit,zep,bulk[@row=(f,xpath_string,(prop,ref_sqli_type))],@sqli_file)</prop>
      <prop id="zep_sqli_row">(f,spirit,zep,bulk[@row=(f,xpath_string,(prop,ref_sqli_type))],@sqli_row)</prop>
      
      <spirit id="zep" act="close"/>
      <file id="zep_sqli_query">(dir,goMoon)queries/(prop,zep_sqli_file)/queries-list.xml</file>
      <spirit id="zep-target" act="open" xml="(file,zep_sqli_query)"/>
      <loop id="zep" 
            spirit="zep-target"
            xpath="//sqli[@row=(f,xpath_string,(prop,zep_sqli_row))]" 
            limit="1"
            missing_strategy="empty">
         <prop id="zep_squery_row">(loop,zep,..,@row)</prop>   
      </loop>
      
      <spirit id="zep-target" act="close"/>            
                  
      
      
      <call_job job="sqli-see">
        <file id="sqlis">(dir,goMoon)queries/(prop,zep_sqli_file)/queries-list.xml</file>
        <prop id="sqli_key">(prop,zep_sqli_row)</prop>
        <prop id="squery_key">(prop,zep_squery_row)</prop>
        <prop id="squerys_offset">./</prop>
        <prop id="sqlis_offset">squery[@row='(prop,zep_squery_row)']/</prop>
        
         
      
      </call_job>
        
</job>

<job id="sqli_event_post_detail_data" role="hidden">  

  <when test="(f,not,(f,eq_text,(prop,sqli_type),private))">
  <when test="(f,exists_file,(dir,goMoon)sqli-types/(prop,sqli_type).txt)">
    <ti label="(prop,_sqli_type_docu):">(f,file_content,(dir,goMoon)sqli-types/(prop,sqli_type).txt)</ti>
  </when>  
  <ti type="call_job" label=" " job="sqli_jump_sqli_implementation" explain="(prop,_sqli_jump_impl)">
    <prop id="ref_sqli_type">(prop,sqli_type)</prop>
  </ti>
  </when>
</job>

<job id="sqli_event_loop_end" role="hidden">

      <prop id="sqli_docu_adder"></prop>
      <try_catch><try>
      <choose>
        <when test="(f,eq_text,private,(loop,sqli_loop,@type))">
          <choose>                   
            <when  test="(loop,sqli_loop,exists?,@docu)">
              <prop id="sqli_docu_adder">[Type] Private Script [Docu] (f,text,cut_nice,(f,replace,(loop,sqli_loop,@docu),&#xA;, ),300)</prop>
            </when>
            <otherwise>
              <prop id="sqli_docu_adder">[Type] Private Script</prop>
            </otherwise>
          </choose>
          
        </when>
        <otherwise>                          
          <prop id="sqli_docu_adder">[Type] (f,tk_sel_translate,(loop,sqli_loop,@type),(file,sqlisel_type))</prop>
          <when test="(loop,sqli_loop,exists?,@docu)">
            <prop id="sqli_docu_adder">(prop,sqli_docu_adder) [Docu] (f,text,cut_nice,(f,replace,(loop,sqli_loop,@docu),&#xA;, ),200)</prop>
          </when>                                   
           
          <when test="(f,exists_file,(dir,goMoon)sqli-types/(loop,sqli_loop,@type).txt)">
            <prop id="sqli_docu_adder">(prop,sqli_docu_adder) [Sqli-Type-Docu] (f,text,cut_nice,(f,replace,(f,file_content,(dir,goMoon)sqli-types/(loop,sqli_loop,@type).txt),&#xA;, ),200)</prop>
          </when>          
          
        </otherwise>
      </choose>
      </try><catch><prop id="sqli_docu_adder">??</prop><throw_again/></catch></try_catch>
      <prop id="sqli_docu_adder">(f,replace,(prop,sqli_docu_adder),&#xA;, )</prop>
       
</job>
<!-- stew edit and run -->
<job id="sqli_event_follow_type" role="hidden">

<when test="(f,has,prop,isAdd)">
<when test="(prop,isAdd)">
<when test="(f,not,(f,eq_text,private,(prop,sqli_type)))">
<when test="(f,not,(f,has,prop,sqli_name))">
  <prop id="sqli_name">(f,tk_sel_translate,(prop,sqli_type),(file,sqlisel_type))</prop>   
  <prop id="sqli_name">(f,substring_before,(prop,sqli_name), (e:o))</prop>   
</when>
</when>
</when>
</when>

</job>
<job id="hook_stew_editnrun" role="hidden">
  <prop id="no-post-see">eben</prop>
  <call_job job="stew-edit"/>
  <call_job job="hook_stew_run"/>
  
</job>                                         

<job id="hook_stew_run" role="hidden">

  
  <call_job job="tr_stew" />
  <call_job job="tr_sqli" />
  <call_job job="tr_squery" />
  <spirit id="sum" act="open" xml="(file,stews)"/>                                                         
   
  
    <ti_break class_table="tabNavigator"/>
    <ti type="rec" label=" ">

    <ti type="call_job" job="stew-see" explain="(prop,_x_go_back_sys)" flag="button" align="right" class="fx justback">
      <file id="stews">(file,stews)</file>
      <prop id="stews_offset">(prop,stews_offset)</prop>
      <prop id="stew_key">(prop,stew_key)</prop>
      <prop id="stews_offset_label"></prop>
      
      <file id="squerys">(file,stews)</file>
      <prop id="squery_key">(prop,squery_key)</prop>    
      
      <file id="sqlis">(file,stews)</file>
      <prop id="sqli_key">(prop,sqli_key)</prop>
      
    </ti> 
        
 
    </ti>
    <ti_break/>
  <ti type="rec">  
  <ti x="Running (prop,_sl_stew): (f,html,b,o)(f,spirit,sum,//stew[@row='(prop,stew_key)'],@type)(f,html,b,c) (e:o)(prop,_sl_sqli) (f,spirit,sum,//sqli[@row='(prop,sqli_key)'],@name) / (prop,_sl_squery) (f,spirit,sum,//squery[@row='(prop,squery_key)'],@id)(e:c)"/>
  </ti>  
   <ti_hr_break class_table="tabVerticalMiddle"/>
  <call_job job="squery_editrun_links"/>   
  <call_job job="sqli_editrun_links"/>     
  <call_job job="stew_editrun_links" />

  
  <spirit id="sum" act="close"/>
  <!-- <ti_break/> -->

  <call_job job="sqli_event_run">
    <prop id="sqli-run-dont-print-finals">1</prop>
    <prop id="run-sqli-from-steward">1</prop>
    
  </call_job>
  
  <ti_hr_break/>                              

  <ti>(prop,_sqli_done1)(prop,_sl_stew)(prop,_sqli_done2)</ti>
 
  
</job>

<!-- sqli editrun und run -->

<job id="sqli_event_editrun" role="hidden">
  <prop id="no-post-see">eben</prop>
  <call_job job="sqli-edit"/>
  
  <call_job job="sqli_event_run">
    <prop id="sqli-run-dont-print-finals">1</prop>
  </call_job>
  

</job>   



