<!-- bp-core, make your changes here -->
<job id="tk_bp_core" role="hidden" tip="bp_: Tk Internal">

  <need default="">(prop,tk_bp_add_flag)</need>

  <tk label="Parameters: bp_" 
      flag="(prop,tk_bp_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 
      
    <tk id="bpRepo"
        type="bool"
        label="bpRepo" 
        tip="Individuelles Repo moeglich"      
        flag="no_is_0"  
      	test_first="0"
        />    
        
    <tk id="bpDb"
        type="bool"
        label="bpDb" 
        tip="Individuelle Datenbank moeglich"     
        flag="no_is_0"   
      	test_first="0"
        />
                
    <tk id="bpWertPlus"
        type="bool"
        label="bpWertPlus" 
        tip="Weiterfuehrende Infos bei den Details zu einem Wert"     
        flag="no_is_0"  
      	test_first="0"
        />     

    <tk id="bpSearch"
        type="bool"
        label="bpSearch" 
        tip="Kann Suchen"      
        flag="no_is_0"  
      	test_first="0"
        />  
                
    <tk id="bpSearchPlus"
        type="bool"
        label="bpSearchPlus" 
        tip="Komplexe Suchargumente"    
        flag="no_is_0"    
      	test_first="0"
        />     
        
    <tk id="bpMat"
        type="bool"
        label="bpMat" 
        tip="Job Materialized Views ist grundsaethlich moeglich. Ermoeglicht aus Queries=Abfragen."    
        flag="no_is_0"    
      	test_first="0"
        />  
                
    <tk id="bpMatPlus"
        type="bool"
        label="bpMatPlus" 
        tip="Die wirklich interessanten dinge in den matviews sind moeglich. alles was das system veraendert."  
        flag="no_is_0"      
      	test_first="0"
        />                        
        
    <tk id="bpLoad"
        type="bool"
        label="bpLoad" 
        tip="Ermoeglicht das Befuellen der Datenbank mit Lade-Jobs. Im prinzip geht es um das ausfuehren von pentaho-kettle-jobs."  
        flag="no_is_0"      
      	test_first="0"
        /> 
        
    <tk id="bpInt"
        type="bool"
        label="bpInt" 
        tip="Ermoeglicht die Ausfuehrung der Integration. Beim aufrufen der Integration werden auch die Datenbank-parameter mitgegeben. hier wird dann entsprechend der bpDb unterschiedlich agiert. Ermoeglicht auch das Ausfuehren von Hints(e:s) sprich das senden an die Datenbank." 
        flag="no_is_0"     
      	test_first="0"
        /> 
        
    <tk id="bpRepair"
        type="bool"
        label="bpRepair" 
        tip="Ermoeglicht die Anlage und das Bearbeiten von hints. Ein Ausfuehren der Hints ist jedoch nicht moeglich(e:s) dazu braucht es dbInt da das Ausfuehren nur im zusammenhang mit der Integration sinnvoll ist."   
        flag="no_is_0"     
      	test_first="0"
        />  
                            
    <tk id="bpDev"
        type="bool"
        label="bpDev" 
        tip="Entwicklungsobjekte fuer Pentaho Generieren" 
        flag="no_is_0"       
      	test_first="0"
        />                                  

    <tk id="bpCsvXml"
        type="bool"
        label="bpCsvXml" 
        tip="Die wirklich interessanten dinge in den matviews sind moeglich. alles was das system veraendert."  
        flag="no_is_0"      
      	test_first="0"
        />  
        
    <tk id="bpSta"
        type="bool"
        label="bpSta" 
        tip="Statistiken."  
        flag="no_is_0"      
      	test_first="0"
        />  
        
    <tk id="bpClr"
        type="bool"
        label="bpClr" 
        tip="Operationen zum loeschen der Datenbank."  
        flag="no_is_0"      
      	test_first="0"
        />    
        
    <tk id="bpMaxLimit"
        type="text"
        label="bpMaxLimit" 
        tip="()Limit Level&#xA;1=geringes limit &#xA;2=mehr limit moeglich &#xA;3=mehr&#xA;4=maximales limit, am meisten moeglich&#xA;9=kein Limit()" 
             
      	test_first="0"
        />         
        
          
                 
 
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_bp_edit" tip="bp_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,bp-data))">
      <!-- data exists already -->
      <prop id="tk_bp_add_flag" x="sum_only print"/>
      <call_job job="tk_bp_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_bp_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_bp_default"/>
  <!-- doing input -->
  <call_job job="tk_bp_core"/>
  
  <!-- writing data -->
  <call_job job="tk_bp_write"/>

</job>



<job id="tk_bp_print_values" tip="bp_: Prints the entered values" role="hidden">
  
  <call_job job="tk_bp_read"/>
  
  <call_job job="tk_bp_core">
    <prop id="tk_bp_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_bp_print_values_tips" tip="bp_: Prints values and tips" role="hidden">
  
  <call_job job="tk_bp_read"/>
  
  <call_job job="tk_bp_core">
    <prop id="tk_bp_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_bp_print_help" tip="bp_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_bp_core">
    <prop id="tk_bp_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_bp_read" role="hidden">

  <file id="joe-in-store" x="(file,bp-data)" />
  <prop id="joe-in-regex" x="(prop,bp-regex)" />
    
  <call_job job="go-joe-read"/>
  <call_job job="tk_bp_default"/>

</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_bp_write" role="hidden">
  <file id="joe-in-store" x="(file,bp-data)" />
  <prop id="joe-in-regex" x="(prop,bp-regex)" />
  <call_job job="go-joe-write"/>
</job>

<!-- cleares data -->
<job id="tk_bp_clear"  tip="bp_: Clears the data" role="hidden">
  <delete file="(file,bp-data)"/>
</job>


</jobs>