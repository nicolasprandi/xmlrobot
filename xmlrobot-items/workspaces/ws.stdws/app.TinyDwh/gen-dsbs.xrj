<ti type="rec">
<ti align="right" x="+/- (prop,_sl_dsb) '(f,text,cut_nice,(prop,dsb_name),50)'" />
</ti>
<call_job job="dsb_did_edit" />
</job><job role="hidden" id="dsb-del">
<need>(prop,dsb_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="dsb-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_dsb) [ (f,text,cut_nice,(prop,dsb_name),50) (prop,dsbs_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,dsbs)" where="(prop,dsbs_offset)dsb[@row='(prop,dsb_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,dsb_name),50) #(prop,dsb_key)</tp>
<ti label="- (prop,_sl_dsb):" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,dsb_name),50)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="dso-see" />
</job><job role="hidden" id="dsb-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="dsb_default_label_class" x="+ (prop,_sl_dsb)" />
<prop id="dsb_default_label_name" x="(f,when,(f,has,(prop,dsbs_offset_label)), | (prop,dsbs_offset_label),)" />
<prop id="dsbs_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,dsb_key)</need>
<prop id="dsb_default_label_class" x="(prop,_sl_dsb)" />
<prop id="dsb_default_label_name" x="(f,text,cut_nice,(prop,dsb_name),50)(f,when,(f,has,(prop,dsbs_offset_label)), - (prop,dsbs_offset_label),)" />
<prop id="dsbs_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="dsb-tk" />
</job><job id="dsb-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="dsb-editor" />
<prop id="dsb_key">1</prop>
<when test="(f,not,(f,exists,prop,dsbs_offset_new_key))">
<prop id="dsbs_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,dsbs)" sort="@row" number="@row" xpath="(prop,dsbs_offset_new_key)dsb">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="dsb_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_dsb): #(prop,dsb_key)</i>
<call_job job="dsb-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_dsb) '(f,text,cut_nice,(prop,dsb_name),50)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_dsb)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_dsb)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="dsb_did_edit" />
</otherwise>
</choose>
</job><job role="hidden" id="dsb-write">
<need>(prop,dsb_key) (prop,isAdd)</need>
<need default="./">(prop,dsbs_offset)</need>
<spirit act="open" id="dsbs_spirit_tc" xml="(file,dsbs)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,dsbs_offset),/)">
<prop id="offset2" x="(f,substring,(prop,dsbs_offset),0,(f,sub,(f,len,(prop,dsbs_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,dsbs_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="dsbs_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;dsb row="(prop,dsb_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsbs_spirit_tc" where="(prop,dsbs_offset)dsb[@row='(prop,dsb_key)']" attribute="beztyp" value="(f,vob,prop,dsb_beztyp)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsbs_spirit_tc" where="(prop,dsbs_offset)dsb[@row='(prop,dsb_key)']" attribute="dso_from_row" value="(f,vob,prop,dsb_dso_from_row)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsbs_spirit_tc" where="(prop,dsbs_offset)dsb[@row='(prop,dsb_key)']" attribute="dso_to_row" value="(f,vob,prop,dsb_dso_to_row)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsbs_spirit_tc" where="(prop,dsbs_offset)dsb[@row='(prop,dsb_key)']" attribute="name" value="(f,vob,prop,dsb_name)" />
<spirit act="close" flag="save pretty" id="dsbs_spirit_tc" />
</job></jobs>
