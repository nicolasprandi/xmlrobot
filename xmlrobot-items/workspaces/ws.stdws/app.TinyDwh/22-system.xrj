<ti_break/>
</job>

<job id="change-to-this-lang" role="hidden">
  <!-- <file id="mylanguage">(dir,pro)my-language.txt</file>  
  das ist die schnellwahl mit dem button im config-->
  <file id="lingua-data" x="(dir,pro)lingua-data.xrs"/>
  <prop id="lingua-regex" x="nav_naming_attribute|lingua_lang"/>   
  <need>(prop,ctl-lang)</need>
  
    <call_job job="tk_lingua_read"/>
    <prop id="lingua_lang" x="(prop,ctl-lang)" />
    <call_job job="tk_lingua_write"/>
    <!-- <create_file out="(file,mylanguage)">(prop,ctl-lang)</create_file>  -->
    
    <prop id="ling">(prop,ctl-lang)</prop>

</job>


<job id="set-sys-lang" role="hidden">

  <need>(prop,ling)</need>
  <when test="(f,not,(f,eq_text,(prop,ling),(f,interpreter,lang)))">
    <prop id="alte-lingua">(f,interpreter,lang_desc_international)</prop>
    <call_job job="tr_basic_terms"/>
    <call_job job="tr_langcg"/>
    <prop id="lang-changed-bisher">(prop,_langcg_changes)</prop>
    
    <interpreter language="(prop,ling)"/>
    
    <call_job job="tr_langcg"/>
    <prop id="lang-changed-neu">(prop,_langcg_changes)</prop>
        
    <prop id="neue-lingua">(f,interpreter,lang_desc_international)</prop>
    <prop id="message_label">(prop,lang-changed-bisher) / (prop,lang-changed-neu)</prop>
    <remove type="prop" id="lang-changed-bisher"/>
    <remove type="prop" id="lang-changed-neu"/>
    
    <prop id="message">(prop,alte-lingua) (prop,_x_arr_right) (prop,neue-lingua)</prop>                                                                     
      <ti label="(prop,message_label)" test="(f,has,prop,message_label)"/>
      <ti x="(prop,message)"/>
      <ti_break/>
    <call_job job="sys_freshup"/>
  </when>

</job>

<job id="tr_langcg" role="hidden">
<!--

(prop,)
-->

 <choose>
    <when test="(f,eq_text,(f,interpreter,lang),de)">
      <!-- d=deutsch -->
      <prop id="_langcg_changes">Sprache ge&#228;ndert</prop>                        
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(prop,ling),es)">
      <prop id="_pl_a">A</prop>
      <prop id="_sl_a">A</prop>  
      <prop id="_ex_b">B</prop>      
    </when>  -->  
    <otherwise>
      <!-- e=englisch -->
      <prop id="_langcg_changes">Language changed</prop>
    </otherwise>
  </choose>

</job>

</jobs>