<?xml version="1.0" encoding="UTF-8"?>
<jobs>
<call_job job="prolog"/>

<job id="sys_project_setup" role="hidden">

  <call_job job="tr_first" />
  
  <call_job job="ps-welcome" />
  
  <!-- 
  <call_job job="tk_lingua_read"/>
  <prop id="lingua_lang" x="(prop,ling)" />
  <call_job job="tk_lingua_write"/>
  -->   
  <call_job job="tr_setup" />
  
  <call_job job="ps-install" />
  <call_job job="ps-sprachen" />
  <!-- <call_job job="ps-privilegien" />  -->

</job>



<job id="ps-sprachen" role="hidden">
       
      
      <ti label="(prop,_first_settings)"/>   
      
      <prop id="sprach-postfix">(prop,_first_current): (f,interpreter,lang_desc_international)</prop>
         <ti type="rec" label="(prop,_first_current):">
           <ti>(f,interpreter,lang_desc_international)</ti>
        </ti>         
      <when test="(f,not,(f,eq_text,de,(prop,ling)))">  
          <ti type="rec" label=" ">      

            <ti type="call_job" job="change-to-this-lang" flag="button " 
                class="fx fxEdit fbConf" explain="W&#228;hlen Sie: German-Deutsch"
                xpostfix=" (prop,sprach-postfix)">  
            
                <prop id="ctl-lang">de</prop>
              </ti>           
      
          </ti>
      </when>
      
      <when test="(f,not,(f,eq_text,en,(prop,ling)))">
          <ti type="rec" label=" ">   

            <ti type="call_job" job="change-to-this-lang" flag="button " 
                class="fx fxEdit fbConf" explain="Choose: English"
                xpostfix=" (prop,sprach-postfix)">  
            
                <prop id="ctl-lang">en</prop>
              </ti>           
          </ti>       
                    
      </when>

        
</job>

<job id="ps-install" role="hidden">
  <when test="(f,or,(f,right,install),(prop,bpRepo),(prop,bpDb))">
    <ti_hr/>
      <ti label="(prop,_ex_setups)"/>

      <ti type="rec" test="(f,or,(prop,bpRepo),(prop,bpDb))">    
        <ti type="call_job" job="guided-setup-simple" explain="(prop,_ex_setup_connect)" flag="block"
            />  
         <ti flag="wrap_word">(prop,_ex_setup_connect_explain)</ti>
      </ti>  
        
      <ti type="rec" test="(f,right,install)">
        <ti type="call_job" job="guided-setup" explain="(prop,_ex_setup_new_db)" flag="block"
            />  
         <ti flag="wrap_word">(prop,_ex_setup_new_db_explain)</ti>    
      </ti>
      <ti_hr/>
  </when>
</job>

<job id="ps-welcome" role="hidden">
      <!-- <ti label="(prop,_first_welcome)"></ti>   -->
      <ti type="rec" label="(prop,_first_welcome)">  
      <ti type="call_job" job="vorstufe-apphelp" explain="(prop,_first_more_infos)" />
      </ti>
</job>

<job id="vorstufe-apphelp" role="hidden">

<call_job job="?"/>


  
  <when test="(f,implement,online)">
    <file id="m2">(f,request,dir,session_home_fs)headers(prop,fs)(prop,app)(prop,fs)m2.xml</file>
    
    <when test="(f,file_exists,(file,m2))">
      <ti_hr/>
      <include file="(file,m2)" flag="catch"/> 
    </when>
    
  </when>
    
</job>

<job id="sys_project_backupxx" role="hidden">
  <need>(dir,my-backup-space)</need>
  
  <i>hello data generator sys_project_backup to (dir,my-backup-space)</i>
  <call_job job="tk_para_read"/>
  <when test="(f,has,file,para_file_vok)">
    <copy file="(file,para_file_vok)" intodir="(dir,my-backup-space)"/>
  </when>
  <delete dir="(dir,my-backup-space)cache/" flag="catch"/>
</job>

<job id="sys_copyright" role="hidden">

<ti type="rec">
<ti flag="block" span="10">Copyright 2023 Red-Shark-Formation. All rights reserved.</ti>

</ti>
</job>

<job id="sys_version" role="hidden">
<ti label="Edition:" prodconf="edition">x</ti>
<ti label="Generation:">Antigone</ti>


