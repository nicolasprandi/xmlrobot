          <remove type="prop" id="db_url" flag="catch"/>
          <remove type="prop" id="db_userid" flag="catch"/>
          <remove type="prop" id="db_pix" flag="catch"/>  
          <remove type="prop" id="db_dbci" flag="catch"/>
          <remove type="prop" id="db_app" flag="catch"/>
          
        </when>   
        <otherwise>
          <prop id="do-by-standard-dbci">1</prop>
          <ti>Running Integration with DEFAULT Db-Access for FAST-Integration-Process</ti>
          <ti_flush/>

        </otherwise>
      </choose>
    </when>
    <otherwise>    

      <prop id="do-by-standard-dbci">1</prop>
      <ti>Running Integration with DEFAULT Db-Access for FAST-Integration-Process</ti>
      <ti_flush/>
    </otherwise>
  </choose>  

  <when test="(prop,do-by-standard-dbci)">

    <call_job job="pre-int"/>
    <integriere
      how="dbci"
      test="(f,right,int)"
      log="(dir,int.log)"
      kick="(file,fast_kick)"
      log_file="(file,integration-log)"        
      dbci="fasta__"
      dbci_app="Hibiscus"      
      runstats="(prop,int.runstats)"                                      
      background="(prop,int.background)"
      pronto="(prop,int.pronto)"
      commit="(prop,fast_commit)"
      report="(prop,fast_report)"
      flag="(prop,fast_flag)"
      mv="(file,fast_mv)"
                mv_style="(prop,fast_mv_style)"
    />    
  
  </when>  
                              
  <ti label="(prop,_int_is_done)"/>
  <ti type="call_job" job="see-log-file" explain="(prop,_int_see_log)" flag="button " > 
    <file id="logging">(file,integration-log)</file>
  </ti>  
            
</job>

