              <ti_flush/>
              <integriere            
                how="dbci"
                test="(f,right,int)"
                log="(dir,int.log)"
                kick="(file,fast_kick)"
                log_file="(file,integration-log)"                                     
                dbci="(prop,db_dbci)"
                dbci_app="(prop,db_app)"
                runstats="(prop,int.runstats)"
                background="(prop,int.background)"
                pronto="(prop,int.pronto)"
                commit="(prop,fast_commit)"
                report="(prop,fast_report)"
