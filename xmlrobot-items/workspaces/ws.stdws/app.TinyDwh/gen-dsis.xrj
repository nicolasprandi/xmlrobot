</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,dsis)" where="(prop,dsis_offset)dsi[@row='(prop,dsi_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,dsi_name),30) #(prop,dsi_key)</tp>
<ti label="- (prop,_sl_dsi):" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,dsi_name),30)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="dsi-see-all" />
</job><job role="hidden" id="dsi-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="dsi_default_label_class" x="+ (prop,_sl_dsi)" />
<prop id="dsi_default_label_name" x="(f,when,(f,has,(prop,dsis_offset_label)), | (prop,dsis_offset_label),)" />
<prop id="dsis_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,dsi_key)</need>
<prop id="dsi_default_label_class" x="(prop,_sl_dsi)" />
<prop id="dsi_default_label_name" x="(f,text,cut_nice,(prop,dsi_name),30)(f,when,(f,has,(prop,dsis_offset_label)), - (prop,dsis_offset_label),)" />
<prop id="dsis_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="dsi-tk" />
</job><job id="dsi-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="dsi-editor" />
<prop id="dsi_key">1</prop>
<when test="(f,not,(f,exists,prop,dsis_offset_new_key))">
<prop id="dsis_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,dsis)" sort="@row" number="@row" xpath="(prop,dsis_offset_new_key)dsi">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="dsi_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_dsi): #(prop,dsi_key)</i>
<call_job job="dsi-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_dsi) '(f,text,cut_nice,(prop,dsi_name),30)'" />
</ti>
<choose>
<when test="(f,exists,prop,hack-mox)">
</when>   
<when test="(f,has,prop,post_add_script_dsi)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_dsi)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="dsi_did_insert" />
</otherwise>
</choose>
</job><job role="hidden" id="dsi-write">
<need>(prop,dsi_key) (prop,isAdd)</need>
<need default="./">(prop,dsis_offset)</need>
<spirit act="open" id="dsis_spirit_tc" xml="(file,dsis)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,dsis_offset),/)">
<prop id="offset2" x="(f,substring,(prop,dsis_offset),0,(f,sub,(f,len,(prop,dsis_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,dsis_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="dsis_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;dsi row="(prop,dsi_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsis_spirit_tc" where="(prop,dsis_offset)dsi[@row='(prop,dsi_key)']" attribute="name" value="(f,vob,prop,dsi_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsis_spirit_tc" where="(prop,dsis_offset)dsi[@row='(prop,dsi_key)']" attribute="docu" value="(f,vob,prop,dsi_docu)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsis_spirit_tc" where="(prop,dsis_offset)dsi[@row='(prop,dsi_key)']" attribute="cat" value="(f,vob,prop,dsi_cat)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsis_spirit_tc" where="(prop,dsis_offset)dsi[@row='(prop,dsi_key)']" attribute="status" value="(f,vob,prop,dsi_status)" />
<spirit act="close" flag="save pretty" id="dsis_spirit_tc" />
</job></jobs>
