<prop id="kjobs_sort_number">(prop,kjobs_sort_number)</prop>
<prop id="kjobs_sort_ignore_case">(prop,kjobs_sort_ignore_case)</prop>
<prop id="kjobs_sort_desc">(prop,kjobs_sort_desc)</prop>
<prop id="kjobs_where">(prop,kjobs_where)</prop>
<prop id="kjobs_return_job">(prop,kjobs_return_job)</prop>
</ti>
</ti>
</when>
<otherwise>
<ti type="rec" label=" ">
<ti type="call_job" explain="(prop,_x_go_up_sys)" flag="button" align="right" class="justup" job="kjob-see-all">
<file id="kjobs">(file,kjobs)</file>
<prop id="kjobs_offset">(prop,kjobs_offset)</prop>
<prop id="kjobs_offset_label">(prop,kjobs_offset_label)</prop>
<prop id="kjobs_offset_new_key">(prop,kjobs_offset_new_key)</prop>
<prop id="kjobs_sort_attribute">(prop,kjobs_sort_attribute)</prop>
<prop id="kjobs_sort_number">(prop,kjobs_sort_number)</prop>
<prop id="kjobs_sort_ignore_case">(prop,kjobs_sort_ignore_case)</prop>
<prop id="kjobs_sort_desc">(prop,kjobs_sort_desc)</prop>
<prop id="kjobs_where">(prop,kjobs_where)</prop>
<prop id="kjobs_return_job">(prop,kjobs_return_job)</prop>
</ti>
</ti>
</otherwise>
</choose>
<ti_break />
</job><job role="hidden" id="kjob-edit">
<need>(prop,kjob_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="kjob-read" />
<prop id="isAdd">0</prop>
<call_job job="kjob-editor" />
<call_job job="kjob-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+/- (prop,_sl_kjob) '(f,text,cut_nice,(prop,kjob_id),30)'" />
</ti>
<call_job job="event_post_update_kjob" />
</job><job role="hidden" id="kjob-del">
<need>(prop,kjob_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="kjob-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_kjob) [ (f,text,cut_nice,(prop,kjob_id),30) (prop,kjobs_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,kjobs)" where="(prop,kjobs_offset)kjob[@row='(prop,kjob_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,kjob_id),30) #(prop,kjob_key)</tp>
<ti label="- (prop,_sl_kjob):" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,kjob_id),30)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="kjob-see-all" />
</job><job role="hidden" id="kjob-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="kjob_default_label_class" x="+ (prop,_sl_kjob)" />
<prop id="kjob_default_label_name" x="(f,when,(f,has,(prop,kjobs_offset_label)), - (prop,kjobs_offset_label),)" />
<prop id="kjobs_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,kjob_key)</need>
<prop id="kjob_default_label_class" x="(prop,_sl_kjob)" />
<prop id="kjob_default_label_name" x="(f,text,cut_nice,(prop,kjob_id),30)(f,when,(f,has,(prop,kjobs_offset_label)), - (prop,kjobs_offset_label),)" />
<prop id="kjobs_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="kjob-tk" />
</job><job id="kjob-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="kjob-editor" />
<prop id="kjob_key">1</prop>
<when test="(f,not,(f,exists,prop,kjobs_offset_new_key))">
<prop id="kjobs_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,kjobs)" sort="@row" number="@row" xpath="(prop,kjobs_offset_new_key)kjob">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="kjob_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_kjob): #(prop,kjob_key)</i>
<call_job job="kjob-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_kjob) '(f,text,cut_nice,(prop,kjob_id),30)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_kjob)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_kjob)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="event_post_update_kjob" />
</otherwise>
</choose>
</job><job role="hidden" id="kjob-write">
<need>(prop,kjob_key) (prop,isAdd)</need>
<need default="./">(prop,kjobs_offset)</need>
<spirit act="open" id="kjobs_spirit_tc" xml="(file,kjobs)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,kjobs_offset),/)">
<prop id="offset2" x="(f,substring,(prop,kjobs_offset),0,(f,sub,(f,len,(prop,kjobs_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,kjobs_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in_begin" id="kjobs_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;kjob row="(prop,kjob_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<file id="jack-in" x="(file,kjob_jobfile)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="kjobs_spirit_tc" where="(prop,kjobs_offset)kjob[@row='(prop,kjob_key)']" attribute="jobfile" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="kjobs_spirit_tc" where="(prop,kjobs_offset)kjob[@row='(prop,kjob_key)']" attribute="id" value="(f,vob,prop,kjob_id)" />
<file id="jack-in" x="(file,kjob_datafile)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="kjobs_spirit_tc" where="(prop,kjobs_offset)kjob[@row='(prop,kjob_key)']" attribute="datafile" value="(prop,jack-result)" />
<dir id="jack-in" x="(dir,kjob_datafolder)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-dir" flag="silent">
<dir id="jack-in" x="(dir,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="kjobs_spirit_tc" where="(prop,kjobs_offset)kjob[@row=(f,xpath_string,(prop,kjob_key))]" attribute="datafolder" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="kjobs_spirit_tc" where="(prop,kjobs_offset)kjob[@row='(prop,kjob_key)']" attribute="desc" value="(f,vob,prop,kjob_desc)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="kjobs_spirit_tc" where="(prop,kjobs_offset)kjob[@row='(prop,kjob_key)']" attribute="hist" value="(f,vob,prop,kjob_hist)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="kjobs_spirit_tc" where="(prop,kjobs_offset)kjob[@row='(prop,kjob_key)']" attribute="uri" value="(f,vob,prop,kjob_uri)" />
<spirit act="close" flag="save pretty" id="kjobs_spirit_tc" />
</job></jobs>
