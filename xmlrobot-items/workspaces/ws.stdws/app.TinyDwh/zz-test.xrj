<job id="test-include" pri="10" role="hidden">

  <try_catch>
    <try>
      <call_job job="go-joe-read">
        <file id="joe-in-store" x="(dir,pro)test-include-data.xrs" />
        <prop id="joe-in-regex" x="torun" />  
      </call_job>
      <prop id="thetip">&lt;steps&gt;
  &lt;ti&gt;hallo&lt;/ti&gt;
&lt;/steps&gt;</prop>
      <tk type="textblock" flag="big bigbig nono" id="torun" tip="(prop,thetip)" x="(prop,thetip)"/>
      
      <call_job job="go-joe-write">
        <file id="joe-in-store" x="(dir,pro)test-include-data.xrs" />
        <prop id="joe-in-regex" x="torun" />  
      </call_job>  
      
      <file id="test-include">(dir,pro)test-include-to-run.xrs</file>
      
      <create_file out="(file,test-include)">(prop,torun)</create_file>
      <ti type="file" label="Created:">(file,test-include)</ti>
      <ti_hr/>
      <prop id="turbo-antes">(f,interpreter,turbo)</prop>
      <interpreter turbo="0"/>
      <include file="(file,test-include)"/>
      <interpreter turbo="(prop,turbo-antes)"/>      
      
      <ti_hr/>
      <ti>task &apos;include&apos; funktiert!</ti>    
    </try>
    <catch>
      <ti>task &apos;include&apos; funktiert nicht oder das script hat einen fehler!</ti>
      <ti label="Message">(prop,catched_msg)</ti>
      <ti_hr/>
      <throw_again/>      
    </catch>
  </try_catch>

  <ti_hr/>
  
  <ti label="Again:" type="call_job" job="test-include"/>
  
</job>

