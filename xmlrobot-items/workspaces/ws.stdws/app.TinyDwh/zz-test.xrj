<job id="test-encrypt" role="hidden">
  <tk label="ecryptor" flag="sum">
    <tk id="k1" flag="nono"/>
    <tk id="k2" flag="nono"/>
    <tk id="silent" flag="nono"/>
  </tk>
  <throw test="(f,not,(f,eq_text,(prop,k1),(prop,k2)))">k1 und k2 muessen gleich sein</throw>
  
      <crypto id="scra" act="open" type="(prop,k1)" flag="secret" />
      <remove type="prop" id="k1"/>
      <remove type="prop" id="k2"/>
      <crypto id="scra" act="encrypt" in="(prop,silent)" out="ergebnis"/>
      <remove type="prop" id="silent"/>
    
      <crypto id="scra" act="close" />    
      <ti label="ergebnis">(prop,ergebnis)</ti> 
        
</job>
