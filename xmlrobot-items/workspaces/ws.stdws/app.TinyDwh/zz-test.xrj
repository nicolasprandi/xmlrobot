<job id="ant-test" pri="10" role="hidden">
  <try_catch>
    <try>
      <interpreter watch="1"/>
      <file id="ant-test-file-from">(dir,pro)ant-test-file-from.txt</file>
      <file id="ant-test-file-to">(dir,pro)ant-test-file-to.txt</file>
      <when test="(f,file_exists,(file,ant-test-file-to))">
        <delete file="(file,ant-test-file-to)"/>
      </when>
      <create_file out="(file,ant-test-file-from)">(f,time)</create_file>
      
      <ant>
      <copy file="(f,file,classic,(file,ant-test-file-from))" 
            todir="(f,dir,classic,(file,ant-test-file-to))" 
            preservelastmodified="true" 
            overwrite="true"/>
      </ant>

      <ti>task &apos;ant&apos; funktiert!</ti>  
      <ti label="did copy file"/>
      <ti type="file">(file,ant-test-file-from)</ti>
      <ti type="file">(file,ant-test-file-to)</ti>
    
    </try>
    <catch>
      <ti>task &apos;ant&apos; funktiert nicht!</ti>
      <ti label="Message">(prop,catched_msg)</ti>
      <ti_hr/>
      <throw_again/>
    </catch>
  </try_catch>


  
</job>

<job id="test-pic" role="hidden">
  <interpreter watch="1"/>
  <prop id="i" x="+000000034700000.0100"/>
  <prop id="vk">(f,substring,(prop,i),0,16)</prop>
  <prop id="vk">(f,format,(prop,vk),(e:s)##0,us)</prop>
  
  
  <prop id="nk">(f,substring,(prop,i),16,21)</prop>
                                 
</job>                                
<job id="test-symbols" role="hidden">
    <prop id="t">[&#402;i &#8489;&#8593;&#8595;&#8834;&#8847;&#9021;&#9651;&#9652;&#10773; +&#8591;++&#8592;+++&#8593;++++&#8594;+++++&#8595;++++++&#8596;]</prop>
    
    <ti>== ti text ==</ti>
    <ti>(prop,t)</ti>
    
    <ti>== ti call ==</ti>
    <ti type="call_job" job="abc" explain="(prop,t)"/>    
    
    <ti>== ti call button ==</ti>
    <ti type="call_job" job="abc" explain="(prop,t)" 
        class="testClass" flag="button obutton"/>   
        
    <ti>== ti rec . text . call call button==</ti>
    <ti type="rec">
      <ti>(prop,t)</ti>
      <ti type="call_job" job="abc" explain="(prop,t)"/> 
      <ti type="call_job" job="abc" explain="(prop,t)" 
        class="testClass" flag="button obutton"/>      
    </ti>        
</job>



<job id="test-ti" role="hidden">

  <ti type="file">(dir,pro)disconnect.off</ti>
  <ti_hr/>
  <ti>[diverses]</ti>
  <ti>xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx</ti>
  <ti>[tiLabel]</ti>
  
  <ti label="derLabel">xx</ti>
  
  <ti>[tiLabelRight]</ti>
  
  <ti label="derLabel" flag="label_right">xx</ti>
    
  <ti>[tiLabelOnly]</ti>

  <ti label="derLabel"/>
