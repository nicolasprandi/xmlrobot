<?xml version="1.0" ?>
<jobs>
<call_job job="prolog"/>
<job id="test-dbci1" role="hidden">
  <prop id="dbci_id">ci1s__</prop>                
  <dbci id="(prop,dbci_id)" act="open"
        url="jdbc:mysql://localhost:3306/hibiscus"
        user="root"
        password="root"
        db="mysql "/>
        
  <dbc id="db1" act="open" how="dbci" dbci="(prop,dbci_id)"/>
  
  <file id="on-3" x="(dir,pro)cache/t1.xml"/>
  
    
  <dbc id="db1"
    out="(file,on-3)"
    style="a"
    act="select"
    root_name="werte"
    row_name="wert"    
    flag="trim">()select * from obj limit 10;()</dbc> 
    
  <ti>(f,file_content,(file,on-3))</ti>
  
  
  <dbc id="db1" act="close"/>
        
  <dbci id="(prop,dbci_id)" act="close" />      

</job>

<job id="test-web" role="hidden">
  <ti label="simple" type="web">https://www.xmlrobot.net</ti>
  <ti type="rec" label="rec">
      <ti  type="web">https://www.xmlrobot.net</ti>
  </ti>
</job>

<job id="test-run2" role="hidden">

      <file id="scripts">(dir,pro)cache/bulk-script-runner.xml</file>
      <create_file file="(file,scripts)"><![CDATA[<?xml version="1.0" encoding="UTF-8"?><steps>
      <ti>hallo</ti>
      <ti test="0" job_id="77">
        <ti>im job 77</ti>
      </ti>  
      <ti test="0" job_id="88">
        <ti>hallo imm 88</ti>
        <try_catch><try>
        <call_job job="Object">
          <prop id="on-id">88</prop>
        </call_job>
        </try><catch><ti>hallo im catch 88 ()(prop,catched_msg)()</ti>
        <tk type="msg">object with number 88 was not found</tk>
        <tk id="my-object-numer" flag="nono"/>
        <call_job job="Object">
          <prop id="on-id">()(prop,my-object-numer)()</prop>
        </call_job>        
        </catch></try_catch>>
      </ti>               
      </steps>]]></create_file>
      <spirit act="open" id="scripts" file="(file,scripts)" />
      <ti label="the file">(f,spirit,scripts,xml?,.)</ti>
      <ti label="Running xpath ."/>
      <spirit act="run" id="scripts"  xpath="." />
      <ti label="Running xpath //ti[@job_id=77]"/>
      <spirit act="run" id="scripts"  xpath="//ti[@job_id=77]" />      

       <ti label="Running xpath //ti[@job_id=88]"/>
      <spirit act="run" id="scripts"  xpath="//ti[@job_id=88]" />         
      <spirit act="close" id="scripts"  />
        
</job>

<job id="test-run" role="hidden">

      <file id="scripts">(dir,pro)cache/bulk-script-runner.xml</file>
      <create_file file="(file,scripts)"><![CDATA[<?xml version="1.0" encoding="UTF-8"?><steps>
      <ti>hallo</ti>
      <ti test="0" job_id="77">
        <ti>im job 77</ti>
      </ti>  
      <ti test="0" job_id="88">
        <ti>hallo imm 88</ti>
        <try_catch><try>
        <call_job job="Object">
          <prop id="on-id">88</prop>
        </call_job>
        </try><catch><ti>hallo im catch 88 ()(prop,catched_msg)()</ti>
        <tk type="msg">object with number 88 was not found</tk>
        <tk id="my-object-numer" flag="nono"/>
        <call_job job="Object">
          <prop id="on-id">()(prop,my-object-numer)()</prop>
        </call_job>        
        </catch></try_catch>>
      </ti>               
      </steps>]]></create_file>
      <spirit act="open" id="scripts" file="(file,scripts)" />
      <ti label="the file">(f,spirit,scripts,xml?,.)</ti>
      <ti label="Running xpath ."/>
      <spirit act="run" id="scripts"  xpath="." />
      <ti label="Running xpath //ti[@job_id=77]"/>
      <spirit act="run" id="scripts"  xpath="//ti[@job_id=77]" />      
       
      <spirit act="close" id="scripts"  />
        
</job>

<job id="test-libro" role="hidden">
  <ti label="request libro ">(f,request,dir,libro)</ti>  
