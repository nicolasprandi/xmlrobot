<jobs>

<call_job job="prolog" />

<!-- <when test="(f,has,prop,pro)"> take 2 things to the prolog --> 
  <!-- 
  <file id="bd-data" x="(dir,pro)bd-data.xrs"/>
  <prop id="bd-regex" x="bd_.+"/>
  -->
<!-- </when>       -->

<!-- gui Adapters: to copy in the app  take the edit to your gui.... -->

<job id="tk_bd_intro_edit" role="hidden">
  <!-- das wird oben im buch eingebunden -->
  <need>(dir,book-master)</need>
  <need>(prop,book-type)</need>
  <need>(prop,book-name)</need>
  <need>(prop,book-home-job)</need>

  <ti_break class_table="tabNavigator"/>

  <ti type="rec">
    <ti type="call_job" job="(prop,book-home-job)" explain="(prop,_x_go_back_sys)" flag="button " class="justback"
        align="right" />
  </ti>  
     
  <ti_break/>
  <file id="bd-data" x="(dir,book-master)(prop,book-name)/book-info.xrs"/>
  <call_job job="tk_bd_edit"/>
  
  <ti type="rec">
    <ti> </ti>
    <ti flag="button" type="call_job" 
      class="fx fxEdit" explain="Edit" job="tk_bd_intro_edit">
        <dir id="book-master">(dir,book-master)</dir>
        <prop id="book-type">(prop,book-type)</prop>
        <prop id="book-name">(prop,book-name)</prop>
        <prop id="book-type-name">(prop,book-type-name)</prop>
        <prop id="book-home-job">(prop,book-home-job)</prop>

    </ti>
  </ti> 
    
  <ti_break class_table="tabNavigator"/>

  <ti type="rec">
    <ti type="call_job" job="(prop,book-home-job)" explain="(prop,_x_go_back_sys)" flag="button " class="justback"
        align="right" />
  </ti>    
</job>

<job id="tk_bd_intro_see" role="hidden">
  <!-- das wird oben im buch eingebunden -->
  <need>(prop,book-type)</need>
  <need>(dir,book-master)</need>
  <need>(prop,book-name)</need>
  <need>(prop,book-home-job)</need>
  
  <file id="bd-data" x="(dir,book-master)(prop,book-name)/book-info.xrs"/>
  <choose>
    <when test="(f,exists_file,(file,bd-data))">
    
    <ti_break class_table="tabNavigator"/>
  
    <ti type="rec">
      <ti type="call_job" job="(prop,book-home-job)" explain="(prop,_x_go_back_sys)" flag="button " class="justback"
          align="right" />
    </ti>  
       
    <ti_break/>
      
      <call_job job="tk_bd_print_values"/> 
      
      <ti type="rec">
        <ti> </ti>
        <ti flag="button" type="call_job" 
          class="fb fbEdit" explain="Edit" job="tk_bd_intro_edit">
              <dir id="book-master">(dir,book-master)</dir>
              <prop id="book-name">(prop,book-name)</prop>
              <prop id="book-type">(prop,book-type)</prop>
              <prop id="book-type-name">(prop,book-type-name)</prop>
              <prop id="book-home-job">(prop,book-home-job)</prop>
    
        </ti>
      </ti> 
      
      <ti_break class_table="tabNavigator"/>
    
      <ti type="rec">
        <ti type="call_job" job="(prop,book-home-job)" explain="(prop,_x_go_back_sys)" flag="button " class="justback"
            align="right" />
      </ti>      
        
    </when>
    <otherwise>
       <call_job job="tk_bd_intro_edit"/> 
    </otherwise>
  
  
  </choose>
    
  
</job>

<job id="tk_bd_intro" role="hidden">
  <!-- das wird oben im buch eingebunden -->
  <need>(dir,book-master)</need>  
  <need>(prop,book-type)</need>
  <need>(prop,book-type-name)</need>
  <need>(prop,book-name)</need>
  <need>(prop,book-home-job)</need>
  
  <file id="bd-data" x="(dir,book-master)(prop,book-name)/book-info.xrs"/>

  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,bd-data)" />
    <prop id="joe-in-regex" x="bd_.+" />
  </call_job>      
  
  <ti type="rec">
    <ti flag="wrap_word block" test="(f,has,prop,bd_doku)">(f,vob,prop,bd_doku)</ti>
    <ti flag="button" align="right" type="call_job" 
      class="fb fbAdd" explain="(prop,_sl_buch) (prop,_x_doku)" job="tk_bd_intro_see">
      
          <dir id="book-master">(dir,book-master)</dir>
          <prop id="book-type">(prop,book-type)</prop>
          <prop id="book-name">(prop,book-name)</prop>
          <prop id="book-type-name">(prop,book-type-name)</prop>
          <prop id="book-home-job">(prop,book-home-job)</prop>

    </ti>
  </ti> 
  
    
 
</job>

<job id="Edit: bd_?">
  <call_job job="tk_bd_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_bd_clear" explain="Clear this data"/>
</job>






<!-- bd-core, make your changes here -->
<job id="tk_bd_core" role="hidden" tip="bd_: Tk Internal">

  <need default="">(prop,tk_bd_add_flag)</need>
  
  <call_job job="tr_bd"/>

  <tk label="(prop,_x_doku) &apos;(prop,book-name)&apos; (prop,book-type-name)-(prop,_sl_buch)" 
      flag="(prop,tk_bd_add_flag)" tk_id="34"> 
         
    <tk id="bd_doku"
        type="textblock"
        label="(prop,_bd_doku_l)"               
      	test_first="0"
        tip="(prop,_bd_doku_t)" 
        flag="big"/> 
        
    <tk id="bd_detail"
        type="textblock"
        label="(prop,_bd_detail_l)"               
      	test_first="0"
        tip="(prop,_bd_detail_t)" 
        flag="big"/>        
                          
  </tk>   
</job>
<!-- 
<job id="See Values: bd_" role="dev">
  <call_job job="tk_bd_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_bd_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: bd_">
  <tk type="msg" x="Sure to clear data of bd_ ?" msg_type="w"/>
  <call_job job="tk_bd_clear"/>
</job>

<job id="Print Values:  bd_">
  <call_job job="tk_bd_print_values"/>
</job>
<job id="Print Help: bd_" role="dev">
  <call_job job="tk_bd_print_help"/>
</job>

