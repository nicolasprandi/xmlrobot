<!-- edit data: read, userinput, write -->
<job id="tk_bd_edit" tip="bd_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,bd-data))">
      <!-- data exists already -->
      <prop id="tk_bd_add_flag" x="sum_only print"/>
      <call_job job="tk_bd_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_bd_add_flag" x="sum print"/>
    </otherwise>
  </choose>

  <!-- doing input -->
  <call_job job="tk_bd_core"/>
  
  <!-- writing data -->
  <call_job job="tk_bd_write"/>

</job>



<job id="tk_bd_print_values" tip="bd_: Prints the entered values" role="hidden">
  
  <call_job job="tk_bd_read"/>
  
  <call_job job="tk_bd_core">
    <prop id="tk_bd_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_bd_print_values_tips" tip="bd_: Prints values and tips" role="hidden">
  
  <call_job job="tk_bd_read"/>
  
  <call_job job="tk_bd_core">
    <prop id="tk_bd_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_bd_print_help" tip="bd_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_bd_core">
    <prop id="tk_bd_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_bd_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,bd-data)" />
    <prop id="joe-in-regex" x="bd_.+" />    
  </call_job>

  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_bd_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,bd-data)" />
    <prop id="joe-in-regex" x="bd_.+" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_bd_clear"  tip="bd_: Clears the data" role="hidden">
  <delete file="(file,bd-data)"/>
</job>


</jobs>