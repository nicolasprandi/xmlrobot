</job>

<job id="-db-close-" role="hidden">
  <!-- 
  <ti key="CLOSE DB: (prop,mydbc)"> </ti>
  <dbc id="a"
    act="close"/>       -->
</job>

<job id="-db-kill-" role="hidden">

<when test="(f,not,(f,has,prop,killid))">
  <tk id="killid" flag="nono"/>
</when>
<need>(prop,killid)</need>

  <prop id="dbci-gleiches">admina__</prop>
  <prop id="dbc-gleiches">admin</prop>
  
        <dbc id="(prop,dbc-gleiches)"
          how="dbci"
          dbci="(prop,dbci-gleiches)"
          dbci_app="Hibiscus"          
          act="open"/>
          

     <try_catch>
      <try>
        <dbc id="(prop,dbc-gleiches)"
          act="update"
          update_return_prop="kill-run-return">KILL CONNECTION (prop,killid);</dbc> 
        <ti label="Killed Connection">(prop,killid)</ti>  
        <ti label="Returns">(prop,kill-run-return)</ti> 
        <remove id="kill-run-return" type="prop" />
      </try><catch>
      <ti label="problem kill connection">(prop,catched_msg)</ti>
      </catch></try_catch>
        
     <dbc id="(prop,dbc-gleiches)"
                   
          act="close"/>
</job>


<job id="-db-close-on-purpose-" role="hidden">
  <!-- --> <!-- <ti>-db-close-on-purpose-</ti>          --> 

  <choose>
    <when test="(f,exists_file,(dir,pro)dc.txt)">
      <call_job job="stop-dbc-real" />
    </when>
    <otherwise>
      <!--<ti>no action done. enable delete by ...</ti>  -->
    </otherwise>
  </choose>
</job>
<job id="stop-dbc-gui" role="hidden">

  <ti_break class_table="tabNavigator"/>    
  <ti type="rec" >   
    <ti flag="block wrap_word" span="8"></ti>                     
    <ti type="call_job" explain="(f,when,(f,eq_text,(f,interpreter,lang),de),Verbindung zur Db trennen,Disconnect from Db)" flxag="button" align="right" cxlass="justup" job="stop-dbc-real">  
    <prop id="return-job">(f,vob,prop,return-job)</prop>
    </ti> 
  </ti>  
  <ti_break /> 
</job>  

<job id="stop-dbc-real" role="hidden">

  <call_job job="-db-get-id-" />
  <try_catch>
    <try>
      <dbc id="(prop,mydbc)"
        act="close"/>   
      <call_job job="tr_db"/> 
      <ti type="rec">
      <ti flag="block" x="(f,html,small,o)(prop,_db_dbms_msg_did_disconnect)(f,html,small,c)" />
      </ti>
    </try>
    <catch>
      <call_job job="tr_db"/> 
      <ti type="rec">
      <tii flag="block" x="(f,html,small,o)(prop,_db_dbms_msg_did_noconn)(f,html,small,c)"/>
      </ti>
    </catch>
  </try_catch>
  
   <!--
   <call_job job="(prop,return-job)" test="(f,has,prop,return-job)"/>
        -->               

</job>  

<job id="tk_db_default" role="hidden">
  <!--
  <need default="jdbc:postgresql://localhost:5432/hibiscus">(prop,db_url)</need>
                
  <need default="postgres">(prop,db_userid)</need>   
  <need default="postgres">(prop,db_dbms)</need>    -->    
  
</job>
<!-- db-core, make your changes here -->
<job id="tk_db_core" role="hidden" tip="db_: Tk Internal">

  <need default="">(prop,tk_db_add_flag)</need>
  
  <call_job job="tk_db_default"/>
  <call_job job="tr_db"/>
  
  
  <tk xlabel="(prop,_db_top_l)"
      label="(f,when,(f,has_flag,(prop,tk_db_add_flag),print_tips_only),(prop,_db_top_l_desc),(prop,_db_top_l))"      
      flag="(prop,tk_db_add_flag)"
      tip="(prop,_db_top_t)"
      tk_id="35"> 
      
    <tk id="db_how" 
        label="Method"  
        flag="nono"                 
        tip="strategy"
        type="sel">
        <sel label="Dbci">dbci</sel>
        <sel label="Url">url</sel>
    </tk>          
    <tk type="msg" msg="Dbci"/>
    <tk id="db_dbci" 
        label="Dbci-Id"  
        xflag="nono"                 
        tip="On type dbci "
        cols="60"/>
        
    <tk id="db_app" 
        label="Dbci-App"  
        xflag="nono"                 
        tip="possible an app "
        cols="60"/>        
    <tk type="msg" msg="Url"/>            
    <tk id="db_url" 
        label="(prop,_db_url_l)"  
        xflag="nono"                 
        tip="(prop,_db_url_t)"
        cols="60"/>
        
    <tk id="db_dbms" 
        label="(prop,_db_dbms_l)"  
        xflag="nono"                 
        tip="(prop,_db_dbms_t)"
        type="sel">
        <sel label="Postgres">postgres</sel>
        <sel label="MySql">mysql</sel>
        <sel label="MariaDb">maria</sel>
    </tk>        
        
    <tk id="db_userid" 
        label="(prop,_db_userid_l)"  
        flag="xnono password"                 
        tip="(prop,_db_userid_t)"
        cols="20"/>
        
    <tk id="db_pix" 
        label="(prop,_db_pix_l)"  
        flag="xnono password"                 
        tip="(prop,_db_pix_t)"
        cols="20"/>
             
                  
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_db_edit" tip="db_: Edit the Data" role="hidden">
  
  
  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,db-data))">
      <!-- data exists already -->
      <prop id="tk_db_add_flag" x="sum_only print"/>
      <call_job job="tk_db_read_for_edit"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_db_add_flag" x="sum_only print"/>
    </otherwise>
  </choose>
  
  <!-- doing input -->
  <call_job job="tk_db_core"/>
  
  <!-- writing data -->
  <call_job job="tk_db_write"/>

</job>



<job id="tk_db_print_values" tip="db_: Prints the entered values" role="hidden">
  
  <call_job job="tk_db_read_for_edit"/>
  
  <call_job job="tk_db_core">
    <prop id="tk_db_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_db_print_values_tips" tip="db_: Prints values and tips" role="hidden">
  
  
  <call_job job="tk_db_read_for_edit"/>
  <call_job job="tk_db_core">
    <prop id="tk_db_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  
    <ti_hr/>  
    <ti type="rec" label=" " > 
      <ti type="call_job" job="Db Conf" explain="(prop,_x_edit)" label=" " flag="button" class="fx fxEdit fxEditDetail fxEditDetailConf fxEditDetailConfDb"/>
      <ti> </ti>
      
    </ti>  
  
</job>

<job id="tk_db_print_help" tip="db_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_db_core">
    <prop id="tk_db_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_db_read_for_edit" role="hidden">
<when test="(prop,bpDb)" >
  <file id="joe-in-store" x="(file,db-data)" />
  <prop id="joe-in-regex" x="(prop,db-regex)" />
  <call_job job="go-joe-read"/>
</when>
</job>  

<job id="tk_db_read" role="hidden">
<when test="(prop,bpDb)" >
  <file id="joe-in-store" x="(file,db-data)" />
  <prop id="joe-in-regex" x="(prop,db-regex)" />
  <call_job job="go-joe-read"/>
  
  <prop id="2db_dbms" test="(f,has,prop,db_dbms)">(f,when,(f,eq_text,maria,(prop,db_dbms)),mysql,(prop,db_dbms))</prop>

  <when test="(f,exists_file,(file,db-data-pwd))">

    <!-- <crypto id="acc" act="close" flag="catch"/> -->
    <try_catch>
      <try>
        <crypto id="acc" act="open" type="FWUspzSgLr1bWKID"/>
        <crypto id="acc" act="decrypt" in="(f,file_content,(file,db-data-pwd))" out="db_pix"/>
        <!-- <ti>(prop,db_pix)</ti> -->
        <crypto id="acc" act="close" />  
      </try>
      <catch>
        <call_job job="tr_dbpr"/>
        <ti label="(prop,_dbpr_pPwd)" />
        <ti label="(prop,_dbpr_exception)">(prop,catched_msg)</ti>
        <crypto id="acc" act="close" flag="catch"/>
      </catch>
    </try_catch>    
  </when>

  <when test="(f,exists_file,(file,db-data-user))">
    <!-- <crypto id="acc" act="close" flag="catch"/> -->
    <try_catch>
      <try>
        
        <crypto id="bcc" act="open" type="FWUspzSgLr1bWKxx"/>
        
        <crypto id="bcc" act="decrypt" in="(f,file_content,(file,db-data-user))" out="db_userid"/>
        <!-- <ti>(prop,db_userid)</ti> -->
        <crypto id="bcc" act="close" />  
        
      </try>
      <catch>
        <ti label="(prop,_dbpr_pUser)" />
        <ti label="(prop,_dbpr_exception)">(prop,catched_msg)</ti>
        <crypto id="bcc" act="close" flag="catch"/>
      </catch>
    </try_catch>    
  </when>  
</when>
  
</job>

<job id="tk_db_read_dbms" role="hidden">
<need default="0">(prop,ask-user-for-dbms)</need>
<need default="0">(prop,ask-user-always-for-dbms)</need>

<remove type="prop" id="db_dbms" test="(f,exists,prop,db_dbms)"/>

<call_job job="go-joe-read">
  <file id="joe-in-store" x="(file,db-data)" />
  <prop id="joe-in-regex" x="db_dbms" />  
</call_job>

<when test="(f,or,(f,not,(f,has,prop,db_dbms)),(prop,ask-user-always-for-dbms))" >

  <choose>  
    <when test="(f,not,(prop,bpDb))" >
      <prop id="db_dbms" prodconf="default-dbms">postgres</prop>    
    </when>
    
    <when test="(prop,ask-user-for-dbms)" >
      <call_job job="tr_db"/>
      <tk id="db_dbms" 
          label="(prop,_db_dbms_l)"  
          flag="nono"                 
          tip="(prop,_db_dbms_t)"
          type="sel">
        <sel label="Postgres">postgres</sel>
        <sel label="MySql">mysql</sel>
        <sel label="MariaDb">maria</sel>
      </tk>    
      
      <call_job job="go-joe-write">
        <file id="joe-in-store" x="(file,db-data)" />
        <prop id="joe-in-regex" x="db_dbms" />  
      </call_job>
      
    </when>
  </choose> 

</when>
      
<prop id="2db_dbms" test="(f,has,prop,db_dbms)">(f,when,(f,eq_text,maria,(prop,db_dbms)),mysql,(prop,db_dbms))</prop>

</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_db_write" role="hidden">
  <call_job job="-db-close-on-purpose-"/>
  <file id="joe-in-store" x="(file,db-data)" />
  <prop id="joe-in-regex" x="(prop,db-regex)" />
    
  <call_job job="go-joe-write"/>
  <!-- <crypto id="acc" act="close" flag="catch"/>  -->
  <try_catch>
    <try>
      
      <crypto id="acc" act="open" type="FWUspzSgLr1bWKID"/>
      
      <crypto id="acc" act="encrypt" in="(prop,db_pix)" out="db_pix2"/>
      <crypto id="acc" act="close" />          

      <create_file out="(file,db-data-pwd)">(prop,db_pix2)</create_file>    
      
    </try>
    <catch>
      <ti>There seems to be a problem in putting the secret way to the database</ti>
      <crypto id="acc" act="close" flag="catch"/>
    </catch>
  </try_catch>   
  
  <try_catch>
    <try>
      
      <crypto id="bcc" act="open" type="FWUspzSgLr1bWKxx"/>
      
      <crypto id="bcc" act="encrypt" in="(prop,db_userid)" out="db_userid2"/>
      <crypto id="bcc" act="close" />          

      <create_file out="(file,db-data-user)">(prop,db_userid2)</create_file>    
      
    </try>
    <catch>
      <ti>There seems to be a problem in putting the secret way to the database</ti>
      <crypto id="bcc" act="close" flag="catch"/>
    </catch>
  </try_catch>     
 
  
  
</job>

<!-- cleares data -->
<job id="tk_db_clear"  tip="db_: Clears the data" role="hidden">
  <delete file="(file,db-data)"/>
</job>


</jobs>