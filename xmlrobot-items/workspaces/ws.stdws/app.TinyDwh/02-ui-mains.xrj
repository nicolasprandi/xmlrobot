<?xml version="1.0" ?>
<jobs>
<call_job job="prolog"/>

<job id="???">
  <call_job job="??"/>
</job>
<job id="flex-info" role="hidden">

      <choose>
      
        <when test="(f,and,(f,right,mymenu),(f,exists_file,(dir,pro)myhome.xml))">
          <try_catch>
            <try>              
              <prop id="turbo-antes">(f,interpreter,turbo)</prop>
              <interpreter turbo="0"/>
              <include file="(dir,pro)myhome.xml"  /> 
              <interpreter turbo="(prop,turbo-antes)"/>            
            </try>
            <catch>
              <ti label="Problem with myhome.xml"/>
              <ti label="Error:">(prop,catched_msg)</ti>
              <ti label="File" type="file">(dir,pro)myhome.xml</ti>
            </catch>
          </try_catch>
        
        </when>
        <!-- xxtest="(f,and,(f,right,explain),(f,right,int))" -->
        <when test="(f,role,test2)" >
          <call_job job="_configurations"/>
        </when>
        <otherwise>
          <!-- <ti_hr/> -->
          <ti label="(prop,_pl_dso)"/>
          <call_job job="_objects"/>        
        </otherwise>
      
      </choose>
      
</job>
<job id="??" role="hidden">

<choose>
  <when test="(f,has,dir,pro)">
  <file id="firsttimer">(dir,pro)cache/introduced</file>

  <choose>
    <when test="(f,exists_file,(file,firsttimer))">
       
       
       <try_catch>
       <try>
          
        <call_job job="flex-info"/>     
        
       </try>
       <catch id="dbproblem">
        <call_job job="tr_setup"/>
        <call_job job="tr_fail"/>
        <ti_hr/>
        <ti label="(prop,_fail_dbproblem_l)"/>
        <ti>(prop,_fail_dbproblem_t)</ti>
        <when test="(f,or,(f,right,install),(prop,bpRepo),(prop,bpDb))">
          <ti label="(prop,_fail_solution_l)" />
          <ti label="(prop,_ex_setup_fail_connect_l)" type="call_job" job="guided-setup-simple" explain="(prop,_ex_setup_fail_connect)"
              test="(f,or,(prop,bpRepo),(prop,bpDb))"/>
          <ti label="(prop,_ex_setup_fail_setup_l)" type="call_job" job="guided-setup" explain="(prop,_ex_setup_fail_setup)" 
              test="(f,right,install)"/>  
        </when>
        <ti_hr/>
        <ti label="(prop,_fail_msg_was_l)"/>
        <ti>(prop,catched_msg)</ti> 
       </catch>
       <catch>
        <ti>Object-overview did not work out</ti>
        <ti>(prop,catched_msg)</ti>
       </catch>
       </try_catch>
           
    </when>
    <otherwise>
      <create_file file="(file,firsttimer)">hello</create_file>
      <call_job job="tr_setup" />
      <!-- <ti align="right">(prop,_ex_setups_continue)</ti>  -->
      <call_job job="sys_project_setup"/>
      
      <call_job job="flex-info"/>

    </otherwise>
  </choose>

  </when>
  <otherwise>
    <call_job job="?"/>
  </otherwise>
  </choose>


       
</job>

<job id="_objects" role="hidden">
  <throw test="(f,gt_num,(f,time,yyyyMMdd),30000101)">Out of service is this great app</throw>
  
  <call_job job="tk_limit_read"/>
  <call_job job="tk_nav_read" test="0" />
  
  <call_job job="tk_lingua_read" test="0" />

  <!-- header (prop,nav_keys) <dump_ti/>-->
  
  <call_job job="-db-open-"/>
  
  <prop id="my-select">()
  select
   anzahl,
   obj_typ
  from 
    r_o;()</prop>
        
  <prop id="found-at-least-one-type" x="0"/>
  
  <spirit act="open" id="objectsr" xml="(dir,repo)objects.xml"/>
  <ti_break class_table="tabLinklistSmall" />
  <when test="(prop,nav_keys)">  
    <ti type="rec" key="type" label=" ">
      <ti> </ti>
      <ti> </ti> 
    </ti>
  </when>
  
  <loop id="typ"  xmissing_strategy="empty" select="(prop,my-select)"  flag="trim" dbc="(prop,mydbc)">
    <prop id="found-at-least-one-type" x="1"/>                                     

    <prop id="oplural">Type: (loop,typ,@obj_typ)</prop>
    <prop id="oplural" flag="catch">(f,spirit,objectsr,ot[@tp=(f,xpath_string,(loop,typ,@obj_typ))],@np)</prop> 
    
    <prop id="oname">Type: (loop,typ,@obj_typ)</prop>
    <prop id="oname" flag="catch">(f,spirit,objectsr,ot[@tp=(f,xpath_string,(loop,typ,@obj_typ))],@(prop,tip-term-class))</prop> 
    
    <choose>
      <when test="(prop,nav_keys)">  
        <prop id="key-element">(loop,typ,@obj_typ)</prop>
      </when>
      <otherwise>                                                
        <prop id="key-element"></prop>
      </otherwise>
    </choose>
    
    <ti label="(prop,oname)" type="rec" key="(prop,key-element)">
    
      <ti align="left">[ (f,format,(loop,typ,@anzahl),(e:s)##0,de) ]</ti>
      
      <ti type="call_job" job="Type-Of-Object" explain="(f,format,(loop,typ,@anzahl),(e:s)##0,de) x (prop,oplural)">
        
        <prop id="on-obj-typ" x="(loop,typ,@obj_typ)"/>
        <prop id="on-obj-name-plural" x="(prop,oplural)"/>
      </ti>    
    </ti>       

  </loop>  

  <spirit act="close" id="objectsr" />
  <call_job job="-db-close-"/>    
  <choose>
    <when test="(f,not,(prop,found-at-least-one-type))">
      <call_job job="tr_fail"/>
      <ti>(prop,_fail_no_objects_l)</ti>
    </when>
    <otherwise>
     <choose>
        <when test="(f,eq_text,(prop,ling),de)">
          <!-- d=deutsch -->
          <prop id="_search_by_id">Suche nach Objekt per Id</prop>
        </when>
        <otherwise>
          <prop id="_search_by_id">Search for Object by Id</prop>
        </otherwise>
      </choose>    
      <ti_space height="5px" />
      
      <ti_break class_table="tabNavigator" />          
      <ti_hr xtest="(f,right,clear)"/>
      <ti type="rec">

             
        <ti explain="(prop,_search_by_id)"
            type="call_job"
            job="_object_by_id"
            xtest="(f,right,clear)"
            align="right"
            flag="button" class="fx fxEdit fxEditDetail fxEditDetailConf fxEditDetailConfNav"/>
      </ti>
    </otherwise>
  </choose>

   
   
</job>



<job id="_testdata" role="hidden">
  <throw test="(f,not,(f,role,expert2))">Diese Funktion ist mit diesen Privilegien nicht moeglich. admin requested.</throw>

  <choose>
    <when test="(f,exists_file,(dir,ghome)last-books/testdata_last.txt)">
                                                             
      <file id="dsis">(dir,goTestdata)(f,file_content,(dir,ghome)last-books/testdata_last.txt)/testdata-list.xml</file>
      
      <when test="(f,not,(f,exists_file,(file,dsis)))">
        <create_file out="(file,dsis)">&lt;testdata/&gt;</create_file>
        <i>Created: (file,dsis)</i>
      </when> 
      
      <call_job job="dsi-see-all"/>  
            
    </when>
    <otherwise>                                                  
      <call_job job="mm-tester-testdata" />
    </otherwise>
  </choose>  
</job>


<job id="_list_of_object_types" role="hidden">
  <call_job job="on-objekte"/>
  
</job>

<job id="_object_by_id" role="hidden">
  
  <call_job job="tk_surf_edit"/>
  <prop id="on-id" x="(prop,surf_id)"/>
  <call_job job="Object"/>
</job>

<job id="_bulk" role="hidden">
  <throw test="(f,not,(f,role,expert))">Diese Funktion ist mit diesen Privilegien nicht moeglich. role expert</throw>
  <choose>

    <when test="(f,exists_file,(dir,ghome)last-books/bulks_last.txt)">>
                                                             
      <file id="bulks">(dir,goMoon)bulks/(f,file_content,(dir,ghome)last-books/bulks_last.txt)/bulks-list.xml</file>
      
      <when test="(f,not,(f,exists_file,(file,bulks)))">
        <create_file out="(file,bulks)">&lt;bulks/&gt;</create_file>
        <i>Created: (file,bulks)</i>
      </when> 
      
      <call_job job="bulk-see-all"/>
            
    </when>
    <otherwise>                          
      <call_job job="mm-tester-bulks" />                        

    </otherwise>
  </choose>
    
  <!-- 
  <ti_hr_break/>
  <call_job job="mm-tester-squeries"/>     -->
                                       
</job>

<job id="_select" role="hidden">
  <throw test="(f,not,(f,role,expert))">Diese Funktion ist mit diesen Privilegien nicht moeglich. bpMat</throw>
  <choose>
    <when test="(f,exists_file,(dir,ghome)last-books/queries_last.txt)">
                                                             
      <file id="squerys">(dir,goMoon)queries/(f,file_content,(dir,ghome)last-books/queries_last.txt)/queries-list.xml</file>
      
      <when test="(f,not,(f,exists_file,(file,squerys)))">
        <create_file out="(file,squerys)">&lt;squerys/&gt;</create_file>
        <i>Created: (file,squerys)</i>
      </when> 
      
      <call_job job="squery-see-all"/>
            
    </when>
    <otherwise>                          
      <call_job job="mm-tester-squeries" />                        

    </otherwise>
  </choose>
    
  <!-- 
  <ti_hr_break/>
  <call_job job="mm-tester-squeries"/>     -->
                                       
</job>

<job id="_connect" role="hidden">


  <choose>
    <when test="(f,exists_file,(dir,ghome)last-books/compos_last.txt)">
                                                             
      <file id="hints">(dir,goCompos)(f,file_content,(dir,ghome)last-books/compos_last.txt)/compos-list.xml</file>
      
      <when test="(f,not,(f,exists_file,(file,hints)))">
        <create_file out="(file,dsis)">&lt;compos/&gt;</create_file>
        <i>Created: (file,hints)</i>
      </when> 
      
      <call_job job="hint-see-all"/>  
            
    </when>
    <otherwise>                                                  
      <call_job job="mm-tester-hints" />
    </otherwise>
  </choose>  
</job>

<job id="_credits" role="hidden" class_menu="amConfig">


  <choose>
    <when test="(f,exists_file,(dir,ghome)last-books/dbcis_last.txt)">
      
                                                             
      <file id="dbcis">(dir,goCredit)(f,file_content,(dir,ghome)last-books/dbcis_last.txt)/dbcis-list.xml</file>
   
      
      <when test="(f,not,(f,exists_file,(file,dbcis)))">
        <create_file out="(file,dbcis)">&lt;dbcis/&gt;</create_file>
        <i>Created: (file,dbcis)</i>
      </when> 
      
      <call_job job="dbci-see-all"/>  
            
    </when>
    <otherwise>                                                  
      <call_job job="mm-tester-dbcis" />
    </otherwise>
  </choose>  
</job>

<job id="_load_data" role="hidden">
  <throw test="(f,not,(f,right,load))">Diese Funktion ist mit diesen Privilegien nicht moeglich. right load</throw>
  <call_job job="my-etl-jobs" />
  <call_job job="etl-jobs"/>
                                       
</job>

<job id="_integrate" role="hidden">
  <throw test="(f,not,(f,right,int))">Diese Funktion ist mit diesen Privilegien nicht moeglich. bpInt</throw>
  <call_job job="do-the-integration">
  </call_job>
                                       
</job>



<!-- <tx_style ti_border="0" />   <interpreter jovial="1" /> -->

</jobs>
