<jobs>

<!--

-->
<call_job job="prolog"/>


<!-- gui Adapters: to copy in the app .... -->

<job id="See Values: kitch_" role="hidden">
  <call_job job="tk_kitch_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_kitch_clear" explain="Clear this data"/>  
</job>         

<job id="Kitchen Conf" role="hidden">
  <call_job job="tk_kitch_edit"/>      
  <call_job job="did-edit-a-conf" />
</job>

<job id="Kitchen Conf?">
  <ti_break class_table="tabNavigator"/>

  <ti type="rec">
    <ti type="call_job" job="_configurations" explain="(prop,_x_go_back_sys)" flag="button " class="justback"
        align="right" />
  </ti>  
     
  <ti_break/>
  
  <when test="(f,has,prop,pro)">
    <call_job job="tk_kitch_print_values" test="(f,has,prop,pro)"/>
     <ti_hr/>
     
    <ti type="menu" first_cell="2">
      <ti type="call_job" job="Kitchen Conf" explain="(prop,_x_edit)" 
          flag="button" class="fb fbEdit"/>
  
      <ti type="call_job" job="tk_kitch_print_values_tips" 
          flag="button xbutton" class="fb fbAskAsk" explain="(prop,_label_askask)"/>    
    </ti>
         
    
  </when>

</job>

<!-- 
 <job id="Clear Data: kitch_">
  <tk type="msg" x="Sure to clear data of kitch_ ?" msg_type="w"/>
  <call_job job="tk_kitch_clear"/>
</job>

<job id="Print Values:  kitch_">
  <call_job job="tk_kitch_print_values"/>
</job>
<job id="Print Help: kitch_" role="dev">
  <call_job job="tk_kitch_print_help"/>
</job>

-->

<!-- setting the default-values -->
<job id="tk_kitch_default" role="hidden">

</job>


<!-- kitch-core, make your changes here -->
<job id="tk_kitch_core" role="hidden" tip="kitch_: Tk Internal">

  <need default="">(prop,tk_kitch_add_flag)</need>
  <call_job job="tr_kitch"/>
  
  <tk label="(f,when,(f,has_flag,(prop,tk_kitch_add_flag),print_tips_only),(prop,_kitch_l_desc),(prop,_kitch_l))" 
      flag="(prop,tk_kitch_add_flag)"
      tip="(prop,_kitch_t)"
      tk_id="24"> 

    <tk id="kitch_bat"
        type="file"  
      	label="(prop,_kitch_bat_l)" 
        flagx="nono"          
        tip="(prop,_kitch_bat_t)"/> 
        
    <tk id="kitch_logs" 
        type="dir" 
        label="(prop,_kitch_logs_l)"  
        flag="nono"                 
        tip="(prop,_kitch_logs_t)"/>         
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_kitch_edit" tip="kitch_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,kitch-data))">
      <!-- data exists already -->
      <prop id="tk_kitch_add_flag" x="sum_only print"/>
      <call_job job="tk_kitch_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_kitch_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_kitch_default"/>
  <!-- doing input -->
  <call_job job="tk_kitch_core"/>
  
  <!-- writing data -->
  <call_job job="tk_kitch_write"/>

</job>



<job id="tk_kitch_print_values" tip="kitch_: Prints the entered values" role="hidden">
  
  <call_job job="tk_kitch_read"/>
  
  <call_job job="tk_kitch_core">
    <prop id="tk_kitch_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_kitch_print_values_tips" tip="kitch_: Prints values and tips" role="hidden">
  
  <call_job job="tk_kitch_read"/>
  
  <call_job job="tk_kitch_core">
    <prop id="tk_kitch_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  
    <ti_hr/>  
    <ti type="rec" label=" " > 
      <ti type="call_job" job="Kitchen Conf" explain="(prop,_x_edit)" flag="button" class="fx fxEdit fxEditDetail fxEditDetailConf" label=" "/>
      <ti> </ti>

    </ti>  
  
</job>

<job id="tk_kitch_print_help" tip="kitch_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_kitch_core">
    <prop id="tk_kitch_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_kitch_read" role="hidden">

  <call_job job="go-joe-read">
    <prop id="joe-in-regex" x="(prop,kitch-regex)" />
    <file id="joe-in-store" x="(file,kitch-data)" />
  </call_job>

  <call_job job="tk_kitch_default"/>
  
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_kitch_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,kitch-data)" />
    <prop id="joe-in-regex" x="(prop,kitch-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_kitch_clear"  tip="kitch_: Clears the data" role="hidden">
  <delete file="(file,kitch-data)"/>
</job>


</jobs>