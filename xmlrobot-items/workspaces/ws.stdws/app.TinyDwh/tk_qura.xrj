<jobs>

<call_job job="prolog" />



<!-- setting the default-values -->
<job id="tk_qura_default" role="hidden">
  <!--
  <need default="regex">(prop,qura_type)</need>
  <need default="(dir,filetemp)">(dir,qura_dir)</need>
  -->
  <need default="c">(prop,qura_typus)</need>
  <need default="0">(prop,qura_meta)</need>
  <need default="1">(prop,qura_print)</need>
  <need default="0">(prop,qura_edit)</need> 
  <need default="keep">(prop,qura_limit_style)</need>  
  
   
</job>


<!-- qura-core, make your changes here -->
<job id="tk_qura_core" role="hidden" tip="qura_: Tk Internal">

  <need default="">(prop,tk_qura_add_flag)</need>
  <call_job job="tr_qura"/>
  
  <choose>
    <when test="(f,right,xlsx)">
      <prop id="qura-selektor">sel-export-xlsx.xml</prop>
    </when>
    
    <when test="(f,right,xls)">
      <prop id="qura-selektor">sel-export-xls.xml</prop>
    </when>    
    
    <otherwise>
       <prop id="qura-selektor">sel-export-plain.xml</prop>
    </otherwise>
  
  </choose>
  
   

  <tk label="(prop,_qura_tk_l)"                       
      flag="(prop,tk_qura_add_flag)"
      tip="(prop,_qura_tk_t)"
      tk_id="30"> 

    <tk id="qura_typus"
        type="sel"  
        label="(prop,_qura_l_typus)" 
        test_first="1"     
        flag="nono"   
        tip="(prop,_qura_t_typus)" xml="(dir,app)(prop,qura-selektor)"> 
    </tk>
    
    <tk type="msg"
        x="(prop,_qura_l_xml)"
        test_first="0"/>  
                
    <tk id="qura_xml_root"  test_first="0" label="(prop,_qura_root_label)" tip="(prop,_qura_root_tip)" cols="30"/>    
    
    <tk id="qura_xml_row"  test_first="0" label="(prop,_qura_row_label)" tip="(prop,_qura_row_tip)" cols="30"/>     
                
    <tk type="msg"
        x="(prop,_qura_l_limit_msg)"
        test_first="0"/>   
        
    <tk id="qura_limit_style"
        type="sel"
        label="(prop,_qura_l_limit_style)" 
        test_first="0"        
        cols="10"
        tip="(prop,_qura_t_limit_style)"
        flag="nono">
        
        <!-- <sel label="(prop,_qura_s_limit_style_config1): (prop,sql_limit_queries) (prop,_qura_s_limit_style_config2)">config</sel>      -->
        <sel label="(prop,_qura_s_limit_style_keep)">keep</sel>
        <sel label="(prop,_qura_s_limit_style_no)">no</sel>
        <sel label="(prop,_qura_s_limit_style_indiv) ...">indiv</sel>                
    </tk>            
                    
    <tk id="qura_limit"
        type="text"
      	label="(prop,_qura_l_limit)"     
        tip="(prop,_qura_t_limit)" 
        cols="10"
        test_first="0" 	
      	regex="()(\d+)()"   />

    <tk type="msg"
        x="(prop,_qura_l_process)"
        test_first="0"/>     
           
    <tk id="qura_meta"
        type="bool"
        label="(prop,_qura_l_meta)"       
      	test_first="0"
        flag="no_is_0 nono"     
        tip="(prop,_qura_t_meta)"
        />              
    <tk id="qura_edit"
        type="bool"
        label="(prop,_qura_l_edit)"       
      	test_first="0"     
        flag="nono"
        tip="(prop,_qura_t_edit)"
        />             
        
    <tk id="qura_print"
        type="bool"
        label="(prop,_qura_l_print)"       
      	test_first="0"   
        flag="nono"  
        tip="(prop,_qura_t_print)"
        />    
        
    <tk id="qura_copy"
        type="file"  
      	label="(prop,_qura_l_copy)" 
        flag="save"
        test_first="0"        
        tip="(prop,_qura_t_copy)"/>           
                  
       
                          
  </tk>   
</job>
<!-- 
<job id="See Values: qura_" role="dev">
  <call_job job="tk_qura_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_qura_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: qura_">
  <tk type="msg" x="Sure to clear data of qura_ ?" msg_type="w"/>
  <call_job job="tk_qura_clear"/>
</job>

<job id="Print Values:  qura_">
  <call_job job="tk_qura_print_values"/>
</job>
<job id="Print Help: qura_" role="dev">
  <call_job job="tk_qura_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_qura_edit" tip="qura_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,qura-data))">
      <!-- data exists already -->
      <prop id="tk_qura_add_flag" x="sum_only print"/>
      <call_job job="tk_qura_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_qura_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_qura_default"/>
  <!-- doing input -->
  <call_job job="tk_qura_core"/>
  
  <!-- writing data -->
  <call_job job="tk_qura_write"/>

</job>



<job id="tk_qura_print_values" tip="qura_: Prints the entered values" role="hidden">
  
  <call_job job="tk_qura_read"/>
  
  <call_job job="tk_qura_core">
    <prop id="tk_qura_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_qura_print_values_tips" tip="qura_: Prints values and tips" role="hidden">
  
  <call_job job="tk_qura_read"/>
  
  <call_job job="tk_qura_core">
    <prop id="tk_qura_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_qura_print_help" tip="qura_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_qura_core">
    <prop id="tk_qura_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_qura_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,qura-data)" />
    <prop id="joe-in-regex" x="(prop,qura-regex)" />    
  </call_job>
  <call_job job="tk_qura_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_qura_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,qura-data)" />
    <prop id="joe-in-regex" x="(prop,qura-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_qura_clear"  tip="qura_: Clears the data" role="hidden">
  <delete file="(file,qura-data)"/>
</job>


</jobs>