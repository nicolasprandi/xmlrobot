<need>(prop,spalte_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="spalte-read" />
<prop id="isAdd">0</prop>
<call_job job="spalte-editor" />
<call_job job="spalte-write" />
<ti align="right" x="Did update Spalte '(f,text,cut_nice,(prop,spalte_name),20)'" />
<call_job job="spalte-see" />
</job><job role="hidden" id="spalte-del">
<need>(prop,spalte_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="spalte-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Spalte [ (f,text,cut_nice,(prop,spalte_name),20) (prop,spalten_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,spalten)" where="(prop,spalten_offset)spalte[@row='(prop,spalte_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,spalte_name),20) #(prop,spalte_key)</tp>
<ti label="Did delete Spalte:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,spalte_name),20)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="spalte-see-all" />
</job><job role="hidden" id="spalte-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Spalte(prop,spalten_offset_label)" />
<prop x="sum" id="spalten_tk_control" />
</when>
<otherwise>
<need>(prop,spalte_key)</need>
<prop id="label" x="Spalte [(f,text,cut_nice,(prop,spalte_name),20)](prop,spalten_offset_label)" />
<prop x="sum_only" id="spalten_tk_control" />
</otherwise>
</choose>
<call_job job="spalte-tk" />
</job><job id="spalte-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="spalte-editor" />
<prop id="spalte_key">1</prop>
<when test="(f,not,(f,exists,prop,spalten_offset_new_key))">
<prop id="spalten_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,spalten)" sort="@row" number="@row" xpath="(prop,spalten_offset_new_key)spalte">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="spalte_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Spalte: #(prop,spalte_key)</i>
<call_job job="spalte-write" />
<ti align="right" x="Did add Spalte '(f,text,cut_nice,(prop,spalte_name),20)'" />
<choose>
<when test="(f,has,prop,post_add_script_spalte)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_spalte)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="spalte-see" />
</otherwise>
</choose>
</job><job role="hidden" id="spalte-write">
<need>(prop,spalte_key) (prop,isAdd)</need>
<spirit act="open" id="spalten_spirit_tc" xml="(file,spalten)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,spalten_offset),/)">
<prop id="offset2" x="(f,substring,(prop,spalten_offset),0,(f,sub,(f,len,(prop,spalten_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,spalten_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="spalten_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;spalte row="(prop,spalte_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="spalten_spirit_tc" where="(prop,spalten_offset)spalte[@row='(prop,spalte_key)']" attribute="name" value="(f,vob,prop,spalte_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="spalten_spirit_tc" where="(prop,spalten_offset)spalte[@row='(prop,spalte_key)']" attribute="expr" value="(f,vob,prop,spalte_expr)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="spalten_spirit_tc" where="(prop,spalten_offset)spalte[@row='(prop,spalte_key)']" attribute="desc" value="(f,vob,prop,spalte_desc)" />
<spirit act="close" flag="save pretty" id="spalten_spirit_tc" />
</job></jobs>
