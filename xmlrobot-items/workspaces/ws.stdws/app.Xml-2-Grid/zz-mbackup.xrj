<!-- setting the default-values -->
<job id="tk_mback_default" role="hidden">

</job>


<!-- mback-core, make your changes here -->
<job id="tk_mback_core" role="hidden" tip="mback_: Tk Internal">

  <need default="">(prop,tk_mback_add_flag)</need>

  <tk label="Parameters: Backup" 
      flag="(prop,tk_mback_add_flag)"
      tip="()Directory which will contain the Project-Backups.()"> 

    <tk id="mback_dir" 
        type="dir" 
        label="Target-Directory"  
        flag="nono"                 
        tipx="()Directory which will contain the Project-Backups.()"/>
  
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_mback_edit" tip="mback_: Edit the Data" role="hidden">

  <!-- preparing -->
  <file id="mback-data" x="(dir,pro)mback-data.xrs"/>
  <prop id="mback-regex" x="mback_.+"/>
    
  <choose>
    <when test="(f,exists_file,(file,mback-data))">
      <!-- data exists already -->
      <prop id="tk_mback_add_flag" x="sum_only print"/>
      <call_job job="tk_mback_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_mback_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_mback_default"/>
  <!-- doing input -->
  <call_job job="tk_mback_core"/>
  
  <!-- writing data -->
  <call_job job="tk_mback_write"/>

</job>



<job id="tk_mback_print_values" tip="mback_: Prints the entered values" role="hidden">
  
  <call_job job="tk_mback_read"/>
  
  <call_job job="tk_mback_core">
    <prop id="tk_mback_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_mback_print_values_tips" tip="mback_: Prints values and tips" role="hidden">
  
  <call_job job="tk_mback_read"/>
  
  <call_job job="tk_mback_core">
    <prop id="tk_mback_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_mback_print_help" tip="mback_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_mback_core">
    <prop id="tk_mback_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_mback_read" role="hidden">
  <file id="mback-data" x="(dir,pro)mback-data.xrs"/>
  <prop id="mback-regex" x="mback_.+"/>
  
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,mback-data)" />
    <prop id="joe-in-regex" x="(prop,mback-regex)" /> 
  </call_job>
  <call_job job="tk_mback_default"/>
  
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_mback_write" role="hidden">
  <file id="mback-data" x="(dir,pro)mback-data.xrs"/>
  <prop id="mback-regex" x="mback_.+"/>
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,mback-data)" />
    <prop id="joe-in-regex" x="(prop,mback-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_mback_clear"  tip="mback_: Clears the data" role="hidden">
  <delete file="(file,mback-data)"/>
</job>
</jobs>