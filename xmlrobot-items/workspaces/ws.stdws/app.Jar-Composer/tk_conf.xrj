<jobs>
<call_job job="prolog" />


<!-- conf-core, make your changes here -->
<job id="tk_conf_core" role="hidden" tip="conf_: Tk Internal">

  <need default="">(prop,tk_conf_add_flag)</need>

  <tk label="Parameters: Jar-Composer" 
      flag="(prop,tk_conf_add_flag)"
      xtip="()Search Parameters is a list of values which will control the search-routine.()"> 
    <tk type="msg" x="Input"/>
    <tk id="conf_jars" 
        type="dir" 
        label="Dir with Jars"                   
        tip="()A directory with jar-files.()"/>
        
    <tk id="conf_classes" 
        type="dir" 
        label="Dir with Classes"                  
        tip="()A directory with class-files.()"/>    
    <tk id="conf_sources" 
        type="dir" 
        label="Dir with Sources"                 
        tip="()A directory with source-files.()"/>     
        
    <tk id="conf_overlay" 
        type="dir" 
        label="Dir with Jar-Overlay"                 
        tip="()This dir will be copied on top of the jar-file.()"/>                  
     
    <tk type="msg" x="Output"/>    
        
    <tk id="conf_result"
        type="file"  
      	label="Result jar" 
        flag="save force_extension"
        extension=".jar"
        test_first="0"        
        tip="()This file will be written()"/> 
        
    <tk id="conf_result"
        type="dir"  
      	label="Result Dir/jar" 
        flag="save"
        test_first="0"        
        tip="()This folder will be written()"/>
        
    <tk type="msg" x="Separated output"/>   
    <tk id="conf_sep_3rd"
        type="file"  
      	label="3rd Party Jar" 
        extension="jar"
        flag="save"
        test_first="0"        
        tip="()This folder will be written()"/> 
        
    <tk id="conf_sep_my"
      extension="jar"
        type="file"  
      	label="Developed Jar" 
        flag="save"
        test_first="0"        
        tip="()This folder will be written()"/>                              
