<jobs>

<!--

-->
<call_job job="prolog" />


<!-- gui Adapters: to copy in the app .... -->




<!-- 
 <job id="Clear Data: refl_">
  <tk type="msg" x="Sure to clear data of refl_ ?" msg_type="w"/>
  <call_job job="tk_refl_clear"/>
</job>

<job id="Print Values:  refl_">
  <call_job job="tk_refl_print_values"/>
</job>
<job id="Print Help: refl_" role="dev">
  <call_job job="tk_refl_print_help"/>
</job>

-->

<!-- setting the default-values -->
<job id="tk_refl_default" role="hidden">
   <need default="0">(prop,refl_also_jars)</need>
</job>


<!-- refl-core, make your changes here -->
<job id="tk_refl_core" role="hidden" tip="refl_: Tk Internal">

  <need default="">(prop,tk_refl_add_flag)</need>

  <tk label="GH-Reflection" 
      flag="(prop,tk_refl_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 

    <tk id="refl_dir" 
        type="dir" 
        label="Java-Item-dir"  
        flag="nono"                 
        tip="()The directory of the specific java-item in the repo: repo/java-items/grp.xy/THIS-ONE()"/>

    <tk id="refl_also_jars"
        type="bool"
        label="Reflect also jars"       
      	test_first="0"
        flag="no_is_0"/> 
        
    <!--    
    <tk id="refl_file_read"
        type="file"  
      	label="File to read" 
        flag="nono"          
        tip="()This file will be read()"/> 
        
    <tk id="refl_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
    <tk id="refl_type"
        type="sel"  
        label="Selection 1" 
        x="text"
        test_first="0"        
        tip="()text versus regular expression; text will search for exaclty that defined search text, regex will apply the regular-expression syntax to search for a piece of text in the files()">
        <sel label="Text">text</sel>
        <sel label="Regular Expression">regex</sel>    
    </tk>            
         
    <tk id="refl_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="refl_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="refl_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="refl_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="refl_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,refl-sel2)"/>
        
    <tk 
      id="refl_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="refl_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="refl_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="refl_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="refl_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="refl_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_refl_edit" tip="refl_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,refl-data))">
      <!-- data exists already -->
      <prop id="tk_refl_add_flag" x="sum_only print"/>
      <call_job job="tk_refl_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_refl_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_refl_default"/>
  <!-- doing input -->
  <call_job job="tk_refl_core"/>
  
  <!-- writing data -->
  <call_job job="tk_refl_write"/>

</job>



<job id="tk_refl_print_values" tip="refl_: Prints the entered values" role="hidden">
  
  <call_job job="tk_refl_read"/>
  
  <call_job job="tk_refl_core">
    <prop id="tk_refl_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_refl_print_values_tips" tip="refl_: Prints values and tips" role="hidden">
  
  <call_job job="tk_refl_read"/>
  
  <call_job job="tk_refl_core">
    <prop id="tk_refl_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_refl_print_help" tip="refl_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_refl_core">
    <prop id="tk_refl_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_refl_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,refl-data)" />
    <prop id="joe-in-regex" x="(prop,refl-regex)" />
  </call_job>
  <call_job job="tk_refl_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_refl_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,refl-data)" />
    <prop id="joe-in-regex" x="(prop,refl-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_refl_clear"  tip="refl_: Clears the data" role="hidden">
  <delete file="(file,refl-data)"/>
</job>


</jobs>