<?xml version="1.0" ?>

<jobs>

<job id="prolog" role="hidden">

<prop id="ant" x="1"/>

<when test="(f,has,prop,pro)">
  <file id="conf-data" x="(dir,pro)conf-data.xrs"/>
  <prop id="conf-regex" x="conf_.+"/>
  
  <file id="refl-data" x="(dir,pro)refl-data.xrs"/>
  <prop id="refl-regex" x="refl_.+"/>  
  
  <dir id="imported_jars" x="(dir,pro)imported-jars"/>
  <mkdir dir="(dir,imported_jars)"/>
  
  <dir id="mt" x="(dir,pro)jar-result-content"/>
  <mkdir dir="(dir,mt)"/>  
</when>
</job>

