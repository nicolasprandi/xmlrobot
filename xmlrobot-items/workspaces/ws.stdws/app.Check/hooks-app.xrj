<?xml version="1.0" ?>

<jobs>
<call_job job="prolog"/>

<job id="hook-action-app-dbcommand" role="hidden">
   
  <need>(prop,app_key)</need>
  
  
  
  <spirit id="cn" act="open" xml="(file,apps)"/>
  
   
  <prop id="cur-app-appid">(f,spirit,cn,//app[@row=(f,xpath_string,(prop,app_key))],@appid)</prop>
  <ti>Working with (prop,cur-app-appid)</ti>
  <spirit id="cn" act="close" />
  <call_job job="tk_dbapp_edit"/>
  
  <call_job job="tk_conf_read"/>
  
  <file id="out" x="(dir,pro)app-command.sql"/>   
  <xslt xml="(file,apps)" xsl="(dir,app)dbapp.xsl" out="(file,out)">
    <params>app_key='(f,xslp,(prop,app_key))' request='(f,xslp,(prop,dbapp_request))' appid='(f,xslp,(prop,cur-app-appid))' conf_db='(f,xslp,(prop,conf_db))' postgres_schema='(f,xslp,(prop,conf_postgres_schema))'</params>
  </xslt>    
  
  <prop id="xxx">(f,file_content,(file,out))</prop>
  <delete file="(file,out)"/>
  <tk type="textblock" id="xxx" flag="big" label="Result" tip="This is the result of your requests: (prop,dbapp_request)"/>
  <remove type="prop" id="xxx"/>
   
   <call_job job="app-see-all" />
</job>

<job id="hook-app-view-begin" role="hidden">

  <ti label="List of Appliations"/>

</job>

<job id="hook-app-details-end" role="hidden">
   <ti_hr/>
   <ti label=" " type="call_job" job="app-see-all" explain="See all Applications"/>
</job>



<job id="hook-app-view-end" role="hidden">
   
   <ti type="rec">
   <ti/><ti/>
   <ti label="Ready:" type="call_job" job="hook-gen-app-selector" explain="&gt;&gt; Update App-Selector for Gui"/>
   </ti>
</job>

<job id="hook-gen-app-selector" role="hidden">

      <!-- 
      <file id="appask" x="(dir,pro)psi-ask.xml"/>
      <ask what="apps" out="(file,appask)" style="natural"/>
      <ti type="file">(file,appask)</ti>
      -->
      <xslt 
          xml="(file,apps)" 
          out="(dir,pro)app-selector-gui.xml">
                    <inline attribute="xsl"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet 
  version="1.0" 
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml"/>

<xsl:template match="/">
  <sels>
   <xsl:apply-templates select="//apps/app"/>
  </sels>
</xsl:template>

<xsl:template match="app">
   <sel><xsl:value-of select="@appid"/></sel>
</xsl:template>

</xsl:stylesheet>
  ]]></inline>       
      </xslt>
      <ti type="file" label="did update" x="(dir,pro)app-selector-gui.xml"/>
      
      <ti_hr/>
      <call_job job="??" />
</job>





