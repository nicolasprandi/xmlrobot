<!-- edit data: read, userinput, write -->
<job id="tk_dbuser_edit" tip="dbuser_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,dbuser-data))">
      <!-- data exists already -->
      <prop id="tk_dbuser_add_flag" x=" sum print"/>
      <call_job job="tk_dbuser_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_dbuser_add_flag" x=" sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_dbuser_default"/>
  <!-- doing input -->
  <call_job job="tk_dbuser_core"/>
  
  <!-- writing data -->
  <call_job job="tk_dbuser_write"/>

</job>



<job id="tk_dbuser_print_values" tip="dbuser_: Prints the entered values" role="hidden">
  
  <call_job job="tk_dbuser_read"/>
  
  <call_job job="tk_dbuser_core">
    <prop id="tk_dbuser_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_dbuser_print_values_tips" tip="dbuser_: Prints values and tips" role="hidden">
  
  <call_job job="tk_dbuser_read"/>
  
  <call_job job="tk_dbuser_core">
    <prop id="tk_dbuser_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_dbuser_print_help" tip="dbuser_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_dbuser_core">
    <prop id="tk_dbuser_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_dbuser_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,dbuser-data)" />
    <prop id="joe-in-regex" x="(prop,dbuser-regex)" />    
  </call_job>
  <call_job job="tk_dbuser_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_dbuser_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,dbuser-data)" />
    <prop id="joe-in-regex" x="(prop,dbuser-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_dbuser_clear"  tip="dbuser_: Clears the data" role="hidden">
  <delete file="(file,dbuser-data)"/>
</job>


</jobs>