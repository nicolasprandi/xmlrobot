<!-- setting the default-values -->
<job id="tk_dbuser_default" role="hidden">
  <!--
  <need default="regex">(prop,dbuser_type)</need>
  <need default="(dir,filetemp)">(dir,dbuser_dir)</need>
  -->
   <need default="app db">(prop,dbuser_tables)</need>
  
</job>


<!-- dbuser-core, make your changes here -->
<job id="tk_dbuser_core" role="hidden" tip="dbuser_: Tk Internal">

  <need default="">(prop,tk_dbuser_add_flag)</need>

  <tk label="Database Command for (f,vob,prop,cur-user)" 
      flag="(prop,tk_dbuser_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 

    <tk id="dbuser_request"
        type="sel"  
        label="What to do" 
        flag="multi"
        test_first="1"        
        tip="()Things to genearte. this goes for() (f,upper,(f,vob,prop,cur-user)) - yes - (f,upper,(f,vob,prop,cur-user))">
        <sel xlabel="That">select</sel>          
        <sel xlabel="Text">delete</sel>
        <sel xlabel="Regex">insert</sel> 
        <sel xlabel="This">update</sel>
        <sel xlabel="Ther" test="0">insupd</sel>
 
    </tk>
    
    <tk id="dbuser_tables"
        type="sel"  
        label="Table Selection" 
        flag="multi"
        test_first="1"        
        tip="()Table Commonads to generate. this goes for() (f,upper,(f,vob,prop,cur-user)) - yes - (f,upper,(f,vob,prop,cur-user))">
        <sel label="Application">app</sel>         
        <sel label="Database if granted">db</sel>


    </tk>    
