        tip="This is about the stones"/>         
        
    <tk id="secret_sun"
        type="bool"
        label="Sun Boolean"       
      	test_first="0"
        flag="no_is_0"     
        tip="()()"
        />         
        
    <tk type="msg"
        x="Files and Folders"
        test_first="0"/>   
                     
    <tk id="secret_cat"
        type="sel"
        flag="multi"  
        label="Categories" 
        test_first="0"        
        tip="()Explain secret_cat here ...()">
        <sel>sand</sel>
        <sel>land</sel>
        <sel>band</sel>
        <sel>hand</sel>                  
    </tk>    
    <tk id="secret_dir" 
        type="dir" 
        label="Directory"  
        flagx="nono"                 
        tip="()A directory which serves as intial directory for the file-search.()"
        test_first="0"/>
        
    <tk id="secret_file_read"
        type="file"  
      	label="File to read" 
        xflag="nono"          
        tip="()This file will be read()"
        test_first="0"/>         
       

        
    <tk id="secret_file_write"
        type="file"  
