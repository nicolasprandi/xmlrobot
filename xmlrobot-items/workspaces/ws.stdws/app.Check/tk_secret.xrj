<!-- setting the default-values -->
<job id="tk_secret_default" role="hidden">
  <!--
  <need default="regex">(prop,secret_type)</need>
  <need default="(dir,filetemp)">(dir,secret_dir)</need>
  -->
</job>


<!-- secret-core, make your changes here -->
<job id="tk_secret_core" role="hidden" tip="secret_: Tk Internal">

  <need default="">(prop,tk_secret_add_flag)</need>

  <tk label="Parameters: secret_" 
      flag="(prop,tk_secret_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 


    

        
    <tk id="secret_codico1" 
        label="Passwort Encryptor in MySqlDb"
        flag="password"
        xtest_first="0"
        tip="()()" />
        
    <tk id="secret_codico2" 
        label="Passwort Encryptor in MySqlDb"
        flag="password"
        xtest_first="0"
        tip="()()" />        
