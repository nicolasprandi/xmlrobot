<!-- edit data: read, userinput, write -->
<job id="tk_secret_edit" tip="secret_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,secret-data))">
      <!-- data exists already -->
      <prop id="tk_secret_add_flag" x="sum_only"/>
      <call_job job="tk_secret_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_secret_add_flag" x="sum"/>
    </otherwise>
  </choose>
  <call_job job="tk_secret_default"/>
  <!-- doing input -->
  <call_job job="tk_secret_core"/>
  
  <!-- writing data -->
  <call_job job="tk_secret_write"/>

</job>



<job id="tk_secret_print_values" tip="secret_: Prints the entered values" role="hidden">
  
  <call_job job="tk_secret_read"/>
  
  <call_job job="tk_secret_core">
    <prop id="tk_secret_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_secret_print_values_tips" tip="secret_: Prints values and tips" role="hidden">
  
  <call_job job="tk_secret_read"/>
  
  <call_job job="tk_secret_core">
    <prop id="tk_secret_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_secret_print_help" tip="secret_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_secret_core">
    <prop id="tk_secret_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_secret_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,secret-data)" />
    <prop id="joe-in-regex" x="(prop,secret-regex)" />    
  </call_job>
  <call_job job="tk_secret_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_secret_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,secret-data)" />
    <prop id="joe-in-regex" x="(prop,secret-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_secret_clear"  tip="secret_: Clears the data" role="hidden">
  <delete file="(file,secret-data)"/>
</job>


</jobs>