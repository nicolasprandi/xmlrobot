<?xml version="1.0" ?>

<jobs>
<call_job job="prolog"/>
<job id="??" role="hidden">
<call_job job="CryptoManger"/>
</job>
<job id="CryptoManger" role="public">

      

      <choose>
        <when test="(f,exists_file,(file,cob-data))">
          <call_job job="tk_cob_print_values"/>
                <ti type="call_job" job="dbci-enter" explain="(f,html,b,o)Edit Coop-Info(f,html,b,c)" label=" ">
         
      </ti>  
        </when>
        <otherwise>
          <!-- no data exists -->
          <ti label="CryptoManger"/>
          <ti>No Crypto-Coop-Info </ti>
      <ti type="call_job" job="dbci-enter" explain="(f,html,b,o)Enter(f,html,b,c) Encryption Object">
         
      </ti>            
        </otherwise>
      </choose>
    
      <ti_hr/>      
      
      <ti type="call_job" job="dbci-encryption-on" explain="(f,html,b,o)Start(f,html,b,c) Encryption Object">
         
      </ti>
 
       <ti type="call_job" job="dbci-exists" explain="(f,html,b,o)Exists ?(f,html,b,c)">
         
      </ti>   
      

       <ti type="call_job" job="dbci-encryption-off" explain="(f,html,b,o)Stop(f,html,b,c) Encryption Object">
          
      </ti>           
      <ti_hr/>    
      
       <ti type="call_job" job="dbci-do-encrypt" explain="(f,html,b,o)Do(f,html,b,c) Encrypt">
          
      </ti>    
      
       <ti type="call_job" job="dbci-do-decrypt" explain="(f,html,b,o)Do(f,html,b,c) Decrypt">
          
      </ti>        
       <ti type="call_job" job="dbci-encryption-test" explain="(f,html,b,o)Do(f,html,b,c) Encryption-Decryption">
         
      </ti>          
      <ti_hr/>      
      
            
      <ti type="call_job" xflag="button block"   xclass="fb fbEdit xjustgui justswitch"                       
          job="conf-swap-pk"  explain="(f,when,(f,exists_file,(dir,pro)pk.txt),Turn Passwords On,Turn Passwords Off)">
      </ti>       
        
    
</job>

<job id="conf-swap-pk"  role="hidden">

  <choose>
    <when test="(f,exists_file,(dir,pro)pk.txt)">
      <delete file="(dir,pro)pk.txt"/>
    </when>
    <otherwise>
      <create_file out="(dir,pro)pk.txt">pk</create_file>
    </otherwise>
  </choose>
  <call_job job="CryptoManger"/>
</job>

<job id="dbci-enter" role="hidden">
  <call_job job="tk_cob_edit" />
  <call_job job="event_dbci_postmortem"/>
</job>

<job id="dbci-encryption-on" role="hidden">
  <ti label="Doing: Start"/>
  <call_job job="tk_cob_read" />

  <tk label="Turn Encryptor on" flag="sum">
  
    <tk id="pw1" label="Pwd" cols="30" flag="nono password(prop,pk)" tip="This is the secret key with which the given text is encrypted/decrypted"/>
    <tk id="pw2" label="Pwd-Again" cols="30"  flag="nono password(prop,pk)" tip="This is the secret key with which the given text is encrypted/decrypted once again"/>
  </tk>
  <throw test="(f,not,(f,eq_text,(prop,pw1),(prop,pw2)))">Passwords differs</throw>  
  <crypto id="(prop,cob_id)" id_app="(prop,cob_id_app)" act="open" type="(prop,pw1)" only="(f,vob,prop,cob_only)"/>
  <ti>did turn encryptor on</ti>
  <call_job job="event_dbci_postmortem"/>
</job>
<job id="dbci-encryption-off" role="hidden">
<ti label="Doing: Stop"/>
<call_job job="tk_cob_read" />
  <crypto id="(prop,cob_id)" act="close" id_app="(prop,cob_id_app)" />

  <ti>did turn encryptor off</ti>
  <call_job job="event_dbci_postmortem"/>
</job>


<job id="dbci-do-encrypt" role="hidden">
  <call_job job="tk_cob_read" />
  <tk id="toencrypt" flag="nono"/>
  <crypto id="(prop,cob_id)" act="encrypt" in="(prop,toencrypt)" out="result1"  id_app="(prop,cob_id_app)"/>
  <ti label="Result">(prop,result1)</ti>
  <call_job job="event_dbci_postmortem"/>
</job>

<job id="dbci-do-decrypt" role="hidden">
  <call_job job="tk_cob_read" />
  <tk id="todecrypt" flag="nono"/>
  <crypto id="(prop,cob_id)" act="decrypt" in="(prop,todecrypt)" out="result1"  id_app="(prop,cob_id_app)"/>
  <ti label="Result">(prop,result1)</ti>
  <call_job job="event_dbci_postmortem"/>
</job>

<job id="dbci-exists" role="hidden">
<call_job job="tk_cob_read" />
<ti label="Doing: Éxists?"/>
<ti label="exists=">(f,exists,coop2,_cry,(prop,cob_id),(prop,cob_id_app))</ti>
<call_job job="event_dbci_postmortem"/>
</job>

<job id="dbci-encryption-test" role="hidden">
  <call_job job="tk_cob_read" />
 <ti label="Doing: Encryption-Decryption"/>
  <ti>object existence is: (f,exists,coop2,_cry,(prop,cob_id),(prop,cob_id_app))</ti>
  <tk id="toencrypt" flag="nono"/>
  
  <crypto id="(prop,cob_id)" act="encrypt" in="(prop,toencrypt)" out="result1"  id_app="(prop,cob_id_app)"/>
  <ti>Is performing encryption</ti>
  <ti label="input">(prop,toencrypt)</ti>
  <ti label="encrypted">(prop,result1)</ti>
  <crypto id="(prop,cob_id)" act="decrypt" in="(prop,result1)" out="result2"  id_app="(prop,cob_id_app)"/>
  <ti label="again decrypted">(prop,result2)</ti>
  <choose>
    <when test="(f,eq_text,(prop,toencrypt),(prop,result2))">
      <ti>Encryption-Decrytion test was sucessfull</ti>
    </when>
    <otherwise>
      <ti>Seems not to be working correctly !!</ti>
    </otherwise>
  </choose>
  
 
  <call_job job="event_dbci_postmortem"/>
</job>



<job id="event_dbci_postmortem" role="hidden">
<ti_hr_break/>
<call_job job="CryptoManger"/>
</job>

