<!-- setting the default-values -->
<job id="tk_cob_default" role="hidden">
  <!--
  <need default="regex">(prop,cob_type)</need>
  <need default="(dir,filetemp)">(dir,cob_dir)</need>
  
  -->
  <need default="validate" test="(f,not,(f,exists_file,(file,cob-data)))">(prop,cob_only)</need>
</job>


<!-- cob-core, make your changes here -->
<job id="tk_cob_core" role="hidden" tip="cob_: Tk Internal">

  <need default="">(prop,tk_cob_add_flag)</need>

  <tk label="Cryptography-Object" 
      flag="(prop,tk_cob_add_flag)"
      tk_id="0"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 


    <tk id="cob_id"
        label="CoopId"  
        flag="nono"            
        cols="30" 
        tip="()()" /> 
        
    <tk id="cob_id_app"
        label="App - a"        
        cols="30"         
        tip="()()" />       
        
    <tk id="cob_only"
        label="Only"  
        type="sel"    
        flag="multi"        
        tip="()()" >
        <sel>encrypt</sel>
        <sel>decrypt</sel>
        <sel>validate</sel>
    </tk>           
 
                          
  </tk>   
</job>
