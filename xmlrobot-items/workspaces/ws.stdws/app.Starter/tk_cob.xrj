  <ti type="call_job" job="tk_cob_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: cob_">
  <tk type="msg" x="Sure to clear data of cob_ ?" msg_type="w"/>
  <call_job job="tk_cob_clear"/>
</job>

<job id="Print Values:  cob_">
  <call_job job="tk_cob_print_values"/>
</job>
<job id="Print Help: cob_" role="dev">
  <call_job job="tk_cob_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_cob_edit" tip="cob_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,cob-data))">
      <!-- data exists already -->
      <prop id="tk_cob_add_flag" x="sum_only "/>
      <call_job job="tk_cob_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_cob_add_flag" x="sum "/>
    </otherwise>
  </choose>
  <call_job job="tk_cob_default"/>
  <!-- doing input -->
  <call_job job="tk_cob_core"/>
  
  <!-- writing data -->
  <call_job job="tk_cob_write"/>

</job>



<job id="tk_cob_print_values" tip="cob_: Prints the entered values" role="hidden">
  
  <call_job job="tk_cob_read"/>
  
  <call_job job="tk_cob_core">
    <prop id="tk_cob_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_cob_print_values_tips" tip="cob_: Prints values and tips" role="hidden">
  
  <call_job job="tk_cob_read"/>
  
  <call_job job="tk_cob_core">
    <prop id="tk_cob_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_cob_print_help" tip="cob_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_cob_core">
    <prop id="tk_cob_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_cob_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,cob-data)" />
    <prop id="joe-in-regex" x="(prop,cob-regex)" />    
  </call_job>
  <call_job job="tk_cob_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_cob_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,cob-data)" />
    <prop id="joe-in-regex" x="(prop,cob-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_cob_clear"  tip="cob_: Clears the data" role="hidden">
  <delete file="(file,cob-data)"/>
</job>


</jobs>