<jobs>

<call_job job="prolog" />

<!-- <when test="(f,has,prop,pro)"> take 2 things to the prolog --> 
  <!-- 

  -->
<!-- </when>       -->

<!-- gui Adapters: to copy in the app  take the edit to your gui.... -->





<!-- setting the default-values -->
<job id="tk_calc_default" role="hidden">
 
  <need default="">(prop,calc_x)</need>
  <need default="">(prop,calc_y)</need>
  <need default="">(prop,calc_z)</need> 
</job>


<!-- calc-core, make your changes here -->
<job id="tk_calc_core" role="hidden" tip="calc_: Tk Internal">

  <need default="">(prop,tk_calc_add_flag)</need>

  <tk label="Volume Calculation" 
      flag="(prop,tk_calc_add_flag)"
      tip="()Demonstration of a calculation.()"> 

        
    <tk id="calc_x" 
        label="x"
        tip="()()"
        flag="nono" />
        
    <tk id="calc_y" 
        label="y"
        tip="()()"
        flag="nono" />
        
    <tk id="calc_z" 
        label="z"
        tip="()()"
        flag="nono" />                
 
                          
  </tk>   
</job>
