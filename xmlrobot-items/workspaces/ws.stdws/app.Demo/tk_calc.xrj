<!-- edit data: read, userinput, write -->
<job id="tk_calc_edit" tip="calc_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,calc-data))">
      <!-- data exists already -->
      <prop id="tk_calc_add_flag" x="sum_only print"/>
      <call_job job="tk_calc_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_calc_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_calc_default"/>
  <!-- doing input -->
  <call_job job="tk_calc_core"/>
  
  <!-- writing data -->
  <call_job job="tk_calc_write"/>

</job>



<job id="tk_calc_print_values" tip="calc_: Prints the entered values" role="hidden">
  
  <call_job job="tk_calc_read"/>
  
  <call_job job="tk_calc_core">
    <prop id="tk_calc_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_calc_print_values_tips" tip="calc_: Prints values and tips" role="hidden">
  
  <call_job job="tk_calc_read"/>
  
  <call_job job="tk_calc_core">
    <prop id="tk_calc_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_calc_print_help" tip="calc_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_calc_core">
    <prop id="tk_calc_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_calc_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,calc-data)" />
    <prop id="joe-in-regex" x="(prop,calc-regex)" />    
  </call_job>
  <call_job job="tk_calc_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_calc_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,calc-data)" />
    <prop id="joe-in-regex" x="(prop,calc-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_calc_clear"  tip="calc_: Clears the data" role="hidden">
  <delete file="(file,calc-data)"/>
</job>


</jobs>