<job id="Calculate">
  <call_job job="tk_calc_edit"/>
  
  <prop id="v">(f,mul,(prop,calc_x),(prop,calc_y),(prop,calc_z))</prop>
  <ti_hr style="2" />
  <ti label="Volume:">(prop,v)</ti>
</job>

