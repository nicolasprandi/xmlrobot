<jobs>

<call_job job="prolog" />
<!-- gui Adapters: to copy in the app  take the edit to your gui.... -->

<!-- setting the default-values -->
<job id="tk_filepd_default" role="hidden">
  <!--
  <need default="regex">(prop,filepd_type)</need>
  <need default="(dir,filetemp)">(dir,filepd_dir)</need>
  -->
</job>


<!-- filepd-core, make your changes here -->
<job id="tk_filepd_core" role="hidden" tip="filepd_: Tk Internal">

  <need default="">(prop,tk_filepd_add_flag)</need>

  <tk label="Parameters: Files with pdname" 
      flag="(prop,tk_filepd_add_flag)"
      tip="()These app-files will be ignored in production, so the will be deleted and not appear in the result()"> 
      
    <tk id="filepd_include" 
        type="sel" 
        label="App-Files to Include"
        test_first="1"                  
        tip="In these app-files the [[ pdname ]] will be replaced by the real product name."
        flag="multi" 
        xml="(file,file-selector-ignore)"/>          

                          
  </tk>   
</job>
<!-- 
<job id="See Values: filepd_" role="dev">
  <call_job job="tk_filepd_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_filepd_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: filepd_">
  <tk type="msg" x="Sure to clear data of filepd_ ?" msg_type="w"/>
  <call_job job="tk_filepd_clear"/>
</job>

<job id="Print Values:  filepd_">
  <call_job job="tk_filepd_print_values"/>
</job>
<job id="Print Help: filepd_" role="dev">
  <call_job job="tk_filepd_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_filepd_edit" tip="filepd_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,filepd-data))">
      <!-- data exists already -->
      <prop id="tk_filepd_add_flag" x="sum_only print"/>
      <call_job job="tk_filepd_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_filepd_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_filepd_default"/>
  <!-- doing input -->
  <call_job job="tk_filepd_core"/>
  
  <!-- writing data -->
  <call_job job="tk_filepd_write"/>

</job>



<job id="tk_filepd_print_values" tip="filepd_: Prints the entered values" role="hidden">
  
  <call_job job="tk_filepd_read"/>
  
  <call_job job="tk_filepd_core">
    <prop id="tk_filepd_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_filepd_print_values_tips" tip="filepd_: Prints values and tips" role="hidden">
  
  <call_job job="tk_filepd_read"/>
  
  <call_job job="tk_filepd_core">
    <prop id="tk_filepd_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_filepd_print_help" tip="filepd_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_filepd_core">
    <prop id="tk_filepd_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_filepd_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,filepd-data)" />
    <prop id="joe-in-regex" x="(prop,filepd-regex)" />    
  </call_job>
  <call_job job="tk_filepd_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_filepd_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,filepd-data)" />
    <prop id="joe-in-regex" x="(prop,filepd-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_filepd_clear"  tip="filepd_: Clears the data" role="hidden">
  <delete file="(file,filepd-data)"/>
</job>


</jobs>