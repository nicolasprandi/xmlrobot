<?xml version="1.0" ?>

<jobs>
<call_job job="prolog" />

<job id="see-full-list" role="hidden">
	<ti type="rec">
    <ti>Off</ti>
    <ti>Bit</ti>
    <ti>File</ti>
    <ti>How</ti>
    <ti span="3">Where</ti>
    <ti>With</ti>
  </ti>
  <spirit act="open" id="md" xml="(file,updater)" missing_strategy="empty"/>
  
  <loop_xml 
    act="open" 
    id="bits" 
    spirit="md" 
    xpath="bit" sort="@bit" number="@bit" missing_strategy="empty"/>
    
  <loop 
    id="while-bits" 
    while="()(f,loop_xml,bits,has_next?)()">
    <loop_xml act="next" id="bits" />  
    <ti label="(f,when,(f,loop_xml,bits,exists?,@off),(f,when,(f,try,()(f,loop_xml,bits,@off)(),0,0),Off,),) " type="rec">
       <ti explain="__(f,loop_xml,bits,@bit)__" type="call_job" job="bit-see" span="3">
        <prop id="show-navi" x="0"/>
        <file id="bits">(file,updater)</file>                                
        <prop id="bits_offset">./</prop>
        <prop id="bits_offset_label">Bit (f,loop_xml,bits,@bit)</prop>
        <prop id="bits_offset_new_key">//</prop>
        <prop id="bits_sort_attribute"></prop>
        <prop id="bits_sort_number"></prop>
        <prop id="bits_where"></prop>
        <prop id="bits_return_job">yyy</prop>
        <prop id="bit_key">(f,loop_xml,bits,@row)</prop> 
        <call_job job="bit-read"/>   
         
       </ti>
       
  
       <ti></ti>
       <ti></ti>
       <ti></ti>
       <ti></ti> 
       <ti explain="Edit" type="call_job" job="my-bit-edit">
        <prop id="bits_return_job" x="see-full-list"/>
        <prop id="bit_key">(f,loop_xml,bits,@row)</prop>    
        <file id="bits">(file,updater)</file>
        <prop id="bits_offset">./</prop> 
       </ti>  
           

    </ti>
    
      
    <loop_xml 
      act="open" 
      id="files" 
      spirit="md" 
      xpath="bit[@row=(f,loop_xml,bits,@row)]/file" missing_strategy="empty"/>
      
    <loop 
      id="while-files" 
      while="()(f,loop_xml,files,has_next?)()">
      <loop_xml act="next" id="files" />  
      <ti type="rec" label="(f,when,(f,loop_xml,files,exists?,@off),(f,when,(f,try,()(f,loop_xml,files,@off)(),0,0),Off,),) ">
        <ti></ti>
        <ti explain="(f,loop_xml,files,@thefile)" type="call_job" job="file-see">
          <prop id="show-navi" x="0"/>
          <file id="bits">(file,updater)</file>                                
          <prop id="bits_offset">./</prop>
          <prop id="bits_offset_label">Bit (f,loop_xml,bits,@bit)</prop>
          <prop id="bit_bit" x=""/>
          <prop id="bits_offset_new_key">//</prop>
          <prop id="bits_sort_attribute"></prop>
          <prop id="bits_sort_number"></prop>
          <prop id="bits_where"></prop>
          <prop id="bits_return_job">yyy</prop>
          <prop id="bit_key">(f,loop_xml,bits,@row)</prop> 
                    
          <prop id="file_key">(f,loop_xml,files,@row)</prop>
          <file id="files">(file,updater)</file>
          <prop id="files_offset">bit[@row=(f,xpath_string,(f,loop_xml,bits,@row))]/</prop>
          <prop id="files_offset_label">offset label file</prop>
          <prop id="files_offset_new_key">//</prop>
          <prop id="files_sort_attribute"></prop>
          <prop id="files_sort_number"></prop>
          <prop id="files_where"></prop>
          <prop id="files_return_job">file-see</prop>   
          <call_job job="file-read"/>    
                  
        </ti> 

       <ti></ti>
       <ti></ti>         
       <ti></ti>
       <ti></ti>       
       <ti></ti>  
       
       <ti   explain="Edit" type="call_job" job="my-file-edit">
        <prop id="files_return_job" x="see-full-list"/>
        <prop id="files_offset">bit[@row=(f,xpath_string,(f,loop_xml,bits,@row))]/</prop>
        <prop id="file_key">(f,loop_xml,files,@row)</prop>
        <file id="files">(file,updater)</file>    
         
       </ti>   
              
       
        <ti></ti>

      </ti>
      
      <loop_xml 
        act="open" 
        id="modos" 
        spirit="md" 
        xpath="bit[@row=(f,loop_xml,bits,@row)]/file[@row=(f,loop_xml,files,@row)]/modo" missing_strategy="empty"
        xxsort="@sort" xxnumber="@sort"/>
        
      <loop 
        id="while-modos" 
        while="()(f,loop_xml,modos,has_next?)()">
        <loop_xml act="next" id="modos" />  
        <ti type="rec" label="(f,when,(f,loop_xml,modos,exists?,@off),(f,when,(f,try,()(f,loop_xml,modos,@off)(),0,0),Off,),) ">
          <ti></ti>
          <ti></ti>
          
          <ti explain="(f,loop_xml,modos,@how)" type="call_job" job="modo-see">
            <prop id="show-navi" x="0"/>
            <file id="bits">(file,updater)</file>                                
            <prop id="bits_offset">./</prop>
            <prop id="bits_offset_label">Bit (f,loop_xml,bits,@bit)</prop>
            <prop id="bit_bit" x=""/>
            <prop id="bits_offset_new_key">//</prop>
            <prop id="bits_sort_attribute"></prop>
            <prop id="bits_sort_number"></prop>
            <prop id="bits_where"></prop>
            <prop id="bits_return_job">yyy</prop>
            <prop id="bit_key">(f,loop_xml,bits,@row)</prop> 
                      
            <prop id="file_key">(f,loop_xml,files,@row)</prop>
            <file id="files">(file,updater)</file>
            <prop id="files_offset">bit[@row=(f,xpath_string,(f,loop_xml,bits,@row))]/</prop>
            <prop id="files_offset_label">offset label file</prop>
            <prop id="files_offset_new_key">//</prop>
            <prop id="files_sort_attribute"></prop>
            <prop id="files_sort_number"></prop>
            <prop id="files_where"></prop>
            <prop id="files_return_job">zzz</prop>  
            
            <prop id="modo_key">(f,loop_xml,modos,@row)</prop>
            <file id="modos">(file,updater)</file>
            <prop id="modos_offset">bit[@row=(f,xpath_string,(f,loop_xml,bits,@row))]/file[@row=(f,xpath_string,(f,loop_xml,files,@row))]/</prop>
            <prop id="modos_offset_label">offset label modo</prop>
            <prop id="modos_offset_new_key">//</prop>
            <prop id="modos_sort_attribute"></prop>
            <prop id="modos_sort_number"></prop>
            <prop id="modos_where"></prop>
            <prop id="modos_return_job">modo-see-all</prop>               
            <call_job job="modo-read"/>    
                    
          </ti> 
 
         <ti flag="wrap" span="3">(f,loop_xml,modos,@where)</ti>  
         <ti flag="wrap" >(f,text,cut_nice,(f,loop_xml,modos,@with),200)</ti> 
         
         <ti explain="Edit" type="call_job" job="my-modo-edit">
          <prop id="modo_return_job" x="see-full-list"/>
          <prop id="modos_offset">bit[@row=(f,xpath_string,(f,loop_xml,bits,@row))]/file[@row=(f,xpath_string,(f,loop_xml,files,@row))]/</prop>
          <prop id="modo_key">(f,loop_xml,modos,@row)</prop>
          <file id="modos">(file,updater)</file>    
           
         </ti> 
                          
  
          
             
  
        </ti>
      </loop>
      
      <loop_xml act="close" id="modos" />            
    </loop>
    
    <loop_xml act="close" id="files" />      
  </loop>
  
  <loop_xml act="close" id="bits" />
      
  <spirit act="close" id="md" />
  <ti_break/>
</job>

<job id="my-modo-edit" role="hidden">
  <try_catch>
    <try>
      <prop id="show-navi" x="0"/>
      <call_job job="modo-edit"/>
    </try>
    <catch>
      <call_job job="see-full-list"/>
    </catch>
  </try_catch>
</job>

<job id="my-bit-edit" role="hidden">
  <try_catch>
    <try>
      <prop id="show-navi" x="0"/>
      <call_job job="bit-edit"/>
    </try>
    <catch>
      <call_job job="see-full-list"/>
    </catch>
  </try_catch>
</job>

<job id="my-file-edit" role="hidden">
  <try_catch>
    <try>
      <prop id="show-navi" x="0"/>
      <call_job job="file-edit"/>
    </try>
    <catch>
      <call_job job="see-full-list"/>
    </catch>
  </try_catch>
</job>

<job id="hook_end_of_bit_details" role="hidden">            
  <need default="1">(prop,show-navi)</need>  
  <when test="(prop,show-navi)"> 

    <ti_hr/>
    <ti type="call_job" explain="Go up and see all bits ..." job="bit-see-all" alixgn="right"/>  
  </when>

</job>

<job id="hook_end_of_file_details_navi" role="hidden">
  <need default="1">(prop,show-navi)</need> 
  <!-- <prop id="the-row" x="(loop,i,@row)"/>  -->
  <when test="(prop,show-navi)"> 
    <ti_hr/> 

      <ti type="call_job" explain="Go up and see all files of this bit ..." job="bit-see" xalign="right">
      
        <file id="bits">(file,bits)</file>
        <prop id="bits_offset">(prop,bits_offset)</prop>
        <prop id="bits_offset_label">(prop,bits_offset_label)</prop>
        <prop id="bits_offset_new_key">(prop,bits_offset_new_key)</prop>
        <prop id="bits_sort_attribute">(prop,bits_sort_attribute)</prop>
        <prop id="bits_sort_number">(prop,bits_sort_number)</prop>
        <prop id="bits_where">(prop,bits_where)</prop>
        <prop id="bits_return_job">(prop,bits_return_job)</prop>
        <prop id="bit_key">(prop,bit_key)</prop>
      </ti> 
  
  </when>

</job>

<job id="hook_end_of_file2_details_navi" role="hidden">

   <ti_hr/>  
 <ti type="call_job" explain="Go up ..." job="file2-see-all" align="right">
        <prop id="file2_key">(prop,file2_key)</prop>
        <file id="files2">(file,files2)</file>
        <prop id="files2_offset">(prop,files2_offset)</prop>
        <prop id="files2_offset_label">(prop,files2_offset_label)</prop>
        <prop id="files2_offset_new_key">(prop,files2_offset_new_key)</prop>
        <prop id="files2_sort_attribute">(prop,files2_sort_attribute)</prop>
        <prop id="files2_sort_number">(prop,files2_sort_number)</prop>
        <prop id="files2_where">(prop,files2_where)</prop>
        <prop id="files2_return_job">(prop,files2_return_job)</prop> 
        <prop id="files2_sort_ignore_case">(prop,files2_sort_ignore_case)</prop>
        <prop id="files2_sort_desc">(prop,files2_sort_desc)</prop>
       
 </ti>
                             
</job>

<job id="hook_end_of_modo_details" role="hidden">
  <need default="1">(prop,show-navi)</need>  
  <!-- <prop id="the-row" x="(loop,i,@row)"/>  -->
  <when test="(prop,show-navi)"> 
    <ti_hr/>  

      <ti type="call_job" explain="Go up and see all modifications of this file ..." job="file-see" axlign="right">
        <prop id="file_key">(prop,file_key)</prop>
        <file id="files">(file,files)</file>
        <prop id="files_offset">(prop,files_offset)</prop>
        <prop id="files_offset_label">(prop,files_offset_label)</prop>
        <prop id="files_offset_new_key">(prop,files_offset_new_key)</prop>
        <prop id="files_sort_attribute">(prop,files_sort_attribute)</prop>
        <prop id="files_sort_number">(prop,files_sort_number)</prop>
        <prop id="files_where">(prop,files_where)</prop>
        <prop id="files_return_job">(prop,files_return_job)</prop>
        <file id="bits">(file,bits)</file>
        <prop id="bits_offset">(prop,bits_offset)</prop>
        <prop id="bits_offset_label">(prop,bits_offset_label)</prop>
        <prop id="bits_offset_new_key">(prop,bits_offset_new_key)</prop>
        <prop id="bits_sort_attribute">(prop,bits_sort_attribute)</prop>
        <prop id="bits_sort_number">(prop,bits_sort_number)</prop>
        <prop id="bits_where">(prop,bits_where)</prop>
        <prop id="bits_return_job">(prop,bits_return_job)</prop>
        <prop id="bit_key">(prop,bit_key)</prop>
      </ti>  
 
    <!-- 
    <ti type="call_job" explain="Go up to bit ..." job="bit-see">
    
      <file id="bits">(file,bits)</file>
      <prop id="bits_offset">(prop,bits_offset)</prop>
      <prop id="bits_offset_label">(prop,bits_offset_label)</prop>
      <prop id="bits_offset_new_key">(prop,bits_offset_new_key)</prop>
      <prop id="bits_sort_attribute">(prop,bits_sort_attribute)</prop>
      <prop id="bits_sort_number">(prop,bits_sort_number)</prop>
      <prop id="bits_where">(prop,bits_where)</prop>
      <prop id="bits_return_job">(prop,bits_return_job)</prop>
      <prop id="bit_key">(prop,bit_key)</prop>
    </ti>  
    <ti type="call_job" explain="Go up to all ..." job="bit-see-all"/>
    -->
  </when>
</job>                                                            


<job id="hook_file2_view_begin" role="hidden">
  

  <ti label="(f,html,b,o)List of (f,when,(f,has,prop,label),(prop,label),Blurries)(f,html,b,c)" type="file">(file,files2)</ti>
  <ti_hr/>
</job> 
<job id="hook_begin_of_modo2_details" role="hidden">
<try_catch><try>
<ti label="File: (f,xpath,(file,files2),(f,substring,(prop,modos2_offset),0,(f,sub,(f,len,(prop,modos2_offset)),1)),@thefile)"/>
</try>
<catch>
  <ti>(prop,catched_msg)</ti>
</catch>
</try_catch>
 
  <!-- 
  <need default="1">(prop,show-navi)</need>  

  <when test="(prop,show-navi)"> 
    <ti_hr/>  

      <ti type="call_job" explain="Go up ..." job="file2-see" xalign="right">
        <prop id="file2_key">(prop,file2_key)</prop>
        <file id="files2">(file,files2)</file>
        <prop id="files2_offset">(prop,files2_offset)</prop>
        <prop id="files2_offset_label">(prop,files2_offset_label)</prop>
        <prop id="files2_offset_new_key">(prop,files2_offset_new_key)</prop>
        <prop id="files2_sort_attribute">(prop,files2_sort_attribute)</prop>
        <prop id="files2_sort_number">(prop,files2_sort_number)</prop>
        <prop id="files2_where">(prop,files2_where)</prop>
        <prop id="files2_return_job">(prop,files2_return_job)</prop>

      </ti>  
 

  </when>
  -->
</job>

<job id="hook_end_of_modo2_details" role="hidden">
  <need default="1">(prop,show-navi)</need>  
  <!-- <prop id="the-row" x="(loop,i,@row)"/>   -->
  <when test="(prop,show-navi)"> 
    <ti_hr/>  

      <try_catch><try>
      <ti type="call_job" explain="Go up ..." job="file2-see" xalign="right">
        <prop id="file2_key">(prop,file2_key)</prop>
        <file id="files2">(file,files2)</file>
        <prop id="files2_offset">(prop,files2_offset)</prop>
        <prop id="files2_offset_label">(prop,files2_offset_label)</prop>
        <prop id="files2_offset_new_key">(prop,files2_offset_new_key)</prop>
        <prop id="files2_sort_attribute">(prop,files2_sort_attribute)</prop>
        <prop id="files2_sort_number">(prop,files2_sort_number)</prop>
        <prop id="files2_where">(prop,files2_where)</prop>
        <prop id="files2_return_job">(prop,files2_return_job)</prop>
         <prop id="files2_sort_ignore_case">(prop,files2_sort_ignore_case)</prop>
        <prop id="files2_sort_desc">(prop,files2_sort_desc)</prop>
      </ti>  
      </try>
      <catch>
        <ti>(prop,catched_msg)</ti>
        <dump_ti/>
      </catch>
      </try_catch>
 

  </when>      
</job>
<job id="hook_bit_details_end" role="hidden">
  <!-- <dump_ti label="hook_bit_details_end"/>   -->
  <ti_hr xstyle="2" />
  
  <file id="files">(file,updater)</file>
  <prop id="files_offset">bit[@row=(prop,bit_key)]/</prop>

  <prop id="files_offset_label">Files to modify</prop>
  <!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
  <prop id="files_offset_new_key">//</prop>
  <!--sort_attribute defines the attributes to be used for the view-sort-->
  <prop id="files_sort_attribute"/>
  <!--the numeric attributes in the sort-->
  <prop id="files_sort_number"/>
  <!--the ignore-case attributes in the sort-->
  <prop id="files_sort_ignore_case"/>
  <!--the desc attributes in the sort-->
  <prop id="files_sort_desc"/>
  <!--a where claused, this is a post to the xpath-expression, use for several view-types-->
  <prop id="files_where"/>
  <!--return job to be called after changes (new,delete,edit)-->
  <prop id="files_return_job">bit-see</prop> 
  
   <call_job job="file-see-all" />  

</job>

<job id="hook_file_details_end" role="hidden">


  <!-- <dump_ti label="hook_bit_details_end"/>   -->
  <ti_hr xstyle="2" />
  <dump_ti label="hook_file_details_end" test="0"/>
  <file id="modos">(file,updater)</file>  
  <prop id="modos_offset">bit[@row=(prop,bit_key)]/file[@row=(prop,file_key)]/</prop>
  <prop id="modos_offset_label">Modifications</prop>
  
  
<!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
<prop id="modos_offset_new_key">//</prop>
<!--sort_attribute defines the attributes to be used for the view-sort-->
<prop id="modos_sort_attribute"></prop>
<!--the numeric attributes in the sort-->
<prop id="modos_sort_number"></prop>
<!--the ignore-case attributes in the sort-->
<prop id="modos_sort_ignore_case"/>
<!--the desc attributes in the sort-->
<prop id="modos_sort_desc"/>
<!--a where claused, this is a post to the xpath-expression, use for several view-types-->
<prop id="modos_where"/>
<!--return job to be called after changes (new,delete,edit)-->
<prop id="modos_return_job">file-see</prop>                 
  
<call_job job="modo-see-all"/>    
</job>  

<job id="hook_file2_details_end" role="hidden">


  <!-- <dump_ti label="hook_bit_details_end"/>   -->
  <ti_hr xstyle="2" />
  <dump_ti label="hook_file_details_end" test="0"/>
  <file id="modos2">(file,files2)</file>
  <prop id="modos2_offset">file2[@row=(prop,file2_key)]/</prop>
  <prop id="modos2_offset_label">Modifications</prop>
  
  
<!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
<prop id="modos2_offset_new_key">//</prop>
<!--sort_attribute defines the attributes to be used for the view-sort-->
<prop id="modos2_sort_attribute"></prop>
<!--the numeric attributes in the sort-->
<prop id="modos2_sort_number"></prop>
<!--the ignore-case attributes in the sort-->
<prop id="modos2_sort_ignore_case"/>
<!--the desc attributes in the sort-->
<prop id="modos2_sort_desc"/>
<!--a where claused, this is a post to the xpath-expression, use for several view-types-->
<prop id="modos2_where"/>
<!--return job to be called after changes (new,delete,edit)-->
<prop id="modos2_return_job">file2-see</prop>    

 
  

<call_job job="modo2-see-all"/>    
</job>  

<job id="hook_end_of_file_field" role="hidden">
  <when test="(f,eq_text,file_thefile,(prop,formix-field-locator-hook))">
    <call_job job="tk_appi_read"/>
    <ti label=" " type="file" x="(dir,appi_from_app)(prop,file_thefile)"/>  
  </when>
</job>

<job id="hook_bit_view_begin" role="hidden">
  <ti label="Bits"/>
</job>

