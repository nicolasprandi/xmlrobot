<?xml version="1.0" ?>

<jobs>

<job id="prolog" role="hidden">



<when test="(f,has,prop,pro)">  
  <file id="last_signature">(dir,pro)last_signature.xml</file>
  <prop id="last_signature-regex">modo_how|modo_where|modo_with|modo_with_what|modo_attribute|modo_value|modo_flag</prop>
  
  <file id="last_blurry">(dir,pro)last_signature.xml</file>
  <prop id="last_blurry-regex">modo2_prob|modo2_how|modo2_where|modo2_with|modo2_with_what|modo2_attribute|modo2_value|modo2_flag</prop>  
  
  <file id="track" x="(dir,pro)track.xml"/>
  <file id="track-html" x="(dir,pro)track.html"/>
  
  <file id="searches-app">(dir,app)quality-searches.xml</file>
  <file id="searches-pro">(dir,pro)quality-searches.xml</file>
  <prop id="searches_offset">./</prop>
  <prop id="searches_offset_label"/>
  <prop id="searches_offset_new_key">//</prop>
  <prop id="searches_sort_attribute"/>
  <prop id="searches_sort_number"/>
  <prop id="searches_sort_ignore_case"/>
  <prop id="searches_sort_desc"/>
  <prop id="searches_where"/>
  <prop id="searches_return_job">search-see-all</prop>

  <!-- 
  <dir id="doku" x="(dir,pro)doku"/>
  <mkdir dir="(dir,doku)"/>   -->
  <dir id="standard-production" x="(dir,pro)production"/>
  <mkdir dir="(dir,standard-production)"/>
  <dir id="mytemp" x="(dir,pro)temp"/>
  <mkdir dir="(dir,mytemp)"/>
  <file id="pro-selektor-dark" x="(dir,mytemp)pro-selektor-dark.xml"/>
  <file id="file-selector-any" x="(dir,mytemp)file-selector-any.xml"/>
  <file id="file-selector-xsl" x="(dir,mytemp)file-selector-xsl.xml"/>
  
  <file id="dir-selector-ignore" x="(dir,mytemp)dir-selector-ignore.xml"/>
  <file id="file-selector-ignore" x="(dir,mytemp)file-selector-ignore.xml"/>
  
  <file id="fileig-data" x="(dir,pro)fileig-data.xrs"/>
  <prop id="fileig-regex" x="fileig_.+"/>  
  
  
  <file id="filepd-data" x="(dir,pro)filepd-data.xrs"/>
  <prop id="filepd-regex" x="filepd_.+"/>    
 
  <file id="dirig-data" x="(dir,pro)dirig-data.xrs"/>
  <prop id="dirig-regex" x="dirig_.+"/>
    
  <file id="appi-data" x="(dir,pro)appi-data.xrs"/>
  <prop id="appi-regex" x="appi_.+"/>
  
  <file id="noxsl-data" x="(dir,pro)noxsl-data.xrs"/>
  <prop id="noxsl-regex" x="noxsl_.+"/>
  
  <file id="prod-data" x="(dir,pro)prod-data.xrs"/>
  <prop id="prod-regex" x="prod_.+"/>

  <file id="conf-data" x="(dir,pro)conf-data.xrs"/>
  <prop id="conf-regex" x="conf_.+"/>
        
  <file id="updater">(dir,pro)serial-nbr-spec.xml</file>
  <file id="bits">(file,updater)</file>
  <when test="(f,not,(f,exists_file,(file,bits)))">
  <create_file out="(file,bits)">&lt;bits/&gt;</create_file>
  <i>Created: (file,bits)</i>
  </when>
  <!--The offset defines a node in the xml-data-file under which all the data is found. use eg 'england' or 'country[id='england']-->
  <prop id="bits_offset">./</prop>
  <!--The offset label is communicated to the user, it verbalizes the offset-->
  <prop id="bits_offset_label"/>
  <!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
  <prop id="bits_offset_new_key">//</prop>
  <!--sort_attribute defines the attributes to be used for the view-sort-->
  <prop id="bits_sort_attribute"></prop>
  <!--the numeric attributes in the sort-->
  <prop id="bits_sort_number"></prop>
  <!--the ignore-case attributes in the sort-->
  <prop id="bits_sort_ignore_case"/>
  <!--the desc attributes in the sort-->
  <prop id="bits_sort_desc"/>
  <!--a where claused, this is a post to the xpath-expression, use for several view-types-->
  <prop id="bits_where"/>
  <!--return job to be called after changes (new,delete,edit)-->
  <prop id="bits_return_job">bit-see-all</prop>
  
  <file id="files">(dir,pro)files.xml</file>
  <when test="(f,not,(f,exists_file,(file,files)))">
  <create_file out="(file,files)">&lt;files/&gt;</create_file>
  <i>Created: (file,files)</i>
  </when>
  <!--The offset defines a node in the xml-data-file under which all the data is found. use eg 'england' or 'country[id='england']-->
  <prop id="files_offset">./</prop>
  <!--The offset label is communicated to the user, it verbalizes the offset-->
  <prop id="files_offset_label"/>
  <!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
  <prop id="files_offset_new_key">//</prop>
  <!--sort_attribute defines the attributes to be used for the view-sort-->
  <prop id="files_sort_attribute"/>
  <!--the numeric attributes in the sort-->
  <prop id="files_sort_number"/>
  <!--the ignore-case attributes in the sort-->
  <prop id="files_sort_ignore_case"/>
  <!--the desc attributes in the sort-->
  <prop id="files_sort_desc"/>
  <!--a where claused, this is a post to the xpath-expression, use for several view-types-->
  <prop id="files_where"/>
  <!--return job to be called after changes (new,delete,edit)-->
  <prop id="files_return_job">file-see-all</prop> 
  
<file id="modos">(dir,pro)modos.xml</file>
<when test="(f,not,(f,exists_file,(file,modos)))">
<create_file out="(file,modos)">&lt;modos/&gt;</create_file>
<i>Created: (file,modos)</i>
</when>
<!--The offset defines a node in the xml-data-file under which all the data is found. use eg 'england' or 'country[id='england']-->
<prop id="modos_offset">./</prop>
<!--The offset label is communicated to the user, it verbalizes the offset-->
<prop id="modos_offset_label"/>
<!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
<prop id="modos_offset_new_key">//</prop>
<!--sort_attribute defines the attributes to be used for the view-sort-->
<prop id="modos_sort_attribute"/>
<!--the numeric attributes in the sort-->
<prop id="modos_sort_number"/>
<!--the ignore-case attributes in the sort-->
<prop id="modos_sort_ignore_case"/>
<!--the desc attributes in the sort-->
<prop id="modos_sort_desc"/>
<!--a where claused, this is a post to the xpath-expression, use for several view-types-->
<prop id="modos_where"/>
<!--return job to be called after changes (new,delete,edit)-->
<prop id="modos_return_job">modo-see-all</prop>  

<file id="exportfiles">(dir,pro)exportfiles.xml</file>
<when test="(f,not,(f,exists_file,(file,exportfiles)))">
<create_file out="(file,exportfiles)">&lt;exportfiles/&gt;</create_file>
<i>Created: (file,exportfiles)</i>
</when>
<!--The offset defines a node in the xml-data-file under which all the data is found. use eg 'england' or 'country[id='england']-->
<prop id="exportfiles_offset">./</prop>
<!--The offset label is communicated to the user, it verbalizes the offset-->
<prop id="exportfiles_offset_label"/>
<!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
<prop id="exportfiles_offset_new_key">//</prop>
<!--sort_attribute defines the attributes to be used for the view-sort-->
<prop id="exportfiles_sort_attribute"/>
<!--the numeric attributes in the sort-->
<prop id="exportfiles_sort_number"/>
<!--the ignore-case attributes in the sort-->
<prop id="exportfiles_sort_ignore_case"/>
<!--the desc attributes in the sort-->
<prop id="exportfiles_sort_desc"/>
<!--a where claused, this is a post to the xpath-expression, use for several view-types-->
<prop id="exportfiles_where"/>
<!--return job to be called after changes (new,delete,edit)-->
<prop id="exportfiles_return_job">exportfile-see-all</prop>

<file id="blurries">(dir,pro)blurries.xml</file>
<when test="(f,not,(f,exists_file,(file,blurries)))">
<create_file out="(file,blurries)">&lt;files2/&gt;</create_file>
<i>Created: (file,blurries)</i>
</when>

<file id="prodconf">(dir,pro)prodconf.xml</file>
<when test="(f,not,(f,exists_file,(file,prodconf)))">
<create_file out="(file,prodconf)">&lt;files2/&gt;</create_file>
<i>Created: (file,prodconf)</i>
</when>


<file id="prolog-steps">(dir,pro)prolog-steps.xrs</file>
<when test="(f,not,(f,exists_file,(file,prolog-steps)))">
<create_file out="(file,prolog-steps)">&lt;?xml version=&quot;1.0&quot; ?&gt;
&lt;steps&gt;
&lt;/steps&gt;</create_file>
<i>Created: (file,prolog-steps)</i>
</when>


<!-- 
<file id="modos2">(dir,pro)files2.xml</file>
<prop id="modos2_offset">./</prop>
<prop id="modos2_offset_label"/>
<prop id="modos2_offset_new_key">//</prop>
<prop id="modos2_sort_attribute"/>
<prop id="modos2_sort_number"/>
<prop id="modos2_sort_ignore_case"/>
<prop id="modos2_sort_desc"/>
<prop id="modos2_where"/>
<prop id="modos2_return_job">modo2-see-all</prop>        -->

</when> 

</job>



</jobs>
