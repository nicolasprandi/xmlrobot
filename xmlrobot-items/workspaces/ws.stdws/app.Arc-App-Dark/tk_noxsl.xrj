<jobs>

<!--

-->
<call_job job="prolog" />


<!-- gui Adapters: to copy in the app .... 


  -->
<job id="Edit: noxsl_?">
  <call_job job="tk_noxsl_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_noxsl_clear" explain="Clear this data"/>
</job>

<!-- 
 <job id="Clear Data: noxsl_">
  <tk type="msg" x="Sure to clear data of noxsl_ ?" msg_type="w"/>
  <call_job job="tk_noxsl_clear"/>
</job>

<job id="Print Values:  noxsl_">
  <call_job job="tk_noxsl_print_values"/>
</job>
<job id="Print Help: noxsl_" role="dev">
  <call_job job="tk_noxsl_print_help"/>
</job>

-->

<!-- setting the default-values -->
<job id="tk_noxsl_default" role="hidden">
  <need default="">(prop,noxsl_files)</need>
</job>


<!-- noxsl-core, make your changes here -->
<job id="tk_noxsl_core" role="hidden" tip="noxsl_: Tk Internal">

  <need default="">(prop,tk_noxsl_add_flag)</need>

  <tk label="Not encrypted xsl-files" 
      flag="(prop,tk_noxsl_add_flag)"
      xtip="()Search Parameters is a list of values which will control the search-routine.()"> 
    <tk id="noxsl_files" 
        type="sel" 
        label="Xsl Exclude"
        test_first="1"                  
        tip="Xsl-Files NOT included in the encryption-process"
        flag="multi" 
        xml="(file,file-selector-xsl)"/>

    <!--    
    <tk id="noxsl_dir" 
        type="dir" 
        label="Directory"  
        flag="nono"                 
        tip="()A directory which serves as intial directory for the file-search.()"/>    
    <tk id="noxsl_file_read"
        type="file"  
      	label="File to read" 
        flag="nono"          
        tip="()This file will be read()"/> 
        
    <tk id="noxsl_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
    <tk id="noxsl_type"
        type="sel"  
        label="Selection 1" 
        x="text"
        test_first="0"        
        tip="()text versus regular expression; text will search for exaclty that defined search text, regex will apply the regular-expression syntax to search for a piece of text in the files()">
        <sel label="Text">text</sel>
        <sel label="Regular Expression">regex</sel>    
    </tk>            
         
    <tk id="noxsl_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="noxsl_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="noxsl_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="noxsl_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>


        
    <tk 
      id="noxsl_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="noxsl_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="noxsl_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="noxsl_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="noxsl_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="noxsl_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_noxsl_edit" tip="noxsl_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,noxsl-data))">
      <!-- data exists already -->
      <prop id="tk_noxsl_add_flag" x="sum print"/>
      <call_job job="tk_noxsl_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_noxsl_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_noxsl_default"/>
  <!-- doing input -->
  <call_job job="tk_noxsl_core"/>
  
  <!-- writing data -->
  <call_job job="tk_noxsl_write"/>

</job>



<job id="tk_noxsl_print_values" tip="noxsl_: Prints the entered values" role="hidden">
  
  <call_job job="tk_noxsl_read"/>
  
  <call_job job="tk_noxsl_core">
    <prop id="tk_noxsl_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_noxsl_print_values_tips" tip="noxsl_: Prints values and tips" role="hidden">
  
  <call_job job="tk_noxsl_read"/>
  
  <call_job job="tk_noxsl_core">
    <prop id="tk_noxsl_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_noxsl_print_help" tip="noxsl_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_noxsl_core">
    <prop id="tk_noxsl_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_noxsl_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,noxsl-data)" />
    <prop id="joe-in-regex" x="(prop,noxsl-regex)" />
  </call_job>
  <call_job job="tk_noxsl_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_noxsl_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,noxsl-data)" />
    <prop id="joe-in-regex" x="(prop,noxsl-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_noxsl_clear"  tip="noxsl_: Clears the data" role="hidden">
  <delete file="(file,noxsl-data)"/>
</job>


</jobs>