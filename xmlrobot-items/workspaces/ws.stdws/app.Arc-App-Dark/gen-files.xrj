<need>(prop,file_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="file-read" />
<prop id="isAdd">0</prop>
<call_job job="file-editor" />
<call_job job="file-write" />
<ti align="right" x="Did update File '(f,tk_sel_translate,(prop,file_thefile),(file,file-selector-any))'" />
<call_job job="file-see" />
</job><job role="hidden" id="file-del">
<need>(prop,file_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="file-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting File [ (f,tk_sel_translate,(prop,file_thefile),(file,file-selector-any)) (prop,files_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,files)" where="(prop,files_offset)file[@row='(prop,file_key)']" />
<tp>Deleted (f,tk_sel_translate,(prop,file_thefile),(file,file-selector-any)) #(prop,file_key)</tp>
<ti label="Did delete File:" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,file_thefile),(file,file-selector-any))(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="file-see-all" />
</job><job role="hidden" id="file-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new File(prop,files_offset_label)" />
<prop x="sum" id="files_tk_control" />
</when>
<otherwise>
<need>(prop,file_key)</need>
<prop id="label" x="File [(f,tk_sel_translate,(prop,file_thefile),(file,file-selector-any))](prop,files_offset_label)" />
<prop x="sum_only" id="files_tk_control" />
</otherwise>
</choose>
<call_job job="file-tk" />
</job><job id="file-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="file-editor" />
<prop id="file_key">1</prop>
<when test="(f,not,(f,exists,prop,files_offset_new_key))">
<prop id="files_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,files)" sort="@row" number="@row" xpath="(prop,files_offset_new_key)file">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="file_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new File: #(prop,file_key)</i>
<call_job job="file-write" />
<ti align="right" x="Did add File '(f,tk_sel_translate,(prop,file_thefile),(file,file-selector-any))'" />
<choose>
<when test="(f,has,prop,post_add_script_file)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_file)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="file-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="file-write">
<need>(prop,file_key) (prop,isAdd)</need>
<spirit act="open" id="files_spirit_tc" xml="(file,files)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,files_offset),/)">
<prop id="offset2" x="(f,substring,(prop,files_offset),0,(f,sub,(f,len,(prop,files_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,files_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="files_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;file row="(prop,file_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="files_spirit_tc" where="(prop,files_offset)file[@row='(prop,file_key)']" attribute="thefile" value="(f,vob,prop,file_thefile)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="files_spirit_tc" where="(prop,files_offset)file[@row='(prop,file_key)']" attribute="off" value="(f,vob,prop,file_off)" />
<spirit act="close" flag="save pretty" id="files_spirit_tc" />
</job></jobs>
