<jobs>

<call_job job="prolog" />



<!-- gui Adapters: to copy in the app  take the edit to your gui.... -->





<!-- setting the default-values -->
<job id="tk_fileig_default" role="hidden">
  <!--
  <need default="regex">(prop,fileig_type)</need>
  <need default="(dir,filetemp)">(dir,fileig_dir)</need>
  -->
</job>


<!-- fileig-core, make your changes here -->
<job id="tk_fileig_core" role="hidden" tip="fileig_: Tk Internal">

  <need default="">(prop,tk_fileig_add_flag)</need>

  <tk label="Parameters: Files to ignore" 
      flag="(prop,tk_fileig_add_flag)"
      tip="()These app-files will be ignored in production, so the will be deleted and not appear in the result()"> 
      
    <tk id="fileig_exclude" 
        type="sel" 
        label="App-Files to Exclude"
        test_first="1"                  
        tip="These app-filess will be ignored in the production."
        flag="multi" 
        xml="(file,file-selector-ignore)"/>          
    <!-- 
    <tk id="fileig_typus"
        type="sel"  
        label="Selection Typus" 
        test_first="0"        
        tip="()Explain fileig_typus here ...()">
        <sel xlabel="Text">text</sel>
        <sel xlabel="Regex">regex</sel> 
        <sel label="This">this</sel>
        <sel label="That">that</sel>   
    </tk>
    
    <tk type="msg"
        x="Descriptions"
        test_first="0"/>  
        
    <tk id="fileig_rain" 
        label="Rain Simple Text"
        test_first="0"
        tip="()()" />
         
    <tk id="fileig_wind"
        type="textblock"
        label="Wind Textblock"               
      	test_first="0"
        tip="()()" /> 
        
    <tk id="fileig_stones"
        type="textblock"
        flag="big"
        label="Stones Bigscreen"               
      	test_first="0"
        tip="This is about the stones"/>         
        
    <tk id="fileig_sun"
        type="bool"
        label="Sun Boolean"       
      	test_first="0"
        flag="no_is_0"     
        tip="()()"
        />         
        
    <tk type="msg"
        x="Files and Folders"
        test_first="0"/>   
                     
    <tk id="fileig_cat"
        type="sel"
        flag="multi"  
        label="Categories" 
        test_first="0"        
        tip="()Explain fileig_cat here ...()">
        <sel>sand</sel>
        <sel>land</sel>
        <sel>band</sel>
        <sel>hand</sel>                  
    </tk>    
    <tk id="fileig_dir" 
        type="dir" 
        label="Directory"  
        flagx="nono"                 
        tip="()A directory which serves as intial directory for the file-search.()"
        test_first="0"/>
        
    <tk id="fileig_file_read"
        type="file"  
      	label="File to read" 
        xflag="nono"          
        tip="()This file will be read()"
        test_first="0"/>         
       

        
    <tk id="fileig_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
            
         
    <tk id="fileig_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="fileig_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="fileig_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="fileig_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="fileig_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,fileig-sel2)"/>
        
    <tk 
      id="fileig_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="fileig_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="fileig_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="fileig_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="fileig_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="fileig_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>
