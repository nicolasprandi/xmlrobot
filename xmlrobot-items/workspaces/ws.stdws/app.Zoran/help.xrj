<jobs>

<call_job job="prolog" />

<job id="???" >
 
  <choose>
    <when test="(f,has,prop,pro)">
      <call_job job="??"/>
    </when>
    <otherwise>
      <ti label="Welcome to (prop,app) s Application">
        <ti type="call_job" job="Run" explain="Go &amp; do i ..."/>
      </ti>
      <ti_hr/>
      <call_job job="?"/>
    </otherwise>
  </choose>     
</job>

<job id="??" >
<call_job job="zirami-see-all"/>
<call_job job="tk_para_print_values_tips" flag="catch"/>
<ti test="(f,role,admin)" type="call_job" job="tk_para_edit" explain="[ Edit these Parameters ]" label=" "/>
<call_job job="tk_conf_print_values_tips" flag="catch"/>
<ti test="(f,role,admin)" type="call_job" job="tk_conf_edit" explain="[ Edit this Configuration ]" label=" "/>
<call_job job="tk_stat_print_values_tips" flag="catch"/>

<!-- <when test="(f,role,expert)">  </when>   -->

    <!-- 
    <ti_hr/>
    <ti label="Login"/>
    <ti type="call_job" job="[ App Login ]" explain="Do App-Login for [(prop,app)]"/>         -->

    
</job>


<job id="?">
  <ti label="When to use Application (f,html,i,open)(prop,app)(f,html,i,close) :">
    <ti xtype="ul">1(e:c) (f,html,bold,open)You want to do this(f,html,bold,close)</ti>
	  <ti xtype="ul">2(e:c) (f,html,bold,open)You want to do that(f,html,bold,close)</ti>
   <ti label="xxx:">alskdj aksdfj akdjf a
asdfköa akdjf </ti> 
    <ti label="More help online:" type="web" x="https://www.xmlrobot.net/data-generator-help"/>
  </ti>
  <ti_break/>
  <ti_space height="5px" />
  <ti label="Overview"/>
  

   

</job>


</jobs>