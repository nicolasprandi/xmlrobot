<?xml version="1.0" ?>

<jobs>



<job id="hook-zirami-after-edit" role="hidden">
 <call_job job="zirami-see" /> 
  <call_job job="zirami-see-all" />

</job>

<job id="hook-zirami-list-begin" role="hidden">
  <ti label="List of Ziramis"/>

</job>

<job id="hook-zirami-list-end" role="hidden">
  <ti_hr/>
  <ti type="call_job" job="zirami-see-all" explain="&gt;&gt; See all ziramis" />

</job>

