<?xml version="1.0" ?>
<!-- Copyright © 2015-2018 Nicolas Prandstaetter. All rights reserved. --><jobs><call_job job="prolog" />
<!-- conf-core, make your changes here -->

<!-- setting the default-values -->
<job id="tk_conf_default" role="hidden">
  <need default="1">(prop,conf_thisOne)</need>
  <need default="0">(prop,conf_thatOne)</need>
  <need default="mo">(prop,conf_dayofweek)</need>
</job>

<job id="tk_conf_core" role="hidden" tip="conf_: Tk Internal">

  <need default="">(prop,tk_conf_add_flag)</need>

  <tk label="Configuration" 
      flag="(prop,tk_conf_add_flag)"
      tip="()Hallo Configuration()"> 
    
    <tk id="conf_thisOne"
        type="bool"
        label="This One"       
      	test_first="0"               
        tip="()()"/> 
        
    <tk id="conf_thatOne"
        type="bool"
        label="That One"       
      	test_first="0"              
        tip="()xyz()"/>         
              
    <tk id="conf_dayofweek"
        type="sel"  
        label="Day of Week" 
        x="text"
        test_first="0"        
        tip="()()">
        <sel label="Monday">mo</sel>
        <sel label="Tuesday">di</sel> 
        <sel label="Miercoles">mi</sel>
        <sel label="Jueves">do</sel>
        <sel label="Viernes">fr</sel>
        <sel label="Sabado">sa</sel>
        <sel label="Domingo">so</sel>   
    </tk>  
          
    <tk id="conf_info" 
        label="Info"
        test_first="0" />
         
    <tk id="conf_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk type="msg"
        x="Specified Files"
        test_first="0"/> 
            
    <tk id="conf_file_read"
        type="file"  
      	label="The file to read" 
        flagx="nono"         
        test_first="0"         
        tip="()()"/> 
        
    <tk id="conf_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()()"/> 
        
    <tk id="conf_dir_read"
        type="dir"  
      	label="The dir to read" 
        flagx="nono"         
        test_first="0"         
        tip="()()"/> 
        
    <tk id="conf_dir_write"
        type="dir"  
      	label="Dir to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()()"/>         
    
    <tk type="msg"
        x="Declared Directory"
        test_first="0"/>    
                           
    <tk id="conf_dir" 
        type="dir" 
        label="The Data From"  
        flagx="nono"   
        test_first="0"              
        tip="()()"/>
        
        
    <!--    
    <tk id="conf_file_read"
        type="file"  
      	label="File to read" 
        flag="nono"          
        tip="()This file will be read()"/> 
        
    <tk id="conf_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
    <tk id="conf_type"
        type="sel"  
        label="Selection 1" 
        x="text"
        test_first="0"        
        tip="()text versus regular expression; text will search for exaclty that defined search text, regex will apply the regular-expression syntax to search for a piece of text in the files()">
        <sel label="Text">text</sel>
        <sel label="Regular Expression">regex</sel>    
    </tk>            
         
    <tk id="conf_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="conf_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="conf_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="conf_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="conf_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,conf-sel2)"/>
        
    <tk 
      id="conf_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="conf_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="conf_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="conf_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="conf_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="conf_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- gui Adapters: to copy in the app .... -->



