<?xml version="1.0" ?>
<!-- Copyright © 2015-2018 Nicolas Prandstaetter. All rights reserved. --><jobs>
<call_job job="prolog" />
<!-- setting the default-values -->
<job id="tk_para_default" role="hidden">
  <need default="1">(prop,para_thisOne)</need>
  <need default="0">(prop,para_thatOne)</need>
  <need default="mo">(prop,para_dayofweek)</need>
</job>

<!-- para-core, make your changes here -->
<job id="tk_para_core" role="hidden" tip="para_: Tk Internal">

  <need default="">(prop,tk_para_add_flag)</need>
    <ti label="vorher"/>
    <ti label="para_info" test="(f,has,prop,para_info)" key="(f,len,(prop,para_info))">(prop,para_info)</ti>
    <ti label="para_info" test="(f,not,(f,has,prop,para_info))">-leer-</ti>
    <ti label="para_textblock" test="(f,has,prop,para_textblock)" key="(f,len,(prop,para_textblock))">(prop,para_textblock)</ti>
    <ti label="para_textblock" test="(f,not,(f,has,prop,para_textblock))">-leer-</ti>
    <ti label="para_textblock2" test="(f,has,prop,para_textblock2)" key="(f,len,(prop,para_textblock2))">(prop,para_textblock2)</ti>
    <ti label="para_textblock2" test="(f,not,(f,has,prop,para_textblock2))">-leer-</ti>

    <prop id="para_info_alt" test="(f,has,prop,para_info)">(prop,para_info)</prop>
    <prop id="para_textblock2_alt" test="(f,has,prop,para_textblock2)">(prop,para_textblock2)</prop>
    <prop id="para_textblock_alt" test="(f,has,prop,para_textblock)">(prop,para_textblock)</prop>
    
  <tk label="Parameters in Zoran" 
      flag="(prop,tk_para_add_flag)"
      tip="()Bon Jour Parameters()"> 

    <tk type="msg"
        x="text und textblock"
        test_first="0"/>  
        
    <tk id="para_info" 
        label="info"
        test_first="0" />
         
    <tk id="para_textblock"
        type="textblock"
        label="textblock"               
      	test_first="0"/> 
        
    <tk id="para_textblock2"
        type="textblock"
        flag="bigbig"
        label="textblock2"
        tip="bigbig"               
      	test_first="0"/>    
          
    <tk type="msg"
        x="bool"
        test_first="0"/>          
    <tk id="para_thatOne"
        type="bool"
        label="That One"       
      	test_first="0"              
        tip="()xyz()"/>         
    <tk type="msg"
        x="selection"
        test_first="0"/>                
    <tk id="para_dayofweek"
        type="sel"  
        label="Day of Week" 
        x="text"
        test_first="0"        
        tip="()()">
        <sel label="Monday">mo</sel>
        <sel label="Tuesday">di</sel> 
        <sel label="Miercoles">mi</sel>
        <sel label="Jueves">do</sel>
        <sel label="Viernes">fr</sel>
        <sel label="Sabado">sa</sel>
        <sel label="Domingo">so</sel>   
    </tk>  
          
       
        
    <tk type="msg"
        x="Files"
        test_first="0"/> 
            
    <tk id="para_file_read"
        type="file"  
      	label="The file to read" 
        flagx="nono"         
        test_first="0"         
        tip="()()"/> 
        
    <tk id="para_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()()"/> 
    <tk type="msg"
        x="Dirs"
        test_first="0"/>         
    <tk id="para_dir_read"
        type="dir"  
      	label="The dir to read" 
        flagx="nono"         
        test_first="0"         
        tip="()()"/> 
        
    <tk id="para_dir_write"
        type="dir"  
      	label="Dir to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()()"/>     
    

                          
  </tk>   
  
      <ti label="nachher"/>
    <ti label="para_info" test="(f,has,prop,para_info)" key="(f,len,(prop,para_info))">(prop,para_info)</ti>
    <ti label="para_info" test="(f,not,(f,has,prop,para_info))">-leer-</ti>
    <ti label="para_textblock" test="(f,has,prop,para_textblock)" key="(f,len,(prop,para_textblock))">(prop,para_textblock)</ti>
    <ti label="para_textblock" test="(f,not,(f,has,prop,para_textblock))">-leer-</ti>
    <ti label="para_textblock2" test="(f,has,prop,para_textblock2)" key="(f,len,(prop,para_textblock2))">(prop,para_textblock2)</ti>
    <ti label="para_textblock2" test="(f,not,(f,has,prop,para_textblock2))">-leer-</ti>
        <ti label="equals"/>
    <when  test="(f,has,prop,para_info)">
    <when  test="(f,has,prop,para_info_alt)">
        <ti label="info-equals">(f,eq_text,(prop,para_info),(prop,para_info_alt))</ti>
    </when>
    </when>
    
    <when  test="(f,has,prop,para_textblock)">
    <when  test="(f,has,prop,para_textblock_alt)">
        <ti label="textblock-equals">(f,eq_text,(prop,para_textblock),(prop,para_textblock_alt))</ti>
    </when>
    </when>
        
    <when  test="(f,has,prop,para_textblock2)">
    <when  test="(f,has,prop,para_textblock2_alt)">
        <ti label="textblock2-equals">(f,eq_text,(prop,para_textblock2),(prop,para_textblock2_alt))</ti>
    </when>
    </when>

</job>

<!-- edit data: read, userinput, write -->
<job id="tk_para_edit" tip="para_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,para-data))">
      <!-- data exists already -->
      <prop id="tk_para_add_flag" x="sum_only print"/>
      <call_job job="tk_para_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_para_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_para_default"/>
  <!-- doing input -->
  <call_job job="tk_para_core"/>
  
  <!-- writing data -->
  <call_job job="tk_para_write"/>

</job>



<job id="tk_para_print_values" tip="para_: Prints the entered values" role="hidden">
  
  <call_job job="tk_para_read"/>
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_para_print_values_tips" tip="para_: Prints values and tips" role="hidden">
  
  <call_job job="tk_para_read"/>
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_para_print_help" tip="para_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_para_core">
    <prop id="tk_para_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_para_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,para-data)" />
    <prop id="joe-in-regex" x="(prop,para-regex)" />    
  </call_job>
  <call_job job="tk_para_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_para_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,para-data)" />
    <prop id="joe-in-regex" x="(prop,para-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_para_clear"  tip="para_: Clears the data" role="hidden">
  <delete file="(file,para-data)"/>
</job>

