<job id="?">
  <ti label="When to use Application (f,html,i,open)Generator(f,html,i,close) :">
    <ti xtype="ul">1(e:c) (f,html,bold,open)You want to create testdata for a software-project(f,html,bold,close)</ti>
	  <ti xtype="ul">2(e:c) (f,html,bold,open)You want to publish an spreadsheet as AngularJS-application(f,html,bold,close)</ti>
	  <ti xtype="ul">3(e:c) (f,html,bold,open)You want to generate an xsl-template(f,html,bold,close)</ti>         
	  <ti xtype="ul">4(e:c) (f,html,bold,open)()You want to convert an spreadsheet to json, csv, json, xml or html()(f,html,bold,close)</ti>
    <ti label="Spreadsheet:">A file in the format 
'Microsoft Excel 2007-2013 XML (e:o).xlsx(e:c)' - or -
'Microsoft Excel 97-2003 (e:o).xls(e:c)'</ti> 
  </ti>
  <ti_break/>
  <ti_space height="5px" />
  <ti label="Overview"/>
  
  <ti type="img" x="(dir,app)all-smaller.png"/>
  <ti_space height="8px" />

  <ti_break/> 
  <ti_hr/>  
  <ti_space height="5px" />
  <ti label="()Generator, Main Process, Job 'Run'()"/>
  <ti_space height="5px" />
  <ti type="img" x="(dir,app)run-smaller.png"/>
  
  <call_job job="do model input" test="(f,has,dir,pro)">
    <prop id="view" x=""/>
    <prop id="modelinputflag" x="print_only print_all_fields print_tips_only"/>
  </call_job>
  
          
  <ti_hr/>
  <ti label="()Exporter()"/>
  <ti type="img" x="(dir,app)exporter-smaller.png"/>
  <ti_space height="5px" />
  <call_job job="do export input" test="(f,has,dir,pro)">
    <prop id="view" x=""/>
    <prop id="exportinputflag" x="print_only print_with_tips print_all_fields print_tips_only"/>
    <prop id="askquestions" x="1"/>
  </call_job>
 

<ti_hr/>  
  <ti label="License: GENERATOR"/>
