    </ti>
  </when> --> 
  <call_job job="Project Configuration"/>
</job>

<job id="Configuration?">
  <call_job job="change-project-type?" />
</job>
<job id="Project Configuration" role="hidden">

		

  <interpreter jovial="1" />
  <!-- 
  <ti label="About: Project Configuration">
    <ti type="ul">Lets you configure some general parameters for the project</ti>
    <ti type="ul">Lets you specify a project description</ti>
  </ti>
  -->

  <call_job job="tell conf" test="(f,has,prop,pro)" />
  <call_job job="tell conf tips" test="(f,not,(f,has,prop,pro))" />
  
	<when test="(f,has,prop,pro)">
    

    <ti type="call_job" job="Modify Project Configuration" explain="Edit Configuration-Parameters" />

  </when>   
</job>

<job id="Change Project Type" pri="10"  role="hidden" tip="Changes test-data-generation -vs- sheet-conversion">
    <call_job job="demand input" />

  <call_job job="change-project-type-c" />
</job>
<job id="Change Project Type?" pri="10">
  <call_job job="change-project-type?" />
  
	<when test="(f,has,prop,pro)">
    <ti_hr />
    <ti label="Next">
    <ti type="call_job" job="Change Project Type" explain="Go" />
    </ti>
  </when>   
</job>  

<job id="Do Backup" tip="Makes a project backup" pri="10" role="hidden">
  <call_service job="Backup: Project" flag="silent" />
</job>

<job id="Do Backup?">
  <ti label="About: Do Backup">
    <ti type="ul">Makes a project backup</ti>
    <ti type="ul">That includes a backup of the spreadsheet(e:s) even if it locates outside the project and is just referenced</ti>
  </ti>
    <ti label="Next" test="(f,has,prop,pro)">
      <ti job="See Project Backups" type="call_service" />
    </ti>  
</job>
</jobs>