<job id="Run EXPORTER?">
<interpreter jovial="1" />

  <call_job job="see_export_input_only" test="(f,has,prop,pro)" />
  
  <ti_hr test="(f,has,prop,pro)" />  
  
  <ti label="About: EXPORTER">
    <ti type="ul">Saves the generated data-xml in files of different formats (e:o)eg. csv(e:s) excel(e:s) sql-insert(e:s) ...(e:c)</ti>          
  </ti>  
  <ti label="Overview" />
      <ti type="img" x="(dir,app)exporter-smaller.png" /> 
      <call_job job="Explain all export parameters" />

	<when test="(f,has,prop,pro)">
    <ti_hr />
    <ti label="Next">
    <ti type="call_job" job="Run EXPORTER" explain="Go" />
    </ti>
  </when>   
  
</job>

<job id="Export &amp; don't ask" pri="10" role="hidden" tip="Exports the testset, but without asking for parameters">
  <prop id="askquestions" x="0" />
  <prop id="view">sum_only</prop>
  <call_job job="internal: export" />
</job>

<job id="Modify Project Configuration" pri="10" tip="Declares some optional numbers and definitions" role="hidden">
  <call_job job="internal: conf" />

  <call_job job="tell conf short" />
</job>

<job id="Find Spreadsheet" pri="10" tip="Imports spreadsheets, offers predefined templates">

  <call_job job="Change Spreadsheet" />

</job>

