<xsl:stylesheet version="1.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml" indent="yes"/>

<xsl:template match="/">

  <xsl:element name="xsl:stylesheet">
    <xsl:attribute name="version">1.0</xsl:attribute>
  
    <xsl:element name="xsl:output">
      <xsl:attribute name="method">xml</xsl:attribute>
      <xsl:attribute name="indent">yes</xsl:attribute>
    </xsl:element>
    
    <xsl:call-template name="lf"/>
    <xsl:comment>
<xsl:call-template name="lf"/><xsl:value-of select="cs/@sheet_name_good" />
Converts Xml to Xml-Elements
This template was generated by XmlRobot Generator.</xsl:comment>
    
    <xsl:call-template name="lf"/><xsl:call-template name="lf"/>
    <xsl:comment>Row-Template, will called for every row</xsl:comment><xsl:call-template name="lf"/>
    <xsl:element name="xsl:template">
      <xsl:attribute name="match">row</xsl:attribute>  
      <row>          
        <xsl:apply-templates select="cs/coltype"/>     
      </row>
      <xsl:comment>End of row-template</xsl:comment><xsl:call-template name="lf"/>
    </xsl:element>  
  
    <xsl:call-template name="lf"/><xsl:call-template name="lf"/>
    <xsl:comment>Root-Template, will call the row-template for every row</xsl:comment><xsl:call-template name="lf"/>
    <xsl:element name="xsl:template">
      <xsl:attribute name="match">root</xsl:attribute>
      <xsl:element name="{translate(cs/@sheet_name_good,' ','')}"> 
        <xsl:element name="xsl:apply-templates">
          <xsl:attribute name="select">row</xsl:attribute>       
        </xsl:element>
      </xsl:element>      
    </xsl:element>
    
    <xsl:call-template name="lf"/><xsl:call-template name="lf"/>
    <xsl:comment>Template for the complete xml, will call the root-template</xsl:comment><xsl:call-template name="lf"/>
    <xsl:element name="xsl:template">
      <xsl:attribute name="match">/</xsl:attribute>
      <xsl:element name="xsl:apply-templates">
        <xsl:attribute name="select">root</xsl:attribute>
      </xsl:element>
    </xsl:element>    
      
  </xsl:element> <!-- </xsl_stylesheet> -->
</xsl:template>

<xsl:template match="coltype">
  <xsl:comment><xsl:value-of select="@name"/></xsl:comment><xsl:call-template name="lf"/>
  <xsl:element name="{translate(@name,' ','')}">
    <xsl:element name="xsl:value-of"><xsl:attribute name="select">@<xsl:value-of select="@name"/></xsl:attribute></xsl:element>
  </xsl:element>
</xsl:template>
<xsl:template name="lf">
<xsl:text>
</xsl:text>
</xsl:template>
</xsl:stylesheet>

  