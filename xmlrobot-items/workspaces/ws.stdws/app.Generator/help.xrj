<jobs>

<call_job job="prolog" />


<job id="??" >

    <choose>    
    <when test="(f,file_exists,(file,fileref))">
      <prop id="info-only" x="1"/>
      <prop id="from-project-info" x="1"/>
      <call_job job="check input" test="1"/>
      <call_job job="pi2"/>
    </when>
    <otherwise>
    
    <call_job job="Run" />
    </otherwise>
    </choose>



    
</job>

<job id="pi2" role="hidden">
  <need default="0">(prop,from-project-info)</need>
  <when test="(f,has,prop,conf-pro-desc)">
    <ti label="About project: (prop,pro)">
      <ti>is (prop,conf-pro-desc)</ti>
    </ti>    
    <ti_hr/>      
  </when>

  <call_job job="See Parameters" flag="catch"/>

  <ti_hr/>  
  <call_job job="has-stats"/>
  <when test="(prop,has-stats-return)">
     <call_job job="print-stats-all"/>
     
  </when>
 
  <try_catch>
    <try>       
      <ti_break test="(prop,from-project-info)"/>    
      <call_job job="resultsetinfo" />

      <!-- 
      <ti>hallolllllllllllllllllll</ti>
      <call_job job="resultsetinfo" />
      <ti_hr/>      -->
      <ti_hr/>
      <ti label="Column Information" test="(f,exists_file,(file,rep_stat))"/>
      <include file="(file,rep_stat)" code="rep_stat"/>

    </try>
    <catch>
    </catch>
  </try_catch>
 
</job>

<job id="internal: print parameters" role="hidden">
  <when test="(f,exists_file,(file,ic-a))">
      
      <call_job job="go-joe-read">
        <file id="joe-in-store" x="(file,ic-a)"/>
        <prop id="joe-in-regex" x="(prop,sheet_regex)"/> 
      </call_job>
      <ti label="Sheet in excel:" x="(prop,sheet)"/>
         
  </when>
</job>





<job id="See Spreadsheet Info?">
  <ti label="About: Edit Spreadsheet Input">
    <ti type="ul">Displays a file-link to your spreadsheet(e:s) so you can open and edit it</ti>
    <ti type="ul">Lists the sheets of the current spreadsheet</ti>
    <ti type="ul">Lets you switch to another sheet within the spreadsheet</ti>
    <ti type="ul">()Lets you switch to another spreadsheet. Choose here to reference a template, to reference a file somewhere on your disk or to import/copy one into the project()</ti>
  </ti>

 
</job>



<job id="excelinfo2" joblevel="pro" role="hidden">
  
  <when test="(f,and,(f,has,file,excel),(f,has,prop,excel-loc))">
    <choose>
      <when test="(f,eq,pro,(prop,excel-loc))">
        <prop id="where_it_is" x="Spreadsheet is stored in project" />
      </when>
      <otherwise>
        <prop id="where_it_is" x="Spreadsheet is outside the project and referenced" />
      </otherwise>
    </choose>
    <ti label="Working on"/>
      <when test="(f,exists_file,(file,ic-a))">
        <prop id="ei2-sheet" x="(f,xpath,(file,ic-a),p[@id='sheet'])"/>
        <unescape type="prop" id="ei2-sheet"/>
        <ti label="Sheet:">(prop,ei2-sheet)</ti>
      </when>      
      <ti label="Spreadsheet:" type="file" x="(file,excel)" />  
      <ti label=" "
          type="call_service" 
          job="sel_open_file" 
          explain="Open with editor" flag="silent"
          key="(prop,where_it_is)">
        <file id="with" x="(file,excel)" />
      </ti>         

  </when> 
  
</job>

<job id="excelinfo" joblevel="pro" role="hidden">
  
  <need default="0">(prop,excelinfo:left)</need>
  <!-- 
  <prop id="excelinfo:left" 
        test="(f,not,(f,is_bool,(f,vob,prop,excelinfo:left)))"
        x="0"/>                 -->
  <when test="(f,and,(f,has,file,excel),(f,has,prop,excel-loc))">
     
    <choose>
      <when test="(prop,excelinfo:left)">
        <choose>
          <when test="(f,eq,pro,(prop,excel-loc))">
            <ti label="Spreadsheet is owened by this project"/>
            <ti type="file" flag="flow">(file,excel)</ti>
          </when>
          <otherwise>
            <ti label="Spreadsheet is referenced"/>
            <ti type="file" flag="flow">(file,excel)</ti>
          </otherwise>    
        </choose>         
      </when>
      <otherwise>
        <choose>
          <when test="(f,eq,pro,(prop,excel-loc))">
            <ti label="Own Spreadsheet:" type="file" flag="flow">(file,excel)</ti>
          </when>
          <otherwise>
            <ti label="Referenced:" type="file" flag="flow">(file,excel)</ti>
          </otherwise>    
        </choose>        
      </otherwise>
    </choose>
     

  </when> 
  
</job>



<job id="print-sheet-in-case" role="hidden">
  <need default="0">(prop,psic:left)</need>
  <!-- 
  <prop id="psic:left" 
        test="(f,not,(f,is_bool,(f,vob,prop,psic:left)))"
        x="0"/>     -->
  <need default="Current sheet:">(prop,psic:intro)</need>
  <when test="(f,exists_file,(file,ic-a))">
    
    <try_catch>
      <try>        
        <prop id="ms" x="(f,xpath,(file,ic-a),p[@id='sheet'])"/>
        <ti label="Current sheet:" test="(f,not,(prop,psic:left))">(prop,ms)</ti>
        <ti test="(prop,psic:left)">(prop,ms)</ti>
      </try>
      <catch>
        <throw_again/>
      </catch>
    </try_catch>
  </when>
</job>




<job id="resultsetinfo" joblevel="pro" role="hidden">
  
  <try_catch>
    <try>
      
      <include file="(file,nrr)" code="nrr"/>
    </try>
    <catch>
      <ti label="No Results found" size="3">
        <ti label="Boring:" x="Nothing happend until now -or- the last jobexecution failed!"/>
        <ti type="call_job" job="Run" label=" " explain="Run project (f,upper,(prop,pro)) from start ..."/>        
      </ti>
      <ti_break/>
    </catch>
  </try_catch>
  
</job>


</jobs>