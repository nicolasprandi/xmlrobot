<!-- setting the default-values -->
<job id="tk_fcrypt_default" role="hidden">
  <need default="regex">(prop,fcrypt_type)</need>
  <need default="(dir,temp)">(dir,fcrypt_dir)</need>
</job>


<!-- fcrypt-core, make your changes here -->
<job id="tk_fcrypt_core" role="hidden" tip="fcrypt_: Tk Internal">

  <need default="">(prop,tk_fcrypt_add_flag)</need>

  <tk label="Parameters: fcrypt_" 
      flag="(prop,tk_fcrypt_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 
    <tk type="msg">Set-1</tk>  
    <tk id="fcrypt_fa1" 
        type="sel" 
        label="()Aktion()"
        test_first="0"                 
        >
        <sel label="Encrypt">e</sel>
        <sel label="Decrypt">d</sel>         
    </tk>      
    <tk id="fcrypt_fi1"
        type="file"  
      	label="File to read"         
        tip="()This file will be read()"/> 
        
    <tk id="fcrypt_fo1"
        type="file"  
      	label="File to write" 
        test_first="0"        
        tip="()This file will be written()"/>    
        
   <tk type="msg">Set-2</tk>  
    <tk id="fcrypt_fa2" 
        type="sel" 
        label="()Aktion()"
        test_first="0"                 
        >
        <sel label="Encrypt">e</sel>
        <sel label="Decrypt">d</sel>         
    </tk>      
    <tk id="fcrypt_fi2"
        type="file"  
      	label="File to read"         
        tip="()This file will be read()"/> 
        
    <tk id="fcrypt_fo2"
        type="file"  
      	label="File to write" 
        test_first="0"        
        tip="()This file will be written()"/> 
        
   <tk type="msg">Set-3</tk>  
    <tk id="fcrypt_fa3" 
        type="sel" 
        label="()Aktion()"
        test_first="0"                 
        >
        <sel label="Encrypt">e</sel>
        <sel label="Decrypt">d</sel>         
    </tk>      
    <tk id="fcrypt_fi3"
        type="file"  
      	label="File to read"         
        tip="()This file will be read()"/> 
        
    <tk id="fcrypt_fo3"
        type="file"  
      	label="File to write" 
        test_first="0"        
        tip="()This file will be written()"/> 
        
   <tk type="msg">Set-4</tk>  
    <tk id="fcrypt_fa4" 
        type="sel" 
        label="()Aktion()"
        test_first="0"                 
        >
        <sel label="Encrypt">e</sel>
        <sel label="Decrypt">d</sel>         
    </tk>      
    <tk id="fcrypt_fi4"
        type="file"  
      	label="File to read"         
        tip="()This file will be read()"/> 
        
    <tk id="fcrypt_fo4"
        type="file"  
      	label="File to write" 
        test_first="0"        
        tip="()This file will be written()"/>                         
    <tk type="msg">Perform</tk>      
    <tk id="fcrypt_set" 
        type="sel" 
        label="()Set to Run()"
        test_first="0"         
        flag="nono"     >
        <sel>1</sel>
        <sel>2</sel>
        <sel>3</sel>
        <sel>4</sel>
        <sel>x</sel>
        <!-- 
        <sel>5</sel>
        <sel>6</sel>
        <sel>7</sel>
        <sel>8</sel>
        <sel>9</sel>        -->                                 
    </tk> 
    
  <tk id="fcrypt_pwd" label="Pwd"/>     
            
    
    <!--
    <tk id="fcrypt_dir" 
        type="dir" 
        label="Directory"  
        flag="nono"                 
