        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="fcrypt_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="fcrypt_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="fcrypt_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="fcrypt_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_fcrypt_edit" tip="fcrypt_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,fcrypt-data))">
      <!-- data exists already -->
      <prop id="tk_fcrypt_add_flag" x="sum_only print"/>
      <call_job job="tk_fcrypt_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_fcrypt_add_flag" x="sum_only print"/>
    </otherwise>
  </choose>
  <call_job job="tk_fcrypt_default"/>
  <!-- doing input -->
  <call_job job="tk_fcrypt_core"/>
  
  <!-- writing data -->
  <call_job job="tk_fcrypt_write"/>

</job>



<job id="tk_fcrypt_print_values" tip="fcrypt_: Prints the entered values" role="hidden">
  
  <call_job job="tk_fcrypt_read"/>
  
  <call_job job="tk_fcrypt_core">
    <prop id="tk_fcrypt_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_fcrypt_print_values_tips" tip="fcrypt_: Prints values and tips" role="hidden">
  
  <call_job job="tk_fcrypt_read"/>
  
  <call_job job="tk_fcrypt_core">
    <prop id="tk_fcrypt_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_fcrypt_print_help" tip="fcrypt_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_fcrypt_core">
    <prop id="tk_fcrypt_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_fcrypt_read" role="hidden">

  <file id="joe-in-store" x="(file,fcrypt-data)" />
  <prop id="joe-in-regex" x="(prop,fcrypt-regex)" />
    
  <call_job job="go-joe-read"/>
  <call_job job="tk_fcrypt_default"/>

</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_fcrypt_write" role="hidden">
  <file id="joe-in-store" x="(file,fcrypt-data)" />
  <prop id="joe-in-regex" x="(prop,fcrypt-regex)" />
  <call_job job="go-joe-write"/>
</job>

<!-- cleares data -->
<job id="tk_fcrypt_clear"  tip="fcrypt_: Clears the data" role="hidden">
  <delete file="(file,fcrypt-data)"/>
</job>


</jobs>