<!-- setting the default-values -->
<job id="tk_tcrypt_default" role="hidden">
  <need default="regex">(prop,tcrypt_type)</need>
  <need default="(dir,temp)">(dir,tcrypt_dir)</need>
</job>


<!-- tcrypt-core, make your changes here -->
<job id="tk_tcrypt_core" role="hidden" tip="tcrypt_: Tk Internal">

  <need default="">(prop,tk_tcrypt_add_flag)</need>
  
  <tk label="Parameters: tcrypt_" 
      flag="(prop,tk_tcrypt_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 
    <tk type="msg">Values</tk>  
    <tk id="tcrypt_v1" label="Value-1" type="textblock"/>      
    <tk id="tcrypt_v2" label="Value-2" type="textblock"/>  
    <tk id="tcrypt_v3" label="Value-3" type="textblock"/>  
    <tk id="tcrypt_v4" label="Value-4" type="textblock"/>  
   
    <tk id="tcrypt_v5" label="Value-5" type="textblock"/>  
    <tk id="tcrypt_v6" label="Value-6" type="textblock"/>  
    <tk id="tcrypt_v7" label="Value-7" type="textblock"/> 
    <tk id="tcrypt_v8" label="Value-8" type="textblock"/>  
    <tk id="tcrypt_v9" label="Value-9" type="textblock"/>     
    
    <tk id="tcrypt_value" 
        type="sel" 
        label="()Value to work()"
        test_first="0"         
        flag="nono"     >
        <sel>1</sel>
        <sel>2</sel>
        <sel>3</sel>
        <sel>4</sel>
        <sel>5</sel>
        <sel>6</sel>
        <sel>7</sel>
        <sel>8</sel>
        <sel>9</sel>                                          
    </tk>         
   <tk type="msg">Passwords</tk> 
   <tk id="tcrypt_p1" label="Pwd-1"/> 
    <tk id="tcrypt_p2" label="Pwd-2"/>  
    <tk id="tcrypt_p3" label="Pwd-3"/>  
    <tk id="tcrypt_p4" label="Pwd-4"/>  
   
    <tk id="tcrypt_p5" label="Pwd-5"/>  
    <tk id="tcrypt_p6" label="Pwd-6"/>  
    <tk id="tcrypt_p7" label="Pwd-7"/> 
    <tk id="tcrypt_p8" label="Pwd-8"/>  
    <tk id="tcrypt_vp9" label="Pwd-9"/>      
    
    <tk id="tcrypt_pwd" 
        type="sel" 
        label="()Pwd to work()"
        test_first="0"         
        flag="nono"     >
        <sel>1</sel>
        <sel>2</sel>
        <sel>3</sel>
        <sel>4</sel>
        <sel>5</sel>
        <sel>6</sel>
        <sel>7</sel>
        <sel>8</sel>
        <sel>9</sel>                                          
    </tk> 
    <tk type="msg">Action</tk>     
    <tk id="tcrypt_action" 
        type="sel" 
        label="()Aktion()"
        test_first="0"         
        flag="nono"         
        >
        <sel label="Encrypt">e</sel>
        <sel label="Decrypt">d</sel>
        <sel label="Nichts">x</sel>          
    </tk>    
    
             
 
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_tcrypt_edit" tip="tcrypt_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,tcrypt-data))">
      <!-- data exists already -->
      <prop id="tk_tcrypt_add_flag" x="sum_only print"/>
      <call_job job="tk_tcrypt_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_tcrypt_add_flag" x="sum_only print"/>
    </otherwise>
  </choose>
  <call_job job="tk_tcrypt_default"/>
  <!-- doing input -->
  <call_job job="tk_tcrypt_core"/>
  
  <!-- writing data -->
  <call_job job="tk_tcrypt_write"/>

</job>



<job id="tk_tcrypt_print_values" tip="tcrypt_: Prints the entered values" role="hidden">
  
  <call_job job="tk_tcrypt_read"/>
  
  <call_job job="tk_tcrypt_core">
    <prop id="tk_tcrypt_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_tcrypt_print_values_tips" tip="tcrypt_: Prints values and tips" role="hidden">
  
  <call_job job="tk_tcrypt_read"/>
  
  <call_job job="tk_tcrypt_core">
    <prop id="tk_tcrypt_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_tcrypt_print_help" tip="tcrypt_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_tcrypt_core">
    <prop id="tk_tcrypt_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_tcrypt_read" role="hidden">

  <file id="joe-in-store" x="(file,tcrypt-data)" />
  <prop id="joe-in-regex" x="(prop,tcrypt-regex)" />
    
  <call_job job="go-joe-read"/>
  <call_job job="tk_tcrypt_default"/>

</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_tcrypt_write" role="hidden">
  <file id="joe-in-store" x="(file,tcrypt-data)" />
  <prop id="joe-in-regex" x="(prop,tcrypt-regex)" />
  <call_job job="go-joe-write"/>
</job>

<!-- cleares data -->
<job id="tk_tcrypt_clear"  tip="tcrypt_: Clears the data" role="hidden">
  <delete file="(file,tcrypt-data)"/>
</job>


</jobs>