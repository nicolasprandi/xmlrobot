<jobs>

<call_job job="prolog" />

<!-- <when test="(f,has,prop,pro)"> take 2 things to the prolog --> 
  <!-- 
  <file id="ipx-data" x="(dir,pro)ipx-data.xrs"/>
  <prop id="ipx-regex" x="ipx_.+"/>
  -->
<!-- </when>       -->


<job id="ipx_run" role="hidden">
  <need default="0">(prop,ipx_run_print)</need>
  <call_job job="tk_ipx_read"/>
  <ti label="Looping over Xml by Xpath"/>
  
  <when test="(prop,ipx_run_print)">
    <ti label="Xml-File:" type="file" x="(file,ipx_file_read)"/>
    <ti label="Xpath:"  x="(prop,ipx_xpath)"/> 
  </when>
  <ti_break/>
  <prop id="ipx-count">0</prop>
  <loop xml="(file,ipx_file_read)" id="ipx" xpath="(prop,ipx_xpath)">
    <prop id="ipx-count">(loop,ipx,#i)</prop>
    <ti type="rec" label="(prop,ipx-count).">
      <ti>(loop,ipx,xml?)</ti>
    </ti>
  </loop>  
  <ti_hr/>
  <ti label="Found (prop,ipx-count) times."/>
  
 <ti type="call_job" job="ixp_edit_run" explain="Edit &amp; Run Again ...." /> 
</job>
<!-- gui Adapters: to copy in the app  take the edit to your gui....
<job id="Edit: ipx_">
  <call_job job="tk_ipx_edit"/>
</job>

<job id="Edit: ipx_?">
  <call_job job="tk_ipx_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_ipx_clear" explain="Clear this data"/>
</job>
                                   -->


<!-- setting the default-values -->
<job id="tk_ipx_default" role="hidden">

  <need default="">(prop,ipx_xpath)</need>
  <need default="">(file,ipx_file_read)</need>
  <need default="">(prop,memo)</need>
</job>


<!-- ipx-core, make your changes here -->
<job id="tk_ipx_core" role="hidden" tip="ipx_: Tk Internal">

  <need default="">(prop,tk_ipx_add_flag)</need>

  <tk label="Xpath" 
      flag="(prop,tk_ipx_add_flag)"
      tip="()Search an xml by xpath()"> 

    <tk id="ipx_xpath"
        type="textblock"
        label="Xpath"               
      	xtest_first="0"
        flag="nono"
        tip="()()" /> 
        
    <tk id="ipx_file_read"
        type="file"  
      	label="Xml-File" 
        flag="nono"          
        tip="()This file will be read()"
        xtest_first="0"/>  
        
    <tk id="ipx_memo"
        type="textblock"
        label="Memo"               
        tip="()Just to note something()" />           
                          
  </tk>   
</job>
