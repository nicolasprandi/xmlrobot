<job id="See Values: ipx_" role="dev">
  <call_job job="tk_ipx_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_ipx_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: ipx_">
  <tk type="msg" x="Sure to clear data of ipx_ ?" msg_type="w"/>
  <call_job job="tk_ipx_clear"/>
</job>

<job id="Print Values:  ipx_">
  <call_job job="tk_ipx_print_values"/>
</job>
<job id="Print Help: ipx_" role="dev">
  <call_job job="tk_ipx_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_ipx_edit" tip="ipx_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,ipx-data))">
      <!-- data exists already -->
      <prop id="tk_ipx_add_flag" x="sum_only print"/>
      <call_job job="tk_ipx_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_ipx_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_ipx_default"/>
  <!-- doing input -->
  <call_job job="tk_ipx_core"/>
  
  <!-- writing data -->
  <call_job job="tk_ipx_write"/>

</job>



<job id="tk_ipx_print_values" tip="ipx_: Prints the entered values" role="hidden">
  
  <call_job job="tk_ipx_read"/>
  
  <call_job job="tk_ipx_core">
    <prop id="tk_ipx_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_ipx_print_values_tips" tip="ipx_: Prints values and tips" role="hidden">
  
  <call_job job="tk_ipx_read"/>
  
  <call_job job="tk_ipx_core">
    <prop id="tk_ipx_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_ipx_print_help" tip="ipx_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_ipx_core">
    <prop id="tk_ipx_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_ipx_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,ipx-data)" />
    <prop id="joe-in-regex" x="(prop,ipx-regex)" />    
  </call_job>
  <call_job job="tk_ipx_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_ipx_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,ipx-data)" />
    <prop id="joe-in-regex" x="(prop,ipx-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_ipx_clear"  tip="ipx_: Clears the data" role="hidden">
  <delete file="(file,ipx-data)"/>
</job>


</jobs>