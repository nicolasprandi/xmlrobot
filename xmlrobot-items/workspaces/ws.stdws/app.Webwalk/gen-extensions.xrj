<prop id="extension_key">1</prop>
<when test="(f,not,(f,exists,prop,extensions_offset_new_key))">
<prop id="extensions_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,extensions)" sort="@row" number="@row" xpath="(prop,extensions_offset_new_key)extension">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="extension_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Project Extension: #(prop,extension_key)</i>
<call_job job="extension-write" />
<ti align="right" x="Did add Project Extension '(prop,extension_titel)'" />
<choose>
<when test="(f,has,prop,post_add_script_extension)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_extension)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
