<!-- conf-core, make your changes here -->
<job id="tk_conf_core" role="hidden" tip="conf_: Tk Internal">

  <need default="">(prop,tk_conf_add_flag)</need>

  <tk label="Configuration" 
      flag="(prop,tk_conf_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 
    <!-- 
    <tk id="conf_wdh" 
        type="sel" 
        label="Driver-Request"  
        flag="nono"                 
        tip="()Do generally start the driver()">        
        <sel label="NO">0</sel>
        <sel label="YES">1</sel>    
    </tk>    -->
    
    <tk id="conf_driver_type" 
        type="sel" 
        label="Type of Driver"  
        flag="nono dynamoX"                 
        tip="()The Implementation of the WebDriver you wan to use()">        
        <sel label="Chrome">chrome</sel>
        <sel label="Firefox">firefox</sel>    
        <sel label="Edge">edge</sel>    
    </tk>    
    <tk type="msg" test_first="0" >-CHROME-</tk>        
    <tk id="conf_chrome_binary" 
        label="Chrome: Binary-Exe"
        type="file"
        test_first="0" 
        tip="If you use a Chrome(e:s) do link the file 'chrome.exe' here"
         />    
        
    <tk id="conf_chrome_driver" 
        label="Chrome: Driver"
        type="file"
        test_first="0" 
        tip="If you use a Chrome(e:s) do link the file 'chromedriver.exe' "
        />  
        
                  
    <tk id="conf_driver_headless_chrome"
        type="bool"
        label="Headless-Option"       
      	test_first="0"
        />  
        
    <tk id="conf_driver_disablegpu_chrome"
        type="bool"
        label="DisableGpu-Option"       
      	test_first="0"
        />                  
      
    <tk type="msg" test_first="0" 
        >-FIREFOX-</tk> 
    <tk id="conf_driver_firefox" 
        label="Firefox: Driver"
        type="file"
        test_first="0"
        tip="geckodriver.exe"/>  
        
    <tk type="msg" test_first="0" >-EDGE-</tk>        
        
    <tk id="conf_edge_driver" 
        label="Edge: Driver"
        type="file"
        test_first="0" 
        tip="If you use a edge(e:s) do link the file 'msedgedriver.exe' "
        />          
        
     <tk type="msg"
        x="General Parameters"
        xtip="Used for Screenshot of Element. If no values defined the scaling will be internally 1. Use dot. for as decimal-point."
      
        test_first="0"/>       
        
    <tk id="conf_implicit" 
        label="Implicit-Wait-Seconds" 
        test_first="0" />     
                  
    <!-- 
    <tk id="conf_scale_loc_x" 
        label="Location X"  tip="eg 1.1"
        test_first="0" />      
        
    <tk id="conf_scale_loc_y" 
        label="Location Y"    tip="eg 1.1"
        test_first="0" />      
        
    <tk id="conf_scale_size_x" 
        label="Size X"              tip="eg 1.1"
        test_first="0" />      
        
    <tk id="conf_scale_size_y" 
        label="Size Y"              tip="eg 1.1"
        test_first="0" />                 
     -->            
 
                          
  </tk>                                   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_conf_edit" tip="conf_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,conf-data))">
      <!-- data exists already -->
      <prop id="tk_conf_add_flag" x="sum_only print"/>
      <call_job job="tk_conf_read"/>                  
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_conf_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_conf_default"/>
  <!-- doing input -->
  <call_job job="tk_conf_core"/>
  
  <!-- writing data -->
  <call_job job="tk_conf_write"/>
  <when test="(f,not,(f,exists,coop2,at.nicolas.webwalk.wd,(prop,wdid)))">
  <ti label="Next"/>
  <ti type="call_job" job="do-driver-start" explain="Do start the driver now"/>
  </when>
                    

</job>



<job id="tk_conf_print_values" tip="conf_: Prints the entered values" role="hidden">
  
  <call_job job="tk_conf_read"/>
  
  <call_job job="tk_conf_core">
    <prop id="tk_conf_add_flag" x="print_only"/>
  </call_job>
  
  
                    
  
</job>

<job id="tk_conf_print_values_tips" tip="conf_: Prints values and tips" role="hidden">
  
  <call_job job="tk_conf_read"/>
  
  <call_job job="tk_conf_core">
    <prop id="tk_conf_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_conf_print_values_tips_all" tip="conf_: Prints values and tips" role="hidden">
  
  <call_job job="tk_conf_read"/>
  
  <call_job job="tk_conf_core">
    <prop id="tk_conf_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  
</job>

<job id="tk_conf_print_help" tip="conf_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_conf_core">
    <prop id="tk_conf_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_conf_read" role="hidden">
  <call_job job="go-joe-read">
    <prop id="joe-in-regex" x="(prop,conf-regex)" />  
    <file id="joe-in-store" x="(file,conf-data)" />
  </call_job>
  <call_job job="tk_conf_default"/>
  
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_conf_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,conf-data)" />
    <prop id="joe-in-regex" x="(prop,conf-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_conf_clear"  tip="conf_: Clears the data" role="hidden">
  <delete file="(file,conf-data)"/>
</job>

</jobs>