<jobs>                                                                                                           

<!--

-->
<call_job job="prolog" />

<job id="driver-state-display" role="hidden">

  <ti label="Current state of webdriver = (f,exists,coop2,at.nicolas.webwalk.wd,(prop,wdid))" />
  <choose>
    <when test="(f,exists,coop2,at.nicolas.webwalk.wd,(prop,wdid))">
      <ti label=" ">Driver is currently running</ti>
      <ti type="call_job" job="do-driver-stop" explain="Stop Driver" label=" "/>
    </when>
    <otherwise>
      <ti label=" ">Driver is currently not running</ti>
      <ti type="call_job" job="do-driver-start" explain="Start Driver" label=" "/>
    </otherwise>
  </choose>
  <ti_hr/>
  <call_job job="tk_conf_print_values_tips" />

  
    
</job>

<job id="driver-startup-phase" role="hidden">
  <!-- <ti label="()(f,not,(f,exists,coop2,at.nicolas.webwalk.wd,(prop,wdid)))()">(f,not,(f,exists,coop2,at.nicolas.webwalk.wd,(prop,wdid)))</ti>   -->
  <!-- <ti>exists-helloconfig=(f,exists,prop,helloconfig)</ti>    -->
  <choose>
    <when test="(f,exists,prop,helloconfig)">
    </when>
    <when test="(f,not,(f,exists,coop2,at.nicolas.webwalk.wd,(prop,wdid)))">
      <!-- es existiert kein laufender webdriver -->
      <ti type="rec" flag="block">
      <ti>Driver is currently NOT RUNNING:</ti>
      <ti type="call_job" job="do-driver-start" explain="Start Driver"/>
      </ti>
      <ti_break/>
    
    </when>
    <otherwise>
      <ti test="0">Continue with existing webdriver ...</ti>
      <call_job job="rec-get-is-started"/>
      <prop id="rechts">Recording OFF</prop>
      <prop id="rechts" test="(prop,ret-is-started)">Recording ON</prop>
      <!-- <ti label=" " key="(prop,rechts)"></ti> -->      
    </otherwise>
  </choose>
 
</job>
<job id="do-driver-stop" role="hidden">
  <tp>Going to stop WebDriver ...</tp>
  <wdriver id="(prop,wdid)"
           act="closeit"/>  
  <ti label="Webdriver was stopped"/>
                   
</job>                                      
<job id="do-driver-start" role="hidden">
  <choose>
    <when test="(f,not,(f,exists_file,(file,conf-data)))">
      <call_job job="tk_conf_edit" />
      <ti_flush/>
      <tk type="msg">Starting WebDriver now</tk>
    </when>
    <otherwise>
      <call_job job="tk_conf_read" />
      <ti label="Starting Webdriver"/>        
    </otherwise>
  </choose>                    
  
  <when test="(f,not,(f,has,prop,conf_implicit))">
    <prop id="conf_implicit">0</prop>
  </when>  

  <choose>
          
    <when test="(f,eq_text,firefox,(prop,conf_driver_type))">
      <tp>Starting Firefox-Webdriver ...</tp>
      <choose>
        <when test="(f,has,file,conf_driver_firefox)">
          <ti>Starting webdriver: 1 firefox und driver (file,conf_driver_firefox)</ti>
          <wdriver id="(prop,wdid)"
                   act="open"
                   driver_type="firefox"
                   driver_firefox="(file,conf_driver_firefox)"
                   implicit_wait_seconds="(prop,conf_implicit)"/>              
        </when>
        <otherwise>
          <ti>Starting webdriver: 2 firefox</ti>
          <wdriver id="(prop,wdid)"
                   act="open"
                   driver_type="firefox" 
                   implicit_wait_seconds="(prop,conf_implicit)"/>              
        </otherwise>
      </choose>
      <ti>Did start Firefox-Webdriver.</ti>
      <ti type="call_job" job="do-driver-stop" explain="Stop WebDriver"/>
    </when>
    
    <when test="(f,eq_text,chrome,(prop,conf_driver_type))">
      <tp>Starting Chrome-Webdriver ...</tp>
                   
      <wdriver id="(prop,wdid)"
               act="open"
               driver_type="chrome"
               conf_chrome_binary="(f,vob,file,conf_chrome_binary)"
               conf_chrome_driver="(f,vob,file,conf_chrome_driver)"
               conf_driver_headless_chrome="(f,vob,prop,conf_driver_headless_chrome)"
               conf_driver_disablegpu_chrome="(f,vob,prop,conf_driver_disablegpu_chrome)"
               implicit_wait_seconds="(prop,conf_implicit)"/>    
               
      <ti>Did start Chrome-Webdriver.</ti>
      <ti type="call_job" job="do-driver-stop" explain="Stop WebDriver"/>                                          
    </when>   
    
    <when test="(f,eq_text,edge,(prop,conf_driver_type))">
      <tp>Starting Edge-Webdriver ...</tp>
                   
      <wdriver id="(prop,wdid)"
               act="open"
               driver_type="edge"
               conf_edge_driver="(f,vob,file,conf_edge_driver)"

               implicit_wait_seconds="(prop,conf_implicit)"/>    
               
      <ti>Did start Edge-Webdriver.</ti>
      <ti type="call_job" job="do-driver-stop" explain="Stop WebDriver"/>                                          
    </when>  
               
    <otherwise>
      <throw>unknown type of driver: [(prop,conf_driver_type)]</throw>
    </otherwise>
  
  </choose>

  <choose>
    <when test="(f,exists,coop2,at.nicolas.webwalk.wd,(prop,wdid))">         
      <wdriver default_id="(prop,wdid)"
               act="set_default_id"/> 
    </when>
    <otherwise>
      <throw>Webdriver was started but was afterwards not found in system under the coop-id (prop,wdid). Looks like a app-problem. Problem: the coop at.nicolas.webwalk.wd called (prop,wdid) does not exist.</throw>
    </otherwise>
  </choose>   
                    
</job>



<!-- setting the default-values -->
<job id="tk_conf_default" role="hidden">
  
  <need default="chrome">(prop,conf_driver_type)</need>
  <need default="">(file,conf_chrome_binary)</need>
  <need default="">(file,conf_chrome_driver)</need>
  <need default="">(file,conf_edge_driver)</need>
  <need default="">(prop,conf_driver_headless_chrome)</need>  
  <need default="">(prop,conf_driver_disablegpu_chrome)</need>   
  <need default="">(file,conf_driver_firefox)</need> 
  <need default="">(prop,conf_implicit)</need>
  
  
    
  <!-- 
  <need default="2">(prop,conf_implicit)</need>   
  <need default="1">(prop,conf_scale_loc_x)</need>
  <need default="1">(prop,conf_scale_loc_y)</need>
  <need default="1">(prop,conf_scale_size_x)</need>
  <need default="1">(prop,conf_scale_size_y)</need>     -->
  
  
  
</job>

