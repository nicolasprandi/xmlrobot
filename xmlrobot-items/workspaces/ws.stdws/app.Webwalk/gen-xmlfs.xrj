</job><job role="hidden" id="xmlf-edit">
<need>(prop,xmlf_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="xmlf-read" />
<prop id="isAdd">0</prop>
<call_job job="xmlf-editor" />
<call_job job="xmlf-write" />
<ti align="right" x="Did update Test-File '(f,text,cut_nice,(prop,xmlf_name),20)'" />
<call_job job="xmlf-see-all" />
</job><job role="hidden" id="xmlf-del">
<need>(prop,xmlf_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="xmlf-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Test-File [ (f,text,cut_nice,(prop,xmlf_name),20) (prop,xmlfs_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,xmlfs)" where="(prop,xmlfs_offset)xmlf[@row='(prop,xmlf_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,xmlf_name),20) #(prop,xmlf_key)</tp>
<ti label="Did delete Test-File:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,xmlf_name),20)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="xmlf-see-all" />
</job><job role="hidden" id="xmlf-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Test-File(prop,xmlfs_offset_label)" />
<prop x="sum" id="xmlfs_tk_control" />
</when>
<otherwise>
<need>(prop,xmlf_key)</need>
<prop id="label" x="Test-File [(f,text,cut_nice,(prop,xmlf_name),20)](prop,xmlfs_offset_label)" />
<prop x="sum_only" id="xmlfs_tk_control" />
</otherwise>
</choose>
<call_job job="xmlf-tk" />
</job><job id="xmlf-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="xmlf-editor" />
<prop id="xmlf_key">1</prop>
<when test="(f,not,(f,exists,prop,xmlfs_offset_new_key))">
<prop id="xmlfs_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,xmlfs)" sort="@row" number="@row" xpath="(prop,xmlfs_offset_new_key)xmlf">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="xmlf_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Test-File: #(prop,xmlf_key)</i>
<call_job job="xmlf-write" />
<ti align="right" x="Did add Test-File '(f,text,cut_nice,(prop,xmlf_name),20)'" />
<choose>
<when test="(f,has,prop,post_add_script_xmlf)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_xmlf)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="xmlf-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="xmlf-write">
<need>(prop,xmlf_key) (prop,isAdd)</need>
<spirit act="open" id="xmlfs_spirit_tc" xml="(file,xmlfs)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,xmlfs_offset),/)">
<prop id="offset2" x="(f,substring,(prop,xmlfs_offset),0,(f,sub,(f,len,(prop,xmlfs_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,xmlfs_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="xmlfs_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;xmlf row="(prop,xmlf_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="xmlfs_spirit_tc" where="(prop,xmlfs_offset)xmlf[@row='(prop,xmlf_key)']" attribute="name" value="(f,vob,prop,xmlf_name)" />
<file id="jack-in" x="(file,xmlf_file)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="xmlfs_spirit_tc" where="(prop,xmlfs_offset)xmlf[@row='(prop,xmlf_key)']" attribute="file" value="(prop,jack-result)" />
<file id="jack-in" x="(file,xmlf_xsl_result)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="xmlfs_spirit_tc" where="(prop,xmlfs_offset)xmlf[@row='(prop,xmlf_key)']" attribute="xsl_result" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="xmlfs_spirit_tc" where="(prop,xmlfs_offset)xmlf[@row='(prop,xmlf_key)']" attribute="xsl_paras" value="(f,vob,prop,xmlf_xsl_paras)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="xmlfs_spirit_tc" where="(prop,xmlfs_offset)xmlf[@row='(prop,xmlf_key)']" attribute="desc" value="(f,vob,prop,xmlf_desc)" />
<spirit act="close" flag="save pretty" id="xmlfs_spirit_tc" />
</job></jobs>
