<job id="topmenu-auto">
  <when test="(f,has,prop,auto)">
    <need>(prop,auto-menu)</need>
  </when>
    
  <wdriver act="find_elements"
           by_xpath="//table[@class='tiTable0']//a"
           new_spirit_id="found"      
           flag="keep"
           return_prop_count="nbr-found-elements"
           return_prop_single_id="found-single-id"
           wait="2000" wait_for="presence_all"/>

  <prop id="calcid">(f,spirit,found,//we[@text='Calculate'],@id)</prop>
  <prop id="listid">(f,spirit,found,//we[@text='List'],@id)</prop>
  <ti>(prop,calcid) (prop,listid) (f,spirit,found,count?,//we[@text='Calculate']) (f,spirit,found,count?,//we)</ti>
          
  <choose>
    <when test="(f,has,prop,auto)">
      <choose>
        <when test="(f,eq_text,(prop,auto-menu),c)">
          <prop id="menusel" x="calculate"/>
        </when>
        <when test="(f,eq_text,(prop,auto-menu),l)">
          <prop id="menusel" x="list"/>
        </when>        
        <otherwise>
          <throw>Property 'auto-menu' has an unexpected value of '(f,vob,prop,auto-menu)' or does not exist at all. if auto is on then the property auto-menu must have the value 'c' or 'l'</throw>
        </otherwise>
      </choose>      
    </when>
    <otherwise>
      <tk type="sel" id="menusel">
        <sel>calculate</sel> 
        <sel>list</sel>
      </tk>
    </otherwise>
  </choose>
  
  
  <choose>
    <when test="(f,eq_text,(prop,menusel),calculate)">
      <prop id="click">(prop,calcid)</prop>
    </when>
    <when test="(f,eq_text,(prop,menusel),list)">
      <prop id="click">(prop,listid)</prop>
    </when>    
  </choose>
  
  <wdriver 
    act="build_element"
    element_id="(prop,click)"
    sleep="1000"/>                                            
  
  <welement id="(prop,click)"
    act="click"         
    sleep="1000"/> 
    
  <spirit id="found" act="close"/>    
</job>

