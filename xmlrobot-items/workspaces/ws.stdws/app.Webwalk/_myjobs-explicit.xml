<job id="field-selektor">
    
  <wdriver act="find_elements"
           by_xpath="//table[@class='tkReviewFieldsTable']//a"
           new_spirit_id="found"      
           flag="keep"
           return_prop_count="nbr-found-elements"
           wait="2000" wait_for="presence_all"/>
  
  <!-- save spirit -->      
  <file id="found" x="(dir,cache)found.xml"/>
  <spirit id="found" act="save" out="(file,found)"/>
  <ti type="file" label="Found:" x="(file,found)" />
   
  <!-- open print for selection result sr -->
  <file id="sr" x="(dir,cache)list-sr.xml"/>
  <print id="sr" out="(file,sr)" act="open"/>
  <print id="sr" act="print">&lt;sel&gt;</print>
 
  <file id="gui" x="(dir,cache)list-gui.xml"/>
  <print id="gui" out="(file,gui)" act="open"/>
  <print id="gui" act="print">&lt;sel&gt;</print>
          
  <loop id="sx" xml="(file,found)" xpath="//we">
    
    <prop id="take">1</prop>
    
    <when test="(f,eq_text,(loop,sx,@text),Alles Bearbeiten)">
      <prop id="take">0</prop>
    </when>

    <when test="(f,eq_text,(loop,sx,@text),  ??  )">
      <prop id="take">0</prop>
    </when>

    <when test="(f,eq_text,(loop,sx,@text),Abbruch)">
      <prop id="take">0</prop>
    </when>
    
    <when test="(f,eq_text,(loop,sx,@text),Schrittweise Bearbeiten)">
      <prop id="take">0</prop>
    </when>

    <when test="(f,eq_text,(loop,sx,@text),  ?  )">
      <prop id="take">0</prop>
    </when>
    
    <when test="(f,eq_text,(loop,sx,@text),Sort &amp; Delete)">
      <prop id="take">0</prop>
    </when>
    
    <when test="(f,eq_text,(loop,sx,@text),Sort &amp; Delete)">
      <prop id="take">0</prop>
    </when>
    
    <when test="(f,eq_text,(loop,sx,@text),Sort &amp; Delete)">
      <prop id="take">0</prop>
    </when>            
        
    <!-- -->
    <when test="(prop,take)">
      <print id="sr" act="print">(f,spirit,found,xml?,//we[(loop,sx,#i)])</print>
      <print id="gui" act="print">&lt;sel label=&quot;(loop,sx,@text)&quot;&gt;(f,spirit,found,//we[(loop,sx,#i)],@id)&lt;/sel&gt;</print>
    </when>              
             
  </loop>    
  <print id="sr" act="print">&lt;/sel&gt;</print> 
  <print id="sr" act="close"/>   
  <ti type="file" label="Selection Result:" x="(file,sr)" />   

  <print id="gui" act="print">&lt;/sel&gt;</print> 
  <print id="gui" act="close"/>   
  <ti type="file" label="Gui-Selektor:" x="(file,gui)" />  
  <spirit id="found" act="close"/>
  
  <tk type="sel" id="row" xml="(file,gui)" flag="nono"/>
  
  <!-- <tk type="msg">row = (prop,row)</tk>  -->
  <wdriver 
    act="build_element"
    element_id="(prop,row)"/>    
    
  <welement id="(prop,row)"
    act="click" />    
    
  
</job>

