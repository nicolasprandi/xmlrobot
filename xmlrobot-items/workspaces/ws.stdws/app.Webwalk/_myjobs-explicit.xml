<job id="enter-single-field-auto">

  
  <when test="(f,has,prop,auto)">
    <need>(prop,auto-value)</need>
  </when>  
  
  <wdriver act="find_elements"
           by_xpath="//input"
           new_spirit_id="found"      
           flag="keep"
           return_prop_count="nbr-found-elements"
           wait="3000" wait_for="presence_all"/>

  <ti label="xml:">(f,spirit,found,xml?)</ti>
  
  <throw test="(f,not,(f,eq_num,3,(prop,nbr-found-elements)))">enter-single-field-auto does not find 3 input-tags. instead it found (prop,nbr-found-elements) of them.</throw>
  
  <choose>
    <when test="(f,has,prop,auto)">                                               
      <prop id="yourinput">(prop,auto-value)</prop>  
    </when>
    <otherwise>
      <tk id="yourinput"/>
    </otherwise>
  </choose>
    
  <prop id="fieldid">(f,spirit,found,//we[2],@id)</prop> 
  <prop id="okid">(f,spirit,found,//we[3],@id)</prop>   
  
  <wdriver 
    act="build_element"
    element_id="(prop,fieldid)"/>   

  <welement 
    act="clear"
    id="(prop,fieldid)"/>
                                           
  <welement 
    act="send_keys"
    id="(prop,fieldid)"
    keys="(prop,yourinput)"/>   
    
  <wdriver 
    act="build_element"
    element_id="(prop,okid)"/>     
    
  <welement id="(prop,okid)"
    act="click"         
    sleep="(f,random,1000,2000)"/>     
             
  <spirit id="found" act="close"/>    
</job>

