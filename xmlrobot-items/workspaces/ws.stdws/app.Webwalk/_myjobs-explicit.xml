<job id="add-vi">
    
  <wdriver act="find_elements"
           by_xpath="//table[@class='tiTable1']//a"
           new_spirit_id="found"      
           flag="keep"
           return_prop_count="nbr-found-elements"
           wait="2000" wait_for="presence_all"/>
   
  <ti label="should be 2:">(f,spirit,found,count?,//we) (prop,nbr-found-elements)</ti>  
  
  <choose>
    <when test="(f,gt,(f,spirit,found,count?,//we[@text='  + Vi  ']),0)">
      <prop id="searchtext">  + Vi  </prop>
    </when>
    <when test="(f,gt,(f,spirit,found,count?,//we[@text='Add another Vi']),0)">
    <prop id="searchtext">Add another Vi</prop>
    </when>    
    <otherwise>
      <throw>no + vi and no add another vi</throw>
    </otherwise>
  </choose>
  <file id="prot" x="(dir,cache)addvi.xml"/>
  <spirit id="found" act="save" out="(file,prot)"/>
  <ti type="file" label="found:" x="(file,prot)" />
   
       
