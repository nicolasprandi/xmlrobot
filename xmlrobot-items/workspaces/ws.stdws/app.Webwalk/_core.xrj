<job id="prepare1" role="hidden">
  <call_job job="tk_reco_read"
    test="(f,not,(f,has,prop,reco_storage))"/>
  <prop id="varprefix" x="(prop,reco_prefix)"/>  
</job>

<job id="make-enter-element" role="hidden">
  <need>(prop,with-element)</need>
  <need default="">(prop,key-class)</need>
  <prop id="dc-we" x="(prop,with-element)"/>
  <call_job job="prep-coop"/>
  
  <call_job job="prepare1"/>
  <tk id="enter"/>
  
  <prop id="var-enter" x="(prop,varprefix)enter"/> 
  <prop id="(prop,var-enter)" x="(prop,enter)"/>
  

      <call_job job="record">
          <prop id="steps"><![CDATA[()  <need>(prop,()(prop,var-enter)())</need>                                             
  <welement 
    act="send_keys()(prop,key-class)()"
    id="(prop,with-element)"
    keys="(prop,()(prop,var-enter)())"/>      
()]]></prop>      
      </call_job> 
                                                 
     
  <ti label="Did Enter"/>
  <ti label="What:">(prop,enter)</ti>
  <ti label="in Element">(prop,with-element)</ti>
  <ti label="Key-Style" test="(f,has,prop,key-class)">(prop,key-class)</ti>
  <ti_hr_break/>
  <call_job job="do-more"/>
    
</job>

<job id="make-enter-element-freestyle" role="hidden">
  <need>(prop,with-element)</need>
  <prop id="dc-we" x="(prop,with-element)"/>
  <call_job job="prep-coop"/>
                                                            
  <call_job job="prepare1"/>
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(dir,pro)hold-and-enter.xml" />
    <prop id="joe-in-regex" x="enter|keycode" />
  </call_job>    
  
  <tk label="Hold a key and enter text" flag="sum">
  <tk id="enter"/>
  <tk id="keycode" type="sel">
    <sel>SHIFT</sel>
    <sel>CONTROL</sel>
    <sel>ALT</sel>
    <sel>SPACE</sel>
    <sel>COMMAND</sel>
    <sel>F1</sel>
    <sel>F2</sel>
    <sel>F3</sel>
    <sel>F4</sel>
    <sel>F5</sel>
    <sel>F6</sel>
    <sel>F7</sel>
    <sel>F8</sel>
    <sel>F9</sel>
    <sel>F10</sel>
    <sel>F11</sel>
    <sel>F12</sel>    
    <sel>NUMPAD0</sel>
    <sel>NUMPAD1</sel>
    <sel>NUMPAD2</sel>
    <sel>NUMPAD3</sel>
    <sel>NUMPAD4</sel>
    <sel>NUMPAD5</sel>
    <sel>NUMPAD6</sel>
    <sel>NUMPAD7</sel>
    <sel>NUMPAD8</sel>
    <sel>NUMPAD9</sel> 
    </tk>
  </tk>
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(dir,pro)hold-and-enter.xml" />
    <prop id="joe-in-regex" x="enter|keycode" />
  </call_job>   
  
  <prop id="var-enter" x="(prop,varprefix)enter"/> 
  <prop id="(prop,var-enter)" x="(prop,enter)"/>
  
  <prop id="var-keycode" x="(prop,varprefix)keycode"/> 
  <prop id="(prop,var-keycode)" x="(prop,keycode)"/>  
  

      <call_job job="record">
          <prop id="steps"><![CDATA[()  <need>(prop,()(prop,var-enter)())</need>                                             
  <welement 
    act="send_keys_freestyle"
    id="(prop,with-element)"
    keys="(prop,()(prop,var-enter)())"
    keycode="(prop,()(prop,var-keycode)())"/>      
()]]></prop>      
      </call_job> 
                                                 
     
  <ti label="Did Enter with holded key"/>
  <ti label="What:">(prop,enter)</ti>
  <ti label="Holded key:">(prop,keycode)</ti>
  <ti label="in Element">(prop,with-element)</ti>
  
  <ti_hr_break/>
  <call_job job="do-more"/>
    
</job>

<job id="make-key-element" role="hidden">
  <need>(prop,with-element)</need>
  <need default="0">(prop,key-by-selection)</need>

  <prop id="dc-we" x="(prop,with-element)"/>
  <call_job job="prep-coop"/>
  
  <call_job job="prepare1"/>
  <prop id="keycode-tip">https://www.selenium.dev/selenium/docs/api/java/org/openqa/selenium/Keys.html#values(e:o)(e:c)&#xA;UP&#xA;ARROW_UP&#xA;DOWN&#xA;ARROW_DOWN</prop>
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(dir,pro)keycode.xml" />
    <prop id="joe-in-regex" x="enter" />
  </call_job>   
  <choose>
    <when test="(prop,key-by-selection)">
      <tk id="enter" 
      tip="(prop,keycode-tip)" type="sel">
      <sel>NULL</sel>
<sel>CANCEL</sel>
<sel>HELP</sel>
<sel>BACK_SPACE</sel>
<sel>TAB</sel>
<sel>CLEAR</sel>
<sel>RETURN</sel>
<sel>ENTER</sel>
<sel>SHIFT</sel>
<sel>LEFT_SHIFT</sel>
<sel>CONTROL</sel>
<sel>LEFT_CONTROL</sel>
<sel>ALT</sel>
<sel>LEFT_ALT</sel>
<sel>PAUSE</sel>
<sel>ESCAPE</sel>
<sel>SPACE</sel>
<sel>PAGE_UP</sel>
<sel>PAGE_DOWN</sel>
<sel>END</sel>
<sel>HOME</sel>
<sel>LEFT</sel>
<sel>ARROW_LEFT</sel>
<sel>UP</sel>
<sel>ARROW_UP</sel>
<sel>RIGHT</sel>
<sel>ARROW_RIGHT</sel>
<sel>DOWN</sel>
<sel>ARROW_DOWN</sel>
<sel>INSERT</sel>
<sel>DELETE</sel>
<sel>SEMICOLON</sel>
<sel>EQUALS</sel>
<sel>NUMPAD0</sel>
<sel>NUMPAD1</sel>
<sel>NUMPAD2</sel>
<sel>NUMPAD3</sel>
<sel>NUMPAD4</sel>
<sel>NUMPAD5</sel>
<sel>NUMPAD6</sel>
<sel>NUMPAD7</sel>
<sel>NUMPAD8</sel>
<sel>NUMPAD9</sel>
<sel>MULTIPLY</sel>
<sel>ADD</sel>
<sel>SEPARATOR</sel>
<sel>SUBTRACT</sel>
<sel>DECIMAL</sel>
<sel>DIVIDE</sel>
<sel>F1</sel>
<sel>F2</sel>
<sel>F3</sel>
<sel>F4</sel>
<sel>F5</sel>
<sel>F6</sel>
<sel>F7</sel>
<sel>F8</sel>
<sel>F9</sel>
<sel>F10</sel>
<sel>F11</sel>
<sel>F12</sel>
<sel>META</sel>
<sel>COMMAND</sel>
<sel>ZENKAKU_HANKAKU</sel>
      </tk>
    </when>
    <otherwise>
      <tk id="enter" 
      tip="(prop,keycode-tip)" />
    </otherwise>
  </choose>
  
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(dir,pro)keycode.xml" />
    <prop id="joe-in-regex" x="enter" />
  </call_job>   
  
  <prop id="var-enter" x="(prop,varprefix)enter"/> 
  <prop id="(prop,var-enter)" x="(prop,enter)"/>
  

   

      <call_job job="record">
          <prop id="steps"><![CDATA[()  <need>(prop,()(prop,var-enter)())</need>                                             
  <welement 
    act="send_keycode"
    id="(prop,with-element)"
    keycode="(prop,()(prop,var-enter)())"/>      
()]]></prop>      
      </call_job>       
                                                 
     
  <ti label="Did KeyCode"/>
  <ti label="What:">(prop,enter)</ti>
  <ti label="in Element">(prop,with-element)</ti>
  <ti_hr_break/>
  <call_job job="do-more"/>
    
</job>

<job id="make-mouse-element" role="hidden">
  <need>(prop,with-element)</need>
  <prop id="dc-we" x="(prop,with-element)"/>
  <call_job job="prep-coop"/>

      <call_job job="record">
          <prop id="steps"><![CDATA[()  <need>(prop,with-element)</need>                                             
  <welement 
    act="mouse_over"
    id="(prop,with-element)" 
    webdriver_id="(prop,wdid)"/>      
()]]></prop>      
      </call_job> 

  <ti type="rec">
    <ti explain="(prop,with-element)" type="call_job" job="do-more">
      <prop id="dc-we" x="(prop,with-element)"/>
    </ti> 
    <ti> - Was moused to</ti>  
  </ti>
  <!-- 
  <ti label="Scrolled to" explain="(prop,with-element)" type="call_job" job="do-more">
    <prop id="dc-we" x="(prop,with-element)"/>
  </ti>   -->
  
  <ti_hr/>   
  
   <call_job job="finally"/>
  
   
</job>
<job id="finally" role="hidden">
   <choose>
    <when test="(f,has,prop,finally-return-ps-print-spirit)">
      <!-- <ti_break/> -->
      <spirit act="open" id="(prop,ps-id)" file="(file,prot)" />
      <prop id="ps-print-should-mark">(prop,with-element)</prop>
      <call_job job="ps-print-spirit" />
    </when>
    <otherwise>
      <call_job job="do-more"/>
    </otherwise>
  </choose>
</job>

<job id="make-scroll-element" role="hidden">
  <need>(prop,with-element)</need>
  <prop id="dc-we" x="(prop,with-element)"/>
  <call_job job="prep-coop"/>

      <call_job job="record">
          <prop id="steps"><![CDATA[()  <need>(prop,with-element)</need>                                             
  <welement 
    act="scroll"
    id="(prop,with-element)" 
    webdriver_id="(prop,wdid)"/>      
()]]></prop>      
      </call_job> 

  <ti type="rec">
    <ti explain="(prop,with-element)" type="call_job" job="do-more">
      <prop id="dc-we" x="(prop,with-element)"/>
    </ti> 
    <ti> - Was scrolled to</ti>  
  </ti>
  <!-- 
  <ti label="Scrolled to" explain="(prop,with-element)" type="call_job" job="do-more">
    <prop id="dc-we" x="(prop,with-element)"/>
  </ti>   -->
  
  <ti_hr/>   
  
  <choose>
    <when test="(f,has,prop,finally-return-ps-print-spirit)">
      <!-- <ti_break/> -->
      <spirit act="open" id="(prop,ps-id)" file="(file,prot)" />
      <prop id="ps-print-should-mark">(prop,with-element)</prop>
      <call_job job="ps-print-spirit" />
    </when>
    <otherwise>
      <call_job job="do-more"/>
    </otherwise>
  </choose>
  
   
</job>


<job id="make-light-element" role="hidden">
  <need>(prop,with-element)</need>
  <prop id="dc-we" x="(prop,with-element)"/>
  <call_job job="prep-coop"/>
  
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <welement 
    act="light"
    id="(prop,with-element)" 
    webdriver_id="(prop,wdid)"/>      
()]]></prop>      
      </call_job> 
          
  <ti type="rec">
    <ti explain="(prop,with-element)" type="call_job" job="do-more">
      <prop id="dc-we" x="(prop,with-element)"/>
    </ti> 
    <ti> - Was Highlighted</ti>  
  </ti>  
    
  
  <ti_hr/>
 
      
  <choose>
    <when test="(f,has,prop,finally-return-ps-print-spirit)">
      <ti_break/>
      <spirit act="open" id="(prop,ps-id)" file="(file,prot)" />
      <prop id="ps-print-should-mark">(prop,with-element)</prop>
      <call_job job="ps-print-spirit" />
    </when>
    <otherwise>
      <call_job job="do-more"/>
    </otherwise>
  </choose>         
</job>

<job id="make-unlight-element" role="hidden">
  <need>(prop,with-element)</need>
  <prop id="dc-we" x="(prop,with-element)"/>
  <call_job job="prep-coop"/>
  
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <welement 
    act="unlight"
    id="(prop,with-element)" 
    webdriver_id="(prop,wdid)"/>      
()]]></prop>      
      </call_job> 
          
  
    
  <ti label="Un-Highlighted" x="(prop,with-element)"/>
  
  <ti_hr/>
 
      
  <choose>
    <when test="(f,has,prop,finally-return-ps-print-spirit)">
      <ti_break/>
      <spirit act="open" id="(prop,ps-id)" file="(file,prot)" />
      <prop id="ps-print-should-mark">(prop,with-element)</prop>
      <call_job job="ps-print-spirit" />
    </when>
    <otherwise>
      <call_job job="do-more"/>
    </otherwise>
  </choose>         
</job>

 


<job id="make-screenshot-element" role="hidden">

  <need>(prop,with-element)</need>
  <prop id="dc-we" x="(prop,with-element)"/>
  <call_job job="prep-coop"/>
  
  <need default="0">(prop,fast)</need>


  
  <sequence id="ss"  act="next"/>
  <tk id="screenshot-title"  label="Filename" rule="filename_with_blanks"/>
  <choose>
    <when test="(f,has,prop,screenshot-title)">
      <file id="output">(dir,screens)(prop,screenshot-title)</file>
    </when>
    <otherwise>
      <file id="output" x="(dir,screens)element-(prop,with-element)"/>
    </otherwise>
  </choose>
  <when test="(f,exists_file,(file,output).png)">
    <file id="output">(file,output)-(f,sequence,ss)</file>
  </when>
   <file id="output">(file,output).png</file>
  <tk label="Save to" flag="sum_only" test="(f,not,(prop,fast))">
  <tk type="file" id="output" flag="save"/>
  </tk>
  <call_job job="tk_conf_read" />
  
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <welement 
    act="screenshot"
    id="(prop,with-element)" 
    webdriver_id="(prop,wdid)"
    file="(file,output)"
    error_id="no-element-screenshot"
    />
  <ti type="file" x="(file,output)" flag="naked"/>      
()]]></prop>      
      </call_job>     
  <!-- 
    scale_loc_x="(f,vob,prop,conf_scale_loc_x)"
    scale_loc_y="(f,vob,prop,conf_scale_loc_y)"
    scale_size_x="(f,vob,prop,conf_scale_size_x)"
    scale_size_y="(f,vob,prop,conf_scale_size_y)"
   -->
  
  <!-- 
  <ti type="call_job" job="see-screenshot">
    <file id="with" x="(file,output)"/>
  </ti>          -->
  <ti type="img"  x="(file,output)"/>
  <ti_hr/>   
  <call_job job="do-more"/>    
</job>






<job id="clear-memory" role="hidden">
    <need default="0">(prop,really)</need>
    <need default="0">(prop,memory-all)</need>
                                           
   
   <ask out="(dir,pro)memo.xml" what="coops" style="natural" />
   
    <when test="(f,and,(prop,really),(prop,memory-all))">
      <prop id="cnt-element">(f,xsl,(dir,pro)memo.xml,()count(ws/coops/coop[@memory='keep'][@type='at.nicolas.webwalk.we'])())</prop>
       <tk label="Clear complete memory ?">
       <tk type="msg" msg_type="w" x="(prop,cnt-element) Element(f,plural,(prop,cnt-element)) will be removed."/>   
       </tk>   
    </when>      
       
   <ti type="file" x="(dir,pro)memo.xml" />
   <ti_flush/>
   
   <choose>
    <when test="(prop,memory-all)">
      <prop id="clear_lower_than">100000000000000</prop>
      <prop id="clear_higher_than">1</prop>
    </when>
    <otherwise>
   
       <prop id="clear_lower_than_label">ends including</prop>
       
       <prop id="clear_higher_than_label">starts including</prop>
      
       
      <call_job job="go-joe-read">
        <file id="joe-in-store" x="(dir,pro)memory-lower-input.xml" />
        <prop id="joe-in-regex" x="clear_lower_than|clear_higher_than" />
      </call_job>   
         
        <tk label="(f,when,(prop,really),Clear Elements of Memory,See Elements of Memory)" 
            flag="sum">
        <tk id="clear_higher_than" 
            label="(prop,clear_higher_than_label)" 
            flag="nono"
            x="1"/>            
        <tk id="clear_lower_than" 
            label="(prop,clear_lower_than_label)" 
            flag="nono"
            x="9999"/>
            
            
        </tk>
    
      <call_job job="go-joe-write">
        <file id="joe-in-store" x="(dir,pro)memory-lower-input.xml" />
        <prop id="joe-in-regex" x="clear_lower_than|clear_higher_than" />
      </call_job>  
    </otherwise>
    </choose>
      
   <prop id="did" x="0"/>
   
   <loop id="weg" 
   xml="(dir,pro)memo.xml" 
   xpath="coops/coop[@memory='keep'][@type='at.nicolas.webwalk.we']"
   xxxpath="coops/coop[@memory='keep']"
   sort="@keeplessId"
   number="@keeplessId"
   missing_strategy="empty">
    <when test="(f,lte_num,(loop,weg,@keeplessId),(prop,clear_lower_than))">
    <when test="(f,gte_num,(loop,weg,@keeplessId),(prop,clear_higher_than))">
      <ti_hr test="(f,eq_num,0,(prop,did))" />
      <prop id="did" x="(f,add,(prop,did),1)"/>
      <choose>
        <when test="(prop,really)">
          
             
          
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <welement id="(loop,weg,@id)" act="closeit"/>
  <ti label="Removed:">(loop,weg,@id)</ti>                
()]]></prop>      
      </call_job> 
                     
        </when>
        <otherwise>
          <try_catch>
            <try>
              <ti type="rec" >          
                <ti type="call_job" job="do-more" explain="(loop,weg,@id)">
                  <prop id="dc-we" x="(loop,weg,@id)"/>
                </ti>
                <ti type="call_job" job="clear-memory-element" explain="Delete">
                  <prop id="dc-we" x="(loop,weg,@id)"/>
                </ti>
                  <ti x="(f,welement,(loop,weg,@id),tag_name)"/>
                  <ti x="(f,replace,(f,welement,(loop,weg,@id),text),&#xA;, )"/>  
                  
              </ti>
            </try>
            <catch>
              <ti type="rec" >          
                <ti type="call_job" job="do-more" explain="(loop,weg,@id)">
                  <prop id="dc-we" x="(loop,weg,@id)"/>
                </ti>
                <ti type="call_job" job="clear-memory-element" explain="Delete">
                  <prop id="dc-we" x="(loop,weg,@id)"/>
                </ti>
                <ti span="2">(f,replace,(prop,catched_msg),&#xA;, )</ti>

              </ti>            
            </catch>
          </try_catch>
        </otherwise>
      </choose>

    </when>
    </when>
   </loop>
   <ti_hr/>
   
   <choose>
     <when test="(f,eq_num,0,(prop,did))">
      <ti type="rec">
      <ti>Didn&apos;t find anything </ti>
      </ti>
     </when>
     <otherwise>
      <ti label="(f,when,(prop,really),Did remove,Did list)">(prop,did) Element(f,plural,(prop,did))</ti>
     </otherwise>
   </choose>                   
   
   <ti_hr_break/>
  <call_job job="Memory-Classic">
    <prop id="memory-no-help">1</prop>
  </call_job>                               
</job>

<job id="clear-memory-element" role="hidden">
  <need>(prop,dc-we)</need>
  <tk label="Delete Element?">
  <tk type="msg" msg_type="w">Id: (prop,dc-we)
Tag: (f,welement,(prop,dc-we),tag_name)(f,when,(f,has,(f,welement,(prop,dc-we),text)),
Text: (f,welement,(prop,dc-we),text),)                         
</tk>
</tk>
  
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <welement id="(prop,dc-we)" act="closeit"/>
  <ti label="Removed:">(prop,dc-we)</ti>                
()]]></prop>      
      </call_job> 
      
  <call_job job="Memory-Classic">
    <prop id="memory-no-help">1</prop>
  </call_job>    
</job>


<job id="new-close-tab" role="hidden">
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <wdriver act="close_tab" />      
()]]></prop>      
      </call_job>   
  
  
</job>

<job id="new-switch-window-index" role="hidden">
  <tk id="index"  test="(f,not,(f,has,prop,index))" label="Position-Number of Tab"/>
  <wdriver act="switch_tab" by_index="(f,sub,(prop,index),1)"/>
  
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <wdriver act="switch_tab" by_index="(f,sub,(prop,index),1)"/>        
()]]></prop>      
      </call_job> 
      <ti label="Did Switch Tab #(prop,index)" />
      <ti_hr_break/>
      <call_job job="??"/> 
  
</job>

<job id="new-switch-window-pos" role="hidden">
  <tk id="pos"  test="(f,not,(f,has,prop,pos))"/>
  
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <wdriver act="switch_tab" by_pos="(prop,pos)"/>        
()]]></prop>      
      </call_job>   
</job>

<job id="new-switch-window-id" role="hidden">
  <tk id="id" test="(f,not,(f,has,prop,id))" tip="The tab-id is that number in the list of tabs."/>
  
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <wdriver act="switch_tab" by_id="(prop,id)"/>        
()]]></prop>      
      </call_job>     
      
      <ti label="Did Switch to Tab with id: (prop,id)" />
      <ti_hr_break/>
      <call_job job="??"/>       
</job>

</jobs>