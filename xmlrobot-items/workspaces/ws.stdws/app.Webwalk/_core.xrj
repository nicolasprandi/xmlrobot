    </ti>   
  
    <ti> | </ti>

<ti type="call_job" job="make-screenshot-element" explain="Picture this"> 
    <prop id="with-element" x="(prop,dc-we)"/>
  </ti>  
  <ti> | </ti> 
    <ti type="call_job" job="make-light-element" explain="Highlight"> 
