    <prop id="dc-we" x="(prop,dc-we)"/>
  </ti> 
    <ti> | </ti>
  <ti type="call_job" job="make-enter-element" explain="Enter Text"> 
    <prop id="with-element" x="(prop,dc-we)"/>
  </ti> 
  <ti>   </ti>
  <ti type="call_job" job="act-enter" explain="Clear and enter a text"> 
    <prop id="with-element" x="(prop,dc-we)"/>
    <prop id="dc-we" x="(prop,dc-we)"/>
   <prop id="do-then-see-more">1</prop>
  </ti>
      
      
  </ti>  
  
  <ti type="rec">
  <ti type="call_job" job="do-control-click" explain="Control-Click"> 
    <prop id="dc-we" x="(prop,dc-we)"/>
    
  </ti>
  <ti> | </ti>
  <ti type="call_job" job="make-key-element" explain="Press Key"> 
    <prop id="with-element" x="(prop,dc-we)"/>
    <prop id="key-by-selection" x="1"/>
  </ti>  
  <ti>  </ti>
 
  <ti type="call_job" job="act-varinput" explain="Clear and select a value"> 
    <prop id="with-element" x="(prop,dc-we)"/>
    <prop id="dc-we" x="(prop,dc-we)"/>
    <prop id="do-then-see-more">1</prop>
  </ti>    
  
  </ti>
  
  <ti type="rec">
  <ti type="call_job" job="do-click" explain="Click"> 
    <prop id="dc-we" x="(prop,dc-we)"/>
    
  </ti>  
  <ti> | </ti>

