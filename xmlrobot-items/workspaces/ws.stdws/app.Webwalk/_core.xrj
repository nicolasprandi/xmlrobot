<?xml version="1.0" ?>

<jobs>

<call_job job="prolog" />
<!-- <ti type="call_job" job="hook-choose-xpath" explain="test"/>  -->
<throw test="(f,gt_num,(f,time,yyyyMMdd),30000101)">Out of service is that great app</throw>

<job id="do-change-color" role="hidden">

  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(dir,pro)highlight-color.xml" />
    <prop id="joe-in-regex" x="color" />
  </call_job>   
      
  <tk id="color" 
      label="Html-Border-Style" 
      x="3px solid red" 
      flag="nono"
      tip="This is a html border style which is used for highlighting"/>
      
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(dir,pro)highlight-color.xml" />
    <prop id="joe-in-regex" x="color" />
  </call_job>         
      
      <call_job job="record">
          <prop id="steps"><![CDATA[()  
  
  <wdriver act="set_light_border"
           light_border="(prop,color)"/>
           ()]]></prop>      
      </call_job>        
</job>
<job id="find-element" role="hidden">
  <ti_hr/>
  
  <call_job job="find-see-all2"/>

</job>

<job id="hook-choose-xpath" role="hidden">
  <need>(prop,find_key) (prop,group_key)</need>
  <!-- <ti>(prop,find_key)</ti>   -->
  
  <call_job job="tk_reco_read"
    test="(f,not,(f,has,prop,reco_prefix))"/>
    
  <prop id="var-spirit" x="(prop,reco_prefix)spirit"/>
  <prop id="(prop,var-spirit)" x="hasen"/>
  
  <spirit id="finds" 
          xml="(file,finds)" 
          act="open"
          missing_strategy="empty"/>
          
  <!-- <interpreter watch="1" />   -->
  <prop id="find_style" x="(f,spirit,finds,group[@row=(f,xpath_string,(prop,group_key))]/find[@row=(f,xpath_string,(prop,find_key))],@style)"/>
  
  <prop id="find_title" x="(f,spirit,finds,group[@row=(f,xpath_string,(prop,group_key))]/find[@row=(f,xpath_string,(prop,find_key))],@title)"/>  
  
  <prop id="search_var">(prop,find_style)</prop>
  <prop id="search_var"                        
        test="(f,eq_text,by_xpath,(prop,search_var))" >xpath</prop>
                                               
  <prop id="search_var_content">(f,xpath,(file,finds),group[@row=(f,xpath_string,(prop,group_key))]/find[@row=(f,xpath_string,(prop,find_key))],@(prop,search_var))</prop>
  <prop id="search_var_content_unescaped">(prop,search_var_content)</prop>
  
  <escape type="prop" id="search_var_content"/>
    
  <!-- 
  <prop id="var-xpath" x="(prop,reco_prefix)xpath"/>
  <prop id="(prop,var-xpath)" x="(f,xpath,(file,finds),group[@row=(f,xpath_string,(prop,group_key))]/find[@row=(f,xpath_string,(prop,find_key))],@xpath)"/>  
  -->
  
  <prop id="ps-desc" x="Go: (prop,find_style) &apos;(prop,search_var_content)&apos;"/>
  <ti type="rec" key="(prop,find_title)">
  <ti>Go: (prop,find_style) &apos;(f,html,b,o)(prop,search_var_content_unescaped)(f,html,b,c)&apos;</ti>
  </ti>

  <tp>(prop,ps-desc) ...</tp>  
  
  <call_job job="tk_conf_read" />
  
  <choose>
    <when test="(f,not,(f,has,prop,conf_implicit))">
      <prop id="tkx">e</prop>
    </when>
    <when test="(f,eq_text,,(prop,conf_implicit))">
      <prop id="tkx">e</prop>
    </when>
    <when test="(f,eq_num,0,(prop,conf_implicit))">
      <prop id="tkx">e</prop>
    </when>    
    <otherwise>
      <prop id="tkx">i</prop>
    </otherwise>
  </choose>
  
  <choose>
    <when test="(f,eq_text,i,(prop,tkx))">

      <call_job job="record">
          <prop id="steps"><![CDATA[
  <wdriver act="find_elements"
           (prop,find_style)="(prop,search_var_content)"
           new_spirit_id="found"      
           flag="keep"
           return_prop_count="nbr-found-elements"
           return_prop_single_id="found-single-id"/>]]></prop>      
      </call_job>       
      
    </when>
                
    <when test="(f,eq_text,e,(prop,tkx))">

      <call_job job="record">
          <prop id="steps"><![CDATA[
  <wdriver act="find_elements"
           (prop,find_style)="(prop,search_var_content)"
           new_spirit_id="found"      
           flag="keep"
           return_prop_single_id="found-single-id"
           return_prop_count="nbr-found-elements"/>
         
           ]]></prop>      
      </call_job>       
      
    </when>   
   </choose> 
          
      <!--       <ti>found single id=(f,vob,prop,found-single-id)</ti>
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <need>(prop,()(prop,var-spirit)())</need>
  <need>(prop,()(prop,var-xpath)())</need>
  <wdriver act="find_elements"
           by_xpath="(prop,()(prop,var-xpath)())"
           new_spirit_id="(prop,()(prop,var-spirit)())"
           flag="keep"/>
           ()]]></prop>      
      </call_job>       
      -->
       
      <prop id="ps-desc" x="finding (prop,find_style) &apos;(prop,search_var_content)&apos;"/>
      <prop id="ps-desc" x="(prop,ps-desc) on url &apos;(f,wdriver,?,get_url)&apos;" flag="catch"/>
      <prop id="ps-desc" x="(prop,ps-desc) with title &apos;(f,wdriver,?,get_title)&apos;" flag="catch" />
      
  <!-- <interpreter watch="0" />  --> 
  <spirit id="finds" act="close"/>        
       
    <call_job job="ps-print-spirit">
      <!-- <prop id="ps-xpath" x="(f,vob,prop,(prop,var-xpath))" />  -->
      <prop id="ps-id" x="found" />
      <prop id="ps-type" x="find_elements" />
      <prop id="ps-desc">(prop,ps-desc)</prop>
      <prop id="ps-count" x="(prop,nbr-found-elements)" />
      <prop id="ps-single-id" x="(f,vob,prop,found-single-id)" test="(f,has,prop,found-single-id)"/>
    </call_job> 
  
     <call_job job="record">
        <prop id="steps"><![CDATA[()  <spirit id="found" act="close"/>
        ()]]></prop>      
    </call_job>    

</job>

<job id="save-as-file" role="hidden">
  <need default="get_xml">(prop,saf-action)</need>  
  <need default="pagesource">(prop,saf-how)</need>  
  <ti label="Saving to file"/>
  <ti label="action:">(prop,saf-action)</ti>
  <ti label="how:">(prop,saf-how)</ti>
  
  <sequence id="pages"  act="next"/>
  <tk label="Save to file">
  <tk id="tit" label="Titel" flxag="nono" tip="action=(prop,saf-action) how=(prop,saf-how)" />
  </tk>
    
  <prop id="kurzz">(prop,tit)-(f,time)</prop>
  <tk label="Short Filename" id="kurzz" flag="nono" />
  
  <file id="to_file" x="(dir,pages)(prop,kurzz).(f,substring_after,(prop,saf-action),get_)"/>
    
    
           
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <need>(file,to_file)</need>
  <wdriver act="(prop,saf-action)"
           how="(prop,saf-how)"
           to_file="(file,to_file)"/>
           ()]]></prop>      
      </call_job>            
  <ti label="Done"/>
  <ti label="Result" type="file" x="(file,to_file)"/>
  <ti label="Type">(prop,saf-how)</ti>
  


</job>

<job id="get-html-dom" role="hidden">
  <need default="get_dom">(prop,style)</need>  
  <sequence id="pages"  act="next"/>
  <tk id="tit" label="Titel" flxag="nono"/>
    
  <file id="to_file" x="(dir,pages)(prop,tit)-(f,time).(f,when,(f,eq_text,get_dom,(prop,style)),html,xml)"/>
    
    
           
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <need>(file,to_file)</need>
  <wdriver act="(prop,style)"
           to_file="(file,to_file)"/>
           ()]]></prop>      
      </call_job>            

  <ti label="Result" type="file" x="(file,to_file)"/>
  


</job>



<job id="go-somewhere" role="hidden">
  <need>(prop,go-url)</need>
  <call_job job="tk_reco_read"
    test="(f,not,(f,has,prop,reco_storage))"/>
    
  <prop id="varprefix" x="(prop,reco_prefix)"/>
  <prop id="var-url" x="(prop,varprefix)url"/>  
  
  <prop id="(prop,var-url)" x="(prop,go-url)"/>
  <call_job job="record">
      <prop id="steps"><![CDATA[()  <need>(prop,()(prop,var-url)())</need>
  <wdriver act="get"
           url="(prop,()(prop,var-url)())"/>
           ()]]></prop>      
  </call_job>
  <tp>Finished get</tp>
  <ti label="Went to" xx="(f,vob,prop,(prop,var-url))"/>
  <ti labyel="Went to" x="(f,vob,prop,(prop,var-url))"/>
  <call_job job="find-element" />
  <!-- 
  <when test="(f,has_flag,(prop,reco_storage),file)">
  
    <tp>Starting find-elelemnts</tp> 
    <file id="found" x="(dir,pro)nicolas-tag-a.xml"/> 
  
    <prop id="var-file" x="(prop,varprefix)found"/>      
    <file id="(prop,var-file)" x="(file,found)"/>   
    <call_job job="record">
        <prop id="steps"><![CDATA[()  <need>(file,()(prop,var-file)())</need>
  <wdriver act="find_elements"
           by_tag_name="a"
           new_file="(file,()(prop,var-file)())" 
           flag="keep"/>
  <ti type="file" x="(file,()(prop,var-file)())" />
    ()]]></prop>      
    </call_job>  
       
                       
     <tp>finished find-elelemnts</tp>   
  
  </when>
  -->
</job>





<job id="go-back" role="hidden">

  <call_job job="record">
      <prop id="steps"><![CDATA[
      ()  <wdriver act="back"/>()]]></prop>      
  </call_job>  
  
  <call_job job="post-nav"/>       
  <ti_hr_break/>           
  <ti label="Did go to previous page" />           
</job>

<job id="go-forward" role="hidden">

  <call_job job="record">
      <prop id="steps"><![CDATA[
      ()  <wdriver act="forward"/>()]]></prop>      
  </call_job>  
  
  
  
  
  <call_job job="post-nav"/>     
  <ti_hr_break/>   
  <ti label="Did go to next page" />          
             
</job>

<job id="go-back2" role="hidden">

  <call_job job="record">
      <prop id="steps"><![CDATA[
      ()  <wdriver act="back2"/>()]]></prop>      
  </call_job>  

  <call_job job="post-nav"/>     
  <ti_hr/>       
  <ti label="Did go to previous page" />
            
             
</job>

<job id="go-refresh" role="hidden">

  <call_job job="record">
      <prop id="steps"><![CDATA[
      ()  <wdriver act="refresh"/>()]]></prop>      
  </call_job>  

  <call_job job="post-nav"/>     
  <ti_hr/>       
  <ti label="Did Refresh Page" />             
</job>

<job id="scroll-to-end" role="hidden">
  
  
  <call_job job="record">
      <prop id="steps"><![CDATA[
      ()  <wdriver act="scroll_to_end"/>()]]></prop>      
  </call_job>    


  <call_job job="post-nav"/>     
  <ti_hr/>       
  <ti label="Did Scoll to End of Page" />
                               
</job>

<job id="scroll-to-begin" role="hidden">
  
  
  <call_job job="record">
      <prop id="steps"><![CDATA[
      ()  <wdriver act="scroll_to_begin"/>()]]></prop>      
  </call_job>    

  <call_job job="post-nav"/>     
  <ti_hr/>           
  <ti label="Did Scoll to Begin of Page" />  
                                 
</job>

<job id="scroll" role="hidden">
  <call_job job="tk_scroll_edit"/>
  
  <call_job job="record">
      <prop id="steps"><![CDATA[
      ()<wdriver act="scroll" x="(prop,scroll_x)" y="(prop,scroll_y)"/>()]]></prop>      
  </call_job> 
    
 
  
  <call_job job="post-nav"/>  
  <ti_hr/>           
  <ti label="Did Scoll by x(e:s) y" />                                
</job>

 <job id="scroll-bit-down" role="hidden">
  <call_job job="record">
      <prop id="steps"><![CDATA[
      ()<wdriver act="scroll" x="0" y="200"/>()]]></prop>      
  </call_job> 
  
  <call_job job="post-nav"/>     
  <ti_hr/>           
  <ti label="Did Scoll Down"/>
 
</job>

<job id="scroll-bit-up" role="hidden">
  <call_job job="record">
      <prop id="steps"><![CDATA[
      ()<wdriver act="scroll" x="0" y="-200"/>()]]></prop>      
  </call_job> 
  <call_job job="post-nav"/>     
  <ti_hr/>           
  <ti label="Did Scoll Up"/>
</job>

<job id="post-nav" role="hidden">
  <!-- 
  <ti_hr/>
  <ti type="call_job" job="??" explain="See current Situation"/>
  <ti type="call_job" job="|| Selektoren ||"/>   
  <ti_hr_break/>           -->
  <call_job job="navigation"/>

</job>


<job id="screenshot" role="hidden">
  <sequence id="ss"  act="next"/>
  <tk id="screenshot-name" label="Name of Screen" rule="filename_with_blanks" x="screenshot-(f,sequence,ss)"/>
  <file id="file" x="(dir,screens)(prop,screenshot-name).png"/>
  
  <tk label="Screenshot" flag="(f,when,(f,file_exists,(file,file)),sum,sum_only)">
    <tk type="file" id="file" xflag="nono" tip="(f,when,(f,file_exists,(file,file)),Warning: Such a file exists already: (prop,screenshot-name),)"/>
  </tk>
  
  <tk type="msg" msg_type="w" test="(f,file_exists,(file,file))" >File exists already and is going to be overwritten</tk>
    <call_job job="record">
      <prop id="steps"><![CDATA[
      ()  <wdriver act="screenshot" file="(file,file)"/>()]]></prop>      
  </call_job>  
  
  
  <ti label="Done"/>
  <ti type="file" x="(file,file)"/>
  <file id="with" x="(file,file)"/>
  <call_job job="see-screenshot"/>
  <!-- 
  <ti type="call_job" job="see-screenshot">
    <file id="with" x="(file,file)"/>
  </ti>          -->
                               
</job>



<job id="ps-print-spirit" role="hidden">
  <need>(prop,ps-id) (prop,ps-type) (prop,ps-desc)</need>
  <tp>Doing Report of type (prop,ps-type) ...</tp>
  
  <file id="prot" x="(dir,cache)latest_(prop,ps-type).xml"/>
  <spirit id="(prop,ps-id)" act="save" out="(file,prot)"/>
  <ti type="file" label="Received:" x="(file,prot)" test="(prop,debug)"/>
  
  <prop id="ps-counter" x="0"/>
  
  <loop_xml 
    act="open" 
    id="lx" 
    spirit="(prop,ps-id)" 
    xpath="we" missing_strategy="empty"/>


   
  <loop id="wx" while="()(f,loop_xml,lx,has_next?)()">
    <loop_xml act="next" id="lx" />
    <prop id="ps-counter" x="(f,add,1,(prop,ps-counter))"/>
    
    <ti label=" " type="rec" test="(f,eq_num,1,(prop,ps-counter))">
      <ti> </ti>
      <ti> </ti>       
      <ti> </ti>
      <ti> </ti>  
      <ti> </ti> 
 
      <ti >text</ti>  
      <ti align="center">tag</ti>
      
      <ti align="center">disp</ti>
      <ti align="center">enab</ti>
      <ti align="center">sel</ti>  
    </ti>
    <prop id="ps-elementid" x="(f,loop_xml,lx,@id)"/>    
    <prop id="ps-marker"></prop>    
    <prop id="ps-marker-o"></prop> 
    <prop id="ps-marker-c"></prop>                       
    <when test="(f,has,prop,ps-print-should-mark)">
      <when test="(f,eq_text,(prop,ps-print-should-mark),(prop,ps-elementid))">
        <prop id="ps-marker">* </prop>
        <prop id="ps-marker-o">(f,html,b,o)</prop> 
        <prop id="ps-marker-c">(f,html,b,c)</prop>         
      </when>
    </when>
                     

    <ti type="rec">
      <!-- 
      <ti type="call_job" job="do-more" 
          explain="(f,substring,(f,loop_xml,lx,@text),0,30)"
          prefix="(prop,ps-marker)">
        <prop id="dc-we" x="(f,loop_xml,lx,@id)"/>
      </ti>  -->     
      <ti type="call_job" job="do-more" 
          explain="(f,loop_xml,lx,@id)" 
          postfix="(prop,ps-marker)">
        <prop id="dc-we" x="(f,loop_xml,lx,@id)"/>
      </ti>   
      <ti type="call_job" job="act-plus" explain="f +">
        <prop id="with-element" x="(f,loop_xml,lx,@id)"/>
        <prop id="dc-we" x="(f,loop_xml,lx,@id)"/>
        <prop id="ps-id">(prop,ps-id)</prop>
        <prop id="ps-type">(prop,ps-type)</prop>
        <prop id="ps-desc">(prop,ps-desc)</prop>
        <file id="prot">(file,prot)</file>
        <prop id="finally-return-ps-print-spirit">1</prop>         
        
      </ti>       
      <ti type="call_job" job="make-mouse-element" explain="Mouse">
        <prop id="with-element" x="(f,loop_xml,lx,@id)"/>
        <prop id="dc-we" x="(f,loop_xml,lx,@id)"/>
        <prop id="ps-id">(prop,ps-id)</prop>
        <prop id="ps-type">(prop,ps-type)</prop>
        <prop id="ps-desc">(prop,ps-desc)</prop>
        <file id="prot">(file,prot)</file>
        <prop id="finally-return-ps-print-spirit">1</prop>        
      </ti>     

                

      <ti type="call_job" job="make-light-element" explain="Light">
        <prop id="with-element" x="(f,loop_xml,lx,@id)"/>
        <prop id="dc-we" x="(f,loop_xml,lx,@id)"/>
        <prop id="ps-id">(prop,ps-id)</prop>
        <prop id="ps-type">(prop,ps-type)</prop>
        <prop id="ps-desc">(prop,ps-desc)</prop>
        <file id="prot">(file,prot)</file>
        <prop id="finally-return-ps-print-spirit">1</prop>         
        
      </ti>    
            
      <ti type="call_job" job="do-click" explain="Click">
        <prop id="with-element" x="(f,loop_xml,lx,@id)"/>
        <prop id="dc-we" x="(f,loop_xml,lx,@id)"/>
        <prop id="ps-id">(prop,ps-id)</prop>
        <prop id="ps-type">(prop,ps-type)</prop>
        <prop id="ps-desc">(prop,ps-desc)</prop>
        <file id="prot">(file,prot)</file>
        <prop id="finally-return-ps-print-spirit">1</prop>    
      </ti>
                
      <ti type="call_job" job="make-scroll-element" explain="Scroll">
        <prop id="with-element" x="(f,loop_xml,lx,@id)"/>
        <prop id="dc-we" x="(f,loop_xml,lx,@id)"/>
        <prop id="ps-id">(prop,ps-id)</prop>
        <prop id="ps-type">(prop,ps-type)</prop>
        <prop id="ps-desc">(prop,ps-desc)</prop>
        <file id="prot">(file,prot)</file>
        <prop id="finally-return-ps-print-spirit">1</prop>        
      </ti>  
       

            

                                                  
        
      
      
      <ti wrap="word">(f,substring,(f,loop_xml,lx,@text),0,30)</ti>
      <ti align="center">(f,loop_xml,lx,@tag_name)</ti>
      <ti align="center">(f,loop_xml,lx,@is_displayed)</ti>
      <ti align="center">(f,loop_xml,lx,@is_enabled)</ti>
      <ti align="center">(f,loop_xml,lx,@is_selected)</ti>
    </ti>  
    <ti_space height="3px" />
  </loop>  
  <loop_xml id="lx" act="close"/>
  <!-- 
  <when test="(f,eq_num,1,(prop,ps-counter))">
    <ti  type="rec">
      <ti  >(f,html,b,o)Found just one thing(f,html,b,o)</ti>
    </ti>
    <ti type="call_job" job="do-one-element">
      <prop id="doe-element-id" x="(prop,ps-elementid)"/>
      <prop id="doe-xpath" x="(prop,ps-xpath)"/>
    </ti>
  </when>    -->
  <ti_hr_break/>

  <choose>
    <when test="(f,not,(f,has,prop,ps-count))">
    </when>                                           
    <when test="(f,eq_num,(prop,ps-count),(prop,ps-counter))">
    </when>  
    <otherwise>
      <ti label="There is an internal problem" />
      <ti>Counters do not match  (prop,ps-count) &lt;&gt; (prop,ps-counter)</ti>
    </otherwise>
  </choose>
  <choose>
  <when test="(f,gt_num,(prop,ps-counter),0)">
    
    <ti label="List of WebElements"/>
    <ti x="(prop,ps-counter)"  label="Count:" />     
    <ti explain="(f,vob,prop,ps-single-id)"  
        label="Single-Id:" 
        test="(f,has,prop,ps-single-id)"
        type="call_job"
        job="do-more">
        <prop id="dc-we" x="(prop,ps-single-id)"/>
    </ti>
    <ti type="rec" label="Xml:">
    <ti type="file" x="(file,prot)"  />   
    </ti>

    <!--
    <ti type="call_job" job="archify" explain="Archify this Xml-File"
      label=" ">
      <file id="prot" x="(file,prot)"/>
      <prop id="prot-type" x="(prop,ps-type)"/>
      <prop id="prot-desc" x="(prop,ps-desc)"/>    
    </ti>
    -->    
 
  </when>
  <otherwise>
    <ti>didn&apos;t find anything</ti>
  </otherwise>
  </choose>
</job>

<job id="archify" role="hidden">
  <need>(file,prot)</need>
  <need>(prop,prot-type)</need>
  <need>(prop,prot-desc)</need>
  <sequence id="archives" act="next"/>
  
  <tk id="title" rule="filename" tip="(prop,prot-desc)"/>

  <file id="arc" x="(dir,smart)(prop,prot-type)/(prop,title).xml"/>
  <tk type="msg"
      msg_type="w"
      test="(f,exists_file,(file,arc))">The file
(file,arc)
exists already!
Continue with overwriting ?
  </tk>            
  <mkdir dir="(dir,smart)(prop,prot-type)"/>
  <copy file="(file,prot)" tofile="(file,arc)"/>
  <ti label="Created" type="file" x="(file,arc)"/>
</job>

<job id="do-one-element" role="hidden">
  <interpreter watch="1"/>

   
  <need>(prop,doe-element-id)</need>
  <need>(prop,doe-xpath)</need>
  <ti>xpath=(prop,doe-xpath)</ti>
  
  <call_job job="prepare1" /> 
  <prop id="var-xpath" x="(prop,reco_prefix)xpath"/>
  <prop id="(prop,var-xpath)" x="(prop,doe-xpath)"/> 
  
  <prop id="var-return" x="(prop,reco_prefix)return"/>
  <prop id="(prop,var-return)" x="return"/> 
  <tp>selecting 1 thing ...</tp>  
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <need>(prop,()(prop,var-xpath)())</need>
  <wdriver act="find_element2"
           by_xpath="(prop,()(prop,var-xpath)())"
           return_prop_element_id="(prop,()(prop,var-return)())"
           flag="keep"/>
           ()]]></prop>      
      </call_job>       
      
      <call_job job="do-more">
        <prop id="dc-we" x="(f,vob,prop,(prop,var-return))"/>
      </call_job>   
  
</job>

<job id="prep-coop" role="hidden">
  
  <need>(prop,dc-we)</need>
  <need default="0">(prop,debug)</need>
   <!-- 
  <try_catch>
    <try>
      <prop id="prep-coop:test" x="(f,welement,(prop,dc-we),is_displayed)"/>
      <prop id="prep-coop:exists" x="1"/>
    </try>
    <catch>
      <prop id="prep-coop:exists" x="0"/>
    </catch>
  </try_catch>
 --> 
 
  <prop id="prep-coop:exists" x="(f,welement,(prop,dc-we),exists)"/>
  
  
  <choose>
    <when test="(prop,prep-coop:exists)">
      <ti test="(prop,debug)">das element '(prop,dc-we)' ist schon geladen</ti>
    </when>
    <otherwise>
      <call_job job="record">
        <prop id="steps"><![CDATA[()  <need>(prop,dc-we)</need>
  <wdriver 
    act="build_element"
    element_id="(prop,dc-we)" />
           ()]]></prop>      
      </call_job>   
              
      <ti label="loaded element:" x="(prop,dc-we)" test="(prop,debug)"/>
          
    </otherwise>
  </choose>
    
    

</job>

<job id="see-entire-text" role="hidden">
  <need>(prop,dc-we)</need>
  <call_job job="prep-coop"/>
  <ti>(f,welement,(prop,dc-we),text)</ti>
</job>

<job id="do-more" role="hidden">
  <need>(prop,dc-we)</need>
  <call_job job="prep-coop"/>
  <choose>
    <when test="(f,gt_num,(f,len,(f,welement,(prop,dc-we),text)),100)">
      <ti label="(prop,dc-we): (f,cut,nice,(f,welement,(prop,dc-we),text),100)"/>
      <ti type="call_job" job="see-entire-text" explain="See complete text">
        <prop id="dc-we">(prop,dc-we)</prop>
      </ti>
    </when>
    <otherwise>
      <ti label="(prop,dc-we): (f,welement,(prop,dc-we),text)"/>
    </otherwise>
  </choose>
  
  <ti_hr/>
  <ti type="rec">
     <ti>(f,html,b,o)Mouse(f,html,b,c)</ti>
     <ti> | </ti>
     <ti>(f,html,b,o)Keyboard(f,html,b,c)</ti>
     <ti>   </ti>

  </ti>
      
  <ti type="rec">
