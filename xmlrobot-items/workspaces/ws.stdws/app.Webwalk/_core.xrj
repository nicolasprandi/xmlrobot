    <ti labxel=" " type="call_job" job="do-switch-to-frame" explain="Switch to this frame"> 
      <prop id="dc-we" x="(prop,dc-we)"/>
    </ti>   
    <ti labxel=" " type="call_job" job="do-iframes-parent" explain="Go to parent-frame"/>
    <ti labxel=" " type="call_job" job="do-iframes-select" explain="See all frames"/>
