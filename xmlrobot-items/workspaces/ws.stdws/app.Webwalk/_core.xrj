<job id="do-click" role="hidden">
  <need>(prop,dc-we)</need>
  
  <call_job job="prep-coop"/>
      
  <try_catch>
    <try> 
      <call_job job="record">
          <prop id="steps"><![CDATA[()  <welement id="(prop,dc-we)"
    act="click"/>
()]]></prop>      
      </call_job>       
      <ti label="Did Click: (prop,dc-we)"/>  
            
    </try>
    <catch>
      <ti label="Could not click"/>
      <ti label="msg" x="(prop,catched_msg)"/>
      <ti label="class" x="(prop,catched_class)"/>
    </catch>
  </try_catch>
<ti_hr/>           
  <call_job job="finally"/>                               

    <ti_hr/>
  <call_job job="find-see-all2"/>  
  
       

</job>

<job id="do-switch-to-frame" role="hidden">
