<!--default -->
<job id="tk_selxpa_default" role="hidden">
  <need default="regex">(prop,selxpa_type)</need>
  <need default="(dir,temp)">(dir,selxpa_dir)</need>
</job>


<!-- selxpa-core, make your changes here -->
<job id="tk_selxpa_core" role="hidden" tip="selxpa_: Tk Internal">

  <need default="">(prop,tk_selxpa_add_flag)</need>

  <tk label="Parameters: selxpa_" 
      flag="(prop,tk_selxpa_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 
      
    <tk id="selxpa_xpath"
        type="textblock"
        label="Textblock"               
      	test_first="0"/>       

                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_selxpa_edit" tip="selxpa_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,selxpa-data))">
      <!-- data exists already -->
      <prop id="tk_selxpa_add_flag" x="sum_only print"/>
      <call_job job="tk_selxpa_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_selxpa_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_selxpa_default"/>
  <!-- doing input -->
  <call_job job="tk_selxpa_core"/>
  
  <!-- writing data -->
  <call_job job="tk_selxpa_write"/>

</job>



<job id="tk_selxpa_print_values" tip="selxpa_: Prints the entered values" role="hidden">
  
  <call_job job="tk_selxpa_read"/>
  
  <call_job job="tk_selxpa_core">
    <prop id="tk_selxpa_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_selxpa_print_values_tips" tip="selxpa_: Prints values and tips" role="hidden">
  
  <call_job job="tk_selxpa_read"/>
  
  <call_job job="tk_selxpa_core">
    <prop id="tk_selxpa_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_selxpa_print_help" tip="selxpa_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_selxpa_core">
    <prop id="tk_selxpa_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_selxpa_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,selxpa-data)" />
    <prop id="joe-in-regex" x="(prop,selxpa-regex)" />    
  </call_job>
  <call_job job="tk_selxpa_default"/>

</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_selxpa_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,selxpa-data)" />
    <prop id="joe-in-regex" x="(prop,selxpa-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_selxpa_clear"  tip="selxpa_: Clears the data" role="hidden">
  <delete file="(file,selxpa-data)"/>
</job>


</jobs>