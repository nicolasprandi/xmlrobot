  <call_job job="extjob-see-all"/>
</job>
  -->
<job id="Configuration?">
  <call_job job="tk_conf_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_conf_clear" explain="Clear this data"/>
</job>

<job id="My-Jobs" role="hidden">
  <call_job job="extension-jobs"/>
</job>
<job id="My-Jobs?">
  <ti label="Extending Jobs for this project"/>
  <call_job job="extjob-see-all"/>
</job>
</jobs>