  <call_job job="tk_conf_print_values"/>
  <ti type="call_job" job="tk_conf_edit" explain="Edit" label=" "/>
  <ti type="call_job" job="do-driver-start" 
    explain="Do start the driver now" label=" "
    test="(f,not,(f,exists,coop2,at.nicolas.webwalk.wd,(prop,wdid)))"/>
  <ti_hr/>
  <ti label="Colors"/>
  <ti type="call_job" job="do-change-color" explain="Change highlight-color"/>  
