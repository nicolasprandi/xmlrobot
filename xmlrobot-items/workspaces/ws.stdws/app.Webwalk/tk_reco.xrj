<!-- setting the default-values -->
<job id="tk_reco_default" role="hidden">

  <need default="regex">(prop,reco_type)</need>
  <need default="(dir,temp)">(dir,reco_dir)</need>
  <need default="manu">(prop,reco_turn)</need>
  <need default="0">(prop,reco_history)</need>
  <need default="0">(prop,reco_ask)</need>
  <need default="file">(prop,reco_storage)</need>
  <need default="paras_">(prop,reco_prefix)</need>
  <need default="(dir,pro)recordings/recording.xml">(file,reco_file)</need>
</job>


<!-- reco-core, make your changes here -->
<job id="tk_reco_core" role="hidden" tip="reco_: Tk Internal">

  <need default="">(prop,tk_reco_add_flag)</need>

  <tk label="Recorder-Configuration" 
      flag="(prop,tk_reco_add_flag)"
      xtip="()Search Parameters is a list of values which will control the search-routine.()"> 

    <tk type="msg" x="Record to file"
        test_first="0"/>   
    <tk id="reco_file" 
        type="file" 
        label="Record to"  
        flag="save"
        extension=".xml" 
        test_first="0"        
        base="(dir,recordings)"
        x2="(dir,recordings)recording.xml"       
        tip="()The file to which the recording goes()"/>
        
    <tk id="reco_history"
        type="bool"
        label="Backup"
        tip="Makes a backup of every overwritten recording in the same folder with a sequenced number"       
      	test_first="0"/> 
        
    <tk type="msg"
        x="Recorder Operation"
        test_first="0"/>               
        
    <tk id="reco_turn"
        type="sel"  
        label="Start Recorder" 
        
        test_first="0"        
        tip="()Specifies in which cases the recorder is turned on()">
        <sel label="Turn On Automatically">auto</sel>
        <sel label="Turn on Manually">manu</sel> 
        <sel label="Ask for turning on">ask</sel>   
    </tk>
    
    <!-- 
    <tk id="reco_ask"
    
        type="bool"
        label="Ask for Recording"       
      	test_first="0"
        tip="Will ask for every stepgroup to record"/>   -->
        
    <tk type="msg"
        x="Styles"
        test_first="0"/>               
    <!--     
    <tk id="reco_storage"
        type="sel"  
        label="Storage" 
                       flag="multi"
        test_first="0"        
        tip="()Persistence()">
        <sel label="spirit">spirit</sel>
        <sel label="file">file</sel> 
    </tk>       -->
    
    <tk id="reco_prefix"
    
        type="text"
        label="Variablen-Prefix"       
      	test_first="0"
        tip="will be the prefix"/>         
                       
  
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_reco_edit" tip="reco_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,reco-data))">
      <!-- data exists already -->
      <prop id="tk_reco_add_flag" x="sum_only print"/>
      <call_job job="tk_reco_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_reco_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_reco_default"/>
  <!-- doing input -->
  <call_job job="tk_reco_core"/>
  
  <!-- writing data -->
  <call_job job="tk_reco_write"/>

</job>



<job id="tk_reco_print_values" tip="reco_: Prints the entered values" role="hidden">
  
  <call_job job="tk_reco_read"/>
  
  <call_job job="tk_reco_core">
    <prop id="tk_reco_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_reco_print_values_tips" tip="reco_: Prints values and tips" role="hidden">
  
  <call_job job="tk_reco_read"/>
  
  <call_job job="tk_reco_core">
    <prop id="tk_reco_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_reco_print_help" tip="reco_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_reco_core">
    <prop id="tk_reco_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_reco_read" role="hidden">
  <call_job job="go-joe-read">
    <prop id="joe-in-regex" x="(prop,reco-regex)" />  
    <file id="joe-in-store" x="(file,reco-data)" />
  </call_job>
  <call_job job="tk_reco_default"/>

</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_reco_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,reco-data)" />
    <prop id="joe-in-regex" x="(prop,reco-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_reco_clear"  tip="reco_: Clears the data" role="hidden">
  <delete file="(file,reco-data)"/>
</job>


</jobs>