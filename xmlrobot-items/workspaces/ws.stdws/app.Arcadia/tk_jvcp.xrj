<jobs>

<!--

-->
<call_job job="prolog" />
<job id="sys_project_setup" role="hidden">
      <tk type="msg" >This is the project setup of (prop,pro)
[ Configuration ]
Continue with configuring up the project ...</tk>
<call_job job="sys_project_setup2" />
</job>
<job id="sys_project_setup2" role="hidden">
<when test="(f,not,(f,exists_file,(file,jvcp-data)))">
  <call_job job="tk_jvcp_read"/>
  
    <tk id="jvcp_repo_type" 
        label="Repository Type"
        type="sel" 
        tip="()The general type of repository ()" flag="nono">
        <sel label="File-System">fs</sel>
        <sel label="GitHub">gh</sel>                
    </tk>
            
    <choose>
      <when test="(f,eq_text,fs,(prop,jvcp_repo_type))">
        <tk id="jvcp_fs" 
            label="Directory"                
            tip="()The directory of the fs-repo ()" 
            type="dir" />       
      </when>
      <when test="(f,eq_text,gh,(prop,jvcp_repo_type))">
        <tk id="jvcp_repo" 
            label="Repo"                
            tip="()The repository, eg UdoScotti/github-xmlrobot-test1 ()" /> 
                          
        <tk id="jvcp_connectA" 
            label="Cred Connect A"
            tip="Connect A"/> 
        <tk id="jvcp_connectB" 
            label="Cred Connect B" 
            tip="Connect B"/>        
      </when>      
    </choose>  
        
    <call_job job="tk_jvcp_write"/>
</when>                
    <call_job job="tk_jvcp_edit"/>
    
          
       
</job>

<!-- gui Adapters: to copy in the app .... -->

<job id="See Values: jvcp_" role="hidden">
  <call_job job="tk_jvcp_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_jvcp_clear" explain="Clear this data"/>  
</job>

<job id="Edit: Configuration" role="hidden" tip="Specifies the github-repository, user &amp; password">
  <call_job job="tk_jvcp_edit"/>
</job>



<job id="Edit: Java-Compiler?">
  <call_job job="tk_jvcp_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_jvcp_clear" explain="Clear this data"/>
</job>

<!-- 
 <job id="Clear Data: jvcp_">
  <tk type="msg" x="Sure to clear data of jvcp_ ?" msg_type="w"/>
  <call_job job="tk_jvcp_clear"/>
</job>

<job id="Print Values:  jvcp_">
  <call_job job="tk_jvcp_print_values"/>
</job>
<job id="Print Help: jvcp_" role="dev">
  <call_job job="tk_jvcp_print_help"/>
</job>

-->

<!-- setting the default-values -->
<job id="tk_jvcp_default" role="hidden">
  <need default="regex">(prop,jvcp_type)</need>
  <need default="(dir,temp)">(dir,jvcp_dir)</need>
  <need default="UdoScotti/xmlrobotbase">(prop,jvcp_repo)</need>
  <need default="0">(prop,jvcp_dont_fail)</need>
  <need default="0">(prop,jvcp_dont_connect_at_all)</need>
  <need default="0">(prop,jvcp_never_overwrite_java)</need>
  <need default="fs">(prop,jvcp_repo_type)</need>
  <need default="1">(prop,jvcp_jar_unzip_by_ant)</need>
  
</job>


<!-- jvcp-core, make your changes here -->
<job id="tk_jvcp_core" role="hidden" tip="jvcp_: Tk Internal">

  <need default="">(prop,tk_jvcp_add_flag)</need>
  <need default="0">(prop,tk_jvcp_only_repo)</need>
  <need default="(f,not,(prop,tk_jvcp_only_repo))">(prop,jvcp-normal)</need>
  <need default="0">(prop,test_first_repo)</need>
  <need default="0">(prop,jvcp_dont_fail)</need>
  <need default="0">(prop,jvcp_dont_connect_at_all)</need>
  <need default="0">(prop,jvcp_never_overwrite_java)</need>
  <need default="fs">(prop,jvcp_repo_type)</need>
  <need default="Cp1252">(prop,jvcp_encoding)</need>
  <need default="20300101">(prop,jvcp_end_date_coded)</need>
  <need default="Arc-App-Dark">(prop,jvcp_appid_appdark)</need>
  <need default="auto">(prop,jvcp_zelix_type)</need>
  <need default="1">(prop,jvcp_jar_unzip_by_ant)</need>
  
  
    
  <tk label="(f,when,(f,exists,prop,jvcp_header),(f,vob,prop,jvcp_header),Configuration (e:o)java-compiler &amp; credentials(e:c))" 
      flag="(prop,tk_jvcp_add_flag)"
      tip="()Project Configuration()"> 


        
    <tk id="jvcp_repo_type" 
        label="Repository Type"
        test_first="(prop,test_first_repo)" 
        type="sel" 
        tip="()The directory of the fs-repo ()" flag="nono">
        <sel label="File-System">fs</sel>
        <sel label="GitHub">gh</sel>                
    </tk>


       
                    
    <tk type="msg"
        x="File-System Repository"
        test_first="0"/>   
        

                
    <tk id="jvcp_fs" 
        label="Directory"
        test_first="(prop,test_first_repo)"                 
        tip="()The directory of the fs-repo ()" 
        type="dir" />         
    <tk type="msg"
        x="Github Repository"
        test_first="0"/>   
    <tk id="jvcp_repo" 
        label="Repo"
        test_first="(prop,test_first_repo)"                 
        tip="()The repository, eg UdoScotti/github-xmlrobot-test1 ()" /> 
    <tk id="jvcp_opp" 
        label="Optional path"
        test_first="0" test="0"/>                         
    <!-- <tk type="msg"
        x="Credentials"
        test_first="0"
        xtest="(prop,jvcp-normal)"/>   -->
    <tk id="jvcp_connectA" 
        label="Cred Connect A"
        test_first="0" 
        tip="Connect A"
        xtest="(prop,jvcp-normal)"/> 
    <tk id="jvcp_connectB" 
        label="Cred Connect B"
        test_first="0" 
        tip="Connect B"
        xtest="(prop,jvcp-normal)"/>       
    <tk type="msg"
        x="Connectivity"
        test_first="0"
        xtest="(prop,jvcp-normal)"/>     
    <tk id="jvcp_dont_fail" 
        label="Dont fail if no WLAN"
        test_first="0"           type="bool"
        tip="Continues if no internet"/>                                 
    <tk id="jvcp_dont_connect_at_all" 
        label="Dont connect at all"
        test_first="0"           type="bool"
        tip="doesnt connect to gh"/>   
    <tk id="jvcp_never_overwrite_java" 
        label="Never overwrite java-sources"
        test_first="0"           type="bool"
        tip="dh"/>           


 
    <tk type="msg"
        x="Java"
        test_first="0"
        test="(prop,jvcp-normal)"/>  
        
    <tk id="jvcp_first" 
        label="First-Party-Lib"
        test_first="0"                 
        tip="()The First-party-Lib. it is a jar-file. this file will be added to the compile if checked. notwendig fuer libs. zuerst core compilieren, dann diesen duplizieren - zb auf &quot;application-complete-firstlib.jar&quot; , und dann diesen hier verlinken.()" 
        type="file" />  
                   
    <tk id="jvcp_javac" 
        type="file" 
        label="javac.exe"  
        xflag="nono"                 
        tip="()Java Compiler on windows. zb file:///C:Program Files/java/jdk1.8.0_121/bin/javac.exe()"
        test_first="0"
        test="(prop,jvcp-normal)"/>                  
    <tk id="jvcp_encoding" 
        label="Encoding of java"
        test_first="0"                 
        tip="()The encoding of the java-files for the timestamps-replacements ()" 
        type="text" />    
                        
    <tk type="msg"
        x="Zelix"
        test_first="0"/>   
    
    <tk id="jvcp_zelix_type" 
        label="Type of Call"
        test_first="0"          
        type="sel"
        test="(prop,jvcp-normal)"
        tip="Hier wird die Art des Zelix-Aufrufes ausgewaehlt.">
        <sel label="Automatic via Ant">auto</sel>
        <sel label="Manual via Terminal and User-Input">manu</sel>
    </tk>             
        
    <tk id="jvcp_zkm" 
        type="file" 
        label="ZKM.jar"  
        xflag="nono"                 
        tip="()the ZKM.jar of zelix in the zelix-folder; C:\software\zelix\ZKMEval\ZKM.jar()"
        test_first="0"
        test="(prop,jvcp-normal)"/>        
        
    <tk id="jvcp_zkm_default_exclude" 
        type="file" 
        label="defaultExclude"  
        xflag="nono"                 
        tip="()Das DefaultExclude.txt; C:\software\zelix\ZKMEval\defaultExclude.txt()"
        test_first="0"
        test="(prop,jvcp-normal)"/>      
    <tk id="jvcp_zkm_default_trim_exclude" 
        type="file" 
        label="defaultTrimExclude"  
        xflag="nono"                 
        tip="()Das DefaultTrimExclude.txt; C:\software\zelix\ZKMEval\defaultTrimExclude.txt()"
        test_first="0"
        test="(prop,jvcp-normal)"/>                          
                
    <tk type="msg"
        x="Diverses"
        test_first="0"/>   
        
    <tk id="jvcp_auto_class" 
        label="Auto-Class"
        flag="nono"
        test_first="0"          
        type="sel"
        test="(prop,jvcp-normal)"
        tip="Einstellung fuer das automatische Compile aus dem Arc-Customer heraus. Hier wird in typ festgelegt der letzendlich bestimme(e:s) welche parameter-files uebersteuert werden.">
        <sel label="Reconquista">1</sel>
        <sel label="Echnaton-Desktop">2</sel>
        <sel label="Echnaton-WebServer">3</sel>
    </tk>          
                        
    <tk id="jvcp_appid_appdark" 
        label="App-Name Arc-App-Dark"
        test_first="0"                 
        tip="()Echnaton-Connectivity: Das ist der aktuelle app-name von 'Arc-App-Dark'()" 
        type="text"
        flag="nono"/>  
    <tk id="jvcp_proddoku" 
        label="Product-Docu"
        test_first="0"                 
        tip="()Interne Produkt-Dokumentation()" 
        type="textblock"
        flag="big"/>     
        
    <tk id="jvcp_jar_unzip_by_ant" 
        label="Do Jar-Unzip-By-Ant"
        test_first="0"                 
        tip="()Seit terra2 mit java20 funktioniert das unzip von jarfiles mit vfs nicht mehr. wahrscheinlich brauchts neue vfs-version. in der zwischenzeit werden die jars mit ant ungezippt, was hier definiert wird. fehler: Could not find a file provider that can handle file ()" 
        type="bool"
        flag="nono"/>               
    <!--     
    <tk id="jvcp_end_date" 
        label="End yyyyMMdd"
        test_first="0"                 
        tip="()Ende Datum ()" 
        type="text" 
        test="0"/>       
        
    <tk id="jvcp_end_date_coded" 
        label="EndCoded yyyyMMdd"
        test_first="0"                 
        tip="()Das Ende-Datum so wie es im sourcecode definiert ist. dieses wird durch das end-datum ersetzt.()" 
        type="text" 
        test="0" />    
        
    <tk type="msg"
        x="XmlRobot-App-Encryption"
        test_first="0"
        test="(prop,jvcp-normal)"/>   
        
    <tk id="jvcp_xrapp_secret_key" 
        label="Der schluessel"
        test_first="0"                 
        tip="()Damit werden xmlrobot-apps encrypted.()" 
        type="text" />    
        -->                                               
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_jvcp_edit" tip="jvcp_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,jvcp-data))">
      <!-- data exists already -->
      <prop id="tk_jvcp_add_flag" x="sum_only print"/>
      <call_job job="tk_jvcp_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_jvcp_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_jvcp_default"/>
  <!-- doing input -->
  <call_job job="tk_jvcp_core"/>
  
  <!-- writing data -->
  <call_job job="tk_jvcp_write"/>

</job>

<job id="tk_jvcp_edit_repo" tip="jvcp_: Edit the Data" role="hidden">
  <prop id="tk_jvcp_only_repo" x="1"/>
  <prop id="test_first_repo" x="1"/>
  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,jvcp-data))">
      <!-- data exists already -->
      <prop id="tk_jvcp_add_flag" x="sum print"/>
      <call_job job="tk_jvcp_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_jvcp_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_jvcp_default"/>
  <!-- doing input -->
  <call_job job="tk_jvcp_core"/>
  
  <!-- writing data -->
  <call_job job="tk_jvcp_write"/>

</job>



<job id="tk_jvcp_print_values" tip="jvcp_: Prints the entered values" role="hidden">
  
  <call_job job="tk_jvcp_read"/>
  
  <call_job job="tk_jvcp_core">
    <prop id="tk_jvcp_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_jvcp_print_values_small" tip="jvcp_: Prints the entered values" role="hidden">
  
  <call_job job="tk_jvcp_read"/>
  <remove type="prop" id="jvcp_dont_connect_at_all" xflag="catch"/>
  <remove type="prop" id="jvcp_dont_fail" flag="catch"/>
  <remove type="prop" id="jvcp_never_overwrite_java" flag="catch"/>    
  
  
  <call_job job="tk_jvcp_core">
    <prop id="tk_jvcp_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_jvcp_print_values_tips" tip="jvcp_: Prints values and tips" role="hidden">
  
  <call_job job="tk_jvcp_read"/>
  
  <call_job job="tk_jvcp_core">
    <prop id="tk_jvcp_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_jvcp_print_help" tip="jvcp_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_jvcp_core">
    <prop id="tk_jvcp_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_jvcp_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,jvcp-data)" />
    <prop id="joe-in-regex" x="(prop,jvcp-regex)" />
  </call_job>
  <call_job job="tk_jvcp_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_jvcp_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,jvcp-data)" />
    <prop id="joe-in-regex" x="(prop,jvcp-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_jvcp_clear"  tip="jvcp_: Clears the data" role="hidden">
  <delete file="(file,jvcp-data)"/>
</job>


</jobs>