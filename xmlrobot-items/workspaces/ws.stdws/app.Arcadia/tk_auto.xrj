<!-- setting the default-values -->
<job id="tk_auto_default" role="hidden">
  
  <need default="1">(prop,auto_compile)</need>
  <need default="1">(prop,auto_zelix)</need>
           <!--
  <need default="(dir,filetemp)">(dir,auto_dir)</need>
  -->
</job>


<!-- auto-core, make your changes here -->
<job id="tk_auto_core" role="hidden" tip="auto_: Tk Internal">

  <need default="">(prop,tk_auto_add_flag)</need>

  <tk label="Automatic Construction" 
      flag="(prop,tk_auto_add_flag)"
      tip="()Parameters for automatic construction. betrifft den aufruf von customerSet()"> 

    <tk id="auto_compile"
        type="bool"
        label="Auto Compile"       
      	test_first="0"
        flag="no_is_0 nono"     
        tip="()wird compiliert wenn von customer-set aufgerufen()"
        />   
        
    <tk id="auto_zelix"
        type="bool"
        label="Auto zelix"       
      	test_first="0"
        flag="no_is_0 nono"     
        tip="()Ist das ein teil von zelix()"
        />           
    <!--      
    <tk id="auto_typus"
        type="sel"  
        label="Selection Typus" 
        test_first="0"        
        tip="()Explain auto_typus here ...()">
        <sel xlabel="Text">text</sel>
        <sel xlabel="Regex">regex</sel> 
        <sel label="This">this</sel>
        <sel label="That">that</sel>   
    </tk>
    
    <tk type="msg"
        x="Descriptions"
        test_first="0"/>  
        
    <tk id="auto_rain" 
        label="Rain Simple Text"
        test_first="0"
        tip="()()" />
         
    <tk id="auto_wind"
        type="textblock"
        label="Wind Textblock"               
      	test_first="0"
        tip="()()" /> 
        
    <tk id="auto_stones"
        type="textblock"
        flag="big"
        label="Stones Bigscreen"               
      	test_first="0"
        tip="This is about the stones"/>         
        
    
        
    <tk type="msg"
        x="Files and Folders"
        test_first="0"/>   
                     
    <tk id="auto_cat"
        type="sel"
        flag="multi"  
        label="Categories" 
        test_first="0"        
        tip="()Explain auto_cat here ...()">
        <sel>sand</sel>
        <sel>land</sel>
        <sel>band</sel>
        <sel>hand</sel>                  
    </tk>    
    <tk id="auto_dir" 
        type="dir" 
        label="Directory"  
        flagx="nono"                 
        tip="()A directory which serves as intial directory for the file-search.()"
        test_first="0"/>
        
    <tk id="auto_file_read"
        type="file"  
      	label="File to read" 
        xflag="nono"          
        tip="()This file will be read()"
        test_first="0"/>         
      

        
    <tk id="auto_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
            
         
    <tk id="auto_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="auto_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="auto_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="auto_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="auto_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,auto-sel2)"/>
        
    <tk 
      id="auto_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="auto_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="auto_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="auto_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="auto_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="auto_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>
<!-- 
<job id="See Values: auto_" role="dev">
  <call_job job="tk_auto_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_auto_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: auto_">
  <tk type="msg" x="Sure to clear data of auto_ ?" msg_type="w"/>
  <call_job job="tk_auto_clear"/>
</job>

<job id="Print Values:  auto_">
  <call_job job="tk_auto_print_values"/>
</job>
<job id="Print Help: auto_" role="dev">
  <call_job job="tk_auto_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_auto_edit" tip="auto_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,auto-data))">
      <!-- data exists already -->
      <prop id="tk_auto_add_flag" x="sum_only print"/>
      <call_job job="tk_auto_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_auto_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_auto_default"/>
  <!-- doing input -->
  <call_job job="tk_auto_core"/>
  
  <!-- writing data -->
  <call_job job="tk_auto_write"/>

</job>



<job id="tk_auto_print_values" tip="auto_: Prints the entered values" role="hidden">
  
  <call_job job="tk_auto_read"/>
  
  <call_job job="tk_auto_core">
    <prop id="tk_auto_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_auto_print_values_tips" tip="auto_: Prints values and tips" role="hidden">
  
  <call_job job="tk_auto_read"/>
  
  <call_job job="tk_auto_core">
    <prop id="tk_auto_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_auto_print_help" tip="auto_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_auto_core">
    <prop id="tk_auto_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_auto_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,auto-data)" />
    <prop id="joe-in-regex" x="(prop,auto-regex)" />    
  </call_job>
  <call_job job="tk_auto_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_auto_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,auto-data)" />
    <prop id="joe-in-regex" x="(prop,auto-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_auto_clear"  tip="auto_: Clears the data" role="hidden">
  <delete file="(file,auto-data)"/>
</job>


</jobs>