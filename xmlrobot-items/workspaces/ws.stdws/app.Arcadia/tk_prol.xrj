<!-- setting the default-values -->
<job id="tk_prol_default" role="hidden">
  <!--
  <need default="regex">(prop,prol_type)</need>
  <need default="(dir,filetemp)">(dir,prol_dir)</need>
  -->
</job>


<!-- prol-core, make your changes here -->
<job id="tk_prol_core" role="hidden" tip="prol_: Tk Internal">

  <need default="">(prop,tk_prol_add_flag)</need>

  <tk label="Prolog-Specification" 
      flag="(prop,tk_prol_add_flag)"
      tip="()Unter Prolog werden hier xr-steps verstanden die zu beginn ausgefuehrt werden um eine gewisse umgebung herzustellen. speziell fuer den aufruf durch customer-set()"> 

    <tk id="prol_typus"
        type="sel"  
        label="Verwendung" 
        test_first="0" 
        flag="nono"     
        tip="()Welche der Eingaben soll ausgefuhert werden()">
        <sel label="Script-Steps">steps</sel>
        <sel label="Linked-File">link</sel> 
        <sel label="Nichts">no</sel>         
  
    </tk>
    
         
    <tk id="prol_steps"
        type="textblock"
        flag="big bigbig"
        label="Scipt-Steps"               
      	test_first="0"
        tip="()Hier nur die wirklichen Steps eingeben. Kein allgemeines steps-element. Kein Xml-dings am anfang. Einfach eine Liste von Steps!()" /> 
        
    <tk id="prol_link"
        type="file"  
      	label="Linked-File" 
        xflag="nono"          
        tip="()In einer Aracadia-App befindet sich die Prolog-Spec im file: {PROJECT}/-store-{LIBNAME}/prolog-specdef.xml()"
        test_first="0"/>          
    <!--          
    <tk id="prol_stones"
        type="textblock"
        flag="big"
        label="Stones Bigscreen"               
      	test_first="0"
        tip="This is about the stones"/>         
        
    <tk id="prol_sun"
        type="bool"
        label="Sun Boolean"       
      	test_first="0"
        flag="no_is_0"     
        tip="()()"
        />         
        
    <tk type="msg"
        x="Files and Folders"
        test_first="0"/>   
                     
    <tk id="prol_cat"
        type="sel"
        flag="multi"  
        label="Categories" 
        test_first="0"        
        tip="()Explain prol_cat here ...()">
        <sel>sand</sel>
        <sel>land</sel>
        <sel>band</sel>
        <sel>hand</sel>                  
    </tk>    
    <tk id="prol_dir" 
        type="dir" 
        label="Directory"  
        flagx="nono"                 
        tip="()A directory which serves as intial directory for the file-search.()"
        test_first="0"/>
        
       
  

        
    <tk id="prol_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
            
         
    <tk id="prol_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="prol_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="prol_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="prol_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="prol_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,prol-sel2)"/>
        
    <tk 
      id="prol_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="prol_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="prol_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="prol_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="prol_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="prol_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>
<!-- 
<job id="See Values: prol_" role="dev">
  <call_job job="tk_prol_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_prol_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: prol_">
  <tk type="msg" x="Sure to clear data of prol_ ?" msg_type="w"/>
  <call_job job="tk_prol_clear"/>
</job>

<job id="Print Values:  prol_">
  <call_job job="tk_prol_print_values"/>
</job>
<job id="Print Help: prol_" role="dev">
  <call_job job="tk_prol_print_help"/>
</job>

-->
<!-- edit data: read, userinput, write -->
<job id="tk_prol_edit" tip="prol_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,prol-data))">
      <!-- data exists already -->
      <prop id="tk_prol_add_flag" x="sum_only print"/>
      <call_job job="tk_prol_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_prol_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_prol_default"/>
  <!-- doing input -->
  <call_job job="tk_prol_core"/>
  
  <!-- writing data -->
  <call_job job="tk_prol_write"/>

</job>



<job id="tk_prol_print_values" tip="prol_: Prints the entered values" role="hidden">
  
  <call_job job="tk_prol_read"/>
  
  <call_job job="tk_prol_core">
    <prop id="tk_prol_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_prol_print_values_tips" tip="prol_: Prints values and tips" role="hidden">
  
  <call_job job="tk_prol_read"/>
  
  <call_job job="tk_prol_core">
    <prop id="tk_prol_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_prol_print_help" tip="prol_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_prol_core">
    <prop id="tk_prol_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_prol_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,prol-data)" />
    <prop id="joe-in-regex" x="(prop,prol-regex)" />    
  </call_job>
  <call_job job="tk_prol_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_prol_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,prol-data)" />
    <prop id="joe-in-regex" x="(prop,prol-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_prol_clear"  tip="prol_: Clears the data" role="hidden">
  <delete file="(file,prol-data)"/>
</job>


</jobs>