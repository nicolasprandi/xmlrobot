<prop id="isAdd">0</prop>
<call_job job="zblock-editor" />
<call_job job="zblock-write" />
<ti align="right" x="+/- ZelixBlock '(prop,zblock_titel)'" />
<call_job job="zblock-see" />
</job><job role="hidden" id="zblock-del">
<need>(prop,zblock_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="zblock-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting ZelixBlock [ (prop,zblock_titel) (prop,zblocks_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,zblocks)" where="(prop,zblocks_offset)zblock[@row='(prop,zblock_key)']" />
<tp>Deleted (prop,zblock_titel) #(prop,zblock_key)</tp>
<ti label="- ZelixBlock:" x="(f,html,bold,open)(f,html,bold,open)(prop,zblock_titel)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="zblock-see-all" />
</job><job role="hidden" id="zblock-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="zblock_default_label" x="+ ZelixBlock(prop,zblocks_offset_label)" />
<prop x="sum" id="zblocks_tk_control" />
</when>
<otherwise>
<need>(prop,zblock_key)</need>
<prop id="zblock_default_label" x="ZelixBlock [(prop,zblock_titel)](prop,zblocks_offset_label)" />
<prop x="sum_only" id="zblocks_tk_control" />
</otherwise>
</choose>
<call_job job="zblock-tk" />
</job><job id="zblock-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="zblock-editor" />
<prop id="zblock_key">1</prop>
<when test="(f,not,(f,exists,prop,zblocks_offset_new_key))">
<prop id="zblocks_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,zblocks)" sort="@row" number="@row" xpath="(prop,zblocks_offset_new_key)zblock">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="zblock_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new ZelixBlock: #(prop,zblock_key)</i>
<call_job job="zblock-write" />
<ti align="right" x="+ ZelixBlock '(prop,zblock_titel)'" />
<choose>
<when test="(f,has,prop,post_add_script_zblock)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_zblock)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="zblock-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="zblock-write">
<need>(prop,zblock_key) (prop,isAdd)</need>
<spirit act="open" id="zblocks_spirit_tc" xml="(file,zblocks)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,zblocks_offset),/)">
<prop id="offset2" x="(f,substring,(prop,zblocks_offset),0,(f,sub,(f,len,(prop,zblocks_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,zblocks_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="zblocks_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;zblock row="(prop,zblock_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="zblocks_spirit_tc" where="(prop,zblocks_offset)zblock[@row='(prop,zblock_key)']" attribute="content" value="(f,vob,prop,zblock_content)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="zblocks_spirit_tc" where="(prop,zblocks_offset)zblock[@row='(prop,zblock_key)']" attribute="titel" value="(f,vob,prop,zblock_titel)" />
<spirit act="close" flag="save pretty" id="zblocks_spirit_tc" />
</job></jobs>
