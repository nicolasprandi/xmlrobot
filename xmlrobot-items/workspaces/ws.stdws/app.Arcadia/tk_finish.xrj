<!-- setting the default-values -->
<job id="tk_finish_default" role="hidden">
  <need default="1">(prop,finish_rebuild_libs)</need>

</job>


<!-- finish-core, make your changes here -->
<job id="tk_finish_core" role="hidden" tip="finish_: Tk Internal">

  <need default="">(prop,tk_finish_add_flag)</need>
  <need default="1">(prop,ac-ask-p4-libs)</need>
  <tk label="Parameters: Finish XmlRobot" 
      test="(prop,ac-ask-p4-libs)"
      flag="(prop,tk_finish_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 
    <tk id="finish_rebuild_libs"
        type="bool"
        label="Rebuild-Libs (e:o)ant poi(e:c)" 
        flag="nono"      
      	test_first="0"/> 

        <tk id="finish_delivery_customer" 
        type="dir" 
        label="Delivery Customer"  
        flag="nono"                 
        tip="()The customers delivery dir.()"/> 

        <tk id="finish_templetto" 
        type="dir" 
        label="Templetto"                 
        tip="()Product Template on filesystem()"/>         
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_finish_edit" tip="finish_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,finish-data))">
      <!-- data exists already -->
      <prop id="tk_finish_add_flag" x="sum_only print"/>
      <call_job job="tk_finish_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_finish_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_finish_default"/>
  <!-- doing input -->
  <call_job job="tk_finish_core"/>
  
  <!-- writing data -->
  <call_job job="tk_finish_write"/>

</job>



<job id="tk_finish_print_values" tip="finish_: Prints the entered values" role="hidden">
  
  <call_job job="tk_finish_read"/>
  
  <call_job job="tk_finish_core">
    <prop id="tk_finish_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_finish_print_values_tips" tip="finish_: Prints values and tips" role="hidden">
  
  <call_job job="tk_finish_read"/>
  
  <call_job job="tk_finish_core">
    <prop id="tk_finish_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_finish_print_help" tip="finish_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_finish_core">
    <prop id="tk_finish_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_finish_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,finish-data)" />
    <prop id="joe-in-regex" x="(prop,finish-regex)" />
  </call_job>
  <call_job job="tk_finish_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_finish_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,finish-data)" />
    <prop id="joe-in-regex" x="(prop,finish-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_finish_clear"  tip="finish_: Clears the data" role="hidden">
  <delete file="(file,finish-data)"/>
</job>


</jobs>