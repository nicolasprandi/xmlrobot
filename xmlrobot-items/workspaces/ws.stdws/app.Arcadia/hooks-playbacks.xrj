<?xml version="1.0" ?>

<jobs>
  <call_job job="prolog"/>
  
<job id="hook_playback_orga_finished" role="hidden">

  <choose>
    <when test="(f,exists_file,(file,current-java-lib))">
      <prop id="jump-to-compile-dir">(f,file_content,(file,current-java-lib))</prop>
      <call_job job="jump-into-java-compilation"/>
    </when>
    <otherwise>
      <call_job job="See Java-Compiles"/>
    </otherwise>
   
  </choose>

</job>  

<job id="hook_playback_view_begin" role="hidden">

</job>

