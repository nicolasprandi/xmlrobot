</job><job id="zsel-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="zsel-editor" />
<prop id="zsel_key">1</prop>
<when test="(f,not,(f,exists,prop,zsels_offset_new_key))">
<prop id="zsels_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,zsels)" sort="@row" number="@row" xpath="(prop,zsels_offset_new_key)zsel">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="zsel_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new ZelixBlockSelection: #(prop,zsel_key)</i>
<call_job job="zsel-write" />
<ti align="right" x="+ ZelixBlockSelection '(f,tk_sel_translate,(prop,zsel_zblock),(file,zblock-selector))'" />
<choose>
<when test="(f,has,prop,post_add_script_zsel)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_zsel)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="zsel-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="zsel-write">
<need>(prop,zsel_key) (prop,isAdd)</need>
<spirit act="open" id="zsels_spirit_tc" xml="(file,zsels)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,zsels_offset),/)">
<prop id="offset2" x="(f,substring,(prop,zsels_offset),0,(f,sub,(f,len,(prop,zsels_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,zsels_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="zsels_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;zsel row="(prop,zsel_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="zsels_spirit_tc" where="(prop,zsels_offset)zsel[@row='(prop,zsel_key)']" attribute="zblock" value="(f,vob,prop,zsel_zblock)" />
<spirit act="close" flag="save pretty" id="zsels_spirit_tc" />
</job></jobs>
