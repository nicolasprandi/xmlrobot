<jobs>

<!--

-->
<call_job job="prolog" />


<!-- gui Adapters: to copy in the app .... -->

<job id="See Values: noto_" role="dev">
  <call_job job="tk_noto_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_noto_clear" explain="Clear this data"/>  
</job>

<job id="Edit: noto_" role="hidden">
  <call_job job="tk_noto_edit"/>
</job>

<job id="Edit: noto_?">
  <call_job job="tk_noto_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_noto_clear" explain="Clear this data"/>
</job>

<!-- 
 <job id="Clear Data: noto_">
  <tk type="msg" x="Sure to clear data of noto_ ?" msg_type="w"/>
  <call_job job="tk_noto_clear"/>
</job>

<job id="Print Values:  noto_">
  <call_job job="tk_noto_print_values"/>
</job>
<job id="Print Help: noto_" role="dev">
  <call_job job="tk_noto_print_help"/>
</job>

-->

<!-- setting the default-values -->
<job id="tk_noto_default" role="hidden">
  <need default="regex">(prop,noto_type)</need>
  <need default="(dir,temp)">(dir,noto_dir)</need>
  <need default="(dir,default-noto-out)">(dir,noto_target)</need>
  <prop id="x">()Project 'XXX'
Copyright (c) 2015-2018 Nicolas Prandstaetter

    This program is free software: you can redistribute it and/or modify
    it under the terms of the GNU General Public License as published by
    the Free Software Foundation, either version 3 of the License, or
    (at your option) any later version.

    This program is distributed in the hope that it will be useful,
    but WITHOUT ANY WARRANTY; without even the implied warranty of
    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    GNU General Public License for more details.

    You should have received a copy of the GNU General Public License
    along with this program.  If not, see &lt;https://www.gnu.org/licenses/&gt;.

The project 'XXX' includes:
i)  Software developed by Nicolas Prandstaetter 
    in the year 2018 and before. See www.xmlrobot.net
ii) Software provided by the following parties and open source projects:()</prop>
  <need default="(prop,x)">(prop,noto_intro)</need>
  <remove type="prop" id="x"/>
</job>


<!-- noto-core, make your changes here -->
<job id="tk_noto_core" role="hidden" tip="noto_: Tk Internal">

  <need default="">(prop,tk_noto_add_flag)</need>

  <tk label="Collect Legals" 
      flag="(prop,tk_noto_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 

    <tk id="noto_main_app" 
        type="sel" 
        label="Used Java Projects"
        test_first="1"                  
        tip="Included Java-Projects"
        flag="multi nono" 
        xml="(file,nca-out)"/>
        
    <tk id="noto_target" 
        type="dir" 
        label="Output Directory"  
        flag="nono"
        test_first="0"                   
        tip="()()"/>
    <tk type="msg"
        x="Text"
        test_first="0"/>          
    <tk id="noto_intro" 
        type="textblock" 
        label="Notice intro"  
        flag="nono big"                 
        tip="()()"/>  
    <tk id="noto_between" 
        type="textblock" 
        label="Notice between"  
        flag=" big"                 
        tip="()()"/>    
    <tk id="noto_after" 
        type="textblock" 
        label="Notice after"  
        flag="big"                 
        tip="()()"/>                         
                
    <!--     
    <tk id="noto_dir" 
        type="dir" 
        label="Directory"  
        flag="nono"                 
        tip="()A directory which serves as intial directory for the file-search.()"/>
        -->
    <!--    
    <tk id="noto_file_read"
        type="file"  
      	label="File to read" 
        flag="nono"          
        tip="()This file will be read()"/> 
        
    <tk id="noto_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
    <tk id="noto_type"
        type="sel"  
        label="Selection 1" 
        x="text"
        test_first="0"        
        tip="()text versus regular expression; text will search for exaclty that defined search text, regex will apply the regular-expression syntax to search for a piece of text in the files()">
        <sel label="Text">text</sel>
        <sel label="Regular Expression">regex</sel>    
    </tk>            
         
    <tk id="noto_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="noto_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="noto_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="noto_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="noto_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,noto-sel2)"/>
        
    <tk 
      id="noto_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="noto_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="noto_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="noto_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="noto_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="noto_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_noto_edit" tip="noto_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,noto-data))">
      <!-- data exists already -->
      <prop id="tk_noto_add_flag" x="sum_only print"/>
      <call_job job="tk_noto_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_noto_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_noto_default"/>
  <!-- doing input -->
  <call_job job="tk_noto_core"/>
  
  <!-- writing data -->
  <call_job job="tk_noto_write"/>

</job>



<job id="tk_noto_print_values" tip="noto_: Prints the entered values" role="hidden">
  
  <call_job job="tk_noto_read"/>
  
  <call_job job="tk_noto_core">
    <prop id="tk_noto_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_noto_print_values_tips" tip="noto_: Prints values and tips" role="hidden">
  
  <call_job job="tk_noto_read"/>
  
  <call_job job="tk_noto_core">
    <prop id="tk_noto_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_noto_print_help" tip="noto_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_noto_core">
    <prop id="tk_noto_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_noto_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,noto-data)" />
    <prop id="joe-in-regex" x="(prop,noto-regex)" />
  </call_job>
  <call_job job="tk_noto_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_noto_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,noto-data)" />
    <prop id="joe-in-regex" x="(prop,noto-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_noto_clear"  tip="noto_: Clears the data" role="hidden">
  <delete file="(file,noto-data)"/>
</job>


</jobs>