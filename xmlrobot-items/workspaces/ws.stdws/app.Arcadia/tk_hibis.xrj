<jobs>

<call_job job="prolog" />

<!-- setting the default-values -->
<job id="tk_hibis_default" role="hidden">
                                                     
  <need default="expression">(prop,hibis_syntax)</need>    
  <need default="1000">(prop,hibis_obj_contract)</need>                                                 
  <need default="1001">(prop,hibis_obj_real)</need>
  <need default="800">(prop,hibis_obj_warn)</need>
  


</job>


<!-- hibis-core, make your changes here -->
<job id="tk_hibis_core" role="hidden" tip="hibis_: Tk Internal">

  <need default="">(prop,tk_hibis_add_flag)</need>
  <need default="1">(prop,ac-ask-p2-indiv)</need>
  
  <tk label="Hibiscus" 
      flag="(prop,tk_hibis_add_flag)"
      tip="()Hibiscus parameter.()"
      test="(prop,ac-ask-p2-indiv)"> 

    <tk id="hibis_syntax"
        type="sel"  
        label="Syntax" 
        test_first="0"
        flag="nono"        
        tip="()Wie sind die parameter zu interpreterieren. 'Natural' ist ein einfacher Parameter. 'Expression' ist ein xml-robot-ausdruck der interpretiert und ausgefuehrt wird. Das wird fuer die parametrisierung gebraucht.()">
        <sel label="Natural">natural</sel>
        <sel label="Expression">expression</sel>   
    </tk>
        
    <tk type="msg"
        x="Limit Objektanzahl"
        test_first="0"/>   
        
    <tk id="hibis_obj_contract"
        type="textblock"
      	label="Contract/Vertrag"      	
      	xregex="\d+"
      	xregex_msg="()Anzahl der Objekte wie im Vertrag beschrieben()"
      	test_first="0"
        flag="nono"
        tip="Lt. Vertrag"/> 

    <tk id="hibis_obj_real"
        type="textblock"
      	label="Real/Effektiv"      	
      	xregex="\d+"
      	xregex_msg="()Anzahl der Objekte die letztendlich real überprüft wird()"
      	test_first="0"
        flag="nono"
        tip="Was wirklich passiert"/>     
        
    <tk id="hibis_obj_warn"
        type="textblock"
      	label="Warnung"      	
      	xregex="\d+"
      	xregex_msg="()Anzahl der Objekte bei denen gewarnt wird()"
      	test_first="0"
        flag="nono"
        tip="Warnung rausschmeissen"/>              
        

          
   <!--      
   <tk id="hibis_pub_bez"
        type="textblock"
      	label="Beziehungen"      	
      	xregex="\d+"
      	xregex_msg="()Eine Stueck-Zahl()"
      	test_first="0"
        flag="nono"
        tip="Von import nach int transferierte Beziehungen: 19580;/*[bez]*/"/>      
        
