<job id="See Values: hibis_" role="dev">
  <call_job job="tk_hibis_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_hibis_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: hibis_">
  <tk type="msg" x="Sure to clear data of hibis_ ?" msg_type="w"/>
  <call_job job="tk_hibis_clear"/>
</job>

<job id="Print Values:  hibis_">
  <call_job job="tk_hibis_print_values"/>
</job>
<job id="Print Help: hibis_" role="dev">
  <call_job job="tk_hibis_print_help"/>
</job>

