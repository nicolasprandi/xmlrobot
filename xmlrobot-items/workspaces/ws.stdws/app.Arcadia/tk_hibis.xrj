    <tk type="msg"
        x="Berichte"
        test_first="0"/>
        
    <tk id="hibis_debug2"
        type="textblock"
        label="Show Debug=Bool 0/1"       
      	test_first="0"    
        flag="nono"
        tip="()Reportet auch unwichtiges()"
        />        
            
     
    <tk id="hibis_typus"
        type="sel"  
        label="Selection Typus" 
        test_first="0"        
        tip="()Explain hibis_typus here ...()">
        <sel xlabel="Text">text</sel>
        <sel xlabel="Regex">regex</sel> 
        <sel label="This">this</sel>
        <sel label="That">that</sel>   
    </tk>
    
    <tk type="msg"
        x="Descriptions"
        test_first="0"/>  
        
    <tk id="hibis_rain" 
        label="Rain Simple Text"
        test_first="0"
        tip="()()" />
         
    <tk id="hibis_wind"
        type="textblock"
        label="Wind Textblock"               
      	test_first="0"
        tip="()()" /> 
        
    <tk id="hibis_stones"
        type="textblock"
        flag="big"
        label="Stones Bigscreen"               
      	test_first="0"
        tip="This is about the stones"/>         
        
    <tk id="hibis_sun"
        type="bool"
        label="Sun Boolean"       
      	test_first="0"
        flag="no_is_0"     
        tip="()()"
        />         
        
    <tk type="msg"
        x="Files and Folders"
        test_first="0"/>   
                     
    <tk id="hibis_cat"
        type="sel"
        flag="multi"  
        label="Categories" 
        test_first="0"        
        tip="()Explain hibis_cat here ...()">
        <sel>sand</sel>
        <sel>land</sel>
        <sel>band</sel>
        <sel>hand</sel>                  
    </tk>    
    <tk id="hibis_dir" 
        type="dir" 
        label="Directory"  
        flagx="nono"                 
        tip="()A directory which serves as intial directory for the file-search.()"
        test_first="0"/>
        
    <tk id="hibis_file_read"
        type="file"  
      	label="File to read" 
        xflag="nono"          
        tip="()This file will be read()"
        test_first="0"/>         
          
    <tk id="hibis_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
            
         
    <tk id="hibis_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="hibis_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="hibis_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="hibis_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="hibis_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,hibis-sel2)"/>
        
    <tk 
      id="hibis_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="hibis_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="hibis_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="hibis_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="hibis_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="hibis_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>
