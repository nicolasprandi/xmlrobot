        tip="Von import nach int transferierte Mehr: 720;/*[mehr]*/"/>         
                             
        
    <tk type="msg"
        x="Migration"
        test_first="0"/>            
              
    <tk id="hibis_mig_obj"
        type="textblock"
      	label="Migrated Objects"      	
      	xregex="\d+"
      	xregex_msg="()Eine Stueck-Zahl()"
      	test_first="0"
        flag="nono"
        tip="Die maximale Anzahl der von der migration betroffenen Objekte: 62070;/*[mig]*/"/>  
        
    <tk type="msg"
        x="Abschluss"
        test_first="0"/>            
              
    <tk id="hibis_top"
        type="textblock"
      	label="Top Werte"      	
      	xregex="\d+"
      	regex_msg="()Eine Stueck-Zahl()"
