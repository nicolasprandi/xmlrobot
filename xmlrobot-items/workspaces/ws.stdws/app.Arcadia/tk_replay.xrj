<!-- setting the default-values -->
<job id="tk_replay_default" role="hidden">
  <need default="0">(prop,replay_original)</need>
  <need default="1">(prop,replay_3rd)</need>
  <need default="(prop,name-clear)">(prop,replay_prefix)</need>
  <need default="1">(prop,replay_ask)</need>

</job>


<!-- replay-core, make your changes here -->
<job id="tk_replay_core" role="hidden" tip="replay_: Tk Internal">

  <need default="">(prop,tk_replay_add_flag)</need>

  <tk label="Replay: (prop,name)" 
      flag="(prop,tk_replay_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 

    <tk type="msg"
        x="App-Target"
        test_first="0"/> 
        
    <tk id="replay_app" 
        type="dir" 
        label="App-Dir"  
        flag="nono"                 
        tip="()The target-application-directory()"/>
        
    <tk id="replay_prefix" 
        type="text" 
        label="Jar-Name-Export"  
        flag="nono"  
        test_first="0"               
        tip="()The jar-name of the jars in the destination-app()"/>         
        
    <tk type="msg"
        x="Source-Jars"
        test_first="0"/>   
        
    <tk id="replay_original"
        type="sel"  
        label="Which jar" 
        test_first="0"   
        flag="nono"     
        tip="()Which jar-file should be taken. The original or the compiled/obfuriscated one.()">
        <sel label="Original (e:o)Clear Java Code(e:c)">1</sel>
        <sel label="Compiled (e:o)Maybe Obfuriscated(e:c)">0</sel>    
    </tk>           
    
    <tk id="replay_3rd"
        type="sel"  
        label="Copy 3rd-party-lib" 
        test_first="0"   
        flag="nono"     
        tip="()Should the 3rd-party-lib also copied to the Target-App.()">
        <sel label="Yes">1</sel>
        <sel label="No">0</sel>    
    </tk> 
    
    <tk type="msg"
        x="Configuration"
        test_first="0"/>     
   
     <tk id="replay_ask"
        type="bool"
        label="Ask for Updates"       
      	test_first="0"/>        
    <!--    
    <tk id="replay_file_read"
        type="file"  
      	label="File to read" 
        flag="nono"          
        tip="()This file will be read()"/> 
        
    <tk id="replay_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
    <tk id="replay_type"
        type="sel"  
        label="Selection 1" 
        x="text"
        test_first="0"        
        tip="()text versus regular expression; text will search for exaclty that defined search text, regex will apply the regular-expression syntax to search for a piece of text in the files()">
        <sel label="Text">text</sel>
        <sel label="Regular Expression">regex</sel>    
    </tk>            
         
    <tk id="replay_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="replay_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        

         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="replay_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="replay_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,replay-sel2)"/>
        
    <tk 
      id="replay_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="replay_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="replay_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="replay_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="replay_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="replay_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_replay_edit" tip="replay_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,replay-data))">
      <!-- data exists already -->
      <prop id="tk_replay_add_flag" x="sum_only print"/>
      <call_job job="tk_replay_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_replay_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_replay_default"/>
  <!-- doing input -->
  <call_job job="tk_replay_core"/>
  
  <!-- writing data -->
  <call_job job="tk_replay_write"/>

</job>



<job id="tk_replay_print_values" tip="replay_: Prints the entered values" role="hidden">
  
  <call_job job="tk_replay_read"/>
  
  <call_job job="tk_replay_core">
    <prop id="tk_replay_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_replay_print_values_tips" tip="replay_: Prints values and tips" role="hidden">
  
  <call_job job="tk_replay_read"/>
  
  <call_job job="tk_replay_core">
    <prop id="tk_replay_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_replay_print_help" tip="replay_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_replay_core">
    <prop id="tk_replay_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_replay_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,replay-data)" />
    <prop id="joe-in-regex" x="(prop,replay-regex)" />
  </call_job>
  <call_job job="tk_replay_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_replay_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,replay-data)" />
    <prop id="joe-in-regex" x="(prop,replay-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_replay_clear"  tip="replay_: Clears the data" role="hidden">
  <delete file="(file,replay-data)"/>
</job>


</jobs>