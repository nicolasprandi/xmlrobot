        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="scnf_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="scnf_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="scnf_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="scnf_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_scnf_edit" tip="scnf_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,scnf-data))">
      <!-- data exists already -->
      <prop id="tk_scnf_add_flag" x="sum_only print"/>
      <call_job job="tk_scnf_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_scnf_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_scnf_default"/>
  <!-- doing input -->
  <call_job job="tk_scnf_core"/>
  
  <!-- writing data -->
  <call_job job="tk_scnf_write"/>

</job>



<job id="tk_scnf_print_values" tip="scnf_: Prints the entered values" role="hidden">
  
  <call_job job="tk_scnf_read"/>
  
  <call_job job="tk_scnf_core">
    <prop id="tk_scnf_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_scnf_print_values_tips" tip="scnf_: Prints values and tips" role="hidden">
  
  <call_job job="tk_scnf_read"/>
  
  <call_job job="tk_scnf_core">
    <prop id="tk_scnf_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_scnf_print_help" tip="scnf_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_scnf_core">
    <prop id="tk_scnf_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_scnf_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,scnf-data)" />
    <prop id="joe-in-regex" x="(prop,scnf-regex)" />
  </call_job>
  <call_job job="tk_scnf_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_scnf_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,scnf-data)" />
    <prop id="joe-in-regex" x="(prop,scnf-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_scnf_clear"  tip="scnf_: Clears the data" role="hidden">
  <delete file="(file,scnf-data)"/>
</job>


</jobs>