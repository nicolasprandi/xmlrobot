<!-- setting the default-values -->
<job id="tk_scnf_default" role="hidden">
  <need default="0">(prop,scnf_web_services)</need>
  <need default="1">(prop,scnf_encrypt_services)</need>
  <need default="1">(prop,scnf_clear_all_services)</need>
  <need default="1">(prop,scnf_clear_all_serviceapps)</need>
  <need default="1">(prop,scnf_clear_copies_serviceapps)</need>
</job>


<!-- scnf-core, make your changes here -->
<job id="tk_scnf_core" role="hidden" tip="scnf_: Tk Internal">

  <need default="">(prop,tk_scnf_add_flag)</need>

  <tk label="Service and Job-Encryptions" 
      flag="(prop,tk_scnf_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 
      
    <tk type="msg" 
        x="Services" 
        test_first="0"/>          
    <tk id="scnf_web_services" type="bool" label="Services4Web" flag="nono no_is_0"/>
    <tk id="scnf_encrypt_services" type="bool" label="Encrypt Services" flag="nono no_is_0"/>
    
    <tk type="msg" 
        x="Service-Apps" 
        test_first="0"/>    
    <tk type="sel" id="scnf_encrypt_apps" label="Encrypted Apps" flag=" multi" xml="(file,sci-selector)" 
    tip="These apps should be in the services and encrypted"/>  
    <tk type="sel" id="scnf_plain_apps" label="Plain Apps" flag=" multi" xml="(file,sci-selector)"
    tip="These apps should be in the services and the source-code should be open"/>
    <tk type="msg" 
        x="Shortcuts Service-Apps" 
        test_first="0"/>
    
    <tk type="sel" 
        test_first="0"
        id="scnf_sc_dont_clear" 
        label="Dont Clear" 
        flag=" multi" 
        xml="(file,sci-selector)"
        tip="These apps should be in the services and the source-code should not be cleared of previous outbput"/>
    <tk type="sel" 
        id="scnf_sc_dont_do_at_all" 
        label="Dont Do at all" 
        flag=" multi" 
        test_first="0"
        xml="(file,sci-selector)"
        tip="These apps should be in the services and the source-code should not be done at all"/> 
  
        
    <tk type="bool" 
        id="scnf_clear_all_serviceapps"
        label="Clear all Service-Apps"
        flag="no_is_0 nono"
        test_first="0"/>
        
     <tk type="msg" 
        x="Additional Copy" 
        test_first="0"/>     
        
    <tk type="dir" 
        id="scnf_copy_services"
        label="Copy Services"
        test_first="0"/>   
        
    <tk type="dir" 
        id="scnf_copy_service_apps"
        label="Copy Service-Apps"
        test_first="0"/>               
        
    <tk type="bool" 
        id="scnf_clear_copies_serviceapps"
        label="Clear App-Copies before"
        flag="no_is_0 nono"
        test_first="0"/>        
         
                
          
    <!--
    <tk id="scnf_dir" 
        type="dir" 
        label="Directory"  
