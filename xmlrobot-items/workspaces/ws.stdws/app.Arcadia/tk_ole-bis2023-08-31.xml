<!-- edit data: read, userinput, write -->
<job id="tk_ole_edit" tip="ole_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,ole-data))">
      <!-- data exists already -->
      <prop id="tk_ole_add_flag" x="sum_only print print_with_tips"/>
      <call_job job="tk_ole_read"/>
      
    </when>
    <otherwise>
      <!-- no data exists -->
      <ti>no data exists</ti>
      <prop id="tk_ole_add_flag" x="sum print print_with_tips"/>
    </otherwise>
  </choose>
  <call_job job="tk_ole_default"/>
  <!-- doing input -->
  <call_job job="tk_ole_core"/>
  
  <!-- writing data -->
  <call_job job="tk_ole_write"/>

</job>



<job id="tk_ole_print_values" tip="ole_: Prints the entered values" role="hidden">
  
  <call_job job="tk_ole_read"/>
  
  <call_job job="tk_ole_core">
