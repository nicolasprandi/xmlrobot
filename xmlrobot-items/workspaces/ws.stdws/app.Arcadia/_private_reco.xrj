          <call_job job="rs">
            <file id="rs-file">(dir,systema-dir)at/nicolas/x/term_core/Tc_PerspManager.java</file>
            <prop id="rs-search">(e:o)Persp_IZP(e:c)izpMap.get(e:o)&quot;Earth&quot;(e:c);</prop>      
            <prop id="rs-replace">(e:o)Persp_IZP(e:c)izpMap.get(e:o)&quot;(f,escape,java,(prop,reco_sw_persp))&quot;(e:c);</prop> 
            <prop id="rs-expected">1</prop>       
          </call_job>                   
        
        </when>    
            
        </when>     
        
        <ti label="did do pwd replacement" test="(prop,did-do-app-decoder)"/>
        <ti label="did NOT do pwd replacement" test="(f,not,(prop,did-do-app-decoder))"/>
 
         
        
      </when>
      <otherwise>
        <ti>i am not overwrting java files although you asked to timestamp !!!</ti>
      </otherwise>
    </choose>  
</job>

<job id="rs" role="hidden">
  <need>(file,rs-file)</need>
  <need>(prop,rs-search)</need>
  <need>(prop,rs-replace)</need> 
  <need>(prop,rs-encoding)</need>
  <need default="1">(prop,rs-expected)</need> 
  <ti_hr/>
  <ti label="REPLACEMENT" x=" " />
  <ti label="searching for:">(f,html,b,o)(prop,rs-search)(f,html,b,c)</ti>
  <ti label="replacing with:">(f,html,i,o)(prop,rs-replace)(f,html,i,c)</ti>
  <ti label="in file:">(file,rs-file)</ti> 
  
  <prop id="rs-x">(f,file_content,(file,rs-file),(prop,rs-encoding))</prop>
  <prop id="rs-count">(f,count_text,(prop,rs-x),(prop,rs-search))</prop>
  
  <choose>
    <when test="(f,eq_num,(prop,rs-count),(prop,rs-expected))">
      <ti type="file" xlabel="Doing Replacement ..." label=" " x="(file,rs-file)"/>
      <prop id="rs-x">(f,replace,(prop,rs-x),(prop,rs-search),(prop,rs-replace))</prop>
      <create_file out="(file,rs-file)" encoding="(prop,rs-encoding)">(prop,rs-x)</create_file>
      <ti test="0">search (prop,rs-search) replace (prop,rs-replace)</ti>
      <ti label=" ">done.</ti>
      <!-- 
      <ti type="file" label="Did Replacement " x="(file,rs-file)"/>
      -->
    </when>
    
    <otherwise>
      <throw>Expectations not fullfilled
(f,eq_num,(prop,rs-count),(prop,rs-expected))= f eq_num  count=(prop,rs-count) expected=(prop,rs-expected)
for    (prop,rs-search)
replace (prop,rs-replace)  
in file
(file,rs-file) 
      </throw>
    
    </otherwise>
  
  </choose>
 

</job>

