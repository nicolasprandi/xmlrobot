<!-- setting the default-values -->
<job id="tk_newfo_default" role="hidden">
  <need default="regex">(prop,newfo_type)</need>
  <need default="(dir,filetemp)">(dir,newfo_dir)</need>
</job>


<!-- newfo-core, make your changes here -->
<job id="tk_newfo_core" role="hidden" tip="newfo_: Tk Internal">

  <need default="">(prop,tk_newfo_add_flag)</need>
  <need default="0">(prop,this-is-new)</need>
  
  <when test="(f,and,(prop,this-is-new),(f,has_flag,(prop,tk_newfo_add_flag),sum_only))">
    <tk id="newfo_dir" 
        type="dir" 
        label="Directory"  
        flag="nono"                 
        tip="()A directory to integrate()"/>
    <prop id="newfo_name" x="(f,name_of_dir,(dir,newfo_dir))"/>
    <tk id="newfo_name" 
        label="Name"
        flag="nono"  />   
  </when>
      

  <tk label="New Folder" 
      flag="(prop,tk_newfo_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 

    <tk id="newfo_dir" 
        type="dir" 
        label="Directory"  
        flag="nono"                 
        tip="()A directory to integrate()"/>

    <tk id="newfo_name" 
        label="Name"
        flag="nono"  />        
  
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_newfo_edit" tip="newfo_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,newfo-data))">
      <!-- data exists already -->
      <prop id="tk_newfo_add_flag" x="sum_only print"/>
      <call_job job="tk_newfo_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_newfo_add_flag" x="sum_only print"/>
    </otherwise>
  </choose>
  <call_job job="tk_newfo_default"/>
  <!-- doing input -->
  <call_job job="tk_newfo_core"/>
  
  <!-- writing data -->
  <call_job job="tk_newfo_write"/>

</job>



<job id="tk_newfo_print_values" tip="newfo_: Prints the entered values" role="hidden">
  
  <call_job job="tk_newfo_read"/>
  
  <call_job job="tk_newfo_core">
    <prop id="tk_newfo_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_newfo_print_values_tips" tip="newfo_: Prints values and tips" role="hidden">
  
  <call_job job="tk_newfo_read"/>
  
  <call_job job="tk_newfo_core">
    <prop id="tk_newfo_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_newfo_print_help" tip="newfo_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_newfo_core">
    <prop id="tk_newfo_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_newfo_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,newfo-data)" />
    <prop id="joe-in-regex" x="(prop,newfo-regex)" />
  </call_job>
  <call_job job="tk_newfo_default"/>

</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_newfo_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,newfo-data)" />
    <prop id="joe-in-regex" x="(prop,newfo-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_newfo_clear"  tip="newfo_: Clears the data" role="hidden">
  <delete file="(file,newfo-data)"/>
</job>


</jobs>