<job id="Read Configuration"   role="hidden">

<ti type="file" label="Excel Configuration">(file,conf-excel)</ti>

<excel_form
  excel="(file,conf-excel)"
  sheet="single"
  out="(file,a)" 
  style="short"
  root_name="s1"/>

<ti type="file" label="read single=a">(file,a)</ti>

<xslt 
  xml="(file,a)" 
  xsl="(dir,app)create-conf2.xsl" 
  out="(file,b)" />
  
<ti type="file" label="adds to single=b">(file,b)</ti> 

<choose>
  <when test="(f,file_exists,(file,conf-excel-fields))">  
  <i>Recognized special excel for fields</i>  
    <excel_table
      excel="(file,conf-excel-fields)"
      sheet="fields"
      out="(file,c)" 
      style="short"
      root_name="fields"
      row_name="field"
      y1="11" />   
  </when>
  <otherwise>
    <excel_table
      excel="(file,conf-excel)"
      sheet="fields"
      out="(file,c)" 
      style="short"
      root_name="fields"
      row_name="field"
      y1="11" />  
  </otherwise>
</choose>


<ti type="file" label="read fields base">(file,c)</ti> 
<excel_table
  excel="(file,conf-excel)"
  sheet="selections"
  out="(file,d)" 
  style="short"
  root_name="selections"
  row_name="sel"/>

<ti type="file" label="read selections">(file,d)</ti>

<file id="cx" x="(dir,pro)cx.xml"/>

<xml_update
  what="(file,c)"
  how="append"
  with="(file,d)"
  out="(file,cx)"/>
  
<ti type="file" x="(file,cx)" label="das ist cx"/>  
<xslt 
  xml="(file,cx)" 
  xsl="(dir,app)convert-fields.xsl" 
  out="(file,c2)">
  <params>view_loop_id='(f,xslp,(f,xpath,(file,b),.,@view_loop_id))' singular_id='(f,xslp,(f,xpath,(file,a),.,@singular_id))' name_separator=' X (f,xslp,(f,xpath,(file,a),.,@name_separator))'</params>
</xslt>

<ti type="file" label="wurde produziert=c">(file,c2)</ti>

 

<choose>
  <when test="(f,file_exists,(file,conf-excel-parents))"> 
    <i>Recognized special excel for parents</i> 
    <excel_table
      excel="(file,conf-excel-parents)"
      sheet="parents"
      out="(file,f)" 
      style="short"
      root_name="parents"
      row_name="parent" />    
  </when>
  <otherwise>
    <excel_table
      excel="(file,conf-excel)"
      sheet="parents"
      out="(file,f)" 
      style="short"
      root_name="parents"
      row_name="parent" />  
  </otherwise>
</choose>



<ti type="file" label="parents">(file,f)</ti> 
<file id="g1">(dir,work)g1.xml</file>
<excel_table
  excel="(file,conf-excel)"
  sheet="actions"
  out="(file,g1)" 
  style="short"
  root_name="actions"
  row_name="action" />

<ti type="file" label="actions1">(file,g1)</ti> 

<file id="g">(dir,work)g.xml</file>
<xslt 
  xml="(file,g1)" 
  xsl="(dir,app)convert-actions.xsl" 
  out="(file,g)">
</xslt>


<file id="h">(dir,work)h.xml</file>
<excel_table
  excel="(file,conf-excel)"
  sheet="hooks"
  out="(file,h)" 
  style="short"
  root_name="hooks"
  row_name="hook"
  count_base="1"/>

<ti type="file" label="hooks2">(file,h)</ti>
<create_file out="(file,conf)"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
    <conf/>]]></create_file>
    
<xml_update
  what="(file,conf)"
  how="append"
  with="(file,a)" />

<xml_update
  what="(file,conf)"
  how="append"
  with="(file,b)" />
  
<xml_update
  what="(file,conf)"
  how="append"
  with="(file,c2)" />
  
<xml_update
  what="(file,conf)"
  how="append"
  with="(file,d)" />   
  
<xml_update
  what="(file,conf)"
  how="append"
  with="(file,f)" />   
  
<xml_update
  what="(file,conf)"
  how="append"
  with="(file,g)" />     
  
<xml_update
  what="(file,conf)"
  how="append"
  with="(file,h)" />     
  
<ti type="file" label="Xml Configuration">(file,conf)</ti>   
  
</job>  
<!--


<prop id="cities_offset"></prop>
<prop id="cities_offset_new_key">//</prop>
<prop id="cities_offset_label"></prop>
-->

<job id="Clear Memory" role="hidden">
  <delete file="(file,memo)"/>
  <ti>Memory Cleared</ti>
</job>

<job id="sys_project_setup" tip="Specifies the project from scratch" >
  <when test="(f,not,(f,file_exists,(file,conf-excel)))">
  <tk type="msg">You can now import a configuration template
that is an excel-file 
which you can select ...</tk>
  <call_job job="Import Configuration from Template"/>
  
  <tk id="to-do" 
    type="sel" 
    label="What do you want to do now?">
    <sel label="Edit the Excel">edit</sel>
    <sel label="Run the Configuration">convert</sel>
    <sel label="Its finished for now">nothing</sel>
   </tk> 
   
   <choose>
    <when test="(f,not,(f,has,prop,to-do))">
    </when>
    <when test="(f,eq,nothing,(prop,to-do))">
    </when> 
    <when test="(f,eq,edit,(prop,to-do))">
      <call_job job="Edit"/>
    </when>    
    <when test="(f,eq,convert,(prop,to-do))">
      <tp>Converting ...</tp>
      <call_job job="Convert"/>
      <tk type="msg" x="Continue with Export ..."/>
      <call_job job="Export"/>
      <tk type="msg" x="Continue with Restart ..."/>
      <restart/>      
    </when>               
   </choose>
   </when>
</job>


<job id="Updates" roxle="hidden">
  <call_job job="update-see-all"/>
</job>

<job id="check-login" role="hidden">
  
</job>
</jobliste>