<need>(prop,update_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="update-read" />
<prop id="isAdd">0</prop>
<call_job job="update-editor" />
<call_job job="update-write" />
<ti align="right" x="Did update Update '(f,text,cut_nice,(prop,update_titel),20)'" />
<call_job job="update-see-all" />
</job><job role="hidden" id="update-del">
<need>(prop,update_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="update-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Update [ (f,text,cut_nice,(prop,update_titel),20) (prop,updates_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,updates)" where="(prop,updates_offset)update[@row='(prop,update_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,update_titel),20) #(prop,update_key)</tp>
<ti label="Did delete Update:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,update_titel),20)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="update-see-all" />
</job><job role="hidden" id="update-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Update(prop,updates_offset_label)" />
<prop x="sum" id="updates_tk_control" />
</when>
<otherwise>
<need>(prop,update_key)</need>
<prop id="label" x="Update [(f,text,cut_nice,(prop,update_titel),20)](prop,updates_offset_label)" />
<prop x="sum_only" id="updates_tk_control" />
</otherwise>
</choose>
<call_job job="update-tk" />
</job><job id="update-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="update-editor" />
<prop id="update_key">1</prop>
<when test="(f,not,(f,exists,prop,updates_offset_new_key))">
<prop id="updates_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,updates)" sort="@row" number="@row" xpath="(prop,updates_offset_new_key)update">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="update_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Update: #(prop,update_key)</i>
<call_job job="update-write" />
<ti align="right" x="Did add Update '(f,text,cut_nice,(prop,update_titel),20)'" />
<choose>
<when test="(f,has,prop,post_add_script_update)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_update)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="update-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="update-write">
<need>(prop,update_key) (prop,isAdd)</need>
<spirit act="open" id="updates_spirit_tc" xml="(file,updates)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,updates_offset),/)">
<prop id="offset2" x="(f,substring,(prop,updates_offset),0,(f,sub,(f,len,(prop,updates_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,updates_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="updates_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;update row="(prop,update_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="updates_spirit_tc" where="(prop,updates_offset)update[@row='(prop,update_key)']" attribute="titel" value="(f,vob,prop,update_titel)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="updates_spirit_tc" where="(prop,updates_offset)update[@row='(prop,update_key)']" attribute="file_class" value="(f,vob,prop,update_file_class)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="updates_spirit_tc" where="(prop,updates_offset)update[@row='(prop,update_key)']" attribute="desc" value="(f,vob,prop,update_desc)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="updates_spirit_tc" where="(prop,updates_offset)update[@row='(prop,update_key)']" attribute="search" value="(f,vob,prop,update_search)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="updates_spirit_tc" where="(prop,updates_offset)update[@row='(prop,update_key)']" attribute="search_type" value="(f,vob,prop,update_search_type)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="updates_spirit_tc" where="(prop,updates_offset)update[@row='(prop,update_key)']" attribute="expectation" value="(f,vob,prop,update_expectation)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="updates_spirit_tc" where="(prop,updates_offset)update[@row='(prop,update_key)']" attribute="replace" value="(f,vob,prop,update_replace)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="updates_spirit_tc" where="(prop,updates_offset)update[@row='(prop,update_key)']" attribute="off" value="(f,vob,prop,update_off)" />
<spirit act="close" flag="save pretty" id="updates_spirit_tc" />
</job></jobs>
