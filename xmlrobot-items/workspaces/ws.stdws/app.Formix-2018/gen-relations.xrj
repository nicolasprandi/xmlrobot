<?xml version="1.0" ?>

<jobs>

<job id="prolog" role="hidden">
  <prop id="debug" x="0"/>
  <when test="(f,has,prop,pro)">
  
  <file id="resto-data" x="(dir,pro)resto-data.xrs"/>
  <prop id="resto-regex" x="resto_.+"/>
    
    <file id="updates">(dir,pro)updates.xml</file>
    <when test="(f,not,(f,exists_file,(file,updates)))">
    <create_file out="(file,updates)">&lt;updates/&gt;</create_file>
    <i>Created: (file,updates)</i>
    </when>
    <!--The offset defines a node in the xml-data-file under which all the data is found. use eg 'england' or 'country[id='england']-->
    <prop id="updates_offset">./</prop>
    <!--The offset label is communicated to the user, it verbalizes the offset-->
    <prop id="updates_offset_label"/>
    <!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
    <prop id="updates_offset_new_key">//</prop>
    <!--sort_attribute defines the attributes to be used for the view-sort-->
    <prop id="updates_sort_attribute"/>
    <!--the numeric attributes in the sort-->
    <prop id="updates_sort_number"/>
    <!--the ignore-case attributes in the sort-->
    <prop id="updates_sort_ignore_case"/>
    <!--the desc attributes in the sort-->
    <prop id="updates_sort_desc"/>
    <!--a where claused, this is a post to the xpath-expression, use for several view-types-->
    <prop id="updates_where"/>
    <!--return job to be called after changes (new,delete,edit)-->
    <prop id="updates_return_job">update-see-all</prop>
        
    <file id="later-data" x="(dir,pro)later-data.xrs"/>
    <prop id="later-regex" x="later_.+"/>
    
    <file id="conf-excel">(dir,pro)configuration.xls</file>
    <file id="conf-excel-parents">(dir,pro)configuration-parents.xls</file>
    <file id="conf-excel-fields">(dir,pro)configuration-fields.xls</file>
    
    
    <dir id="work">(dir,pro)work</dir>
    <dir id="result">(dir,pro)result</dir>
    
    <mkdir dir="(dir,work)" />
    <mkdir dir="(dir,result)" />
    
    <file id="conf">(dir,work)conf.xml</file>
    <file id="a">(dir,work)a.xml</file>
    <file id="b">(dir,work)b.xml</file>
    <file id="c">(dir,work)c.xml</file>
    <file id="c2">(dir,work)c2.xml</file>
    <file id="d">(dir,work)d.xml</file>
    <file id="e">(dir,work)e.xml</file>
    <file id="f">(dir,work)f.xml</file>
    <file id="i">(dir,work)i.xml</file>
    
    <file id="x">(dir,result)Generated-Jobs.ljx</file>
    <file id="y">(dir,result)Generated-Prolog.lsx</file>
    <file id="z">(dir,result)Generated-Adapter.ljx</file>
    
    <file id="prolog">(dir,work)prolog.xml</file>
    <file id="prolog-include">(dir,work)prolog-include.xml</file>
    <file id="view">(dir,work)view.xml</file>
    <file id="tomemory">(dir,work)tomemory.xml</file>
    <file id="details">(dir,work)details.xml</file>
    <file id="details2">(dir,work)details2.xml</file>
    <file id="edit">(dir,work)edit.xml</file>
    <file id="delete">(dir,work)delete.xml</file>
    <file id="editor">(dir,work)editor.xml</file>
    <file id="add">(dir,work)add.xml</file>
    <file id="tofile">(dir,work)tofile.xml</file>
    <file id="tkcore">(dir,work)tkcore.xml</file>
    
    <file id="memo">(dir,pro)memo.xml</file>
    
    <when test="(f,not,(f,file_exists,(file,memo)))">
      <create_file out="(file,memo)"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
          <memo/>]]></create_file>
    </when>
    
  </when>

</job>


</jobs>
