<jobs>

<call_job job="prolog" />

<job id="do-org-me-clip" role="hidden">
  <need>(prop,position) (prop,orga_where) (prop,orga_row) (prop,orga_name) (prop,orga_finished_job) (prop,orga_tr_job) (prop,orga_view_loop_id) (file,orga) (prop,orga_segment_singular) (prop,orga_offset) (prop,orga_desc) (prop,orga_name) (prop,orga_name_expression_loop) (prop,orga_desc_expression_loop) (prop,orga_segment_plural_label) (prop,orga_segment_singular_label) </need>
  <call_job job="go-joe-read"> 
    <file id="joe-in-store" x="(file,srv-orga-cp)" /> 
    <prop id="joe-in-regex" x="cp_.+" /> 
  </call_job>
  
  <spirit id="srv-orga-tmp1"
        act="open"
        xml="(file,cp_s_file)"/>
  <!-- <ti label="Source-Xml">(f,spirit,srv-orga-tmp1,xml?,(prop,cp_s_xp))</ti>  size=&quot;5&quot;-->
  <ti label="In clipboard"/>
  <ti label="File:" type="file">(file,cp_s_file)</ti>
  <ti label="Xpath:" >(prop,cp_s_xp)</ti>
  <ti label="Date:" >(f,file_info,last_mod,(file,cp_s_file),yyyy-MM-dd)</ti>
  <ti label="Time:" >(f,file_info,last_mod,(file,cp_s_file),HH:mm:ss)</ti>
  <ti label="Xml"/>
  <ti  flag="html" x="&lt;font  face=&quot;Courier&quot;&gt;(f,escape,_htmlb,(f,spirit,srv-orga-tmp1,xml?,(prop,cp_s_xp)))&lt;font&gt;" />    
  <spirit id="srv-orga-tmp1"
        act="close"/>    
        
  <ti_hr_break/>
  <call_job job="do-org-me"/>        
    
</job>
<job id="do-org-me-paste" role="hidden">
  <need>(prop,position) (prop,orga_where) (prop,orga_row) (prop,orga_name) (prop,orga_finished_job) (prop,orga_tr_job) (prop,orga_view_loop_id) (file,orga) (prop,orga_segment_singular) (prop,orga_offset) (prop,orga_desc) (prop,orga_name) (prop,orga_name_expression_loop) (prop,orga_desc_expression_loop) (prop,orga_segment_plural_label) (prop,orga_segment_singular_label) (prop,paste-where)</need>
  <prop id="testpaste">0</prop>
  <ti test="(prop,testpaste)" type="file" label="srv-orga-cp">(file,srv-orga-cp)</ti>
  <call_job job="go-joe-read"> 
    <file id="joe-in-store" x="(file,srv-orga-cp)" /> 
    <prop id="joe-in-regex" x="cp_.+" /> 
  </call_job>
  <file id="cp_t_file">(file,orga)</file>
  <prop id="cp_t_en" x="(prop,orga_segment_singular)" />
  <prop id="cp_t_row" x="(prop,orga_row)" />
  <prop id="cp_t_xp" x="(prop,orga_offset)(prop,orga_segment_singular)[@row=(prop,orga_row)]" />
  <prop id="cp_t_how" x="insert_(prop,paste-where)" />
  <!--   
  <call_job job="go-joe-write"> 
    <file id="joe-in-store" x="(file,srv-orga-cp)" /> 
    <prop id="joe-in-regex" x="cp_.+" /> 
  </call_job>
  -->
  
  <spirit id="srv-orga-tmp1"
        act="open"
        xml="(file,cp_s_file)"/>
  <!-- <ti label="Source-Xml">(f,spirit,srv-orga-tmp1,xml?,(prop,cp_s_xp))</ti>  size=&quot;5&quot;-->
  <ti  test="(prop,testpaste)" label=" " flag="html" x="&lt;font  face=&quot;Courier&quot;&gt;(f,escape,_htmlb,(f,spirit,srv-orga-tmp1,xml?,(prop,cp_s_xp)))&lt;font&gt;" />  
  <create_file file="(dir,filetemp)orga-cp-source.xml"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>(f,spirit,srv-orga-tmp1,xml?,(prop,cp_s_xp))]]></create_file>
  <ti  test="(prop,testpaste)" type="file" label="orga-cp-source">(dir,filetemp)orga-cp-source.xml</ti>
  
  <spirit id="srv-orga-tmp1"
        act="close"/>  
        
  <spirit id="srv-orga-src"
        act="open"
        xml="(dir,filetemp)orga-cp-source.xml"/>
  <!-- key_source report -->    
     
  <key_source_report 
    in_spirit="srv-orga-src"
    out_spirit="srv-orga-src-rep"/>      
    
  <ti  test="(prop,testpaste)" label="keySourceReport">(f,spirit,srv-orga-src-rep,xml?)</ti>  
  
  <choose>
    <when test="(f,implement,online)">   

      <file id="org-printer">(dir,filetemp)srv-orga-src-rep.xml</file>
    </when>
    <otherwise>

      <file id="org-printer">(dir,status)srv-orga-src-rep.xml</file>
    </otherwise>
  </choose>
  
  <create_file file="(file,org-printer)"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>(f,spirit,srv-orga-src-rep,xml?)]]></create_file>
  <ti test="(prop,testpaste)" label=" " type="file">(file,org-printer)</ti>  
  
  <!-- key_target report -->    
  
  <key_target_report 
    in_file="(file,cp_t_file)"
    out_spirit="srv-orga-tar-rep"/>   
  <ti test="(prop,testpaste)" label="TargetFile" type="file">(file,cp_t_file)</ti>  
  <ti test="(prop,testpaste)" label="keyTargetReport">(f,spirit,srv-orga-tar-rep,xml?)</ti>  
  
  <!-- verarbeitung -->
  <loop_xml id="src-t" 
          act="open" 
          spirit="srv-orga-src-rep"
          xpath="t"/>  
                                                                                        
  <loop id="w" while="()(f,loop_xml,src-t,has_next?)()">
    <loop_xml act="next" id="src-t" />   
    <choose>
      <when test="(f,spirit,srv-orga-tar-rep,exists?,t[@en=(f,xpath_string,(f,loop_xml,src-t,@en))],@m)">
        
        <prop id="max">(f,spirit,srv-orga-tar-rep,t[@en=(f,xpath_string,(f,loop_xml,src-t,@en))],@m)</prop>
        <ti test="(prop,testpaste)">max for [(f,loop_xml,src-t,@en)] is [(prop,max)] and it was found</ti>
        <!-- orga-cp-innter BEGIN <call_job job="orga-cp-inner"/> -->
        
        <!-- values des keys  -->
        <loop_xml id="src-v" 
                act="open" 
                spirit="srv-orga-src-rep"
                xpath="t[@en=(f,xpath_string,(f,loop_xml,src-t,@en))]/v"/>  
                                                                                              
        <loop id="w2" while="()(f,loop_xml,src-v,has_next?)()">
          <loop_xml act="next" id="src-v" />
          <prop id="max">(f,add,1,(prop,max))</prop>
          <!-- jetzt sind wir bei einem value von dem aktuellen key
               wir ersetzen alle row-attribute -->
          <spirit id="srv-orga-src"
                act="xml_update"
                how="set_attribute"
                where="//(f,loop_xml,src-t,@en)[@row=(f,loop_xml,src-v,@v)]"
                attribute="row"
                value="(prop,max)"
                flag="any" />
          <prop id="do-the-references">1</prop>
          <when test="(f,loop_xml,src-v,exists?,@f)">
            <when test="(f,eq_num,0,(f,loop_xml,src-v,@f))">
              <prop id="do-the-references">0</prop>
            </when>             
          </when>      
          <!-- referenzen und values des keys  -->
          <when test="(prop,do-the-references)">
            <loop_xml id="src-r" 
                    act="open" 
                    spirit="srv-orga-src-rep"
                    xpath="t[@en=(f,xpath_string,(f,loop_xml,src-t,@en))]/v[@v=(f,loop_xml,src-v,@v)]/r"/>  
                                                                                                  
            <loop id="w3" while="()(f,loop_xml,src-r,has_next?)()">
              <loop_xml act="next" id="src-r" />
              <!-- jetzt sind wir bei einem ref von dem aktuellen key vom aktuellen wert
                   wir ersetzen alle x-attribute -->
              <spirit id="srv-orga-src"
                    act="xml_update"
                    how="set_attribute"
                    where="(f,loop_xml,src-r,@xp)"
                    wherex="(f,substring_after,(f,loop_xml,src-r,@xp),.)"
                    attribute="(f,loop_xml,src-r,@an)"
                    value="(prop,max)"
                    xflag="any" />
            </loop> <!-- close the while -->
            <loop_xml id="src-r" act="close"/>       
           </when>           
        </loop> <!-- close the while -->
        <loop_xml id="src-v" act="close"/>  
          
        <!-- orga-cp-innter END <call_job job="orga-cp-inner"/> -->
      </when>
      <otherwise>
        <ti>max for [(f,loop_xml,src-t,@en)] was NOT found</ti>
      </otherwise>
    </choose>
    
  </loop> <!-- close the while -->
  <loop_xml id="src-t" act="close"/>        
  
  <!-- ergebnis spirit reinkopieren -->   
  
  <choose>
    <when test="(f,implement,online)">   
      <file id="result-printer">(dir,filetemp)srv-orga-src-new.xml</file>
    </when>
    <otherwise>
      <file id="result-printer">(dir,status)srv-orga-src-new.xml</file>
    </otherwise>
  </choose>
  <file id="result-printer">(dir,pro)cache/paste-inserted-this.xml</file>
  
  <create_file file="(file,result-printer)"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>(f,spirit,srv-orga-src,xml?)]]></create_file>
      
  
  <xml_update
    what="(file,orga)"
    how="(prop,cp_t_how)"
    where="(prop,cp_t_xp)"
    with="(file,result-printer)"/>
  <!-- 
    <file id="cp_t_file">(file,orga)</file>
  <prop id="cp_t_en" x="(prop,orga_segment_singular)" />
  <prop id="cp_t_row" x="(prop,orga_row)" />
  <prop id="cp_t_xp" x="(prop,orga_offset)(prop,orga_segment_singular)[@row=(prop,orga_row)]" />
  <prop id="cp_t_how" x="insert_(prop,paste-where)" />                            -->
  <!-- spirits schliessen -->      

  <spirit id="srv-orga-tar-rep"
        act="close"/>  
        
  <spirit id="srv-orga-src-rep"
        act="close"/>  
          
  <spirit id="srv-orga-src"
        act="close"/>    
  <ti label="Paste was done"/> 
  <ti label="Inserted Data:" type="file">(file,result-printer)</ti>             
  <ti_hr_break/>
  <call_job job="do-org-me"/>
  
</job>

<job id="do-org-me-copy" role="hidden">
  <need>(prop,position) (prop,orga_where) (prop,orga_row) (prop,orga_name) (prop,orga_finished_job) (prop,orga_tr_job) (prop,orga_view_loop_id) (file,orga) (prop,orga_segment_singular) (prop,orga_offset) (prop,orga_desc) (prop,orga_name) (prop,orga_name_expression_loop) (prop,orga_desc_expression_loop) (prop,orga_segment_plural_label) (prop,orga_segment_singular_label)</need>
  <!-- <ti type="file">(file,srv-orga-cp)</ti>  -->
  <call_job job="go-joe-read"> 
    <file id="joe-in-store" x="(file,srv-orga-cp)" /> 
    <prop id="joe-in-regex" x="cp_.+" /> 
  </call_job>
  <file id="cp_s_file">(file,orga)</file>
  <prop id="cp_s_en" x="(prop,orga_segment_singular)" />
  <prop id="cp_s_row" x="(prop,orga_row)" />
  <prop id="cp_s_xp" x="(prop,orga_offset)(prop,orga_segment_singular)[@row=(prop,orga_row)]" />
    
  <call_job job="go-joe-write"> 
    <file id="joe-in-store" x="(file,srv-orga-cp)" /> 
    <prop id="joe-in-regex" x="cp_.+" /> 
  </call_job>
  <ti label="Copy was performed"/>
  <ti label="Name:">(prop,orga_name)</ti>
  <ti label="Type:">(prop,orga_segment_singular_label)</ti>
  <spirit id="srv-orga-tmp1"
        act="open"
        xml="(file,cp_s_file)"/>
  <!-- <ti label="Xml:">(f,spirit,srv-orga-tmp1,xml?,(prop,cp_s_xp))</ti> size=&quot;5&quot;  -->
  <ti label="Xml"/>
  <ti flag="html" x="&lt;font face=&quot;Courier&quot;&gt;(f,escape,_htmlb,(f,spirit,srv-orga-tmp1,xml?,(prop,cp_s_xp)))&lt;font&gt;" />

  
  <spirit id="srv-orga-tmp1"
        act="close"/>  

  <ti_hr_break/>
  <call_job job="do-org-me"/>
  
</job>

<job id="tr_formix_orga" role="hidden">
  <choose>
    <when test="(f,implement,online)">
      <prop id="_org_move_up">       &#8593;       </prop>
      <prop id="_org_move_down">       &#8595;       </prop>
    </when>
    <otherwise>
      <prop id="_org_move_up">[       &#8593;       ]</prop>
      <prop id="_org_move_down">[       &#8595;       ]</prop>    
    </otherwise>
  </choose>
  
  <choose>
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
    
      <prop id="_org_edit">Bearbeiten</prop>
      <prop id="_org_delete">L&#246;schen</prop>
      
      <prop id="_org_organize">/ Organisieren /</prop>
      
      <prop id="_org_del">L&#246;schen</prop>
      <prop id="_org_sure_del">Wirklich l&#246;schen? </prop>
      <prop id="_org_del_again">- LOESCHE-</prop>
      <prop id="_org_del_from">- von -</prop>
      <prop id="_org_del_at">- auf -</prop>
      <prop id="_org_del_fin">??
Dr&#252;cken Sie OK um mit dem L&#246;schen weiterzumachen ...</prop>
      <prop id="_org_decise">Eine Entscheidung wird erwartet</prop>
      <prop id="_org_ready">Bereit und Zur&#252;ck</prop>
            
      <prop id="_org_finished">Fertig:</prop>
      
      <prop id="_org_sicher">Sicher?</prop>
      <prop id="_org_wirk_loe"> wirklich l&#246;schen?</prop>
      <prop id="_org_zu_loesch">Zu l&#246;schende Daten: </prop>
      <prop id="_org_ja_loesch">Ja(e:s) L&#246;schen</prop>
      <prop id="_org_abbrechen">Abbrechen</prop>
      <prop id="_org_ja_forever">()Ja, ich bin mir &#252;ber das L&#246;schen der Daten bewusst.()</prop>
      
      <prop id="_org_wurde_abgebr">Das L&#246;schen wurde abgebrochen(e:s)</prop>
      <prop id="_org_bleit">bleibt erhalten!</prop>    

      <prop id="_org_attempt">Versuch zur Ausf&#252;hrung eines</prop>
      <prop id="_org_attempt_at">auf</prop>
      <prop id="_org_attempt_pos">Position ist</prop>             
    </when>
    <when test="1" lang="en">
    
      <prop id="_org_edit">Edit</prop>
      <prop id="_org_delete">Delete</prop>
      
      <prop id="_org_organize">/ Organize /</prop>
      
      <prop id="_org_del">Delete</prop>
      <prop id="_org_sure_del">Sure to remove?</prop>
      <prop id="_org_del_again">- DELETE -</prop>
      <prop id="_org_del_from">- from -</prop>
      <prop id="_org_del_at">- at -</prop>
      <prop id="_org_del_fin">??
Press OK to continue with delete ...</prop>
      <prop id="_org_decise">You have a decision to make</prop>
      <prop id="_org_ready">Ready and done</prop>
      <prop id="_org_finished">Finished:</prop>       
      
      <prop id="_org_sicher">Sure?</prop>
      <prop id="_org_wirk_loe"> you want to delete?</prop>
      <prop id="_org_zu_loesch">Data to delete: </prop>
      <prop id="_org_ja_loesch">Yes(e:s) Delete</prop>
      <prop id="_org_abbrechen">Cancel</prop>
      <prop id="_org_ja_forever">()Yes, I know it, the data will be gone()</prop>
      <prop id="_org_wurde_abgebr">The delete-process was cancelled(e:s)</prop>
      <prop id="_org_bleit">will remain!</prop>    

      <prop id="_org_attempt">Attempt to perform a </prop>
      <prop id="_org_attempt_at">at</prop>
      <prop id="_org_attempt_pos">Position is</prop>           
    
    </when>
    
  </choose>
        

</job>
