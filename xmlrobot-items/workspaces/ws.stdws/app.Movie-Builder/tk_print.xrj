<!-- setting the default-values -->
<job id="tk_print_default" role="hidden">
  <!--
  <need default="regex">(prop,print_type)</need>
  <need default="(dir,filetemp)">(dir,print_dir)</need>
  -->
</job>


<!-- print-core, make your changes here -->
<job id="tk_print_core" role="hidden" tip="print_: Tk Internal">

  <need default="">(prop,tk_print_add_flag)</need>

  <tk label="Parameters: print_" 
      flag="(prop,tk_print_add_flag)"
      tip="()Which movie to print()"> 

        
    <tk id="print_what" 
        label="Movie to print"
        flag="nono"
        tip="()()" />

                          
  </tk>   
</job>
