<!-- edit data: read, userinput, write -->
<job id="tk_print_edit" tip="print_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,print-data))">
      <!-- data exists already -->
      <prop id="tk_print_add_flag" x="sum print"/>
      <call_job job="tk_print_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_print_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_print_default"/>
  <!-- doing input -->
  <call_job job="tk_print_core"/>
  
  <!-- writing data -->
  <call_job job="tk_print_write"/>

</job>



<job id="tk_print_print_values" tip="print_: Prints the entered values" role="hidden">
  
  <call_job job="tk_print_read"/>
  
  <call_job job="tk_print_core">
    <prop id="tk_print_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_print_print_values_tips" tip="print_: Prints values and tips" role="hidden">
  
  <call_job job="tk_print_read"/>
  
  <call_job job="tk_print_core">
    <prop id="tk_print_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_print_print_help" tip="print_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_print_core">
    <prop id="tk_print_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_print_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,print-data)" />
    <prop id="joe-in-regex" x="(prop,print-regex)" />    
  </call_job>
  <call_job job="tk_print_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_print_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,print-data)" />
    <prop id="joe-in-regex" x="(prop,print-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_print_clear"  tip="print_: Clears the data" role="hidden">
  <delete file="(file,print-data)"/>
</job>


</jobs>
