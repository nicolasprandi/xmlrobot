<job id="See Values: print_" role="dev">
  <call_job job="tk_print_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_print_clear" explain="Clear this data"/>  
</job>




 <job id="Clear Data: print_">
  <tk type="msg" x="Sure to clear data of print_ ?" msg_type="w"/>
  <call_job job="tk_print_clear"/>
</job>

