<jobs>

<call_job job="prolog" />

<!-- <when test="(f,has,prop,pro)"> take 2 things to the prolog --> 
  <!-- 

  -->
<!-- </when>       -->

<!-- gui Adapters: to copy in the app  take the edit to your gui.... -->

<job id="_visuals" role="hidden">
  <call_job job="tk_visual_edit"/>
  <call_job job="execute"/>
</job>

<job id="?Visuals?" role="hidden">
  <call_job job="tk_visual_print_values"/>
  
  <ti type="rec" > 
    <ti> </ti>
     
    <ti type="call_job" job="?Visuals?-edit" explain="[ (prop,_x_edit) ]" flag="button" class="fx fxEdit fxEditDetail fxEditDetailConf"/>
    <ti type="call_job" job="?Visuals?-tips" flag="button" class="fx fxAskAsk fxAskAskConf" explain="(prop,_label_askask)"  align="right"/>
 
  </ti>

</job>

<job id="?Visuals?-tips" role="hidden">
  <call_job job="tk_visual_print_values_tips"/>
  
  <ti type="rec" > 
    <ti> </ti>
     
    <ti type="call_job" job="?Visuals?-edit" explain="[ (prop,_x_edit) ]" flag="button" class="fx fxEdit fxEditDetail fxEditDetailConf"/>

 
  </ti>

</job>

<job id="?Visuals?-edit" role="hidden">
  <call_job job="tk_visual_edit"/>
  <call_job job="execute"/>
  


</job>



<!-- setting the default-values -->
<job id="tk_visual_default" role="hidden">
  <!--
  <need default="regex">(prop,visual_type)</need>
  <need default="(dir,filetemp)">(dir,visual_dir)</need>
  <need default="(dir,filetemp)">(dir,visual_dir)</need>
  -->
  <need default="160">(prop,visual_max_x)</need>
  <need default="0">(prop,visual_onoff)</need>
</job>


<!-- visual-core, make your changes here -->
<job id="tk_visual_core" role="hidden" tip="visual_: Tk Internal">

  <call_job job="tr_visuals_core"/>

  <need default="">(prop,tk_visual_add_flag)</need>

  <tk label="(prop,_visi_label)" 
      flag="(prop,tk_visual_add_flag)"
      tip="(prop,_visi_tip)"> 
      
    <tk id="visual_onoff"
        type="bool"
        label="(prop,_visi_onoff)"       
      	test_first="1"
        flag="no_is_0"     
        tip="(prop,_visi_onoff_t)"
        />     
              
        <tk id="visual_max_x" label="(prop,_visi_maxx)" test_first="0" tip="(prop,_visi_maxx_t)"/>
        <tk id="visual_max_y" label="(prop,_visi_maxy)" test_first="0" tip="(prop,_visi_maxy_t)"/> 
 
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_visual_edit" tip="visual_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,visual-data))">
      <!-- data exists already -->
      <prop id="tk_visual_add_flag" x="sum_only print"/>
      <call_job job="tk_visual_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_visual_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_visual_default"/>
  <!-- doing input -->
  <call_job job="tk_visual_core"/>
  
  <!-- writing data -->
  <call_job job="tk_visual_write"/>

</job>



<job id="tk_visual_print_values" tip="visual_: Prints the entered values" role="hidden">
  
  <call_job job="tk_visual_read"/>
  
  <call_job job="tk_visual_core">
    <prop id="tk_visual_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_visual_print_values_tips" tip="visual_: Prints values and tips" role="hidden">
  
  <call_job job="tk_visual_read"/>
  
  <call_job job="tk_visual_core">
    <prop id="tk_visual_add_flag" x="print_only print_with_tips print_all_fields"/>
  </call_job>
  
</job>

<job id="tk_visual_print_help" tip="visual_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_visual_core">
    <prop id="tk_visual_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_visual_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,visual-data)" />
    <prop id="joe-in-regex" x="(prop,visual-regex)" />    
  </call_job>
  <call_job job="tk_visual_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_visual_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,visual-data)" />
    <prop id="joe-in-regex" x="(prop,visual-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_visual_clear"  tip="visual_: Clears the data" role="hidden">
  <delete file="(file,visual-data)"/>
</job>


</jobs>