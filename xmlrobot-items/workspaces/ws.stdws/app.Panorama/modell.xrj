<jobs>

<call_job job="prolog" />
<!-- 
<job id="Identify Project" role="hidden">
  <try_catch>
    <try>
    <dump_ti flag="Vorher"/>
      <call_job job="Edit Project Type" />
      <dump_ti flag="Nacher"/>
    </try>
    <catch>
      <dump_ti flag="im exception"/>
    </catch>
  </try_catch> 
    <tk type="msg" msg="Identify Project"/>

    
</job>
