<job id="tr_lysp" role="hidden">
 <!-- (prop,)
 (prop,_lysp_) (prop,_lysp__) 
 <call_job job="tr_lysp"/> -->
 <choose>           
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
      <!-- d=deutsch -->
   
      <!-- 
      <prop id="_lysp__l"></prop>
      <prop id="_lysp__t"></prop>
      
      <prop id="_lysp__l"></prop>
      <prop id="_lysp__t"></prop>   
      -->
      <prop id="_lysp_l">Berichts-Layout</prop>
      <prop id="_lysp_mscope_l">Strukturierung</prop>
      
      <prop id="_lysp_cats_l">Auflisten je Kategorie</prop>
      <prop id="_lysp_cats_t">Dateien werden gruppiert je Kategorie</prop>

      <prop id="_lysp_msums_l">Summen</prop>
      <prop id="_lysp_msums_t">Regeln f&#252;r die Darstellung von Summen</prop>

      <prop id="_lysp_ptot_l">Gesamt-Summe</prop>
