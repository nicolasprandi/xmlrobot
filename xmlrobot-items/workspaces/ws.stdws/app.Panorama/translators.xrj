      <prop id="_lysp_ptot_beg">Am Seitenbeginn</prop>
      <prop id="_lysp_ptot_end">Am Seitenende</prop>      

      <prop id="_lysp_sumcat_l">Summe je Kategorie</prop>
      <prop id="_lysp_sumcat_t">Zeigt Summen je Kategorie</prop>
      
      <prop id="_lysp_sumext_l">Summe je Erweiterung</prop>
      <prop id="_lysp_sumext_t">Zeigt Summen je Datei-Erweiterung</prop>    

      <prop id="_lysp_sumsort_l">Sortierung der Summen</prop>
      
      <prop id="_lysp_sumsort_t">Sortierreihenfolge der Summen.</prop>

      <prop id="_lysp_sumsort_big">Gr&#246;sste zuerst</prop>
      <prop id="_lysp_sumsort_small">Kleinste zuerst</prop>
      <prop id="_lysp_sumsort_fequ">Haufigste zuerst</prop>
      <prop id="_lysp_sumsort_less">Seltenste zuerst</prop>

      <prop id="_lysp_mfdet_l">Datei-Infos</prop>
      <prop id="_lysp_mdfet_t">Betreffend Detailsinfos je Datei</prop>
      
      <prop id="_lysp_sefi_l">Ansicht Dateiname</prop>
      <prop id="_lysp_sefi_t">Steuert ob Dateien grunds&#228;tzlich(e:s) und wenn ja WIE diese angezeigt werden sollen.</prop>
      
      <prop id="_lysp_sefi_no">Nein</prop>
      <prop id="_lysp_sefi_yes">Ja</prop>
      <prop id="_lysp_sefi_yesb">()Ja (Fett)()</prop>
      <prop id="_lysp_sefi_yesbc">()Ja (Fett-Spalig)()</prop>       
      <prop id="_lysp_sesi_l">Dateigr&#246;sse</prop>
      <prop id="_lysp_sesi_t">Zeigt die Dateigr&#246;sse in KB an</prop>
      
      <prop id="_lysp_sofi_l">Datei-Sortierung</prop>
      <prop id="_lysp_sofi_t">Spezifiziert wie die Dateien sortiert werden sollen.</prop> 
      <prop id="_lysp_sofi_name">Name</prop> 
      <prop id="_lysp_sofi_ext">Erweiterung</prop> 
      <prop id="_lysp_sofi_big">Gr&#246;sse(e:s) Gr&#246;sste zuerst</prop> 
      <prop id="_lysp_sofi_small">Gr&#246;sse(e:s) Kleinste zuerst</prop> 

      <prop id="_lysp_limitf_l">Limitierung</prop>
      <prop id="_lysp_limitf_t">Maximale Anzahl von Dateien je Kategorie</prop>

      <prop id="_lysp_mdirs_l">Verzeichnisse</prop>
      <prop id="_lysp_mdirs_t">Regeln f&#252;r das Anzeigen der Verzeichnisse</prop>
      
      <prop id="_lysp_dirtyp_l">Verzeichnis-Typen</prop>
      <prop id="_lysp_dirtyp_t">Spezifiziert(e:s) wie Verzeichnisse angezeigt werden sollen</prop>  
      
