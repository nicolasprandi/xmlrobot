<job id="tr_pcat" role="hidden">
 <!--
 (prop,) (prop,_pcat_) (prop,_pcat__) 
 <call_job job="tr_pcat"/> -->
 <choose>           
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_pcat_do_you_want">Wollen Sie projektspezifische Kategorien verwenden?</prop>
      <prop id="_pcat_you_could">Sie k&#246;nnen die Kategorien in den Services modifizieren!</prop>      
      <prop id="_pcat_there_exists">Es existiert eine &#228;ltere Version der Kategorien in diesem Projekt</prop>
      <prop id="_pcat_use_this">Verwende diese &#228;ltere Version erneut</prop>
      <prop id="_pcat_forget_the">Vergiss die Vergangenheit und definiere neue Kategorien</prop>
      <prop id="_pcat_proj_cats">Projektspezifische Kategorien:</prop>      
      <prop id="_pcat_use_std">Verwende wieder die standardm&#228;ssigen Kategorien</prop>
           
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(f,interpreter,lang),es)" lang="es">
    
    </when>  -->  
    <when test="1" lang="en">   
      <!-- e=englisch -->
      <prop id="_pcat_do_you_want">Do you want to use project-specific categories?</prop>
      <prop id="_pcat_you_could">You could change the Categories in the Services!</prop>      
      <prop id="_pcat_there_exists">There exists an older version of categories in the project</prop>
      <prop id="_pcat_use_this">Use this older version again</prop>
      <prop id="_pcat_forget_the">Forget the past and make new categories</prop>
      <prop id="_pcat_proj_cats">Project Specific Categories:</prop>      
      <prop id="_pcat_use_std">Use standard-categories again</prop>
    </when>
  </choose>
</job>

<job id="tr_rep" role="hidden">
 <!--
 (prop,_rep_) (prop,_rep__) 
 <call_service job="tr_rep"/>     -->

 <choose>           
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
      <!-- d=deutsch  -->
      <choose>
        <when test="(f,implement,online)">
          <prop id="_rep_upperdir">  &#8593;&#8593;   RAUF   &#8593;&#8593;  </prop>
          <prop id="_rep_dirinfo">&#402;</prop>
          <prop id="_rep_adddir"> + </prop>
          <prop id="_rep_"></prop>
        </when>
        <otherwise>      
          <prop id="_rep_upperdir">  &#8593;&#8593;   RAUF   &#8593;&#8593;  </prop>
