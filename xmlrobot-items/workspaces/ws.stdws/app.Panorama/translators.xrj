<job id="tr_fadd" role="hidden">
 <!--
 (prop,) (prop,_fadd_) (prop,_fadd__) 
 <call_job job="tr_fadd"/> -->
 <choose>           
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_fadd_create_file_in">Erzeuge Datei im Verzeichnis</prop>
      <prop id="_fadd_fn_l">Name der Datei</prop>      
      <prop id="_fadd_fn_t">Diese Datei wird 'virtuell' erzeugt. Sie m&#252;ssen die Datei in weiterer Folge noch ausw&#228;hlen ...</prop>
      <prop id="_fadd_conti">Weiter mit dem Ausw&#228;hlen der Datei</prop>
      <prop id="_fadd_choose">Aus&#228;hlen:</prop>
      <prop id="_fadd_cancel">Erzeugung einer Ausgabe-Datei abgebrochen</prop>     
            
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(f,interpreter,lang),es)" lang="es">
    
    </when>  -->  
    <when test="1" lang="en">   
      <!-- e=englisch -->
