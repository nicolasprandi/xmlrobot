<job id="tr_dscan" role="hidden">
 <!--
 (prop,_dscan_) (prop,_dscan__) 
 <call_job job="tr_dscan"/> -->
 <choose>           
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_dscan_dir_l">Verzeichnis</prop>
      <prop id="_dscan_dir_t">Verzeichnis zur Ansicht</prop>
      
      <prop id="_dscan_l">Verzeichnisauswahl</prop>    
            
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(f,interpreter,lang),es)" lang="es">
    
    </when>  -->  
    <when test="1" lang="en">   
      <!-- e=englisch -->

      <prop id="_dscan_dir_l">Directory</prop>
      <prop id="_dscan_dir_l">Directory to view</prop>
      
      <prop id="_dscan_l">Selection of Folder</prop> 

    </when>
  </choose>
</job>

<job id="tr_visuals_core" role="hidden">
 <!--
 (prop,_visi_) (prop,_visi__) 
 <call_job job="tr_visi"/> -->
 <choose>           
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_visi_label">Panorama Visuals</prop>
      <prop id="_visi_tip">()Definition der Darstellung von Bildern.()</prop>
      
      <prop id="_visi_onoff">Bilder darstellen</prop>
      <prop id="_visi_onoff_t">Definiert ob Bilder bei der Auflistung von Dateien in Panorama als Bilder darstellt werden sollen</prop>
      <prop id="_visi_maxx">Maximale Breite/x</prop>
      
      <prop id="_visi_maxy">Maximale H&#246;he/y</prop>   
      <prop id="_visi_maxx_t">Limitiert die Breite bei der Darstellung eines Bildes in Pixeln</prop>
      <prop id="_visi_maxy_t">Limitiert die H&#246;he bei der Darstellung eines Bildes in Pixeln</prop> 
            
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(f,interpreter,lang),es)" lang="es">
    
    </when>  -->  
    <when test="1" lang="en">   
      <!-- e=englisch -->
      <prop id="_visi_label">Panorama Visuals</prop>
      <prop id="_visi_tip">()Define the size of pictures.()</prop>
      
      <prop id="_visi_onoff">See pictures</prop>
      <prop id="_visi_onoff_t">Specifies if pictures should be displayed as pictures when listing files with Panorama</prop>
      <prop id="_visi_maxx">Max Width/x</prop>
      <prop id="_visi_maxy">Max Height/y</prop> 
      
      <prop id="_visi_maxx_t">Limits the width of the displayed pictures in pixels</prop>
      <prop id="_visi_maxy_t">Limits the height of the displayed pictures in pixels</prop>       
    </when>
  </choose>
</job>



