      <prop id="_lysp_dirtyp_next">N&#228;chste Kinder</prop> 
      <prop id="_lysp_dirtyp_all">Alle Verzeichnisse</prop> 
      <prop id="_lysp_dirtyp_big">Gr&#246;sste Verzeichnisse</prop>
      <prop id="_lysp_dirtyp_big_av">Gr&#246;sste Verzeichnisse (e:o)Durchschnittliche Gr&#246;sse(e:c)</prop>  
            
      <prop id="_lysp_dirsiz_l">Verzeichnisgrosse</prop>
      <prop id="_lysp_dirsiz_t">Zeigt den Speicherplatzbedarf von Verzeichnissen an</prop>
      
      <prop id="_lysp_limitbig_l">(prop,_lysp_dirtyp_big)</prop>
      <prop id="_lysp_limitbig_t">Maximale Anzahl von angezeigten Verzeichnissen bei '(prop,_lysp_dirtyp_big)'</prop> 

      <prop id="_lysp_maxnext_l">(prop,_lysp_dirtyp_next)</prop>
      <prop id="_lysp_maxnext_t">Maximale Anzahl von angezeigten Verzeichnissen bei '(prop,_lysp_dirtyp_next)'</prop>

      <prop id="_lysp_mfilpc_l">Kategorien-Filter</prop>
      <prop id="_lysp_mfilpc_t">Filtert spezifische Kategorien aus</prop>
      
      <prop id="_lysp_typfilt_l">Filter-Typ</prop>
      <prop id="_lysp_typfilt_t">Art und Weise des Filters: Positive oder Negative Formulierung</prop>    
      <prop id="_lysp_typfilt_want">Positiver Filter = Was Sie WOLLEN</prop>
      <prop id="_lysp_typfilt_wantnot">Negativer Filter = What Sie NICHT WOLLEN</prop>

      <prop id="_lysp_catsel_l">Gew&#228;hlte Kategorien</prop>
