    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(f,interpreter,lang),es)" lang="es">
    
    </when>  -->  
    <when test="1" lang="en">   
      <!-- e=englisch -->
     
   <prop id="_lysp_l">Setup: Layout</prop>
      <prop id="_lysp_mscope_l">Structure</prop>
      
      <prop id="_lysp_cats_l">Structure by Categories</prop>
      <prop id="_lysp_cats_t">Triggers to File-Categories in report</prop>

      <prop id="_lysp_msums_l">Sums</prop>
      <prop id="_lysp_msums_t">Treatment of sums</prop>

      <prop id="_lysp_ptot_l">Page Totals</prop>
      <prop id="_lysp_ptot_t">Triggers to see total values like count and kb. If you want to see them (e:s) specify where to see them(e:s) at the beginning of the page or at the end</prop>
      <prop id="_lysp_ptot_beg">At the beginning</prop>
      <prop id="_lysp_ptot_end">At the end</prop>      

      <prop id="_lysp_sumcat_l">Sums per Category</prop>
      <prop id="_lysp_sumcat_t">See sums per category</prop>
      
      <prop id="_lysp_sumext_l">Sums per Extension</prop>
      <prop id="_lysp_sumext_t">See sums per extension</prop>    

      <prop id="_lysp_sumsort_l">Sort of Sums</prop>
      <prop id="_lysp_sumsort_t">How to sort the sums: Biggest ones first(e:s) Smallest ones first(e:s) Frequent ones first(e:s) Less ones first</prop>

      <prop id="_lysp_sumsort_big">Biggest ones first</prop>
      <prop id="_lysp_sumsort_small">Smallest ones first</prop>
      <prop id="_lysp_sumsort_fequ">Frequent ones first</prop>
      <prop id="_lysp_sumsort_less">Less ones first</prop>

      <prop id="_lysp_mfdet_l">File Details</prop>
      <prop id="_lysp_mdfet_t">Treatment of file-details</prop>
      
      <prop id="_lysp_sefi_l">See Filenames</prop>
      <prop id="_lysp_sefi_t">Trigges wheter to see each file (e:s) and if where ...</prop>
      
      <prop id="_lysp_sefi_no">No</prop>
      <prop id="_lysp_sefi_yes">Yes</prop>
      <prop id="_lysp_sefi_yesb">()Yes (Bold)()</prop>
      <prop id="_lysp_sefi_yesbc">()Yes (Bold-Column)()</prop>       
      <prop id="_lysp_sesi_l">See Size</prop>
      <prop id="_lysp_sesi_t">Prints filesize of files in KB</prop>
      
      <prop id="_lysp_sofi_l">Sort of Files</prop>
      <prop id="_lysp_sofi_t">Specifies the sorting of listed files: Name(e:s) Extension(e:s)Size Big ones first(e:s) Size Small ones first</prop> 
      <prop id="_lysp_sofi_name">Name</prop> 
      <prop id="_lysp_sofi_ext">Extension</prop> 
      <prop id="_lysp_sofi_big">Size(e:s) Big ones first</prop> 
      <prop id="_lysp_sofi_small">Size(e:s) Small ones first</prop> 

      <prop id="_lysp_limitf_l">Limit Files</prop>
