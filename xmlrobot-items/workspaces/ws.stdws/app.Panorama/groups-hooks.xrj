<jobs>

<job  id="eg-editor-base" joblevel="ws" 
      role="hidden" 
      tip="You can define the groupings of the files in the Panorama-Browser" >
      
  <need>(file,eg-with)</need>    
  
  <file id="groups">(file,eg-with)</file>
  <prop id="groups_offset">./</prop>
  <prop id="groups_offset_label" />
  <prop id="groups_offset_new_key">//</prop>
  <prop id="groups_sort_attribute">@sort</prop>
  <prop id="groups_sort_number">@sort</prop>
  <prop id="groups_sort_ignore_case"></prop>
  <prop id="groups_sort_desc"></prop>
  <prop id="groups_where" />
  <prop id="groups_return_job">View File-Categories</prop>
  <call_job job="View File-Categories" />

</job>

<job id="pnx_hook_view_21" role="hidden">

  <!-- <dump/> -->
  <!-- <ti type="call_job" job="Publish Panorama File-Categories" explain="Publish"/> -->
</job>

<job id="List All Extensions" role="hidden">

  <prop id="result"></prop>
  <ti label="List of Extensions"/>
  <loop id="r" xml="(file,groups)" xpath="group[@id=(prop,group_key)]/extension">
    <ti label=" ">(loop,r,@extension)</ti>
    <prop id="result">(prop,result).(loop,r,@extension) </prop>
  </loop>
  
  <ti label="All Extensions">
    <ti label=" ">(prop,result)</ti>
  </ti>
  <!-- <dump/> -->
  <!-- <ti type="call_job" job="Publish Panorama File-Categories" explain="Publish"/> -->
</job>

<job id="pnx_hook_view_extensions_end" role="hidden">
  <ti_hr/>
  <ti type="call_job" job="Publish Panorama File-Categories" explain="Publish">
    <tk type="msg">Sure to publish the categories?</tk>
    <file id="groups">(file,groups)</file>
  </ti>    
  <ti type="call_job" job="View File-Categories" explain="See all categories">
    <file id="groups">(f,vob,file,groups)</file>
    <prop id="groups_offset">(f,vob,prop,groups_offset)</prop>
    <prop id="groups_offset_label">(f,vob,prop,groups_offset_label)</prop>
    <prop id="groups_offset_new_key">(f,vob,prop,groups_offset_new_key)</prop>
    <prop id="groups_sort_attribute">(f,vob,prop,groups_sort_attribute)</prop>
    <prop id="groups_sort_number">(f,vob,prop,groups_sort_number)</prop>
    <prop id="groups_sort_ignore_case">(f,vob,prop,groups_sort_ignore_case)</prop>
    <prop id="groups_sort_desc">(f,vob,prop,groups_sort_desc)</prop>
    <prop id="groups_where">(f,vob,prop,groups_where)</prop>
    <prop id="groups_return_job">(f,vob,prop,groups_return_job)</prop>  
  </ti>

</job>

<job id="pnx_hook_view_groups_end" role="hidden">
  <!-- <ti>Greetings from pnx_hook_view_groups_end</ti> -->
  <ti_hr/>
  <ti type="call_job" 
