</job>

<job id="pnx_hook_view_activity_end" role="hidden">
<ti type="call_job" job="pnx_act_publish" explain="Publish">
  <file id="activities">(f,vob,file,activities)</file>
  <prop id="activities_offset">(f,vob,prop,activities_offset)</prop>
  <prop id="activities_offset_label">(f,vob,prop,activities_offset_label)</prop>
  <prop id="activities_offset_new_key">(f,vob,prop,activities_offset_new_key)</prop>
  <prop id="activities_sort_attribute">(f,vob,prop,activities_sort_attribute)</prop>
  <prop id="activities_sort_number">(f,vob,prop,activities_sort_number)</prop>
  <prop id="activities_sort_ignore_case">(f,vob,prop,activities_sort_ignore_case)</prop>
  <prop id="activities_sort_desc">(f,vob,prop,activities_sort_desc)</prop>
  <prop id="activities_where">(f,vob,prop,activities_where)</prop>
  <prop id="activities_return_job">(f,vob,prop,activities_return_job)</prop>
</ti>

</job>

<job id="pnx_act_publish" role="hidden">
  <interpreter watch="1"/>
  <choose>
    <when test="(f,eq,(prop,activities_offset),file_activities/)">
      <prop id="pub_type">file</prop>
      <prop id="pub_type_human">File</prop>
      <file id="dest">(dir,services)Panorama-File-Activities.jobs.xml</file>
    </when>
    <when test="(f,eq,(prop,activities_offset),dir_activities/)">
      <prop id="pub_type">dir</prop>
      <prop id="pub_type_human">Dir</prop>
      <file id="dest">(dir,services)Panorama-Dir-Activities.jobs.xml</file>
    </when>    
    <otherwise>
      <throw>Terrible 7234</throw>
    </otherwise>
  </choose>
  
  <ti label="pub_type:" x="(prop,pub_type)" />
  <file id="gen_jobs">(dir,filetemp)pnx_generated_activity_jobs.xml</file>
  
  <xslt
    xml="(dir,services)activities-panorama.xml"
    xsl="(dir,services)pano-activities-jobs.xsl"
    out="(file,dest)">
    <params>job_id='(f,xslp,Panorama-(prop,pub_type_human)-Activities)' type_dir_file='(prop,pub_type)'</params>
  </xslt>
  <tk type="msg" x="Activate Changes by Restarting ..." />
  <restart/>

  <!-- <dump flag="ti" label="pnx_act_publish"/> -->
</job>  

</jobs>