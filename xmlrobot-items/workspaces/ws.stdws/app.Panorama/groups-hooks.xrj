<job id="Get Panorama File-Extensions" role="hidden">
  <need>(file,groups)</need>
  <dump_ti_all/>
</job>

<job id="Publish Panorama File-Categories" role="hidden">
  
  <!-- create the name of the destination files -->
  <prop id="dof">(f,dir_of_file,(file,groups))</prop>
  <prop id="nof">(f,name_of_file,(file,groups))</prop>
  <prop id="last">(f,last_index_of,(prop,nof),edit.xml)</prop>
  <when test="(f,eq,-1,(prop,last))">
    <throw>Invalid Filename: (file,groups)</throw>
  </when>
  <file id="life">(prop,dof)(f,substring,(prop,nof),0,(prop,last))life.xml</file>
  <file id="tisel">(prop,dof)(f,substring,(prop,nof),0,(prop,last))tisel.xml</file>
  
  <!-- filter non-active, and sort by attribute @sort -->
  <file id="tx">(dir,filetemp)(f,time).xml</file>
  <xslt
    xml="(file,groups)"
    xsl="(dir,app)publish-groups.xsl"
    out="(file,tx)"/>
  <!-- <ti label="tx:" type="file">(file,tx)</ti> -->
  
  <!-- for the aggreation, it is nessecarry to make sure a specific 
       organisation of group and extions-ids,
       group-ids start with 1
       all extension-ids are above all group-ids -->
  <prop id="next_id_to_give">0</prop>  
  <spirit id="x" act="open" xml="(file,tx)" flag="nuevo"/>
  <loop_xml id="x" act="open" spirit="x" xpath="//group" sort="@sort" number="@sort"/>
  <loop id="wx" while="()(f,loop_xml,x,has_next?)()">
    <loop_xml act="next" id="x" />
    <prop id="next_id_to_give">(f,add,1,(prop,next_id_to_give))</prop>
    <spirit 
      id="x"  
      act="xml_update" 
      where_is_loop_xml="x" 
      how="set_attribute" 
      attribute="id" 
      value="(prop,next_id_to_give)" /> 
  </loop>
  <loop_xml id="x" act="close"/>
  
  <spirit 
    id="x"  
    act="xml_update" 
    where="." 
    how="set_attribute" 
    attribute="max_g_id" 
    value="(prop,next_id_to_give)" />  
     
  <loop_xml id="x" act="open" spirit="x" xpath="//extension"/>
  <loop id="wx" while="()(f,loop_xml,x,has_next?)()">
    <loop_xml act="next" id="x" />
    <prop id="next_id_to_give">(f,add,1,(prop,next_id_to_give))</prop>
    <spirit 
      id="x"  
      act="xml_update" 
      where_is_loop_xml="x" 
      how="set_attribute" 
      attribute="id" 
      value="(prop,next_id_to_give)" /> 
  </loop>
  <loop_xml id="x" act="close"/>
    
  <spirit 
    id="x"  
    act="xml_update" 
    where="." 
    how="set_attribute" 
    attribute="max_id" 
    value="(prop,next_id_to_give)" /> 
      
  <spirit id="x" act="close" flag="save" out="(file,life)"/>
  
  <!-- create the ti-selector for group selections -->
  <xslt
    xml="(file,life)"
    xsl="(dir,app)publish-group-selector.xsl"
    out="(file,tisel)"/>
  <!-- <ti label="tisel:" type="file">(file,tisel)</ti> -->
  
  <!-- done -->  
  <ti label="Published Successfully">
    <ti label="Created:" type="file">(file,life)</ti>

  </ti>

</job>

<job id="pnx_hook_details_group_end" role="hidden">
  <call_job job="To Memory File-Category"/>
  <!-- <dump flag="ti"/> -->
  
  <file id="extensions">(file,groups)</file>
  <prop id="extensions_offset">group[@id=(prop,group_key)]/</prop>
  <prop id="extensions_offset_label"></prop>
  <prop id="extensions_offset_new_key">//</prop>
  <prop id="extensions_sort_attribute" />
  <prop id="extensions_sort_number" />
  <prop id="extensions_sort_ignore_case" />
  <prop id="extensions_sort_desc" />
  <prop id="extensions_where" />
  <prop id="extensions_return_job">See File-Category</prop>
  
  <ti_hr/>
  <ti label="File-Extensions:"/>
  <call_job job="View File-Extensions" />
  <!-- <ti_break/> -->
    
