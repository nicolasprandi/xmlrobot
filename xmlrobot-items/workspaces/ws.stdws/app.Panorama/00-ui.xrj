<?xml version="1.0" ?>

<jobs>
<call_job job="prolog" />




<job id="See Report" lang="en" tip="See last file-report"  pri="10" notonline="notonline">
  <call_job job="do-report-print"/>
</job>

<job id="Bericht" lang="de" tip="Den letzten Datei-Bericht ansehen"  pri="10" notonline="notonline">
  <call_job job="do-report-print"/>
</job>

<job id="Raporto" lang="es" tip="Mostrar el ultimo raporto"  pri="10" notonline="notonline">
  <call_job job="do-report-print"/>
</job>

<job id="See Report?" lang="en" notonline="notonline" >
  <call_job job="?See report?"/>
</job>

<job id="Bericht?" lang="de" notonline="notonline">
  <call_job job="?See report?"/>
</job>

<job id="Raporto?" lang="es"  notonline="notonline">
  <call_job job="?See report?"/>
</job>

<job id="Change folder" lang="en" tip="Switch to another folder"  >
  <call_job job="_scan_dir"/>
</job>

<job id="Anderes Verzeichnis" lang="de" tip="Auf ein anderes Verzeichnis wechseln">
  <call_job job="_scan_dir"/>
</job>

<job id="Otro Directorio" lang="es" tip="Cambia a un otro directoryio" >
  <call_job job="_scan_dir"/>
</job>

<job id="Change folder?" lang="en" >
  <call_job job="?scan-folder?"/>
</job>

<job id="Anderes Verzeichnis?" lang="de" >
  <call_job job="?scan-folder?"/>
</job>

<job id="Otro Directorio?" lang="es" >
  <call_job job="?scan-folder?"/>
</job>
<!--    -->
<job id="flex-layout-action" role="hidden"  >
  <choose>
    <when xtest="1" test="(f,implement,online)">
    
      <call_job job="_visual_layouting_new"/>
    </when>
    <otherwise>
      <call_job job="do-report-conf"/>
    </otherwise>
  
  </choose>
  
</job>
<job id="Setup: Layout" lang="en" tip="Define how file-reports look like" pri="10"  >
  <call_job job="flex-layout-action"/>
</job>

<job id="Setup: Darstellung" lang="de" tip="Konfigurationen: zb Gruppierung und Summenbildung, Sortierung der Dateien, Anzeige der Dateigr&#246;ssen und bildliche Darstellung von Bild-Dateien" pri="10">
  <call_job job="flex-layout-action"/>
</job>

<job id="Setup: Estilo" lang="es" tip="Controle como las listas de fichas mira" pri="10" >
  <call_job job="flex-layout-action"/>
</job>

<job id="Setup: Layout?" lang="en" >
  <call_job job="?SetupLayout?"/>
</job>

<job id="Setup: Darstellung?" lang="de" >
  <call_job job="?SetupLayout?"/>
</job>

<job id="Setup: Estilo?" lang="es" >
  <call_job job="?SetupLayout?"/>
</job>

<job id="Setup: Visuals" lang="en" tip="View Pictures when listing files" notonline="notonline" pri="10" >
  <call_job job="_visuals"/>
</job>

<job id="Setup: Visuelles" lang="de" tip="Bilder in Panorama anzeigen" notonline="notonline" pri="10" >
  <call_job job="_visuals"/>
</job>

<job id="Setup: Vidi" lang="es" tip="Mostrar fotos" notonline="notonline" pri="10" >
  <call_job job="_visuals"/>
</job>

<job id="Setup: Visuals?" lang="en" notonline="notonline" >
  <call_job job="?Visuals?"/>
</job>

<job id="Setup: Visuelles?" lang="de" notonline="notonline" >
  <call_job job="?Visuals?"/>
</job>

<job id="Setup: Vidi?" lang="es" notonline="notonline" >
  <call_job job="?Visuals?"/>
</job>

