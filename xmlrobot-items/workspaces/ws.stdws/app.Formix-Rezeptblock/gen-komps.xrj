</job><job role="hidden" id="komp-edit">
<need>(prop,komp_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="komp-read" />
<prop id="isAdd">0</prop>
<call_job job="komp-editor" />
<call_job job="komp-write" />
<ti align="right" x="Did update Komponente '(f,text,cut_nice,(prop,komp_bez),20)'" />
<call_job job="komp-see" />
</job><job role="hidden" id="komp-del">
<need>(prop,komp_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="komp-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Komponente [ (f,text,cut_nice,(prop,komp_bez),20) (prop,komps_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,komps)" where="(prop,komps_offset)komp[@row='(prop,komp_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,komp_bez),20) #(prop,komp_key)</tp>
<ti label="Did delete Komponente:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,komp_bez),20)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="rez-see" />
</job><job role="hidden" id="komp-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Komponente(prop,komps_offset_label)" />
<prop x="sum" id="komps_tk_control" />
</when>
<otherwise>
<need>(prop,komp_key)</need>
<prop id="label" x="Komponente [(f,text,cut_nice,(prop,komp_bez),20)](prop,komps_offset_label)" />
<prop x="sum_only" id="komps_tk_control" />
</otherwise>
</choose>
<call_job job="komp-tk" />
</job><job id="komp-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="komp-editor" />
<prop id="komp_key">1</prop>
<when test="(f,not,(f,exists,prop,komps_offset_new_key))">
<prop id="komps_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,komps)" sort="@row" number="@row" xpath="(prop,komps_offset_new_key)komp">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="komp_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Komponente: #(prop,komp_key)</i>
<call_job job="komp-write" />
<ti align="right" x="Did add Komponente '(f,text,cut_nice,(prop,komp_bez),20)'" />
<choose>
<when test="(f,has,prop,post_add_script_komp)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_komp)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="rez-see" />
</otherwise>
</choose>
</job><job role="hidden" id="komp-write">
<need>(prop,komp_key) (prop,isAdd)</need>
<spirit act="open" id="komps_spirit_tc" xml="(file,komps)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,komps_offset),/)">
<prop id="offset2" x="(f,substring,(prop,komps_offset),0,(f,sub,(f,len,(prop,komps_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,komps_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="komps_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;komp row="(prop,komp_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="komps_spirit_tc" where="(prop,komps_offset)komp[@row='(prop,komp_key)']" attribute="bez" value="(f,vob,prop,komp_bez)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="komps_spirit_tc" where="(prop,komps_offset)komp[@row='(prop,komp_key)']" attribute="beschreibung" value="(f,vob,prop,komp_beschreibung)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="komps_spirit_tc" where="(prop,komps_offset)komp[@row='(prop,komp_key)']" attribute="phasen" value="(f,vob,prop,komp_phasen)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="komps_spirit_tc" where="(prop,komps_offset)komp[@row='(prop,komp_key)']" attribute="kalkulationen" value="(f,vob,prop,komp_kalkulationen)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="komps_spirit_tc" where="(prop,komps_offset)komp[@row='(prop,komp_key)']" attribute="zeiten" value="(f,vob,prop,komp_zeiten)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="komps_spirit_tc" where="(prop,komps_offset)komp[@row='(prop,komp_key)']" attribute="moda_zutaten" value="(f,vob,prop,komp_moda_zutaten)" />
<spirit act="close" flag="save pretty" id="komps_spirit_tc" />
</job></jobs>