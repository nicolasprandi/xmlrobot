</job><job role="hidden" id="rezpic-edit">
<need>(prop,rezpic_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="rezpic-read" />
<prop id="isAdd">0</prop>
<call_job job="rezpic-editor" />
<call_job job="rezpic-write" />
<ti align="right" x="Did update Rezept-Pic '(f,text,cut_nice,(prop,rezpic_bez),20)'" />
<call_job job="rez-see" />
</job><job role="hidden" id="rezpic-del">
<need>(prop,rezpic_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="rezpic-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Rezept-Pic [ (f,text,cut_nice,(prop,rezpic_bez),20) (prop,rezpics_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,rezpics)" where="(prop,rezpics_offset)rezpic[@row='(prop,rezpic_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,rezpic_bez),20) #(prop,rezpic_key)</tp>
<ti label="Did delete Rezept-Pic:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,rezpic_bez),20)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="rez-see" />
</job><job role="hidden" id="rezpic-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Rezept-Pic(prop,rezpics_offset_label)" />
<prop x="sum" id="rezpics_tk_control" />
</when>
<otherwise>
<need>(prop,rezpic_key)</need>
<prop id="label" x="Rezept-Pic [(f,text,cut_nice,(prop,rezpic_bez),20)](prop,rezpics_offset_label)" />
<prop x="sum_only" id="rezpics_tk_control" />
</otherwise>
</choose>
<call_job job="rezpic-tk" />
</job><job id="rezpic-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="rezpic-editor" />
<prop id="rezpic_key">1</prop>
<when test="(f,not,(f,exists,prop,rezpics_offset_new_key))">
<prop id="rezpics_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,rezpics)" sort="@row" number="@row" xpath="(prop,rezpics_offset_new_key)rezpic">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="rezpic_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Rezept-Pic: #(prop,rezpic_key)</i>
<call_job job="rezpic-write" />
<ti align="right" x="Did add Rezept-Pic '(f,text,cut_nice,(prop,rezpic_bez),20)'" />
<choose>
<when test="(f,has,prop,post_add_script_rezpic)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_rezpic)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="rez-see" />
</otherwise>
</choose>
</job><job role="hidden" id="rezpic-write">
<need>(prop,rezpic_key) (prop,isAdd)</need>
<spirit act="open" id="rezpics_spirit_tc" xml="(file,rezpics)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,rezpics_offset),/)">
<prop id="offset2" x="(f,substring,(prop,rezpics_offset),0,(f,sub,(f,len,(prop,rezpics_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,rezpics_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="rezpics_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;rezpic row="(prop,rezpic_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<file id="jack-in" x="(file,rezpic_pic)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="rezpics_spirit_tc" where="(prop,rezpics_offset)rezpic[@row='(prop,rezpic_key)']" attribute="pic" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="rezpics_spirit_tc" where="(prop,rezpics_offset)rezpic[@row='(prop,rezpic_key)']" attribute="bez" value="(f,vob,prop,rezpic_bez)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="rezpics_spirit_tc" where="(prop,rezpics_offset)rezpic[@row='(prop,rezpic_key)']" attribute="max_x_px" value="(f,vob,prop,rezpic_max_x_px)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="rezpics_spirit_tc" where="(prop,rezpics_offset)rezpic[@row='(prop,rezpic_key)']" attribute="max_y_px" value="(f,vob,prop,rezpic_max_y_px)" />
<spirit act="close" flag="save pretty" id="rezpics_spirit_tc" />
</job></jobs>