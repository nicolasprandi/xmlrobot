<?xml version="1.0" ?>

<jobs>

<job id="prolog" role="hidden">


<throw test="(f,gt_num,(f,time,yyyyMMdd),30000101)">Formix-Rezeptblock out of service</throw>
<!-- <call_job job="Login"/>    -->

<prop id="order-regex" x="order_.+"/>
<file id="phasen-selektor">(dir,app)phasen-typ-selector.xml</file>

  <file id="uc-data" x="(dir,pro)uc-data.xml"/>
  <prop id="uc-regex" x="uc_.+"/>
  
<when test="(f,has,prop,pro)"> 
  <call_job job="get-app-material"/>
  <choose>
    <when test="(f,exists_file,(dir,pro)idioma)">
      <prop id="idioma">(f,file_content,(dir,pro)idioma)</prop>
    </when>
    <otherwise>
      <prop id="idioma">jp</prop>
    </otherwise>
  </choose>

  <!--   <ti>idioma is (prop,idioma)</ti> --> 

  
  <!-- 
  <file id="namix-data" x="(dir,pro)namix-data.xrs"/>
  <prop id="namix-regex" x="namix_.+"/>
                                                                      
  
    <when test="(f,exists_file,(file,namix-data))">
      <include file="(file,namix-data)"/>
    </when>
    <need default="Rezept">(prop,namix_rezept)</need>
    <need default="Zutat">(prop,namix_zutat)</need>
    <need default="Vorgang">(prop,namix_ephase)</need>
    <need default="Komponente">(prop,namix_komponente)</need>
    <need default="Zutatenverwendung">(prop,namix_zutverw)</need>
  -->
  <file id="rezs">(dir,pro)rezs.xml</file>
  
  <when xtest="1" test="(f,not,(f,exists_file,(file,rezs)))">
     <!--
    <file id="sample-scan" x="(dir,filetemp)cn-scan.xml"/>
    <file id="sample-sel" x="(dir,filetemp)cn-sel.xml"/>
    <quick_scan dir="(dir,app)sample_pros/" out="(file,sample-scan)" level_limit="2"/>
    <xslt 
      xml="(file,sample-scan)"
      xsl="(dir,app)template-list.xsl"
      out="(file,sample-sel)"/>
      
    <tk type="sel" 
        id="template" 
        xml="(file,sample-sel)" 
        label="Selection du Rezept-Block"
        tip="Select your rezeptblock"
        flag="nono"/>  
       
    <copy uri="(dir,app)sample_pros/(prop,template)" touri="(dir,pro)"/>
    <ti>Did create default: (prop,template)</ti>
    -->
    <copy uri="(dir,app-material)sample_pros/Thai" touri="(dir,pro)"/>
  </when> 
  
  

  <dir id="cache" x="(dir,pro)cache/"/>
  <mkdir dir="(dir,cache)"/>
  <file id="akt-rez">(dir,cache)aktuelles-rezept.txt</file>
  <file id="akt-komp">(dir,cache)aktuelle-komponente.txt</file>
  <file id="akt-zutatenliste">(dir,cache)akt-zutatenliste.xml</file>
  <file id="akt-zutatenliste2">(dir,cache)akt-zutatenliste2.xml</file>
  <file id="akt-komponentenliste">(dir,cache)akt-komponentenliste.xml</file>
  <file id="akt-zutatenliste-komponente">(dir,cache)akt-zutatenliste-komponente.xml</file>
  
  <file id="doku-data" x="(dir,pro)doku-data.xml"/>
  <prop id="doku-regex" x="doku_.+"/>

  
  
  <file id="para-data" x="(dir,pro)para-data.xml"/>
  <prop id="para-regex" x="para_.+"/>

  <file id="conf-data" x="(dir,pro)conf-data.xml"/>
  <prop id="conf-regex" x="conf_.+"/>
  
  <file id="stat-data" x="(dir,pro)stat-data.xml"/>
  <prop id="stat-regex" x="stat_.+"/>  
    
  <file id="project-exists" x="(dir,pro)project-exists.txt"/>
  
  
  <when test="(f,not,(f,exists_file,(file,rezs)))">
  <create_file out="(file,rezs)">&lt;rezs/&gt;</create_file>
  <i>Created: (file,rezs)</i>
  </when>
  <!--The offset defines a node in the xml-data-file under which all the data is found. use eg 'england' or 'country[id='england']-->
  <prop id="rezs_offset">./</prop>
  <!--The offset label is communicated to the user, it verbalizes the offset-->
  <prop id="rezs_offset_label"/>
  <!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
  <prop id="rezs_offset_new_key">//</prop>
  <!--sort_attribute defines the attributes to be used for the view-sort-->
  <prop id="rezs_sort_attribute"/>
  <!--the numeric attributes in the sort-->
  <prop id="rezs_sort_number"/>
  <!--the ignore-case attributes in the sort-->
  <prop id="rezs_sort_ignore_case"/>
  <!--the desc attributes in the sort-->
  <prop id="rezs_sort_desc"/>
  <!--a where claused, this is a post to the xpath-expression, use for several view-types-->
  <prop id="rezs_where"/>
  <!--return job to be called after changes (new,delete,edit)-->
  <prop id="rezs_return_job">rez-see-all</prop>
  
  <file id="zuts">(file,rezs)</file>

  <!--The offset defines a node in the xml-data-file under which all the data is found. use eg 'england' or 'country[id='england']-->
  <prop id="zuts_offset">./</prop>
  <!--The offset label is communicated to the user, it verbalizes the offset-->
  <prop id="zuts_offset_label"/>
  <!--the offset_new_key is used whenever a new id for an added record is needed. this is a prefix for an xpath-expression-->
  <prop id="zuts_offset_new_key">//</prop>
  <!--sort_attribute defines the attributes to be used for the view-sort-->
  <prop id="zuts_sort_attribute"/>
  <!--the numeric attributes in the sort-->
  <prop id="zuts_sort_number"/>
  <!--the ignore-case attributes in the sort-->
  <prop id="zuts_sort_ignore_case"/>
  <!--the desc attributes in the sort-->
  <prop id="zuts_sort_desc"/>
  <!--a where claused, this is a post to the xpath-expression, use for several view-types-->
  <prop id="zuts_where"/>
  <!--return job to be called after changes (new,delete,edit)-->
  <prop id="zuts_return_job">zut-see-all</prop>
  

  <!--   
  <file id="asss">(file,rezs)</file>
  <prop id="asss_offset">./</prop>
  <prop id="asss_offset_label"/>
  <prop id="asss_offset_new_key">//</prop>
  <prop id="asss_sort_attribute"/>
  <prop id="asss_sort_number"/>
  <prop id="asss_sort_ignore_case"/>
  <prop id="asss_sort_desc"/>
  <prop id="asss_where"/>
  <prop id="asss_return_job">ass-see-all</prop>  
  -->
  
<file id="rezpics">(file,rezs)</file>

<prop id="rezpics_offset">./</prop>
<prop id="rezpics_offset_label"/>
<prop id="rezpics_offset_new_key">//</prop>
<prop id="rezpics_sort_attribute"/>
<prop id="rezpics_sort_number"/>
<prop id="rezpics_sort_ignore_case"/>
<prop id="rezpics_sort_desc"/>
<prop id="rezpics_where"/>
<prop id="rezpics_return_job">rezpic-see-all</prop>  
  
  
<file id="opts">(file,rezs)</file> 

<prop id="opts_offset">./</prop>
<prop id="opts_offset_label"/>
<prop id="opts_offset_new_key">//</prop>
<prop id="opts_sort_attribute"/>
<prop id="opts_sort_number"/>
<prop id="opts_sort_ignore_case"/>
<prop id="opts_sort_desc"/>
<prop id="opts_where"/>
<prop id="opts_return_job">opt-see-all</prop> 

<file id="komps">(file,rezs)</file> 

<prop id="komps_offset">./</prop>
<prop id="komps_offset_label"/>
<prop id="komps_offset_new_key">//</prop>
<prop id="komps_sort_attribute"/>
<prop id="komps_sort_number"/>
<prop id="komps_sort_ignore_case"/>
<prop id="komps_sort_desc"/>
<prop id="komps_where"/>
<prop id="komps_return_job">komp-see-all</prop>

<file id="ephasen">(file,rezs)</file> 

<prop id="ephasen_offset">./</prop>
<prop id="ephasen_offset_label"/>
<prop id="ephasen_offset_new_key">//</prop>
<prop id="ephasen_sort_attribute"/>
<prop id="ephasen_sort_number"/>
<prop id="ephasen_sort_ignore_case"/>
<prop id="ephasen_sort_desc"/>
<prop id="ephasen_where"/>
<prop id="ephasen_return_job">ephase-see-all</prop>


<file id="kompzuts">(file,rezs)</file> 

<prop id="kompzuts_offset">./</prop>
<prop id="kompzuts_offset_label"/>
<prop id="kompzuts_offset_new_key">//</prop>
<prop id="kompzuts_sort_attribute"/>
<prop id="kompzuts_sort_number"/>
<prop id="kompzuts_sort_ignore_case"/>
<prop id="kompzuts_sort_desc"/>
<prop id="kompzuts_where"/>
<prop id="kompzuts_return_job">kompzut-see-all</prop>


<prop id="myclass">Rezept</prop>
<prop id="myclassPl">Rezepte</prop>
<prop id="myclassAkt">Aktulles Rezepte</prop>
<prop id="myclassZutat">ZuatatXX</prop>
<prop id="myclassZutatPl">ZuatatenXX</prop>
<prop id="myclassZutatVerw">Verwendete ZutatenXX</prop>

<prop id="mcRezeptname">Rezeptname</prop>
<prop id="mcDokumentation">Dokumentation</prop>
<prop id="mcVorgang">Vorgang</prop>
<prop id="mcBetrifftZutat">Betrifft Zutat</prop>
<prop id="mcAktion">Aktion</prop>
<prop id="mcZutatenbezeichnung">Zutatenbezeichnung</prop>
<prop id="mcMenge">Menge</prop>
<prop id="mcEinheit">Einheit</prop>
<prop id="mcZutatenverwendung">Zutaten-Verwendung</prop>
<prop id="mcZutatenOptionen">Zutaten Optionen</prop>
<prop id="mcLogin">Login</prop>

    
    <call_job job="go-joe-read">
      <file id="joe-in-store" x="(dir,app-material)idiomas/(prop,idioma)2.xml" /> 
      <prop id="joe-in-regex" x="myclas.*|mc.*" /> 
    </call_job>
    
    
<prop id="moda">e</prop>
<prop id="moda_zutaten">1</prop>
  <when test="(f,exists_file,(file,uc-data))">
    <exclude file="(file,uc-data)" regex="uc_moda|uc_singular|uc_plural|uc_aktuelles_rezept|uc_zutaten_moda"/>
    
    <prop id="myclass" test="(f,has,prop,uc_singular)">(prop,uc_singular)</prop>
    <prop id="myclassPl" test="(f,has,prop,uc_plural)">(prop,uc_plural)</prop>
    <prop id="moda" test="(f,has,prop,uc_moda)">(prop,uc_moda)</prop>
    <prop id="myclassAkt" test="(f,has,prop,uc_aktuelles_rezept)">(prop,uc_aktuelles_rezept)</prop>
    <prop id="moda_zutaten" test="(f,has,prop,uc_zutaten_moda)">(prop,uc_zutaten_moda)</prop>
    
  </when>  
<!--   
