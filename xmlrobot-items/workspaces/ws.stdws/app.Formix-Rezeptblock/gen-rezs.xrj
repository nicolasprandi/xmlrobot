</tk>
<tk label="Internes" x="Internes" test_first="0" type="msg" flag=" " />
<tk label="Text" id="rez_detail" x="" test_first="0" tip="Beschreibung fuer die interne verwendung; wird nicht publiziert" type="textblock" flag=" " />
</tk>
