<need default="">(prop,rezs_tk_control)</need>
<need default="">(prop,label)</need>
<tk label="(prop,label)" tip="Ein Rezept ist ein Beschreibung eines Kochvorganges dervin einem Endresultat muendet. &#xA;Zum einen gibt es Grund-Zutaten fuer das gesamte Rezept. &#xA;Weiters kann ein Rezept in Teilprodukte gegliedert werden - diese werden Komponenten genannt;&#xA;Innerhalb jeder Komponente kann aus den Grund-Zutaten auswgewaet werden um diese zu verarbeiten. ie Verarbeitungsschritte &#xA;Wwerden dokumentiert. " flag="(prop,rezs_tk_control) wrap ">
<tk label="(f,vob,prop,mcRezeptname)" id="rez_bez" x="" test_first="1" tip="Titel" type="text" flag=" nono " />
<tk label="Charakter" id="rez_character" x="" test_first="1" tip="Geschmaecker und Besonderheiten die das Rezept einzigartig machen" type="text" flag=" " />
<tk label="Doku" id="rez_beschreibung" x="" test_first="0" tip="Beschreibung die publiziert wird" type="textblock" flag=" " />
<tk label="Portionen" id="rez_portionen" x="" test_first="0" tip="Anzahl der Portionen auf das die Mengenangaben gemuenzt sind" type="text" flag=" " />
<tk label="Logo" x="Logo" test_first="0" test="(f,role,boss)" type="msg" flag=" " />
<tk label="Bild" id="rez_logo" x="" test_first="0" tip="ein Bild" test="(f,role,boss)" type="file" flag=" " />
<tk label="List-Max Breite/Px" id="rez_logo_max_x" x="" test_first="0" tip="in pixel" test="(f,role,boss)" type="text" flag=" " />
<tk label="List-Max Hoehe/px" id="rez_logo_max_y" x="90" test_first="0" tip="in pixel" test="(f,role,boss)" type="text" flag=" " />
<tk label="Detail-Max Hoehe/px" id="rez_logo_max_x_main" x="" test_first="0" tip="in pixel" test="(f,role,boss)" type="text" flag=" " />
<tk label="Detail-Max Hoehe/px" id="rez_logo_max_y_main" x="290" test_first="0" tip="in pixel" test="(f,role,boss)" type="text" flag=" " />
<tk label="Bewertungen" x="Bewertungen" test_first="0" type="msg" flag=" " />
<tk label="Status" id="rez_rezeptstatus" x="" test_first="0" tip="Metainformation bezueglich der Qualitaet dieser Rezeptbeschreibung" type="sel" flag=" ">
<sel label="Idee">idee</sel>
<sel label="inBeareitung">inBeareitung</sel>
