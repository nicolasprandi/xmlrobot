<job id="see-pics-of-kompzut" role="hidden">

<try_catch>
<try>
  <interpreter watch="0"/>
  <prop id="die-zutat">(loop,kompzut_loop,@zut_key)</prop>
  <when test="(loop,kompzut_loop,exists?,../zut[@row='(prop,die-zutat)'],@logo)">
    
    <file id="mx" flag="cool" x="(loop,kompzut_loop,../zut[@row='(prop,die-zutat)'],@logo)"/>
    <unescape id="mx" type="file"/>
    <translate id="mx" type="file"/>
    <when test="(f,exists_file,(file,mx))">
      <ti type="call_job" max_x="(loop,kompzut_loop,../zut[@row='(prop,die-zutat)'],@logo_max_x)" max_y="(loop,kompzut_loop,../zut[@row='(prop,die-zutat)'],@logo_max_y)" pic="(file,mx)"
          job="zut-see">
          
        <prop id="rez_key">(loop,kompzut_loop,..,@row)</prop>  
        <prop id="zut_key">(loop,kompzut_loop,@zut_key)</prop>
        <file id="zuts">(file,zuts)</file>
        <prop id="zuts_offset">(prop,zuts_offset)</prop>
        <prop id="zuts_offset_label">(prop,zuts_offset_label)</prop>
        <prop id="zuts_offset_new_key">(prop,zuts_offset_new_key)</prop>
        <prop id="zuts_sort_attribute">(prop,zuts_sort_attribute)</prop>
        <prop id="zuts_sort_number">(prop,zuts_sort_number)</prop>
        <prop id="zuts_where">(prop,zuts_where)</prop>
        <prop id="zuts_return_job">(prop,zuts_return_job)</prop> 
      </ti>    
    </when>

  </when>
</try>
<catch>
  <dump_ti label="cateched"/>
</catch>
</try_catch>
</job>

<job id="eine-zutatenverwendung-vorbereiten" role="hidden">
<try_catch>
<try>
       <call_job job="see-pics-of-kompzut" />   
          <prop id="teil" x=""/>
          <prop id="teil" x="(loop,kompzut_loop,@anteil) von " test="(f,has,(loop,kompzut_loop,@anteil))" />
          <prop id="die-menge" x=""/>
          <prop id="die-mengen-einheit" x=""/>
          <!-- <ti>zut-key = (loop,kompzut_loop,@zut_key)</ti>  -->
          <prop id="zutaten-row" >(loop,kompzut_loop,@zut_key)</prop>
          <!-- <ti>zutaten-row = (prop,zutaten-row)</ti>  -->
          <when test="(loop,kompzut_loop,exists?,../zut[@row='(prop,zutaten-row)'],@menge)">
            
            <prop id="die-menge" x="(loop,kompzut_loop,../zut[@row='(prop,zutaten-row)'],@menge)"/>
            
            <when test="(loop,kompzut_loop,exists?,../zut[@row='(prop,zutaten-row)'],@einheit)">
              <prop id="die-mengen-einheit" x="(f,tk_sel_translate,(loop,kompzut_loop,../zut[@row='(prop,zutaten-row)'],@einheit),(dir,app)mengen-selector.xml)"/>
            </when>            
          </when>
</try>
<catch>
  <ti>errror (prop,catched_msg)</ti>
</catch>
</try_catch>
<!-- 
          <when test="(loop,kompzut_loop,exists?,../zut[@row=(loop,kompzut_loop,@zut_key)],@menge)">
            
            
            <when test="(loop,kompzut_loop,exists?,../zut[@row=(loop,kompzut_loop,@zut_key)],@einheit)">
            <prop id="die-mengen-einheit" x="(f,tk_sel_translate,(loop,kompzut_loop,../zut[@row=(loop,kompzut_loop,@zut_key)],@einheit),(dir,app)mengen-selector.xml)"/>
            </when>
          </when>  
          
             -->
          
  <prop id="ein-mengentext">(prop,teil) (prop,die-menge) (prop,die-mengen-einheit)</prop> <!--    -->

  
</job>

<job id="did-insert-ephase" role="hidden">

<prop id="rezeptname" x="(f,xpath,(file,ephasen),rez[@row='(prop,rez_key)'],@bez)"/>
<prop id="komponentenname" x="(f,xpath,(file,ephasen),rez[@row='(prop,rez_key)']/komp[@row='(prop,komp_key)'],@bez)"/>
<!-- 
<ti label="Rezept" test="0">(prop,rezeptname)</ti>
<ti label="Komponente">(prop,komponentenname) von Rezept '(prop,rezeptname)'</ti>
<ti_hr/>
<ti label="Vorgaenge" />
<call_job job="ephase-see-all"/>
<ti_hr/>        -->
 
    <prop id="komps_offset">rez[@row=(prop,rez_key)]/</prop>
    <prop id="komps_label">(prop,rezeptname)</prop>
    <call_job job="komp-see"/>
  <!-- 
  <ti type="call_job" job="komp-see"  label=" " explain="Zur Komponente"  prefix="&gt;&gt; ">
    <prop id="komps_offset">rez[@row=(prop,rez_key)]/</prop>
    <prop id="komps_label">(prop,rezeptname)</prop>
    <prop id="rez_key" x="(prop,rez_key)"/>
    <prop id="komp_key" x="(prop,komp_key)"/>
  </ti>  
  -->
  
  <!-- 
<ti type="call_job" job="rez-see" explain=" '(prop,rezeptname)'" label="Zum 1 Rezept" >
  <prop id="rez_key">(prop,rez_key)</prop>
</ti>  -->

   


</job>

<job id="hook-ephase-add-begin" role="hidden">
<dump_ti label="nach-update-zutatenverwendung" test="0"/>
<when test="(f,exists_file,(dir,pro)rembered1.txt)">
  <prop id="ephase_zut_key">(f,file_content,(dir,pro)rembered1.txt)</prop>
</when>
</job>

<job id="hook-ephase-add-end" role="hidden">
  <dump_ti label="hook-ephase-add-end" test="0"/>
  <when test="(f,has,prop,ephase_zut_key)">
    <create_file file="(dir,pro)rembered1.txt">(prop,ephase_zut_key)</create_file>
  </when>
</job>

<job id="nach-update-zutatenverwendung" role="hidden">
<dump_ti label="nach-update-zutatenverwendung"/>
</job>
  
  <job id="strich" role="hidden">
  
    <!-- 
    <ti_break test="1"/>
    <ti_hr/>      <ti test="(f,gt_num,(loop,komp_loop,#i),1)">  </ti>        -->
    
    <ti_hr test="(f,gt_num,(loop,komp_loop,#i),1)" stxyle="2"/> 
  </job>   
 <job id="hook-komp-detail-starter-off" role="hidden">
 </job>  
 
 <job id="hook-komp-detail-starter" role="hidden">
 <ti test="0">hook-komp-detail-starter a</ti>
  <call_job job="zeige-zutatenliste"/>
  <ti test="0">hook-komp-detail-starter b</ti>
 </job>    
  
<job id="zeige-zutatenliste" role="hidden">

  <need>(prop,rez_key) (prop,komp_key)</need> 
 
  <!-- 
  <prop id="is-single-component" x="0"/>
  
  <choose>
    <when test="(f,eq_text,e,(prop,moda))">
    
      <prop id="is-single-component" x="1"/>
      <when test="(f,has,prop,nbr-of-comps)">
        
        <when test="(f,gt_num,(prop,nbr-of-comps),1)">
          <prop id="is-single-component" x="0"/>
        </when>         
      </when>      
    </when>
    <otherwise>
     
    
    </otherwise>
  
  </choose>
  -->
  <!-- 
  <when test="(f,has,prop,nbr-of-comps)">
    <prop id="is-single-component" x="(f,eq_num,1,(prop,nbr-of-comps))"/>
  </when>                   -->

  <!--             <when test="(f,eq_text,e,(prop,moda))">
  <call_job job="do-create-akt-zutatenliste"/>
  </when>
  <when test="(prop,is-single-component)">
    <ti test="0">da sollten wir was tun</ti>
    <call_job job="do-create-akt-zutatenliste"/>
  </when>
  -->
<when test="(f,gt_num,(prop,moda_zutaten),0)">
  <prop id="kompzuts_offset">rez[@row='(prop,rez_key)']/</prop>
  <prop id="kompzuts_offset_label"></prop>
  <prop id="kompzuts_offset_new_key">//</prop>
  <prop id="kompzuts_where">[@komp_key='(prop,komp_key)']</prop>
  <prop id="kompzut_komp_key">(prop,komp_key)</prop>
  <call_job job="do-create-akt-zutatenliste"/>

  <ti_space height="3px"/>
  <ti>(f,html,i,o)(prop,myclassZutatVerw):(f,html,i,c)</ti>
  <call_job job="kompzut-see-all"/>
  <when test="(f,role,boss)">
  <ti type="call_job" job="Neue Grund-Zutat" explain="[ + neue (prop,myclassZutat) verwenden ]" label=" ">
    <prop id="jobtodo" x="komp-see" />
    <call_job job="prolog" />
    <prop id="rez_key">(prop,rez_key)</prop>

    <prop id="kompzuts_offset">rez[@row='(prop,rez_key)']/</prop>
    <prop id="kompzuts_offset_label"></prop>
    <prop id="kompzuts_offset_new_key">//</prop>
    <prop id="kompzuts_where">[@komp_key='(prop,komp_key)']</prop>
    <prop id="kompzut_komp_key">(prop,komp_key)</prop>      
    
    <prop id="rez_key">(prop,rez_key)</prop>
    <prop id="komp_key">(prop,komp_key)</prop>  
          
    <prop id="zuts_offset">rez[@row='(prop,rez_key)']/</prop>
    <prop id="zuts_offset_label"> fuer Rezept &apos;(f,xpath,(file,rezs),rez[@row=(f,xpath_string,(prop,rez_key))],@bez)&apos;</prop>
    <prop id="zuts_offset_new_key">//</prop> 
    <prop id="komponentenname" x="(f,xpath,(file,ephasen),rez[@row='(prop,rez_key)']/komp[@row='(prop,komp_key)'],@bez)"/>   
  </ti>
  </when>
</when>     




 </job> 
 
<job id="Neue Grund-Zutat" role="hidden">
  <need>(prop,jobtodo)</need>
  <prop id="post_add_script_zut"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<steps/>
]]></prop>
  <call_job job="zut-add"/>

  <prop id="kompzut_key">1</prop>
  <when test="(f,not,(f,exists,prop,kompzuts_offset_new_key))">
    <prop id="kompzuts_offset_new_key">//</prop>
  </when>
  <loop id="max" limit="1" flag="back" xml="(file,kompzuts)" sort="@row" number="@row" xpath="(prop,kompzuts_offset_new_key)kompzut">
    <trace>max key=(loop,max,@row)</trace>
    <trace>i=(loop,max,#i)</trace>
    <prop id="kompzut_key">(f,add,(loop,max,@row),1)</prop>
  </loop>
  <!-- <ti>Generated Key for new Zutaten-Verwendung: #(prop,kompzut_key)</ti> -->
  <prop id="isAdd" x="1"/>
  <prop id="kompzut_komp_key" x="(prop,komp_key)"/>
  <prop id="kompzut_zut_key" x="(prop,zut_key)"/>
  <call_job job="kompzut-write"/>

 <call_job job="do-create-akt-zutatenliste"/>
 <call_job job="do-create-akt-komponentenliste"/>

  <prop id="rezeptname" x="(f,xpath,(file,rezs),rez[@row=(f,xpath_string,(prop,rez_key))],@bez)"/>  
  <prop id="komps_offset">rez[@row=(f,xpath_string,(prop,rez_key))]/</prop>
  <prop id="komps_offset_label"></prop> 
     
  <!-- <ti label="Komponente: (prop,komponentenname)"/> -->
  <call_job job="(prop,jobtodo)" xjob="zeige-zutatenliste"/>

  
 </job>
   
 <job id="zeige-zutatenliste-alt" role="hidden">
  <need>(prop,rez_key) (prop,komp_key)</need>
 
 <try_catch>
<try>

 <spirit act="open" id="starter" xml="(file,rezs)"/>

 
      <prop id="virgin" x="1"/>
      
      <prop id="rezeptname"></prop>
     
      <loop id="v" spirit="starter" xpath="rez[@row=(prop,rez_key)]/kompzut[@komp_key=(prop,komp_key)]" sort="@zut_key"
            missing_strategy="empty">
            
          <when test="(prop,virgin)">
            <!-- <ti label="(f,spirit,starter,rez[@row=(prop,rez_key)],@bez)"/> <ti_hr/>     -->
            <ti></ti>
            <ti_break xinfo="web"/>
            <ti></ti>
            <ti type="rec">
            <ti x="(f,html,i,o)(prop,myclassZutatVerw)(f,html,i,c): " flag="label_right" ylabel=" " />
            </ti>
            <prop id="rezeptname">(loop,v,..,@bez)</prop>
            
            <prop id="virgin" x="0"/>
          </when>
          <prop id="teil" x=""/>
          <prop id="teil" x="(loop,v,@anteil) von " test="(f,has,(loop,v,@anteil))" />
          <prop id="die-menge" x=""/>
          <prop id="die-mengen-einheit" x=""/>
          <when test="(f,spirit,starter,exists?,rez[@row=(prop,rez_key)]/zut[@row=(loop,v,@zut_key)],@menge)">
            <prop id="die-menge" x="(f,spirit,starter,rez[@row=(prop,rez_key)]/zut[@row=(loop,v,@zut_key)],@menge)"/>
            
            <when test="(f,spirit,starter,exists?,rez[@row=(prop,rez_key)]/zut[@row=(loop,v,@zut_key)],@einheit)">
            <prop id="die-mengen-einheit" x="(f,tk_sel_translate,(f,spirit,starter,rez[@row=(prop,rez_key)]/zut[@row=(loop,v,@zut_key)],@einheit),(dir,app)mengen-selector.xml)"/>
            </when>
          </when>
          <!-- <prop id="teil">(prop,teil) (prop,die-menge) (prop,die-mengen-einheit)</prop> -->
        <ti type="rec" xlabel="  " flag="label_right">
          <!-- 
          <ti align="center" explain="(prop,teil)" type="call_job" job="show-zuordnung">
            <prop id="rez_key">(prop,rez_key)</prop>
            <prop id="key_kompzut">(loop,v,@row)</prop>
            <prop id="key_zut">(loop,v,@zut_key)</prop>
            <prop id="key_komp">(loop,v,@komp_key)</prop>
          </ti> 
          -->
          
          <ti explain="(f,spirit,starter,rez[@row=(prop,rez_key)]/zut[@row=(loop,v,@zut_key)],@bez)" type="call_job" job="show-zutat">
            <prop id="rez_key">(prop,rez_key)</prop>
            <prop id="kompzut_key">(loop,v,@row)</prop>
            <prop id="zut_key">(loop,v,@zut_key)</prop>
            <prop id="komp_key">(loop,v,@komp_key)</prop>
            <prop id="rezeptname">(loop,v,..,@bez)</prop>
          </ti>
          <ti align="left" >(prop,teil) (prop,die-menge) (prop,die-mengen-einheit)</ti>
          <!-- 
          <ti align="left" explain="(prop,teil) (prop,die-menge) (prop,die-mengen-einheit)" type="call_job" job="show-zuordnung">
            <prop id="rez_key">(prop,rez_key)</prop>
            <prop id="kompzut_key">(loop,v,@row)</prop>
            <prop id="zut_key">(loop,v,@zut_key)</prop>
            <prop id="komp_key">(loop,v,@komp_key)</prop>
            <prop id="rezeptname">(loop,v,..,@bez)</prop>
          </ti> -->
                              
          <ti></ti> 
          <ti></ti>
               

         </ti>
      </loop>
     <spirit act="close" id="starter"/>  
     
     <ti type="call_job" job="neue-zuordnung" explain="[ + Zutat verwenden ]" label=" " test="(f,role,boss)">
      <prop id="rez_key">(prop,rez_key)</prop>
      <prop id="komp_key">(prop,komp_key)</prop>
      <prop id="rezeptname">(prop,rezeptname)</prop>
     </ti> 
     <!--
     <ti type="call_job" job="do-org-me" explain="organizieren" label=" ">
      <file id="orga">(file,rezs)</file>
      <prop id="orga_segment_plural_label">Etwas</prop>
      <prop id="orga_offset">rez[@row=(prop,rez_key)]/</prop>
      <prop id="orga_segment_singular">kompzut[@komp_key=(prop,komp_key)]</prop>
      
      <prop id="orga_name_expression_loop"></prop>
      <prop id="orga_desc_expression_loop"></prop>
     </ti>      
     
<ti flag="no_arrow" label=" " type="call_service" explain="/ Organize /" job="do-org-me">
<file id="orga">(file,rezs)</file>
<prop id="orga_offset">rez[@row=(prop,rez_key)]/</prop>
<prop id="orga_offset_label">rezept (prop,rez_key)</prop>
<prop id="orga_offset_new_key">//</prop>
<prop id="orga_segment_plural">kompzuts</prop>
<prop id="orga_segment_singular">kompzut</prop>
<prop id="orga_segment_plural_label">Komponente-Zutat</prop>
<prop id="orga_segment_singular_label">Kompopn-zutaten-</prop>
