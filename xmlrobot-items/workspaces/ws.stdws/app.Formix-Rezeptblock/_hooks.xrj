<?xml version="1.0" encoding="UTF-8"?>

<jobs>
<job id="get-new-key" role="hidden">
  <!-- <call_job job="prolog" /> -->
  <file id="rezs">(dir,pro)rezs.xml</file>
  <file id="nk" x="(file,rezs)"/>
  <try_catch>
    <try>
      <need>(file,nk) (prop,nk-singular)</need>
    </try>
    <catch>
      
      <tk xflag="sum" label="Generate new key for ?">
        <tk type="file" id="nk" label="Das File" x="(file,rezs)" flag="nono" test="0"/>
        <tk type="sel" id="nk-singular" flag="nono">
          <sel label="Rezept">rez</sel>
          <sel label="Zutat">zut</sel>
          <sel label="Option">opt</sel>
          <sel label="Vorgang">ephase</sel>
          <sel label="Komponente">komp</sel>
          <sel label="Zutaten-Verwendung">kompzut</sel>
        </tk>
      </tk>
    </catch>
  </try_catch>

  <prop id="nk-key">1</prop>

  <loop id="nk" limit="1" flag="back" xml="(file,nk)" sort="@row" number="@row" xpath="//(prop,nk-singular)">
    <trace>max key=(loop,nk,@row)</trace>
    <trace>i=(loop,nk,#i)</trace>
    <prop id="nk-key">(f,add,(loop,nk,@row),1)</prop>
  </loop>  
  <ti>new row-key for (prop,nk-singular) is: (prop,nk-key)</ti>
  
  <need>(prop,nk-key)</need>
</job>

<job id="event-rez-insert" role="hidden">
  
  <when test="(f,eq_text,e,(prop,moda))"> 
    <file id="nk" x="(file,komps)"/>
    <prop id="nk-singular" x="komp"/>
    <call_job job="get-new-key"/>
    <need>(prop,nk-key)</need>
    <prop id="komp_key" x="(prop,nk-key)"/>
    
    
    <prop id="isAdd" x="1"/>
    <prop id="komps_offset">rez[@row=(prop,rez_key)]/</prop>
    <prop id="komp_bez" x="(prop,rez_bez)"/>
    <call_job job="komp-write"/>
    <ti align="right" x=" ">Did create default component due to moda==e</ti>
  </when>
  <call_job job="rez-see-all"/>
  <!-- 
  
  <prop id="kompzut_komp_key" x="(prop,komp_key)"/>
  <prop id="kompzut_zut_key" x="(prop,zut_key)"/>
  <call_job job="kompzut-write"/>  
  <call_job job="rez-see-all"/>
  -->
</job>

<job id="did-finish-orga-rezkomp" role="hidden">
  <call_job job="prolog" />
  <!-- -->
  <prop id="komp_key">(f,substring_before,(f,substring_after,(prop,orga_where),[@komp_key='),'])</prop>
  <prop id="rez_key">(f,substring_before,(f,substring_after,(prop,orga_offset),rez[@row='),'])</prop>
  <prop id="rezeptname" x="(f,xpath,(file,rezs),rez[@row=(f,xpath_string,(prop,rez_key))],@bez)"/>
  
  <prop id="komps_offset">rez[@row=(f,xpath_string,(prop,rez_key))]/</prop>
  <prop id="komps_offset_label"> </prop>
  
  <call_job job="komp-see"/>                    <!--[Rezept (prop,rezeptname)] -->
    

</job>

<job id="zutatenverwendung-detail-ende" role="hidden">

  <prop id="zuts_offset">rez[@row='(prop,rez_key)']/</prop>
  <!--The offset label is communicated to the user, it verbalizes the offset /zut[@row='(prop,kompzut_zut_key)']-->
  <prop id="zuts_offset_label"></prop>
  <prop id="zuts_where"/>
  
  <prop id="zut_key">(prop,kompzut_zut_key)</prop>
  <ti_hr/>
  <ti type="rec">
  <ti>zugrundeliegend - base - 基部 基底 - au base de  ...</ti>
  </ti>
  <call_job job="zut-see"/>
  <!-- 
  <ti_hr style="2"/>
  <call_job job="zum-rezept-link"/>     -->
  
    

</job>

