<prop id="orga_sort_number"></prop>
<prop id="orga_where">@komp_key=(prop,komp_key)</prop>
<prop id="orga_name_expression_loop">()(f,html,bold,open)(loop,i,@bez)(f,html,bold,close)()</prop>
<prop id="orga_desc_expression_loop">()(f,text,cut_nice,(loop,i,@beschreibung),40)()</prop>
</ti>     
             -->
    <ti_break info="web"/>
</try>
<catch>
<dump_ti label="Hallo from starter komponent"/>
</catch> 
 </try_catch>
 

    
</job>
