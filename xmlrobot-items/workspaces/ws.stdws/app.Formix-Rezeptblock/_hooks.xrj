<job id="hook_rezeptdetails" role="hidden">



<!-- <dump_ti label="ACTHUNG"/> -->


<try_catch>
<try>

  <!-- hier die bilder -->
  <choose>
    <when test="(f,role,boss)">
      <file id="rezpics">(file,rezs)</file>
      <prop id="rezpics_offset">rez[@row=(prop,rez_key)]/</prop>
      <prop id="rezpics_offset_label"/>
      <prop id="rezpics_offset_new_key">//</prop>
      <prop id="rezpics_sort_attribute"/>
      <prop id="rezpics_sort_number"/>
      <prop id="rezpics_sort_ignore_case"/>
      <prop id="rezpics_sort_desc"/>
      <prop id="rezpics_where"/>
      <prop id="rezpics_return_job">rez-see</prop>  
      <ti label="Pictures"/>    
      <call_job job="rezpic-see-all"/>
      <!-- 
      <ti type="call_job" job="see-the-pics" explain="See all pictures/Autor" label=" ">
        <call_job job="prolog"/>
        <file id="pics">(file,rezs)</file>
        <prop id="pics_xpath">rez[@row=(prop,rez_key)]/rezpic</prop>
        <prop id="pics_div" x="0"/>  
      </ti>         -->
      <ti type="call_job" job="see-the-pics" explain="See all pictures" label=" ">
        <call_job job="prolog"/>
        <file id="pics">(file,rezs)</file>
        <prop id="pics_xpath">rez[@row=(prop,rez_key)]/rezpic</prop>
        <prop id="pics_div" x="1"/>  
      </ti>           
    </when>
    <otherwise>
      <call_job job="see-the-pics">
        <file id="pics">(file,rezs)</file>
        <prop id="pics_xpath">rez[@row=(prop,rez_key)]/rezpic</prop> 
        <prop id="pics_div" x="1"/> 
      </call_job>
    </otherwise>
  </choose>
  
  <!-- bilder fertig -->
  <create_file file="(file,akt-rez)">(prop,rez_key)</create_file>
  <prop id="mymoda" x="(prop,moda)"/>
  <call_job job="einfache-komponentenliste-max"/>
  <call_job job="do-create-akt-zutatenliste"/>
  <call_job job="do-create-akt-komponentenliste"/>
  
  <prop id="nbr-of-comps" x="(prop,max)"/>
  
  <when test="(f,eq_text,e,(prop,moda))">
  <when test="(f,not,(f,eq_num,1,(prop,max)))">
    <prop id="mymoda" x="m"/>
  </when>
  </when>
  <ti x="  " key="modaZ2=(prop,moda).(prop,mymoda)" test="0"/>
  
  <prop id="zuts_offset">rez[@row=(prop,rez_key)]/</prop>
  <prop id="zuts_offset_label"/>
  <prop id="zuts_offset_new_key">//</prop>
  <prop id="zuts_sort_attribute"></prop>
  <prop id="zuts_sort_number"></prop>
  <prop id="zuts_sort_ignore_case"/>
  <prop id="zuts_sort_desc"/>
  <prop id="zuts_where"/>
  <prop id="zuts_return_job">rez-see</prop>    
  
  <!-- einfache komponenten sicht -->
  <when test="(f,eq_text,e,(prop,mymoda))">
  

    <ti_space height="3px"/>
    <!-- 
    <prop id="zadd" x=""/>
    <prop id="zadd" x="(e:o)(prop,rez_portionen) Portion(f,plural,(prop,rez_portionen),en)(e:c)"
          test="(f,has,prop,rez_portionen)"/>   -->
       

    
    <when test="(f,eq_num,0,(prop,max))">
      <ti>keine komponente gefunden</ti>
    </when>
    <prop id="komp_key" x=""/>
    <loop id="firstkomp" xml="(file,komps)" xpath="rez[@row=(prop,rez_key)]/komp" limit="1">
      <ti test="0">(loop,firstkomp,#i). Komponente</ti>
      <prop id="komp_key" x="(loop,firstkomp,@row)"/>
    </loop>


      
    <choose>
      <when test="(f,has,prop,komp_key)">
      
        <prop id="kompzuts_offset">rez[@row='(prop,rez_key)']/</prop>
        <prop id="kompzuts_offset_label"></prop>
        <prop id="kompzuts_offset_new_key">//</prop>
        <prop id="kompzuts_where">[@komp_key='(prop,komp_key)']</prop>
        <prop id="kompzut_komp_key">(prop,komp_key)</prop>
      
        <when test="(f,gt_num,(prop,moda_zutaten),0)">
          <ti_space height="3px"/>
          <ti label="(prop,myclassZutatVerw)" />        
          <call_job job="kompzut-see-all"/>
          <when test="(f,role,boss)">
            <ti type="call_job" job="Neue Grund-Zutat" explain="[ + neue Zutat verwenden ]" label=" ">
              <prop id="jobtodo" x="rez-see" />
              <call_job job="prolog" />
              <prop id="rez_key">(prop,rez_key)</prop>
          
              <prop id="kompzuts_offset">rez[@row='(prop,rez_key)']/</prop>
              <prop id="kompzuts_offset_label"></prop>
              <prop id="kompzuts_offset_new_key">//</prop>
              <prop id="kompzuts_where">[@komp_key='(prop,komp_key)']</prop>
              <prop id="kompzut_komp_key">(prop,komp_key)</prop>      
              
              <prop id="rez_key">(prop,rez_key)</prop>
              <prop id="komp_key">(prop,komp_key)</prop>  
                    
              <prop id="zuts_offset">rez[@row='(prop,rez_key)']/</prop>
              <prop id="zuts_offset_label"> fuer Rezept &apos;(f,xpath,(file,rezs),rez[@row=(f,xpath_string,(prop,rez_key))],@bez)&apos;</prop>
              <prop id="zuts_offset_new_key">//</prop> 
              <prop id="komponentenname" x="(f,xpath,(file,ephasen),rez[@row='(prop,rez_key)']/komp[@row='(prop,komp_key)'],@bez)"/>   
            </ti>    
           </when>         
        
          <prop id="ephasen_offset">rez[@row=(prop,rez_key)]/komp[@row=(prop,komp_key)]/</prop>
          <prop id="ephasen_offset_label"/>
          <prop id="ephasen_offset_new_key">//</prop>
          <prop id="ephasen_sort_attribute"></prop>
          <prop id="ephasen_sort_number"></prop>
          <prop id="ephasen_sort_ignore_case"/>
          <prop id="ephasen_sort_desc"/>
          <prop id="ephasen_where"/>
          <prop id="ephasen_return_job">komp-see</prop>  
        </when>
        <ti_space height="6px"/>
      
        <ti label="(f,vob,prop,mcDokumentation)" />
   
        <call_job job="ephase-see-all"/>      
       
      </when>
      <otherwise>
        <ti x=" " key="Keine Komponente gefunden(e:s) Darstellung erfolgt im Mehr-Komponenten-Modus"/>
        <prop id="mymoda" x="m"/>
      </otherwise>
    
    </choose>
 
  </when>
  <when test="(f,eq_text,m,(prop,mymoda))">
  
        <ti label="(prop,myclassZutatPl)" />
        <call_job job="zut-see-all"/>

        <call_job job="einfache-komponentenliste"/>  
        
        <file id="komps">(file,rezs)</file>
        <prop id="komps_offset">rez[@row=(prop,rez_key)]/</prop>
        <prop id="komps_offset_label"/>
        <prop id="komps_offset_new_key">//</prop>
        <prop id="komps_sort_attribute"/>
        <prop id="komps_sort_number"/>
        <prop id="komps_sort_ignore_case"/>
        <prop id="komps_sort_desc"/>
        <prop id="komps_where"/>
        <prop id="komps_return_job">rez-see</prop>      
        <call_job job="komp-see-all"/>  
  </when>

  <when test="(f,role,expert)">
    <ti_hr/>
  
    <ti label="Bestellungen" xx=" "/>
    
    <try_catch>
    <try>
    <call_job job="order-see-all"/>
    </try>
    <catch>
      <ti>probleme mit den bestellungen</ti>
    </catch>
    </try_catch>   
  </when>
  <ti_break/>

  
  <ti type="call_job" job="mext-rezept" explain="Next Rezept" pic="(dir,libro)next-logo.png"  max_y="60" label=" ">
    <prop id="prev_rez_key" x="(prop,rez_key)"/>
  </ti>

  
</try>
<catch>
  <ti label="error">(prop,catched_msg)</ti>
</catch>
</try_catch>      
</job>

<job id="mext-rezept" role="hidden">
    <need>(prop,prev_rez_key)</need>
    <call_job job="prolog"/>
    <prop id="passed" x="0"/>
    <prop id="passedDone" x="0"/>
    <prop id="next_key" x=""/>
    <loop id="r" xml="(file,rezs)" xpath="rez">
    
      <choose>
        <when test="(prop,passedDone)">
        </when>      
        <when test="(prop,passed)">
          <prop id="next_key" x="(loop,r,@row)"/>
          <prop id="passedDone" x="1"/>
        </when>
        <when test="(f,eq_num,(loop,r,@row),(prop,prev_rez_key))">
          <prop id="passed" x="1"/>
        </when>
      </choose>
    
    </loop>
    
    <choose>
      <when test="(f,has,prop,next_key)">      
        <call_job job="rez-see" >
          <prop id="rez_key" x="(prop,next_key)"/>
        </call_job>
      </when>
      <otherwise>
         <call_job job="Liste der Rezepte" />
      </otherwise>
    </choose>
    <!-- 
      <ti type="call_job"  label=" " xprefix="&gt;&gt; " job="rez-see" explain="[ (prop,myclassAkt) ]">
    <prop id="rez_key" x="(prop,rez_key)"/>   -->
  
</job>

<job id="hook_rezeptdetails-xx" role="hidden">

   <ti>post 1</ti>
  <call_job job="do-create-akt-komponentenliste" />  
       <ti>post 2</ti>
  <create_file file="(file,akt-rez)">(prop,rez_key)</create_file>
  
  <dump_ti test="0"/>
  <prop id="zuts_offset">rez[@row=(prop,rez_key)]/</prop>
  <prop id="zuts_offset_label"/>
  <prop id="zuts_offset_new_key">//</prop>
  <prop id="zuts_sort_attribute">@sort</prop>
  <prop id="zuts_sort_number">@sort</prop>
  <prop id="zuts_sort_ignore_case"/>
  <prop id="zuts_sort_desc"/>
  <prop id="zuts_where"/>
  <prop id="zuts_return_job">rez-see</prop>  
  <ti_space height="3px"/>
  <prop id="zadd" x=""/>
  <prop id="zadd" x="(e:o)(prop,rez_portionen) Portion(f,plural,(prop,rez_portionen),en)(e:c)"
        test="(f,has,prop,rez_portionen)"/>
 <ti>post 3</ti>       
 <when test="(f,eq_text,e,(prop,moda))">
        <ti label="(prop,myclassZutatPl)" />
      <call_job job="zut-see-all"/>
 </when> 
        <ti>post 4</ti>
  <try_catch>
    <try>  
    <ti>post 5</ti>
    <call_job job="einfache-komponentenliste-max"/>
    <ti>post 6</ti>
    <when test="(f,eq_text,e,(prop,moda))">
    <when test="(f,not,(f,eq_num,1,(prop,max)))">
      <ti_hr/>
      <ti label="Zutatenliste" />
      <ti>post 7</ti>
      <call_job job="zut-see-all"/>     
      <ti>post 8</ti>
    </when>
    </when>

    
     <ti>post 9</ti>
        
    <when test="(f,gt_num,(prop,max),1)">
        
        <!-- <ti>mehr als eine komponente</ti><ti_hr/><ti_hr style="2aL" label="1(e:c) Zutaten (prop,zadd)"/>   
        <ti_hr/>
        <ti label="Grund-Zutaten (f,html,b,o)(prop,zadd)(f,html,b,c)" xx=" "/>    
        <ti>post 1</ti>                                                                                  -->
        <ti>post 10</ti>
        <call_job job="hook-kompzutat-editor-begin"/>   
        <ti>post 11</ti>
    </when>
    <ti>post 12</ti>

  

  <file id="komps">(file,rezs)</file>
  <prop id="komps_offset">rez[@row=(prop,rez_key)]/</prop>
  <prop id="komps_offset_label"/>
  <prop id="komps_offset_new_key">//</prop>
  <prop id="komps_sort_attribute"/>
  <prop id="komps_sort_number"/>
  <prop id="komps_sort_ignore_case"/>
  <prop id="komps_sort_desc"/>
  <prop id="komps_where"/>
  <prop id="komps_return_job">rez-see</prop>
  <ti_space height="3px"/>
   <ti>post 13</ti>
  <ti>moda = (prop,moda)</ti>
  <when test="(f,eq_num,(prop,max),1)">
    <ti_hr/>
  </when>  
  <ti>post 14</ti>
  <when test="(f,eq_text,(prop,moda),m)">
  <when test="(f,gt_num,(prop,max),1)">
    <ti>post 15</ti>
    <call_job job="einfache-komponentenliste"/>
    <ti>post 16</ti>
  </when>
  </when>
  <ti>post 17</ti>
  <need>(prop,max)</need>
  <prop id="nbr-of-comps" x="(prop,max)"/>

  <call_job job="komp-see-all"/>   
  <ti>post 18</ti>
  <!-- 
  <prop id="kompzuts_offset">rez[@row=(prop,rez_key)]/</prop>
  <prop id="kompzuts_offset_label"/>
  <prop id="kompzuts_offset_new_key">//</prop>
  <prop id="kompzuts_sort_attribute">@komp_key</prop>
  <prop id="kompzuts_sort_number"/>
  <prop id="kompzuts_sort_ignore_case"/>
  <prop id="kompzuts_sort_desc"/>
  <prop id="kompzuts_where"/>
  <prop id="kompzuts_return_job">kompzut-see</prop>
                        -->
  
  <ti_hr/>

  <ti label="3(e:c) Bestellungen" xx=" "/>
  
  
  <call_job job="order-see-all"/>     
    
  </try>
  <catch>
    <dump_ti label="catched"/>
  </catch>
  </try_catch>    
  <ti_hr/>
  
  <ti type="call_job" job="rez-see-all" explain="Liste aller Rezepte" label=" " prefix="&gt;&gt; " />
  
 
</job>

<job id="event-ephase-orga-finished" role="hidden">
   <dump_ti label="event-ephase-orga-finished" test="0"/>
   <call_job job="prolog" />
   <call_job job="Aktuelle Komponente"/>
</job>   

<job id="komp-finalizer" role="hidden">
<ti test="0">komp-finalizer</ti>
  <dump_ti label="komp-finalizer" test="0"/>
  <when test="(f,has,prop,komp_moda_zutaten)">
    <prop id="moda_zutaten" x="(prop,komp_moda_zutaten)"/>
  </when>
  <try_catch>
    <try>    
      <create_file file="(file,akt-komp)">(prop,komp_key)</create_file>
      <create_file file="(file,akt-rez)">(prop,rez_key)</create_file>
      <when test="(f,eq_num,1,(prop,moda_zutaten))">
       <call_job job="zeige-zutatenliste" />
      </when>
      
      <prop id="ephasen_offset">rez[@row=(prop,rez_key)]/komp[@row=(prop,komp_key)]/</prop>
      <prop id="ephasen_offset_label"/>
      <prop id="ephasen_offset_new_key">//</prop>
      <prop id="ephasen_sort_attribute"></prop>
      <prop id="ephasen_sort_number"></prop>
      <prop id="ephasen_sort_ignore_case"/>
      <prop id="ephasen_sort_desc"/>
      <prop id="ephasen_where"/>
      <prop id="ephasen_return_job">komp-see</prop>  
    
      <ti_space height="6px"/>
    
      <ti>(f,html,i,o)Aktionen:(f,html,i,c)</ti>


      <call_job job="ephase-see-all"/>
      
      <when test="(f,eq_num,2,(prop,moda_zutaten))">
       <call_job job="zeige-zutatenliste" />
      </when>
            
  </try>
  <catch> 
    <ti>catched msg= (prop,catched_msg)</ti>
  </catch>
  </try_catch>
    
   
  <ti_hr/>
  <call_job job="zum-rezept-link"/>   



</job>

<job id="komp-see-all-event" role="hidden">
  <call_job job="komp-see-all"/>
  
  <ti_hr/>
  <call_job job="zum-rezept-link"/>
</job>

<job id="kompzut-see-all-event" role="hidden">

  <call_job job="kompzut-see-all"/>
  
  <ti_hr/>
<call_job job="zum-rezept-link"/> 
</job>

<job id="hook-ephase-detail-end" role="hidden">


  <ti_hr style="2"/>
  
  <ti type="call_job"  label=" " prefix="&gt;&gt; " job="komp-see" 
  explain="Zur Komponente &apos;(f,xpath,(file,rezs),rez[@row=(prop,rez_key)]/komp[@row=(prop,komp_key)],@bez)&apos;">
    <prop id="komps_offset">rez[@row=(prop,rez_key)]/</prop>
    <prop id="rez_key" x="(prop,rez_key)"/>
    <prop id="komp_key" x="(prop,komp_key)"/>
  </ti>    
 
  
<call_job job="zum-rezept-link"/>  
 
  

</job>

