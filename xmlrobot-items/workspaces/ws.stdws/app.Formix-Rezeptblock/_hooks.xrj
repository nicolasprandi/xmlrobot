<job id="see-options-list" role="hidden">
  <need>(prop,rez_key)</need>

  <prop id="did-intro" x="0"/>
  <loop id="x" xml="(file,rezs)" xpath="rez[@row=(prop,rez_key)]/zut/opt"
        missing_strategy="empty">
      
      <when test="(f,eq_num,0,(prop,did-intro))">
      
        <prop id="did-intro" x="1"/>
            <ti_space height="3px"/>

  <ti label="Zutaten-Optionen" flag="label_right">  </ti>       
        
        <!--
            <ti_space height="3px"/>
  <ti_hr style="2aL" label="2(e:c) Arbeitsschritte"/>
        -->
        
      </when>
      
      <ti type="rec" label="(loop,x,@bez);" flag="label_right">
     
     <ti type="call_job" prefix="  " job="opt-see" explain="(loop,x,@bez) fuer (loop,x,..,@bez)">          
        <prop id="opts_offset">rez[@row=(loop,x,../..,@row)]/zut[@row=(loop,x,..,@row)]/</prop>
        <prop id="opts_offset_label"/>
        <prop id="opts_offset_new_key">//</prop>
        <prop id="opts_sort_attribute"></prop>
        <prop id="opts_sort_number"></prop>
        <prop id="opts_sort_ignore_case"/>
        <prop id="opts_sort_desc"/>
        <prop id="opts_where"/>
        <prop id="opts_return_job">opt-see</prop>  
        <prop id="rez_key" x="(loop,x,../..,@row)"/>  
        <prop id="zut_key" x="(loop,x,..,@row)"/>  
        <prop id="opt_key" x="(loop,x,@row)"/>   
        <ti label="Optionen zu zutat [(loop,x,..,@bez)]"/>
     </ti>

     <ti>(loop,x,@besch)</ti>
     </ti>
  </loop>
</job>

<job id="hoop-opt-detail-end" role="hidden">
<call_job job="zum-rezept-link"/>

  <ti type="rec">
  <ti type="call_job" job="zut-see" explain="Zur Zutat">
  <prop id="rez_key" x="(prop,rez_key)"/>
    <prop id="zut_key" x="(prop,zut_key)"/>
  </ti>  
  </ti>
  <dump_ti test="0"/>  
</job>

<job id="einfache-komponentenliste-max" role="hidden">
  <prop id="komps_offset">rez[@row=(prop,rez_key)]/</prop>
  <prop id="max" x="0"/>
  <loop 
      missing_strategy="empty" 
      id="komp_loop" 
      xml="(file,komps)" 
      xpath="(prop,komps_offset)komp" >                                           
      <prop id="max" x="(loop,komp_loop,#i)"/>
  </loop>

</job>

<job id="einfache-komponentenliste" role="hidden">
  <ti test="0">in einfache-komponentenliste</ti>
  <prop id="kompzuts_offset">rez[@row=(prop,rez_key)]/</prop>
  <prop id="max" x="0"/>
  <loop 
      missing_strategy="empty" 
      id="komp_loop" 
      xml="(file,komps)" 
      xpath="(prop,komps_offset)komp" >
      <when test="(f,eq_num,1,(loop,komp_loop,#i))">
        <ti_hr/>  
        <ti label="Komponenten" xx=" "/>
      </when>
      <!-- 
      <ti prxefix="   " label="(loop,komp_loop,#i).(f,text,cut_nice,(loop,komp_loop,@bez),23)" 
      x="(f,try,()(f,substring,(loop,komp_loop,@bez),20)())"/>
      -->
      
      <ti type="rec">
        <ti type="call_job"   prefix="(loop,komp_loop,#i). " job="komp-see" 
        explain="(loop,komp_loop,@bez)" span="9" fxlag="block">
          <prop id="komps_offset">rez[@row=(prop,rez_key)]/</prop>
          <prop id="rez_key" x="(prop,rez_key)"/>
          <prop id="komp_key" x="(loop,komp_loop,@row)"/>
        </ti> 
      </ti>
      <!-- 
      <ti label=" " type="rec">
        <ti prefix="   ">(loop,komp_loop,#i).(loop,komp_loop,@bez)</ti>
      </ti>                                              -->
      <prop id="max" x="(loop,komp_loop,#i)"/>
  </loop>
  <when test="(f,gt_num,(prop,max),1)">
    <ti_hr/>
    
  </when>

</job>
<job id="hook-rezpic-detail-end" role="hidden">

<prop id="the-fn-upper" x="(f,lower,(f,name_of_file,(file,rezpic_pic)))"/>
<ti>the-fn-upper=(prop,the-fn-upper)</ti>
<when test="(f,or,(f,ends_with,(prop,the-fn-upper),.jpg),(f,ends_with,(prop,the-fn-upper),.png))">
  <ti_hr/>
  <ti label="libro">(f,file,libro,(file,rezpic_pic))</ti>
  <ti type="img" alt="(prop,rezpic_bez)" max_x="(prop,rezpic_max_x_px)" max_y="(prop,rezpic_max_y_px)">(file,rezpic_pic)</ti>
  <ti>Scaled</ti>
  <ti_hr style="2"/>
  <ti>Original</ti>
   <ti type="img" alt="(prop,rezpic_bez)" xmax_x="(prop,rezpic_max_x_px)" xmax_y="(prop,rezpic_max_y_px)">(file,rezpic_pic)</ti>
</when>

</job>

<job id="see-the-pics" role="hidden">
  <need>(file,pics) (prop,pics_xpath)</need>
  <need default="0">(prop,pics_div)</need>
  <file id="tpx" x="(f,request,dir,session_home_mem)pics(f,random_text,4)"/>
  <print act="open" id="tpx" out="(file,tpx)"/>
  <print act="println" id="tpx">&lt;?xml version="1.0" encoding="UTF-8"?&gt;&lt;steps&gt;</print>
  <print act="print" id="tpx">&lt;ti type="rec"</print> 
  
  <print act="print" id="tpx" test="(prop,pics_div)"> flag="divs"</print>
  
  <print act="println" id="tpx">&gt;</print>  
  

  <loop missing_strategy="empty" id="pics" xml="(file,pics)" xpath="(prop,pics_xpath)">
    <when test="(loop,pics,exists?,@pic)">
      <file id="mp" flag="cool" x="(loop,pics,@pic)"/>

      <unescape id="mp" type="file"/>

      <translate id="mp" type="file"/>                    

      <print act="print" id="tpx">&lt;ti type="img" </print>
      
      <print act="print" id="tpx" test="(f,has,(loop,pics,@max_x_px))"> max_x="(loop,pics,@max_x_px)" </print>
            
      
      <print act="print" id="tpx" test="(f,has,(loop,pics,@max_y_px))"> max_y="(loop,pics,@max_y_px)" </print>
      
      <print act="print" id="tpx" test="(f,has,(loop,pics,@bez))"> alt="(loop,pics,@bez)" </print>
          
      <print act="println" id="tpx"> pic="(file,mp)"/&gt;</print>              
      
    </when>
  </loop>
  
  <print act="println" id="tpx">&lt;/ti&gt;</print>
  <print act="println" id="tpx">&lt;/steps&gt;</print>
  <print act="close" id="tpx"/>
 
  
  <include file="(file,tpx)"/>
  
  <!--    <ti>(f,file_content,(file,tpx)) </ti>    <ti type="file" x="(file,tpx)"/>   
  <when test="(f,has,prop,html)">
    <ti>derhtml</ti>
    <ti flag="html">&lt;div &gt;(prop,html)&lt;/div &gt;</ti>
  </when>
  -->
  
</job> 
<job id="see-the-pics-gut" role="hidden">
  <need>(file,pics) (prop,pics_xpath)</need>
  <loop missing_strategy="empty" id="pics" xml="(file,pics)" xpath="(prop,pics_xpath)">
    <when test="(loop,pics,exists?,@pic)">
      <file id="mp" flag="cool" x="(loop,pics,@pic)"/>

      <unescape id="mp" type="file"/>

      <translate id="mp" type="file"/>

      <ti type="img">(file,mp)</ti>
      
      <choose>
        <when test="(f,role,boss)">
          <ti>(f,html,b,o)(loop,pics,@bez)(f,html,b,c)</ti>
          <ti>(f,html,b,o)(f,name_of_file,(file,mp))(f,html,b,c)</ti>
          <ti flag="wrap">(file,mp)</ti>
          <ti_hr/>        
        </when>
        <otherwise>
          <ti>(loop,pics,@bez)</ti>
          <ti> </ti>
        </otherwise>
      </choose>

      
    </when>
  </loop>
</job> 

<job id="hook-every-ephase-list" role="hidden">
  <when test="(f,has,(loop,ephase_loop,@logo))">
  
    <!-- <ti_hr style="14"/> -->
    <ti_space height="10px" test="(f,gt_num,(loop,ephase_loop,#i),1)" />
    
    <file id="mx" flag="cool" x="(loop,ephase_loop,@logo)"/>
    <unescape id="mx" type="file"/>
    <translate id="mx" type="file"/>
    <when test="(f,exists_file,(file,mx))">
      <ti type="call_job" max_x="(loop,ephase_loop,@logo_max_x)" max_y="(loop,ephase_loop,@logo_max_y)" pic="(file,mx)"
          job="ephase-see">
        <prop id="rez_key">(loop,ephase_loop,../..,@row)</prop>  
