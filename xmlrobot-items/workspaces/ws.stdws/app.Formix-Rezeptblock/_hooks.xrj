<job id="see-ephasen-list" role="hidden">
  <need>(prop,rez_key)</need>
   
  <prop id="did-intro" x="0"/>
  <loop id="x" xml="(file,rezs)" xpath="rez[@row=(prop,rez_key)]/komp/ephase"
        missing_strategy="empty">
      
      <when test="(f,eq_num,0,(prop,did-intro))">
      
        <prop id="did-intro" x="1"/>
            <ti_space height="3px"/>

  <ti label="Komponenten-Phasen" flag="label_right">  </ti>       
        
        <!--
            <ti_space height="3px"/>
  <ti_hr style="2aL" label="2(e:c) Arbeitsschritte"/>
        -->
        
      </when>
      
      <ti type="rec" label="(loop,x,..,@bez) (loop,x,@phase) " flag="label_right">
     
     <ti type="call_job" prefix="  " job="ephase-see" explain="(loop,x,@bez) sdaf (loop,x,..,@bez)">          
        <prop id="ephasen_offset">rez[@row=(loop,x,../..,@row)]/komp[@row=(loop,x,..,@row)]/</prop>
        <prop id="ephasen_offset_label"/>
        <prop id="ephasen_offset_new_key">//</prop>
        <prop id="ephasen_sort_attribute"></prop>
        <prop id="ephasen_sort_number"></prop>
        <prop id="ephasen_sort_ignore_case"/>
        <prop id="ephasen_sort_desc"/>
        <prop id="ephasen_where"/>
        <prop id="ephasen_return_job">ephase-see</prop>  
        <prop id="rez_key" x="(loop,x,../..,@row)"/>  
        <prop id="komp_key" x="(loop,x,..,@row)"/>  
        <prop id="ephase_key" x="(loop,x,@row)"/>   
        <ti label="Phase zu Komponente [(loop,x,..,@bez)]"/>
     </ti>

     <ti>(loop,x,@besch)</ti>
     </ti>
  </loop>
</job>
<job id="hook-komp-listend" role="hidden">

  <when test="(f,eq_text,e,(prop,moda))">
  <!-- 
    <ti test>hier noch die ephasen zur ersten komponente im rezept</ti>
    <dump_ti/>                  -->
  </when>
</job>
<job id="hook-komp-listed" role="hidden">
  <ti test="0">hook-komp-listed</ti>
  <call_job job="hook-komp-detail-starter">
    <prop id="komp_key" x="(loop,komp_loop,@row)"/>
  </call_job>
</job>
<job id="hook-komp-listed2" role="hidden">
<ti test="0">hook-komp-listed2</ti>
<try_catch>
<try>
  <ti test="0">hallo nic123 komp_key=(loop,i,@row) komps_offset=(prop,komps_offset)</ti>
  <dump_ti label="dada" test="0"/>
  
  <call_job job="hook-komp-detail-starter">
    <prop id="komp_key" x="(loop,i,@row)"/>
  </call_job>
            
 <prop id="virg" x="1"/>
 <prop id="rezeptname"></prop>
 <prop id="komponentenname"></prop>
 <spirit id="r" act="open" file="(file,komps)"/>
  <loop id="r" spirit="r" xpath="(prop,komps_offset)komp[@row=(loop,i,@row)]/ephase"
        missing_strategy="empty" sort="@phase" number="@phase">
      <when test="(prop,virg)">
        <ti x="(f,html,b,o)Vorgangs-Doku(f,html,b,c)" flag="label_right" label=" "/>
          <prop id="virg" x="0" span="5" colspan="5"/>
          
         <prop id="rezeptname">(loop,r,../../@bez)</prop>
         <prop id="komponentenname">(loop,r,../@bez)</prop>          
      </when>
     
      <prop id="zutatheader"></prop>
      
      
      <when test="(f,has,(loop,r,@zut_key))">
         <prop id="zutatheader">(f,spirit,r,rez[@row=(prop,rez_key)]/zut[@row=(loop,r,@zut_key)],@bez): </prop>   
     
      </when>    
                               
      
      
      <ti type="rec" label="(f,tk_sel_translate,(loop,r,@phase),(file,phasen-selektor)):" flag="label_right" prefix="  " >
      
    <ti>(prop,zutatheader)</ti>
     
     <ti type="call_job" prefix="  " job="ephase-see" explain="(f,text,cut_nice,(loop,r,@besch),40)"> 
                 
        <prop id="ephasen_offset">rez[@row=(loop,r,../..,@row)]/komp[@row=(loop,r,..,@row)]/</prop>
        <prop id="ephasen_offset_label"> [ (prop,rez_bez) ] [ (f,text,cut_nice,(loop,r,..,@bez),30) ]</prop>
        <prop id="ephasen_offset_new_key">//</prop>
        <prop id="ephasen_sort_attribute"></prop>
        <prop id="ephasen_sort_number"></prop>
        <prop id="ephasen_sort_ignore_case"/>
        <prop id="ephasen_sort_desc"/>
        <prop id="ephasen_where"/>
        <prop id="ephasen_return_job">ephase-see</prop>  
        <prop id="rez_key" x="(loop,r,../..,@row)"/>  
        <prop id="komp_key" x="(loop,r,..,@row)"/>  
        <prop id="ephase_key" x="(loop,r,@row)"/>   
        <ti label="Phase zu Komponente [(loop,r,..,@bez)]"/>
        
     </ti>

     <!-- <ti>(loop,r,@besch)</ti>   -->
     </ti>
  </loop> 
  
  <spirit id="r" act="close" />
  <ti type="call_job" job="neuer-vorgang" explain="[+ weiteren Vorgang dokumentieren ]" label=" ">
         <prop id="rezeptname">(prop,rezeptname)</prop>
         <prop id="komponentenname">(prop,komponentenname)</prop> 
         <prop id="rez_key">(prop,rez_key)</prop>
         <prop id="komp_key">(loop,i,@row)</prop>  
  </ti>
</try>
<catch>
  <dump_ti label="problem in hook-komp-listed"/>
</catch>
</try_catch>
   
</job>

<job id="do-create-akt-komponentenliste" role="hidden" >
  <need>(prop,rez_key) (file,akt-komponentenliste)</need>
  
  <xslt xml="(file,rezs)" xsl="(dir,app)komponentenliste-rez.xsl"
   out="(file,akt-komponentenliste)">
    <params>rez_key='(f,xslp,(prop,rez_key))'</params>
  </xslt>    
</job>

<job id="do-create-akt-zutatenliste" role="hidden" >
  <need>(prop,rez_key) (file,akt-zutatenliste)</need>
  
  <!-- 
  <xslt xml="(file,rezs)" xsl="(dir,app)zutatenliste-rez.xsl" out="(file,akt-zutatenliste2)">
    <params>rez_key='(f,xslp,(prop,rez_key))' meinmodus='1'</params>
  </xslt>   
  <ti label="generated" type="file" x="(file,akt-zutatenliste2)"/>
  <ti label="generated" type="file" x="(file,akt-zutatenliste)"/> 
  
  -->
  <xslt xml="(file,rezs)" xsl="(dir,app)zutatenliste-rez.xsl" out="(file,akt-zutatenliste)">
    <params>rez_key='(f,xslp,(prop,rez_key))' meinmodus='2'</params>
  </xslt>
      
</job>

<job id="hook-kompzutat-editor-begin" role="hidden">

  <call_job job="do-create-akt-zutatenliste" />
  <call_job job="do-create-akt-komponentenliste" />  
  
</job>

<job id="hook-ephase-editor-begin" role="hidden">
                 
<try_catch>
  <try>
  <xslt xml="(file,rezs)" xsl="(dir,app)zutatenliste-rez-komponente.xsl" out="(file,akt-zutatenliste-komponente)">
    <params>rez_key='(f,xslp,(prop,rez_key))' komp_key='(f,xslp,(prop,komp_key))'</params>
  </xslt>  
  <ti type="file" label="produzierte zutatenliste komp" test="0">(file,akt-zutatenliste-komponente)</ti>
</try>
<catch>
  <dump_ti label="problem in hook-komp-listed"/>
</catch>
</try_catch>  
</job>

<job id="hook-zutat-editor-begin" role="hidden">


  <xslt xml="(file,rezs)" xsl="(dir,app)komponentenliste-rez.xsl"
   out="(file,akt-komponentenliste)">
    <params>rez_key='(f,xslp,(prop,rez_key))'</params>
  </xslt>  

 
  
</job>

<job id="see-the-pics-ALT" role="hidden">
  <need>(file,pics) (prop,pics_xpath)</need>
  <need default="0">(prop,pics_div)</need>
  <prop id="html"></prop>
  <loop missing_strategy="empty" id="pics" xml="(file,pics)" xpath="(prop,pics_xpath)">
    <when test="(loop,pics,exists?,@pic)">
      <file id="mp" flag="cool" x="(loop,pics,@pic)"/>

      <unescape id="mp" type="file"/>

      <translate id="mp" type="file"/>

      
      
      <choose>
        <when test="(prop,pics_div)">
          <prop id="sizer"> style='height: auto; width: auto; </prop>
          <when test="(f,has,(loop,pics,@max_x_px))">
            <prop id="sizer">(prop,sizer) max-width: (loop,pics,@max_x_px)px;</prop>
          </when>
          <when test="(f,has,(loop,pics,@max_y_px))">
            <prop id="sizer">(prop,sizer) max-height: (loop,pics,@max_y_px)px;</prop>
          </when>      
          <prop id="sizer">(prop,sizer)' </prop>    
          <prop id="html">(prop,html)&lt;div style='float: left;' alt='(f,when,(f,has,(loop,pics,@max_y_px)),(loop,pics,@max_y_px),Bild)' &gt;&lt;img src="(f,file,libro,(file,mp))" (prop,sizer)&gt;&lt;/div&gt;</prop>
          <!-- 
          <ti>(loop,pics,@bez)</ti>
          <ti> </ti>               -->
        </when>
        <otherwise>

          
          <ti type="img">(file,mp)</ti>
          <ti>(f,html,b,o)(loop,pics,@bez)(f,html,b,c)</ti>
          <ti>(f,html,b,o)(f,name_of_file,(file,mp))(f,html,b,c)</ti>
          <ti flag="wrap">(file,mp)</ti>
          <ti_hr/>             
        </otherwise>
      </choose>

      
    </when>
  </loop>
  
  <when test="(f,has,prop,html)">
    <ti>derhtml</ti>
    <ti flag="html">&lt;div &gt;(prop,html)&lt;/div &gt;</ti>
  </when>
  
</job> 

</jobs>