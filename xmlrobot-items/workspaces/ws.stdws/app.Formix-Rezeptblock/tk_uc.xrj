<jobs>

<!--

-->
<call_job job="prolog" />

<when test="(f,has,prop,pro)">  

</when>

<!-- gui Adapters: to copy in the app .... -->

<job id="See Values: uc_" role="dev">
  <call_job job="tk_uc_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_uc_clear" explain="Clear this data"/>  
</job>

<job id="Edit: uc_" role="hidden">
  <call_job job="tk_uc_edit"/>
</job>

<job id="Edit: uc_?">
  <call_job job="tk_uc_print_values_tips"/>
  <ti_hr/>
  <ti type="call_job" job="tk_uc_clear" explain="Clear this data"/>
</job>

<!-- 
 <job id="Clear Data: uc_">
  <tk type="msg" x="Sure to clear data of uc_ ?" msg_type="w"/>
  <call_job job="tk_uc_clear"/>
</job>

<job id="Print Values:  uc_">
  <call_job job="tk_uc_print_values"/>
</job>
<job id="Print Help: uc_" role="dev">
  <call_job job="tk_uc_print_help"/>
</job>

-->

<!-- setting the default-values -->
<job id="tk_uc_default" role="hidden">
  <need default="e">(prop,uc_moda)</need>
  <need default="Rezept">(prop,uc_singular)</need>
  <need default="Rezepte">(prop,uc_plural)</need>
  <need default="Aktuelles Rezept">(prop,uc_aktuelles_rezept)</need>
  <need default="1">(prop,uc_zutaten_moda)</need>
</job>


<!-- uc-core, make your changes here -->
<job id="tk_uc_core" role="hidden" tip="uc_: Tk Internal">

  <need default="">(prop,tk_uc_add_flag)</need>

  <tk label="Parameters: uc_" 
      flag="(prop,tk_uc_add_flag)"
      tip="()Search Parameters is a list of values which will control the search-routine.()"> 
      
    
    
    <tk type="msg"
        x="Namix"
        test_first="0"/> 
        
    <tk id="uc_singular" 
        label="Singular"
        x="Rezept"
        test_first="0" />     
        
    <tk id="uc_plural" 
        label="Plural"
        x="Rezepte"
        test_first="0" />  
        
    <tk id="uc_aktuelles_rezept" 
        label="Aktuelles Rezept"
        x="Aktuelles Rezept"
        test_first="0" />       
    <tk type="msg" tip="Les variationes dela presentation" test_first="0">Modas</tk>    
    <tk id="uc_moda"
        type="sel"  
        label="Moda" 
        x="e"
        test_first="0"        
        tip="()Einkomponenten-Modus oder Mehr-komponenten-modus()">
        <sel label="Ein-Komponenten-Modus">e</sel>
        <sel label="Mehr-Komponenten-Modus">m</sel>    
    </tk>          
    <tk id="uc_zutaten_moda"
        type="sel"  
        label="Zutaten Moda" 
        test_first="0"        
        xtip="()text versus regular expression; text will search for exaclty that defined search text, regex will apply the regular-expression syntax to search for a piece of text in the files()">
        <sel label="Keine Zutaten">0</sel>
        <sel label="Mit Zutaten">1</sel>
        <sel label="Zutaten Sekondaer">2</sel>    
    </tk>   
    
    <tk type="msg" tip="Input pour dir and file" test_first="0">Evaluer logiciel</tk>                                  
     
    <tk id="uc_dir1" 
        type="dir" 
        label="Directory1"  
        flag=" x "            
        test_first="0"     
        txp="()A directory which serves as intial directory for the file-search.()"/>
    <tk id="uc_dir2" 
        type="dir" 
        label="Directory1"  
        test_first="0"
        flag=" save write "                 
        txp="()A directory which serves as intial directory for the file-search.()"/>        
      
    <tk id="uc_file1"
        type="file"  
      	label="File to read" 
        flaxg="nono"          
        test_first="0"
        txip="()This file will be read()"/> 
        
    <tk id="uc_file2"
        type="file"  
      	label="File to write" 
        flag="save write" 
        test_first="0"         
        txip="()This file will be read()"/>         
        
    <!--    
    <tk id="uc_file_write"
        type="file"  
      	label="File to write" 
        flag="save force_extension"
        extension=".xml"
        test_first="0"        
        tip="()This file will be written()"/> 

    <tk type="msg"
        x="Text and Bool"
        test_first="0"/>   
        
    <tk id="uc_type"
        type="sel"  
        label="Selection 1" 
        x="text"
        test_first="0"        
        tip="()text versus regular expression; text will search for exaclty that defined search text, regex will apply the regular-expression syntax to search for a piece of text in the files()">
        <sel label="Text">text</sel>
        <sel label="Regular Expression">regex</sel>    
    </tk>            
         
    <tk id="uc_for" 
        label="Text"
        x="text default"
        test_first="0" />
         
    <tk id="uc_textblock"
        type="textblock"
        label="Textblock"               
      	test_first="0"/> 
        
    <tk id="uc_bool"
        type="bool"
        label="Boolean"       
      	test_first="0"
        x="0"/> 
         
    <tk type="msg"
        x="Selections" 
        msg_type="i" 
        test_first="0" 
        tip="()Some Selections() "/>         
            
    <tk id="uc_levels" 
        type="sel" 
        label="()Selection (2)()"
        test_first="0"         
        x="1"         
        tip="the number of directory levels included in the file-search">
        <sel label="One">1</sel>
        <sel label="Two" test="(f,role,expert)">2</sel>
        <sel label="Three" test="(f,role,admin)">3</sel>
        <sel label="Four">4</sel>
        <sel label="Five">5</sel>
        <sel label="Six">6</sel>
        <sel label="Seven">7</sel>
        <sel label="Eight">8</sel>
        <sel label="Nine">9</sel>
        <sel label="Unlimited">999</sel>    
    </tk>

    <tk id="uc_days" 
        type="sel" 
        label="()Days (Sel)()"
        test_first="0"                  
        tip="Days of the week"
        flag="multi" 
        xml="(file,uc-sel2)"/>
        
    <tk 
      id="uc_ext"
      label="Extension" 
      test_first="0"       
      x="extension" 
      flag="nono"
      tip="Tip for Extension"/>

    <tk type="msg" x="Options" msg_type="i"  test_first="0"/>
  
    <tk id="uc_encoding"
        label="Encoding" 
        test_first="0" 
        x="UTF-8" 
        tip="()Encoding defines the way data is stored()"/>
    
    <tk type="msg" 
        x="Reporting Display" 
        msg_type="i"/>
        
    <tk id="uc_len_before"
        label="Len Before" 
        test_first="0" 
        x="20"         
        tip="()does define the lenght before ...()"/>
        
    <tk id="uc_len_after" 
        label="Len After"
        test_first="0" 
        x="60"          
        flag="nono" 
        tip="()does define the lenght after ..()"/>      
        
    <tk type="msg" x="Regular Expressions" msg_type="i" />   
     
    <tk id="uc_xms"
        type="text"
      	label="Minimum Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 512m()"
      	test_first="0"
	      x="512m"
        tip="Tip for minimum heap size"/>

    <tk id="uc_xmx"
        type="text"      	
      	label="Maximal Heap Size"      	
      	regex="()(\d+[g|G|m|M|k|K])()"
      	regex_msg="()A Number and Unit (g,G,m,M,k,K) &#xA;eg 1G or 1024m()"
      	test_first="0"
	      x="1024m"
        tip="Tip for maximal heap size"/>
      -->   
                          
  </tk>   
</job>

<!-- edit data: read, userinput, write -->
<job id="tk_uc_edit" tip="uc_: Edit the Data" role="hidden">

  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,uc-data))">
      <!-- data exists already -->
      <prop id="tk_uc_add_flag" x="sum_only print"/>
      <call_job job="tk_uc_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_uc_add_flag" x="sum print"/>
    </otherwise>
  </choose>
  <call_job job="tk_uc_default"/>
  <!-- doing input -->
  <call_job job="tk_uc_core"/>
  
  <!-- writing data -->
  <call_job job="tk_uc_write"/>

</job>



<job id="tk_uc_print_values" tip="uc_: Prints the entered values" role="hidden">
  
  <call_job job="tk_uc_read"/>
  
  <call_job job="tk_uc_core">
    <prop id="tk_uc_add_flag" x="print_only"/>
  </call_job>
  
</job>

<job id="tk_uc_print_values_tips" tip="uc_: Prints values and tips" role="hidden">
  
  <call_job job="tk_uc_read"/>
  
  <call_job job="tk_uc_core">
    <prop id="tk_uc_add_flag" x="print_only print_with_tips"/>
  </call_job>
  
</job>

<job id="tk_uc_print_help" tip="uc_: Prints only tips for help" role="hidden">
  
  <call_job job="tk_uc_core">
    <prop id="tk_uc_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_job>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_uc_read" role="hidden">
  <call_job job="go-joe-read">
    <file id="joe-in-store" x="(file,uc-data)" />
    <prop id="joe-in-regex" x="(prop,uc-regex)" />
  </call_job>
  <call_job job="tk_uc_default"/>
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_uc_write" role="hidden">
  <call_job job="go-joe-write">
    <file id="joe-in-store" x="(file,uc-data)" />
    <prop id="joe-in-regex" x="(prop,uc-regex)" />
  </call_job>
</job>

<!-- cleares data -->
<job id="tk_uc_clear"  tip="uc_: Clears the data" role="hidden">
  <delete file="(file,uc-data)"/>
</job>


</jobs>