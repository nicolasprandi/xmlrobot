</job><job id="computer-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="computer-editor" />
<prop id="computer_key">1</prop>
<when test="(f,not,(f,exists,prop,computers_offset_new_key))">
<prop id="computers_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,computers)" sort="@row" number="@row" xpath="(prop,computers_offset_new_key)computer">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="computer_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Computer: #(prop,computer_key)</i>
<call_job job="computer-write" />
<ti label="Did add Computer:" x="(f,html,bold,open)(prop,computer_computer)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)">
<call_job job="(prop,computers_return_job)" />
</when>
</job><job role="hidden" id="computer-write">
<need>(prop,computer_key) (prop,isAdd)</need>
<spirit act="open" id="computers_spirit_tc" xml="(file,computers)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,computers_offset),/)">
<prop id="offset2" x="(f,substring,(prop,computers_offset),0,(f,sub,(f,len,(prop,computers_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,computers_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="computers_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;computer row="(prop,computer_key)" /&gt;</inline>
</spirit>
<spirit act="xml_update" how="set_attribute" attribute="dt_add" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row=(f,xpath_string,(prop,computer_key))]" value="(moment)" />
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" attribute="dt_upd" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row=(f,xpath_string,(prop,computer_key))]" value="(moment)" />
<spirit act="xml_update" how="set_attribute" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row='(prop,computer_key)']" attribute="computer" value="(f,vob,prop,computer_computer)" />
<spirit act="xml_update" how="set_attribute" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row='(prop,computer_key)']" attribute="os" value="(f,vob,prop,computer_os)" />
<spirit act="close" flag="save" id="computers_spirit_tc" />
