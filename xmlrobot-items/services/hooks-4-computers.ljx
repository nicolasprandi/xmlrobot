<jobliste>
<!--
Gemacht:
1) in programms-gen.jobs.xml, job "Add Programm"
<file id="computers">(file,computers)</file>
<prop id="computers_offset">(prop,computers_offset)</prop>
<prop id="computers_offset_label">(prop,computers_offset_label)</prop>
<prop id="computers_offset_new_key">(prop,computers_offset_new_key)</prop>
<prop id="computers_sort_attribute">(prop,computers_sort_attribute)</prop>
<prop id="computers_sort_number">(prop,computers_sort_number)</prop>
<prop id="computers_where">(prop,computers_where)</prop>
<prop id="computers_return_job">(prop,computers_return_job)</prop>

-->
<job id="comp_recog_view" role="hidden">
  <interpreter jovial="1"/>
	<ti>hello recog_view</ti>
	<dump flag="ti" />
</job>

<job id="compi_hook_del_computer" role="hidden">
  <interpreter jovial="1"/>  
	<try_catch>
	<try>
  	<!-- remving from takeoff -->
    <copy file="(file,takeoff)" tofile="(dir,filetemp)takeoff-(f,time)-xml-robot-takeoff.xml"/>
    <i>copied (file,takeoff) to (dir,filetemp)takeoff-(f,time)-xml-robot-takeoff.xml</i>
    <xml_update what="(file,takeoff)" how="remove" where="computers/computer[text(e:o)(e:c)=(f,xpath_string,(prop,computer_computer))]" flag="catch"/>
    <i>Deleted computer '(prop,computer_computer)' from takeoff-file</i>
    
    <!-- removing service for computer -->
    <file id="srv-del" x="(dir,services)computer-(prop,computer_computer).ljx" />
    <when test="(f,exists_file,(file,srv-del))">
      <delete file="(file,srv-del)"/>
      <i>Deleted file-service for computer '(prop,computer_computer)'</i>
    </when>
                    
    <!-- <tk type="msg" msg="Continue with updating System?" /> -->
    <call_service job="compi_hook_upd_recognizers" />
   </try>
   <catch>
    <dump flag="ti" label="We have a problem!"/>
   </catch>
   </try_catch>	
</job>

<job id="compi_hook_new_computer_added" role="hidden">
  <interpreter jovial="1"/>
  <dump flag="ti" label="compi_hook_new_computer_added"/>
  

  <tk type="bool" id="do_recog" x="1" label="Define a Recoginition-File for this Computer now?"/>

  <when test="(prop,do_recog)">
    <file id="recognitions">(dir,services)computers.xml</file>
    <prop id="recognitions_offset">computer[@row=(prop,computer_key)]/</prop>
    <prop id="recognitions_offset_label"> [(prop,computer_computer)]</prop>
    <prop id="recognitions_offset_new_key">//</prop>
    <prop id="recognitions_sort_attribute" />
    <prop id="recognitions_sort_number" />
    <prop id="recognitions_sort_ignore_case" />
    <prop id="recognitions_sort_desc" />
    <prop id="recognitions_where" />
    <prop id="recognitions_return_job">XXX</prop>
  
    <prop id="do_return_job_asldfkjjwiojfasffdh">(prop,do_return_job)</prop>
    <prop id="do_return_job">0</prop>
    
    <call_service job="Add another Recognition File" />  
    <prop id="do_return_job">(prop,do_return_job_asldfkjjwiojfasffdh)</prop>
    <remove id="do_return_job_asldfkjjwiojfasffdh" type="prop"/>
    
  </when>  
  
  <tk type="bool" id="do_takeoff" x="1" label="Add the new Computer to the current take-off-file ?"/>

  <when test="(prop,do_takeoff)">
    <call_service job="comp_add_computer_takeoff" />
  </when>    
</job>

<job id="something_hook" role="hidden">
  <interpreter jovial="1"/>
  <dump flag="txi" label="Something Hook"/>
</job>

<job id="Conf: Computers" joblevel="ws" role="hidden">
  <interpreter jovial="1"/>
  <include file="(dir,services)computers-prolog.lsx" />
  <call_service job="View Computers"/>
</job>

<job id="compi_recognition_act_test" joblevel="ws" role="hidden">
  <interpreter jovial="1"/>
  <call_service job="To Memory Recognition File" />
  <!-- <dump flag="ti" label="compi_recognition_act_check_exist"/> -->
  <ti label="Test: Checking if Recognition-File exists ...">
    <ti label="File to test:" type="file">(file,recognition_file)</ti>
  </ti>
  <ti label="Test Result:"/>
  <choose>
    <when test="(f,file_exists,(file,recognition_file))">
      <ti label="Good News:">File was found on current computer</ti>
    </when>
    <otherwise>
      <ti label="Bad News:">(f,html,bold,open)File found NOT on current computer(f,html,bold,close)</ti>
    </otherwise>
  </choose>
  
      
</job>


<job id="Adapter" role="hidden" joblevel="ws">
  <interpreter jovial="1"/>
  <file id="computers">(dir,services)computers.xml</file>
  <try_catch>
    <try>  
      <prop id="computer_key">(f,xpath,(file,computers),computer[@computer=(f,xpath_string,(prop,computer))],@row)</prop>
      
      <file id="computers">(dir,services)computers.xml</file>
      <prop id="computers_offset">./</prop>
      <prop id="computers_offset_label"></prop>
      <prop id="computers_offset_new_key">//</prop>
      <prop id="computers_sort_attribute"/>
      <prop id="computers_sort_number"/>
      <prop id="computers_sort_ignore_case"/>
      <prop id="computers_sort_desc"/>
      <prop id="computers_where"/>
      <prop id="computers_return_job">Adapter</prop>        
      <call_service job="See Computer"/>
    </try>
    <catch>
      <ti label="Info">
        <ti>This computer is not known!</ti>
      </ti>
    </catch>
  </try_catch>
  <ti_break/>
  <ti label="Action">
  <ti laxbel="_" type="call_service" job="All Adapters" explain="See all Computer Adapters" />
  </ti>

  
</job>

<job id="hook_programm_act_see2" joblevel="ws" role="hidden">
  <interpreter jovial="1"/>
  <try_catch><try>
<need>(prop,computer_key)</need>
<call_service job="To Memory Computer" />
<prop id="isAdd">0</prop>
<call_service job="Computer Editor" />
  </try>
  <catch/>
  </try_catch>
</job>
<job id="hook_programm_act_test" joblevel="ws" role="hidden">
  <interpreter jovial="1"/>
  <file id="mx">(dir,filetemp)hook-memo.xml</file>
  <when test="(f,not,(f,file_exists,(file,mx)))">
    <create_file out="(file,mx)">&lt;memo/&gt;</create_file>
  </when>
  
    <call_service job="To Memory Programm"/>
    <call_service job="To Memory Computer"/>
    <dump msg="Begin HOOK_PROGRAMM_ACT_RUN after LOOAD" />
      
  <when test="(f,eq,(prop,greetings_from),view)">

  </when>

  <when test="(f,not,(f,eq,(prop,os),(prop,computer_os)))">
    <tk type="msg" msg="Computers do not fit: (prop,os)(e:s) (prop,computer_os)"/>
  </when>
  
  <prop id="how">(f,xpathx,1,(file,mx),.,@how)</prop>
  <tk type="sel" id="how" label="How do you want to test this programm?" flag="nono"
      tip="By 'testing' the programm will be called.">
    <sel label="With a DIRECTORY as parameter">fd</sel>   
    <sel label="With a FILE as parameter">fp</sel>
    <sel label="Without parameter">alone</sel>
  </tk>
  <xml_update what="(file,mx)" where="." how="set_attribute" 
    attribute="how" value="(prop,how)" />  
  
  <when test="(f,eq,(prop,how),alone)">
      <i>Testing on it's own</i>
      <choose>
        <when test="(f,eq,(prop,os),mac)">
          <dump label="For Mac" />
          <exe>
        	  <arg>open</arg>
        	  <arg>-a</arg>
        	  <arg>(prop,programm_pgm_app)</arg>
        </exe></when>
        <when test="(f,eq,(prop,os),win)">
	       <exe>
      	    <arg>(file,programm_pgm_file)</arg>
          </exe>
        </when>  
        <when test="(f,eq,(prop,os),linux)">
	  <exe>
      	    <arg>(prop,programm_pgm_app)</arg>
          </exe>
        </when>  
      </choose>
      

  </when>
  
  <when test="(f,eq,(prop,how),fp)">
      <i>Running with a file as parameter</i>
      
      <file id="parameter_file">(f,xpathx,(dir,workspace),(file,mx),.,@parameter_file)</file>
      <tk type="file" id="parameter_file" label="Select a file as parameter"/>
      <xml_update what="(file,mx)" where="." how="set_attribute" 
        attribute="parameter_file" value="(file,parameter_file)" />  
      
      <choose>
        <when test="(f,eq,(prop,os),mac)"><exe>
        	  <arg>open</arg>
        	  <arg>-a</arg>
        	  <arg>(prop,programm_pgm_app)</arg>
      	   <arg>(file,parameter_file)</arg>        	  
        </exe></when>
        <when test="(f,eq,(prop,os),win)"><exe>
      	  <arg>(file,programm_pgm_file)</arg>
      	  <arg>(file,parameter_file)</arg>
        </exe></when>  
        <when test="(f,eq,(prop,os),linux)">
	  <exe>
      	    <arg>(prop,programm_pgm_app)</arg>
	    <arg>(file,parameter_file)</arg>
          </exe>
        </when>  
      </choose>

  </when>  
  
  <when test="(f,eq,(prop,how),fd)">
      <i>testing with a dir as parameter</i>
      
      <dir id="parameter_dir">(f,xpathx,?,(file,mx),.,@parameter_dir)</dir>
       <tk type="dir" id="parameter_dir"/>
      <xml_update what="(file,mx)" where="." how="set_attribute" 
        attribute="parameter_dir" value="(dir,parameter_dir)" />  

      

      <choose>
        <when test="(f,eq,(prop,os),mac)"><exe>
        	  <arg>open</arg>
        	  <arg>-a</arg>
        	  <arg>(file,programm_pgm_app)</arg>
      	   <arg>(dir,parameter_dir)</arg>        	  
        </exe></when>
        <when test="(f,eq,(prop,os),win)"><exe>
      	  <arg>(file,programm_pgm_file)</arg>
      	  <arg>(dir,parameter_dir)</arg>
        </exe></when>  
        <when test="(f,eq,(prop,os),linux)"><exe>
      	  <arg>(prop,programm_pgm_app)</arg>
      	  <arg>(dir,parameter_dir)</arg>
        </exe></when> 
      </choose>

  </when>   
      
</job>
