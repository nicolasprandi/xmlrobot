<ti type="rec" label="(f,html,bold,open)(f,substring,(f,name_of_file,(file,hasi)),0,16)(f,when,(f,gt,(f,len,(f,name_of_file,(file,hasi))),16),...,)(f,html,bold,close)">
  -->
  
  <ti_hr/>
  <!-- <ti_break/> -->
  
  
  
  <call_service job="comp_check_computer_takeoff" />  
