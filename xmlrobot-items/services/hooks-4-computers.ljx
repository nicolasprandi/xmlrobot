</job>

<job id="compi_hook_view_computer_end" role="hidden">
  <interpreter jovial="1"/>
  <ti_hr/>
  <ti label="Actions:">
  <ti type="call_service" job="compi_hook_upd_recognizers" 
      explain="Update all computer-recognizers on system" >
  </ti>
  </ti>
  
</job>
<job id="comp_sync_computer" role="hidden">
  <interpreter jovial="1"/>
  <!-- <call_service job="To Memory Computer"/> -->
  <!-- <dump label="with love from comp_sync_computer" flag="ti"/> -->
  
  <ti>doing button for Computer-Programm-update</ti>
  <file id="compi_programms">(dir,filetemp)compi-programms.jobs.xml</file>
  <file id="computers">(dir,services)computers.xml</file>
  <xslt 
    xml="(file,computers)" 
    xsl="(dir,services)compi-programms-jobs.xsl" 
    out="(file,compi_programms)" >
    <params>computer='(f,xslp,(prop,computer_computer))' os='(f,xslp,(f,xpath,(file,computers),computer[@computer=(f,xpath_string,(prop,computer_computer))],@os))'</params>
  </xslt>
  <ti type="file">(file,compi_programms)</ti>


    <copy file="(file,compi_programms)" tofile="(dir,services)computer-(prop,computer_computer).ljx"/>

  
<create_file out="(dir,filetemp)written.lsx" flag="dont_unescape_on_write"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<steps>

<ti type="ul" x="Computerspecific programms for &apos;(x,(prop,computer_computer))&apos; are now available"/>
<ti label="Did Create:" type="file" test="(f,role,admin)">(x,(dir,services)computer-(prop,computer_computer).ljx)</ti>
<ti_break/>
<ti_hr/>
<call_service job="Conf: Computers"/> 
</steps>]]></create_file>

<call_service job="restarter">
 <file id="with-lsx" x="(dir,filetemp)written.lsx" />
</call_service>

  <choose>
    <when test="(f,not,(f,exists,prop,comp_sync_no_restart))">
      <!-- <tk type="msg" msg="Going to Restart 1 ..."/>  -->
      <restart/>    
    </when>
    <when test="(f,eq,(prop,comp_sync_no_restart),0)">
      <!-- <tk type="msg" msg="Going to Restart 2..."/> -->
      <restart/>    
    </when>  
  </choose>
    
</job>


<job id="ccar" role="hidden">
  <interpreter jovial="1"/>
<create_file out="(dir,filetemp)do.lsx"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<steps>
<call_service job="Conf: Computers"/> 
</steps>]]></create_file>

<call_service job="restarter">
 <file id="with-lsx" x="(dir,filetemp)do.lsx" />
</call_service>
</job>

<job id="compi_hook_upd_recognizers" role="hidden">
  <interpreter jovial="1"/>
  <need default="0">(prop,deselect-computer)</need>
  <ti>doing button for Recognition files</ti>
  <file id="compi_reco">(dir,filetemp)compi-recog.jobs.xml</file>
  <file id="computers">(dir,services)computers.xml</file>

    <copy file="(file,takeoff)" tofile="(dir,filetemp)compi-takeoff.xml" />

  <xslt 
    xml="(file,computers)" 
    xsl="(dir,services)compi-verification-jobs.xsl" 
    out="(file,compi_reco)"
    home="(dir,filetemp)" >
  </xslt>
  <ti type="file">(file,compi_reco)</ti>
  

    <copy file="(file,compi_reco)" tofile="(dir,services)check-computers-onstart.ljx"/>

  
  <call_service job="ccar"/>
  
  <choose>
    <when test="(prop,deselect-computer)">
      <restart computer=""/>
    </when>
    <otherwise>
      <restart/>
    </otherwise>
  </choose>
  
  
</job>
<job id="compi_hook_editor_programm_end" role="hidden">
  <interpreter jovial="1"/>
  <dump label="compi_hook_editor_programm_end"/>
  <when test="(f,not,(f,file_exists,(file,programm_pgm_file)))">
    <file id="programm_pgm_file"></file>
  </when>
</job>

