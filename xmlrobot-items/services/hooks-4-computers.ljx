<job id="comp_check_computer_takeoff" role="hidden">
  <interpreter jovial="1"/>
  
  <!-- 
  <ti label="Checking:" type="text">(prop,computer_computer)</ti>  
  <ti label="in:" type="file">(file,takeoff)</ti>
-->

  <try_catch>
    <try>
      <prop id="ist">(f,xpath,(file,takeoff),computers/computer[text(e:o)(e:c)=(f,xpath_string,(prop,computer_computer))])</prop>
      
      <ti label="(e:o)a(e:c) Publish">
        <ti label="Programms:" type="call_service" job="comp_sync_computer" explain="Publish programms of '(prop,computer_computer)'">
          <prop id="computer_computer">(prop,computer_computer)</prop>
        </ti>     
	      <ti label="Recognizers:" type="call_service" job="compi_hook_upd_recognizers" 
		explain="Publish recognizers of all computers" />
      </ti>
      
      <ti_space height="4px" />
      
      <prop id="computer-flag-tablet">(f,contains,(f,xpathx,,(file,takeoff),computers/computer[text(e:o)(e:c)=(f,xpath_string,(prop,computer_computer))],@flag),tablet)</prop>
      
      <ti label="(e:o)b(e:c) Check Takeoff-File for Computer">
	
        <ti label="OK">'(prop,computer_computer)' is in Takeoff-File</ti>
        
        <ti label=" " type="call_service" job="comp_remove_computer_takeoff" explain="Remove '(prop,computer_computer)' from Takeoff-File">
          <prop id="computer_computer">(prop,computer_computer)</prop>
        </ti>
        
        <ti label=" " type="call_service" 
            job="comp_maketablet_computer_takeoff" explain="Define '(prop,computer_computer)' as Tablet"
            test="(f,not,(prop,computer-flag-tablet))">
          <prop id="computer_computer">(prop,computer_computer)</prop>
        </ti>      
        
        <ti label=" " type="call_service" 
            job="comp_unmaketablet_computer_takeoff" explain="Define '(prop,computer_computer)' as s normal Desktop-Computer and NOT as a Tablet"
            test="(prop,computer-flag-tablet)">
          <prop id="computer_computer">(prop,computer_computer)</prop>
        </ti>               
         
      </ti>
      
      
      <ti type="file" label="Takeoff-File:" test="(f,role,admin)">(file,takeoff)</ti>
    
      
      
    </try>
    <catch>
	     
      <ti label="()(a) Check Takeoff-File for Computer:()">
      	<ti label="(f,html,bold,open)- - - F a i l u r e - - -(f,html,bold,close)">'(prop,computer_computer)' is NOT in Takeoff-File</ti>
      	<ti label=" " type="call_service" job="comp_add_computer_takeoff" explain="Add '(prop,computer_computer)' to Takeoff-File">
      	  <prop id="computer_computer">(prop,computer_computer)</prop>
      	</ti>
      </ti>
      <!-- 
      <ti_break/>
      <ti_hr/>
      <dump flag="ti" /> -->
      
    </catch>
  </try_catch>

  
  <call_service job="comp_act_home"/>
   
</job>

<job id="comp_act_home" role="hidden">
  <interpreter jovial="1"/>
  <ti_space heigth="5px"/>
  <ti_hr/>
  <ti_space heigth="3px"/>
  <ti type="call_service" job="Conf: Computers" explain="See all Computers"/>

</job>




<job id="computer_act_export" role="hidden">
  <interpreter jovial="1"/>
  <call_service job="To Memory Computer"/>
  <dump label="with love from computer act export"/>
</job>

<job id="comp_add_computer_takeoff" role="hidden">
  <interpreter jovial="1"/>

    <copy file="(file,takeoff)" 
          tofile="(dir,filetemp)takeoff-(f,time).ltx" />

  <i>copied (file,takeoff) to (dir,filetemp)takeoff-(f,time).ltx</i>
  
  <when test="(f,eq,0,(f,xsl,(file,takeoff),count(e:o)takeoff/computers(e:c)))">
  	<warn>computers will be defined in takeoff</warn>
  	<xml_update what="(file,takeoff)" how="append" >
        <inline attribute="with">&lt;computers/&gt;</inline>
    </xml_update>		
  </when>

  <xml_update what="(file,takeoff)" how="insert_in" where="computers">
      <inline attribute="with">&lt;computer&gt;(x,(prop,computer_computer))&lt;/computer&gt;</inline>
  </xml_update>
  <prop id="comp_sync_no_restart">1</prop>
  <call_service job="comp_sync_computer" />
  <call_service job="compi_hook_upd_recognizers" />
</job>

<job id="comp_maketablet_computer_takeoff" role="hidden">
  <interpreter jovial="1"/>
  <need>(prop,computer_computer)</need>

  <prop id="computer-flag">(f,xpathx,,(file,takeoff),computers/computer[text(e:o)(e:c)=(f,xpath_string,(prop,computer_computer))],@flag) tablet</prop>
        
  <xml_update 
    what="(file,takeoff)" 
    how="set_attribute" 
    where="computers/computer[text(e:o)(e:c)=(f,xpath_string,(prop,computer_computer))]"
    attribute="flag"
    value="(prop,computer-flag)"
    >
  </xml_update>
                  
  <call_service job="Restart" />
  
</job>

<job id="comp_unmaketablet_computer_takeoff" role="hidden">
  <interpreter jovial="1"/>
  <need>(prop,computer_computer)</need>

  <prop id="computer-flag">(f,xpathx,,(file,takeoff),computers/computer[text(e:o)(e:c)=(f,xpath_string,(prop,computer_computer))],@flag)</prop>
  
  <prop id="startpos">(f,index_of,(prop,computer-flag),tablet)</prop>

  <prop id="computer-flag2">(f,substring,(prop,computer-flag),0,(prop,startpos))(f,substring,(prop,computer-flag),(f,add,(prop,startpos),6))</prop>
          
  <xml_update 
    what="(file,takeoff)" 
    how="set_attribute" 
    where="computers/computer[text(e:o)(e:c)=(f,xpath_string,(prop,computer_computer))]"
    attribute="flag"
    value="(prop,computer-flag2)"
    >
  </xml_update>
                  
  <call_service job="Restart" />
  
</job>

<job id="comp_remove_computer_takeoff" role="hidden">
  <interpreter jovial="1"/>
     
  <tk label="Remove computer ?"
      type="accept"
      id="delete-this-1"
      x="Sure about removing computer '(prop,computer_computer)' from takeoff-file ?"
      label_accept="Remove"
      label_decline="Forget it"
      width="300" height="100">
      <q id="delete-this-2" label="()Yes, do remove the computer()"/>
  </tk>
  <when test="(f,not,(f,and,(prop,delete-this-1),(prop,delete-this-2)))">
      <throw>Remove of computer terminated on request.</throw>
  </when>

    <copy file="(file,takeoff)" 
          tofile="(dir,filetemp)takeoff-(f,time).xrt.xml"/>

  
  <i>copied (file,takeoff) to (dir,filetemp)takeoff-(f,time).xrt.xml</i>
  
  <xml_update 
    what="(file,takeoff)" 
    how="remove" 
    where="computers/computer[text(e:o)(e:c)=(f,xpath_string,(prop,computer_computer))]"/>
  
  <file id="maybe-programms"
        x="(dir,services)computer-(prop,computer_computer).ljx" />
  <when test="(f,exists_file,(file,maybe-programms))">
    <tk type="msg" x="removing (file,maybe-programms)" test="0"/>
    <delete file="(file,maybe-programms)"/>
  </when>
  
  <when test="(f,has,prop,computer)">
  <when test="(f,eq_text,(prop,computer),(prop,computer_computer))">
    <prop id="deselect-computer" x="1"/>
  </when>  
  </when>               
  <call_service job="compi_hook_upd_recognizers" />

</job>

