  <prop id="programms_sort_attribute">@sort</prop>
  <prop id="programms_sort_number">@sort</prop>
  <prop id="programms_sort_ignore_case"></prop>
  <prop id="programms_desc" />
  <prop id="programms_where" />
  <prop id="programms_return_job">See Computer</prop>
  
  <ti_hr/>
  
  <ti label="(e:o)1(e:c) Programms"/>
  <call_service job="View Programms" />

  <file id="recognitions">(dir,services)computers.xml</file>
  <prop id="recognitions_offset">computer[@row=(prop,computer_key)]/</prop>
  <prop id="recognitions_offset_label"></prop>
  <prop id="recognitions_offset_new_key">//</prop>
  <prop id="recognitions_sort_attribute" />
  <prop id="recognitions_sort_number" />
  <prop id="recognitions_sort_ignore_case" />  
  <prop id="recognitions_desc" />
  <prop id="recognitions_where" />
  <prop id="recognitions_return_job">See Computer</prop>
  <!--  -->
  <ti_hr styxle="2"/>
  <!-- <ti_hr/><ti_break/> -->
  <ti label="(e:o)2(e:c) Recognition Files"/>
  <call_service job="View Recognition Files" />
  <!-- dort das so machen, das war mal 
<file id="hasi">(f,exxxxxxport,(loop,i,@file))</file>
