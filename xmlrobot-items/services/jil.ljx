<jobs>
  <prop id="debug-jack">1</prop>
  
  <job id="sys_jil_adapter_file" role="hidden">
    <when test="(f,has,file,with-jil)">
      <dir id="with-jil">(f,dir_of_file,(file,with-jil))</dir>
      <prop id="init-filename" x="(f,name_of_file,(file,with-jil))"/>
    </when>
    
    <call_service job="go-jil-run"/>
    <global act="get" id="jil-result"/>
    <tk type="msg" x="jil-result: (prop,jil-result)" test="0"/>
    
    <prop id="save-flag" x="(f,has_flag,(prop,with-flag-jil),save)"/>
    
    <choose>
      <when test="(f,and,(f,not,(f,has,prop,with-extension-jil)),(f,not,(f,has,prop,init-filename)))">
        <!-- no extension and no initial-filname-->
        <tk type="file" 
          id="f" 
          base="(prop,jil-result)" 
          label="File of Pre-Selection" 
          flag="(prop,with-flag-jil) no_preselection"/>
      </when>
      <when test="(f,and,(f,not,(f,has,prop,with-extension-jil)),(f,has,prop,init-filename))">
        <!-- no extension and initial-filname-->
        <file id="maybe" x="(prop,jil-result)(prop,init-filename)"/>
        <prop id="maybe-exists" x="(f,exists_file,(file,maybe))"/>
        
        <choose>
          <when test="(f,or,(prop,maybe-exists),(prop,save-flag))">
            <tk type="file" 
              id="f" 
              x="(file,maybe)" 
              label="File of Pre-Selection" 
              flag="(prop,with-flag-jil) no_preselection"/>            
          </when> 
          <otherwise>
            <tk type="file" 
              id="f" 
              base="(prop,jil-result)" 
              label="File of Pre-Selection" 
              flag="(prop,with-flag-jil) no_preselection"/>          
          </otherwise>                              
        </choose>
        
      </when>      

      <when test="(f,and,(f,has,prop,with-extension-jil),(f,not,(f,has,prop,init-filename)))">
        <!-- extension and no initial-filname-->
        <tk type="file" 
          id="f" 
          base="(prop,jil-result)" 
          label="File of Pre-Selection" 
          flag="(prop,with-flag-jil) no_preselection"
          extension="(prop,with-extension-jil)"/>
      </when>
      
      <when test="(f,and,(f,has,prop,with-extension-jil),(f,has,prop,init-filename))">
        <!-- extension and initial-filname-->
        
        <file id="maybe" x="(prop,jil-result)(prop,init-filename)"/>
        <prop id="maybe-exists" x="(f,exists_file,(file,maybe))"/>
        
        <choose>
          <when test="(f,or,(prop,maybe-exists),(prop,save-flag))">
            <tk type="file" 
              id="f" 
              x="(file,maybe)" 
              label="File of Pre-Selection" 
              flag="(prop,with-flag-jil) no_preselection"
              extension="(prop,with-extension-jil)"/>            
          </when> 
          <otherwise>
            <tk type="file" 
              id="f" 
              base="(prop,jil-result)" 
              label="File of Pre-Selection" 
              flag="(prop,with-flag-jil) no_preselection"
              extension="(prop,with-extension-jil)"/>          
          </otherwise>                              
        </choose>

      </when>      
          
    </choose>
    <global act="set" id="jil-result" x="(file,f)"/>

    <i>Preselected: (file,f)</i>
  </job>  
  
  <job id="sys_jil_adapter_dir" role="hidden">
    <call_service job="go-jil-run"/>
    <!-- 
    <global act="get" id="jil-result"/>
    <i>Preselected: (prop,jil-result)</i>            -->
  </job>   
  
  <job id="Select Directory" role="hidden" joblevel="ws"> 
    <call_service job="tr_seldir"/>
    <call_service job="go-joe-read">
      <file id="joe-in-store">(f,request,dir,sys_cache)last-pano-ic.lsx</file>
      <prop id="joe-in-regex">dir_to_see</prop>          
    </call_service>
    <when test="(f,has,dir,dir_to_see)">
      <!-- <ti type="dir" label="Last Dir:" x="(dir,dir_to_see)" />
      <ti_flush/>                                                   -->
    </when>
    <call_service job="go-jil-run" flag="silent"/>
    <tk id="dir_to_see" label="(prop,_seldir_confchange)" type="dir"/>
    
    <!-- <ti tyxpe="dir" label="Selected:">(dir,dir_to_see)</ti> 
    <ti_hr/>             -->
    <ti_break/>
    <ti_flush/>
    
    <call_service job="go-joe-write-srv">
      <prop id="joe-in-regex">dir_to_see</prop>  
      <file id="joe-in-store">(f,request,dir,sys_cache)last-pano-ic.lsx</file>  
    </call_service>

      <dir id="with">(dir,dir_to_see)</dir>
      <call_service job="Goto-Panorama"/>
    
  </job>
  
  <!--
    <job id="Select Directory" role="dev" joblevel="ws">
    
    <call_service job="go-jil-run" flag="silent"/>
    <tk id="dir_to_see" label="Confirm or Change" type="dir"/>
    <ti type="dir" label="Selected:">(dir,dir_to_see)</ti>
    <ti tyxpe="dir" label=" ">(dir,dir_to_see)</ti>
    <ti_flush/>
    
    <file id="joe-in-store">(dir,status)seldir77-ic.xml</file>  
    <call_service job="go-joe-read"/>
        
    <tk type="bool" id="cont_panorama" label="Continue with Panorama?" flag="nono"/>

    <prop id="joe-in-regex">cont_panorama</prop>  
    <call_service job="go-joe-write-srv"/>
        
    <when test="1" txest="(prop,cont_panorama)">
      <ti_hr/>
      <dir id="with">(dir,dir_to_see)</dir>
      <call_service job="Goto-Panorama"/>
    </when>
    
  </job>
  -->
  
  <!-- selects just an application -->
  <job id="go-jil-run-app" role="hidden" joblevel="ws">
    <call_service job="jil-add-app-dir"/>
    <need>(dir,dir_to_see) (prop,app_ref)</need>
    <global act="set" id="jil-result" x="(dir,dir_to_see)"/>
    <global act="set" id="jil-result-app" x="(prop,app_ref)"/> 
  </job>
  
  <job id="go-jil-run" role="hidden" joblevel="ws">
 
    <call_service job="tr_seldir"/>
    <need default="">(dir,senders_dir)</need>
    <need default="">(prop,senders_label)</need>
    <need default="(prop,_seldir_vorauswahl)">(prop,instead_preselection)</need>
    
    <file id="joe-in-store">(f,request,dir,sys_cache)jil-ic.xml</file>
    <prop id="joe-in-regex">input1|app_ref|pro_ref</prop>
    <ti type="file" label="mystore" x="(file,joe-in-store)" test="0"/>  
    <call_service job="go-joe-read"/>
    
    <need default="(prop,_seldir_dirtype)">(prop,jil-question)</need>
    <try_catch>
      <try>
        <dir id="user_doc">(f,info,documents_dir)</dir>
      </try>
      <catch/>
    </try_catch>    

    <prop id="second-pro" x="1"/>
    <when test="(f,and,(f,has,dir,senders_dir),(f,has,dir,pro))">
      <when test="(f,eq_text,(dir,senders_dir),(dir,pro))">
        <prop id="second-pro" x="0"/>
      </when>    
    </when>
    <choose>
      <when test="(f,guicontroller,general,is-web,)">
      
        <prop id="offer-master-project" x="1"/>
        <when test="(f,and,(f,has,(f,request,dir,master_project)),(f,has,dir,senders_dir))">
          <when test="(f,eq_text,(f,request,dir,master_project),(dir,senders_dir))">
               <prop id="offer-master-project" x="0"/>
          </when>        
        </when>
        
        <prop id="offer-this-project" x="1"/>
        <choose>
          <when test="(f,and,(prop,second-pro),(prop,offer-master-project),(f,eq_text,(f,request,dir,master_project),(dir,pro)))">
            <prop id="offer-this-project" x="0"/>
          </when>
          <when test="(f,has,dir,senders_dir)">
           <when test="(f,eq_text,(dir,senders_dir),(dir,pro))">
            <prop id="offer-this-project" x="0"/>
          </when>         
          </when>
        </choose>
        <!-- <ti test="(f,has,prop,input1)">input1= (prop,input1)</ti> -->
        <when test="(f,not,(f,has,prop,input1))">
          <when test="(prop,offer-master-project)">
            <prop id="input1">master-pro</prop>
          </when>
        </when>
        <tk label="(prop,instead_preselection)">    
          <tk label="(prop,jil-question)" type="sel" id="input1" x="this-pro" flag="nono" tip="(prop,_seldir_typentip)">
            <sel label="(f,vob,prop,senders_label)"
                 test="(f,has,dir,senders_dir)">sender</sel>  
                                    
            <sel label="(prop,_seldir_your) (f,request,prop,master_project_app)-(prop,_seldir_project)"
                 test="(prop,offer-master-project)">master-pro</sel> 
                                   
           
            <!-- 
            <sel label="(prop,_seldir_userdocs)" test="(f,and,(f,role,admin),(f,exists,dir,user_doc))">userdocs</sel> 
            <sel label="(prop,_seldir_userhome)" test="(f,role,admin)">userhome</sel> 
            -->
            
            
  
            <sel label="(prop,_seldir_dblink)" test="(f,has,(f,request,dir,databaselink))">databaselink</sel>      
            <sel label="(prop,_seldir_libro)">libro</sel> 
            <sel label="(prop,_seldir_libro2)">libro2</sel>
                
       
             
      
            <sel label="(prop,_seldir_app) - (f,vob,prop,app)"
                 test="(f,has,prop,app)">this-app</sel>
            <sel label="(prop,_seldir_sessdisk)">session_home_fs</sel>     
            <sel label="(prop,_seldir_sessmem)">session_home_mem</sel> 
            <sel label="System">system</sel>
            <!--      
            <sel label="(prop,_seldir_app) - ...">app</sel> 
            <sel label="(prop,_seldir_allapps)" 
                 test="(f,role,admin)">serviceApps</sel>             
                        
            <sel label="(prop,_seldir_takeoff)" test="0">takeoff</sel>
            <sel label="(prop,_seldir_services)">services</sel>
            -->
            
            <sel label="(prop,_seldir_serving) (prop,app)-(prop,_seldir_project)"
                 test="(prop,offer-this-project)" xtest="(prop,second-pro)">this-pro</sel> 
            <!--                              
            <sel label="(prop,_seldir_javahome)" test="(f,role,admin)">loxo_home</sel>
            -->
            <sel label="(prop,_seldir_manual)">hand</sel>
          </tk> 
        </tk>       
      
      </when>
      <otherwise>
        <tk label="(prop,_seldir_vorauswahl)">    
          <tk label="(prop,jil-question)" type="sel" id="input1" x="userdocs" flag="nono" tip="(prop,_seldir_typentip)">
            <sel label="(f,vob,prop,senders_label)"
                 test="(f,has,dir,senders_dir)">sender</sel>  
                 
            <sel label="(prop,_seldir_userdocs)" test="(f,exists,dir,user_doc)">userdocs</sel> 
            <sel label="(prop,_seldir_userhome)">userhome</sel> 
            
            <sel label="(prop,_seldir_sessdisk)">session_home_fs</sel>
            <sel label="(prop,_seldir_sessmem)">session_home_mem</sel>   
            <sel label="(prop,_seldir_dblink)" test="(f,has,(f,request,dir,databaselink))">databaselink</sel>      
            <sel label="(prop,_seldir_libro)" >libro</sel> 
            <sel label="(prop,_seldir_libro2)" >libro2</sel> 
                
            <sel label="(prop,_seldir_project) - (f,upper,(f,vob,prop,pro))"
                 test="(f,has,prop,pro)">this-pro</sel>         
            <sel label="(prop,_seldir_project) - ...">pro</sel>             
      
            <sel label="(prop,_seldir_app) - (f,upper,(f,vob,prop,app))"
                 test="(f,has,prop,app)">this-app</sel>
            <sel label="(prop,_seldir_app) - ...">app</sel> 
            
            <sel label="Workspace - (f,upper,(prop,workspace))">workspace</sel>
            
            <sel label="(prop,_seldir_takeoff)">takeoff</sel>
            <sel label="(prop,_seldir_services)">services</sel>
            <sel label="Service Apps" 
                 test="(f,role,admin)">serviceApps</sel> 
                                         
            <sel label="System">system</sel>   
                    
            <sel label="Archive - Backups">backup</sel>
            <sel label="Archive - Museum">museum</sel>
            <sel label="(prop,_seldir_javahome)" test="(f,role,expert)">loxo_home</sel>
            
            
            
            <sel label="mpe1 = (f,request,dir,mpe1)" test="(f,has,(f,request,dir,mpe1))">mpe1</sel>
            <sel label="mpe2 = (f,request,dir,mpe2)" test="(f,has,(f,request,dir,mpe2))">mpe2</sel>
            <sel label="mpe3 = (f,request,dir,mpe3)" test="(f,has,(f,request,dir,mpe3))">mpe3</sel>
            <sel label="mpr  = (f,request,dir,mpr)" test="(f,has,(f,request,dir,mpr))">mpr</sel>
            <sel label="(prop,_seldir_manual)">hand</sel>
          </tk> 
        </tk>       
      </otherwise>
    
    </choose>
    

  
    <choose>
      <when test="(f,eq,(prop,input1),)">
        <throw>(prop,_seldir_cancelled)</throw>
      </when>     
      <when test="(f,eq,(prop,input1),master-pro)">
        <dir id="dir_to_see">(f,request,dir,master_project)</dir>
      </when> 
      <when test="(f,eq,(prop,input1),sender)">
        <dir id="dir_to_see">(dir,senders_dir)</dir>
      </when>       
      <when test="(f,eq,(prop,input1),app)">
        <call_service job="jil-add-pro-dir"/>
      </when>
      <when test="(f,eq,(prop,input1),pro)">
        <prop id="app_label">(prop,_seldir_doselapppro)</prop>
        <prop id="app_tip">(prop,_seldir_doselapppro_tip)</prop>
        <call_service job="jil-add-pro-dir"/>
      </when>   
      <when test="(f,eq,(prop,input1),databaselink)">
        <dir id="dir_to_see">(f,request,dir,databaselink)</dir>
      </when>        
      <when test="(f,eq,(prop,input1),libro)">
        <dir id="dir_to_see">(f,request,dir,libro)</dir>
      </when>     
      <when test="(f,eq,(prop,input1),libro2)">
        <dir id="dir_to_see">(f,request,dir,libro2)</dir>
      </when>              
      <when test="(f,eq,(prop,input1),services)">
        <dir id="dir_to_see">(dir,services)</dir>
      </when>  
      <when test="(f,eq,(prop,input1),serviceApps)">
        <dir id="dir_to_see">(dir,service_apps)</dir>
      </when>      
      <when test="(f,eq,(prop,input1),workspace)">
        <dir id="dir_to_see">(dir,workspace)</dir>
      </when>  
      <when test="(f,eq,(prop,input1),session_home_fs)">
        <dir id="dir_to_see">(f,request,dir,session_home_fs)</dir>
      </when>  
      <when test="(f,eq,(prop,input1),session_home_mem)">
        <dir id="dir_to_see">(f,request,dir,session_home_mem)</dir>
      </when>           
      
      <!--
              <sel label="Session-Home-Files">session_home_fs</sel>
      <sel label="Session-Home-Mem">session_home_mem</sel> 
      -->
      <when test="(f,eq,(prop,input1),this-app)">
        <dir id="dir_to_see">(dir,app)</dir>
      </when>  
      <when test="(f,eq,(prop,input1),this-pro)">
        <dir id="dir_to_see">(dir,pro)</dir>
      </when>              
      <when test="(f,eq,(prop,input1),takeoff)">
        <dir id="dir_to_see">(f,dir_of_file,(file,takeoff))</dir>
      </when>          
      <when test="(f,eq,(prop,input1),system)">
        <dir id="dir_to_see">(dir,system)</dir>
      </when>   
      <when test="(f,eq,(prop,input1),museum)">
        <dir id="dir_to_see">(dir,museum)</dir>
      </when>  
      <when test="(f,eq,(prop,input1),backup)">
        <dir id="dir_to_see">(dir,backup)</dir>
      </when>                
      <when test="(f,eq,(prop,input1),userhome)">
        <dir id="dir_to_see">(f,sys_prop,user.home)(prop,fs)</dir>
      </when>   
      <when test="(f,eq,(prop,input1),userdocs)">
        <dir id="dir_to_see">(dir,user_doc)</dir>
      </when>   
      <when test="(f,eq,(prop,input1),loxo_home)">
        <dir id="dir_to_see">(dir,home)</dir>
      </when>   
      <when test="(f,eq,(prop,input1),hand)">
        <when test="(f,has,dir,with-jil)">
          <prop id="hand">(dir,with-jil)</prop>
        </when>
        <tk type="textblock" id="hand" label="(prop,_seldir_enterfn)"/>
        <dir id="dir_to_see">(prop,hand)</dir>
      </when>                            
  
      <when test="(f,eq,(prop,input1),mpe1)">
        <dir id="dir_to_see">(f,request,dir,mpe1)</dir>
      </when>   
      <when test="(f,eq,(prop,input1),mpe2)">
        <dir id="dir_to_see">(f,request,dir,mpe2)</dir>
      </when> 
      <when test="(f,eq,(prop,input1),mpe3)">
        <dir id="dir_to_see">(f,request,dir,mpe3)</dir>
      </when> 

      <when test="(f,eq,(prop,input1),mpr)">
        <dir id="dir_to_see">(f,request,dir,mpr)</dir>
      </when>               
  
    </choose>     
 
      
    <prop id="joe-in-regex">input1|app_ref|pro_ref</prop>  
    <call_service job="go-joe-write-srv"/>
   
    
    <need>(dir,dir_to_see)</need>

    <global act="set" id="jil-result" x="(dir,dir_to_see)"/>
  
          
  </job>

<job id="jil-add-pro-dir" role="hidden">
 
      <need default="(prop,_seldir_appsel)">(prop,app_label)</need>
      
      <!-- <file id="applist" x="(f,reqeust,dir,sys_cache)">       -->
      <file id="applist" x="(dir,filetemp)applist.xml"/>
      <ask what="apps" out="(file,applist)" style="natural"/>

      <xslt 
          xml="(file,applist)" 
          out="(dir,filetemp)psi-sel-apps.xml">
          <inline attribute="xsl" flag="log"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet 
  version="1.0" 
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml"/>

<xsl:template match="/">
  <sels>
   <xsl:apply-templates select="//apps"/>
  </sels>
</xsl:template>

<xsl:template match="app">
   <sel><xsl:value-of select="@id"/></sel>
</xsl:template>

</xsl:stylesheet>
  ]]></inline>         
      </xslt>      
      <tk type="sel" id="app_ref" label="(prop,app_label)" xml="(dir,filetemp)psi-sel-apps.xml" flag="nono" tip="(f,vob,prop,app_tip)"/>


      <choose>
        <when test="(f,eq,(prop,app_ref),)">
          <dir id="dir_to_see">.</dir>
          <throw>(prop,_seldir_goodbye)</throw>
        </when>                 
        <when test="(f,eq,(prop,input1),app)">
          <ti test="0">selected app=(prop,app_ref)</ti>
          <dir id="dir_to_see">(f,xpath,(file,applist),apps/app[@id=(f,xpath_string,(prop,app_ref))],@dir)</dir>
        </when> 
        <when test="(f,eq,(prop,input1),pro)">
          <!--  <xsl:apply-templates select="//apps/app[@id=(f,xpath_string,(prop,app_ref))]/pro"/>  -->
          <xslt 
              xml="(file,applist)" 
              out="(dir,filetemp)psi-sel-pros.xml" >
              <params>id='(f,xslp,(prop,app_ref))'</params>
              <inline attribute="xsl"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
    <xsl:stylesheet 
      version="1.0" 
      xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
    <xsl:param name="id" />
    <xsl:output method="xml"/>
    
    <xsl:template match="/">
      <sels>
       <xsl:apply-templates select="//apps/app[@id=$id]/pro"/>
      </sels>
    </xsl:template>
    
    <xsl:template match="pro">
       <sel><xsl:value-of select="@id"/></sel>
    </xsl:template>
    
    </xsl:stylesheet>
      ]]></inline>         
            </xslt>      
            <tk type="sel" id="pro_ref" label="(prop,_seldir_selecta) &apos;(prop,app_ref)&apos; (prop,_seldir_PROJECT)" xml="(dir,filetemp)psi-sel-pros.xml" flag="nono"/>
    
            <choose>
              <when test="(f,eq,(prop,pro_ref),)">
                <dir id="dir_to_see">.</dir>
                <throw>(prop,_seldir_goodbye)</throw>
              </when>                 
              <when test="(f,eq,(prop,input1),pro)">
                <dir id="dir_to_see">(f,xpath,(file,applist),apps/app[@id=(f,xpath_string,(prop,app_ref))]/pro[@id=(f,xpath_string,(prop,pro_ref))],@data_dir)</dir>
                <ti test="0">project dir=(dir,dir_to_see)</ti>
              </when> 
            </choose>
          </when>                
      </choose>
            
     
</job>

<job id="jil-add-app-dir" role="hidden">
      <need default="Application Selection">(prop,app_label)</need>
      <file id="appask" x="(dir,filetemp)psi-ask.xml"/>
      <ask what="apps" out="(file,appask)" style="natural"/>
      <xslt 
          xml="(file,appask)" 
          out="(dir,filetemp)psi-sel-apps.xml">
          <inline attribute="xsl"><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet 
  version="1.0" 
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="xml"/>

<xsl:template match="/">
  <sels>
   <xsl:apply-templates select="//apps"/>
  </sels>
</xsl:template>

<xsl:template match="app">
   <sel><xsl:value-of select="@id"/></sel>
</xsl:template>

</xsl:stylesheet>
  ]]></inline>         
      </xslt>

      <file id="joe-in-store">(f,request,dir,sys_cache)jil-app-ic.xml</file>
      <prop id="joe-in-regex">app_ref</prop>
      <ti type="file" label="app-sel-cache" x="(file,joe-in-store)"/>  
      <call_service job="go-joe-read"/>
    
      <tk type="sel" id="app_ref" label="(prop,app_label)" xml="(dir,filetemp)psi-sel-apps.xml" flag="nono"/>

      <prop id="joe-in-regex">app_ref</prop>  
      <call_service job="go-joe-write-srv"/>
    
      <choose>
        <when test="(f,eq,(prop,app_ref),)">
          <dir id="dir_to_see">.</dir>
          <throw>good bye</throw>
        </when>                 
        <otherwise>
          <dir id="dir_to_see">(f,xpath,(file,appask),apps/app[@id=(f,xpath_string,(prop,app_ref))],@dir)</dir>
        </otherwise>
      </choose>
</job>






</jobs>