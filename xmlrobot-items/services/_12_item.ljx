<job id="item-add-app-zip" role="hidden">
  <need>(dir,target-dir)</need>
  
  <!-- read input-cach -->
  <file id="joe-in-store">(dir,status)srv-add-element-2-ic.xml</file>
  <call_service job="go-joe-read"/>

  <!-- select a zip-file -->

  <tk label="Install an Application">
    <tk id="app-zip"
        type="file"
        label="Select Application Zip-File to use"
        base="(dir,system)material"
        extension=".zip"
        tip="A zip file which contains the zipped application folder"
        flag="print_before nono"/>
  </tk>
  
  <!-- write input-cach -->
  <prop id="joe-in-regex">app-zip</prop>
  <call_service job="go-joe-write-srv"/>

  <!-- create default app-name by filename of zip -->
  <prop id="appname">(f,name_of_file,(file,app-zip))</prop>
  <when test="(f,starts_with,(prop,appname),app.)">
    <prop id="appname" x="(f,substring_after,(prop,appname),app.)"/>
  </when>
  <prop id="p1" x="(f,index_of,(prop,appname),.)"/>
  <when test="(f,gt,(prop,p1),-1)">
     <prop id="appname">(f,substring,(prop,appname),0,(prop,p1))</prop>
  </when>
  
  <when test="(f,starts_with,(prop,appname),APP_)">
     <prop id="appname" flag="catch">(f,substring,(prop,appname),4)</prop>
  </when>  

  <!-- verify input -->
  <tk id="appname" 
      label="Application Name" 
      flag="nono" 
      regex=".+"
      test="(f,role,admin)"/>

  <tk label="Going to install app: (prop,appname)" 
      flag="sum_only"
      tip="We are going to install now this application. Check the details ...">
     <tk id="appname" 
         label="Application Name" 
         flag="nono"
         tip="The name the application will have"/>  
     <tk id="app-zip" 
         type="file" 
         label="Zip-File"
         extension=".zip"
         flag="nono"
         tip="The zip-file which contains the Application to be installed."/>

  </tk>
  
  <!--check for duplicate appname -->
  <call_service job="item-add-check-newapp">
    <prop id="newapp" x="(prop,appname)"/>
  </call_service>
  
  <!-- specify foldername for app-->
  <dir id="target-app" x="(dir,target-dir)app.(prop,appname)" />
  
  <when test="(f,dir_exists,(dir,target-app))">
    <ti type="dir" label="Found this:" x="(dir,target-app)"/>
    <throw>An application '(prop,appname)' exists already in folder '(f,dir_of_dir,(dir,target-app))'. Try again with another name ...</throw>
  </when>
  
  <!-- unzip, doing the unzip now to a temporary folder to check github -->
  <dir id="aut" x="(dir,filetemp)app-unzip-tmp" />
  <tp>Unzip App-Archive (file,app-zip)...</tp>  

   <delete dir="(dir,aut)" />
   <mkdir dir="(dir,aut)"/>
   <unzip file="(file,app-zip)" todir="(dir,aut)"/>

  
  <!-- standard-app-zip remembers things ... -->
  <prop id="standard-app-zip" x="1" />

  <!-- thats expected thing on github -->  
  <dir id="github" x="(dir,aut)(f,name_of_file2,(file,app-zip))" />

  <when test="(f,exists_dir,(dir,github))">
  
    <tk type="sel" label="Was this application-zip downloaded from GITHUB ?" id="github" x="1" flag="nono">
      <sel label="Yes">1</sel>
      <sel label="No">0</sel>
      <sel label="Just do what you are said(e:s) and dont ask">0</sel>
    </tk>
    
    <when test="(f,eq,1,(prop,github))">
      <!-- ok, came from github, just take the inner zip/dir -->
      <copy uri="(dir,github)" touri="(dir,target-app)"/>

      <prop id="standard-app-zip" x="0" /> <!-- avoid doing the standard -->
    </when>
  </when>
  
  <!-- standard procedure if its not coming from github -->
  <when test="(f,eq,1,(prop,standard-app-zip))">
    <copy uri="(dir,aut)" touri="(dir,target-app)"/>
   
  </when>
  
  <!-- restart nic -->
  <restart app="(prop,appname)" pro=" "/>  
</job>

<job id="item-add-check-newapp" role="hidden">
  <need>(prop,newapp)</need>
  <file id="adcna-ask" x="(dir,filetemp)ask.xml"/>
  <ask what="apps" app="(prop,newapp)" out="(file,adcna-ask)" style="natural"/>
  <prop id="adcna-count" x="(f,xsl,(file,adcna-ask),count(e:o)//app(e:c))"/>
  <when test="(f,gt,(prop,adcna-count),0)">
    <prop id="adcna-sa" x="(f,xsl,(file,adcna-ask),//app/@sa)"/>
    <throw>Application '(prop,newapp)' exists already. Its (f,when,(prop,adcna-sa),a Service application, an Application in Workspace '(prop,workspace)'). Try another name!</throw>
  </when>
</job>

</jobs>