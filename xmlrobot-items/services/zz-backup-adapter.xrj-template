<jobs>

<job id="Backup: PROJECT" pri="10" tip="Makes a backup of the project-data">
  <call_service job="Backup: Project" flag="silent"/>
</job>

<job id="Backup: PROJECT?">
  <ti label="About: Backup: PROJECT">
    <ti type="ul">Lets you make backups of the project</ti>
    <ti type="ul">()With this help-button you can also duplicate, rename and delete projects ...()</ti>
    <ti type="ul">()With this help-button you can also see the project-backups ...()</ti>    
  </ti>
  <when test="(f,has,prop,pro)">
    <ti_hr/>
    <call_service job="Project" flag="silent">
      <prop id="pro-details" x="0"/>
      <prop id="pro-backup-things" x="0"/>
    </call_service>
    <ti_hr/>
    <call_service job="See Project Backups" flag="silent"/>
  </when>
</job>


<job id="Backup: APP" joblevel="app" pri="10" tip="Makes a backup of the application-software" role="admin">
  <call_service job="Backup: Application" flag="silent"/>
</job>

<job id="Backup: APP?">
  <ti label="About: Backup: APP">
    <ti type="ul">Lets you make backups of the app</ti>
    <ti type="ul">()With this help-button you can also see the app-backups ...()</ti>         
  </ti>
  <when test="(f,has,prop,app)">
  <ti_hr/>
  <call_service job="See Application Backups" flag="silent"/>
  </when>
</job>

