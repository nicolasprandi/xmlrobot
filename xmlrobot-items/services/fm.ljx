        <call_service job="open_dir" />
      </when>
      <when test="(f,exists,prop,app)" >
        <dir id="with">(dir,app)</dir>
        <call_service job="open_dir" />
      </when>
      <otherwise>
        <dir id="with">(dir,workspace)</dir>
        <call_service job="open_dir" />
      </otherwise>
      <otherwise>
        <info>no recognition of folderlevel</info>      
      </otherwise>
    </choose>
      
  </job>  
  -->
  
</jobs>