<job id="&gt;&gt; Echnaton Eclipse Build" joblevel="ws" role="test">

  <call_app
        app="Arc-CustomerBuilder"
        pro_id="first"
        pro_dir="(f,ask,pro_dir,Arc-CustomerBuilder,first)"
        job="action_custset_build">
    <prop id="custset_key">24</prop>
  </call_app>
  
  <call_app
        app="Arc-WebXml-Producer"
        pro_id="main"
        pro_dir="(f,ask,pro_dir,Arc-WebXml-Producer,main)"
        job="Edit &amp; Run">
  </call_app>
    

</job>

