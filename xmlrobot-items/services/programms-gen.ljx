<prop id="programms_return_job">(prop,programms_return_job)</prop>
<file id="computers">(file,computers)</file>
<prop id="computers_offset">(prop,computers_offset)</prop>
<prop id="computers_offset_label">(prop,computers_offset_label)</prop>
<prop id="computers_offset_new_key">(prop,computers_offset_new_key)</prop>
<prop id="computers_sort_attribute">(prop,computers_sort_attribute)</prop>
<prop id="computers_sort_number">(prop,computers_sort_number)</prop>
<prop id="computers_where">(prop,computers_where)</prop>
<prop id="computers_return_job">(prop,computers_return_job)</prop>
<prop id="computer_key">(prop,computer_key)</prop>
</ti>
<ti type="call_service" explain="Delete" job="Del Programm">
<prop id="programm_key">(loop,i,@row)</prop>
<file id="programms">(file,programms)</file>
<prop id="programms_offset">(prop,programms_offset)</prop>
<prop id="programms_offset_label">(prop,programms_offset_label)</prop>
<prop id="programms_offset_new_key">(prop,programms_offset_new_key)</prop>
<prop id="programms_sort_attribute">(prop,programms_sort_attribute)</prop>
<prop id="programms_sort_number">(prop,programms_sort_number)</prop>
<prop id="programms_where">(prop,programms_where)</prop>
<prop id="programms_return_job">(prop,programms_return_job)</prop>
<file id="computers">(file,computers)</file>
<prop id="computers_offset">(prop,computers_offset)</prop>
<prop id="computers_offset_label">(prop,computers_offset_label)</prop>
<prop id="computers_offset_new_key">(prop,computers_offset_new_key)</prop>
<prop id="computers_sort_attribute">(prop,computers_sort_attribute)</prop>
<prop id="computers_sort_number">(prop,computers_sort_number)</prop>
<prop id="computers_where">(prop,computers_where)</prop>
<prop id="computers_return_job">(prop,computers_return_job)</prop>
<prop id="computer_key">(prop,computer_key)</prop>
</ti>
<ti isFromAction="1" type="call_service" page="view" explain="Test" job="hook_programm_act_test" flag="silent">
<prop id="greetings_from_page">view</prop>
<prop id="greetings_from_action">test</prop>
<prop page="view" id="programm_key">(loop,i,@row)</prop>
<file id="programms">(file,programms)</file>
<prop id="programms_offset">(prop,programms_offset)</prop>
<prop id="programms_offset_label">(prop,programms_offset_label)</prop>
<prop id="programms_offset_new_key">(prop,programms_offset_new_key)</prop>
<prop id="programms_sort_attribute">(prop,programms_sort_attribute)</prop>
<prop id="programms_sort_number">(prop,programms_sort_number)</prop>
<prop id="programms_where">(prop,programms_where)</prop>
<prop id="programms_return_job">(prop,programms_return_job)</prop>
<file id="computers">(file,computers)</file>
<prop id="computers_offset">(prop,computers_offset)</prop>
<prop id="computers_offset_label">(prop,computers_offset_label)</prop>
<prop id="computers_offset_new_key">(prop,computers_offset_new_key)</prop>
<prop id="computers_sort_attribute">(prop,computers_sort_attribute)</prop>
<prop id="computers_sort_number">(prop,computers_sort_number)</prop>
<prop id="computers_where">(prop,computers_where)</prop>
<prop id="computers_return_job">(prop,computers_return_job)</prop>
<prop id="computer_key">(prop,computer_key)</prop>
</ti>
</ti>
</loop>
<when test="(prop,nothing)">
<ti>No Programms found</ti>
</when>
<when test="(f,not,(f,contains,(prop,programms_offset),node(e:o)(e:c)))">
<ti label=" " type="call_service" explain="Add another Programm" explain_alt="Add another Programm(prop,programms_offset_label)" job="Add another Programm">
<file id="programms">(file,programms)</file>
<prop id="programms_offset">(prop,programms_offset)</prop>
<prop id="programms_offset_label">(prop,programms_offset_label)</prop>
<prop id="programms_offset_new_key">(prop,programms_offset_new_key)</prop>
<prop id="programms_sort_attribute">(prop,programms_sort_attribute)</prop>
<prop id="programms_sort_number">(prop,programms_sort_number)</prop>
<prop id="programms_where">(prop,programms_where)</prop>
<prop id="programms_return_job">(prop,programms_return_job)</prop>
<file id="computers">(file,computers)</file>
<prop id="computers_offset">(prop,computers_offset)</prop>
<prop id="computers_offset_label">(prop,computers_offset_label)</prop>
<prop id="computers_offset_new_key">(prop,computers_offset_new_key)</prop>
<prop id="computers_sort_attribute">(prop,computers_sort_attribute)</prop>
<prop id="computers_sort_number">(prop,computers_sort_number)</prop>
<prop id="computers_where">(prop,computers_where)</prop>
<prop id="computers_return_job">(prop,computers_return_job)</prop>
<prop id="computer_key">(prop,computer_key)</prop>
</ti>
</when>
<when test="(f,has_flag,debug trace all,(f,info,level))">
<ti_hr />
<ti label="Debug Information">
<ti label="File:" type="file">(file,programms)</ti>
<ti label="Xml-Offset:" test="(f,gt,(f,len,(prop,programms_offset)),0)">(prop,programms_offset)</ti>
</ti>
</when>
</job>
<job role="hidden" id="To Memory Programm">
<need>(prop,programm_key)</need>
<spirit act="open" id="programms_spirit_tc" xml="(file,programms)"  
  flag="nuevo"
  missing_strategy="empty"/>
<prop id="programm_dt_upd">(f,spirit,programms_spirit_tc,(prop,programms_offset)programm[@row='(prop,programm_key)'],@dt_upd)</prop>
<prop id="programm_dt_add">(f,spirit,programms_spirit_tc,(prop,programms_offset)programm[@row='(prop,programm_key)'],@dt_add)</prop>
<prop id="programm_title">(f,spirit,programms_spirit_tc,(prop,programms_offset)programm[@row='(prop,programm_key)'],@title)</prop>
<prop id="programm_sort">(f,spirit,programms_spirit_tc,(prop,programms_offset)programm[@row='(prop,programm_key)'],@sort)</prop>
<file id="programm_pgm_file">(f,spirit,programms_spirit_tc,(prop,programms_offset)programm[@row='(prop,programm_key)'],@pgm_file)</file>
<echo id="programm_pgm_file" type="file" label="Station A" level="warn"/>
<unescape type="file" id="programm_pgm_file" />
<echo id="programm_pgm_file" type="file" label="Station B" level="warn"/>
<translate type="file" id="programm_pgm_file" />
<echo id="programm_pgm_file" type="file" label="Station C" level="warn"/>
<prop id="programm_pgm_app">(f,spirit,programms_spirit_tc,(prop,programms_offset)programm[@row='(prop,programm_key)'],@pgm_app)</prop>
<prop id="programm_pgm_alt">(f,spirit,programms_spirit_tc,(prop,programms_offset)programm[@row='(prop,programm_key)'],@pgm_alt)</prop>
<spirit act="close" id="programms_spirit_tc" />
</job><job role="hidden" id="See Programm">
<need>(prop,programm_key)</need>
<call_service job="To Memory Programm" />
<ti_hr />
<ti label="[ (prop,programm_title) ]" key="#(prop,programm_key)" />
<ti padding_top="0px" laxxbel="(prop,programm_title)(prop,programms_offset_label)">
<ti label="Programm File:" type="file" test="(f,and,(f,gt,(f,len,(file,programm_pgm_file)),0),(f,exists,file,programm_pgm_file))">(file,programm_pgm_file)</ti>
<ti label="Application:" type="text" test="(f,and,(f,gt,(f,len,(prop,programm_pgm_app)),0),(f,exists,prop,programm_pgm_app))">(prop,programm_pgm_app)</ti>
<ti label="Programms Title:" type="text" test="(f,has,prop,programm_title)">(prop,programm_title)</ti>
<ti label="Sort:" type="text" test="(f,has,prop,programm_sort)">(prop,programm_sort)</ti>
<ti label="Alternative Pgm:" type="text" test="(f,and,(f,gt,(f,len,(prop,programm_pgm_alt)),0),(f,exists,prop,programm_pgm_alt))">(prop,programm_pgm_alt)</ti>
</ti>
<ti_hr />
<ti padding_top="6px" label="Programm Actions">
<ti type="call_service" explain="Edit" job="Edit Programm">
<prop id="programm_key">(prop,programm_key)</prop>
<file id="programms">(file,programms)</file>
<prop id="programms_offset">(prop,programms_offset)</prop>
<prop id="programms_offset_label">(prop,programms_offset_label)</prop>
<prop id="programms_offset_new_key">(prop,programms_offset_new_key)</prop>
<prop id="programms_sort_attribute">(prop,programms_sort_attribute)</prop>
<prop id="programms_sort_number">(prop,programms_sort_number)</prop>
<prop id="programms_where">(prop,programms_where)</prop>
<prop id="programms_return_job">(prop,programms_return_job)</prop>
<file id="computers">(file,computers)</file>
<prop id="computers_offset">(prop,computers_offset)</prop>
<prop id="computers_offset_label">(prop,computers_offset_label)</prop>
<prop id="computers_offset_new_key">(prop,computers_offset_new_key)</prop>
<prop id="computers_sort_attribute">(prop,computers_sort_attribute)</prop>
<prop id="computers_sort_number">(prop,computers_sort_number)</prop>
<prop id="computers_where">(prop,computers_where)</prop>
<prop id="computers_return_job">(prop,computers_return_job)</prop>
<prop id="computer_key">(prop,computer_key)</prop>
</ti>
<ti type="call_service" explain="Delete" job="Del Programm">
<prop id="programm_key">(prop,programm_key)</prop>
<file id="programms">(file,programms)</file>
<prop id="programms_offset">(prop,programms_offset)</prop>
<prop id="programms_offset_label">(prop,programms_offset_label)</prop>
<prop id="programms_offset_new_key">(prop,programms_offset_new_key)</prop>
