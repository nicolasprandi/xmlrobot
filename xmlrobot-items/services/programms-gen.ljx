<include file="(dir,services)programms-prolog.lsx" /><job id="View Programms" joblevel="pro" role="hidden" tip="Lists all Programms">
<prop id="nothing">1</prop>
<loop id="i" xml="(file,programms)" xpath="(prop,programms_offset)programm(prop,programms_where)" sort="(prop,programms_sort_attribute)" number="(prop,programms_sort_number)" ignore_case="(prop,programms_sort_ignore_case)" desc="(prop,programms_sort_desc)">
<when test="(prop,nothing)">
<when test="(f,gt,(f,len,(prop,programms_offset_label)),0)">
<ti>(f,html,bold,open)(prop,programms_offset_label): (f,html,bold,close)</ti>
</when>
<ti type="rec" label=" ">
<ti x="Sort" />
<ti x=" " />
<ti x=" " />
<ti x=" " />
<ti x=" " />
</ti>
<prop id="nothing">0</prop>
</when>
<ti type="rec" label="(f,html,bold,open)(loop,i,@title)(f,html,bold,close)">
<ti type="text" x="(loop,i,@sort)" />
<ti type="call_service" explain="See" job="See Programm">
<prop id="programm_key">(loop,i,@row)</prop>
<file id="programms">(file,programms)</file>
<prop id="programms_offset">(prop,programms_offset)</prop>
<prop id="programms_offset_label">(prop,programms_offset_label)</prop>
<prop id="programms_offset_new_key">(prop,programms_offset_new_key)</prop>
<prop id="programms_sort_attribute">(prop,programms_sort_attribute)</prop>
<prop id="programms_sort_number">(prop,programms_sort_number)</prop>
<prop id="programms_where">(prop,programms_where)</prop>
<prop id="programms_return_job">(prop,programms_return_job)</prop>
<file id="computers">(file,computers)</file>
<prop id="computers_offset">(prop,computers_offset)</prop>
<prop id="computers_offset_label">(prop,computers_offset_label)</prop>
<prop id="computers_offset_new_key">(prop,computers_offset_new_key)</prop>
<prop id="computers_sort_attribute">(prop,computers_sort_attribute)</prop>
<prop id="computers_sort_number">(prop,computers_sort_number)</prop>
<prop id="computers_where">(prop,computers_where)</prop>
<prop id="computers_return_job">(prop,computers_return_job)</prop>
<prop id="computer_key">(prop,computer_key)</prop>
</ti>
<ti type="call_service" explain="Edit" job="Edit Programm">
<prop id="programm_key">(loop,i,@row)</prop>
<file id="programms">(file,programms)</file>
<prop id="programms_offset">(prop,programms_offset)</prop>
