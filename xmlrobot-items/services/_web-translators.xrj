<job id="tr_seldir" role="hidden">
 <!--
 (prop,_seldir_) (prop,_seldir__) 
  -->
 <when test="(f,not,(f,has,prop,_seldir_confchange))">
   <choose>           
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_seldir_confchange">Best&#228;tigen oder &#196;ndern</prop>
      <choose>
        <when test="(f,implement,online)">
          <prop id="_seldir_vorauswahl">Verzeichnis-Wahl</prop>
        </when>
        <otherwise>
          <prop id="_seldir_vorauswahl">Vorauswahl</prop>
        </otherwise>
      </choose>
      
      <prop id="_seldir_dirtype">W&#228;hlen Sie eine Verzeichnis-Kategorie aus</prop>
      <prop id="_seldir_typentip">()Das ist eine Liste von System-Verzeichnissen. Die Liste unterst&#252;tzt Sie beim Auffinden eines Verzeichnisses. Verwenden Sie 'Manuelle Eingabe' um einen Verzeichnisnamen direkt mit der Tastatur zu erfassen.()</prop>
      <prop id="_seldir_your">Ihr</prop>
      <prop id="_seldir_project">Projekt</prop>
      <prop id="_seldir_serving">Unterst&#252;tzendes</prop>
      <prop id="_seldir_userdocs">OsBenutzer - Dokumente</prop>
      <prop id="_seldir_userhome">OsBenutzer - Home</prop>
      <prop id="_seldir_sessdisk">Sitzung - Festplatte</prop>
      <prop id="_seldir_sessmem">Sitzung - Hauptspeicher</prop>
      <prop id="_seldir_dblink">PdB - Projektdatenbank</prop>
      <prop id="_seldir_libro">Libro - Bilder</prop>
      <prop id="_seldir_libro2">Libro - Daten</prop>
      <prop id="_seldir_app">Applikation</prop>
      <prop id="_seldir_allapps">Verzeichnis aller Applikationen</prop>
      <prop id="_seldir_takeoff">Takeoff</prop>
      <prop id="_seldir_services">Services</prop>
      <prop id="_seldir_javahome">Java - Home</prop>
      <prop id="_seldir_manual">Manuelle Eingabe ...</prop>
      <prop id="_seldir_cancelled">Auswahl Abgebrochen</prop>
      <prop id="_seldir_doselapppro">()W&#228;hlen Sie zuerste eine APPLIKATION, darnach ein Projekt ...()</prop>
      <prop id="_seldir_doselapppro_tip">()Sie haben sich dazu entschlossen, ein projekt zu w&#228;hlen. Um dieses aufzufinden, w&#228;hlen Sie bitte zuerst eine APPLIKATION aus. Darnach wird Ihnen eine Liste der dazu passenden Projekte angeboten.()</prop>
      <prop id="_seldir_enterfn">Geben Sie einen Verzeichnisnamen ein</prop>
      <prop id="_seldir_appsel">Auswahl einer Applikation</prop>
      <prop id="_seldir_goodbye">tsch&#252;ss</prop>
      <prop id="_seldir_selecta">W&#228;hlen Sie ein</prop>
      <prop id="_seldir_PROJECT">PROJEKT</prop>
      <!-- <prop id="_seldir_"></prop> -->  
            
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(f,interpreter,lang),es)" lang="es">
    
    </when>  -->  
    <when test="1" lang="en">   
      <!-- e=englisch -->
    <!-- d=deutsch -->
      <prop id="_seldir_confchange">Confirm or Change</prop>

      
      <choose>
        <when test="(f,implement,online)">
          <prop id="_seldir_vorauswahl">Selection</prop>
        </when>
        <otherwise>
          <prop id="_seldir_vorauswahl">Preselection</prop>
        </otherwise>
      </choose>      
      
      <prop id="_seldir_dirtype">Select a Directory-Type</prop>
      <prop id="_seldir_typentip">()This is a list of the System-Folders. It helps you to find project- or application-folders. You will be navitaged through your datastructure. Use 'Manual Input per hand' to enter a folder-name with the keyboard.()</prop>
      <prop id="_seldir_your">Your</prop>
      <prop id="_seldir_project">Project</prop>
      <prop id="_seldir_serving">Serving</prop>
      <prop id="_seldir_userdocs">OsUser - Documents</prop>
      <prop id="_seldir_userhome">OsUser - Home</prop>
      <prop id="_seldir_sessdisk">Session - Disk</prop>
      <prop id="_seldir_sessmem">Session - Memory</prop>
      <prop id="_seldir_dblink">PdB - Projectdatabase</prop>
      <prop id="_seldir_libro">Libro - Pics</prop>
      <prop id="_seldir_libro2">Libro - Data</prop>
      <prop id="_seldir_app">Application</prop>
      <prop id="_seldir_allapps">Folder with all applications</prop>
      <prop id="_seldir_takeoff">Takeoff</prop>
      <prop id="_seldir_services">Services</prop>
      <prop id="_seldir_javahome">Java - Home</prop>
      <prop id="_seldir_manual">Manual input per hand ...</prop>
      <prop id="_seldir_cancelled">Selection cancelled.</prop>
      <prop id="_seldir_doselapppro">()Select first an APPLICATION, next the project ...()</prop>
      <prop id="_seldir_doselapppro_tip">()You decided to select a project. To find that project, we want you at first to select an application. Afterwards we will present you the list of projects of that application.()</prop>
      <prop id="_seldir_enterfn">Enter the Folder-Name</prop>
      <prop id="_seldir_appsel">Application Selection</prop>
      <prop id="_seldir_goodbye">good bye</prop>
      <prop id="_seldir_selecta">Select a</prop>
      <prop id="_seldir_PROJECT">PROJECT</prop>
      <!-- <prop id="_seldir_"></prop> -->
    </when>
  </choose>
</when>
</job>

