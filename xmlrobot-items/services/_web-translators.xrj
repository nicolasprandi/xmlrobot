<?xml version="1.0" encoding="UTF-8"?>
<jobs>

<job id="tr_sam" role="hidden">
 <!--
 (prop,) (prop,_sam_) (prop,_sam__) 
 <call_service job="tr_sam"/>
Ue &#220;
ue &#252;
Oe &#214;
oe &#246;
Ae &#196;
ae &#228;
-->
 <choose>           
    <when test="(f,eq_text,(f,interpreter,lang),de)" lang="de">
      <!-- d=deutsch -->
      <prop id="_sam_created_backup">Datensicherung wurde gemacht</prop>

      <prop id="_sam_ups_veraenderungen">Es ist bei den Zieldaten zwischenzeitlich zu einer Ver&#228;nderung gekommen</prop>      
      <prop id="_sam_ups_what">Was soll gemacht werden?</prop>
      <prop id="_sam_ups_see">Genauer betrachten</prop>
      <prop id="_sam_ups_stop">Abbrechen</prop>
      <prop id="_sam_ups_update">Neue Datenen fraglos &#252;bertragen</prop>
      
      <prop id="_sam_compare">Nochmals vergleichen ...</prop>
      <prop id="_sam_stopped">Abgebrochen ...</prop>
      <prop id="_sam_upd_sure">Sind Sie sich mit dem &#220;berschreiben sicher??</prop>
      <prop id="_sam_upd_doing">Die Ver&#228;nderungen werden begonnen ...</prop>
      <prop id="_sam_r_chg">Ver&#228;nderung</prop>
      <prop id="_sam_r_chg_pl">en</prop>
      <prop id="_sam_r_repl">Ersetzung</prop>
      <prop id="_sam_r_repl_pl">en</prop>
      <prop id="_sam_r_del">L&#246;schung</prop>
      <prop id="_sam_r_del_pl">en</prop>
      <prop id="_sam_r_new">Neuanlage</prop>
      <prop id="_sam_r_new_pl">n</prop>
      <prop id="_sam_r_equ">Gleich</prop>
      <prop id="_sam_r_equ_pl">e</prop>

      <prop id="_sam_r_did_perform">Durchgef&#252;hrt wurden</prop>
      <prop id="_sam_r_did_replace">Ersetzt:</prop>
      <prop id="_sam_r_did_replacek">ersetzt</prop>
      <prop id="_sam_r_did_delete">Gel&#246;scht:</prop>
      <prop id="_sam_r_did_deletek">gel&#246;scht</prop>
      <prop id="_sam_r_did_create">Neu:</prop>
      <prop id="_sam_r_did_createk">erzeugt</prop>

<prop id="_sam_r_did_replacek2">ersetzten</prop>
<prop id="_sam_r_did_deletek2">l&#246;schen</prop>
<prop id="_sam_r_did_createk2">neu</prop>

      <prop id="_sam_a_confirm">Sie m&#252;ssen die Ver&#228;nderungen noch best&#228;tigen ...</prop>
      <prop id="_sam_a_notmuch">Es gibt nichts zu tun(e:s) alles am neuersten Stand</prop>
      <prop id="_sam_a_performall">F&#252;hre alle Ver&#228;nderungen durch</prop>
(prop,)
      <prop id="_sam_a_nochanges">Keine Ver&#228;nderungen gefunden</prop>
      <prop id="_sam_a_copy">Kopiere</prop>
      <prop id="_sam_a_delete">L&#246;sche</prop>
      <prop id="_sam_a_new">Erzeuge</prop>
      <prop id="_sam_a_really">wirklich?</prop> 
      <prop id="_sam_compare">Vergleichen</prop>   
            
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(f,interpreter,lang),es)" lang="es">
    
    </when>  -->  
    <when test="1" lang="en">   
      <!-- e=englisch -->
      <prop id="_sam_created_backup">Created backup</prop>

      <prop id="_sam_ups_veraenderungen">Targeted data changed meanwhile</prop>      
      <prop id="_sam_ups_what">What to do?</prop>
      <prop id="_sam_ups_see">See into this</prop>
      <prop id="_sam_ups_stop">Stop</prop>
      <prop id="_sam_ups_update">Update Changes anyway</prop>
      
      <prop id="_sam_compare">Do compare again ...</prop>
      <prop id="_sam_stopped">Stopped ...</prop>
      <prop id="_sam_upd_sure">Sure about overwriting??</prop>
      <prop id="_sam_upd_doing">Starting now to implement Changes ...</prop>
      <prop id="_sam_r_chg">Change</prop>
      <prop id="_sam_r_chg_pl">s</prop>
      <prop id="_sam_r_repl">Replacement</prop>
      <prop id="_sam_r_repl_pl">s</prop>
      <prop id="_sam_r_del">Delete</prop>
      <prop id="_sam_r_del_pl">s</prop>
      <prop id="_sam_r_new">New</prop>
      <prop id="_sam_r_new_pl">s</prop>
      <prop id="_sam_r_equ">Equal</prop>
      <prop id="_sam_r_equ_pl">s</prop>

      <prop id="_sam_r_did_perform">Did perform</prop>
      <prop id="_sam_r_did_replace">Did replace:</prop>
      <prop id="_sam_r_did_replacek">replaced</prop>
      <prop id="_sam_r_did_delete">Did delete:</prop>
      <prop id="_sam_r_did_deletek">deleted</prop>
      <prop id="_sam_r_did_create">Did create:</prop>
      <prop id="_sam_r_did_createk">inserted</prop>
<prop id="_sam_r_did_replacek2">replace</prop>
<prop id="_sam_r_did_deletek2">delete</prop>
<prop id="_sam_r_did_createk2">new</prop>

      <prop id="_sam_a_confirm">We ask you to confirm the updates ...</prop>
      <prop id="_sam_a_notmuch">Not much to do</prop>
      <prop id="_sam_a_performall">Perform all changes</prop>
(prop,)
      <prop id="_sam_a_nochanges">No changes found</prop>
      <prop id="_sam_a_copy">Copy</prop>
      <prop id="_sam_a_delete">Delete</prop>
      <prop id="_sam_a_new">New</prop>
      <prop id="_sam_a_really">Really?</prop> 
      <prop id="_sam_compare">Compare</prop> 
    </when>
  </choose>
</job>

<job id="tr_wdb" role="hidden">
 <!--
 (prop,) (prop,_wdb_) (prop,_wdb__) 
 <call_service job="tr_wdb"/> -->
 <when test="(f,not,(f,has,prop,_wdb_prep_yourdblink))">
