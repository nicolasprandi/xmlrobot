      <prop id="_wdb_com_name">Projekt-Datenbank Commit</prop>
      <prop id="_wdb_syn_name">Projekt-Datenbank Synchronisation</prop>
      <prop id="_wdb_roll_name">Projekt-Datenbank Rollback</prop>
      <prop id="_wdb_wrt_writefrommem">Schreibe vom Projekt-Speicher &#8594; Projekt-Datenbank</prop>      
  
      <prop id="_wdb_down_headline">Projekt Zip</prop>
      <prop id="_wdb_read_readfrom">Lese von der Projekt-Datenbank &#8594; Projekt-Speicher</prop>      
      <prop id="_wdb_act_what">Welche Aufgabe wollen Sie ausf&#252;hren?</prop>
      <prop id="_wdb_act_readl">Datenbank &#8594; Projekt-Speicher</prop>
      <prop id="_wdb_act_read">Lesen</prop>
      <prop id="_wdb_act_writel">Projekt-Speicher &#8594; Datenbank</prop>
      <prop id="_wdb_act_write">Schreiben</prop>
      <prop id="_wdb_act_syncl">Lesen/Schreiben:</prop>
      <prop id="_wdb_act_sync">Synchronisieren</prop>      
      <prop id="_wdb_act_downl">Unterst&#252;tzung:</prop>
      <prop id="_wdb_act_down">Projekt-Download</prop>
       
            
    </when>
    <!-- s=spanish 
    <when test="(f,eq_text,(f,interpreter,lang),es)" lang="es">
    
    </when>  -->  
    <when test="1" lang="en">   
      <!-- e=englisch -->
      <prop id="_wdb_prep_yourdblink">Your PdB-Link</prop>
      <prop id="_wdb_prep_created">Created:</prop>      
      <prop id="_wdb_red_dir_to_del">Directory to delete empty dirs from</prop>
      <prop id="_wdb_com_name">Project-Database Commit</prop>
      <prop id="_wdb_syn_name">Project-Database Sync</prop>
      <prop id="_wdb_roll_name">Project-Database Rollback</prop>
      <prop id="_wdb_wrt_writefrommem">Writing from Memory &#8594; Database:</prop>      
  
      <prop id="_wdb_down_headline">Project Zip</prop>
      <prop id="_wdb_read_readfrom">Reading from database &#8594; memory:</prop>      
      <prop id="_wdb_act_what">What to do?</prop>
      <prop id="_wdb_act_readl">Database &#8594; Project</prop>
      <prop id="_wdb_act_read">Read</prop>
      <prop id="_wdb_act_writel">Project &#8594; Database</prop>
      <prop id="_wdb_act_write">Write</prop>
      <prop id="_wdb_act_syncl">Read/Write:</prop>
      <prop id="_wdb_act_sync">Synchronize</prop>      
      <prop id="_wdb_act_downl">Service:</prop>
      <prop id="_wdb_act_down">Project-Download</prop>
    </when>
  </choose>
  </when>
</job>



