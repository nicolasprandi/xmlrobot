</job>

<!-- edit data: read, userinput, write -->
<job id="tk_crmco_edit" tip="crmco_: Edit the Data" role="hidden">

  <call_service job="tk_crmco_prolog"/>
  
  <!-- preparing -->
  <choose>
    <when test="(f,exists_file,(file,crmco-data))">
      <!-- data exists already -->
      <prop id="tk_crmco_add_flag" x="sum_only print"/>
      <call_service job="tk_crmco_read"/>
    </when>
    <otherwise>
      <!-- no data exists -->
      <prop id="tk_crmco_add_flag" x="sum print"/>
      <call_service job="tk_crmco_defaults"/>
    </otherwise>
  </choose>
  
  <!-- doing input -->
  <call_service job="tk_crmco_core"/>
  
  <!-- writing data -->
  <call_service job="tk_crmco_write"/>

</job>



<job id="tk_crmco_print_values" tip="crmco_: Prints the entered values" role="hidden">
  
  <call_service job="tk_crmco_prolog"/>
  <call_service job="tk_crmco_read"/>
  
  <call_service job="tk_crmco_core">
    <prop id="tk_crmco_add_flag" x="print_only"/>
  </call_service>
  
</job>

<job id="tk_crmco_print_values_tips" tip="crmco_: Prints values and tips" role="hidden">
  <call_service job="tk_crmco_prolog"/>
  <call_service job="tk_crmco_read"/>
  
  <call_service job="tk_crmco_core">
    <prop id="tk_crmco_add_flag" x="print_only print_with_tips"/>
  </call_service>
  
</job>

<job id="tk_crmco_print_help" tip="crmco_: Prints only tips for help" role="hidden">
  
  <call_service job="tk_crmco_core">
    <prop id="tk_crmco_add_flag" x="print_only print_with_tips print_tips_only print_all_fields"/>
  </call_service>
  
</job>

<!-- read only the data, dont change that jobname! -->
<job id="tk_crmco_read" role="hidden">
  <call_service job="tk_crmco_prolog" />
  <call_service job="go-joe-read">
    <file id="joe-in-store" x="(file,crmco-data)" />
  </call_service>
  
  <call_service job="tk_crmco_defaults" />
  <dump/>
</job>

<!-- write only the data, dont change that jobname! -->
<job id="tk_crmco_write" role="hidden">
  <call_service job="go-joe-write">
    <file id="joe-in-store" x="(file,crmco-data)" />
    <prop id="joe-in-regex" x="(prop,crmco-regex)" />
  </call_service>
</job>

<!-- cleares data -->
<job id="tk_crmco_clear"  tip="crmco_: Clears the data" role="hidden">
  <delete file="(file,crmco-data)"/>
</job>


</jobs>