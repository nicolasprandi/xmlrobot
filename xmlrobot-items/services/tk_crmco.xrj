<jobs>

<job id="tk_crmco_prolog" role="hidden">  
  <file id="crmco-data" x="(dir,status)crmco-data.xrs"/>
  <prop id="crmco-regex" x="crmco_.+"/>  
</job>

<job id="tk_crmco_defaults" role="hidden">  
  <prop id="crmco_preview_limit" x="10" test="(f,not,(f,has,prop,crmco_preview_limit))"/>

</job>

<!-- crmco-core, make your changes here -->
<job id="tk_crmco_core" role="hidden" tip="crmco_: Tk Internal">

  <need default="">(prop,tk_crmco_add_flag)</need>

  <tk label="Parameters: File-Actions" 
      flag="(prop,tk_crmco_add_flag)"
      tip="()Some control-values for the file-actions.()"> 
            
    <tk id="crmco_preview_limit" 
        label="Preview Limit"
        test_first="0" 
        regex="\d+" 
        tip="This limits the list of preview-items"/>
