<jobs>

<prop id="backup_moment">(f,time,yyyy-MM-dd,job)_(f,time,HH-mm,job)</prop>
<job id="testst" role="test">
  <ti label="request libro ">(f,request,dir,libro)</ti>  
  <ti label="request libro2">(f,request,dir,libro2)</ti>  
  
  <ti label="request libro " type="dir">(f,request,dir,libro)</ti>  
  <ti label="request libro2" type="dir">(f,request,dir,libro2)</ti>  
</job>
<job id="Backup?" joblevel="ws">
  <ti label="About: Backup">
    <ti>(f,html,b,open)Makes backups(f,html,b,close)</ti>
    <ti type="ul">()Looks different for roles USER/EXPERT and ADMIN()</ti>
  </ti>
  
  <ti label="()1) ()Roles USER &amp; EXPERT">
    <ti type="ul">()Makes only project-backups()</ti>
    <ti type="ul">()Lets you see project-backups()</ti>
    <ti type="ul">()Requires a selected project in the database()</ti>
  </ti>
  
  <ti label="()2) ()Role ADMIN">
    <ti type="ul">()Makes backups of projects, applications and services()</ti>
    <ti type="ul">()Lets you see project-backups()</ti>
  </ti>  
    
</job>

<job id="Backup 4 Admins?" joblevel="ws">
  <ti label="About: Backup 4 Admins">
    <ti>(f,html,b,open)Offers a wide range of activities for the backups(f,html,b,close)</ti>
    <ti type="ul">()Handles project-, application- and service-backups()</ti>
    <ti type="ul">()Handles configuration of the project-trailer()</ti>
    <ti type="ul">()The project-trailer is a piece of script which is executed whenever a backup is done. It can be configured and is used to perform an additional task with the backup. For example to copy it on another drive. The project-trailer receives the following parameters:
(prop,type): pro, app or srv  - depending on what type of backup was performed
(dir,bt-dir): the current backup-directory
(prop,bt-pro): the project-id
(prop,bt-app): the application-id
(f,vob,prop,computer): the current compter()</ti>
  </ti>
  

    
</job>

<job id="Backup" joblevel="ws" role="admin">

<call_service job="make-static-project"/>

<choose>

<when test="(f,or,(f,has,prop,pro),(f,role,admin))">

  <call_service job="go-joe-read">
    <file id="joe-in-store">(dir,status)ic-backup-wish.xml</file>  
  </call_service>
  
  <choose>    
    <when test="(f,role,admin)">
      <tk label="Backup for Administrators">
      <tk id="bu-user-do"
          label="Make a backup of: "
          type="sel"
          flag="nono">
         <sel label="Pro: (f,upper,(f,vob,prop,pro))"
              test="(f,has,prop,pro)">bu-pro</sel> 
              
         <sel label="App: (f,upper,(f,vob,prop,app))"
              test="(f,and,(f,has,prop,app),(f,role,admin))">bu-app</sel> 
         <sel label="Srv: Services"
              test="(f,role,admin)">bu-services</sel>  
         <sel label="... or see project-backups"
              test="(f,has,prop,pro)">bu-see</sel>                       

      </tk>
      </tk>    
    </when>
    <otherwise>
      <tk label="Project Backup">
      <tk id="bu-user-do"
          label="Project: (f,upper,(f,vob,prop,pro))"
          type="sel"
          flag="nono">
         <sel label="Make a backup of (f,upper,(f,vob,prop,pro))"
              test="(f,has,prop,pro)">bu-pro</sel>          
         <sel label="See backups"
              test="(f,has,prop,pro)">bu-see</sel>
      </tk>
      </tk>    
    </otherwise>
  </choose>


  <call_service job="go-joe-write-srv">
    <file id="joe-in-store">(dir,status)ic-backup-wish.xml</file>   
    <prop id="joe-in-regex">bu-user-do</prop>
  </call_service>  
    
  <choose>
    <when test="(f,eq_text,bu-pro,(prop,bu-user-do))">
      <call_service 
          job="Backup: Project"
          flag="arrow"/>     
    </when>
    <when test="(f,eq_text,bu-app,(prop,bu-user-do))">
      <call_service 
          job="Backup: Application"
          flag="arrow"/>     
    </when> 
    <when test="(f,eq_text,bu-services,(prop,bu-user-do))">
      <call_service 
          job="Backup: Services"
          flag="arrow"/>     
    </when>       
    <when test="(f,eq_text,bu-see,(prop,bu-user-do))">
      <call_service 
          job="See Project Backups"
          flag="arrow"/>     
    </when>    
  </choose>
      
</when>
<otherwise>
  <ti label="Sorry(e:s) no project">
  <ti>Select a project (f,when,(f,role,admin),or application,) to make a backup ...</ti>
  </ti>
 
</otherwise>
</choose>
  
</job>

<job id="Backup 4 Admins" joblevel="ws" role="admin">
<call_service job="make-static-project"/>
<ti_space height="10px" />
  <when test="(f,has,prop,pro)">
    <ti label="Project (f,html,b,open)(prop,pro)(f,html,b,close)" type="rec">

      <ti label="Pro:"
          type="call_service"
          job="Backup: Project"
          flag="arrow"
          xexplain="(f,upper,(prop,pro))"
          explain="Do backup [ (prop,pro) ]">
      </ti> 
      <ti></ti>
      <ti label="Pro:"
          type="call_service" 
          job="See Project Backups"
          explain="See backups"
          flag="arrow"
          test="(f,has,prop,pro)"/>   
      <ti></ti>
      <ti type="call_service" 
          job="Project"
          explain="Manage project"
          flag="arrow"
          test="(f,has,prop,pro)"/>                     
    </ti>
    <ti_space height="3px"/>
  </when>

  <when test="(f,has,prop,app)">
    <ti label="App (f,html,b,open)(prop,app)(f,html,b,close)" type="rec">

      <ti type="call_service"
          job="Backup: Application"
          flag="arrow"
          explain="Do backup [ (prop,app) ]"
          xexplain="(f,upper,(prop,app))">
      </ti> 
      <ti></ti>
      <ti type="call_service" 
          job="See Application Backups"
          explain="See backups"
          flag="arrow"/>      
          
      <ti></ti>
      <ti type="call_service" 
          job="Application"
          explain="Manage application"
          flag="arrow"/>                            
    </ti>  
    <ti_space height="3px"/>
  
  </when>
  <ti_hr/>
  <ti label="Services" type="rec">

    <ti type="call_service"
        job="Backup: Services"   
        explain="Do backup services"
        flag="arrow"/> 
    <ti></ti>    
    <ti type="call_service" 
        job="See Service Backups"
        explain="See backups"
        flag="arrow"/>     
    <ti></ti>    
    <ti type="call_service" 
        job="Services"
        explain="Manage services"
        flag="arrow"/>              
  </ti>
     <when test="(f,role,admin)">
    <ti_hr/>
    <ti label="Backup Trailer"/>
    <ti labxel=" "
        type="call_service" 
        job="Backup-Trailer Conf?"
        explain="See Trailer"
        test="(f,role,admin)"/> 
              
    <ti labxel=" "
        type="call_service"
        job="Backup-Trailer Conf"
        explain="Declare Trailer"
        test="(f,role,admin)">
    </ti>    
    </when>
</job>

