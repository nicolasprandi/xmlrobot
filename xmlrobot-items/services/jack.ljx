<jobs>

<job id="go-jack-do-file" role="hidden">
  <prop id="jack-srv" x="0"/>
  <call_service job="go-jack-do-file-core"/>
</job>      

<job id="go-jack-do-file-srv" role="hidden">
  <prop id="jack-srv" x="1"/>
  <call_service job="go-jack-do-file-core"/>
</job> 

<job id="go-jack-do-file-core" role="hidden">
  <need>(file,jack-in)</need>  
  <need>(prop,jack-srv)</need>
  <need>(prop,jack-result-prop)</need>
  <need>(prop,jack-result-did-prop)</need>  
  <!-- <echo type="file" id="jack-in" label="In:"/> -->
  <choose>
    <when test="(f,has,file,jack-in)" >
      <dir id="jwith">(f,can_dir,(f,dir_of_file,(file,jack-in)))</dir>
      <call_service job="srv-jack-int-1" /> 
      <prop id="go-jack-do-file-ret"     x="(prop,jack-out)(f,escape,(f,name_of_file,(file,jack-in)))"/>
      <global act="set" id="(prop,jack-result-prop)" x="(prop,jack-out)(f,escape,(f,name_of_file,(file,jack-in)))"/>                            
      <global act="set" id="(prop,jack-result-did-prop)" x="1"/>         
    </when> 
    <otherwise>
      <prop id="go-jack-do-file-ret" x="(f,escape,(file,jack-in))"/>
      <global act="set" id="(prop,jack-result-prop)" x="(f,escape,(file,jack-in))"/> 
      <global act="set" id="(prop,jack-result-did-prop)" x="0"/>
    </otherwise>
  </choose>
  
  <!-- <echo type="prop" id="go-jack-do-file-ret" label="Jack: Return for file: (file,jack-in)"/>  -->

</job>

<job id="go-jack-do-dir" role="hidden" tip="x">
  <prop id="jack-srv" x="0"/>
  <call_service job="go-jack-do-dir-core"/>
</job>

<job id="go-jack-do-dir-srv" role="hidden" tip="x">
  <prop id="jack-srv" x="1"/>
  <call_service job="go-jack-do-dir-core"/>
</job>

<job id="go-jack-do-dir-core" role="hidden" tip="x">
  <need>(dir,jack-in)</need> 
  <need>(prop,jack-srv)</need> 
  <need>(prop,jack-result-prop)</need>
  <need>(prop,jack-result-did-prop)</need>   
  
  <choose>
    <when test="(f,has,dir,jack-in)" >
      <dir id="jwith">(f,can_dir,(dir,jack-in))</dir>
      <call_service job="srv-jack-int-1" />
      <global act="set" id="(prop,jack-result-prop)" x="(prop,jack-out)"/>  
      <global act="set" id="(prop,jack-result-did-prop)" x="1"/> 
    </when>
    <otherwise>
      <global act="set" id="(prop,jack-result-prop)" x="(f,escape,(dir,jack-in))"/>
      <global act="set" id="(prop,jack-result-did-prop)" x="0"/>  
    </otherwise>
  </choose>  
  
  

</job>

<job id="srv-jack-int-1" role="hidden">
  <need>(dir,jwith)</need>
  <need>(prop,jack-srv)</need>
  <file id="jspirit" x="(dir,filetemp)jack-jspirit.xml" />
  <!-- <file id="jspirit" x="H:\XmlRobot-Dev\Echnaton-Scripts\temp\jspriti.xml" />
  <ti type="file" test="0">(file,jspirit)</ti>     -->
  
  <prop id="isoffline" x="(f,not,(f,implement,online))" />             
  
  <create_file out="(file,jspirit)">&lt;list search_for=&quot;(x,(dir,jwith))&quot;/&gt;</create_file>
  <spirit id="jspirit" act="open" xml="(file,jspirit)" flag="nuevo"/>
  
  <when test="(f,not,(prop,jack-srv))">
    <!-- do project-dir if one exists -->
    <!-- hallo <ti>dirpro=(f,vob,dir,pro) jwith=(f,vob,dir,jwith)</ti> -->
    
    <!-- projekt -->
    <choose>
      <when test="(f,exists,dir,pro)">
        <when test="(f,dir_exists,(dir,pro))">
          <when test="(f,starts_with,(dir,jwith),(dir,pro))">                
            <!-- <prop id="name">pro</prop> -->
            <dir id="name">(dir,pro)</dir>
            <prop id="exxpr">()(dir,pro)()</prop>
            <prop id="pri">1</prop>
            <prop id="only_inside">1</prop>
            
            <call_service job="srv-jack-int-2" />                    
          </when>
        </when> <!-- end dir_exists -->
      </when> <!-- end pro -->
      
      <when test="(prop,isoffline)">
      <when test="(f,not,(f,has,prop,pro))">
      <when test="(f,has,prop,app)"  >
  
          <when test="(f,ask,app_has_static_pro,(prop,app))"  >
            <ti label="Problem">with Standar-Project</ti>
            <dir id="yypro" x="(dir,pro_home)pro_standard" />
            <when test="(f,dir_exists,(dir,yypro))">
              <when test="(f,starts_with,(dir,jwith),(dir,yypro))">                
                <!-- <prop id="name">pro</prop> -->
                <prop id="exxpr">()(dir,pro)()</prop>
                <dir id="name">(dir,yypro)</dir>
                <prop id="pri">1</prop>
                <prop id="only_inside">1</prop>
                <call_service job="srv-jack-int-2" />                    
              </when>
            </when> <!-- end dir_exists -->          
            <!-- 
            <prop id="pro" x="Standard-Project" />
            <dir id="pro" x="(dir,pro_home)pro_standard" />
            <mkdir dir="(dir,pro)" />
            -->
          </when>
      </when>  
      </when>
      </when>  
    </choose>
    
    
    <!-- do WORKSPACE AND APPLICATION 
         if one exists and if it isn't a service-app -->
    <when test="(f,exists,dir,app)">
      <!-- application -->
      <!-- <prop id="name">app</prop> -->
      <prop id="exxpr">()(dir,app)()</prop>
      <dir id="name">(dir,app)</dir>
      <prop id="pri">2</prop>
      <prop id="only_inside">1</prop>
      <call_service job="srv-jack-int-2" /> 
      
      <!-- workspace, but not for service-apps -->   
      <when test="(prop,isoffline)"> 
        <when test="(f,not,(prop,is_service_app))">
          <!-- <prop id="name">workspace</prop> -->
          <prop id="exxpr">()(dir,workspace)()</prop>
          <dir id="name">(dir,workspace)</dir>
          <prop id="pri">3</prop>
          <prop id="only_inside">1</prop>
          <call_service job="srv-jack-int-2" />
        </when>
      </when>
    </when>
  </when>
  <!-- 
  <try_catch>
  <try>
  </try>
  <catch/>
  </try_catch>     -->
    
    <when test="(f,has,(f,request,dir,databaselink))">
            <!-- <prop id="name">databaselink</prop> -->
            <prop id="exxpr">()(f,request,dir,databaselink)()</prop>
            <dir id="name">(f,request,dir,databaselink)</dir>
            <prop id="pri">3</prop>
            <prop id="only_inside">1</prop>
            <call_service job="srv-jack-int-2" />  
    </when>

  <!-- 
  <try_catch>
  <try>
  </try>
  <catch/>
  </try_catch>     
    <when test="(f,has,(f,request,dir,libro))">  
        </when>
  -->
    

            <!-- <prop id="name">libro</prop> -->
            <prop id="exxpr">()(f,request,dir,libro)()</prop>
            <dir id="name">(f,request,dir,libro)</dir>
            <prop id="pri">3</prop>
            <prop id="only_inside">1</prop>
            <call_service job="srv-jack-int-2" />  


  <!-- 
  <try_catch>
  <try>
    <when test="(f,has,(f,request,dir,libro2))">
            <prop id="name">libro2</prop>
    </when>
  </try>
  <catch/>
  </try_catch>              
    -->        
            <prop id="exxpr">()(f,request,dir,libro2)()</prop>
            <dir id="name">(f,request,dir,libro2)</dir>
            <prop id="pri">3</prop>
            <prop id="only_inside">1</prop>
            <call_service job="srv-jack-int-2" />  

  
  <when test="(prop,isoffline)">
    <!-- <prop id="name">system</prop> -->
    <prop id="exxpr">()(dir,system)()</prop>
    <dir id="name">(dir,system)</dir>
    <prop id="pri">4</prop>
    <prop id="only_inside">0</prop> <!-- am 16.6.23 auf 0 geändert damit auch am selben datenträger referenziert wird -->
    <call_service job="srv-jack-int-2" />    
    
    <!-- <prop id="name">museum</prop> -->
    <prop id="exxpr">()(dir,museum)()</prop>
    <dir id="name">(dir,museum)</dir>
    <prop id="pri">5</prop>
    <prop id="only_inside">1</prop>
    <call_service job="srv-jack-int-2" /> 
    
    
    <when test="(f,has,(f,request,dir,mpr))">
    <prop id="exxpr">()(f,request,dir,mpr)()</prop>
    <dir id="name">(f,request,dir,mpr)</dir>
    <prop id="pri">6</prop>
    <prop id="only_inside">1</prop>
    <call_service job="srv-jack-int-2" />  
    </when>
    
    <when test="(f,has,(f,request,dir,mpe1))"> 
    <prop id="exxpr">()(f,request,dir,mpe1)()</prop>
    <dir id="name">(f,request,dir,mpe1)</dir>
    <prop id="pri">6</prop>
    <prop id="only_inside">1</prop>
    <call_service job="srv-jack-int-2" /> 
    </when> 

    <when test="(f,has,(f,request,dir,mpe2))">
    <prop id="exxpr">()(f,request,dir,mpe2)()</prop>
    <dir id="name">(f,request,dir,mpe2)</dir>
    <prop id="pri">6</prop>
    <prop id="only_inside">1</prop>
    <call_service job="srv-jack-int-2" />  
    </when>
    
    <when test="(f,has,(f,request,dir,mpe3))">
    <prop id="exxpr">()(f,request,dir,mpe3)()</prop>
    <dir id="name">(f,request,dir,mpe3)</dir>
    <prop id="pri">6</prop>
    <prop id="only_inside">1</prop>
    <call_service job="srv-jack-int-2" />  
    </when>
      
  </when>
  <!-- <ti label="jspirit">(f,spirit,jspirit,xml?)</ti>  -->
  
  <!-- seit 2022-12-29 --> 
  <prop id="jack-out-did">0</prop>
  
  <loop id="pick" 
        spirit="jspirit" 
        limit="1" 
        xpath="member" 
        sort="@is_outside @pri" 
        number="@is_outside @pri">         
      <prop id="jack-out">(loop,pick)</prop>
      <prop id="jack-out-did">1</prop>        
  </loop>  
  
  <when test="(f,not,(prop,jack-out-did))">
      <prop id="jack-out">(f,escape,(dir,jwith))</prop>
  </when>
  <spirit id="jspirit" act="close"/>    
  
  <!-- bis 2022-12-29   
  <spirit id="jspirit" act="close" flag="write save"/>
  
  <prop id="result-count">(f,xsl,(file,jspirit),count(e:o)//member(e:c))</prop>
  <ti label="Result Count" test="0">(prop,result-count)</ti>
  
  <choose>
    <when test="(f,eq,(prop,result-count),0)">
      <prop id="jack-out">(f,escape,(dir,jwith))</prop>
      <prop id="jack-out-did">0</prop>
    </when>
    <otherwise>
      <loop id="pick" xml="(file,jspirit)" limit="1" 
            xpath="member" sort="@is_outside @pri" number="@is_outside @pri">         
          <prop id="jack-out">(loop,pick)</prop>
          <prop id="jack-out-did">1</prop>        
      </loop>
    </otherwise>
  </choose>                -->
  

  <!-- <echo type="prop" id="jack-out" label="selected by [srv-jack-int-1]"/>  -->

  <!-- <need>(prop,joe-out)</need> -->
</job>

<job id="srv-jack-int-2" role="hidden" tip="x">
  <!-- sparmassnahmen 
  <need>(dir,name) (dir,jwith) (prop,pri) (prop,only_inside) (prop,exxpr)</need>
  -->
  <!--  <ti>(dir,jwith)
(dir,name)
(f,vfs,(dir,jwith),root_uri)
(f,vfs,(dir,name),root_uri)
</ti>   -->   
  <choose>
    <!-- value equals request -->
    <when test="(f,eq_text,(dir,jwith),(dir,name))">
      <prop id="jack_out"></prop>
      <!-- inline vorher 
    <member 
      name="(prop,name)" 
      pri="(prop,pri)" 
      dir="(dir,name)" 
      is_outside="0">(e:o)dir(e:s)(prop,name)(e:c)</member>
      ]]>      
      -->
      <spirit id="jspirit" act="xml_update" how="append">
        <inline attribute="with"><![CDATA[
    <member 
      pri="(prop,pri)" 
      dir="(dir,name)" 
      is_outside="0">(prop,exxpr)</member>
      ]]>
        </inline>
      </spirit>
    </when>      
    <!-- <otherwise> -->
    <!-- nur am selben laufwerk -->
    
    <otherwise>
      <try_catch>
        <try>  
          <when test="(f,eq_text,(f,vfs,(dir,jwith),root_uri),(f,vfs,(dir,name),root_uri))">      
      
                <prop id="jack_out">(f,relative_dir,(dir,jwith),(dir,name))</prop>
                <!-- <ti label="jack_out">(prop,jack_out)</ti>   -->
                <escape type="prop" id="jack_out"/>
                <!-- filter outsiders if only insiders wanted -->
                <prop id="is_outside">(f,starts_with,(prop,jack_out),..)</prop>
      
                <when test="(f,or,(f,not,(prop,is_outside)),(f,not,(prop,only_inside)))">
                  <spirit id="jspirit" act="xml_update" how="append">
                    <inline attribute="with"><![CDATA[
                      <member 
                        dir="(dir,name)" 
                        is_outside="(f,starts_with,(prop,jack_out),..)"
                        pri="(prop,pri)"
                        >(prop,exxpr)(x,(prop,jack_out))</member>
                        ]]>
                    </inline>
                  </spirit>      
                </when>         
      
          </when>  
        
        
        </try>
        <catch>
          <ti label="Jacks Problem">(prop,catched_msg)</ti>
        </catch>


      </try_catch>          
    </otherwise>
    
    <!-- </otherwise>  -->
  </choose>
  
          <!-- inline vorher 
                <member 
                  name="(prop,name)" 
                  dir="(dir,name)" 
                  is_outside="(f,starts_with,(prop,jack_out),..)"
                  pri="(prop,pri)"
                  >(e:o)dir(e:s)(prop,name)(e:c)(x,(prop,jack_out))</member>
                  ]]>          
          -->  
        <!--
                          >(e:o)dir(e:s)(prop,name)(e:c)(x,(f,replace,(prop,jack_out),(prop,fs),(e:o)prop(e:s)fs(e:c)))</member> 
        -->
</job>

  <job id="go-joe-read!" role="hidden">
    <remove type="file" id="joe-in-store" flag="catch"/>
    <remove type="prop" id="joe-in-regex" flag="catch"/>    
  </job>
  
  <job id="go-joe-read" role="hidden">
    <try_catch>
      <try>
        <need>(file,joe-in-store)</need>
        <when test="(f,file_exists,(file,joe-in-store))">
          <exclude file="(file,joe-in-store)" regex="(prop,joe-in-regex)"/>
        </when>
      </try>
      <catch>
        <ti>(prop,catched_msg)</ti>
        <tp>Some problem in reading gui-store: (f,vob,file,joe-in-store) (f,vob,prop,joe-in-regex)</tp>
      </catch>
    </try_catch>
  </job>

  <job id="go-joe-write!" role="hidden">
    <remove type="file" id="joe-in-store" flag="catch"/>
    <remove type="prop" id="joe-in-regex" flag="catch"/>
  </job>
  
  <job id="go-joe-write" role="hidden">
    <prop id="job-go-jack-do-file" x="go-jack-do-file"/>
    <prop id="job-go-jack-do-dir" x="go-jack-do-dir"/>
    <call_service job="go-joe-write-core"/>
  </job>
  
  <job id="go-joe-write-srv" role="hidden">
    <prop id="job-go-jack-do-file" x="go-jack-do-file-srv"/>
    <prop id="job-go-jack-do-dir" x="go-jack-do-dir-srv"/>
    <call_service job="go-joe-write-core"/>
  </job>  
    
  <job id="go-joe-write-core" role="hidden">

    <need>(prop,joe-in-regex) (file,joe-in-store)</need>
    <file id="gj-ask">(dir,temp)joe-ask.xml</file>

    <ask what="vars" out="(file,gj-ask)" style="escaped"/>
    <ti label="ask-vars" type="file" x="(file,gj-ask)" test="0"/>
    <print act="open" id="jp" out="(file,joe-in-store)"/>
    <print act="println" id="jp">&lt;?xml version="1.0" ?&gt;&lt;steps&gt;</print>
    <prop id="isoffline" x="(f,not,(f,implement,online))" />
     
    <loop id="j" xml="(file,gj-ask)" xpath="vars/var" flag="dont_escape_on_read">
      <prop id="do-this">1</prop>
      <when test="(f,and,(f,eq,dir,(loop,j,@type)),(f,eq,(prop,fs),(loop,j)))">
        <prop id="do-this">0</prop>
      </when>
      <when test="(f,matches_regex,(loop,j,@id),(prop,joe-in-regex))">
      <when test="(prop,do-this)">
       <ti test="0">(loop,j,@type),(loop,j,@id) = (loop,j)</ti>
       
       <print act="print" id="jp" test="(f,eq,prop,(loop,j,@type))">&lt;p </print>
       <print act="print" id="jp" test="(f,eq,file,(loop,j,@type))">&lt;f </print>
       <print act="print" id="jp" test="(f,eq,dir,(loop,j,@type))">&lt;d </print>

       <print act="print" id="jp">id=&quot;(x,(f,escape,(loop,j,@id)))&quot;</print>
    
				<choose>
					<when test="(f,eq,,(loop,j))">
						<!-- nothing -->
						<print act="print" id="jp">&gt;</print>
					</when>
          <!-- online nix
					<when test="(f,not,(prop,isoffline))">						  
						<print act="print" id="jp">&gt;</print>
						<print act="print" id="jp" flag="dont_unescape_on_write">(x,(loop,j))</print>
					</when> -->          
					<when test="(f,eq,prop,(loop,j,@type))">
						<!-- property -->
						<print act="print" id="jp">&gt;</print>
						<print act="print" id="jp" flag="dont_unescape_on_write">(x,(loop,j))</print>
					</when>
					<when test="(f,eq,file,(loop,j,@type))">
						<!-- file -->
						<print act="print" id="jp">&gt;</print>
                                                
						<call_service job="(prop,job-go-jack-do-file)" flag="silent">
              <file id="jack-in" x="(loop,j)" />
              <prop id="jack-result-prop" x="(f,random_text,5)"/>
              <prop id="jack-result-did-prop" x="(f,random_text,5)"/>				
						</call_service>
						<global act="get" as_id="jack-result" id="(prop,jack-result-prop)"/>
						<print act="print" id="jp">(x,(prop,jack-result))</print>
					</when>
					<when test="(f,eq,dir,(loop,j,@type))">
						<!-- directory -->                                                
						<call_service job="(prop,job-go-jack-do-dir)" flag="silent">
              <prop id="jack-result-prop" x="(f,random_text,5)"/>
              <prop id="jack-result-did-prop" x="(f,random_text,5)"/>
              <dir id="jack-in" x="(loop,j)" />	
						</call_service>
						<global act="get" as_id="jack-result" id="(prop,jack-result-prop)"/>
						<when test="(f,not,(f,eq,(loop,j),(prop,jack-result)))">
							<print act="print" id="jp"> flag="cool"</print>
						</when>
						<print act="print" id="jp">&gt;</print>
						
						<print act="print" id="jp">(x,(prop,jack-result))</print>              
					</when>
				</choose>          
      
       <print act="print" id="jp">&lt;</print>
       <print act="println" id="jp" test="(f,eq,prop,(loop,j,@type))">/p&gt;</print>
       <print act="println" id="jp" test="(f,eq,file,(loop,j,@type))">/f&gt;</print>
       <print act="println" id="jp" test="(f,eq,dir,(loop,j,@type))">/d&gt;</print>

       </when>
      </when>
    </loop>
    <print act="println" id="jp">&lt;/steps&gt;</print>
    <print act="close" id="jp"/>

  </job>  
  
</jobs>