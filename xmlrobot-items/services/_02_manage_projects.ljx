  <call_job
    job="??"
    app="(prop,app)"
    pro="(prop,pro)"
    flxag="silent"/>
  
</job>
-->

<job id="Make Project" joblevel="pro" role="hidden">
  <need>(dir,from-pro-home)</need>
  <need>(dir,from-pro)</need>
  <need>(prop,from-app)</need>
  <tk label="Make Project">
    <tk type="msg" x="Going to ask you now for project-name ..."/>
  </tk>
  <prop id="not_ok" x="1"/>
  <loop id="not_ok" while="()(prop,not_ok)()">
    <tk label="Make Project">
      <tk type="text" 
          id="new_project_id" 
          rule="filename" 
          flag="nono"
          label="Name of new project" 
          tip="Under this name the project can be found in the database"/>    
    </tk>
    

    <dir id="new_project_dir" x="(dir,from-pro-home)pro.(prop,new_project_id)"/>
    <choose>
      <when test="(f,eq_text,Standard-Project,(prop,new_project_id))">
        <tk label="Project name not allowed">
          <tk type="msg" msg_type="e" x="project '(prop,new_project_id)' with this name [Standard-Project]not allowed&#xA;Enter another project-name ..."/>
        </tk>
      </when>    
      <when test="(f,dir_exists,(dir,new_project_dir))">
        <tk label="Project name not unique">
          <tk type="msg" msg_type="e" x="project '(prop,new_project_id)' &#xA;with directory '(dir,new_project_dir)' &#xA;exists already.&#xA;Enter another project-name ..."/>
        </tk>
      </when>
      <otherwise>
        <prop id="not_ok" x="0"/>
      </otherwise>
    </choose>
  </loop>

  <mkdir dir="(dir,new_project_dir)" />

    <copy touri="(dir,new_project_dir)" uri="(dir,from-pro)"/>
 
  <tk label="Make Project">
    <tk type="msg" msg="Switching now to new project '(prop,new_project_id)'"/>
  </tk>
  
  <restart app="(prop,from-app)" pro="(prop,new_project_id)"/>    
  
</job>
  
</jobs>