</job>
<job id="did-pda-action" role="hidden">
  <ti>we did it</ti>
</job>



<job id="TEST Project-Database Actions"  role="test" joblevel="ws">
  <prop id="db_app" x="Hibiscus"/>
  <prop id="db_conf">project_token='hibiscus' style='fs1' db_dir='file:///H:/Echnaton-Dbs/db1/'</prop>
  <prop id="db_ons">mayCheckinProject mayCheckoutProject mayDownloadProject</prop>
  <prop id="db_pro_extension"></prop>
  <prop id="db_bits"></prop>
  <prop id="db_pro_commits"></prop>
  <prop id="db_pro_cache"></prop>
  <prop id="db_pro" x="Test-Tk-General-1"/>
  <dir id="db_pro">file:///H:/XmlRobot-Dev/Echnaton-Scripts/xmlrobot-internals/system/service_apps/app.Hibiscus/pro.leer/</dir>
  
  <call_service job="Project-Database Actions"/>
  
</job>

 
</jobs>