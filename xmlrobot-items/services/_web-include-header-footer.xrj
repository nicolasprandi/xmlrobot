      </when>
      
      <!-- </when> <ti label="header">(f,file_content,(file,t1))</ti> -->
       <!-- ok <ti_hr_break/>  -->    
       
      <include file="(file,t1)"/>     
     
</job>    

<job id="include-header-the-class" role="hidden">

  <prop id="the-class">(f,when,(f,or,(f,eq_text,[ Werkzeuge ],(loop,sx,@id)),(f,eq_text,[ Anmelden ],(loop,sx,@id)),(f,eq_text,[ Tools ],(loop,sx,@id)),(f,eq_text,[ Login ],(loop,sx,@id))),stdSysButton,(prop,job-button-class))</prop>  

</job>
                       
<job id="do-that-app-help" joblevel="ws" role="hidden">
  <include file="(file,app-help-steps)" flag="catch"/>
</job>                          
<job id="include-footer" joblevel="ws" role="hidden">

  <ti_hr/>
  <ti_break/>
  <ti type="menu">
    <ti type="call_service" explain="Project" xexplain="Project [(prop,pro)]" job="Project"/>
    <ti type="call_service" job="Application" explain="App" xexplain="App [(prop,app)]"/>
    <ti type="call_service" job="System Info"/>
    <ti type="call_service" job="Applications"/>
  </ti>
</job>

<job id="include-project-footer" joblevel="ws" role="hidden">
  <ti_hr/>
  <ti_break/>
  <ti type="menu">
    <ti type="call_service" explain="Project [(prop,pro)]" job="Project"/>
    <ti type="call_service" job="Application" explain="App [(prop,app)]"/>
  </ti>
</job>

<job id="include-header-multi" joblevel="ws" role="hidden">
    <ti>bin im include-header-multi</ti>

    <file id="t1" x="(dir,filetemp)(f,random_text,5)t1"/>
    <print id="t1" out="(file,t1)" act="open"/> 
    <print act="println" id="t1"><![CDATA[<?xml version="1.0" ?><steps><ti type="rec">]]></print>
      
    <file id="ask" 
      x="(dir,filetemp)ask.xml"
      style="natural" /> 
  
    <!-- ask for system information -->
    <ask 
      what="apps" 
      out="(file,ask)" 
      app="(prop,app)"
      style="escaped"/>

     <print act="println" id="t1"><![CDATA[<ti type="call_service" job="do-that-now" explain="Home" flag="silent">
        <prop id="from-app">(x,(prop,app))</prop>
        <prop id="from-pro">(x,(prop,pro))</prop>
        <dir id="from-pro">(x,(dir,pro))</dir>
        <prop id="from-job">??</prop>   
     </ti>]]></print>
     
     <prop id="total" x="0"/>
     <loop 
      id="sx" 
      xml="(file,ask)" 
      xpath="apps/app/jobs/job" 
      missing_strategy="empty">
      <when test="(f,role,(loop,sx,@role))">
      <when test="(f,not,(f,ends_with,(loop,sx,@id),?))">
        <prop id="total" x="(f,add,1,(prop,total))"/>            
        </when> 
        </when>
      </loop>  
      
     <!-- <ti>total=(prop,total)</ti> -->
     <prop id="perline" x="(f,round,(f,div,(prop,total),(prop,lines)),0,CEILING)"/> 
     <!-- <ti>perline=(prop,perline)</ti> -->   
     
     <prop id="count" x="0"/>  
                      
     <loop 
      id="sx" 
      xml="(file,ask)" 
      xpath="apps/app/jobs/job" 
      missing_strategy="empty">
      <when test="(f,role,(loop,sx,@role))">
      <when test="(f,not,(f,ends_with,(loop,sx,@id),?))">
      
         <prop id="count" x="(f,add,1,(prop,count))"/>
         <when test="(f,gt_num,(prop,count),(prop,perline))">
          <print act="println" id="t1"><![CDATA[</ti>]]></print>
          <print act="println" id="t1"><![CDATA[<ti type="rec"><ti></ti>]]></print>
          <prop id="count" x="1"/>
         </when>
  
         <print act="println" id="t1"><![CDATA[<ti type="call_service" job="do-that-now" explain="(x,(loop,sx,@id))" flag="silent">
            <prop id="from-app">(x,(prop,app))</prop>
            <prop id="from-pro">(x,(prop,pro))</prop>
            <dir id="from-pro">(x,(dir,pro))</dir>
            <prop id="from-job">(x,(loop,sx,@id))</prop>   
         </ti>]]></print>
       
            
        </when> 
        </when>
      </loop>                 
      <print act="println" id="t1"><![CDATA[</ti></steps>]]></print>     
      <print id="t1" act="close"/>
      <!-- <tk type="msg">(f,file_content,(file,t1))</tk> --> 
      <include file="(file,t1)"/>    <!-- ist am 19.3.2019 kontrolliert -->
      <ti_break/>
      <ti_hr/> 
     
</job>



