<jobs>

<job id="File-Again" role="hidden">
  <need>(file,with)</need>
  <ti_hr/>
  <call_service job="tr_fdag"/>
  <ti type="call_service" job="see_file_actions" explain="(prop,_fdag_file_another)">
    <file id="with">(file,with)</file>
  </ti>
</job>

<job id="go-on" role="hidden">
  <need>(dir,with)</need>
  <call_service job="Goto-Panorama"/>  
  <call_service job="see_file_actions"/>
</job>
    
<job id="see_file_actions" joblevel="ws" role="hidden">
<!-- <interpreter act="check-login"/>  -->
  <need>(file,with)</need>
  <ti_break/>
  <call_service job="tr_wfa"/>
  <!-- 
  <when test="(f,guicontroller,choose,file,is-on)">
    <ti label="(f,html,b,o)Coosing file (f,html,b,c)(f,when,(f,guicontroller,choose,file,has-save),to write,):" x="(f,guicontroller,choose,file,label)"/>   
    <ti label=" " x="(f,guicontroller,choose,file,tip)" 
        test="(f,has,(f,guicontroller,choose,file,tip))"/>    
    <ti type="file" label=" " x="(file,with)" flag="choose label_right"
     explain="Keep (f,name_of_file,(file,with))" prefix="[ choose ]"/>
    <ti_hr/>
  </when>         -->
  
  <prop id="fnk" x="(f,lower,(f,name_of_file,(file,with)))"/>            
  <prop id="ispic">(f,or,(f,ends_with,(prop,fnk),.jpg),(f,ends_with,(prop,fnk),.png))</prop>

  <when test="(f,and,(prop,ispic),(f,interpreter,has_priv,opContent))">

    <ti explain="(prop,_wfa_do_fullpic)" type="call_service" job="File-Pic" 
        test="(f,interpreter,has_priv,opContent)">
      <file id="with" x="(file,with)"/>
    </ti>  
    <ti type="img" max_x="600" max_y="200">(file,with)</ti>      
  </when>

  <prop id="src" x="(file,with)"/>

  

  <!-- <ti x="(f,html,b,o)(prop,_wfa_file)(f,html,b,c)"/>  -->
  <ti label="(prop,_wfa_file): (f,name_of_file,(file,with))"/>
  <ti_break class_table="tabNavigator"/>
  <ti type="file" x="(file,with)"/>  

  <ti_break/>

  <ti type="file" x="(file,with)" flag="download blind" test="(f,implement,online)"/>
 
 <!-- <ti x="(f,html,b,o)(prop,_wfa_size)(f,html,b,c)" /> -->
 <ti type="rec" flag="catch">
  <ti flag="block" x="(f,file_info,size,(file,with),kb) kb = (f,file_info,size,(file,with),bytes) bytes"/> 
 </ti>

 <ti type="rec" flag="catch">
  <ti flag="block" x="(f,file_info,last_mod,(file,with),yyyy-MM-dd)" /> 
 </ti>
 
 <ti type="rec" flag="catch">
  <ti flag="block" x="(f,file_info,last_mod,(file,with),HH:mm:ss)"/> 
 </ti>
 

  
 <ti_space height="4px"/> 

    
  <when test="(f,interpreter,has_priv,opFiles)">
    <ti label="(prop,_wfa_fileactions)"/> 
    
    <ti type="rec">
      <ti explain="(prop,_wfa_do_delete)" type="call_service" job="File-Delete" flag="button" class="fx fxSrv fxSrvDel redButton"
          test="(f,interpreter,has_priv,opDelete)">
        <file id="with" x="(file,with)"/>
      </ti> 
      <ti test="(f,not,(f,interpreter,has_priv,opDelete))"></ti>
       <ti test="(f,not,(f,interpreter,has_priv,opCopy))"></ti>
      <ti explain="(f,html,b,o)UTF-8:(f,html,b,c) (prop,_wfa_do_seecont)" type="call_service" job="File-Content-UTF8"   flag="button" class="fx greenButton"
          test="(f,interpreter,has_priv,opContent)">
        <file id="with" x="(file,with)"/>
      </ti>      
      
      <ti explain="(prop,_wfa_do_seecont)" type="call_service" job="File-Content"        flag="button" class="fx   greenButton"
          test="(f,interpreter,has_priv,opContent)">
        <file id="with" x="(file,with)"/>
      </ti>           

    </ti>


  
    <ti type="rec">
      <ti explain="(prop,_wfa_do_copy)" type="call_service" job="File-Copy"          flag="button" class="fx fxSrv fxSrvCopy"
          test="(f,interpreter,has_priv,opCopy)">
        <file id="with" x="(file,with)"/>
      </ti> 
      <ti explain="(f,html,b,o)UTF-8:(f,html,b,c) (prop,_wfa_do_edit)" type="call_service" job="File-Edit"  flag="button" class="fx fxSrv fxSrvEdit yellowButton"
          test="(f,interpreter,has_priv,opUpdate)">
        <file id="with" x="(file,with)"/>
        <prop id="file-edit-encoding">UTF-8</prop>
      </ti>  
      <ti explain="(prop,_wfa_do_edit)" type="call_service" job="File-Edit"  flag="button" class="fx fxSrv fxSrvEdit yellowButton"
          test="(f,interpreter,has_priv,opUpdate)">
        <file id="with" x="(file,with)"/>
      </ti>        
    </ti>
    
    
    <ti type="rec">
      <ti explain="(prop,_wfa_do_rename)" type="call_service" job="File-Rename"     flag="button" class="fx fxSrv fxSrvRename"
          test="(f,interpreter,has_priv,opRename)">
        <file id="with" x="(file,with)"/>
      </ti>     
       <ti test="(f,not,(f,interpreter,has_priv,opRename))"></ti>
      <ti explain="(prop,_wfa_do_seepic)" type="call_service" job="File-Pic"   flag="button" class="fx fxSrv fxSrvPic"
          test="(f,interpreter,has_priv,opContent)">
        <file id="with" x="(file,with)"/>
      </ti>
    </ti>        

    
 
    

        
    <!-- 
    <ti explain="Text Replace" type="call_service" job="File-ReplaceText">
      <file id="with" x="(file,with)"/>
    </ti>  -->
    

    <!-- 
    <ti explain="(f,html,b,o)Csv-2-Xml(f,html,b,c)" type="call_service" job="File-Csv2Xml" 
        test="(f,interpreter,has_priv,opCsv2Xml)">
      <file id="with" x="(file,with)"/>
    </ti>    -->     
    <ti type="rec">
      <ti explain="(prop,_wfa_do_checksum)" type="call_service" job="File-Checksum"     span="2"     flag="button" class="fx fxSrv fxSrvChecksum"
          test="(f,interpreter,has_priv,opContent)">
        <file id="with" x="(file,with)"/>
      </ti>     
    </ti>

    <ti type="rec">
      <ti explain="(prop,_wfa_do_extract)" type="call_service" job="File-Extract"     span="2"     flag="button" class="fx fxSrv fxSrvExtract"
          test="(f,interpreter,has_priv,opUnzip)">
        <file id="with" x="(file,with)"/>
      </ti>        
    
    </ti>
    
    <ti type="rec">
      <ti type="call_service" job="File-Encrypt-Decrypt" explain="(prop,_wfa_do_encrypt)" span="2"   flag="button" class="fx fxSrv fxSrvDecEncrypt"
        test="(f,interpreter,has_priv,opCrypto)">
        <file id="with" x="(file,with)"/>  
      </ti>    
    </ti>    

        

    

      
    <ti type="rec">
      <ti> </ti>
      <ti explain="(prop,_wfa_do_pano)" type="call_service" job="Dir-Panorama"          flag="button" class="fx fxSrv fxSrvPano"
          test="(f,interpreter,has_priv,opInfo)">   
        <dir id="with" x="(f,dir_of_file,(file,with))"/>
      </ti>           
    </ti>
    
    <ti type="rec">
      <ti> </ti>
      <ti explain="(prop,_wfa_do_seeinfos)" type="call_service" job="File-Dir-VFS"                flag="button" class="fx fxSrv fxSrvInfo"
          test="(f,interpreter,has_priv,opInfo)">   
        <prop id="with" x="(file,with)"/>
      </ti>              
    </ti>
        
 
    

  <ti_hr_break/>
  <ti label="(prop,_wfa_completefn):"/>
  <ti type="rec">
  <ti  flag="block wrap" x="(file,with)" />
  </ti>
    
   
    <!-- 
    
      <ti_hr_break/>
  <ti label="(prop,_wdi_complete):"/>
  <ti  flag="block wrap" x="(dir,with)" />
    <when test="(f,interpreter,has_priv,opInfo)">
      <ti label="File-Infos"/>
      <ti label="base" x="(f,vfs,(prop,src),base)" flag="catch"/>  
      <ti label="scheme" x="(f,vfs,(prop,src),scheme)" flag="catch"/>  
      <ti label="type" x="(f,vfs,(prop,src),type)" flag="catch"/>
     
    
      <ti label="extension" x="(f,vfs,(prop,src),extension)" flag="catch"/>
      <ti label="depth" x="(f,vfs,(prop,src),depth)" flag="catch"/>   
      <ti label="uri" x="(f,vfs,(prop,src),uri)" flag="catch"/>   
    
      <ti label="URL &amp; URI"/>
                       
      <ti label="friendly_uri" x="(f,vfs,(prop,src),friendly_uri)" flag="catch"/>   
      <ti label="url" x="(f,vfs,(prop,src),url)" flag="catch"/>  
      <ti label="url_prot" x="(f,vfs,(prop,src),url_prot)" flag="catch"/> 
       
      
    
    
      <ti label="Path"/>
      <ti label="path" x="(f,vfs,(prop,src),path)" flag="catch"/>
      <ti label="path_decoded" x="(f,vfs,(prop,src),path_decoded)" flag="catch"/> 
    
      <ti label="Root"/>
      <ti label="root_path" x="(f,vfs,(prop,src),root_path)" flag="catch"/>  
      <ti label="root_path_decoded" x="(f,vfs,(prop,src),root_path_decoded)" flag="catch"/>
      <ti label="root_base" x="(f,vfs,(prop,src),root_base)" flag="catch"/>
      <ti label="root_uri" x="(f,vfs,(prop,src),root_uri)" flag="catch"/>
           
      <ti label="Bits"/>  
      <ti label="name_is_file" x="(f,vfs,(prop,src),name_is_file)" flag="catch"/>   
      <ti label="exists" x="(f,vfs,(prop,src),exists)" flag="catch"/>  
      <ti label="is_attached" x="(f,vfs,(prop,src),is_attached)" flag="catch"/>
      <ti label="is_content_open" x="(f,vfs,(prop,src),is_content_open)" flag="catch"/>
    
      <ti label="is_executable" x="(f,vfs,(prop,src),is_executable)" flag="catch"/>
      <ti label="is_file" x="(f,vfs,(prop,src),is_file)" flag="catch"/>
      <ti label="is_folder" x="(f,vfs,(prop,src),is_folder)" flag="catch"/>  
      
      <ti label="is_hidden" x="(f,vfs,(prop,src),is_hidden)" flag="catch"/>
      <ti label="is_readable" x="(f,vfs,(prop,src),is_readable)" flag="catch"/>
      <ti label="is_writable" x="(f,vfs,(prop,src),is_writable)" flag="catch"/>   
    </when>
    -->
  
  </when>  
    

  <!-- 
  <ti label="Real-file infos"/>     
  <ti label="file_uri" x="(f,vfs,(prop,src),file_uri)" flag="catch"/>
  <ti label="file_url" x="(f,vfs,(prop,src),file_url)" flag="catch"/>
  
  <when test="(f,guicontroller,may,operate-file,)">
    <ti label="Actions"/> 
    <ti label="See file-content" type="call_service" job="see_file_content">
      <file id="with" x="(file,with)"/>
    </ti>  
    
    <ti label="Copy File" type="call_service" job="Panorama-File-Activity-COPY">
      <file id="with" x="(file,with)"/>
    </ti>    
    
     <ti label="Treat File as Directory" type="call_service" job="Panorama-File-Activity-TREAT"><file id="with" x="(file,with)"/></ti> 
     <ti label="Rename File" type="call_service" job="Panorama-File-Activity-RENAME"><file id="with" x="(file,with)"/></ti>
     <ti label="Extract a ZIP file" type="call_service" job="Panorama-File-Activity-EXTRACTZIP"><file id="with" x="(file,with)"/></ti>
     <ti label="Calculate Checksums (e:o)md5(e:s) sha1(e:c)" type="call_service" job="Panorama-File-Activity-CHECKSUM"><file id="with" x="(file,with)"/></ti>

  </when>
  -->
                   
  


</job>
 
<job id="File-Csv2Xml" role="hidden" joblevel="ws">
  <need>(file,with)</need>
  
</job>   

<job id="File-Delete" role="hidden" joblevel="ws">
  <need>(file,with)</need>
  <call_service job="tr_fdel"/>
  <!-- <ti type="file" x="(file,with)" label="File to Delete:"/>  -->

  <tk label="(prop,_fdel_acc_l) (f,name_of_file,(file,with)) ?" 
      type="accept" 
      id="quest-delete-1" 
      x="(prop,_fdel_acc_x) &#xA;(f,name_of_file,(file,with))&#xA;&#xA;(file,with)"
      label_accept="(prop,_fdel_acc_ac)"
      label_decline="(prop,_fdel_acc_de)"
      width="300"
      height="150">
    <q id="quest-delete-2" label="(prop,_fdel_acc_q)"/>       
  </tk>

  <choose>  
    <when test="(f,not,(f,and,(prop,quest-delete-1),(prop,quest-delete-2)))">
       <ti type="file" label="(prop,_fdel_del_stop)">(file,with)</ti>
    </when>
    <otherwise>
          <delete file="(file,with)"/>
          <ti type="file" label="(prop,_fdel_del_done)">(file,with)</ti>
          <call_service job="tr_wda"/>
          <ti type="call_service" job="Goto-Panorama" explain="(prop,_wda_del_seepano_parent)" label=" ">
            <dir id="with">(f,dir_of_file,(file,with))</dir>
          </ti>              
    </otherwise>
  </choose>
  <!-- <call_service job="File-Again"/>  -->
</job>

<job id="File-Rename" role="hidden" joblevel="ws">
  <call_service job="tr_fren"/>
  
  <ti type="file" x="(file,with)" label="(prop,_fren_fileto_ren)"/>
  <need>(file,with)</need>
  <prop id="nof">(f,name_of_file,(file,with))</prop>

  <tk id="nof" label="(prop,_fren_new_name)" regex=".+" flag="nono" rule="filename" cols="30"/>

  <file id="new">(f,dir_of_file,(file,with))(prop,nof)</file>
  <tk type="msg">(prop,_fren_goingto)</tk>
  <prop id="t1" x="(f,file_info,last_mod,(file,with),yyyy-MM-dd-HH-mm-ss-SSS)"/>
  <copy file="(file,with)" tofile="(file,new)"/>
  <set_last_mod file="(file,new)" time="(prop,t1)"/>
  <delete file="(file,with)"/>  

  <ti label="(prop,_fren_performed)">
    <ti type="file" id="(prop,_fren_from)" x="(file,with)" />
    <ti type="file" id="(prop,_fren_to)" x="(file,new)" />
  </ti>
  <file id="with">(file,new)</file>
  <call_service job="File-Again"/>
</job>
<!-- 
