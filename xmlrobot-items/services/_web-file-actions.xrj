<job id="File-Pic" joblevel="ws" role="hidden">
  <need>(file,with)</need>
  <call_service job="tr_fsimp"/>
  <ti type="file" x="(file,with)" label="(prop,_fsimp_file_view)"/>
  <ti type="text">(file,with)</ti>
  <ti type="img">(file,with)</ti>
  <call_service job="File-Again"/>
</job>

<job id="File-Content" joblevel="ws" role="hidden">
  <need>(file,with)</need>
  <call_service job="tr_fsimp"/>
  <ti type="file" x="(file,with)" label="(prop,_fsimp_file_view)"/>
  <prop id="encoding" x="UTF-8"/>
  <tk type="text" id="encoding" x="UTF-8" label="(prop,_fsimp_encoding)" flag="nono" cols="10"/>

  <ti_hr/>
                <call_service job="fps">
                  <file id="fps-file">(file,with)</file>   
                  <prop id="fps-regex">\n</prop>
                  <prop id="fps-limit">300000</prop>
                  <prop id="fps-header">1</prop>        
                  <prop id="fps-encode">(prop,encoding)</prop>
                    
                </call_service>
                  
  <call_service job="File-Again"/>
</job>

<job id="File-Content-UTF8" joblevel="ws" role="hidden">
  <need>(file,with)</need>
  <need default="0">(prop,last_size)</need>
  <call_service job="tr_fsimp"/>
  <ti label="(prop,_fsimp_file_view)"/>
  <ti type="file" x="(file,with)" label="File"/>
  <ti label="Time" >(f,time,yyyy-MM-dd HH:mm:ss)</ti>
  <prop id="size">(f,file_info,size,(file,with),bytes)</prop>
  <choose>
    <when test="(f,eq_num,0,(prop,last_size))">
      <ti label="Size" >(prop,size) bytes</ti>
    </when>  
    <when test="(f,eq_num,(prop,size),(prop,last_size))">
      <ti label="Size" >(prop,size) bytes</ti>
    </when>
    <otherwise>
      <ti label="Size" >(prop,size) bytes = +(f,html,b,o)(f,sub,(prop,size),(prop,last_size))(f,html,b,c)</ti>
    </otherwise>
  
  </choose>

  <ti type="call_service" job="File-Content-UTF8" explain="View again" label=" " flag="button">
    <file id="with">(file,with)</file>
    <prop id="last_size">(prop,size)</prop>
  </ti>  
  <ti_hr/>
  <!-- 
  <ti>(f,file_content,(file,with),UTF-8)</ti>      -->
  
                <call_service job="fps">
                  <file id="fps-file">(file,with)</file>   
                  <prop id="fps-regex">\n</prop>
                  <prop id="fps-limit">300000</prop>
                  <prop id="fps-header">1</prop>        
                  <prop id="fps-encode">UTF-8</prop>
                    
                </call_service>
                  
  <ti_hr/>
  <ti type="call_service" job="File-Content-UTF8" explain="View again" flag="button">
    <file id="with">(file,with)</file>
    <prop id="last_size">(prop,size)</prop>
  </ti>
  <call_service job="File-Again"/>
</job>

<job id="File-Checksum" role="hidden" joblevel="ws">
  <need>(file,with)</need>
  <call_service job="tr_fsimp"/>
  <ti type="file" x="(file,with)" label="(prop,_fsimp_file_checksum)"/>
  <ti_break/>
  <ti label="(prop,_fsimp_file_checksum2)">
    <ti label="md5:">(f,file_info,hash,md5,(file,with))</ti>
    <ti label="md2:">(f,file_info,hash,md2,(file,with))</ti>
    <ti label="sha1:">(f,file_info,hash,sha1,(file,with))</ti>
    <ti label="sha256:">(f,file_info,hash,sha256,(file,with))</ti>
    <ti label="sha384:">(f,file_info,hash,sha384,(file,with))</ti>
    <ti label="sha512:">(f,file_info,hash,sha512,(file,with))</ti>
    
  </ti>
  <call_service job="File-Again"/>
  
</job>

<job id="File-Download" role="hidden" joblevel="ws">

  <need>(file,with)</need>
   <call_service job="tr_fsimp"/>
     
  <ti type="file" x="(file,with)" label="(prop,_fsimp_file_down)" flag="download"/>
  <call_service job="File-Again"/>
</job>

                                                            
<job id="File-Copy" role="hidden" joblevel="ws">
  <need>(file,with)</need>
  <call_service job="tr_fcop"/> 
  <ti type="file" x="(file,with)" label="(prop,_fcop_file_copy)"/>

  

  <call_service job="go-joe-read"> 
    <prop id="joe-in-regex">target</prop>
    <file id="joe-in-store">(f,request,dir,session_home_fs)services/op-copy-x-ic.lsx</file>  
  </call_service>
  
  <tk id="where" type="sel" flag="nono" label="(prop,_fcop_targetoc)">
      <sel label="(prop,_fcop_samedir)">same</sel>
      <sel label="(prop,_fcop_likelast) (f,vob,dir,target)" test="(f,has,dir,target)">last</sel>
      <sel label="(prop,_fcop_someelse)">else</sel>
  </tk>
  
  <choose>
    <when test="(f,eq_text,same,(prop,where))">
      <dir id="target" x="(f,dir_of_file,(file,with))" />
    </when>
    <when test="(f,eq_text,last,(prop,where))">
    </when>
    <when test="(f,eq_text,else,(prop,where))">
      <dir id="target" x="(f,dir_of_file,(file,with))" />
      <tk id="target" label="(prop,_fcop_target_dir)" type="dir" flag="nono"/> 
    </when>        
  </choose>
 

  
  <prop id="nof">(f,name_of_file,(file,with))</prop>
  <tk id="nof" label="(prop,_fcop_filename)" type="text" flag="nono" tip="(prop,_fcop_new_filename)"/>
  <file id="new">(dir,target)(prop,nof)</file>
  <tk label="(prop,_fcop_target_copy)" flag="sum_only">    
    <tk id="new" type="file" label="(prop,_fcop_file_write)" flag="nono save"/>
  </tk>
  
  <dir id="target" x="(f,dir_of_file,(file,new))" />
  <call_service job="go-joe-write-srv">
    <prop id="joe-in-regex">target</prop>  
    <file id="joe-in-store">(f,request,dir,session_home_fs)services/op-copy-x-ic.lsx</file>  
  </call_service>

  <when test="(f,file_exists,(file,new))">
    <tk type="msg" msg_type="w">(prop,_fcop_overwrite)
(file,new)</tk>
  </when>

  <prop id="t1" x="(f,file_info,last_mod,(file,with),yyyy-MM-dd-HH-mm-ss-SSS)"/>
  <copy file="(file,with)" tofile="(file,new)"/>
  <set_last_mod file="(file,new)" time="(prop,t1)"/>  


  <ti label="(prop,_fcop_performed)">
    <ti type="file" label="(prop,_fcop_from)" x="(file,with)" />
    <ti type="file" label="(prop,_fcop_to)" x="(file,new)" />
  </ti>
  <call_service job="File-Again"/>
</job>  

<job id="File-Encrypt-Decrypt" role="hidden" joblevel="ws">
  <need>(file,with)</need>
  <tk type="msg" msg_type="w">Make sure that the text in the file is stored in utf-8</tk>
  
  <call_service job="go-joe-read"> 
    <file id="joe-in-store">(f,request,dir,session_home_fs)services/op-enc-dec-file.lsx</file>
    <prop id="joe-in-regex">style</prop>  
  </call_service>
  <tk label="Encrypt-Decrypt File: (f,name_of_file,(file,with))">
    
    <tk type="sel" flag="nono"
        id="style"
        label="Encrypt-or-Decrypt"
        x="encrypt">
        <sel label="Encrypt">encrypt</sel>
        <sel label="Decrypt">decrypt</sel>
    </tk>
          
    <tk id="pw1" label="Pw" flag="nono password" tip="This is the secret key with which the given text is encrypted/decrypted"/>
    <tk id="pw2" label="Pw-Again" flag="nono password" tip="This is the secret key with which the given text is encrypted/decrypted once again"/>
    <tk id="result" type="file" flag="save write nono" label="Result-File" />
    
  </tk>
  
  <call_service job="go-joe-write-srv">
    <prop id="joe-in-regex">style</prop>  
    <file id="joe-in-store">(f,request,dir,session_home_fs)services/op-enc-dec-file.lsx</file> 
  </call_service>  
  
  <throw test="(f,not,(f,eq_text,(prop,pw1),(prop,pw2)))">Passwords differs</throw>
  
  <crypto id="scra" act="open" type="(prop,pw1)"/>
  <crypto id="scra" act="(prop,style)" from="(file,with)" to="(file,result)"/>

  <crypto id="scra" act="close" />
  
  <ti type="file" label="Result">(file,result)</ti>
  <ti label=" ">(f,file_content,(file,result))</ti>
  
  
  <call_service job="File-Again"/>  
    
</job>
  
<job id="File-Extract" role="hidden" joblevel="ws">
  <need>(file,with)</need>
  <call_service job="tr_fextr"/>
  
  <ti type="file" x="(file,with)" label="(prop,_fextr_file_extract)"/>
  <tk id="extract-to-dir" type="dir" x="(f,dir_of_file,(file,with))" label="(prop,_fextr_spec_target)" />
  
  <call_service job="go-joe-read"> 
    <file id="joe-in-store">(f,request,dir,session_home_fs)services/op-unzip-ic.lsx</file>
    <prop id="joe-in-regex">what-target</prop>  
  </call_service>
  
  <tk type="sel" id="what-target" label="(prop,_fextr_fin_targ_dir)" flag="nono" x="here">
    <sel label="(f,name_of_dir,(dir,extract-to-dir))">here</sel>
    <sel label="(f,name_of_dir,(dir,extract-to-dir))(prop,fs)(f,name_of_file2,(file,with))">there</sel>
    <sel label="(f,name_of_dir,(dir,extract-to-dir))(prop,fs)(f,replace,(f,name_of_file,(file,with)),.,-)">over</sel>
 <sel label="(prop,_fextr_someelse)">else</sel>
  </tk>
  
  <call_service job="go-joe-write-srv">
    <prop id="joe-in-regex">what-target</prop>  
    <file id="joe-in-store">(f,request,dir,session_home_fs)services/op-unzip-ic.lsx</file>  
  </call_service>  

  <when test="(f,eq,else,(prop,what-target))">
    
      <call_service job="go-jil-run" flag="silent">
        <prop id="jil-question" x="(prop,_fextr_extr_dest) (f,name_of_file,(file,with))"/>
      </call_service>
      <global act="get" id="jil-result"/>        
      <dir id="extract-to-dir" x="(prop,jil-result)" />

    
  </when>
  <when test="(f,eq,there,(prop,what-target))">
    <dir id="extract-to-dir">(dir,extract-to-dir)(f,name_of_file2,(file,with))</dir>   
  </when>
  
  <when test="(f,eq,over,(prop,what-target))">
    <dir id="extract-to-dir">(dir,extract-to-dir)(f,replace,(f,name_of_file,(file,with)),.,-)</dir>    
  </when>  
  <tk label="(prop,_fextr_confirm)" flag="sum_only">
  <tk id="extract-to-dir" type="dir" flag="nono" label="(prop,_fextr_dir_to_create)"/>
  </tk>
  
  <tk type="msg" 
      x="(prop,_fextr_going_extr) &#xA;(dir,extract-to-dir) (f,when,(f,exists_dir,(dir,extract-to-dir)),&#xA;(prop,_fextr_warn_exists),)"
      msg_type="(f,when,(f,exists_dir,(dir,extract-to-dir)),w,i)"/>
  <mkdir dir="(dir,extract-to-dir)" flag="cascade"/>
  <tp>(prop,_fextr_extracting) (f,name_of_file,(file,with)) (prop,_fextr_to) (dir,extract-to-dir)</tp>

    <mkdir dir="(dir,extract-to-dir)"/>
    <unzip file="(file,with)" todir="(dir,extract-to-dir)"/>


  <ti label="(prop,_fextr_did_extract)">
    <ti type="file" label="(prop,_fextr_from)">(file,with)</ti>
  </ti>
  <ti_break/>
    <ti type="dir" label="(prop,_fextr_to)">(dir,extract-to-dir)</ti>

    <ti type="call_service" job="Goto-Panorama" label=" " explain="(prop,_fextr_see_pano)">
      <dir id="with" x="(dir,extract-to-dir)"/>
    </ti>  

    <call_service job="File-Again"/>
  </job>


