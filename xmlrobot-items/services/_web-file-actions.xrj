<job id="File-Edit" role="hidden" joblevel="ws">
  <need>(file,with)</need>
  <call_service job="tr_fedit"/>
  <ti type="file" x="(file,with)" label="(prop,_fedit_edit)"/>
  <choose>
    <when test="(f,has,prop,file-edit-encoding)">
      <prop id="encoding">(prop,file-edit-encoding)</prop>
    </when>
    <otherwise>
      <tk id="encoding" x="UTF-8" label="(prop,_fedit_encoding)" flag="nono" cols="10"/>
    </otherwise>
  </choose>
  
  <prop id="content" x="(f,file_content,(file,with),(prop,encoding))"/>
  <prop id="content_before" x="(prop,content)"/>
  <tk>
  <tk type="textblock" flag="bigbig" id="content" label="(prop,_fedit_edit_label) (f,name_of_file,(file,with))"/>
  </tk>
  <choose>
  <when test="(f,not,(f,eq_text,(prop,content),(prop,content_before)))">
    <ti_hr/>  
    <ti label="(prop,_fedit_new)(e:s) Len=(f,len,(prop,content))"/>
    <ti>(prop,content)</ti>   
    <ti_hr/>   
    <ti label="(prop,_fedit_before)(e:s) Len=(f,len,(prop,content_before))"/>

    <ti>(prop,content_before)</ti>
    <prop id="delete-pro-2" x="1"/>
    <tk label="(prop,_fedit_sure)" 
    	type="accept" 
    	id="delete-pro-1" 
    	x="(prop,_fedit_sure2)&#xA;(file,with)&#xA;(prop,_fedit_sure3)" 
    	label_accept="(prop,_fedit_overwrite)" 
    	label_decline="(prop,_fedit_forget)" 
    	width="300" height="150">
    	<q id="delete-pro-2" label="(prop,_fedit_iknow)" flag="load"/>
    </tk>
    
    <!-- fail if question not answered properly -->
    <when test="(f,not,(f,and,(prop,delete-pro-1),(prop,delete-pro-2)))">
      <ti>(prop,_fedit_terminated)</ti>
    	<throw>(prop,_fedit_terminated)</throw>
    </when> 
    <create_file out="(file,with)">(prop,content)</create_file>
    <ti type="file" label="(prop,_fedit_created)" x="(file,with)"/>
  </when>
  <otherwise>
    <ti>(prop,_fedit_not_updated)</ti>
  </otherwise>
  </choose>
  <call_service job="File-Again"/>
</job>

<job id="File-Dir-VFS" role="hidden" joblevel="ws">
  <need>(prop,with)</need>
  <call_service job="tr_vfsi"/>
  <ti label="(prop,with)"/>
  <ti_space height="5px" />
  <ti label="(prop,_vfsi_props)"/>
 <ti label="(prop,_vfsi_lastmod)" x="(f,file_info,last_mod,(prop,with),yyyy-MM-dd HH:mm:ss)" flag="catch"/>
 <ti label="(prop,_vfsi_size)" x="(f,file_info,size,(prop,with),kb) kb" flag="catch"/>
 <ti label=" " x="(f,file_info,size,(prop,with),bytes) bytes" flag="catch"/>
 <ti label=" " x="(f,file_info,size,(prop,with),mb) mb" flag="catch"/> 
 <ti label="URL &amp; URI"/>  

  <ti label="uri" x="(f,vfs,(prop,with),uri)" flag="catch"/>                  
  <ti label="friendly_uri" x="(f,vfs,(prop,with),friendly_uri)" flag="catch"/>   
  <ti label="url" x="(f,vfs,(prop,with),url)" flag="catch"/>  
  <ti label="url_prot" x="(f,vfs,(prop,with),url_prot)" flag="catch"/>   


 <ti label="(prop,_vfsi_nameinfos)"/>  

  <ti label="scheme" x="(f,vfs,(prop,with),scheme)" flag="catch"/>  
  <ti label="type" x="(f,vfs,(prop,with),type)" flag="catch"/>
 
  <ti label="base" x="(f,vfs,(prop,with),base)" flag="catch"/>
  <ti label="extension" x="(f,vfs,(prop,with),extension)" flag="catch"/>
  <ti label="depth" x="(f,vfs,(prop,with),depth)" flag="catch"/>   

  <ti label="Path"/>
  <ti label="path" x="(f,vfs,(prop,with),path)" flag="catch"/>
  <ti label="path_decoded" x="(f,vfs,(prop,with),path_decoded)" flag="catch"/> 

  <ti label="Root"/>
  <ti label="root_path" x="(f,vfs,(prop,with),root_path)" flag="catch"/>  
  <ti label="root_path_decoded" x="(f,vfs,(prop,with),root_path_decoded)" flag="catch"/>
  <ti label="root_base" x="(f,vfs,(prop,with),root_base)" flag="catch"/>
  <ti label="root_uri" x="(f,vfs,(prop,with),root_uri)" flag="catch"/>
  
  <ti label="Bits"/>     
 
  <ti label="name_is_file" x="(f,vfs,(prop,with),name_is_file)" flag="catch"/>   
  <ti label="exists" x="(f,vfs,(prop,with),exists)" flag="catch"/>  
  <ti label="is_attached" x="(f,vfs,(prop,with),is_attached)" flag="catch"/>
  <ti label="is_content_open" x="(f,vfs,(prop,with),is_content_open)" flag="catch"/>

  <ti label="is_executable" x="(f,vfs,(prop,with),is_executable)" flag="catch"/>
  <ti label="is_file" x="(f,vfs,(prop,with),is_file)" flag="catch"/>
  <ti label="is_folder" x="(f,vfs,(prop,with),is_folder)" flag="catch"/>  
  
  <ti label="is_hidden" x="(f,vfs,(prop,with),is_hidden)" flag="catch"/>
  <ti label="is_readable" x="(f,vfs,(prop,with),is_readable)" flag="catch"/>
  <ti label="is_writable" x="(f,vfs,(prop,with),is_writable)" flag="catch"/>   
    
  <choose>
    <when test="(f,vfs,(prop,with),name_is_file)">  
      <call_service job="File-Again">
        <file id="with">(prop,with)</file>
      </call_service>
    </when>
    <otherwise>
      <call_service job="Dir-Again">
        <dir id="with">(prop,with)</dir>
      </call_service>
    </otherwise>
  </choose>
  
</job>
 
<job id="fps" role="hidden">
  <need>(file,fps-file)</need>
  <need default="\n">(prop,fps-regex)</need>
  
  <need default="30">(prop,fps-limit)</need> <!-- maximale zeilenanzahl -->
  <prop id="fps-limit2">(f,add,1,(prop,fps-limit))</prop>
  
  <need default="UTF-8">(prop,fps-encode)</need>
  <need default="1">(prop,fps-header)</need>
  
  <prop id="fps-filemax">(f,file_info,len,(file,fps-file))</prop>
  <!-- 
  <choose>
    <when test="(f,has,prop,font)">
    </when>
  <need default="Courier">(prop,fps-face)</need>      -->
  <prop id="fps-intro">&lt;font face=&quot;Courier&quot;&gt;</prop>
  <prop id="fps-extro">&lt;font&gt;</prop>
  

  <!--
  <ti label="fps: ECHT"/>  
  
  <prop id="fps-founds">0</prop>
  <prop id="fps-limit-reached">0</prop>
  
  
  
  <loop id="findings" file="(file,fps-file)" regex="(prop,fps-regex)" 
        encoding="(prop,fps-encode)" limit="(prop,fps-limit2)">
  
    <prop id="fps-founds">(f,add,1,(prop,fps-founds))</prop>
    <ti>founds=(prop,fps-founds) limit2=(prop,fps-limit2)</ti>
    <choose>                               
      <when test="(f,eq_num,(prop,fps-founds),(prop,fps-limit2))">
        <prop id="fps-limit-reached">1</prop>
      </when>
      <otherwise>
         <prop id="fps-start">(f,max,(loop,findings,#start),0)</prop>
         <prop id="fps-end">(f,min,(loop,findings,#end),(prop,fps-filemax))</prop>
         <ti label="(prop,fps-founds):">(loop,findings,$before)</ti>
         
      </otherwise>
    </choose>
    
  </loop>
    
  <ti>fps-limit-reached=(prop,fps-limit-reached) limit2=(prop,fps-limit2) fps-founds=(prop,fps-founds)</ti>  
  -->
 
  <prop id="fps-founds">0</prop>
  <prop id="fps-limit-reached">0</prop>    

  <!-- <ti>rt: (prop,fps-regex)</ti> -->
  <loop_regex act="open" id="findings" file="(file,fps-file)"  
              regex="(prop,fps-regex)" encoding="(prop,fps-encode)" 
              limit="(prop,fps-limit2)" 
              remain_prop_id="fps-remain"/>

  <loop id="while" while="()(f,loop_regex,findings,has_next?)()"> 
  
    <prop id="fps-founds">(f,add,1,(prop,fps-founds))</prop>
    <!-- <ti>founds=(prop,fps-founds) limit2=(prop,fps-limit2)</ti>  -->
    <choose>                               
      <when test="(f,eq_num,(prop,fps-founds),(prop,fps-limit2))">
      
        <prop id="fps-limit-reached">1</prop>
      </when>
      <otherwise>
        <choose>
          <when test="(f,and,(prop,fps-header),(f,eq_num,1,(prop,fps-founds)))">
            <!-- header zeile -->
            <ti flag="html" x="&lt;strong/&gt;(prop,fps-intro)(f,escape,_htmlb,(f,loop_regex,findings,$before)(f,loop_regex,findings))(prop,fps-extro)&lt;/strong&gt;" />       
          </when>
          <otherwise>
            <!-- normale datenzeile -->
            <ti flag="html" x="(prop,fps-intro)(f,escape,_htmlb,(f,loop_regex,findings,$before)(f,loop_regex,findings))(prop,fps-extro)" />
          </otherwise>
        </choose>
        <ti_space height="3px"/>
         
      </otherwise>
    </choose>  
    
  </loop>

  <loop_regex act="close" id="findings"/>  

  <!-- <ti flag="html" x="REMAIN would be: (prop,fps-intro)(f,escape,_htmlb,(prop,fps-remain))(prop,fps-extro)" />   -->
  <when test="(f,not,(prop,fps-limit-reached))">
     <ti flag="html" x="(prop,fps-intro)(f,escape,_htmlb,(prop,fps-remain))(prop,fps-extro)" />
  </when>

  <!--    
  <ti>fps-limit-reached=(prop,fps-limit-reached) limit2=(prop,fps-limit2) fps-founds=(prop,fps-founds)</ti>      
  
    <ti label="fps-TEST-anfang"/>
  
  <ti flag="html" x="(prop,fps-intro)(f,escape,_htmlb,(f,file_content,(file,fps-file),(prop,fps-encode)))(prop,fps-extro)" /> 

  <ti label="fps-TEST-ende"/> 
  -->
  <remove type="prop" id="fps-intro"/>
  <remove type="prop" id="fps-extro"/>
  <remove type="prop" id="fps-filemax"/>
  <remove type="prop" id="fps-limit2"/>
  
  <remove type="prop" id="fps-founds"/>
  <remove type="prop" id="fps-start" flag="catch"/>
  <remove type="prop" id="fps-end" flag="catch"/>  
  
</job>
</jobs>