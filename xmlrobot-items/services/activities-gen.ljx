</job><job id="Add another Operation" joblevel="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_service job="Operation Editor" />
<prop id="activity_key">1</prop>
<when test="(f,not,(f,exists,prop,activities_offset_new_key))">
<prop id="activities_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,activities)" sort="@id" number="@id" xpath="(prop,activities_offset_new_key)activity">
<trace>max key=(loop,max,@id)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="activity_key">(f,add,(loop,max,@id),1)</prop>
</loop>
<i>Generated Key for new Operation: #(prop,activity_key)</i>
<call_service job="To File Operation" />
<ti label="Did add Operation:" x="(f,html,bold,open)(prop,activity_title)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)">
<call_service job="(prop,activities_return_job)" />
</when>
</job><job role="hidden" id="To File Operation">
<need>(prop,activity_key) (prop,isAdd)</need>
<spirit act="open" id="activities_spirit_tc" xml="(file,activities)" flag="nuevo"/>
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,activities_offset),/)">
<prop id="offset2" x="(f,substring,(prop,activities_offset),0,(f,sub,(f,len,(prop,activities_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,activities_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="activities_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;activity id="(prop,activity_key)" /&gt;</inline>
</spirit>
<spirit act="xml_update" how="set_attribute" attribute="dt_add" id="activities_spirit_tc" where="(prop,activities_offset)activity[@id=(f,xpath_string,(prop,activity_key))]" value="(f,time)" />
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" attribute="dt_upd" id="activities_spirit_tc" where="(prop,activities_offset)activity[@id=(f,xpath_string,(prop,activity_key))]" value="(f,time)" />
<spirit act="xml_update" how="set_attribute" id="activities_spirit_tc" where="(prop,activities_offset)activity[@id=(f,xpath_string,(prop,activity_key))]" attribute="title" value="(prop,activity_title)" />
<spirit act="xml_update" how="set_attribute" id="activities_spirit_tc" where="(prop,activities_offset)activity[@id=(f,xpath_string,(prop,activity_key))]" attribute="service_job" value="(prop,activity_service_job)" />
<spirit act="xml_update" how="set_attribute" id="activities_spirit_tc" where="(prop,activities_offset)activity[@id=(f,xpath_string,(prop,activity_key))]" attribute="active" value="(prop,activity_active)" />
<spirit act="xml_update" how="set_attribute" id="activities_spirit_tc" where="(prop,activities_offset)activity[@id=(f,xpath_string,(prop,activity_key))]" attribute="sort" value="(prop,activity_sort)" />
<spirit act="close" flag="save" id="activities_spirit_tc" />
