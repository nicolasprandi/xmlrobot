<?xml version="1.0" encoding="UTF-8"?><job id="namaste-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<prop id="parent-objekttyp">(f,xpath,(file,namastes),hint[@row=(prop,hint_key)],@objekt_typ)</prop>
<file id="pdi-sel-attr">(dir,repo)ot-(prop,parent-objekttyp)-asel-(prop,tip-term-class)-ident.xml</file>
<remove id="parent-objekttyp" type="prop"/>
<call_job job="namaste-editor"/>
<prop id="namaste_key">1</prop>
<when test="(f,not,(f,exists,prop,namastes_offset_new_key))">
<prop id="namastes_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,namastes)" sort="@row" number="@row" xpath="(prop,namastes_offset_new_key)namaste">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="namaste_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_namaste): #(prop,namaste_key)</i>
<call_job job="namaste-write"/>
<ti_break class_table="tabNavigator"/>
<ti type="rec">
<ti align="right" x="+ (prop,_sl_namaste) '(f,tk_sel_translate,(prop,namaste_attributtyp),(file,pdi-sel-attr))'"/>
</ti>
<choose>
<when test="(f,has,prop,post_add_script_namaste)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_namaste)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="hint-see"/>
</otherwise>
</choose>
</job>