<tk label="Randomize CoopIds" id="custset_randomize" x="1" test_first="1" tip="Schaltet die zufaellige vergabe von system-coop-ids ein" type="bool" flag=" nono " />
<tk label="Zeichenanzahl Randomize" id="custset_randomize_len" x="10" test_first="1" regex="\d+" regex_msg="Zahl" type="text" flag=" " />
<tk label="Privilegien" x="Privilegien" test_first="0" type="msg" flag=" " />
<tk label="Product" id="custset_product" x="" test_first="1" tip="Selected Product" type="sel" flag=" nono " xml="(dir,pro)product-selector-gui.xml" />
<tk label="Pin" id="custset_password" x="(f,random_text,4,abcdefghijklmnopqrstuvwxyz)" test_first="1" tip="Password to enter at the beginning" type="text" flag=" " />
<tk label="Final-Date" id="custset_ablaufdatum" x="(f,vob,prop,base_default_final)" test_first="1" tip="in YYYYMMDD 20200301; Der LETZTE Tag an dem die app funktioniert!" regex="()(?&lt;!\d)(?:(?:20\d{2})(?:(?:(?:0[13578]|1[02])31)|(?:(?:0[1,3-9]|1[0-2])(?:29|30)))|(?:(?:20(?:0[48]|[2468][048]|[13579][26]))0229)|(?:20\d{2})(?:(?:0?[1-9])|(?:1[0-2]))(?:0?[1-9]|1\d|2[0-8]))(?!\d)()" regex_msg="Das muss ein Datum im format JJJJMMTT sein." type="text" flag=" " />
<tk label="Encryptor-Jobs" id="custset_encryptor" x="(f,random_text,16,ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!&quot;$%&amp;/(e:o)(e:c)=?*+'#-_.:(e:s);&lt;&gt;|{[]}\)" test_first="1" tip="Das ding mit dem all jobs verschluesselt sind; 16 stellig" regex="................" regex_msg="16 signs" type="text" flag=" " />
<tk label="Encryptor-Xsl" id="custset_encryptor_xsl" x="(f,random_text,16,ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!&quot;$%&amp;/(e:o)(e:c)=?*+'#-_.:(e:s);&lt;&gt;|{[]}\)" test_first="1" tip="Das ding mit dem all xsl verschluesselt sind; 16 stellig" regex="................" regex_msg="17 signs" type="text" flag=" " />
<tk label="Serial-Number" id="custset_serial" x="(f,add,0,(f,sequence,serial))" test_first="1" tip="Fuer das Wasserzeichen" type="text" flag=" " />
<tk label="Product-Configuration" id="custset_prodconf" x="" test_first="0" tip="Liste von Xml-Elementen&#xA;zb:&#xA;&lt;panorama groesserKleiner=&quot;(e:o)x(e:s)&lt;&gt;(e:c)&quot;/&gt;&#xA;&lt;hibiscusJava limit=&quot;12&quot; limit1=&quot;(e:o)x(e:s)23(e:c)&quot;/&gt;&#xA;Das (e:o)x(e:s)...(e:c) zum escapen von xml-entities!" type="textblock" flag="  big bigbig " />
<tk label="Details" x="Details" test_first="0" type="msg" flag=" " />
