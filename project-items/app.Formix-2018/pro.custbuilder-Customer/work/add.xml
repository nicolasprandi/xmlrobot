<?xml version="1.0" encoding="UTF-8"?><job id="custset-add" level="ws" role="hidden">
<sequence id="serial" act="next"/>
<call_job job="tk_base_read"/>
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="custset-editor"/>
<prop id="custset_key">1</prop>
<when test="(f,not,(f,exists,prop,custsets_offset_new_key))">
<prop id="custsets_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,custsets)" sort="@row" number="@row" xpath="(prop,custsets_offset_new_key)custset">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="custset_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Customer: #(prop,custset_key)</i>
<call_job job="custset-write"/>
<ti_break class_table="tabNavigator"/>
<ti type="rec">
<ti align="right" x="+ Customer '(f,text,cut_nice,(prop,custset_name),30)'"/>
</ti>
<choose>
<when test="(f,has,prop,post_add_script_custset)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_custset)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="custset-see-all"/>
</otherwise>
</choose>
</job>