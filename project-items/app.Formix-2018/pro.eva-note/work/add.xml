<?xml version="1.0" encoding="UTF-8"?><job id="note-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="note-editor"/>
<prop id="note_key">1</prop>
<when test="(f,not,(f,exists,prop,notes_offset_new_key))">
<prop id="notes_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,notes)" sort="@row" number="@row" xpath="(prop,notes_offset_new_key)note">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="note_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Note: #(prop,note_key)</i>
<call_job job="note-write"/>
<ti align="right" x="Did add Note '(f,tk_sel_translate,(prop,note_aspect),(dir,pro)aspect-selector-gui.xml)'"/>
<choose>
<when test="(f,has,prop,post_add_script_note)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_note)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="note-see-all"/>
</otherwise>
</choose>
</job>
