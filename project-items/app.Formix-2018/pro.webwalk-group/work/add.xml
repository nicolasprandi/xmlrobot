<?xml version="1.0" encoding="UTF-8"?><job id="group-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="group-editor"/>
<prop id="group_key">1</prop>
<when test="(f,not,(f,exists,prop,groups_offset_new_key))">
<prop id="groups_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,groups)" sort="@row" number="@row" xpath="(prop,groups_offset_new_key)group">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="group_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Group: #(prop,group_key)</i>
<call_job job="group-write"/>
<ti_break class_table="tabNavigator"/>
<ti type="rec">
<ti align="right" x="+ Group '(prop,group_titel)'"/>
</ti>
<choose>
<when test="(f,has,prop,post_add_script_group)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_group)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="group-see-all"/>
</otherwise>
</choose>
</job>
