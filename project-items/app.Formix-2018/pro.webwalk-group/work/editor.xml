<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="group-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="group_default_label_class" x="+ Group"/>
<prop id="group_default_label_name" x="(f,when,(f,has,(prop,groups_offset_label)), | (prop,groups_offset_label),)"/>
<prop id="groups_tk_control" x=""/>
</when>
<otherwise>
<need>(prop,group_key)</need>
<prop id="group_default_label_class" x="Group"/>
<prop id="group_default_label_name" x="(prop,group_titel)(f,when,(f,has,(prop,groups_offset_label)), - (prop,groups_offset_label),)"/>
<prop id="groups_tk_control" x=""/>
</otherwise>
</choose>
<call_job job="group-tk"/>
</job>
