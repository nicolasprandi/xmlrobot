<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+/- Group '(prop,group_titel)'" />
</ti>
<call_job job="group-see-all" />
</job><job role="hidden" id="group-del">
<need>(prop,group_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="group-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Group [ (prop,group_titel) (prop,groups_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,groups)" where="(prop,groups_offset)group[@row='(prop,group_key)']" />
<tp>Deleted (prop,group_titel) #(prop,group_key)</tp>
<ti label="- Group:" x="(f,html,bold,open)(f,html,bold,open)(prop,group_titel)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="group-see-all" />
</job><job role="hidden" id="group-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="group_default_label_class" x="+ Group" />
<prop id="group_default_label_name" x="(f,when,(f,has,(prop,groups_offset_label)), | (prop,groups_offset_label),)" />
<prop id="groups_tk_control" x="" />
</when>
<otherwise>
<need>(prop,group_key)</need>
<prop id="group_default_label_class" x="Group" />
<prop id="group_default_label_name" x="(prop,group_titel)(f,when,(f,has,(prop,groups_offset_label)), - (prop,groups_offset_label),)" />
<prop id="groups_tk_control" x="" />
</otherwise>
</choose>
<call_job job="group-tk" />
</job><job id="group-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="group-editor" />
<prop id="group_key">1</prop>
<when test="(f,not,(f,exists,prop,groups_offset_new_key))">
<prop id="groups_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,groups)" sort="@row" number="@row" xpath="(prop,groups_offset_new_key)group">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="group_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Group: #(prop,group_key)</i>
<call_job job="group-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ Group '(prop,group_titel)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_group)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_group)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="group-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="group-write">
<need>(prop,group_key) (prop,isAdd)</need>
<need default="./">(prop,groups_offset)</need>
<spirit act="open" id="groups_spirit_tc" xml="(file,groups)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,groups_offset),/)">
<prop id="offset2" x="(f,substring,(prop,groups_offset),0,(f,sub,(f,len,(prop,groups_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,groups_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="groups_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;group row="(prop,group_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="groups_spirit_tc" where="(prop,groups_offset)group[@row='(prop,group_key)']" attribute="titel" value="(f,vob,prop,group_titel)" />
<spirit act="close" flag="save pretty" id="groups_spirit_tc" />
</job></jobs>
