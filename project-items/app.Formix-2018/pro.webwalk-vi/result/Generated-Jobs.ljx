            <prop id="vi_key">(prop,vi_key)</prop>
            <file id="vis">(file,vis)</file>
            <prop id="vis_offset">(prop,vis_offset)</prop>
            <prop id="vis_offset_label">(prop,vis_offset_label)</prop>
            <prop id="vis_offset_new_key">(prop,vis_offset_new_key)</prop>
            <prop id="vis_sort_attribute">(prop,vis_sort_attribute)</prop>
            <prop id="vis_sort_number">(prop,vis_sort_number)</prop>
            <prop id="vis_sort_ignore_case">(prop,vis_sort_ignore_case)</prop>
            <prop id="vis_sort_desc">(prop,vis_sort_desc)</prop>
            <prop id="vis_where">(prop,vis_where)</prop>
            <prop id="vis_return_job">(prop,vis_return_job)</prop>
        </ti>
    </ti>
    <ti_break class_table="tabNavigator" />
    <choose>
        <when test="(f,has_flag,(prop,vis_tk_control),print_all_fields)">
            <ti type="rec" label=" ">
                <ti type="call_job" explain="(prop,_x_go_up_sys2)" align="right" class="justback2" flag="button" job="vi-see">
                    <prop id="vi_key">(prop,vi_key)</prop>
                    <file id="vis">(file,vis)</file>
                    <prop id="vis_offset">(prop,vis_offset)</prop>
                    <prop id="vis_offset_label">(prop,vis_offset_label)</prop>
                    <prop id="vis_offset_new_key">(prop,vis_offset_new_key)</prop>
                    <prop id="vis_sort_attribute">(prop,vis_sort_attribute)</prop>
                    <prop id="vis_sort_number">(prop,vis_sort_number)</prop>
                    <prop id="vis_sort_ignore_case">(prop,vis_sort_ignore_case)</prop>
                    <prop id="vis_sort_desc">(prop,vis_sort_desc)</prop>
                    <prop id="vis_where">(prop,vis_where)</prop>
                    <prop id="vis_return_job">(prop,vis_return_job)</prop>
                </ti>
            </ti>
        </when>
        <otherwise>
            <ti type="rec" label=" ">
                <ti type="call_job" explain="(prop,_x_go_up_sys)" align="right" class="justup" flag="button" job="vi-see-all">
                    <file id="vis">(file,vis)</file>
                    <prop id="vis_offset">(prop,vis_offset)</prop>
                    <prop id="vis_offset_label">(prop,vis_offset_label)</prop>
                    <prop id="vis_offset_new_key">(prop,vis_offset_new_key)</prop>
                    <prop id="vis_sort_attribute">(prop,vis_sort_attribute)</prop>
                    <prop id="vis_sort_number">(prop,vis_sort_number)</prop>
                    <prop id="vis_sort_ignore_case">(prop,vis_sort_ignore_case)</prop>
                    <prop id="vis_sort_desc">(prop,vis_sort_desc)</prop>
                    <prop id="vis_where">(prop,vis_where)</prop>
                    <prop id="vis_return_job">(prop,vis_return_job)</prop>
                </ti>
            </ti>
        </otherwise>
    </choose>
    <ti_break />
</job><job role="hidden" id="vi-edit">
    <need>(prop,vi_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="vi-read" />
    <prop id="isAdd">0</prop>
    <call_job job="vi-editor" />
    <call_job job="vi-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+/- Virtual Identity '(f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50)'" />
    </ti>
    <call_job job="vi-see" />
</job><job role="hidden" id="vi-del">
    <need>(prop,vi_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="vi-read" />
    <tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Virtual Identity [ (f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50) (prop,vis_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
        <q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
    </tk>
    <choose>
        <when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
            <xml_update how="remove" what="(file,vis)" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" />
            <tp>Deleted (f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50) #(prop,vi_key)</tp>
            <ti label="- Virtual Identity:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50)(f,html,bold,close)(f,html,bold,close)" />
            <ti_hr />
            <when test="(prop,do_return_job)" />
        </when>
        <otherwise>
            <tp>No delete performed.</tp>
            <ti>No delete performed.</ti>
        </otherwise>
    </choose>
    <call_job job="vi-see-all" />
</job><job role="hidden" id="vi-editor">
    <need>(prop,isAdd)</need>
    <choose>
        <when test="(prop,isAdd)">
            <prop id="vi_default_label_class" x="+ Virtual Identity" />
            <prop id="vi_default_label_name" x="(f,when,(f,has,(prop,vis_offset_label)), | (prop,vis_offset_label),)" />
            <prop id="vis_tk_control" x="sum" />
        </when>
        <otherwise>
            <need>(prop,vi_key)</need>
            <prop id="vi_default_label_class" x="Virtual Identity" />
            <prop id="vi_default_label_name" x="(f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50)(f,when,(f,has,(prop,vis_offset_label)), - (prop,vis_offset_label),)" />
            <prop id="vis_tk_control" x="sum_only" />
        </otherwise>
    </choose>
    <call_job job="vi-tk" />
</job><job id="vi-add" level="ws" role="hidden">
    x
    <prop id="isAdd">1</prop>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="vi-editor" />
    <prop id="vi_key">1</prop>
    <when test="(f,not,(f,exists,prop,vis_offset_new_key))">
        <prop id="vis_offset_new_key">//</prop>
    </when>
    <loop id="max" limit="1" flag="back" xml="(file,vis)" sort="@row" number="@row" xpath="(prop,vis_offset_new_key)vi">
        <trace>max key=(loop,max,@row)</trace>
        <trace>i=(loop,max,#i)</trace>
        <prop id="vi_key">(f,add,(loop,max,@row),1)</prop>
    </loop>
    <i>Generated Key for new Virtual Identity: #(prop,vi_key)</i>
    <call_job job="vi-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+ Virtual Identity '(f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50)'" />
    </ti>
    <choose>
        <when test="(f,has,prop,post_add_script_vi)">
            <file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
            <prop id="formix-posting-code" x="(f,random_text,16)" />
            <create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_vi)</create_file>
            <include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
            <delete file="(file,formix-posting)" />
            <remove type="file" id="formix-posting" />
            <remove type="prop" id="formix-posting-code" />
        </when>
        <otherwise>
            <call_job job="vi-see-after-insert" />
        </otherwise>
    </choose>
</job><job role="hidden" id="vi-write">
    <need>(prop,vi_key) (prop,isAdd)</need>
    <need default="./">(prop,vis_offset)</need>
    <spirit act="open" id="vis_spirit_tc" xml="(file,vis)" />
    <when test="(prop,isAdd)">
        <choose>
            <when test="(f,ends_with,(prop,vis_offset),/)">
                <prop id="offset2" x="(f,substring,(prop,vis_offset),0,(f,sub,(f,len,(prop,vis_offset)),1))" />
            </when>
            <otherwise>
                <prop id="offset2" x="(prop,vis_offset)" />
            </otherwise>
        </choose>
        <spirit act="xml_update" how="insert_in" id="vis_spirit_tc" where="(prop,offset2)">
            <inline attribute="with">&lt;vi row="(prop,vi_key)" /&gt;</inline>
        </spirit>
        <i>Added a new record</i>
    </when>
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="firstname" value="(f,vob,prop,vi_firstname)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="lastname" value="(f,vob,prop,vi_lastname)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="area" value="(f,vob,prop,vi_area)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="phone" value="(f,vob,prop,vi_phone)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="email" value="(f,vob,prop,vi_email)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="street" value="(f,vob,prop,vi_street)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="house" value="(f,vob,prop,vi_house)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="door" value="(f,vob,prop,vi_door)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="zip" value="(f,vob,prop,vi_zip)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="tit1" value="(f,vob,prop,vi_tit1)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="vis_spirit_tc" where="(prop,vis_offset)vi[@row='(prop,vi_key)']" attribute="tit2" value="(f,vob,prop,vi_tit2)" />
    <spirit act="close" flag="save pretty" id="vis_spirit_tc" />
</job></jobs>
