            </otherwise>
        </choose>
    </when>
    <tk label="(f,when,(f,has_flag,(prop,vis_tk_control),print_only),,(prop,vi_default_label_class)(f,when,(f,has,prop,vi_default_label_name), (prop,vi_default_label_name),))" flag="(prop,vis_tk_control) wrap ">
