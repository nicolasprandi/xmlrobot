<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="vi-del">
    <need>(prop,vi_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="vi-read"/>
    <tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Virtual Identity [ (f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50) (prop,vis_offset_label)] ?" x="Do you really want to delete that?&#10;()If you are not sure, make a backup of the ()project.">
        <q id="delete-it-2" label="()Yes, I know that the record will be gone forever()"/>
    </tk>
    <choose>
        <when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
            <xml_update how="remove" what="(file,vis)" where="(prop,vis_offset)vi[@row='(prop,vi_key)']"/>
            <tp>Deleted (f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50) #(prop,vi_key)</tp>
            <ti label="- Virtual Identity:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50)(f,html,bold,close)(f,html,bold,close)"/>
            <ti_hr/>
            <when test="(prop,do_return_job)"/>
        </when>
        <otherwise>
            <tp>No delete performed.</tp>
            <ti>No delete performed.</ti>
        </otherwise>
    </choose>
    <call_job job="vi-see-all"/>
</job>
