<?xml version="1.0" encoding="UTF-8"?><prolog>
    <!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
    <file id="vis">(dir,pro)vis.xml</file>
    <when test="(f,not,(f,exists_file,(file,vis)))">
        <create_file out="(file,vis)">&lt;vis/&gt;</create_file>
        <i>Created: (file,vis)</i>
    </when>
    <prop id="vis_offset">./</prop>
    <prop id="vis_offset_label"/>
    <prop id="vis_offset_new_key">//</prop>
    <prop id="vis_sort_attribute"/>
    <prop id="vis_sort_number"/>
    <prop id="vis_sort_ignore_case"/>
    <prop id="vis_sort_desc"/>
    <prop id="vis_where"/>
    <prop id="vis_return_job">vi-see-all</prop>
</prolog>
