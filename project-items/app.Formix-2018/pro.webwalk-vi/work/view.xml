<?xml version="1.0" encoding="UTF-8"?><job id="vi-see-all" level="ws" role="hidden">
    <need default="">(prop,vis_sort_attribute)</need>
    <need default="">(prop,vis_sort_number)</need>
    <need default="">(prop,vis_sort_ignore_case)</need>
    <need default="">(prop,vis_sort_desc)</need>
    <need default="">(prop,vis_where)</need>
    <need default="">(prop,vis_offset_label)</need>
    <need default="./">(prop,vis_offset)</need>
    <need default="">(prop,vis_return_job)</need>
    <need default="//">(prop,vis_offset_new_key)</need>
    <need default="0">(prop,vis_no_header)</need>
    <prop id="nothing">(f,not,(prop,vis_no_header))</prop>
    <loop missing_strategy="empty" id="vi_loop" xml="(file,vis)" xpath="(prop,vis_offset)vi(prop,vis_where)" sort="(prop,vis_sort_attribute)" number="(prop,vis_sort_number)" ignore_case="(prop,vis_sort_ignore_case)" desc="(prop,vis_sort_desc)">
        <when test="(prop,nothing)">
            <when test="(f,gt,(f,len,(prop,vis_offset_label)),0)">
                <ti label="(prop,vis_offset_label)"/>
            </when>
            <prop id="nothing">0</prop>
        </when>
        <ti type="rec">
            <ti flag="" type="call_job" prefix="  " explain="(f,html,bold,open)(f,text,cut_nice,(loop,vi_loop,@firstname),50).(f,text,cut_nice,(loop,vi_loop,@lastname),50)(f,html,bold,close)" job="vi-see">
                <prop id="vi_key">(loop,vi_loop,@row)</prop>
                <file id="vis">(file,vis)</file>
                <prop id="vis_offset">(prop,vis_offset)</prop>
                <prop id="vis_offset_label">(prop,vis_offset_label)</prop>
                <prop id="vis_offset_new_key">(prop,vis_offset_new_key)</prop>
                <prop id="vis_sort_attribute">(prop,vis_sort_attribute)</prop>
                <prop id="vis_sort_number">(prop,vis_sort_number)</prop>
                <prop id="vis_sort_ignore_case">(prop,vis_sort_ignore_case)</prop>
                <prop id="vis_sort_desc">(prop,vis_sort_desc)</prop>
                <prop id="vis_where">(prop,vis_where)</prop>
                <prop id="vis_return_job">(prop,vis_return_job)</prop>
            </ti>
            <ti type="menu">
                <ti isFromAction="1" type="call_job" page="view" flag="button" class="fb fbAction fbActionVirun" explain="Export" job="act_vi_export">
                    <prop id="greetings_from_page">view</prop>
                    <prop id="greetings_from_action">run</prop>
                    <prop page="view" id="vi_key">(loop,vi_loop,@row)</prop>
                    <file id="vis">(file,vis)</file>
                    <prop id="vis_offset">(prop,vis_offset)</prop>
                    <prop id="vis_offset_label">(prop,vis_offset_label)</prop>
                    <prop id="vis_offset_new_key">(prop,vis_offset_new_key)</prop>
                    <prop id="vis_sort_attribute">(prop,vis_sort_attribute)</prop>
                    <prop id="vis_sort_number">(prop,vis_sort_number)</prop>
                    <prop id="vis_sort_ignore_case">(prop,vis_sort_ignore_case)</prop>
                    <prop id="vis_sort_desc">(prop,vis_sort_desc)</prop>
                    <prop id="vis_where">(prop,vis_where)</prop>
                    <prop id="vis_return_job">(prop,vis_return_job)</prop>
                </ti>
                <ti isFromAction="1" type="call_job" page="view" flag="button" class="fb fbAction fbActionViedit" explain="Import" job="act_vi_import">
                    <prop id="greetings_from_page">view</prop>
                    <prop id="greetings_from_action">edit</prop>
                    <prop page="view" id="vi_key">(loop,vi_loop,@row)</prop>
                    <file id="vis">(file,vis)</file>
                    <prop id="vis_offset">(prop,vis_offset)</prop>
                    <prop id="vis_offset_label">(prop,vis_offset_label)</prop>
                    <prop id="vis_offset_new_key">(prop,vis_offset_new_key)</prop>
                    <prop id="vis_sort_attribute">(prop,vis_sort_attribute)</prop>
                    <prop id="vis_sort_number">(prop,vis_sort_number)</prop>
                    <prop id="vis_sort_ignore_case">(prop,vis_sort_ignore_case)</prop>
                    <prop id="vis_sort_desc">(prop,vis_sort_desc)</prop>
                    <prop id="vis_where">(prop,vis_where)</prop>
                    <prop id="vis_return_job">(prop,vis_return_job)</prop>
                </ti>
            </ti>
        </ti>
    </loop>
    <when test="(prop,nothing)">
        <ti type="rec">
            <ti flag="wrap_word">No Virtual Identities found</ti>
        </ti>
    </when>
    <when test="(f,not,(f,contains,(prop,vis_offset),node(e:o)(e:c)))">
        <ti type="rec" label=" ">
            <ti type="menu" span="10">
                <ti label=" " type="call_job" explain_nix="vi-add" flag="xbutton " class="fb fbAdd fbAddVi" explain="  + Vi  " job="vi-add">
                    <file id="vis">(file,vis)</file>
                    <prop id="vis_offset">(prop,vis_offset)</prop>
                    <prop id="vis_offset_label">(prop,vis_offset_label)</prop>
                    <prop id="vis_offset_new_key">(prop,vis_offset_new_key)</prop>
                    <prop id="vis_sort_attribute">(prop,vis_sort_attribute)</prop>
                    <prop id="vis_sort_number">(prop,vis_sort_number)</prop>
                    <prop id="vis_sort_ignore_case">(prop,vis_sort_ignore_case)</prop>
                    <prop id="vis_sort_desc">(prop,vis_sort_desc)</prop>
                    <prop id="vis_where">(prop,vis_where)</prop>
                    <prop id="vis_return_job">(prop,vis_return_job)</prop>
                </ti>
                <ti test="(f,not,(prop,nothing))" label=" " type="call_job" flag="button" class="fb fbOrg fbOrgVi" explain="Sort &amp; Delete" job="do-org-me">
                    <file id="orga">(file,vis)</file>
                    <prop id="orga_where">(prop,vis_where)</prop>
                    <prop id="orga_view_loop_id">vi_loop</prop>
                    <prop id="orga_finished_job">vi-see-all</prop>
                    <prop id="orga_offset">(prop,vis_offset)</prop>
                    <prop id="orga_offset_label">(prop,vis_offset_label)</prop>
                    <prop id="orga_offset_new_key">(prop,vis_offset_new_key)</prop>
                    <prop id="orga_segment_plural">vis</prop>
                    <prop id="orga_segment_singular">vi</prop>
                    <prop id="orga_segment_plural_label">Virtual Identities</prop>
                    <prop id="orga_segment_singular_label">Virtual Identity</prop>
                    <prop id="orga_sort_attribute">(prop,vis_sort_attribute)</prop>
                    <prop id="orga_sort_number">(prop,vis_sort_number)</prop>
                    <prop id="orga_where">(prop,vis_where)</prop>
                    <prop id="orga_name_expression_loop">()(f,text,cut_nice,(loop,vi_loop,@firstname),50).(f,text,cut_nice,(loop,vi_loop,@lastname),50)()</prop>
                    <prop id="orga_desc_expression_loop">()()</prop>
                </ti>
            </ti>
        </ti>
    </when>
    <when test="(f,has_flag,debug trace all,(f,interpreter,level))">
        <ti_hr/>
        <ti label="Debug Information">
            <ti label="File:" type="file">(file,vis)</ti>
            <ti label="Xml-Offset:" test="(f,gt_num,(f,len,(prop,vis_offset)),0)">(prop,vis_offset)</ti>
        </ti>
    </when>
</job>
