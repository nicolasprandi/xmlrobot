<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="vi-editor">
    <need>(prop,isAdd)</need>
    <choose>
        <when test="(prop,isAdd)">
            <prop id="vi_default_label_class" x="+ Virtual Identity"/>
            <prop id="vi_default_label_name" x="(f,when,(f,has,(prop,vis_offset_label)), | (prop,vis_offset_label),)"/>
            <prop id="vis_tk_control" x="sum"/>
        </when>
        <otherwise>
            <need>(prop,vi_key)</need>
            <prop id="vi_default_label_class" x="Virtual Identity"/>
            <prop id="vi_default_label_name" x="(f,text,cut_nice,(prop,vi_firstname),50).(f,text,cut_nice,(prop,vi_lastname),50)(f,when,(f,has,(prop,vis_offset_label)), - (prop,vis_offset_label),)"/>
            <prop id="vis_tk_control" x="sum_only"/>
        </otherwise>
    </choose>
    <call_job job="vi-tk"/>
</job>
