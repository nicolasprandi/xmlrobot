<?xml version="1.0" encoding="UTF-8"?><job id="taste-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="taste-editor"/>
<prop id="taste_key">1</prop>
<when test="(f,not,(f,exists,prop,tastes_offset_new_key))">
<prop id="tastes_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,tastes)" sort="@row" number="@row" xpath="(prop,tastes_offset_new_key)taste">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="taste_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Verkostung: #(prop,taste_key)</i>
<call_job job="taste-write"/>
<ti align="right" x="Did add Verkostung '(f,tk_sel_translate,(prop,taste_was),(dir,pro)plate-selector-gui.xml)'"/>
<choose>
<when test="(f,has,prop,post_add_script_taste)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_taste)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="taste-see-all"/>
</otherwise>
</choose>
</job>
