<need>(prop,taste_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="taste-read" />
<prop id="isAdd">0</prop>
<call_job job="taste-editor" />
<call_job job="taste-write" />
<ti align="right" x="Did update Verkostung '(f,tk_sel_translate,(prop,taste_was),(dir,pro)plate-selector-gui.xml)'" />
<call_job job="taste-see" />
</job><job role="hidden" id="taste-del">
<need>(prop,taste_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="taste-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Verkostung [ (f,tk_sel_translate,(prop,taste_was),(dir,pro)plate-selector-gui.xml) (prop,tastes_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,tastes)" where="(prop,tastes_offset)taste[@row='(prop,taste_key)']" />
<tp>Deleted (f,tk_sel_translate,(prop,taste_was),(dir,pro)plate-selector-gui.xml) #(prop,taste_key)</tp>
<ti label="Did delete Verkostung:" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,taste_was),(dir,pro)plate-selector-gui.xml)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="taste-see-all" />
</job><job role="hidden" id="taste-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Verkostung(prop,tastes_offset_label)" />
<prop x="sum" id="tastes_tk_control" />
</when>
<otherwise>
<need>(prop,taste_key)</need>
<prop id="label" x="Verkostung [(f,tk_sel_translate,(prop,taste_was),(dir,pro)plate-selector-gui.xml)](prop,tastes_offset_label)" />
<prop x="sum_only" id="tastes_tk_control" />
</otherwise>
</choose>
<call_job job="taste-tk" />
</job><job id="taste-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="taste-editor" />
<prop id="taste_key">1</prop>
<when test="(f,not,(f,exists,prop,tastes_offset_new_key))">
<prop id="tastes_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,tastes)" sort="@row" number="@row" xpath="(prop,tastes_offset_new_key)taste">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="taste_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Verkostung: #(prop,taste_key)</i>
<call_job job="taste-write" />
<ti align="right" x="Did add Verkostung '(f,tk_sel_translate,(prop,taste_was),(dir,pro)plate-selector-gui.xml)'" />
<choose>
<when test="(f,has,prop,post_add_script_taste)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_taste)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="taste-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="taste-write">
<need>(prop,taste_key) (prop,isAdd)</need>
<spirit act="open" id="tastes_spirit_tc" xml="(file,tastes)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,tastes_offset),/)">
<prop id="offset2" x="(f,substring,(prop,tastes_offset),0,(f,sub,(f,len,(prop,tastes_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,tastes_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="tastes_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;taste row="(prop,taste_key)" /&gt;</inline>
</spirit>
