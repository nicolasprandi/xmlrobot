<ti align="right" x="Did update Vorgang '(f,text,cut_nice,(f,tk_sel_translate,(prop,ephase_zut_key),(file,akt-zutatenliste-komponente)),30).(f,text,cut_nice,(prop,ephase_besch),40)'" />
<call_job job="show-komponte" />
</job><job role="hidden" id="ephase-del">
<need>(prop,ephase_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="ephase-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Vorgang [ (f,text,cut_nice,(f,tk_sel_translate,(prop,ephase_zut_key),(file,akt-zutatenliste-komponente)),30).(f,text,cut_nice,(prop,ephase_besch),40) (prop,ephasen_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,ephasen)" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" />
<tp>Deleted (f,text,cut_nice,(f,tk_sel_translate,(prop,ephase_zut_key),(file,akt-zutatenliste-komponente)),30).(f,text,cut_nice,(prop,ephase_besch),40) #(prop,ephase_key)</tp>
<ti label="Did delete Vorgang:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(f,tk_sel_translate,(prop,ephase_zut_key),(file,akt-zutatenliste-komponente)),30).(f,text,cut_nice,(prop,ephase_besch),40)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="show-komponte" />
</job><job role="hidden" id="ephase-editor">
<try_catch>
<try>
<call_job job="hook-ephase-editor-begin" />
</try>
<catch>
<ti label="Hook must be implemented: ephase-editor: begin.0">
<ti> hook_job=hook-ephase-editor-begin hook=begin page=editor station=0 object=ephase</ti>
</ti>
<tk type="msg" x="You have to implement the hook!" />
<throw_again />
</catch>
</try_catch>
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Vorgang(prop,ephasen_offset_label)" />
<prop x="sum" id="ephasen_tk_control" />
</when>
<otherwise>
<need>(prop,ephase_key)</need>
<prop id="label" x="Vorgang [(f,text,cut_nice,(f,tk_sel_translate,(prop,ephase_zut_key),(file,akt-zutatenliste-komponente)),30).(f,text,cut_nice,(prop,ephase_besch),40)](prop,ephasen_offset_label)" />
<prop x="sum_only" id="ephasen_tk_control" />
</otherwise>
</choose>
<call_job job="ephase-tk" />
</job><job id="ephase-add" level="ws" role="hidden">
<try_catch>
<try>
<call_job job="hook-ephase-add-begin" />
</try>
<catch>
<ti label="Hook must be implemented: ephase-add: begin.0">
<ti> hook_job=hook-ephase-add-begin hook=begin page=add station=0 object=ephase</ti>
</ti>
<tk type="msg" x="You have to implement the hook!" />
<throw_again />
</catch>
</try_catch>
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="ephase-editor" />
<prop id="ephase_key">1</prop>
<when test="(f,not,(f,exists,prop,ephasen_offset_new_key))">
<prop id="ephasen_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,ephasen)" sort="@row" number="@row" xpath="(prop,ephasen_offset_new_key)ephase">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="ephase_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Vorgang: #(prop,ephase_key)</i>
<call_job job="ephase-write" />
<ti align="right" x="Did add Vorgang '(f,text,cut_nice,(f,tk_sel_translate,(prop,ephase_zut_key),(file,akt-zutatenliste-komponente)),30).(f,text,cut_nice,(prop,ephase_besch),40)'" />
<choose>
<when test="(f,has,prop,post_add_script_ephase)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_ephase)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="show-komponte" />
</otherwise>
</choose>
<try_catch>
<try>
<call_job job="hook-ephase-add-end" />
</try>
<catch>
<ti label="Hook must be implemented: ephase-add: end.0">
<ti> hook_job=hook-ephase-add-end hook=end page=add station=0 object=ephase</ti>
</ti>
<tk type="msg" x="You have to implement the hook!" />
<throw_again />
</catch>
</try_catch>
</job><job role="hidden" id="ephase-write">
<need>(prop,ephase_key) (prop,isAdd)</need>
<spirit act="open" id="ephasen_spirit_tc" xml="(file,ephasen)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,ephasen_offset),/)">
<prop id="offset2" x="(f,substring,(prop,ephasen_offset),0,(f,sub,(f,len,(prop,ephasen_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,ephasen_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="ephasen_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;ephase row="(prop,ephase_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="zut_key" value="(f,vob,prop,ephase_zut_key)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="besch" value="(f,vob,prop,ephase_besch)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="details" value="(f,vob,prop,ephase_details)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="phase" value="(f,vob,prop,ephase_phase)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="zeitangaben" value="(f,vob,prop,ephase_zeitangaben)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="kostenangaben" value="(f,vob,prop,ephase_kostenangaben)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="notiz" value="(f,vob,prop,ephase_notiz)" />
<when test="(f,exists,file,ephase_logo)">
<file id="jack-in" x="(file,ephase_logo)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="logo" value="(prop,jack-result)" />
</when>
<when test="(f,exists,prop,ephase_logo_max_x)">
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="logo_max_x" value="(f,vob,prop,ephase_logo_max_x)" />
</when>
<when test="(f,exists,prop,ephase_logo_max_y)">
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="logo_max_y" value="(f,vob,prop,ephase_logo_max_y)" />
</when>
<when test="(f,exists,prop,ephase_logo_max_x_main)">
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="logo_max_x_main" value="(f,vob,prop,ephase_logo_max_x_main)" />
</when>
<when test="(f,exists,prop,ephase_logo_max_y_main)">
<spirit act="xml_update" how="set_attribute" flag="remove" id="ephasen_spirit_tc" where="(prop,ephasen_offset)ephase[@row='(prop,ephase_key)']" attribute="logo_max_y_main" value="(f,vob,prop,ephase_logo_max_y_main)" />
</when>
<spirit act="close" flag="save pretty" id="ephasen_spirit_tc" />
</job></jobs>
