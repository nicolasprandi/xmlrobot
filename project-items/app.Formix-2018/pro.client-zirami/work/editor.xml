<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="zirami-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Zirami(prop,ziramis_offset_label)"/>
<prop x="sum" id="ziramis_tk_control"/>
</when>
<otherwise>
<need>(prop,zirami_key)</need>
<prop id="label" x="Zirami [(prop,zirami_bez)](prop,ziramis_offset_label)"/>
<prop x="sum_only" id="ziramis_tk_control"/>
</otherwise>
</choose>
<call_job job="zirami-tk"/>
</job>
