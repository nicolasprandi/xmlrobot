<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="zirami-del">
<need>(prop,zirami_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="zirami-read"/>
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Zirami [ (prop,zirami_bez) (prop,ziramis_offset_label)] ?" x="Do you really want to delete that?&#10;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()"/>
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,ziramis)" where="(prop,ziramis_offset)zirami[@row='(prop,zirami_key)']"/>
<tp>Deleted (prop,zirami_bez) #(prop,zirami_key)</tp>
<ti label="Did delete Zirami:" x="(f,html,bold,open)(f,html,bold,open)(prop,zirami_bez)(f,html,bold,close)(f,html,bold,close)"/>
<ti_hr/>
<when test="(prop,do_return_job)"/>
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="zirami-see-all"/>
</job>
