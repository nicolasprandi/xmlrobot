<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="ziramis">(dir,pro)ziramis.xml</file>
<when test="(f,not,(f,exists_file,(file,ziramis)))">
<create_file out="(file,ziramis)">&lt;ziramis/&gt;</create_file>
<i>Created: (file,ziramis)</i>
</when>
<prop id="ziramis_offset">./</prop>
<prop id="ziramis_offset_label"/>
<prop id="ziramis_offset_new_key">//</prop>
<prop id="ziramis_sort_attribute"/>
<prop id="ziramis_sort_number"/>
<prop id="ziramis_sort_ignore_case"/>
<prop id="ziramis_sort_desc"/>
<prop id="ziramis_where"/>
<prop id="ziramis_return_job">zirami-see-all</prop>
</prolog>
