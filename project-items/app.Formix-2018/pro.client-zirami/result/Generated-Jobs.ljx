<need>(prop,zirami_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="zirami-read" />
<prop id="isAdd">0</prop>
<call_job job="zirami-editor" />
<call_job job="zirami-write" />
<ti align="right" x="Did update Zirami '(prop,zirami_bez)'" />
<call_job job="hook-zirami-after-edit" />
</job><job role="hidden" id="zirami-del">
<need>(prop,zirami_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="zirami-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Zirami [ (prop,zirami_bez) (prop,ziramis_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,ziramis)" where="(prop,ziramis_offset)zirami[@row='(prop,zirami_key)']" />
<tp>Deleted (prop,zirami_bez) #(prop,zirami_key)</tp>
<ti label="Did delete Zirami:" x="(f,html,bold,open)(f,html,bold,open)(prop,zirami_bez)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="zirami-see-all" />
</job><job role="hidden" id="zirami-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Zirami(prop,ziramis_offset_label)" />
<prop x="sum" id="ziramis_tk_control" />
</when>
<otherwise>
<need>(prop,zirami_key)</need>
<prop id="label" x="Zirami [(prop,zirami_bez)](prop,ziramis_offset_label)" />
<prop x="sum_only" id="ziramis_tk_control" />
</otherwise>
</choose>
<call_job job="zirami-tk" />
</job><job id="zirami-add" level="ws" role="user">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="zirami-editor" />
<prop id="zirami_key">1</prop>
<when test="(f,not,(f,exists,prop,ziramis_offset_new_key))">
<prop id="ziramis_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,ziramis)" sort="@row" number="@row" xpath="(prop,ziramis_offset_new_key)zirami">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="zirami_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Zirami: #(prop,zirami_key)</i>
<call_job job="zirami-write" />
<ti align="right" x="Did add Zirami '(prop,zirami_bez)'" />
<choose>
<when test="(f,has,prop,post_add_script_zirami)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_zirami)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="zirami-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="zirami-write">
<need>(prop,zirami_key) (prop,isAdd)</need>
<spirit act="open" id="ziramis_spirit_tc" xml="(file,ziramis)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,ziramis_offset),/)">
<prop id="offset2" x="(f,substring,(prop,ziramis_offset),0,(f,sub,(f,len,(prop,ziramis_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,ziramis_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="ziramis_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;zirami row="(prop,zirami_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="ziramis_spirit_tc" where="(prop,ziramis_offset)zirami[@row='(prop,zirami_key)']" attribute="bez" value="(f,vob,prop,zirami_bez)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ziramis_spirit_tc" where="(prop,ziramis_offset)zirami[@row='(prop,zirami_key)']" attribute="character" value="(f,vob,prop,zirami_character)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ziramis_spirit_tc" where="(prop,ziramis_offset)zirami[@row='(prop,zirami_key)']" attribute="beschreibung" value="(f,vob,prop,zirami_beschreibung)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="ziramis_spirit_tc" where="(prop,ziramis_offset)zirami[@row='(prop,zirami_key)']" attribute="portionen" value="(f,vob,prop,zirami_portionen)" />
<file id="jack-in" x="(file,zirami_bild_read)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
