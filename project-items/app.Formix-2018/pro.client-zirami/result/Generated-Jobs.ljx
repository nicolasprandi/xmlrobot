<spirit act="xml_update" how="set_attribute" flag="remove" id="ziramis_spirit_tc" where="(prop,ziramis_offset)zirami[@row=(f,xpath_string,(prop,zirami_key))]" attribute="folders_read" value="(prop,jack-result)" />
<dir id="jack-in" x="(dir,zirami_folders_write)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
