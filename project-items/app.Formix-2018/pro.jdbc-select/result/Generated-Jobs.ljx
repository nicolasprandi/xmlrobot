<need>(prop,select_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="select-read" />
<prop id="isAdd">0</prop>
<call_job job="select-editor" />
<call_job job="select-write" />
<ti align="right" x="Did update Select '(f,text,cut_nice,(prop,select_sql),50)'" />
<call_job job="event_post_update_select" />
</job><job role="hidden" id="select-del">
<need>(prop,select_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="select-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Select [ (f,text,cut_nice,(prop,select_sql),50) (prop,selects_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,selects)" where="(prop,selects_offset)select[@row='(prop,select_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,select_sql),50) #(prop,select_key)</tp>
<ti label="Did delete Select:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,select_sql),50)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="select-see-all" />
</job><job role="hidden" id="select-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Select(prop,selects_offset_label)" />
<prop x="sum" id="selects_tk_control" />
</when>
<otherwise>
<need>(prop,select_key)</need>
<prop id="label" x="Select [(f,text,cut_nice,(prop,select_sql),50)](prop,selects_offset_label)" />
<prop x="sum_only" id="selects_tk_control" />
</otherwise>
</choose>
<call_job job="select-tk" />
</job><job id="select-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="select-editor" />
<prop id="select_key">1</prop>
<when test="(f,not,(f,exists,prop,selects_offset_new_key))">
<prop id="selects_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,selects)" sort="@row" number="@row" xpath="(prop,selects_offset_new_key)select">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="select_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Select: #(prop,select_key)</i>
<call_job job="select-write" />
<ti align="right" x="Did add Select '(f,text,cut_nice,(prop,select_sql),50)'" />
<choose>
<when test="(f,has,prop,post_add_script_select)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_select)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="file" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="event_post_update_select" />
</otherwise>
</choose>
</job><job role="hidden" id="select-write">
<need>(prop,select_key) (prop,isAdd)</need>
<spirit act="open" id="selects_spirit_tc" xml="(file,selects)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,selects_offset),/)">
<prop id="offset2" x="(f,substring,(prop,selects_offset),0,(f,sub,(f,len,(prop,selects_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,selects_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="selects_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;select row="(prop,select_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="selects_spirit_tc" where="(prop,selects_offset)select[@row='(prop,select_key)']" attribute="sql" value="(f,vob,prop,select_sql)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="selects_spirit_tc" where="(prop,selects_offset)select[@row='(prop,select_key)']" attribute="id" value="(f,vob,prop,select_id)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="selects_spirit_tc" where="(prop,selects_offset)select[@row='(prop,select_key)']" attribute="desc" value="(f,vob,prop,select_desc)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="selects_spirit_tc" where="(prop,selects_offset)select[@row='(prop,select_key)']" attribute="update" value="(f,vob,prop,select_update)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="selects_spirit_tc" where="(prop,selects_offset)select[@row='(prop,select_key)']" attribute="archify" value="(f,vob,prop,select_archify)" />
<spirit act="close" flag="save pretty" id="selects_spirit_tc" />
</job></jobs>
