<include file="(dir,app)prolog.xrs" /><job role="hidden" id="atyp-tk">
<need default="">(prop,atyps_tk_control)</need>
<need default="">(prop,label)</need>
<tk label="(prop,label)" flag="(prop,atyps_tk_control)">
<tk label="Bezeichung" id="atyp_bez" x="" test_first="1" tip="Ueberschrift Titel" type="text" flag=" nono " />
<tk label="Intervall" id="atyp_intervall" x="" test_first="1" tip="Welche Geschmäcker sind für das Rezept bestimmend" type="sel" flag=" ">
<sel label="Täglich">9</sel>
<sel label="Wöchentlich">7</sel>
<sel label="Monatlich">4</sel>
<sel label="Jährlich">1</sel>
</tk>
<tk label="Beschreibung" id="atyp_beschreibung" x="" test_first="0" tip="Eine kurze bescheibung im überlick" type="textblock" flag=" " />
<tk label="Wahrscheinlichkeit" id="atyp_wahrscheinlichkeit" x="1" test_first="1" tip="Wahrscheinlichkeit im gewählten Intervall; Zahl zwischen 0 und 1" type="text" flag=" " />
<tk label="Anmerkung" id="atyp_anmerkung" x="" test_first="0" type="textblock" flag=" " />
</tk>
</job><job id="atyp-see-all" level="ws" role="hidden" tip="Lists all Aktions-Typen">
<prop id="nothing">1</prop>
<loop id="i" missing_strategy="empty" xml="(file,atyps)" xpath="(prop,atyps_offset)atyp(prop,atyps_where)" sort="(prop,atyps_sort_attribute)" number="(prop,atyps_sort_number)" ignore_case="(prop,atyps_sort_ignore_case)" desc="(prop,atyps_sort_desc)">
<when test="(prop,nothing)">
<when test="(f,gt,(f,len,(prop,atyps_offset_label)),0)">
<ti label="(prop,atyps_offset_label)" />
</when>
<prop id="nothing">0</prop>
</when>
<ti type="rec">
<ti type="call_job" prefix="  " explain="(f,html,bold,open)(f,text,cut_nice,(loop,i,@bez),45)(f,html,bold,close)" job="atyp-see">
<prop id="atyp_key">(loop,i,@row)</prop>
<file id="atyps">(file,atyps)</file>
<prop id="atyps_offset">(prop,atyps_offset)</prop>
<prop id="atyps_offset_label">(prop,atyps_offset_label)</prop>
<prop id="atyps_offset_new_key">(prop,atyps_offset_new_key)</prop>
<prop id="atyps_sort_attribute">(prop,atyps_sort_attribute)</prop>
<prop id="atyps_sort_number">(prop,atyps_sort_number)</prop>
<prop id="atyps_where">(prop,atyps_where)</prop>
<prop id="atyps_return_job">(prop,atyps_return_job)</prop>
</ti>
<ti flag="(f,when,(f,guicontroller,general,is-web,),wrap,)">(f,text,cut_nice,(f,when,(f,has_flag,(loop,i,@intervall),9),Täglich(e:s),)(f,when,(f,has_flag,(loop,i,@intervall),7),Wöchentlich(e:s),)(f,when,(f,has_flag,(loop,i,@intervall),4),Monatlich(e:s),)(f,when,(f,has_flag,(loop,i,@intervall),1),Jährlich(e:s),),30).(loop,i,@wahrscheinlichkeit)</ti>
</ti>
</loop>
<when test="(prop,nothing)">
<ti label=" ">Keinen Aktions-Typ gefunden</ti>
</when>
<when test="(f,not,(f,contains,(prop,atyps_offset),node(e:o)(e:c)))">
<ti type="rec" label=" ">
<ti flag="no_arrow" test="(f,role,user)" label=" " type="call_job" explain_nix="atyp-add" explain="Neuer Aktions-Typ" job="atyp-add">
<file id="atyps">(file,atyps)</file>
<prop id="atyps_offset">(prop,atyps_offset)</prop>
<prop id="atyps_offset_label">(prop,atyps_offset_label)</prop>
<prop id="atyps_offset_new_key">(prop,atyps_offset_new_key)</prop>
<prop id="atyps_sort_attribute">(prop,atyps_sort_attribute)</prop>
<prop id="atyps_sort_number">(prop,atyps_sort_number)</prop>
<prop id="atyps_where">(prop,atyps_where)</prop>
<prop id="atyps_return_job">(prop,atyps_return_job)</prop>
</ti>
<ti flag="no_arrow" label=" " type="call_service" explain="/ Organize /" job="do-org-me">
<file id="orga">(file,atyps)</file>
<prop id="orga_offset">(prop,atyps_offset)</prop>
<prop id="orga_offset_label">(prop,atyps_offset_label)</prop>
<prop id="orga_offset_new_key">(prop,atyps_offset_new_key)</prop>
<prop id="orga_segment_plural">atyps</prop>
<prop id="orga_segment_singular">atyp</prop>
<prop id="orga_segment_plural_label">Aktions-Typen</prop>
<prop id="orga_segment_singular_label">Aktions-Typ</prop>
<prop id="orga_sort_attribute">(prop,atyps_sort_attribute)</prop>
<prop id="orga_sort_number">(prop,atyps_sort_number)</prop>
<prop id="orga_where">(prop,atyps_where)</prop>
<prop id="orga_name_expression_loop">()(f,html,bold,open)(f,text,cut_nice,(loop,i,@bez),45)(f,html,bold,close)()</prop>
<prop id="orga_desc_expression_loop">()(f,text,cut_nice,(f,when,(f,has_flag,(loop,i,@intervall),9),Täglich(e:s),)(f,when,(f,has_flag,(loop,i,@intervall),7),Wöchentlich(e:s),)(f,when,(f,has_flag,(loop,i,@intervall),4),Monatlich(e:s),)(f,when,(f,has_flag,(loop,i,@intervall),1),Jährlich(e:s),),30).(loop,i,@wahrscheinlichkeit)()</prop>
</ti>
</ti>
</when>
<when test="(f,has_flag,debug trace all,(f,interpreter,level))">
<ti_hr />
<ti label="Debug Information">
<ti label="File:" type="file">(file,atyps)</ti>
<ti label="Xml-Offset:" test="(f,gt_num,(f,len,(prop,atyps_offset)),0)">(prop,atyps_offset)</ti>
</ti>
</when>
</job><job role="hidden" id="atyp-read">
<need>(prop,atyp_key)</need>
<spirit act="open" missing_strategy="empty" id="atyps_spirit_tc" xml="(file,atyps)" />
<prop id="atyp_dt_upd">(f,spirit,atyps_spirit_tc,(prop,atyps_offset)atyp[@row=(f,xpath_string,(prop,atyp_key))],@dt_upd)</prop>
<prop id="atyp_dt_add">(f,spirit,atyps_spirit_tc,(prop,atyps_offset)atyp[@row=(f,xpath_string,(prop,atyp_key))],@dt_add)</prop>
<prop id="atyp_bez">(f,spirit,atyps_spirit_tc,(prop,atyps_offset)atyp[@row=(f,xpath_string,(prop,atyp_key))],@bez)</prop>
<prop id="atyp_intervall">(f,spirit,atyps_spirit_tc,(prop,atyps_offset)atyp[@row=(f,xpath_string,(prop,atyp_key))],@intervall)</prop>
<prop id="atyp_beschreibung">(f,spirit,atyps_spirit_tc,(prop,atyps_offset)atyp[@row=(f,xpath_string,(prop,atyp_key))],@beschreibung)</prop>
<prop id="atyp_wahrscheinlichkeit">(f,spirit,atyps_spirit_tc,(prop,atyps_offset)atyp[@row=(f,xpath_string,(prop,atyp_key))],@wahrscheinlichkeit)</prop>
<prop id="atyp_anmerkung">(f,spirit,atyps_spirit_tc,(prop,atyps_offset)atyp[@row=(f,xpath_string,(prop,atyp_key))],@anmerkung)</prop>
<spirit act="close" id="atyps_spirit_tc" />
</job><job role="hidden" id="atyp-see">
<need>(prop,atyp_key)</need>
<call_job job="atyp-read" />
<prop x="print print_only" id="atyps_tk_control" />
<prop id="label" x="(f,html,bold,open)(f,text,cut_nice,(prop,atyp_bez),45)(f,html,bold,close)(prop,atyps_offset_label)" />
<ti test="(f,role,user)" type="call_job" explain="Bearbeite Aktions-Typ" job="atyp-edit">
<prop id="atyp_key">(prop,atyp_key)</prop>
<file id="atyps">(file,atyps)</file>
<prop id="atyps_offset">(prop,atyps_offset)</prop>
<prop id="atyps_offset_label">(prop,atyps_offset_label)</prop>
<prop id="atyps_offset_new_key">(prop,atyps_offset_new_key)</prop>
<prop id="atyps_sort_attribute">(prop,atyps_sort_attribute)</prop>
<prop id="atyps_sort_number">(prop,atyps_sort_number)</prop>
<prop id="atyps_where">(prop,atyps_where)</prop>
<prop id="atyps_return_job">(prop,atyps_return_job)</prop>
</ti>
<call_job job="atyp-tk" />
<ti_space height="3px" />
</job><job role="hidden" id="atyp-edit">
<need>(prop,atyp_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="atyp-read" />
<prop id="isAdd">0</prop>
<call_job job="atyp-editor" />
<call_job job="atyp-write" />
<ti label="Did update Aktions-Typ:" x="(f,html,bold,open)(f,text,cut_nice,(prop,atyp_bez),45)(f,html,bold,close)" />
<ti_break />
<ti_hr />
<call_job job="atyp-see-all" />
</job><job role="hidden" id="atyp-del">
<need>(prop,atyp_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="atyp-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Aktions-Typ [ (f,text,cut_nice,(prop,atyp_bez),45) (prop,atyps_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,atyps)" where="(prop,atyps_offset)atyp[@row='(prop,atyp_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,atyp_bez),45) #(prop,atyp_key)</tp>
<ti label="Did delete Aktions-Typ:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,atyp_bez),45)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="atyp-see-all" />
</job><job role="hidden" id="atyp-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Aktions-Typ(prop,atyps_offset_label)" />
<prop x="sum" id="atyps_tk_control" />
</when>
<otherwise>
<need>(prop,atyp_key)</need>
<prop id="label" x="Aktions-Typ [(f,text,cut_nice,(prop,atyp_bez),45)](prop,atyps_offset_label)" />
<prop x="sum_only" id="atyps_tk_control" />
</otherwise>
</choose>
<call_job job="atyp-tk" />
</job><job id="atyp-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="atyp-editor" />
<prop id="atyp_key">1</prop>
<when test="(f,not,(f,exists,prop,atyps_offset_new_key))">
<prop id="atyps_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,atyps)" sort="@row" number="@row" xpath="(prop,atyps_offset_new_key)atyp">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="atyp_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Aktions-Typ: #(prop,atyp_key)</i>
<call_job job="atyp-write" />
<ti label="Did add Aktions-Typ:" x="(f,html,bold,open)(f,text,cut_nice,(prop,atyp_bez),45)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
<call_job job="atyp-see-all" />
</job><job role="hidden" id="atyp-write">
<need>(prop,atyp_key) (prop,isAdd)</need>
<spirit act="open" id="atyps_spirit_tc" xml="(file,atyps)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,atyps_offset),/)">
<prop id="offset2" x="(f,substring,(prop,atyps_offset),0,(f,sub,(f,len,(prop,atyps_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,atyps_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="atyps_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;atyp row="(prop,atyp_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="atyps_spirit_tc" where="(prop,atyps_offset)atyp[@row='(prop,atyp_key)']" attribute="bez" value="(f,vob,prop,atyp_bez)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="atyps_spirit_tc" where="(prop,atyps_offset)atyp[@row='(prop,atyp_key)']" attribute="intervall" value="(f,vob,prop,atyp_intervall)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="atyps_spirit_tc" where="(prop,atyps_offset)atyp[@row='(prop,atyp_key)']" attribute="beschreibung" value="(f,vob,prop,atyp_beschreibung)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="atyps_spirit_tc" where="(prop,atyps_offset)atyp[@row='(prop,atyp_key)']" attribute="wahrscheinlichkeit" value="(f,vob,prop,atyp_wahrscheinlichkeit)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="atyps_spirit_tc" where="(prop,atyps_offset)atyp[@row='(prop,atyp_key)']" attribute="anmerkung" value="(f,vob,prop,atyp_anmerkung)" />
<spirit act="close" flag="save pretty" id="atyps_spirit_tc" />
</job></jobs>
