<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="atyp-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Aktions-Typ(prop,atyps_offset_label)"/>
<prop x="sum" id="atyps_tk_control"/>
</when>
<otherwise>
<need>(prop,atyp_key)</need>
<prop id="label" x="Aktions-Typ [(f,text,cut_nice,(prop,atyp_bez),45)](prop,atyps_offset_label)"/>
<prop x="sum_only" id="atyps_tk_control"/>
</otherwise>
</choose>
<call_job job="atyp-tk"/>
</job>
