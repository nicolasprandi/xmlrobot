<?xml version="1.0" encoding="UTF-8"?><job id="product-see-all" level="ws" role="hidden">
    <need default="">(prop,products_sort_attribute)</need>
    <need default="">(prop,products_sort_number)</need>
    <need default="">(prop,products_sort_ignore_case)</need>
    <need default="">(prop,products_sort_desc)</need>
    <need default="">(prop,products_where)</need>
    <need default="">(prop,products_offset_label)</need>
    <need default="./">(prop,products_offset)</need>
    <need default="">(prop,products_return_job)</need>
    <need default="//">(prop,products_offset_new_key)</need>
    <need default="0">(prop,products_no_header)</need>
    <try_catch>
        <try>
            <trace>Hook Station page=view station=0 hook=begin hook_job=hook_product_view_begin</trace>
            <call_job job="hook_product_view_begin"/>
        </try>
        <catch>
            <ti label="Hook must be implemented: product-view: begin.0">
                <ti> hook_job=hook_product_view_begin hook=begin page=view station=0 object=product</ti>
            </ti>
        </catch>
    </try_catch>
    <prop id="nothing">(f,not,(prop,products_no_header))</prop>
    <loop missing_strategy="empty" id="product_loop" xml="(file,products)" xpath="(prop,products_offset)product(prop,products_where)" sort="(prop,products_sort_attribute)" number="(prop,products_sort_number)" ignore_case="(prop,products_sort_ignore_case)" desc="(prop,products_sort_desc)">
        <when test="(prop,nothing)">
            <ti>
                <ti/>
            </ti>
            <when test="(f,gt,(f,len,(prop,products_offset_label)),0)">
                <ti label="(prop,products_offset_label)"/>
            </when>
            <prop id="nothing">0</prop>
        </when>
        <ti type="rec">
            <ti flag="" type="call_job" prefix="  " explain="(f,html,bold,open)(loop,product_loop,@name)(f,html,bold,close)" job="product-see">
                <prop id="product_key">(loop,product_loop,@row)</prop>
                <file id="products">(file,products)</file>
                <prop id="products_offset">(prop,products_offset)</prop>
                <prop id="products_offset_label">(prop,products_offset_label)</prop>
                <prop id="products_offset_new_key">(prop,products_offset_new_key)</prop>
                <prop id="products_sort_attribute">(prop,products_sort_attribute)</prop>
                <prop id="products_sort_number">(prop,products_sort_number)</prop>
                <prop id="products_sort_ignore_case">(prop,products_sort_ignore_case)</prop>
                <prop id="products_sort_desc">(prop,products_sort_desc)</prop>
                <prop id="products_where">(prop,products_where)</prop>
                <prop id="products_return_job">(prop,products_return_job)</prop>
            </ti>
            <ti test="(f,has,(loop,product_loop,@apps))" type="text" x="(f,tk_sel_translate,(loop,product_loop,@apps),(dir,pro)app-selector-gui.xml)" flag="wrap"/>
            <ti test="(f,not,(f,has,(loop,product_loop,@apps)))"/>
            <ti test="(f,has,(loop,product_loop,@apps_open))" type="text" x="(f,tk_sel_translate,(loop,product_loop,@apps_open),(dir,pro)app-selector-gui.xml)" flag="wrap"/>
            <ti test="(f,not,(f,has,(loop,product_loop,@apps_open)))"/>
            <ti test="(f,has,(loop,product_loop,@arcadia_pro))" type="text" x="(f,tk_sel_translate,(loop,product_loop,@arcadia_pro),(dir,pro)arcadia-pro-selector-gui.xml)"/>
            <ti test="(f,not,(f,has,(loop,product_loop,@arcadia_pro)))"/>
        </ti>
    </loop>
    <when test="(prop,nothing)">
        <ti type="rec">
            <ti flag="wrap_word">No Product specified</ti>
        </ti>
    </when>
    <when test="(f,not,(f,contains,(prop,products_offset),node(e:o)(e:c)))">
        <ti type="rec" label=" " test="(f,and,(f,role,user),(f,role,user))">
            <ti type="menu" span="10">
                <ti test="(f,role,user)" label=" " type="call_job" explain_nix="product-add" flag="xbutton " class="fb fbAdd fbAddProduct" explain="[ + New Product ]" job="product-add">
                    <file id="products">(file,products)</file>
                    <prop id="products_offset">(prop,products_offset)</prop>
                    <prop id="products_offset_label">(prop,products_offset_label)</prop>
                    <prop id="products_offset_new_key">(prop,products_offset_new_key)</prop>
                    <prop id="products_sort_attribute">(prop,products_sort_attribute)</prop>
                    <prop id="products_sort_number">(prop,products_sort_number)</prop>
                    <prop id="products_sort_ignore_case">(prop,products_sort_ignore_case)</prop>
                    <prop id="products_sort_desc">(prop,products_sort_desc)</prop>
                    <prop id="products_where">(prop,products_where)</prop>
                    <prop id="products_return_job">(prop,products_return_job)</prop>
                </ti>
                <ti test="(f,and,(f,not,(prop,nothing)),(f,role,user))" label=" " type="call_job" flag="button" class="fb fbOrg fbOrgProduct" explain="/ Org /" job="do-org-me">
                    <file id="orga">(file,products)</file>
                    <prop id="orga_where">(prop,products_where)</prop>
                    <prop id="orga_view_loop_id">product_loop</prop>
                    <prop id="orga_finished_job">product-see-all</prop>
                    <prop id="orga_offset">(prop,products_offset)</prop>
                    <prop id="orga_offset_label">(prop,products_offset_label)</prop>
                    <prop id="orga_offset_new_key">(prop,products_offset_new_key)</prop>
                    <prop id="orga_segment_plural">products</prop>
                    <prop id="orga_segment_singular">product</prop>
                    <prop id="orga_segment_plural_label">Products</prop>
                    <prop id="orga_segment_singular_label">Product</prop>
                    <prop id="orga_sort_attribute">(prop,products_sort_attribute)</prop>
                    <prop id="orga_sort_number">(prop,products_sort_number)</prop>
                    <prop id="orga_where">(prop,products_where)</prop>
                    <prop id="orga_name_expression_loop">()(loop,product_loop,@name)()</prop>
                    <prop id="orga_desc_expression_loop">()()</prop>
                </ti>
            </ti>
        </ti>
    </when>
    <when test="(f,has_flag,debug trace all,(f,interpreter,level))">
        <ti_hr/>
        <ti label="Debug Information">
            <ti label="File:" type="file">(file,products)</ti>
            <ti label="Xml-Offset:" test="(f,gt_num,(f,len,(prop,products_offset)),0)">(prop,products_offset)</ti>
        </ti>
    </when>
    <try_catch>
        <try>
            <trace>Hook Station page=view station=0 hook=end hook_job=hook_product_view_end</trace>
            <call_job job="hook_product_view_end"/>
        </try>
        <catch>
            <ti label="Hook must be implemented: product-view: end.0">
                <ti> hook_job=hook_product_view_end hook=end page=view station=0 object=product</ti>
            </ti>
        </catch>
    </try_catch>
</job>
