        <otherwise>
            <ti type="rec" label=" ">
                <ti type="call_job" explain="(prop,_x_go_up_sys)" align="right" class="justup" flag="button" job="product-see-all">
                    <file id="products">(file,products)</file>
                    <prop id="products_offset">(prop,products_offset)</prop>
                    <prop id="products_offset_label">(prop,products_offset_label)</prop>
                    <prop id="products_offset_new_key">(prop,products_offset_new_key)</prop>
                    <prop id="products_sort_attribute">(prop,products_sort_attribute)</prop>
                    <prop id="products_sort_number">(prop,products_sort_number)</prop>
                    <prop id="products_sort_ignore_case">(prop,products_sort_ignore_case)</prop>
                    <prop id="products_sort_desc">(prop,products_sort_desc)</prop>
                    <prop id="products_where">(prop,products_where)</prop>
                    <prop id="products_return_job">(prop,products_return_job)</prop>
                </ti>
            </ti>
        </otherwise>
    </choose>
    <ti_break />
</job><job role="hidden" id="product-edit">
    <need>(prop,product_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="product-read" />
    <prop id="isAdd">0</prop>
    <call_job job="product-editor" />
    <call_job job="product-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+/- Product '(prop,product_name)'" />
    </ti>
    <call_job job="product-see" />
</job><job role="hidden" id="product-del">
    <need>(prop,product_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="product-read" />
    <tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Product [ (prop,product_name) (prop,products_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
        <q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
    </tk>
    <choose>
        <when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
            <xml_update how="remove" what="(file,products)" where="(prop,products_offset)product[@row='(prop,product_key)']" />
            <tp>Deleted (prop,product_name) #(prop,product_key)</tp>
            <ti label="- Product:" x="(f,html,bold,open)(f,html,bold,open)(prop,product_name)(f,html,bold,close)(f,html,bold,close)" />
            <ti_hr />
            <when test="(prop,do_return_job)" />
        </when>
        <otherwise>
            <tp>No delete performed.</tp>
            <ti>No delete performed.</ti>
        </otherwise>
    </choose>
    <call_job job="product-see-all" />
</job><job role="hidden" id="product-editor">
    <need>(prop,isAdd)</need>
    <choose>
        <when test="(prop,isAdd)">
            <prop id="product_default_label_class" x="+ Product" />
            <prop id="product_default_label_name" x="(f,when,(f,has,(prop,products_offset_label)), | (prop,products_offset_label),)" />
            <prop id="products_tk_control" x="sum" />
        </when>
        <otherwise>
            <need>(prop,product_key)</need>
            <prop id="product_default_label_class" x="Product" />
            <prop id="product_default_label_name" x="(prop,product_name)(f,when,(f,has,(prop,products_offset_label)), - (prop,products_offset_label),)" />
            <prop id="products_tk_control" x="sum_only" />
        </otherwise>
    </choose>
    <call_job job="product-tk" />
</job><job id="product-add" level="ws" role="hidden">
    x
    <prop id="isAdd">1</prop>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="product-editor" />
    <prop id="product_key">1</prop>
    <when test="(f,not,(f,exists,prop,products_offset_new_key))">
        <prop id="products_offset_new_key">//</prop>
    </when>
    <loop id="max" limit="1" flag="back" xml="(file,products)" sort="@row" number="@row" xpath="(prop,products_offset_new_key)product">
        <trace>max key=(loop,max,@row)</trace>
        <trace>i=(loop,max,#i)</trace>
        <prop id="product_key">(f,add,(loop,max,@row),1)</prop>
    </loop>
    <i>Generated Key for new Product: #(prop,product_key)</i>
    <call_job job="product-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+ Product '(prop,product_name)'" />
    </ti>
    <choose>
        <when test="(f,has,prop,post_add_script_product)">
            <file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
            <prop id="formix-posting-code" x="(f,random_text,16)" />
            <create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_product)</create_file>
            <include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
            <delete file="(file,formix-posting)" />
            <remove type="file" id="formix-posting" />
            <remove type="prop" id="formix-posting-code" />
        </when>
        <otherwise>
            <call_job job="product-see-all" />
        </otherwise>
    </choose>
</job><job role="hidden" id="product-write">
    <need>(prop,product_key) (prop,isAdd)</need>
    <need default="./">(prop,products_offset)</need>
    <spirit act="open" id="products_spirit_tc" xml="(file,products)" />
    <when test="(prop,isAdd)">
        <choose>
            <when test="(f,ends_with,(prop,products_offset),/)">
                <prop id="offset2" x="(f,substring,(prop,products_offset),0,(f,sub,(f,len,(prop,products_offset)),1))" />
            </when>
            <otherwise>
                <prop id="offset2" x="(prop,products_offset)" />
            </otherwise>
        </choose>
        <spirit act="xml_update" how="insert_in" id="products_spirit_tc" where="(prop,offset2)">
            <inline attribute="with">&lt;product row="(prop,product_key)" /&gt;</inline>
        </spirit>
        <i>Added a new record</i>
    </when>
    <spirit act="xml_update" how="set_attribute" flag="remove" id="products_spirit_tc" where="(prop,products_offset)product[@row='(prop,product_key)']" attribute="name" value="(f,vob,prop,product_name)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="products_spirit_tc" where="(prop,products_offset)product[@row='(prop,product_key)']" attribute="productname" value="(f,vob,prop,product_productname)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="products_spirit_tc" where="(prop,products_offset)product[@row='(prop,product_key)']" attribute="doku" value="(f,vob,prop,product_doku)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="products_spirit_tc" where="(prop,products_offset)product[@row='(prop,product_key)']" attribute="proddoku" value="(f,vob,prop,product_proddoku)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="products_spirit_tc" where="(prop,products_offset)product[@row='(prop,product_key)']" attribute="apps" value="(f,vob,prop,product_apps)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="products_spirit_tc" where="(prop,products_offset)product[@row='(prop,product_key)']" attribute="apps_open" value="(f,vob,prop,product_apps_open)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="products_spirit_tc" where="(prop,products_offset)product[@row='(prop,product_key)']" attribute="arcadia_pro" value="(f,vob,prop,product_arcadia_pro)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="products_spirit_tc" where="(prop,products_offset)product[@row='(prop,product_key)']" attribute="prodconf" value="(f,vob,prop,product_prodconf)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="products_spirit_tc" where="(prop,products_offset)product[@row='(prop,product_key)']" attribute="dcl_services" value="(f,vob,prop,product_dcl_services)" />
    <spirit act="close" flag="save pretty" id="products_spirit_tc" />
</job></jobs>
