<need>(prop,app_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="app-read" />
<prop id="isAdd">0</prop>
<call_job job="app-editor" />
<call_job job="app-write" />
<ti align="right" x="Did update App '(prop,app_appid)'" />
<call_job job="app-see-all" />
</job><job role="hidden" id="app-del">
<need>(prop,app_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="app-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting App [ (prop,app_appid) (prop,apps_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,apps)" where="(prop,apps_offset)app[@row='(prop,app_key)']" />
<tp>Deleted (prop,app_appid) #(prop,app_key)</tp>
<ti label="Did delete App:" x="(f,html,bold,open)(f,html,bold,open)(prop,app_appid)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="app-see-all" />
</job><job role="hidden" id="app-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new App(prop,apps_offset_label)" />
<prop x="sum" id="apps_tk_control" />
</when>
<otherwise>
<need>(prop,app_key)</need>
<prop id="label" x="App [(prop,app_appid)](prop,apps_offset_label)" />
<prop x="sum_only" id="apps_tk_control" />
</otherwise>
</choose>
<call_job job="app-tk" />
</job><job id="app-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="app-editor" />
<prop id="app_key">1</prop>
<when test="(f,not,(f,exists,prop,apps_offset_new_key))">
<prop id="apps_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,apps)" sort="@row" number="@row" xpath="(prop,apps_offset_new_key)app">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="app_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new App: #(prop,app_key)</i>
<call_job job="app-write" />
<ti align="right" x="Did add App '(prop,app_appid)'" />
<choose>
<when test="(f,has,prop,post_add_script_app)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_app)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="app-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="app-write">
<need>(prop,app_key) (prop,isAdd)</need>
<spirit act="open" id="apps_spirit_tc" xml="(file,apps)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,apps_offset),/)">
<prop id="offset2" x="(f,substring,(prop,apps_offset),0,(f,sub,(f,len,(prop,apps_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,apps_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="apps_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;app row="(prop,app_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="apps_spirit_tc" where="(prop,apps_offset)app[@row='(prop,app_key)']" attribute="appid" value="(f,vob,prop,app_appid)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="apps_spirit_tc" where="(prop,apps_offset)app[@row='(prop,app_key)']" attribute="explain" value="(f,vob,prop,app_explain)" />
<spirit act="close" flag="save pretty" id="apps_spirit_tc" />
</job></jobs>
