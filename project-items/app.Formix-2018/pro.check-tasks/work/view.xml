<prop id="tasks_offset_label">(prop,tasks_offset_label)</prop>
<prop id="tasks_offset_new_key">(prop,tasks_offset_new_key)</prop>
<prop id="tasks_sort_attribute">(prop,tasks_sort_attribute)</prop>
