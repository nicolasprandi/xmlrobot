<file id="tasks">(file,tasks)</file>
<prop id="tasks_offset">(prop,tasks_offset)</prop>
<prop id="tasks_offset_label">(prop,tasks_offset_label)</prop>
<prop id="tasks_offset_new_key">(prop,tasks_offset_new_key)</prop>
<prop id="tasks_sort_attribute">(prop,tasks_sort_attribute)</prop>
<prop id="tasks_sort_number">(prop,tasks_sort_number)</prop>
<prop id="tasks_where">(prop,tasks_where)</prop>
<prop id="tasks_return_job">(prop,tasks_return_job)</prop>
</ti>
</ti>
</job>
