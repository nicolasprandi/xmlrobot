<need>(prop,task_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="task-read" />
<prop id="isAdd">0</prop>
<call_job job="task-editor" />
<call_job job="task-write" />
<ti align="right" x="Did update Task '(f,text,cut_nice,(prop,task_name),32)'" />
<call_job job="task-see-all" />
</job><job role="hidden" id="task-del">
<need>(prop,task_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="task-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Task [ (f,text,cut_nice,(prop,task_name),32) (prop,tasks_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,tasks)" where="(prop,tasks_offset)task[@row='(prop,task_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,task_name),32) #(prop,task_key)</tp>
<ti label="Did delete Task:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,task_name),32)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="task-see-all" />
</job><job role="hidden" id="task-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Task(prop,tasks_offset_label)" />
<prop x="sum" id="tasks_tk_control" />
</when>
<otherwise>
<need>(prop,task_key)</need>
<prop id="label" x="Task [(f,text,cut_nice,(prop,task_name),32)](prop,tasks_offset_label)" />
<prop x="sum_only" id="tasks_tk_control" />
</otherwise>
</choose>
<call_job job="task-tk" />
</job><job id="task-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="task-editor" />
<prop id="task_key">1</prop>
<when test="(f,not,(f,exists,prop,tasks_offset_new_key))">
<prop id="tasks_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,tasks)" sort="@row" number="@row" xpath="(prop,tasks_offset_new_key)task">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="task_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Task: #(prop,task_key)</i>
<call_job job="task-write" />
<ti align="right" x="Did add Task '(f,text,cut_nice,(prop,task_name),32)'" />
<choose>
<when test="(f,has,prop,post_add_script_task)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_task)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="task-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="task-write">
<need>(prop,task_key) (prop,isAdd)</need>
<spirit act="open" id="tasks_spirit_tc" xml="(file,tasks)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,tasks_offset),/)">
<prop id="offset2" x="(f,substring,(prop,tasks_offset),0,(f,sub,(f,len,(prop,tasks_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,tasks_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="tasks_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;task row="(prop,task_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="tasks_spirit_tc" where="(prop,tasks_offset)task[@row='(prop,task_key)']" attribute="name" value="(f,vob,prop,task_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="tasks_spirit_tc" where="(prop,tasks_offset)task[@row='(prop,task_key)']" attribute="description" value="(f,vob,prop,task_description)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="tasks_spirit_tc" where="(prop,tasks_offset)task[@row='(prop,task_key)']" attribute="full" value="(f,vob,prop,task_full)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="tasks_spirit_tc" where="(prop,tasks_offset)task[@row='(prop,task_key)']" attribute="classes" value="(f,vob,prop,task_classes)" />
<spirit act="close" flag="save pretty" id="tasks_spirit_tc" />
</job></jobs>
