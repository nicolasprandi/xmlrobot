<?xml version="1.0" encoding="UTF-8"?><job id="dsa-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<prop id="dsa-parent-objekttyp">(f,xpath,(file,dsas),dsi[@row=(prop,dsi_key)]/dso[@row=(prop,dso_key)],@objekttyp)</prop>
<file id="pdi-sel-attr">(dir,repo)ot-(prop,dsa-parent-objekttyp)-asel-(prop,tip-term-class).xml</file>
<call_job job="dsa-editor"/>
<prop id="dsa_key">1</prop>
<when test="(f,not,(f,exists,prop,dsas_offset_new_key))">
<prop id="dsas_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,dsas)" sort="@row" number="@row" xpath="(prop,dsas_offset_new_key)dsa">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="dsa_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_dsa): #(prop,dsa_key)</i>
<call_job job="dsa-write"/>
<ti_break class_table="tabNavigator"/>
<ti type="rec">
<ti align="right" x="+ (prop,_sl_dsa) '(f,tk_sel_translate,(prop,dsa_attributtyp),(file,pdi-sel-attr))'"/>
</ti>
<choose>
<when test="(f,has,prop,post_add_script_dsa)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_dsa)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="dsa_did_edit"/>
</otherwise>
</choose>
</job>