<prop id="dsos_sort_ignore_case">(prop,dsos_sort_ignore_case)</prop>
<prop id="dsos_sort_desc">(prop,dsos_sort_desc)</prop>
<prop id="dsos_where">(prop,dsos_where)</prop>
<prop id="dsos_return_job">(prop,dsos_return_job)</prop>
<prop id="dso_key">(prop,dso_key)</prop>
</ti>
</ti>
</otherwise>
</choose>
<ti_break />
</job><job role="hidden" id="dsa-edit">
<need>(prop,dsa_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="dsa-read" />
<prop id="isAdd">0</prop>
<call_job job="dsa-editor" />
<call_job job="dsa-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+/- (prop,_sl_dsa) '(f,tk_sel_translate,(prop,dsa_attributtyp),(file,pdi-sel-attr))'" />
</ti>
<call_job job="dsa_did_edit" />
</job><job role="hidden" id="dsa-del">
<need>(prop,dsa_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="dsa-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_dsa) [ (f,tk_sel_translate,(prop,dsa_attributtyp),(file,pdi-sel-attr)) (prop,dsas_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,dsas)" where="(prop,dsas_offset)dsa[@row='(prop,dsa_key)']" />
<tp>Deleted (f,tk_sel_translate,(prop,dsa_attributtyp),(file,pdi-sel-attr)) #(prop,dsa_key)</tp>
<ti label="- (prop,_sl_dsa):" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,dsa_attributtyp),(file,pdi-sel-attr))(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="dso-see-all" />
</job><job role="hidden" id="dsa-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<call_job job="idef-dsa-on" />
<prop id="dsa_default_label_class" x="+ (prop,_sl_dsa)" />
<prop id="dsa_default_label_name" x="(f,when,(f,has,(prop,dsas_offset_label)), | (prop,dsas_offset_label),)" />
<prop id="dsas_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,dsa_key)</need>
<prop id="dsa_default_label_class" x="(prop,_sl_dsa)" />
<prop id="dsa_default_label_name" x="(f,tk_sel_translate,(prop,dsa_attributtyp),(file,pdi-sel-attr))(f,when,(f,has,(prop,dsas_offset_label)), - (prop,dsas_offset_label),)" />
<prop id="dsas_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="dsa-tk" />
</job><job id="dsa-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<prop id="dsa-parent-objekttyp">(f,xpath,(file,dsas),dsi[@row=(prop,dsi_key)]/dso[@row=(prop,dso_key)],@objekttyp)</prop>
<file id="pdi-sel-attr">(dir,repo)ot-(prop,dsa-parent-objekttyp)-asel-(prop,tip-term-class).xml</file>
<call_job job="dsa-editor" />
<prop id="dsa_key">1</prop>
<when test="(f,not,(f,exists,prop,dsas_offset_new_key))">
<prop id="dsas_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,dsas)" sort="@row" number="@row" xpath="(prop,dsas_offset_new_key)dsa">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="dsa_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_dsa): #(prop,dsa_key)</i>
<call_job job="dsa-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_dsa) '(f,tk_sel_translate,(prop,dsa_attributtyp),(file,pdi-sel-attr))'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_dsa)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_dsa)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="dsa_did_edit" />
</otherwise>
</choose>
</job><job role="hidden" id="dsa-write">
<need>(prop,dsa_key) (prop,isAdd)</need>
<need default="./">(prop,dsas_offset)</need>
<spirit act="open" id="dsas_spirit_tc" xml="(file,dsas)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,dsas_offset),/)">
<prop id="offset2" x="(f,substring,(prop,dsas_offset),0,(f,sub,(f,len,(prop,dsas_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,dsas_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="dsas_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;dsa row="(prop,dsa_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsas_spirit_tc" where="(prop,dsas_offset)dsa[@row='(prop,dsa_key)']" attribute="attributtyp" value="(f,vob,prop,dsa_attributtyp)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsas_spirit_tc" where="(prop,dsas_offset)dsa[@row='(prop,dsa_key)']" attribute="wert" value="(f,vob,prop,dsa_wert)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsas_spirit_tc" where="(prop,dsas_offset)dsa[@row='(prop,dsa_key)']" attribute="von" value="(f,vob,prop,dsa_von)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsas_spirit_tc" where="(prop,dsas_offset)dsa[@row='(prop,dsa_key)']" attribute="bis" value="(f,vob,prop,dsa_bis)" />
<spirit act="close" flag="save pretty" id="dsas_spirit_tc" />
</job></jobs>
