<prop id="label" x="(f,html,bold,open)(prop,modo_how)(f,html,bold,close)(f,when,(f,has,(prop,modos_offset_label)), - (prop,modos_offset_label),)" />
<call_job job="modo-tk" />
<ti_hr />
<ti type="rec">
<ti type="call_job" explain="Edit" job="modo-edit">
<prop id="modo_key">(prop,modo_key)</prop>
<file id="modos">(file,modos)</file>
<prop id="modos_offset">(prop,modos_offset)</prop>
<prop id="modos_offset_label">(prop,modos_offset_label)</prop>
<prop id="modos_offset_new_key">(prop,modos_offset_new_key)</prop>
<prop id="modos_sort_attribute">(prop,modos_sort_attribute)</prop>
<prop id="modos_sort_number">(prop,modos_sort_number)</prop>
<prop id="modos_where">(prop,modos_where)</prop>
<prop id="modos_return_job">(prop,modos_return_job)</prop>
<file id="bits">(file,bits)</file>
<prop id="bits_offset">(prop,bits_offset)</prop>
<prop id="bits_offset_label">(prop,bits_offset_label)</prop>
<prop id="bits_offset_new_key">(prop,bits_offset_new_key)</prop>
<prop id="bits_sort_attribute">(prop,bits_sort_attribute)</prop>
<prop id="bits_sort_number">(prop,bits_sort_number)</prop>
<prop id="bits_where">(prop,bits_where)</prop>
<prop id="bits_return_job">(prop,bits_return_job)</prop>
<prop id="bit_key">(prop,bit_key)</prop>
<file id="files">(file,files)</file>
<prop id="files_offset">(prop,files_offset)</prop>
<prop id="files_offset_label">(prop,files_offset_label)</prop>
<prop id="files_offset_new_key">(prop,files_offset_new_key)</prop>
<prop id="files_sort_attribute">(prop,files_sort_attribute)</prop>
<prop id="files_sort_number">(prop,files_sort_number)</prop>
<prop id="files_where">(prop,files_where)</prop>
<prop id="files_return_job">(prop,files_return_job)</prop>
<prop id="file_key">(prop,file_key)</prop>
</ti>
</ti>
</job><job role="hidden" id="modo-edit">
<need>(prop,modo_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="modo-read" />
<prop id="isAdd">0</prop>
<call_job job="modo-editor" />
<call_job job="modo-write" />
<ti align="right" x="Did update Modificator '(prop,modo_how)'" />
<call_job job="modo-see" />
</job><job role="hidden" id="modo-del">
<need>(prop,modo_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="modo-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Modificator [ (prop,modo_how) (prop,modos_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,modos)" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" />
<tp>Deleted (prop,modo_how) #(prop,modo_key)</tp>
<ti label="Did delete Modificator:" x="(f,html,bold,open)(f,html,bold,open)(prop,modo_how)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="modo-see-all" />
</job><job role="hidden" id="modo-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Modificator(prop,modos_offset_label)" />
<prop x="sum" id="modos_tk_control" />
</when>
<otherwise>
<need>(prop,modo_key)</need>
<prop id="label" x="Modificator [(prop,modo_how)](prop,modos_offset_label)" />
<prop x="sum_only" id="modos_tk_control" />
</otherwise>
</choose>
<call_job job="modo-tk" />
<prop id="joe-in-regex" x="(prop,last_signature-regex)" />
<file id="joe-in-store" x="(file,last_signature)" />
<call_job job="go-joe-write" />
</job><job id="modo-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<prop id="joe-in-regex" x="(prop,last_signature-regex)" />
<file id="joe-in-store" x="(file,last_signature)" />
<call_job job="go-joe-read" />

<need default="1">(prop,do_return_job)</need>
<call_job job="modo-editor" />
<prop id="modo_key">1</prop>
<when test="(f,not,(f,exists,prop,modos_offset_new_key))">
<prop id="modos_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,modos)" sort="@row" number="@row" xpath="(prop,modos_offset_new_key)modo">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="modo_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Modificator: #(prop,modo_key)</i>
<call_job job="modo-write" />
<ti align="right" x="Did add Modificator '(prop,modo_how)'" />
<choose>
<when test="(f,has,prop,post_add_script_modo)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_modo)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="modo-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="modo-write">
<need>(prop,modo_key) (prop,isAdd)</need>
<spirit act="open" id="modos_spirit_tc" xml="(file,modos)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,modos_offset),/)">
<prop id="offset2" x="(f,substring,(prop,modos_offset),0,(f,sub,(f,len,(prop,modos_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,modos_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="modos_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;modo row="(prop,modo_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="modos_spirit_tc" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" attribute="how" value="(f,vob,prop,modo_how)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="modos_spirit_tc" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" attribute="where" value="(f,vob,prop,modo_where)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="modos_spirit_tc" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" attribute="with" value="(f,vob,prop,modo_with)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="modos_spirit_tc" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" attribute="with_what" value="(f,vob,prop,modo_with_what)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="modos_spirit_tc" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" attribute="attribute" value="(f,vob,prop,modo_attribute)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="modos_spirit_tc" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" attribute="value" value="(f,vob,prop,modo_value)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="modos_spirit_tc" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" attribute="flag" value="(f,vob,prop,modo_flag)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="modos_spirit_tc" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" attribute="off" value="(f,vob,prop,modo_off)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="modos_spirit_tc" where="(prop,modos_offset)modo[@row='(prop,modo_key)']" attribute="count" value="(f,vob,prop,modo_count)" />
<spirit act="close" flag="save pretty" id="modos_spirit_tc" />
</job></jobs>
