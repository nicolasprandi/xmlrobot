<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="sources">(dir,pro)sources.xml</file>
<when test="(f,not,(f,exists_file,(file,sources)))">
<create_file out="(file,sources)">&lt;sources/&gt;</create_file>
<i>Created: (file,sources)</i>
</when>
<prop id="sources_offset">./</prop>
<prop id="sources_offset_label"/>
<prop id="sources_offset_new_key">//</prop>
<prop id="sources_sort_attribute"/>
<prop id="sources_sort_number"/>
<prop id="sources_sort_ignore_case"/>
<prop id="sources_sort_desc"/>
<prop id="sources_where"/>
<prop id="sources_return_job">source-see-all</prop>
</prolog>
