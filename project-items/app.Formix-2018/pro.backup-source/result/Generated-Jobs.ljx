<need default="1">(prop,do_return_job)</need>
<call_job job="source-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Source [ (f,text,cut_nice,(prop,source_name),20) (prop,sources_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,sources)" where="(prop,sources_offset)source[@row='(prop,source_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,source_name),20) #(prop,source_key)</tp>
<ti label="Did delete Source:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,source_name),20)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="source-see-all" />
</job><job role="hidden" id="source-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Source(prop,sources_offset_label)" />
<prop x="sum" id="sources_tk_control" />
</when>
<otherwise>
<need>(prop,source_key)</need>
<prop id="label" x="Source [(f,text,cut_nice,(prop,source_name),20)](prop,sources_offset_label)" />
<prop x="sum_only" id="sources_tk_control" />
</otherwise>
</choose>
<call_job job="source-tk" />
</job><job id="source-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="source-editor" />
<prop id="source_key">1</prop>
<when test="(f,not,(f,exists,prop,sources_offset_new_key))">
<prop id="sources_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,sources)" sort="@row" number="@row" xpath="(prop,sources_offset_new_key)source">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="source_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Source: #(prop,source_key)</i>
<call_job job="source-write" />
<ti align="right" x="Did add Source '(f,text,cut_nice,(prop,source_name),20)'" />
<choose>
<when test="(f,has,prop,post_add_script_source)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_source)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="source-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="source-write">
<need>(prop,source_key) (prop,isAdd)</need>
<spirit act="open" id="sources_spirit_tc" xml="(file,sources)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,sources_offset),/)">
<prop id="offset2" x="(f,substring,(prop,sources_offset),0,(f,sub,(f,len,(prop,sources_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,sources_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="sources_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;source row="(prop,source_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<dir id="jack-in" x="(dir,source_dir_rel)" />
<prop id="jack-result-prop" x="anton" />
<prop id="jack-result-did-prop" x="berta" />
<call_service job="go-jack-do-dir" flag="silent">
<dir id="jack-in" x="(dir,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sources_spirit_tc" where="(prop,sources_offset)source[@row=(f,xpath_string,(prop,source_key))]" attribute="dir_rel" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sources_spirit_tc" where="(prop,sources_offset)source[@row='(prop,source_key)']" attribute="name" value="(f,vob,prop,source_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sources_spirit_tc" where="(prop,sources_offset)source[@row='(prop,source_key)']" attribute="includes" value="(f,vob,prop,source_includes)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="sources_spirit_tc" where="(prop,sources_offset)source[@row='(prop,source_key)']" attribute="excludes" value="(f,vob,prop,source_excludes)" />
<spirit act="close" flag="save pretty" id="sources_spirit_tc" />
