<call_job job="source-read" />
<prop id="isAdd">0</prop>
<call_job job="source-editor" />
<call_job job="source-write" />
<ti align="right" x="Did update Source '(f,text,cut_nice,(prop,source_name),20)'" />
<call_job job="source-see-all" />
</job><job role="hidden" id="source-del">
