<call_job job="kompzut-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Zutaten-Verwendung [ (f,text,cut_nice,(f,tk_sel_translate,(prop,kompzut_zut_key),(file,akt-zutatenliste)),20) (prop,kompzuts_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,kompzuts)" where="(prop,kompzuts_offset)kompzut[@row='(prop,kompzut_key)']" />
<tp>Deleted (f,text,cut_nice,(f,tk_sel_translate,(prop,kompzut_zut_key),(file,akt-zutatenliste)),20) #(prop,kompzut_key)</tp>
<ti label="Did delete Zutaten-Verwendung:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(f,tk_sel_translate,(prop,kompzut_zut_key),(file,akt-zutatenliste)),20)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
