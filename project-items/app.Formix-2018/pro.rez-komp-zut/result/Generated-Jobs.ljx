<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Zutaten-Verwendung(prop,kompzuts_offset_label)" />
<prop x="sum" id="kompzuts_tk_control" />
</when>
<otherwise>
<need>(prop,kompzut_key)</need>
<prop id="label" x="Zutaten-Verwendung [(f,text,cut_nice,(f,tk_sel_translate,(prop,kompzut_zut_key),(file,akt-zutatenliste)),20)](prop,kompzuts_offset_label)" />
<prop x="sum_only" id="kompzuts_tk_control" />
</otherwise>
</choose>
<call_job job="kompzut-tk" />
</job><job id="kompzut-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="kompzut-editor" />
<prop id="kompzut_key">1</prop>
<when test="(f,not,(f,exists,prop,kompzuts_offset_new_key))">
<prop id="kompzuts_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,kompzuts)" sort="@row" number="@row" xpath="(prop,kompzuts_offset_new_key)kompzut">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="kompzut_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Zutaten-Verwendung: #(prop,kompzut_key)</i>
<call_job job="kompzut-write" />
<ti align="right" x="Did add Zutaten-Verwendung '(f,text,cut_nice,(f,tk_sel_translate,(prop,kompzut_zut_key),(file,akt-zutatenliste)),20)'" />
<choose>
<when test="(f,has,prop,post_add_script_kompzut)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_kompzut)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="make-after-zuord-add" />
</otherwise>
</choose>
</job><job role="hidden" id="kompzut-write">
<need>(prop,kompzut_key) (prop,isAdd)</need>
<spirit act="open" id="kompzuts_spirit_tc" xml="(file,kompzuts)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,kompzuts_offset),/)">
<prop id="offset2" x="(f,substring,(prop,kompzuts_offset),0,(f,sub,(f,len,(prop,kompzuts_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,kompzuts_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="kompzuts_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;kompzut row="(prop,kompzut_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="kompzuts_spirit_tc" where="(prop,kompzuts_offset)kompzut[@row='(prop,kompzut_key)']" attribute="zut_key" value="(f,vob,prop,kompzut_zut_key)" />
<when test="(f,exists,prop,kompzut_komp_key)">
<spirit act="xml_update" how="set_attribute" flag="remove" id="kompzuts_spirit_tc" where="(prop,kompzuts_offset)kompzut[@row='(prop,kompzut_key)']" attribute="komp_key" value="(f,vob,prop,kompzut_komp_key)" />
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="kompzuts_spirit_tc" where="(prop,kompzuts_offset)kompzut[@row='(prop,kompzut_key)']" attribute="anteil" value="(f,vob,prop,kompzut_anteil)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="kompzuts_spirit_tc" where="(prop,kompzuts_offset)kompzut[@row='(prop,kompzut_key)']" attribute="besch" value="(f,vob,prop,kompzut_besch)" />
<spirit act="close" flag="save pretty" id="kompzuts_spirit_tc" />
</job></jobs>
