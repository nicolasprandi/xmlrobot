<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="kompzuts">(dir,pro)kompzuts.xml</file>
<when test="(f,not,(f,exists_file,(file,kompzuts)))">
<create_file out="(file,kompzuts)">&lt;kompzuts/&gt;</create_file>
<i>Created: (file,kompzuts)</i>
</when>
<prop id="kompzuts_offset">./</prop>
<prop id="kompzuts_offset_label"/>
<prop id="kompzuts_offset_new_key">//</prop>
<prop id="kompzuts_sort_attribute"/>
<prop id="kompzuts_sort_number"/>
<prop id="kompzuts_sort_ignore_case"/>
<prop id="kompzuts_sort_desc"/>
<prop id="kompzuts_where"/>
<prop id="kompzuts_return_job">kompzut-see-all</prop>
</prolog>
