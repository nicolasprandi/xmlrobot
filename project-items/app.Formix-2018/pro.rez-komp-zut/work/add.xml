<?xml version="1.0" encoding="UTF-8"?><job id="kompzut-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="kompzut-editor"/>
<prop id="kompzut_key">1</prop>
<when test="(f,not,(f,exists,prop,kompzuts_offset_new_key))">
<prop id="kompzuts_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,kompzuts)" sort="@row" number="@row" xpath="(prop,kompzuts_offset_new_key)kompzut">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="kompzut_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Zutaten-Verwendung: #(prop,kompzut_key)</i>
<call_job job="kompzut-write"/>
<ti align="right" x="Did add Zutaten-Verwendung '(f,text,cut_nice,(f,tk_sel_translate,(prop,kompzut_zut_key),(file,akt-zutatenliste)),20)'"/>
<choose>
<when test="(f,has,prop,post_add_script_kompzut)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_kompzut)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="make-after-zuord-add"/>
</otherwise>
</choose>
</job>
