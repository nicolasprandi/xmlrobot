<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="kompzut-editor">
<try_catch>
<try>
<call_job job="hook-kompzutat-editor-begin"/>
</try>
<catch>
<ti label="Hook must be implemented: kompzut-editor: begin.0">
<ti> hook_job=hook-kompzutat-editor-begin hook=begin page=editor station=0 object=kompzut</ti>
</ti>
<tk type="msg" x="You have to implement the hook!"/>
<throw_again/>
</catch>
</try_catch>
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Zutaten-Verwendung(prop,kompzuts_offset_label)"/>
<prop x="sum" id="kompzuts_tk_control"/>
</when>
<otherwise>
<need>(prop,kompzut_key)</need>
<prop id="label" x="Zutaten-Verwendung [(f,text,cut_nice,(f,tk_sel_translate,(prop,kompzut_zut_key),(file,akt-zutatenliste)),20)](prop,kompzuts_offset_label)"/>
<prop x="sum_only" id="kompzuts_tk_control"/>
</otherwise>
</choose>
<call_job job="kompzut-tk"/>
</job>
