<?xml version="1.0" encoding="UTF-8"?><job id="kompzut-see-all" level="ws" role="hidden" tip="Lists all Zutenten-Verwendungen">
<prop id="nothing">1</prop>
<loop missing_strategy="empty" id="kompzut_loop" xml="(file,kompzuts)" xpath="(prop,kompzuts_offset)kompzut(prop,kompzuts_where)" sort="(prop,kompzuts_sort_attribute)" number="(prop,kompzuts_sort_number)" ignore_case="(prop,kompzuts_sort_ignore_case)" desc="(prop,kompzuts_sort_desc)">
<when test="(prop,nothing)">
<when test="(f,gt,(f,len,(prop,kompzuts_offset_label)),0)">
<ti label="(prop,kompzuts_offset_label)"/>
</when>
<prop id="nothing">0</prop>
</when>
<try_catch>
<try>
<call_job job="eine-zutatenverwendung-vorbereiten"/>
</try>
<catch>
<ti label="Hook must be implemented: kompzut-view: 2.0">
<ti> hook_job=eine-zutatenverwendung-vorbereiten hook=2 page=view station=0 object=kompzut</ti>
</ti>
<tk type="msg" x="You have to implement the hook!"/>
<throw_again/>
</catch>
</try_catch>
<ti type="rec">
<ti type="call_job" flag="block" prefix="  " explain="(f,html,bold,open)(f,text,cut_nice,(f,tk_sel_translate,(loop,kompzut_loop,@zut_key),(file,akt-zutatenliste)),20)(f,html,bold,close)" job="kompzut-see">
<prop id="kompzut_key">(loop,kompzut_loop,@row)</prop>
<file id="kompzuts">(file,kompzuts)</file>
<prop id="kompzuts_offset">(prop,kompzuts_offset)</prop>
<prop id="kompzuts_offset_label">(prop,kompzuts_offset_label)</prop>
<prop id="kompzuts_offset_new_key">(prop,kompzuts_offset_new_key)</prop>
<prop id="kompzuts_sort_attribute">(prop,kompzuts_sort_attribute)</prop>
<prop id="kompzuts_sort_number">(prop,kompzuts_sort_number)</prop>
<prop id="kompzuts_where">(prop,kompzuts_where)</prop>
<prop id="kompzuts_return_job">(prop,kompzuts_return_job)</prop>
<file id="rezs">(file,rezs)</file>
<prop id="rezs_offset">(prop,rezs_offset)</prop>
<prop id="rezs_offset_label">(prop,rezs_offset_label)</prop>
<prop id="rezs_offset_new_key">(prop,rezs_offset_new_key)</prop>
<prop id="rezs_sort_attribute">(prop,rezs_sort_attribute)</prop>
<prop id="rezs_sort_number">(prop,rezs_sort_number)</prop>
<prop id="rezs_where">(prop,rezs_where)</prop>
<prop id="rezs_return_job">(prop,rezs_return_job)</prop>
<prop id="rez_key">(prop,rez_key)</prop>
</ti>
<ti>(prop,ein-mengentext)</ti>
</ti>
</loop>
<when test="(prop,nothing)">
<ti label=" ">Keine Zutaten-Verwendung gefunden</ti>
</when>
<when test="(f,not,(f,contains,(prop,kompzuts_offset),node(e:o)(e:c)))">
<ti type="rec" label=" ">
<ti type="call_job" job="neue-zuordnung" explain="[ + Zutat verwenden ]" label=" " test="(f,role,business)" >
  <prop id="rez_key">(prop,rez_key)</prop>
  <prop id="komp_key">(f,substring_before,(f,substring_after,(prop,kompzuts_where),[@komp_key=&apos;),&apos;])</prop>
  <!-- <prop id="komp_key">(f,substring_before,(f,substring,(prop,kompzuts_where),(prop,komp_key),11),'])</prop>        -->
  <prop id="rezeptname">ooo</prop>
</ti>
<ti flag="no_arrow" test="(f,role,business)" label=" " type="call_job" explain="/ Sort /" job="do-org-me">
<file id="orga">(file,kompzuts)</file>
<prop id="orga_where">(prop,kompzuts_where)</prop>
<prop id="orga_view_loop_id">kompzut_loop</prop>
<prop id="orga_finished_job">did-finish-orga-rezkomp</prop>
<prop id="orga_offset">(prop,kompzuts_offset)</prop>
<prop id="orga_offset_label">(prop,kompzuts_offset_label)</prop>
<prop id="orga_offset_new_key">(prop,kompzuts_offset_new_key)</prop>
<prop id="orga_segment_plural">kompzuts</prop>
<prop id="orga_segment_singular">kompzut</prop>
<prop id="orga_segment_plural_label">Zutenten-Verwendungen</prop>
<prop id="orga_segment_singular_label">Zutaten-Verwendung</prop>
<prop id="orga_sort_attribute">(prop,kompzuts_sort_attribute)</prop>
<prop id="orga_sort_number">(prop,kompzuts_sort_number)</prop>
<prop id="orga_where">(prop,kompzuts_where)</prop>
<prop id="orga_name_expression_loop">()(f,text,cut_nice,(f,tk_sel_translate,(loop,kompzut_loop,@zut_key),(file,akt-zutatenliste)),20)()</prop>
<prop id="orga_desc_expression_loop">()()</prop>
<file id="rezs">(file,rezs)</file>
<prop id="rezs_offset">(prop,rezs_offset)</prop>
<prop id="rezs_offset_label">(prop,rezs_offset_label)</prop>
<prop id="rezs_offset_new_key">(prop,rezs_offset_new_key)</prop>
<prop id="rezs_sort_attribute">(prop,rezs_sort_attribute)</prop>
<prop id="rezs_sort_number">(prop,rezs_sort_number)</prop>
<prop id="rezs_where">(prop,rezs_where)</prop>
<prop id="rezs_return_job">(prop,rezs_return_job)</prop>
<prop id="rez_key">(prop,rez_key)</prop>
</ti>
</ti>
</when>
<when test="(f,has_flag,debug trace all,(f,interpreter,level))">
<ti_hr/>
<ti label="Debug Information">
<ti label="File:" type="file">(file,kompzuts)</ti>
<ti label="Xml-Offset:" test="(f,gt_num,(f,len,(prop,kompzuts_offset)),0)">(prop,kompzuts_offset)</ti>
</ti>
</when>
</job>