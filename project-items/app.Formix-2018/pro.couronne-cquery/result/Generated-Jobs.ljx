<need>(prop,squery_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="squery-read" />
<prop id="isAdd">0</prop>
<call_job job="squery-editor" />
<call_job job="squery-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+/- (prop,_sl_squery) '(f,text,cut_nice,(prop,squery_id),50)'" />
</ti>
<call_job job="event_post_update_squery" />
</job><job role="hidden" id="squery-del">
<need>(prop,squery_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="squery-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_squery) [ (f,text,cut_nice,(prop,squery_id),50) (prop,squerys_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,squerys)" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,squery_id),50) #(prop,squery_key)</tp>
<ti label="- (prop,_sl_squery):" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,squery_id),50)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="squery-see-all" />
</job><job role="hidden" id="squery-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="squery_default_label_class" x="+ (prop,_sl_squery)" />
<prop id="squery_default_label_name" x="(f,when,(f,has,(prop,squerys_offset_label)), | (prop,squerys_offset_label),)" />
<prop id="squerys_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,squery_key)</need>
<prop id="squery_default_label_class" x="(prop,_sl_squery)" />
<prop id="squery_default_label_name" x="(f,text,cut_nice,(prop,squery_id),50)(f,when,(f,has,(prop,squerys_offset_label)), - (prop,squerys_offset_label),)" />
<prop id="squerys_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="squery-tk" />
</job><job id="squery-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>

<prop id="squery_key">1</prop>
<when test="(f,not,(f,exists,prop,squerys_offset_new_key))">
<prop id="squerys_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,squerys)" sort="@row" number="@row" xpath="(prop,squerys_offset_new_key)squery">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="squery_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<call_job job="squery-editor" />
<i>Generated Key for new (prop,_sl_squery): #(prop,squery_key)</i>
<call_job job="squery-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_squery) '(f,text,cut_nice,(prop,squery_id),50)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_squery)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_squery)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="event_post_insert_squery" />
</otherwise>
</choose>
</job><job role="hidden" id="squery-write">
<need>(prop,squery_key) (prop,isAdd)</need>
<need default="./">(prop,squerys_offset)</need>
<spirit act="open" id="squerys_spirit_tc" xml="(file,squerys)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,squerys_offset),/)">
<prop id="offset2" x="(f,substring,(prop,squerys_offset),0,(f,sub,(f,len,(prop,squerys_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,squerys_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in_begin" id="squerys_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;squery row="(prop,squery_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="sql" value="(f,vob,prop,squery_sql)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="id" value="(f,vob,prop,squery_id)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="class1" value="(f,vob,prop,squery_class1)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="desc" value="(f,vob,prop,squery_desc)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="limit_typ" value="(f,vob,prop,squery_limit_typ)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="limit_indiv" value="(f,vob,prop,squery_limit_indiv)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="prolog" value="(f,vob,prop,squery_prolog)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="translate" value="(f,vob,prop,squery_translate)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="archify" value="(f,vob,prop,squery_archify)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="squerys_spirit_tc" where="(prop,squerys_offset)squery[@row='(prop,squery_key)']" attribute="trim" value="(f,vob,prop,squery_trim)" />
<spirit act="close" flag="save pretty" id="squerys_spirit_tc" />
</job></jobs>
