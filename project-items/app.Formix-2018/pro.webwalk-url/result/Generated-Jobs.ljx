    <need>(prop,url_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="url-read" />
    <prop id="isAdd">0</prop>
    <call_job job="url-editor" />
    <call_job job="url-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+/- Url '(f,text,cut_nice,(prop,url_url),50)'" />
    </ti>
    <call_job job="url-see" />
</job><job role="hidden" id="url-del">
    <need>(prop,url_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="url-read" />
    <tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Url [ (f,text,cut_nice,(prop,url_url),50) (prop,urls_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
        <q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
    </tk>
    <choose>
        <when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
            <xml_update how="remove" what="(file,urls)" where="(prop,urls_offset)url[@row='(prop,url_key)']" />
            <tp>Deleted (f,text,cut_nice,(prop,url_url),50) #(prop,url_key)</tp>
            <ti label="- Url:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,url_url),50)(f,html,bold,close)(f,html,bold,close)" />
            <ti_hr />
            <when test="(prop,do_return_job)" />
        </when>
        <otherwise>
            <tp>No delete performed.</tp>
            <ti>No delete performed.</ti>
        </otherwise>
    </choose>
    <call_job job="url-see-all" />
</job><job role="hidden" id="url-editor">
    <need>(prop,isAdd)</need>
    <choose>
        <when test="(prop,isAdd)">
            <prop id="url_default_label_class" x="+ Url" />
            <prop id="url_default_label_name" x="(f,when,(f,has,(prop,urls_offset_label)), | (prop,urls_offset_label),)" />
            <prop id="urls_tk_control" x="sum" />
        </when>
        <otherwise>
            <need>(prop,url_key)</need>
            <prop id="url_default_label_class" x="Url" />
            <prop id="url_default_label_name" x="(f,text,cut_nice,(prop,url_url),50)(f,when,(f,has,(prop,urls_offset_label)), - (prop,urls_offset_label),)" />
            <prop id="urls_tk_control" x="sum_only" />
        </otherwise>
    </choose>
    <call_job job="url-tk" />
</job><job id="url-add" level="ws" role="hidden">
    x
    <prop id="isAdd">1</prop>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="url-editor" />
    <prop id="url_key">1</prop>
    <when test="(f,not,(f,exists,prop,urls_offset_new_key))">
        <prop id="urls_offset_new_key">//</prop>
    </when>
    <loop id="max" limit="1" flag="back" xml="(file,urls)" sort="@row" number="@row" xpath="(prop,urls_offset_new_key)url">
        <trace>max key=(loop,max,@row)</trace>
        <trace>i=(loop,max,#i)</trace>
        <prop id="url_key">(f,add,(loop,max,@row),1)</prop>
    </loop>
    <i>Generated Key for new Url: #(prop,url_key)</i>
    <call_job job="url-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+ Url '(f,text,cut_nice,(prop,url_url),50)'" />
    </ti>
    <choose>
        <when test="(f,has,prop,post_add_script_url)">
            <file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
            <prop id="formix-posting-code" x="(f,random_text,16)" />
            <create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_url)</create_file>
            <include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
            <delete file="(file,formix-posting)" />
            <remove type="file" id="formix-posting" />
            <remove type="prop" id="formix-posting-code" />
        </when>
        <otherwise>
            <call_job job="event_post_update_url" />
        </otherwise>
    </choose>
</job><job role="hidden" id="url-write">
    <need>(prop,url_key) (prop,isAdd)</need>
    <need default="./">(prop,urls_offset)</need>
    <spirit act="open" id="urls_spirit_tc" xml="(file,urls)" />
    <when test="(prop,isAdd)">
        <choose>
            <when test="(f,ends_with,(prop,urls_offset),/)">
                <prop id="offset2" x="(f,substring,(prop,urls_offset),0,(f,sub,(f,len,(prop,urls_offset)),1))" />
            </when>
            <otherwise>
                <prop id="offset2" x="(prop,urls_offset)" />
            </otherwise>
        </choose>
        <spirit act="xml_update" how="insert_in" id="urls_spirit_tc" where="(prop,offset2)">
            <inline attribute="with">&lt;url row="(prop,url_key)" /&gt;</inline>
        </spirit>
        <i>Added a new record</i>
    </when>
    <spirit act="xml_update" how="set_attribute" flag="remove" id="urls_spirit_tc" where="(prop,urls_offset)url[@row='(prop,url_key)']" attribute="url" value="(f,vob,prop,url_url)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="urls_spirit_tc" where="(prop,urls_offset)url[@row='(prop,url_key)']" attribute="desc" value="(f,vob,prop,url_desc)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="urls_spirit_tc" where="(prop,urls_offset)url[@row='(prop,url_key)']" attribute="history" value="(f,vob,prop,url_history)" />
    <spirit act="close" flag="save pretty" id="urls_spirit_tc" />
</job></jobs>
