<?xml version="1.0" encoding="UTF-8"?><job id="url-see-all" level="ws" role="hidden">
    <need default="">(prop,urls_sort_attribute)</need>
    <need default="">(prop,urls_sort_number)</need>
    <need default="">(prop,urls_sort_ignore_case)</need>
    <need default="">(prop,urls_sort_desc)</need>
    <need default="">(prop,urls_where)</need>
    <need default="">(prop,urls_offset_label)</need>
    <need default="./">(prop,urls_offset)</need>
    <need default="">(prop,urls_return_job)</need>
    <need default="//">(prop,urls_offset_new_key)</need>
    <need default="0">(prop,urls_no_header)</need>
    <try_catch>
        <try>
            <call_job job="event_url_begin"/>
        </try>
        <catch>
            <ti label="Hook must be implemented: url-view: begin.0">
                <ti> hook_job=event_url_begin hook=begin page=view station=0 object=url</ti>
            </ti>
            <tk type="msg" x="You have to implement the hook!"/>
            <throw_again/>
        </catch>
    </try_catch>
    <prop id="nothing">(f,not,(prop,urls_no_header))</prop>
    <loop missing_strategy="empty" id="url_loop" xml="(file,urls)" xpath="(prop,urls_offset)url(prop,urls_where)" sort="(prop,urls_sort_attribute)" number="(prop,urls_sort_number)" ignore_case="(prop,urls_sort_ignore_case)" desc="(prop,urls_sort_desc)">
        <when test="(prop,nothing)">
            <when test="(f,gt,(f,len,(prop,urls_offset_label)),0)">
                <ti label="(prop,urls_offset_label)"/>
            </when>
            <prop id="nothing">0</prop>
        </when>
        <ti type="rec">
            <ti flag="" type="call_job" prefix="  " explain="(f,html,bold,open)(f,text,cut_nice,(loop,url_loop,@url),50)(f,html,bold,close)" job="event_url_go">
                <prop id="url_key">(loop,url_loop,@row)</prop>
                <file id="urls">(file,urls)</file>
                <prop id="urls_offset">(prop,urls_offset)</prop>
                <prop id="urls_offset_label">(prop,urls_offset_label)</prop>
                <prop id="urls_offset_new_key">(prop,urls_offset_new_key)</prop>
                <prop id="urls_sort_attribute">(prop,urls_sort_attribute)</prop>
                <prop id="urls_sort_number">(prop,urls_sort_number)</prop>
                <prop id="urls_sort_ignore_case">(prop,urls_sort_ignore_case)</prop>
                <prop id="urls_sort_desc">(prop,urls_sort_desc)</prop>
                <prop id="urls_where">(prop,urls_where)</prop>
                <prop id="urls_return_job">(prop,urls_return_job)</prop>
            </ti>
            <ti type="menu">
                <ti isFromAction="1" type="call_job" page="view" explain="See" job="url-see">
                    <prop id="greetings_from_page">view</prop>
                    <prop id="greetings_from_action">see</prop>
                    <prop page="view" id="url_key">(loop,url_loop,@row)</prop>
                    <file id="urls">(file,urls)</file>
                    <prop id="urls_offset">(prop,urls_offset)</prop>
                    <prop id="urls_offset_label">(prop,urls_offset_label)</prop>
                    <prop id="urls_offset_new_key">(prop,urls_offset_new_key)</prop>
                    <prop id="urls_sort_attribute">(prop,urls_sort_attribute)</prop>
                    <prop id="urls_sort_number">(prop,urls_sort_number)</prop>
                    <prop id="urls_sort_ignore_case">(prop,urls_sort_ignore_case)</prop>
                    <prop id="urls_sort_desc">(prop,urls_sort_desc)</prop>
                    <prop id="urls_where">(prop,urls_where)</prop>
                    <prop id="urls_return_job">(prop,urls_return_job)</prop>
                </ti>
            </ti>
        </ti>
    </loop>
    <when test="(prop,nothing)">
        <ti type="rec">
            <ti flag="wrap_word">No Urls found</ti>
        </ti>
    </when>
    <when test="(f,not,(f,contains,(prop,urls_offset),node(e:o)(e:c)))">
        <ti type="rec" label=" ">
            <ti type="menu" span="10">
                <ti label=" " type="call_job" explain_nix="url-add" explain="  + Url " job="url-add">
                    <file id="urls">(file,urls)</file>
                    <prop id="urls_offset">(prop,urls_offset)</prop>
                    <prop id="urls_offset_label">(prop,urls_offset_label)</prop>
                    <prop id="urls_offset_new_key">(prop,urls_offset_new_key)</prop>
                    <prop id="urls_sort_attribute">(prop,urls_sort_attribute)</prop>
                    <prop id="urls_sort_number">(prop,urls_sort_number)</prop>
                    <prop id="urls_sort_ignore_case">(prop,urls_sort_ignore_case)</prop>
                    <prop id="urls_sort_desc">(prop,urls_sort_desc)</prop>
                    <prop id="urls_where">(prop,urls_where)</prop>
                    <prop id="urls_return_job">(prop,urls_return_job)</prop>
                </ti>
                <ti test="(f,not,(prop,nothing))" label=" " type="call_job" explain="Sort &amp; Delete" job="do-org-me">
                    <file id="orga">(file,urls)</file>
                    <prop id="orga_where">(prop,urls_where)</prop>
                    <prop id="orga_view_loop_id">url_loop</prop>
                    <prop id="orga_finished_job">url-see-all</prop>
                    <prop id="orga_offset">(prop,urls_offset)</prop>
                    <prop id="orga_offset_label">(prop,urls_offset_label)</prop>
                    <prop id="orga_offset_new_key">(prop,urls_offset_new_key)</prop>
                    <prop id="orga_segment_plural">urls</prop>
                    <prop id="orga_segment_singular">url</prop>
                    <prop id="orga_segment_plural_label">Urls</prop>
                    <prop id="orga_segment_singular_label">Url</prop>
                    <prop id="orga_sort_attribute">(prop,urls_sort_attribute)</prop>
                    <prop id="orga_sort_number">(prop,urls_sort_number)</prop>
                    <prop id="orga_where">(prop,urls_where)</prop>
                    <prop id="orga_name_expression_loop">()(f,text,cut_nice,(loop,url_loop,@url),50)()</prop>
                    <prop id="orga_desc_expression_loop">()()</prop>
                </ti>
            </ti>
        </ti>
    </when>
    <when test="(f,has_flag,debug trace all,(f,interpreter,level))">
        <ti_hr/>
        <ti label="Debug Information">
            <ti label="File:" type="file">(file,urls)</ti>
            <ti label="Xml-Offset:" test="(f,gt_num,(f,len,(prop,urls_offset)),0)">(prop,urls_offset)</ti>
        </ti>
    </when>
</job>