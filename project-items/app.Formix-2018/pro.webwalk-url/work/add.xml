<?xml version="1.0" encoding="UTF-8"?><job id="url-add" level="ws" role="hidden">
    x
    <prop id="isAdd">1</prop>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="url-editor"/>
    <prop id="url_key">1</prop>
    <when test="(f,not,(f,exists,prop,urls_offset_new_key))">
        <prop id="urls_offset_new_key">//</prop>
    </when>
    <loop id="max" limit="1" flag="back" xml="(file,urls)" sort="@row" number="@row" xpath="(prop,urls_offset_new_key)url">
        <trace>max key=(loop,max,@row)</trace>
        <trace>i=(loop,max,#i)</trace>
        <prop id="url_key">(f,add,(loop,max,@row),1)</prop>
    </loop>
    <i>Generated Key for new Url: #(prop,url_key)</i>
    <call_job job="url-write"/>
    <ti_break class_table="tabNavigator"/>
    <ti type="rec">
        <ti align="right" x="+ Url '(f,text,cut_nice,(prop,url_url),50)'"/>
    </ti>
    <choose>
        <when test="(f,has,prop,post_add_script_url)">
            <file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
            <prop id="formix-posting-code" x="(f,random_text,16)"/>
            <create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_url)</create_file>
            <include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
            <delete file="(file,formix-posting)"/>
            <remove type="file" id="formix-posting"/>
            <remove type="prop" id="formix-posting-code"/>
        </when>
        <otherwise>
            <call_job job="event_post_update_url"/>
        </otherwise>
    </choose>
</job>
