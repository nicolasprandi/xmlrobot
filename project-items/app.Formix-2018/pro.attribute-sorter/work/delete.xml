<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="attribute-del">
<need>(prop,attribute_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="attribute-read"/>
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting [ (prop,attribute_name) (prop,attributes_offset_label)] ?" x="Do you really want to delete that?&#10;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()"/>
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,attributes)" where="(prop,attributes_offset)attribute[@row='(prop,attribute_key)']"/>
<i>Deleted (prop,attribute_name) #(prop,attribute_key)(e:s) (prop,attribute_name)</i>
<ti label="Did delete Attribute:" x="(f,html,bold,open)(prop,attribute_name)(f,html,bold,close)"/>
<ti_hr/>
<when test="(prop,do_return_job)">
<call_job job="(prop,attributes_return_job)"/>
</when>
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
</job>
