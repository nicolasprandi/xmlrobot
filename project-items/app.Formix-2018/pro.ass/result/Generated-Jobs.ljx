</job><job role="hidden" id="ass-edit">
<need>(prop,ass_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="ass-read" />
<prop id="isAdd">0</prop>
<call_job job="ass-editor" />
<call_job job="ass-write" />
<ti label="Did update Arbeitsschritt:" x="(f,html,bold,open)(prop,ass_bez)(f,html,bold,close)" />
<ti_break />
<ti_hr />
<call_job job="ass-see-all-event" />
</job><job role="hidden" id="ass-del">
<need>(prop,ass_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="ass-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Arbeitsschritt [ (prop,ass_bez) (prop,asss_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,asss)" where="(prop,asss_offset)ass[@row='(prop,ass_key)']" />
<tp>Deleted (prop,ass_bez) #(prop,ass_key)</tp>
<ti label="Did delete Arbeitsschritt:" x="(f,html,bold,open)(f,html,bold,open)(prop,ass_bez)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="ass-see-all-event" />
</job><job role="hidden" id="ass-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Arbeitsschritt(prop,asss_offset_label)" />
<prop x="sum" id="asss_tk_control" />
</when>
<otherwise>
<need>(prop,ass_key)</need>
<prop id="label" x="Arbeitsschritt [(prop,ass_bez)](prop,asss_offset_label)" />
<prop x="sum_only" id="asss_tk_control" />
</otherwise>
</choose>
<call_job job="ass-tk" />
</job><job id="ass-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="ass-editor" />
<prop id="ass_key">1</prop>
<when test="(f,not,(f,exists,prop,asss_offset_new_key))">
<prop id="asss_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,asss)" sort="@row" number="@row" xpath="(prop,asss_offset_new_key)ass">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="ass_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Arbeitsschritt: #(prop,ass_key)</i>
<call_job job="ass-write" />
<ti label="Did add Arbeitsschritt:" x="(f,html,bold,open)(prop,ass_bez)(f,html,bold,close)" />
<ti_hr />
<choose>
<when test="(f,has,prop,post_add_script_ass)">
<create_file file="(dir,temp)abdert.xrs">(prop,post_add_script_ass)</create_file>
<include file="(dir,temp)abdert.xrs" />
</when>
<otherwise>
<call_job job="ass-see-all-event" />
</otherwise>
</choose>
</job><job role="hidden" id="ass-write">
<need>(prop,ass_key) (prop,isAdd)</need>
<spirit act="open" id="asss_spirit_tc" xml="(file,asss)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,asss_offset),/)">
<prop id="offset2" x="(f,substring,(prop,asss_offset),0,(f,sub,(f,len,(prop,asss_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,asss_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="asss_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;ass row="(prop,ass_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="asss_spirit_tc" where="(prop,asss_offset)ass[@row='(prop,ass_key)']" attribute="bez" value="(f,vob,prop,ass_bez)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="asss_spirit_tc" where="(prop,asss_offset)ass[@row='(prop,ass_key)']" attribute="beschreibung" value="(f,vob,prop,ass_beschreibung)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="asss_spirit_tc" where="(prop,asss_offset)ass[@row='(prop,ass_key)']" attribute="dauer" value="(f,vob,prop,ass_dauer)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="asss_spirit_tc" where="(prop,asss_offset)ass[@row='(prop,ass_key)']" attribute="einheit" value="(f,vob,prop,ass_einheit)" />
<spirit act="close" flag="save pretty" id="asss_spirit_tc" />
</job></jobs>
