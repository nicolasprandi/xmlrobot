</job><job role="hidden" id="ass-read">
<need>(prop,ass_key)</need>
<spirit act="open" missing_strategy="empty" id="asss_spirit_tc" xml="(file,asss)" />
<prop id="ass_dt_upd">(f,spirit,asss_spirit_tc,(prop,asss_offset)ass[@row=(f,xpath_string,(prop,ass_key))],@dt_upd)</prop>
