                    <prop id="imps_offset_label">(prop,imps_offset_label)</prop>
                    <prop id="imps_offset_new_key">(prop,imps_offset_new_key)</prop>
                    <prop id="imps_sort_attribute">(prop,imps_sort_attribute)</prop>
                    <prop id="imps_sort_number">(prop,imps_sort_number)</prop>
                    <prop id="imps_sort_ignore_case">(prop,imps_sort_ignore_case)</prop>
                    <prop id="imps_sort_desc">(prop,imps_sort_desc)</prop>
                    <prop id="imps_where">(prop,imps_where)</prop>
                    <prop id="imps_return_job">(prop,imps_return_job)</prop>
                </ti>
            </ti>
        </otherwise>
    </choose>
    <ti_break />
</job><job role="hidden" id="imp-edit">
    <need>(prop,imp_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="imp-read" />
    <prop id="isAdd">0</prop>
    <call_job job="imp-editor" />
    <call_job job="imp-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+/- Index Manipulation Point '(f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml)'" />
    </ti>
    <call_job job="imp-see-all" />
</job><job role="hidden" id="imp-del">
    <need>(prop,imp_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="imp-read" />
    <tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Index Manipulation Point [ (f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml) (prop,imps_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
        <q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
    </tk>
    <choose>
        <when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
            <xml_update how="remove" what="(file,imps)" where="(prop,imps_offset)imp[@row='(prop,imp_key)']" />
            <tp>Deleted (f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml) #(prop,imp_key)</tp>
            <ti label="- Index Manipulation Point:" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml)(f,html,bold,close)(f,html,bold,close)" />
            <ti_hr />
            <when test="(prop,do_return_job)" />
        </when>
        <otherwise>
            <tp>No delete performed.</tp>
            <ti>No delete performed.</ti>
        </otherwise>
    </choose>
    <call_job job="imp-see-all" />
</job><job role="hidden" id="imp-editor">
    <need>(prop,isAdd)</need>
    <choose>
        <when test="(prop,isAdd)">
            <prop id="imp_default_label_class" x="+ Index Manipulation Point" />
            <prop id="imp_default_label_name" x="(f,when,(f,has,(prop,imps_offset_label)), | (prop,imps_offset_label),)" />
            <prop id="imps_tk_control" x="sum" />
        </when>
        <otherwise>
            <need>(prop,imp_key)</need>
            <prop id="imp_default_label_class" x="Index Manipulation Point" />
            <prop id="imp_default_label_name" x="(f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml)(f,when,(f,has,(prop,imps_offset_label)), - (prop,imps_offset_label),)" />
            <prop id="imps_tk_control" x="sum_only" />
        </otherwise>
    </choose>
    <call_job job="imp-tk" />
</job><job id="imp-add" level="ws" role="hidden">
    <prop id="isAdd">1</prop>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="imp-editor" />
    <prop id="imp_key">1</prop>
    <when test="(f,not,(f,exists,prop,imps_offset_new_key))">
        <prop id="imps_offset_new_key">//</prop>
    </when>
    <loop id="max" limit="1" flag="back" xml="(file,imps)" sort="@row" number="@row" xpath="(prop,imps_offset_new_key)imp">
        <trace>max key=(loop,max,@row)</trace>
        <trace>i=(loop,max,#i)</trace>
        <prop id="imp_key">(f,add,(loop,max,@row),1)</prop>
    </loop>
    <i>Generated Key for new Index Manipulation Point: #(prop,imp_key)</i>
    <call_job job="imp-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+ Index Manipulation Point '(f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml)'" />
    </ti>
    <choose>
        <when test="(f,has,prop,post_add_script_imp)">
            <file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
            <prop id="formix-posting-code" x="(f,random_text,16)" />
            <create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_imp)</create_file>
            <include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
            <delete file="(file,formix-posting)" />
            <remove type="file" id="formix-posting" />
            <remove type="prop" id="formix-posting-code" />
        </when>
        <otherwise>
            <call_job job="imp-see-all" />
        </otherwise>
    </choose>
</job><job role="hidden" id="imp-write">
    <need>(prop,imp_key) (prop,isAdd)</need>
    <need default="./">(prop,imps_offset)</need>
    <spirit act="open" id="imps_spirit_tc" xml="(file,imps)" />
    <when test="(prop,isAdd)">
        <choose>
            <when test="(f,ends_with,(prop,imps_offset),/)">
                <prop id="offset2" x="(f,substring,(prop,imps_offset),0,(f,sub,(f,len,(prop,imps_offset)),1))" />
            </when>
            <otherwise>
                <prop id="offset2" x="(prop,imps_offset)" />
            </otherwise>
        </choose>
        <spirit act="xml_update" how="insert_in" id="imps_spirit_tc" where="(prop,offset2)">
            <inline attribute="with">&lt;imp row="(prop,imp_key)" /&gt;</inline>
        </spirit>
        <i>Added a new record</i>
    </when>
    <spirit act="xml_update" how="set_attribute" flag="remove" id="imps_spirit_tc" where="(prop,imps_offset)imp[@row='(prop,imp_key)']" attribute="point" value="(f,vob,prop,imp_point)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="imps_spirit_tc" where="(prop,imps_offset)imp[@row='(prop,imp_key)']" attribute="on" value="(f,vob,prop,imp_on)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="imps_spirit_tc" where="(prop,imps_offset)imp[@row='(prop,imp_key)']" attribute="desc" value="(f,vob,prop,imp_desc)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="imps_spirit_tc" where="(prop,imps_offset)imp[@row='(prop,imp_key)']" attribute="work" value="(f,vob,prop,imp_work)" />
    <spirit act="close" flag="save pretty" id="imps_spirit_tc" />
</job></jobs>
