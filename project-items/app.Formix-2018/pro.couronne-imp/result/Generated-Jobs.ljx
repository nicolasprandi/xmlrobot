        <tk label="Point" id="imp_point" x="" test_first="1" tip="Um welchen Index-Punkt gehts?" type="sel" flag=" nono " xml="(dir,app)index-points.xml" />
        <tk label="On" id="imp_on" x="1" test_first="0" tip="Eingeschaltet ?" type="bool" flag=" nono " />
        <tk label="Description" id="imp_desc" x="" test_first="0" tip="Description visible in the Integration Report" type="textblock" flag="  wrap " />
        <tk label="Work-Docu" id="imp_work" x="" test_first="0" tip="Working-Documentation(e:s)stays private" type="textblock" flag="  wrap " />
    </tk>
