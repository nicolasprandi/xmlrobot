<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="imp-del">
    <need>(prop,imp_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="imp-read"/>
    <tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Index Manipulation Point [ (f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml) (prop,imps_offset_label)] ?" x="Do you really want to delete that?&#10;()If you are not sure, make a backup of the ()project.">
        <q id="delete-it-2" label="()Yes, I know that the record will be gone forever()"/>
    </tk>
    <choose>
        <when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
            <xml_update how="remove" what="(file,imps)" where="(prop,imps_offset)imp[@row='(prop,imp_key)']"/>
            <tp>Deleted (f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml) #(prop,imp_key)</tp>
            <ti label="- Index Manipulation Point:" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml)(f,html,bold,close)(f,html,bold,close)"/>
            <ti_hr/>
            <when test="(prop,do_return_job)"/>
        </when>
        <otherwise>
            <tp>No delete performed.</tp>
            <ti>No delete performed.</ti>
        </otherwise>
    </choose>
    <call_job job="imp-see-all"/>
</job>
