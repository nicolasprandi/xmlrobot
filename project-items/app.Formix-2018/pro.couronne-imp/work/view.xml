<?xml version="1.0" encoding="UTF-8"?><job id="imp-see-all" level="ws" role="hidden">
    <need default="">(prop,imps_sort_attribute)</need>
    <need default="">(prop,imps_sort_number)</need>
    <need default="">(prop,imps_sort_ignore_case)</need>
    <need default="">(prop,imps_sort_desc)</need>
    <need default="">(prop,imps_where)</need>
    <need default="">(prop,imps_offset_label)</need>
    <need default="./">(prop,imps_offset)</need>
    <need default="">(prop,imps_return_job)</need>
    <need default="//">(prop,imps_offset_new_key)</need>
    <need default="0">(prop,imps_no_header)</need>
    <call_job job="event_imp_view_begin"/>
    <prop id="nothing">(f,not,(prop,imps_no_header))</prop>
    <loop missing_strategy="empty" id="imp_loop" xml="(file,imps)" xpath="(prop,imps_offset)imp(prop,imps_where)" sort="(prop,imps_sort_attribute)" number="(prop,imps_sort_number)" ignore_case="(prop,imps_sort_ignore_case)" desc="(prop,imps_sort_desc)">
        <when test="(prop,nothing)">
            <when test="(f,gt,(f,len,(prop,imps_offset_label)),0)">
                <ti label="(prop,imps_offset_label)"/>
            </when>
            <prop id="nothing">0</prop>
        </when>
        <ti type="rec">
            <ti flag="" type="call_job" prefix="  " explain="(f,html,bold,open)(f,tk_sel_translate,(loop,imp_loop,@point),(dir,app)index-points.xml)(f,html,bold,close)" job="imp-see">
                <prop id="imp_key">(loop,imp_loop,@row)</prop>
                <file id="imps">(file,imps)</file>
                <prop id="imps_offset">(prop,imps_offset)</prop>
                <prop id="imps_offset_label">(prop,imps_offset_label)</prop>
                <prop id="imps_offset_new_key">(prop,imps_offset_new_key)</prop>
                <prop id="imps_sort_attribute">(prop,imps_sort_attribute)</prop>
                <prop id="imps_sort_number">(prop,imps_sort_number)</prop>
                <prop id="imps_sort_ignore_case">(prop,imps_sort_ignore_case)</prop>
                <prop id="imps_sort_desc">(prop,imps_sort_desc)</prop>
                <prop id="imps_where">(prop,imps_where)</prop>
                <prop id="imps_return_job">(prop,imps_return_job)</prop>
            </ti>
            <ti type="menu">
                <ti isFromAction="1" type="call_job" page="view" flag="button" class="fb fbAction fbActionImpedit" explain="Edit" job="imp-edit">
                    <prop id="greetings_from_page">view</prop>
                    <prop id="greetings_from_action">edit</prop>
                    <prop page="view" id="imp_key">(loop,imp_loop,@row)</prop>
                    <file id="imps">(file,imps)</file>
                    <prop id="imps_offset">(prop,imps_offset)</prop>
                    <prop id="imps_offset_label">(prop,imps_offset_label)</prop>
                    <prop id="imps_offset_new_key">(prop,imps_offset_new_key)</prop>
                    <prop id="imps_sort_attribute">(prop,imps_sort_attribute)</prop>
                    <prop id="imps_sort_number">(prop,imps_sort_number)</prop>
                    <prop id="imps_sort_ignore_case">(prop,imps_sort_ignore_case)</prop>
                    <prop id="imps_sort_desc">(prop,imps_sort_desc)</prop>
                    <prop id="imps_where">(prop,imps_where)</prop>
                    <prop id="imps_return_job">(prop,imps_return_job)</prop>
                </ti>
            </ti>
            <ti test="(f,has,(loop,imp_loop,@desc))" type="textblock" x="(f,text,cut_nice,(loop,imp_loop,@desc),100)" flag="wrap"/>
            <ti test="(f,not,(f,has,(loop,imp_loop,@desc)))"/>
            <ti test="(f,has,(loop,imp_loop,@on))" type="text" x="(f,when,(loop,imp_loop,@on), ,(f,html,b,o)Off(f,html,b,c))"/>
            <ti test="(f,not,(f,has,(loop,imp_loop,@on)))"/>
            <ti type="menu">
                <ti isFromAction="1" type="call_job" page="view" flag="button" class="fb fbAction fbActionImprun" explain="Run" job="imp-run">
                    <prop id="greetings_from_page">view</prop>
                    <prop id="greetings_from_action">run</prop>
                    <prop page="view" id="imp_key">(loop,imp_loop,@row)</prop>
                    <file id="imps">(file,imps)</file>
                    <prop id="imps_offset">(prop,imps_offset)</prop>
                    <prop id="imps_offset_label">(prop,imps_offset_label)</prop>
                    <prop id="imps_offset_new_key">(prop,imps_offset_new_key)</prop>
                    <prop id="imps_sort_attribute">(prop,imps_sort_attribute)</prop>
                    <prop id="imps_sort_number">(prop,imps_sort_number)</prop>
                    <prop id="imps_sort_ignore_case">(prop,imps_sort_ignore_case)</prop>
                    <prop id="imps_sort_desc">(prop,imps_sort_desc)</prop>
                    <prop id="imps_where">(prop,imps_where)</prop>
                    <prop id="imps_return_job">(prop,imps_return_job)</prop>
                </ti>
            </ti>
        </ti>
        <call_job job="event_imp_loop_end"/>
    </loop>
    <when test="(prop,nothing)">
        <ti type="rec">
            <ti span="1"> </ti>
            <ti flag="wrap_word">Keine Daten gefunden</ti>
        </ti>
    </when>
    <when test="(f,not,(f,contains,(prop,imps_offset),node(e:o)(e:c)))">
        <ti type="rec" label=" ">
            <ti type="menu" span="10">
                <ti label=" " type="call_job" explain_nix="imp-add" flag="button " class="fb fbAdd fbAddImp" explain="+ Index Manipulation Point" job="imp-add">
                    <file id="imps">(file,imps)</file>
                    <prop id="imps_offset">(prop,imps_offset)</prop>
                    <prop id="imps_offset_label">(prop,imps_offset_label)</prop>
                    <prop id="imps_offset_new_key">(prop,imps_offset_new_key)</prop>
                    <prop id="imps_sort_attribute">(prop,imps_sort_attribute)</prop>
                    <prop id="imps_sort_number">(prop,imps_sort_number)</prop>
                    <prop id="imps_sort_ignore_case">(prop,imps_sort_ignore_case)</prop>
                    <prop id="imps_sort_desc">(prop,imps_sort_desc)</prop>
                    <prop id="imps_where">(prop,imps_where)</prop>
                    <prop id="imps_return_job">(prop,imps_return_job)</prop>
                </ti>
                <ti test="(f,not,(prop,nothing))" label=" " type="call_job" flag="button" class="fb fbOrg fbOrgImp" explain="(prop,_x_organize)" job="do-org-me">
                    <file id="orga">(file,imps)</file>
                    <prop id="orga_where">(prop,imps_where)</prop>
                    <prop id="orga_view_loop_id">imp_loop</prop>
                    <prop id="orga_finished_job">imp-orga-finished</prop>
                    <prop id="orga_offset">(prop,imps_offset)</prop>
                    <prop id="orga_offset_label">(prop,imps_offset_label)</prop>
                    <prop id="orga_offset_new_key">(prop,imps_offset_new_key)</prop>
                    <prop id="orga_segment_plural">imps</prop>
                    <prop id="orga_segment_singular">imp</prop>
                    <prop id="orga_segment_plural_label">Index Manipulation Points</prop>
                    <prop id="orga_segment_singular_label">Index Manipulation Point</prop>
                    <prop id="orga_sort_attribute">(prop,imps_sort_attribute)</prop>
                    <prop id="orga_sort_number">(prop,imps_sort_number)</prop>
                    <prop id="orga_where">(prop,imps_where)</prop>
                    <prop id="orga_name_expression_loop">()(f,tk_sel_translate,(loop,imp_loop,@point),(dir,app)index-points.xml)()</prop>
                    <prop id="orga_desc_expression_loop">()()</prop>
                </ti>
            </ti>
        </ti>
    </when>
    <when test="(f,has_flag,debug trace all,(f,interpreter,level))">
        <ti_hr/>
        <ti label="Debug Information">
            <ti label="File:" type="file">(file,imps)</ti>
            <ti label="Xml-Offset:" test="(f,gt_num,(f,len,(prop,imps_offset)),0)">(prop,imps_offset)</ti>
        </ti>
    </when>
</job>