<?xml version="1.0" encoding="UTF-8"?><job id="imp-add" level="ws" role="hidden">
    <prop id="isAdd">1</prop>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="imp-editor"/>
    <prop id="imp_key">1</prop>
    <when test="(f,not,(f,exists,prop,imps_offset_new_key))">
        <prop id="imps_offset_new_key">//</prop>
    </when>
    <loop id="max" limit="1" flag="back" xml="(file,imps)" sort="@row" number="@row" xpath="(prop,imps_offset_new_key)imp">
        <trace>max key=(loop,max,@row)</trace>
        <trace>i=(loop,max,#i)</trace>
        <prop id="imp_key">(f,add,(loop,max,@row),1)</prop>
    </loop>
    <i>Generated Key for new Index Manipulation Point: #(prop,imp_key)</i>
    <call_job job="imp-write"/>
    <ti_break class_table="tabNavigator"/>
    <ti type="rec">
        <ti align="right" x="+ Index Manipulation Point '(f,tk_sel_translate,(prop,imp_point),(dir,app)index-points.xml)'"/>
    </ti>
    <choose>
        <when test="(f,has,prop,post_add_script_imp)">
            <file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
            <prop id="formix-posting-code" x="(f,random_text,16)"/>
            <create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_imp)</create_file>
            <include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
            <delete file="(file,formix-posting)"/>
            <remove type="file" id="formix-posting"/>
            <remove type="prop" id="formix-posting-code"/>
        </when>
        <otherwise>
            <call_job job="imp-see-all"/>
        </otherwise>
    </choose>
</job>
