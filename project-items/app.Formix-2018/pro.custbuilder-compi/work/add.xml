<?xml version="1.0" encoding="UTF-8"?><job id="compi-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="compi-editor"/>
<prop id="compi_key">1</prop>
<when test="(f,not,(f,exists,prop,compis_offset_new_key))">
<prop id="compis_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,compis)" sort="@row" number="@row" xpath="(prop,compis_offset_new_key)compi">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="compi_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Arcadia-Compilation: #(prop,compi_key)</i>
<call_job job="compi-write"/>
<ti align="right" x="Did add Arcadia-Compilation '(f,text,cut_nice,(f,tk_sel_translate,(prop,compi_compilation),(dir,pro)current-compi-compile-selection.xml),50)'"/>
<choose>
<when test="(f,has,prop,post_add_script_compi)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_compi)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="compi-see-all"/>
</otherwise>
</choose>
</job>
