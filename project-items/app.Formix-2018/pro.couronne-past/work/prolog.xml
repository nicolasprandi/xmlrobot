<?xml version="1.0" encoding="UTF-8"?><prolog>
    <!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
    <file id="pasts">(dir,pro)pasts.xml</file>
    <when test="(f,not,(f,exists_file,(file,pasts)))">
        <create_file out="(file,pasts)">&lt;pasts/&gt;</create_file>
        <i>Created: (file,pasts)</i>
    </when>
    <prop id="pasts_offset">./</prop>
    <prop id="pasts_offset_label"/>
    <prop id="pasts_offset_new_key">//</prop>
    <prop id="pasts_sort_attribute"/>
    <prop id="pasts_sort_number"/>
    <prop id="pasts_sort_ignore_case"/>
    <prop id="pasts_sort_desc"/>
    <prop id="pasts_where"/>
    <prop id="pasts_return_job">past-see-all</prop>
</prolog>
