<?xml version="1.0" encoding="UTF-8"?><job id="past-see-all" level="ws" role="hidden">
    <need default="">(prop,pasts_sort_attribute)</need>
    <need default="">(prop,pasts_sort_number)</need>
    <need default="">(prop,pasts_sort_ignore_case)</need>
    <need default="">(prop,pasts_sort_desc)</need>
    <need default="">(prop,pasts_where)</need>
    <need default="">(prop,pasts_offset_label)</need>
    <need default="./">(prop,pasts_offset)</need>
    <need default="">(prop,pasts_return_job)</need>
    <need default="//">(prop,pasts_offset_new_key)</need>
    <need default="0">(prop,pasts_no_header)</need>
    <call_job job="tr_past"/>
    <try_catch>
        <try>
            <call_job job="hook_past_view_begin"/>
        </try>
        <catch>
            <ti label="Hook must be implemented: past-view: begin.0">
                <ti> hook_job=hook_past_view_begin hook=begin page=view station=0 object=past</ti>
            </ti>
            <tk type="msg" x="You have to implement the hook!"/>
            <throw_again/>
        </catch>
    </try_catch>
    <prop id="nothing">(f,not,(prop,pasts_no_header))</prop>
    <loop missing_strategy="empty" id="past_loop" xml="(file,pasts)" xpath="(prop,pasts_offset)past(prop,pasts_where)" sort="(prop,pasts_sort_attribute)" number="(prop,pasts_sort_number)" ignore_case="(prop,pasts_sort_ignore_case)" desc="(prop,pasts_sort_desc)">
        <when test="(prop,nothing)">
            <when test="(f,gt,(f,len,(prop,pasts_offset_label)),0)">
                <ti label="(prop,pasts_offset_label)"/>
            </when>
            <prop id="nothing">0</prop>
        </when>
        <ti type="rec">
            <ti flag="" type="call_job" prefix="  " explain="(f,html,bold,open)(loop,past_loop,@for)(f,html,bold,close)" job="past-see">
                <prop id="past_key">(loop,past_loop,@row)</prop>
                <file id="pasts">(file,pasts)</file>
                <prop id="pasts_offset">(prop,pasts_offset)</prop>
                <prop id="pasts_offset_label">(prop,pasts_offset_label)</prop>
                <prop id="pasts_offset_new_key">(prop,pasts_offset_new_key)</prop>
                <prop id="pasts_sort_attribute">(prop,pasts_sort_attribute)</prop>
                <prop id="pasts_sort_number">(prop,pasts_sort_number)</prop>
                <prop id="pasts_sort_ignore_case">(prop,pasts_sort_ignore_case)</prop>
                <prop id="pasts_sort_desc">(prop,pasts_sort_desc)</prop>
                <prop id="pasts_where">(prop,pasts_where)</prop>
                <prop id="pasts_return_job">(prop,pasts_return_job)</prop>
            </ti>
            <ti test="(f,has,(loop,past_loop,@obj_tech_name))" type="text" x="(f,tk_sel_translate,(loop,past_loop,@obj_tech_name),(dir,repo)osel-(prop,tip-term-class).xml)" flag="wrap_word"/>
            <ti test="(f,not,(f,has,(loop,past_loop,@obj_tech_name)))"/>
            <ti test="(f,has,(loop,past_loop,@attr_tech_name))" type="text" x="(f,tk_sel_translate,(loop,past_loop,@attr_tech_name),(dir,repo)attr-sel-(prop,tip-term-class).xml)" flag="wrap_word"/>
            <ti test="(f,not,(f,has,(loop,past_loop,@attr_tech_name)))"/>
            <ti type="menu">
                <ti isFromAction="1" type="call_job" page="view" flag="button" class="fb fbAction fbActionPastrun fbGo" explain="(prop,_past_act_run)" job="event_past_run">
                    <prop id="greetings_from_page">view</prop>
                    <prop id="greetings_from_action">run</prop>
                    <prop page="view" id="past_key">(loop,past_loop,@row)</prop>
                    <file id="pasts">(file,pasts)</file>
                    <prop id="pasts_offset">(prop,pasts_offset)</prop>
                    <prop id="pasts_offset_label">(prop,pasts_offset_label)</prop>
                    <prop id="pasts_offset_new_key">(prop,pasts_offset_new_key)</prop>
                    <prop id="pasts_sort_attribute">(prop,pasts_sort_attribute)</prop>
                    <prop id="pasts_sort_number">(prop,pasts_sort_number)</prop>
                    <prop id="pasts_sort_ignore_case">(prop,pasts_sort_ignore_case)</prop>
                    <prop id="pasts_sort_desc">(prop,pasts_sort_desc)</prop>
                    <prop id="pasts_where">(prop,pasts_where)</prop>
                    <prop id="pasts_return_job">(prop,pasts_return_job)</prop>
                </ti>
                <ti isFromAction="1" type="call_job" page="view" flag="button" class="fb fbAction fbActionPastdefnrun" explain="(prop,_past_act_defnrun)" job="event_past_defnrun">
                    <prop id="greetings_from_page">view</prop>
                    <prop id="greetings_from_action">defnrun</prop>
                    <prop page="view" id="past_key">(loop,past_loop,@row)</prop>
                    <file id="pasts">(file,pasts)</file>
                    <prop id="pasts_offset">(prop,pasts_offset)</prop>
                    <prop id="pasts_offset_label">(prop,pasts_offset_label)</prop>
                    <prop id="pasts_offset_new_key">(prop,pasts_offset_new_key)</prop>
                    <prop id="pasts_sort_attribute">(prop,pasts_sort_attribute)</prop>
                    <prop id="pasts_sort_number">(prop,pasts_sort_number)</prop>
                    <prop id="pasts_sort_ignore_case">(prop,pasts_sort_ignore_case)</prop>
                    <prop id="pasts_sort_desc">(prop,pasts_sort_desc)</prop>
                    <prop id="pasts_where">(prop,pasts_where)</prop>
                    <prop id="pasts_return_job">(prop,pasts_return_job)</prop>
                </ti>
            </ti>
        </ti>
    </loop>
    <when test="(prop,nothing)">
        <ti type="rec">
            <ti flag="wrap_word">(prop,_past_nodata_l)</ti>
        </ti>
    </when>
    <when test="(f,not,(f,contains,(prop,pasts_offset),node(e:o)(e:c)))">
        <ti type="rec" label=" ">
            <ti type="menu" span="10">
                <ti label=" " type="call_job" explain_nix="past-add" flag="button " class="fb fbAdd fbAddPast" explain="+ (prop,_sl_past)" job="past-add">
                    <file id="pasts">(file,pasts)</file>
                    <prop id="pasts_offset">(prop,pasts_offset)</prop>
                    <prop id="pasts_offset_label">(prop,pasts_offset_label)</prop>
                    <prop id="pasts_offset_new_key">(prop,pasts_offset_new_key)</prop>
                    <prop id="pasts_sort_attribute">(prop,pasts_sort_attribute)</prop>
                    <prop id="pasts_sort_number">(prop,pasts_sort_number)</prop>
                    <prop id="pasts_sort_ignore_case">(prop,pasts_sort_ignore_case)</prop>
                    <prop id="pasts_sort_desc">(prop,pasts_sort_desc)</prop>
                    <prop id="pasts_where">(prop,pasts_where)</prop>
                    <prop id="pasts_return_job">(prop,pasts_return_job)</prop>
                </ti>
                <ti test="(f,not,(prop,nothing))" label=" " type="call_job" flag="button" class="fb fbOrg fbOrgPast" explain="(prop,_x_organize)" job="do-org-me">
                    <file id="orga">(file,pasts)</file>
                    <prop id="orga_where">(prop,pasts_where)</prop>
                    <prop id="orga_view_loop_id">past_loop</prop>
                    <prop id="orga_finished_job">ready-and-done-past</prop>
                    <prop id="orga_offset">(prop,pasts_offset)</prop>
                    <prop id="orga_offset_label">(prop,pasts_offset_label)</prop>
                    <prop id="orga_offset_new_key">(prop,pasts_offset_new_key)</prop>
                    <prop id="orga_segment_plural">pasts</prop>
                    <prop id="orga_segment_singular">past</prop>
                    <prop id="orga_segment_plural_label">(prop,_pl_past)</prop>
                    <prop id="orga_segment_singular_label">(prop,_sl_past)</prop>
                    <prop id="orga_sort_attribute">(prop,pasts_sort_attribute)</prop>
                    <prop id="orga_sort_number">(prop,pasts_sort_number)</prop>
                    <prop id="orga_where">(prop,pasts_where)</prop>
                    <prop id="orga_name_expression_loop">()(loop,past_loop,@for)()</prop>
                    <prop id="orga_desc_expression_loop">()()</prop>
                    <prop id="orga_tr_job">tr_past</prop>
                </ti>
            </ti>
        </ti>
    </when>
    <when test="(f,has_flag,debug trace all,(f,interpreter,level))">
        <ti_hr/>
        <ti label="Debug Information">
            <ti label="File:" type="file">(file,pasts)</ti>
            <ti label="Xml-Offset:" test="(f,gt_num,(f,len,(prop,pasts_offset)),0)">(prop,pasts_offset)</ti>
        </ti>
    </when>
    <try_catch>
        <try>
            <call_job job="hook_past_view_end"/>
        </try>
        <catch>
            <ti label="Hook must be implemented: past-view: end.0">
                <ti> hook_job=hook_past_view_end hook=end page=view station=0 object=past</ti>
            </ti>
            <tk type="msg" x="You have to implement the hook!"/>
            <throw_again/>
        </catch>
    </try_catch>
</job>
