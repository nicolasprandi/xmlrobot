<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="past-editor">
    <need>(prop,isAdd)</need>
    <choose>
        <when test="(prop,isAdd)">
            <prop id="past_default_label_class" x="+ (prop,_sl_past)"/>
            <prop id="past_default_label_name" x="(f,when,(f,has,(prop,pasts_offset_label)), | (prop,pasts_offset_label),)"/>
            <prop id="pasts_tk_control" x="sum"/>
        </when>
        <otherwise>
            <need>(prop,past_key)</need>
            <prop id="past_default_label_class" x="(prop,_sl_past)"/>
            <prop id="past_default_label_name" x="(prop,past_for)(f,when,(f,has,(prop,pasts_offset_label)), - (prop,pasts_offset_label),)"/>
            <prop id="pasts_tk_control" x="sum_only"/>
        </otherwise>
    </choose>
    <call_job job="past-tk"/>
</job>
