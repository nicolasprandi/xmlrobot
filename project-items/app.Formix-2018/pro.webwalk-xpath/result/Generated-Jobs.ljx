    <need>(prop,find_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="find-read" />
    <prop id="isAdd">0</prop>
    <call_job job="find-editor" />
    <call_job job="find-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+/- Selektor '(f,text,cut_nice,(prop,find_titel),40)'" />
    </ti>
    <call_job job="find-see" />
</job><job role="hidden" id="find-del">
    <need>(prop,find_key)</need>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="find-read" />
    <tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Selektor [ (f,text,cut_nice,(prop,find_titel),40) (prop,finds_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
        <q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
    </tk>
    <choose>
        <when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
            <xml_update how="remove" what="(file,finds)" where="(prop,finds_offset)find[@row='(prop,find_key)']" />
            <tp>Deleted (f,text,cut_nice,(prop,find_titel),40) #(prop,find_key)</tp>
            <ti label="- Selektor:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,find_titel),40)(f,html,bold,close)(f,html,bold,close)" />
            <ti_hr />
            <when test="(prop,do_return_job)" />
        </when>
        <otherwise>
            <tp>No delete performed.</tp>
            <ti>No delete performed.</ti>
        </otherwise>
    </choose>
    <call_job job="see-filters" />
</job><job role="hidden" id="find-editor">
    <need>(prop,isAdd)</need>
    <choose>
        <when test="(prop,isAdd)">
            <prop id="find_default_label_class" x="+ Selektor" />
            <prop id="find_default_label_name" x="(f,when,(f,has,(prop,finds_offset_label)), | (prop,finds_offset_label),)" />
            <prop id="finds_tk_control" x="sum" />
        </when>
        <otherwise>
            <need>(prop,find_key)</need>
            <prop id="find_default_label_class" x="Selektor" />
            <prop id="find_default_label_name" x="(f,text,cut_nice,(prop,find_titel),40)(f,when,(f,has,(prop,finds_offset_label)), - (prop,finds_offset_label),)" />
            <prop id="finds_tk_control" x="sum_only" />
        </otherwise>
    </choose>
    <call_job job="find-tk" />
</job><job id="find-add" level="ws" role="hidden">
    x
    <prop id="isAdd">1</prop>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="find-editor" />
    <prop id="find_key">1</prop>
    <when test="(f,not,(f,exists,prop,finds_offset_new_key))">
        <prop id="finds_offset_new_key">//</prop>
    </when>
    <loop id="max" limit="1" flag="back" xml="(file,finds)" sort="@row" number="@row" xpath="(prop,finds_offset_new_key)find">
        <trace>max key=(loop,max,@row)</trace>
        <trace>i=(loop,max,#i)</trace>
        <prop id="find_key">(f,add,(loop,max,@row),1)</prop>
    </loop>
    <i>Generated Key for new Selektor: #(prop,find_key)</i>
    <call_job job="find-write" />
    <ti_break class_table="tabNavigator" />
    <ti type="rec">
        <ti align="right" x="+ Selektor '(f,text,cut_nice,(prop,find_titel),40)'" />
    </ti>
    <choose>
        <when test="(f,has,prop,post_add_script_find)">
            <file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
            <prop id="formix-posting-code" x="(f,random_text,16)" />
            <create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_find)</create_file>
            <include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
            <delete file="(file,formix-posting)" />
            <remove type="file" id="formix-posting" />
            <remove type="prop" id="formix-posting-code" />
        </when>
        <otherwise>
            <call_job job="see-filters" />
        </otherwise>
    </choose>
</job><job role="hidden" id="find-write">
    <need>(prop,find_key) (prop,isAdd)</need>
    <need default="./">(prop,finds_offset)</need>
    <spirit act="open" id="finds_spirit_tc" xml="(file,finds)" />
    <when test="(prop,isAdd)">
        <choose>
            <when test="(f,ends_with,(prop,finds_offset),/)">
                <prop id="offset2" x="(f,substring,(prop,finds_offset),0,(f,sub,(f,len,(prop,finds_offset)),1))" />
            </when>
            <otherwise>
                <prop id="offset2" x="(prop,finds_offset)" />
            </otherwise>
        </choose>
        <spirit act="xml_update" how="insert_in_begin" id="finds_spirit_tc" where="(prop,offset2)">
            <inline attribute="with">&lt;find row="(prop,find_key)" /&gt;</inline>
        </spirit>
        <i>Added a new record</i>
    </when>
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="xpath" value="(f,vob,prop,find_xpath)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="titel" value="(f,vob,prop,find_titel)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="desc" value="(f,vob,prop,find_desc)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="style" value="(f,vob,prop,find_style)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="by_link_text" value="(f,vob,prop,find_by_link_text)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="by_partial_link_text" value="(f,vob,prop,find_by_partial_link_text)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="by_class_name" value="(f,vob,prop,find_by_class_name)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="by_css" value="(f,vob,prop,find_by_css)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="by_id" value="(f,vob,prop,find_by_id)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="by_name" value="(f,vob,prop,find_by_name)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="by_tag_name" value="(f,vob,prop,find_by_tag_name)" />
    <file id="jack-in" x="(file,find_xsl_file)" />
    <prop id="jack-result-prop" x="(f,random_text,5)" />
    <prop id="jack-result-did-prop" x="(f,random_text,5)" />
    <call_service job="go-jack-do-file" flag="silent">
        <file id="jack-in" x="(file,jack-in)" />
        <prop id="jack-result-prop" x="(prop,jack-result-prop)" />
        <prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
    </call_service>
    <global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="xsl_file" value="(prop,jack-result)" />
    <spirit act="xml_update" how="set_attribute" flag="remove" id="finds_spirit_tc" where="(prop,finds_offset)find[@row='(prop,find_key)']" attribute="xsl_paras" value="(f,vob,prop,find_xsl_paras)" />
    <spirit act="close" flag="save pretty" id="finds_spirit_tc" />
</job></jobs>
