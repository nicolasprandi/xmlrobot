<?xml version="1.0" encoding="UTF-8"?><job id="zut-see-all" level="ws" role="hidden" tip="Lists all Zutaten">
<prop id="nothing">1</prop>
<loop missing_strategy="empty" id="zut_loop" xml="(file,zuts)" xpath="(prop,zuts_offset)zut(prop,zuts_where)" sort="(prop,zuts_sort_attribute)" number="(prop,zuts_sort_number)" ignore_case="(prop,zuts_sort_ignore_case)" desc="(prop,zuts_sort_desc)">
<when test="(prop,nothing)">
<when test="(f,gt,(f,len,(prop,zuts_offset_label)),0)">
<ti label="(prop,zuts_offset_label)"/>
</when>
<prop id="nothing">0</prop>
</when>
<try_catch>
<try>
<trace>Hook Station page=view station=0 hook=2 hook_job=hook-every-zutat-list</trace>
<call_job job="hook-every-zutat-list"/>
</try>
<catch>
<ti label="Hook must be implemented: zut-view: 2.0">
<ti> hook_job=hook-every-zutat-list hook=2 page=view station=0 object=zut</ti>
</ti>
</catch>
</try_catch>
<ti type="rec">
<ti type="call_job" flag="block"  prefix="  " explain="(f,html,bold,open)(f,text,cut_nice,(loop,zut_loop,@bez),20)(f,html,bold,close)" job="zut-see">
<prop id="zut_key">(loop,zut_loop,@row)</prop>
<file id="zuts">(file,zuts)</file>
<prop id="zuts_offset">(prop,zuts_offset)</prop>
<prop id="zuts_offset_label">(prop,zuts_offset_label)</prop>
<prop id="zuts_offset_new_key">(prop,zuts_offset_new_key)</prop>
<prop id="zuts_sort_attribute">(prop,zuts_sort_attribute)</prop>
<prop id="zuts_sort_number">(prop,zuts_sort_number)</prop>
<prop id="zuts_where">(prop,zuts_where)</prop>
<prop id="zuts_return_job">(prop,zuts_return_job)</prop>
