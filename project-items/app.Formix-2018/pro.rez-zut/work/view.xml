<prop id="rezs_where">(prop,rezs_where)</prop>
<prop id="rezs_return_job">(prop,rezs_return_job)</prop>
<prop id="rez_key">(prop,rez_key)</prop>
</ti>
<ti flag="(f,when,(f,guicontroller,general,is-web,),wrap,)">(loop,zut_loop,@menge) (f,tk_sel_translate,(loop,zut_loop,@einheit),(dir,app)mengen-selector.xml)</ti>
<ti test="(f,has,(loop,zut_loop,@kat1))" type="text" x="(f,when,(f,has_flag,(loop,zut_loop,@kat1),obst),Frisch(e:s),)(f,when,(f,has_flag,(loop,zut_loop,@kat1),trocken),Trocken(e:s),)(f,when,(f,has_flag,(loop,zut_loop,@kat1),milch),Milch(e:s),)(f,when,(f,has_flag,(loop,zut_loop,@kat1),fleisch),Fleisch(e:s),)(f,when,(f,has_flag,(loop,zut_loop,@kat1),fisch),Fisch(e:s),)"/>
<ti test="(f,not,(f,has,(loop,zut_loop,@kat1)))"/>
<ti test="(f,has,(loop,zut_loop,@komp_key))" type="text" x="(f,tk_sel_translate,(loop,zut_loop,@komp_key),(file,akt-komponentenliste))"/>
<ti test="(f,not,(f,has,(loop,zut_loop,@komp_key)))"/>
</ti>
</loop>
<when test="(prop,nothing)">
