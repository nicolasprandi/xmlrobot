<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Zutat [ (f,text,cut_nice,(prop,zut_bez),20) (prop,zuts_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,zuts)" where="(prop,zuts_offset)zut[@row='(prop,zut_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,zut_bez),20) #(prop,zut_key)</tp>
