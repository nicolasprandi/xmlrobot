        <otherwise>
            <ti type="rec" label=" ">
                <ti type="call_job" explain="(prop,_x_go_up_sys)" align="right" class="justup" job="find-see">
                    <file id="xmlfs">(file,xmlfs)</file>
                    <prop id="xmlfs_offset">(prop,xmlfs_offset)</prop>
