            <prop id="find_key">(prop,find_key)</prop>
        </ti>
    </ti>
    <ti_break class_table="tabNavigator" />
    <choose>
        <when test="(f,has_flag,(prop,xmlfs_tk_control),print_all_fields)">
            <ti type="rec" label=" ">
                <ti type="call_job" explain="(prop,_x_go_up_sys2)" align="right" class="justback2" flag="button" job="xmlf-see">
                    <prop id="xmlf_key">(prop,xmlf_key)</prop>
                    <file id="xmlfs">(file,xmlfs)</file>
