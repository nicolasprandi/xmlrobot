<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="xmlf-editor">
    <need>(prop,isAdd)</need>
    <choose>
        <when test="(prop,isAdd)">
            <prop id="xmlf_default_label_class" x="+ Test-File"/>
            <prop id="xmlf_default_label_name" x="(f,when,(f,has,(prop,xmlfs_offset_label)), | (prop,xmlfs_offset_label),)"/>
            <prop id="xmlfs_tk_control" x=""/>
        </when>
        <otherwise>
            <need>(prop,xmlf_key)</need>
            <prop id="xmlf_default_label_class" x="Test-File"/>
            <prop id="xmlf_default_label_name" x="(f,text,cut_nice,(prop,xmlf_name),20)(f,when,(f,has,(prop,xmlfs_offset_label)), - (prop,xmlfs_offset_label),)"/>
            <prop id="xmlfs_tk_control" x=""/>
        </otherwise>
    </choose>
    <call_job job="xmlf-tk"/>
</job>
