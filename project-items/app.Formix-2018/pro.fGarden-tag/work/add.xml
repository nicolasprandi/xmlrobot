<?xml version="1.0" encoding="UTF-8"?><job id="tag-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="tag-editor"/>
<prop id="tag_key">1</prop>
<when test="(f,not,(f,exists,prop,tage_offset_new_key))">
<prop id="tage_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,tage)" sort="@row" number="@row" xpath="(prop,tage_offset_new_key)tag">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="tag_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Tag: #(prop,tag_key)</i>
<call_job job="tag-write"/>
<ti label="Did add Tag:" x="(f,html,bold,open)(f,text,cut_nice,(prop,tag_bez),30)(f,html,bold,close)"/>
<ti_hr/>
<when test="(prop,do_return_job)"/>
<call_job job="tag-see"/>
</job>
