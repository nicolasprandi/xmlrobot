<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="file2-write">
<need>(prop,file2_key) (prop,isAdd)</need>
<spirit act="open" id="files2_spirit_tc" xml="(file,files2)"/>
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,files2_offset),/)">
<prop id="offset2" x="(f,substring,(prop,files2_offset),0,(f,sub,(f,len,(prop,files2_offset)),1))"/>
</when>
<otherwise>
<prop id="offset2" x="(prop,files2_offset)"/>
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="files2_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;file2 row="(prop,file2_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="files2_spirit_tc" where="(prop,files2_offset)file2[@row='(prop,file2_key)']" attribute="thefile" value="(f,vob,prop,file2_thefile)"/>
<spirit act="xml_update" how="set_attribute" flag="remove" id="files2_spirit_tc" where="(prop,files2_offset)file2[@row='(prop,file2_key)']" attribute="prob" value="(f,vob,prop,file2_prob)"/>
<spirit act="close" flag="save pretty" id="files2_spirit_tc"/>
</job>
