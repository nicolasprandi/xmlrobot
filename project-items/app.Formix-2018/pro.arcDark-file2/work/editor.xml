<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="file2-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="+ File(prop,files2_offset_label)"/>
<prop x="sum" id="files2_tk_control"/>
</when>
<otherwise>
<need>(prop,file2_key)</need>
<prop id="label" x="File [(f,tk_sel_translate,(prop,file2_thefile),(file,file-selector-any))](prop,files2_offset_label)"/>
<prop x="sum_only" id="files2_tk_control"/>
</otherwise>
</choose>
<call_job job="file2-tk"/>
</job>
