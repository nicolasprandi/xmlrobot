<?xml version="1.0" encoding="UTF-8"?><job id="file2-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="file2-editor"/>
<prop id="file2_key">1</prop>
<when test="(f,not,(f,exists,prop,files2_offset_new_key))">
<prop id="files2_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,files2)" sort="@row" number="@row" xpath="(prop,files2_offset_new_key)file2">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="file2_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new File: #(prop,file2_key)</i>
<call_job job="file2-write"/>
<ti align="right" x="Did add File '(f,tk_sel_translate,(prop,file2_thefile),(file,file-selector-any))'"/>
<choose>
<when test="(f,has,prop,post_add_script_file2)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_file2)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="file2-see-all"/>
</otherwise>
</choose>
</job>
