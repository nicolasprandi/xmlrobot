<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="files2">(dir,pro)files2.xml</file>
<when test="(f,not,(f,exists_file,(file,files2)))">
<create_file out="(file,files2)">&lt;files2/&gt;</create_file>
<i>Created: (file,files2)</i>
</when>
<prop id="files2_offset">./</prop>
<prop id="files2_offset_label"/>
<prop id="files2_offset_new_key">//</prop>
<prop id="files2_sort_attribute"/>
<prop id="files2_sort_number"/>
<prop id="files2_sort_ignore_case"/>
<prop id="files2_sort_desc"/>
<prop id="files2_where"/>
<prop id="files2_return_job">file2-see-all</prop>
</prolog>
