<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="modos2">(dir,pro)modos2.xml</file>
<when test="(f,not,(f,exists_file,(file,modos2)))">
<create_file out="(file,modos2)">&lt;modos2/&gt;</create_file>
<i>Created: (file,modos2)</i>
</when>
<prop id="modos2_offset">./</prop>
<prop id="modos2_offset_label"/>
<prop id="modos2_offset_new_key">//</prop>
<prop id="modos2_sort_attribute"/>
<prop id="modos2_sort_number"/>
<prop id="modos2_sort_ignore_case"/>
<prop id="modos2_sort_desc"/>
<prop id="modos2_where"/>
<prop id="modos2_return_job">modo2-see-all</prop>
</prolog>
