</job><job role="hidden" id="exportfile-see-more">
<need>(prop,exportfile_key)</need>
<call_job job="exportfile-read" />
<prop x="print_only print_with_tips print_all_fields" id="exportfiles_tk_control" />
<prop id="label" x="(f,html,bold,open)(prop,exportfile_desc)(f,html,bold,close)(f,when,(f,has,(prop,exportfiles_offset_label)), - (prop,exportfiles_offset_label),)" />
<call_job job="exportfile-tk" />
<ti_hr />
<ti type="rec">
<ti type="call_job" explain="Edit" job="exportfile-edit">
<prop id="exportfile_key">(prop,exportfile_key)</prop>
<file id="exportfiles">(file,exportfiles)</file>
<prop id="exportfiles_offset">(prop,exportfiles_offset)</prop>
