<ti label="Xml-Offset:" test="(f,gt_num,(f,len,(prop,exportfiles_offset)),0)">(prop,exportfiles_offset)</ti>
</ti>
</when>
</job><job role="hidden" id="exportfile-read">
<need>(prop,exportfile_key)</need>
<spirit act="open" missing_strategy="empty" id="exportfiles_spirit_tc" xml="(file,exportfiles)" />
<prop id="exportfile_dt_upd">(f,spirit,exportfiles_spirit_tc,(prop,exportfiles_offset)exportfile[@row=(f,xpath_string,(prop,exportfile_key))],@dt_upd)</prop>
<prop id="exportfile_dt_add">(f,spirit,exportfiles_spirit_tc,(prop,exportfiles_offset)exportfile[@row=(f,xpath_string,(prop,exportfile_key))],@dt_add)</prop>
<file id="exportfile_file">(f,spirit,exportfiles_spirit_tc,(prop,exportfiles_offset)exportfile[@row=(f,xpath_string,(prop,exportfile_key))],@file)</file>
