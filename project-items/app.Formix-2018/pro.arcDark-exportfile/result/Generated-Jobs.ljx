</job><job role="hidden" id="exportfile-edit">
<need>(prop,exportfile_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="exportfile-read" />
<prop id="isAdd">0</prop>
<call_job job="exportfile-editor" />
<call_job job="exportfile-write" />
<ti align="right" x="Did update Export File '(prop,exportfile_desc)'" />
<call_job job="exportfile-see" />
</job><job role="hidden" id="exportfile-del">
<need>(prop,exportfile_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="exportfile-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Export File [ (prop,exportfile_desc) (prop,exportfiles_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,exportfiles)" where="(prop,exportfiles_offset)exportfile[@row='(prop,exportfile_key)']" />
<tp>Deleted (prop,exportfile_desc) #(prop,exportfile_key)</tp>
<ti label="Did delete Export File:" x="(f,html,bold,open)(f,html,bold,open)(prop,exportfile_desc)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="exportfile-see-all" />
</job><job role="hidden" id="exportfile-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Export File(prop,exportfiles_offset_label)" />
<prop x="sum" id="exportfiles_tk_control" />
</when>
<otherwise>
<need>(prop,exportfile_key)</need>
<prop id="label" x="Export File [(prop,exportfile_desc)](prop,exportfiles_offset_label)" />
<prop x="sum_only" id="exportfiles_tk_control" />
</otherwise>
</choose>
<call_job job="exportfile-tk" />
</job><job id="exportfile-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="exportfile-editor" />
<prop id="exportfile_key">1</prop>
<when test="(f,not,(f,exists,prop,exportfiles_offset_new_key))">
<prop id="exportfiles_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,exportfiles)" sort="@row" number="@row" xpath="(prop,exportfiles_offset_new_key)exportfile">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="exportfile_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Export File: #(prop,exportfile_key)</i>
<call_job job="exportfile-write" />
<ti align="right" x="Did add Export File '(prop,exportfile_desc)'" />
<choose>
<when test="(f,has,prop,post_add_script_exportfile)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<create_file file="(file,formix-posting)">(prop,post_add_script_exportfile)</create_file>
<include file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
</when>
<otherwise>
<call_job job="exportfile-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="exportfile-write">
<need>(prop,exportfile_key) (prop,isAdd)</need>
<spirit act="open" id="exportfiles_spirit_tc" xml="(file,exportfiles)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,exportfiles_offset),/)">
<prop id="offset2" x="(f,substring,(prop,exportfiles_offset),0,(f,sub,(f,len,(prop,exportfiles_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,exportfiles_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="exportfiles_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;exportfile row="(prop,exportfile_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<file id="jack-in" x="(file,exportfile_file)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="exportfiles_spirit_tc" where="(prop,exportfiles_offset)exportfile[@row='(prop,exportfile_key)']" attribute="file" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="exportfiles_spirit_tc" where="(prop,exportfiles_offset)exportfile[@row='(prop,exportfile_key)']" attribute="desc" value="(f,vob,prop,exportfile_desc)" />
<spirit act="close" flag="save pretty" id="exportfiles_spirit_tc" />
</job></jobs>
