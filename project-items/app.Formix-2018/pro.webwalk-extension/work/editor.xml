<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="extension-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Project Extension(prop,extensions_offset_label)"/>
<prop x="sum" id="extensions_tk_control"/>
</when>
<otherwise>
<need>(prop,extension_key)</need>
<prop id="label" x="Project Extension [(prop,extension_titel)](prop,extensions_offset_label)"/>
<prop x="sum_only" id="extensions_tk_control"/>
</otherwise>
</choose>
<call_job job="extension-tk"/>
</job>
