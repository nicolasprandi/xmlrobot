<xml_update how="remove" what="(file,hints)" where="(prop,hints_offset)hint[@row='(prop,hint_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,hint_name),25) #(prop,hint_key)</tp>
<ti label="- (prop,_sl_hint):" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,hint_name),25)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="hint-see-all" />
</job><job role="hidden" id="hint-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="hint_default_label_class" x="+ (prop,_sl_hint)" />
<prop id="hint_default_label_name" x="(f,when,(f,has,(prop,hints_offset_label)), | (prop,hints_offset_label),)" />
<prop id="hints_tk_control" x="sum" />
<prop id="hints_tk_control" x="sum_only" test="(f,has,prop,hack-hintadd-process)" />
</when>
<otherwise>
<need>(prop,hint_key)</need>
<prop id="hint_default_label_class" x="(prop,_sl_hint)" />
<prop id="hint_default_label_name" x="(f,text,cut_nice,(prop,hint_name),25)(f,when,(f,has,(prop,hints_offset_label)), - (prop,hints_offset_label),)" />
<prop id="hints_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="hint-tk" />
</job><job id="hint-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="hint-editor" />
<prop id="hint_key">1</prop>
<when test="(f,not,(f,exists,prop,hints_offset_new_key))">
<prop id="hints_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,hints)" sort="@row" number="@row" xpath="(prop,hints_offset_new_key)hint">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="hint_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_hint): #(prop,hint_key)</i>
<call_job job="hint-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_hint) '(f,text,cut_nice,(prop,hint_name),25)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_hint)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_hint)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="hint-event-post-insert" />
</otherwise>
</choose>
</job><job role="hidden" id="hint-write">
<need>(prop,hint_key) (prop,isAdd)</need>
<need default="./">(prop,hints_offset)</need>
<spirit act="open" id="hints_spirit_tc" xml="(file,hints)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,hints_offset),/)">
<prop id="offset2" x="(f,substring,(prop,hints_offset),0,(f,sub,(f,len,(prop,hints_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,hints_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="hints_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;hint row="(prop,hint_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="hints_spirit_tc" where="(prop,hints_offset)hint[@row='(prop,hint_key)']" attribute="objekt_typ" value="(f,vob,prop,hint_objekt_typ)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="hints_spirit_tc" where="(prop,hints_offset)hint[@row='(prop,hint_key)']" attribute="name" value="(f,vob,prop,hint_name)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="hints_spirit_tc" where="(prop,hints_offset)hint[@row='(prop,hint_key)']" attribute="doku" value="(f,vob,prop,hint_doku)" />
<spirit act="close" flag="save pretty" id="hints_spirit_tc" />
</job></jobs>
