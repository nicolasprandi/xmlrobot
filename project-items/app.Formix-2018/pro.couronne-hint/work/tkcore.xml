<tk label="(f,when,(f,has_flag,(prop,hints_tk_control),print_only),,(prop,hint_default_label_class)(f,when,(f,has,prop,hint_default_label_name), (prop,hint_default_label_name),))" tip="(prop,_hint_t)" tk_id="15" flag="(prop,hints_tk_control) wrap ">
