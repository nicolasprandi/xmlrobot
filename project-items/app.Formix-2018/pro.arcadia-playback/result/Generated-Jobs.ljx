<call_job job="playback-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Playback [ (prop,playback_target) (prop,playbacks_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,playbacks)" where="(prop,playbacks_offset)playback[@row='(prop,playback_key)']" />
<tp>Deleted (prop,playback_target) #(prop,playback_key)</tp>
<ti label="Did delete Playback:" x="(f,html,bold,open)(f,html,bold,open)(prop,playback_target)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="hook_playback_orga_finished" />
</job><job role="hidden" id="playback-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Playback(prop,playbacks_offset_label)" />
<prop x="sum" id="playbacks_tk_control" />
</when>
<otherwise>
<need>(prop,playback_key)</need>
<prop id="label" x="Playback [(prop,playback_target)](prop,playbacks_offset_label)" />
<prop x="sum_only" id="playbacks_tk_control" />
</otherwise>
</choose>
<call_job job="playback-tk" />
</job><job id="playback-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="playback-editor" />
<prop id="playback_key">1</prop>
<when test="(f,not,(f,exists,prop,playbacks_offset_new_key))">
<prop id="playbacks_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,playbacks)" sort="@row" number="@row" xpath="(prop,playbacks_offset_new_key)playback">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="playback_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Playback: #(prop,playback_key)</i>
<call_job job="playback-write" />
<ti align="right" x="Did add Playback '(prop,playback_target)'" />
<choose>
<when test="(f,has,prop,post_add_script_playback)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_playback)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="hook_playback_orga_finished" />
</otherwise>
</choose>
</job><job role="hidden" id="playback-write">
<need>(prop,playback_key) (prop,isAdd)</need>
<spirit act="open" id="playbacks_spirit_tc" xml="(file,playbacks)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,playbacks_offset),/)">
<prop id="offset2" x="(f,substring,(prop,playbacks_offset),0,(f,sub,(f,len,(prop,playbacks_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,playbacks_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="playbacks_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;playback row="(prop,playback_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="playbacks_spirit_tc" where="(prop,playbacks_offset)playback[@row='(prop,playback_key)']" attribute="target" value="(f,vob,prop,playback_target)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="playbacks_spirit_tc" where="(prop,playbacks_offset)playback[@row='(prop,playback_key)']" attribute="desc" value="(f,vob,prop,playback_desc)" />
<spirit act="close" flag="save pretty" id="playbacks_spirit_tc" />
</job></jobs>
