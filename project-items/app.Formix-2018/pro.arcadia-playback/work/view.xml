<prop id="playbacks_where">(prop,playbacks_where)</prop>
<prop id="playbacks_return_job">(prop,playbacks_return_job)</prop>
</ti>
<ti test="(f,has,(loop,playback_loop,@desc))" type="text" x="(loop,playback_loop,@desc)"/>
<ti test="(f,not,(f,has,(loop,playback_loop,@desc)))"/>
<ti type="call_job" explain="Edit" job="playback-edit">
<prop id="playback_key">(loop,playback_loop,@row)</prop>
<file id="playbacks">(file,playbacks)</file>
<prop id="playbacks_offset">(prop,playbacks_offset)</prop>
