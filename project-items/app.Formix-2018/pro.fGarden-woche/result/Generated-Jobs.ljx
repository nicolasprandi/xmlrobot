</job><job role="hidden" id="woche-edit">
<need>(prop,woche_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="woche-read" />
<prop id="isAdd">0</prop>
<call_job job="woche-editor" />
<call_job job="woche-write" />
<ti label="Did update Woche:" x="(f,html,bold,open)(f,text,cut_nice,(prop,woche_bez),30)(f,html,bold,close)" />
<ti_break />
<ti_hr />
<call_job job="woche-see-all-event" />
</job><job role="hidden" id="woche-del">
<need>(prop,woche_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="woche-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Woche [ (f,text,cut_nice,(prop,woche_bez),30) (prop,wochen_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,wochen)" where="(prop,wochen_offset)woche[@row='(prop,woche_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,woche_bez),30) #(prop,woche_key)</tp>
<ti label="Did delete Woche:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,woche_bez),30)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="woche-see-all-event" />
</job><job role="hidden" id="woche-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Woche(prop,wochen_offset_label)" />
<prop x="sum" id="wochen_tk_control" />
</when>
<otherwise>
<need>(prop,woche_key)</need>
<prop id="label" x="Woche [(f,text,cut_nice,(prop,woche_bez),30)](prop,wochen_offset_label)" />
<prop x="sum_only" id="wochen_tk_control" />
</otherwise>
</choose>
<call_job job="woche-tk" />
</job><job id="woche-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="woche-editor" />
<prop id="woche_key">1</prop>
<when test="(f,not,(f,exists,prop,wochen_offset_new_key))">
<prop id="wochen_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,wochen)" sort="@row" number="@row" xpath="(prop,wochen_offset_new_key)woche">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="woche_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Woche: #(prop,woche_key)</i>
<call_job job="woche-write" />
<ti label="Did add Woche:" x="(f,html,bold,open)(f,text,cut_nice,(prop,woche_bez),30)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
<call_job job="woche-see-all-event" />
</job><job role="hidden" id="woche-write">
<need>(prop,woche_key) (prop,isAdd)</need>
<spirit act="open" id="wochen_spirit_tc" xml="(file,wochen)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,wochen_offset),/)">
<prop id="offset2" x="(f,substring,(prop,wochen_offset),0,(f,sub,(f,len,(prop,wochen_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,wochen_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="wochen_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;woche row="(prop,woche_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="wochen_spirit_tc" where="(prop,wochen_offset)woche[@row='(prop,woche_key)']" attribute="bez" value="(f,vob,prop,woche_bez)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="wochen_spirit_tc" where="(prop,wochen_offset)woche[@row='(prop,woche_key)']" attribute="beschreibung" value="(f,vob,prop,woche_beschreibung)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="wochen_spirit_tc" where="(prop,wochen_offset)woche[@row='(prop,woche_key)']" attribute="menge" value="(f,vob,prop,woche_menge)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="wochen_spirit_tc" where="(prop,wochen_offset)woche[@row='(prop,woche_key)']" attribute="einheit" value="(f,vob,prop,woche_einheit)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="wochen_spirit_tc" where="(prop,wochen_offset)woche[@row='(prop,woche_key)']" attribute="klasse" value="(f,vob,prop,woche_klasse)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="wochen_spirit_tc" where="(prop,wochen_offset)woche[@row='(prop,woche_key)']" attribute="ersatz" value="(f,vob,prop,woche_ersatz)" />
<spirit act="close" flag="save pretty" id="wochen_spirit_tc" />
</job></jobs>
