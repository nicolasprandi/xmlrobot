<?xml version="1.0" encoding="UTF-8"?><job id="woche-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="woche-editor"/>
<prop id="woche_key">1</prop>
<when test="(f,not,(f,exists,prop,wochen_offset_new_key))">
<prop id="wochen_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,wochen)" sort="@row" number="@row" xpath="(prop,wochen_offset_new_key)woche">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="woche_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Woche: #(prop,woche_key)</i>
<call_job job="woche-write"/>
<ti label="Did add Woche:" x="(f,html,bold,open)(f,text,cut_nice,(prop,woche_bez),30)(f,html,bold,close)"/>
<ti_hr/>
<when test="(prop,do_return_job)"/>
<call_job job="woche-see-all-event"/>
</job>
