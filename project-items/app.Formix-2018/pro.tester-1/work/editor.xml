<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="computer-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Computer(prop,computers_offset_label)"/>
<prop x="sum" id="computers_tk_control"/>
</when>
<otherwise>
<need>(prop,computer_key)</need>
<prop id="label" x="(prop,computer_computer)(prop,computers_offset_label)"/>
<prop x="sum_only" id="computers_tk_control"/>
</otherwise>
</choose>
<call_job job="computer-tk"/>
</job>
