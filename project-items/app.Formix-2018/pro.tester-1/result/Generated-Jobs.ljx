<tk id="computer_d1" test_first="0" type="dir" flag="  download " />
<tk id="computer_d2" test_first="0" type="dir" flag="  download " />
</tk>
</job><job id="computer-see-all" level="ws" role="hidden" tip="Lists all Computers">
<prop id="nothing">1</prop>
<loop id="i" missing_strategy="empty" xml="(file,computers)" xpath="(prop,computers_offset)computer(prop,computers_where)" sort="(prop,computers_sort_attribute)" number="(prop,computers_sort_number)" ignore_case="(prop,computers_sort_ignore_case)" desc="(prop,computers_sort_desc)">
