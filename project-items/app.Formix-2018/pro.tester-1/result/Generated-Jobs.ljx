</job><job role="hidden" id="computer-edit">
<need>(prop,computer_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="computer-read" />
<prop id="isAdd">0</prop>
<call_job job="computer-editor" />
<call_job job="computer-write" />
<ti label="Did update Computer:" x="(f,html,bold,open)(prop,computer_computer)(f,html,bold,close)" />
<ti_break />
<ti_hr />
<call_job job="computer-see" />
</job><job role="hidden" id="computer-del">
<need>(prop,computer_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="computer-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting [ (prop,computer_computer) (prop,computers_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,computers)" where="(prop,computers_offset)computer[@row='(prop,computer_key)']" />
<i>Deleted (prop,computer_computer) #(prop,computer_key)(e:s) (prop,computer_computer)</i>
<ti label="Did delete Computer:" x="(f,html,bold,open)(prop,computer_computer)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="Runcomputer-see-all" />
</job><job role="hidden" id="computer-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Computer(prop,computers_offset_label)" />
<prop x="sum" id="computers_tk_control" />
</when>
<otherwise>
<need>(prop,computer_key)</need>
<prop id="label" x="(prop,computer_computer)(prop,computers_offset_label)" />
<prop x="sum_only" id="computers_tk_control" />
</otherwise>
</choose>
<call_job job="computer-tk" />
</job><job id="computer-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="computer-editor" />
<prop id="computer_key">1</prop>
<when test="(f,not,(f,exists,prop,computers_offset_new_key))">
<prop id="computers_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,computers)" sort="@row" number="@row" xpath="(prop,computers_offset_new_key)computer">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="computer_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Computer: #(prop,computer_key)</i>
<call_job job="computer-write" />
<ti label="Did add Computer:" x="(f,html,bold,open)(prop,computer_computer)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
<call_job job="Runcomputer-see-all" />
</job><job role="hidden" id="computer-write">
<need>(prop,computer_key) (prop,isAdd)</need>
<spirit act="open" id="computers_spirit_tc" xml="(file,computers)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,computers_offset),/)">
<prop id="offset2" x="(f,substring,(prop,computers_offset),0,(f,sub,(f,len,(prop,computers_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,computers_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="computers_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;computer row="(prop,computer_key)" /&gt;</inline>
</spirit>
<spirit act="xml_update" how="set_attribute" attribute="dt_add" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row=(f,xpath_string,(prop,computer_key))]" value="(f,time)" />
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" attribute="dt_upd" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row=(f,xpath_string,(prop,computer_key))]" value="(f,time)" />
<spirit act="xml_update" how="set_attribute" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row='(prop,computer_key)']" attribute="computer" value="(f,vob,prop,computer_computer)" />
<spirit act="xml_update" how="set_attribute" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row='(prop,computer_key)']" attribute="os" value="(f,vob,prop,computer_os)" />
<spirit act="xml_update" how="set_attribute" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row='(prop,computer_key)']" attribute="name" value="(f,vob,prop,computer_name)" />
<spirit act="xml_update" how="set_attribute" id="computers_spirit_tc" where="(prop,computers_offset)computer[@row='(prop,computer_key)']" attribute="adresse" value="(f,vob,prop,computer_adresse)" />
<file id="jack-in" x="(file,computer_f1)" />
