<call_job job="event_post_update_dbci" />
</job><job role="hidden" id="dbci-del">
<need>(prop,dbci_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="dbci-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_dbci) [ (f,text,cut_nice,(prop,dbci_id),50) (prop,dbcis_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,dbcis)" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,dbci_id),50) #(prop,dbci_key)</tp>
<ti label="- (prop,_sl_dbci):" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,dbci_id),50)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="Dbci-see-all" />
</job><job role="hidden" id="dbci-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="dbci_default_label_class" x="+ (prop,_sl_dbci)" />
<prop id="dbci_default_label_name" x="(f,when,(f,has,(prop,dbcis_offset_label)), | (prop,dbcis_offset_label),)" />
<prop id="dbcis_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,dbci_key)</need>
<prop id="dbci_default_label_class" x="(prop,_sl_dbci)" />
<prop id="dbci_default_label_name" x="(f,text,cut_nice,(prop,dbci_id),50)(f,when,(f,has,(prop,dbcis_offset_label)), - (prop,dbcis_offset_label),)" />
<prop id="dbcis_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="dbci-tk" />
</job><job id="dbci-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="dbci-editor" />
<prop id="dbci_key">1</prop>
<when test="(f,not,(f,exists,prop,dbcis_offset_new_key))">
<prop id="dbcis_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,dbcis)" sort="@row" number="@row" xpath="(prop,dbcis_offset_new_key)dbci">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="dbci_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_dbci): #(prop,dbci_key)</i>
<call_job job="dbci-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_dbci) '(f,text,cut_nice,(prop,dbci_id),50)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_dbci)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_dbci)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="event_post_insert_dbci" />
</otherwise>
</choose>
</job><job role="hidden" id="dbci-write">
<need>(prop,dbci_key) (prop,isAdd)</need>
<need default="./">(prop,dbcis_offset)</need>
<spirit act="open" id="dbcis_spirit_tc" xml="(file,dbcis)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,dbcis_offset),/)">
<prop id="offset2" x="(f,substring,(prop,dbcis_offset),0,(f,sub,(f,len,(prop,dbcis_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,dbcis_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="dbcis_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;dbci row="(prop,dbci_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="id" value="(f,vob,prop,dbci_id)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="app" value="(f,vob,prop,dbci_app)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="titel" value="(f,vob,prop,dbci_titel)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="db" value="(f,vob,prop,dbci_db)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="url" value="(f,vob,prop,dbci_url)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="user" value="(f,vob,prop,dbci_user)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="password" value="(f,vob,prop,dbci_password)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="autocommit" value="(f,vob,prop,dbci_autocommit)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="doku" value="(f,vob,prop,dbci_doku)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="off" value="(f,vob,prop,dbci_off)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="crypto" value="(f,vob,prop,dbci_crypto)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dbcis_spirit_tc" where="(prop,dbcis_offset)dbci[@row='(prop,dbci_key)']" attribute="request" value="(f,vob,prop,dbci_request)" />
<spirit act="close" flag="save pretty" id="dbcis_spirit_tc" />
</job></jobs>
