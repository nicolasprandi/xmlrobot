<try_catch>
<try>
  <prop id="sy12">(loop,dbci_loop,@app)</prop>
  <when test="(f,ends_with,(loop,dbci_loop,@id),a__)">
  <when test="(f,not,(f,has,prop,sy12))">
    <prop id="sy12">Hibiscus</prop>
  </when>
  </when>                        
  <prop id="sy13">(f,when,(f,exists,coop2,_dbi,(loop,dbci_loop,@id),(f,vob,prop,sy12)),(f,html,i,o)Started(f,html,i,c),)</prop>
</try>
<catch>
  <prop id="sy13">Error: (prop,catched_msg)</prop>
</catch>
</try_catch>

<prop id="sy14" />                                          
<choose>
  <when test="(f,and,(loop,dbci_loop,@off),(f,not,(loop,dbci_loop,@crypto)))">
     <prop id="sy14">Off(e:s) Unencrypted</prop>
  </when>
  <when test="(loop,dbci_loop,@off)">
      <prop id="sy14">Off</prop>
  </when>
  
  <when test="(f,not,(loop,dbci_loop,@crypto))">
      <prop id="sy14">Unencrypted</prop>
  </when>    
</choose>

  <when test="(loop,dbci_loop,@autocommit)">
      <prop id="sy14" test="(f,has,prop,sy14)">(prop,sy14)(e:s) </prop>
      <prop id="sy14">Autocommit</prop>
  </when>    

<when test="(f,has,prop,sy14)">
