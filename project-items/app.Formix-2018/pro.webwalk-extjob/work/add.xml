<?xml version="1.0" encoding="UTF-8"?><job id="extjob-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="extjob-editor"/>
<prop id="extjob_key">1</prop>
<when test="(f,not,(f,exists,prop,extjobs_offset_new_key))">
<prop id="extjobs_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,extjobs)" sort="@row" number="@row" xpath="(prop,extjobs_offset_new_key)extjob">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="extjob_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Job: #(prop,extjob_key)</i>
<call_job job="extjob-write"/>
<ti_break class_table="tabNavigator"/>
<ti type="rec">
<ti align="right" x="+ Job '(prop,extjob_jobid)'"/>
</ti>
<choose>
<when test="(f,has,prop,post_add_script_extjob)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_extjob)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="extjob-see-all"/>
</otherwise>
</choose>
</job>
