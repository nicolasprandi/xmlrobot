<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="extjobs">(dir,pro)extjobs.xml</file>
<when test="(f,not,(f,exists_file,(file,extjobs)))">
<create_file out="(file,extjobs)">&lt;extjobs/&gt;</create_file>
<i>Created: (file,extjobs)</i>
</when>
<prop id="extjobs_offset">./</prop>
<prop id="extjobs_offset_label"/>
<prop id="extjobs_offset_new_key">//</prop>
<prop id="extjobs_sort_attribute"/>
<prop id="extjobs_sort_number"/>
<prop id="extjobs_sort_ignore_case"/>
<prop id="extjobs_sort_desc"/>
<prop id="extjobs_where"/>
<prop id="extjobs_return_job">extjob-see-all</prop>
</prolog>
