<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="komp-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Komponente(prop,komps_offset_label)"/>
<prop x="sum" id="komps_tk_control"/>
</when>
<otherwise>
<need>(prop,komp_key)</need>
<prop id="label" x="Komponente [(f,text,cut_nice,(prop,komp_bez),20)](prop,komps_offset_label)"/>
<prop x="sum_only" id="komps_tk_control"/>
</otherwise>
</choose>
<call_job job="komp-tk"/>
</job>
