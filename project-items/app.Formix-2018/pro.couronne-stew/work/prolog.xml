</when>
<prop id="stews_offset">./</prop>
<prop id="stews_offset_label"/>
<prop id="stews_offset_new_key">//</prop>
<prop id="stews_sort_attribute"/>
<prop id="stews_sort_number"/>
<prop id="stews_sort_ignore_case"/>
<prop id="stews_sort_desc"/>
<prop id="stews_where"/>
<prop id="stews_return_job">stew-see-all</prop>
</prolog>
