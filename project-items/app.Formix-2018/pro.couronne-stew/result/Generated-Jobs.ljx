</job><job role="hidden" id="stew-edit">
<need>(prop,stew_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="stew-read" />
<prop id="isAdd">0</prop>
<call_job job="stew-editor" />
<call_job job="stew-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+/- (prop,_sl_stew) '(prop,stew_type)'" />
</ti>
<call_job job="stew_event_post_update" />
</job><job role="hidden" id="stew-del">
<need>(prop,stew_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="stew-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_stew) [ (prop,stew_type) (prop,stews_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,stews)" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" />
<tp>Deleted (prop,stew_type) #(prop,stew_key)</tp>
<ti label="- (prop,_sl_stew):" x="(f,html,bold,open)(f,html,bold,open)(prop,stew_type)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="stew-see-all" />
</job><job role="hidden" id="stew-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="stew_default_label_class" x="+ (prop,_sl_stew)" />
<prop id="stew_default_label_name" x="(f,when,(f,has,(prop,stews_offset_label)), - (prop,stews_offset_label),)" />
<prop id="stews_tk_control" x="sum" />
</when>
<otherwise>
<need>(prop,stew_key)</need>
<prop id="stew_default_label_class" x="(prop,_sl_stew)" />
<prop id="stew_default_label_name" x="(prop,stew_type)(f,when,(f,has,(prop,stews_offset_label)), - (prop,stews_offset_label),)" />
<prop id="stews_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="stew-tk" />
</job><job id="stew-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="stew-editor" />
<prop id="stew_key">1</prop>
<when test="(f,not,(f,exists,prop,stews_offset_new_key))">
<prop id="stews_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,stews)" sort="@row" number="@row" xpath="(prop,stews_offset_new_key)stew">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="stew_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_stew): #(prop,stew_key)</i>
<call_job job="stew-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_stew) '(prop,stew_type)'" />
</ti>
<choose>
<when test="(f,has,prop,post_add_script_stew)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_stew)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="stew_event_post_update" />
</otherwise>
</choose>
</job><job role="hidden" id="stew-write">
<need>(prop,stew_key) (prop,isAdd)</need>
<need default="./">(prop,stews_offset)</need>
<spirit act="open" id="stews_spirit_tc" xml="(file,stews)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,stews_offset),/)">
<prop id="offset2" x="(f,substring,(prop,stews_offset),0,(f,sub,(f,len,(prop,stews_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,stews_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="stews_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;stew row="(prop,stew_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="type" value="(f,vob,prop,stew_type)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="hd_usage" value="(f,vob,prop,stew_hd_usage)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="hd_script" value="(f,vob,prop,stew_hd_script)" />
<file id="jack-in" x="(file,stew_hd_file)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="hd_file" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="ow_usage" value="(f,vob,prop,stew_ow_usage)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="ow_script" value="(f,vob,prop,stew_ow_script)" />
<file id="jack-in" x="(file,stew_ow_file)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="ow_file" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="ft_usage" value="(f,vob,prop,stew_ft_usage)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="ft_script" value="(f,vob,prop,stew_ft_script)" />
<file id="jack-in" x="(file,stew_ft_file)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="ft_file" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="ex_usage" value="(f,vob,prop,stew_ex_usage)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="ex_script" value="(f,vob,prop,stew_ex_script)" />
<file id="jack-in" x="(file,stew_ex_file)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="ex_file" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="off" value="(f,vob,prop,stew_off)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="stews_spirit_tc" where="(prop,stews_offset)stew[@row='(prop,stew_key)']" attribute="docu" value="(f,vob,prop,stew_docu)" />
<spirit act="close" flag="save pretty" id="stews_spirit_tc" />
</job></jobs>
