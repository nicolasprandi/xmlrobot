</job><job role="hidden" id="exti-del">
<need>(prop,exti_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="exti-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting ExtendedConf [ (f,tk_sel_translate,(prop,exti_ons),(dir,app)sel-ons.xml) (prop,extis_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,extis)" where="(prop,extis_offset)exti[@row='(prop,exti_key)']" />
<tp>Deleted (f,tk_sel_translate,(prop,exti_ons),(dir,app)sel-ons.xml) #(prop,exti_key)</tp>
<ti label="Did delete ExtendedConf:" x="(f,html,bold,open)(f,html,bold,open)(f,tk_sel_translate,(prop,exti_ons),(dir,app)sel-ons.xml)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
</job><job role="hidden" id="exti-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new ExtendedConf(prop,extis_offset_label)" />
<prop x="sum" id="extis_tk_control" />
</when>
<otherwise>
<need>(prop,exti_key)</need>
<prop id="label" x="ExtendedConf [(f,tk_sel_translate,(prop,exti_ons),(dir,app)sel-ons.xml)](prop,extis_offset_label)" />
<prop x="sum_only" id="extis_tk_control" />
</otherwise>
</choose>
<call_job job="exti-tk" />
</job><job id="exti-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="exti-editor" />
<prop id="exti_key">1</prop>
<when test="(f,not,(f,exists,prop,extis_offset_new_key))">
<prop id="extis_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,extis)" sort="@row" number="@row" xpath="(prop,extis_offset_new_key)exti">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="exti_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new ExtendedConf: #(prop,exti_key)</i>
<call_job job="exti-write" />
<ti align="right" x="Did add ExtendedConf '(f,tk_sel_translate,(prop,exti_ons),(dir,app)sel-ons.xml)'" />
<choose>
<when test="(f,has,prop,post_add_script_exti)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<create_file file="(file,formix-posting)">(prop,post_add_script_exti)</create_file>
<include file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
</when>
<otherwise />
</choose>
</job><job role="hidden" id="exti-write">
<need>(prop,exti_key) (prop,isAdd)</need>
<spirit act="open" id="extis_spirit_tc" xml="(file,extis)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,extis_offset),/)">
<prop id="offset2" x="(f,substring,(prop,extis_offset),0,(f,sub,(f,len,(prop,extis_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,extis_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="extis_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;exti row="(prop,exti_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="extis_spirit_tc" where="(prop,extis_offset)exti[@row='(prop,exti_key)']" attribute="ons" value="(f,vob,prop,exti_ons)" />
