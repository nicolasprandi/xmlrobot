<?xml version="1.0" encoding="UTF-8"?><job id="task-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="task-editor"/>
<prop id="task_key">1</prop>
<when test="(f,not,(f,exists,prop,tasks_offset_new_key))">
<prop id="tasks_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,tasks)" sort="@row" number="@row" xpath="(prop,tasks_offset_new_key)task">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="task_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Task: #(prop,task_key)</i>
<call_job job="task-write"/>
<ti align="right" x="Did add Task '(f,text,cut_nice,(prop,task_name),26)'"/>
<choose>
<when test="(f,has,prop,post_add_script_task)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_task)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="task-see-all"/>
</otherwise>
</choose>
</job>
