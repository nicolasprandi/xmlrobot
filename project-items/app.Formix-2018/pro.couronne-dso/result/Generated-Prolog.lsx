<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="dsos">(dir,pro)dsos.xml</file>
<when test="(f,not,(f,exists_file,(file,dsos)))">
<create_file out="(file,dsos)">&lt;dsos/&gt;</create_file>
<i>Created: (file,dsos)</i>
</when>
<prop id="dsos_offset">./</prop>
<prop id="dsos_offset_label"/>
<prop id="dsos_offset_new_key">//</prop>
<prop id="dsos_sort_attribute"/>
<prop id="dsos_sort_number"/>
<prop id="dsos_sort_ignore_case"/>
<prop id="dsos_sort_desc"/>
<prop id="dsos_where"/>
<prop id="dsos_return_job">dso-see-all</prop>
</prolog>
