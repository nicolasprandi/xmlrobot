</job><job role="hidden" id="dso-del">
<need>(prop,dso_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="dso-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_dso) [ (f,text,cut_nice,(prop,dso_name),25) (prop,dsos_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,dsos)" where="(prop,dsos_offset)dso[@row='(prop,dso_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,dso_name),25) #(prop,dso_key)</tp>
<ti label="- (prop,_sl_dso):" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,dso_name),25)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="dsi-see" />
</job><job role="hidden" id="dso-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<call_job job="idef-dso-on" />
<prop id="dso_default_label_class" x="+ (prop,_sl_dso)" />
<prop id="dso_default_label_name" x="(f,when,(f,has,(prop,dsos_offset_label)), | (prop,dsos_offset_label),)" />
<prop id="dsos_tk_control" x="sum_only" test="(f,has,prop,hack-mox)" />
</when>
<otherwise>
<need>(prop,dso_key)</need>
<prop id="dso_default_label_class" x="(prop,_sl_dso)" />
<prop id="dso_default_label_name" x="(f,text,cut_nice,(prop,dso_name),25)(f,when,(f,has,(prop,dsos_offset_label)), - (prop,dsos_offset_label),)" />
<prop id="dsos_tk_control" x="sum_only" />
</otherwise>
</choose>
<call_job job="dso-tk" />
</job><job id="dso-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="dso-editor" />
<prop id="dso_key">1</prop>
<when test="(f,not,(f,exists,prop,dsos_offset_new_key))">
<prop id="dsos_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,dsos)" sort="@row" number="@row" xpath="(prop,dsos_offset_new_key)dso">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="dso_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_dso): #(prop,dso_key)</i>
<call_job job="dso-write" />
<ti_break class_table="tabNavigator" />
<ti type="rec">
<ti align="right" x="+ (prop,_sl_dso) '(f,text,cut_nice,(prop,dso_name),25)'" />
</ti>
<choose>
<when test="(f,has,prop,hack-mox)">
</when>
<when test="(f,has,prop,post_add_script_dso)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_dso)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="dso_did_insert" />
</otherwise>
</choose>
</job><job role="hidden" id="dso-write">
<need>(prop,dso_key) (prop,isAdd)</need>
<need default="./">(prop,dsos_offset)</need>
<spirit act="open" id="dsos_spirit_tc" xml="(file,dsos)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,dsos_offset),/)">
<prop id="offset2" x="(f,substring,(prop,dsos_offset),0,(f,sub,(f,len,(prop,dsos_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,dsos_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="dsos_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;dso row="(prop,dso_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsos_spirit_tc" where="(prop,dsos_offset)dso[@row='(prop,dso_key)']" attribute="objekttyp" value="(f,vob,prop,dso_objekttyp)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsos_spirit_tc" where="(prop,dsos_offset)dso[@row='(prop,dso_key)']" attribute="name" value="(f,vob,prop,dso_name)" />
<spirit act="close" flag="save pretty" id="dsos_spirit_tc" />
</job></jobs>
