<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="dso-tk">
<call_job job="tr_dso"/>
<need default="">(prop,dsos_tk_control)</need>
<when test="(f,has_flag,(prop,dsos_tk_control),print_only)">
<choose>
<when test="(f,has_flag,(prop,dsos_tk_control),print_all_fields)">
<ti label="(prop,dso_default_label_class) (prop,dso_default_label_name) {(prop,dso_key)}"/>
</when>
<otherwise>
<ti label=" " x="(f,html,b,o)(prop,dso_default_label_class)(f,html,b,c) {(prop,dso_key)}"/>
</otherwise>
</choose>
</when>
<when test="(f,not,(f,has_flag,(prop,dsos_tk_control),print_only))">
<when test="(f,not,(prop,isAdd))">
<tk label="(prop,_dso_name_l)" id="dso_name" x="" test_first="1" tip="(prop,_dso_name_t)" type="text" cols="25" flag=" "/>
</when>
</when>
<tk label="(f,when,(f,has_flag,(prop,dsos_tk_control),print_only),,(prop,dso_default_label_class)(f,when,(f,has,prop,dso_default_label_name), (prop,dso_default_label_name),)(f,when,(f,has,prop,dso_key), {(f,vob,prop,dso_key)},))" tip="(prop,_dso_t)" tk_id="14" flag="(prop,dsos_tk_control) wrap ">
<tk label="(prop,_dso_otyp_l)" id="dso_objekttyp" x="" test_first="1" tip="(prop,_dso_otyp_t)" type="sel" follow_job="hook_dso_follow_otyp" flag=" nono " xml="(dir,repo)osel-(prop,tip-term-class).xml"/>
<tk label="(prop,_dso_doku_l)" x="(prop,_dso_doku_l)" test_first="0" type="msg" flag=" "/>
<tk label="(prop,_dso_name_l)" id="dso_name" x="" test_first="1" tip="(prop,_dso_name_t)" type="text" cols="25" flag=" "/>
</tk>
</job>
