<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="dso-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<call_job job="idef-dso-on"/>
<prop id="dso_default_label_class" x="+ (prop,_sl_dso)"/>
<prop id="dso_default_label_name" x="(f,when,(f,has,(prop,dsos_offset_label)), | (prop,dsos_offset_label),)"/>
<prop id="dsos_tk_control" x="sum_only" test="(f,has,prop,hack-mox)"/>
</when>
<otherwise>
<need>(prop,dso_key)</need>
<prop id="dso_default_label_class" x="(prop,_sl_dso)"/>
<prop id="dso_default_label_name" x="(f,text,cut_nice,(prop,dso_name),25)(f,when,(f,has,(prop,dsos_offset_label)), - (prop,dsos_offset_label),)"/>
<prop id="dsos_tk_control" x="sum_only"/>
</otherwise>
</choose>
<call_job job="dso-tk"/>
</job>