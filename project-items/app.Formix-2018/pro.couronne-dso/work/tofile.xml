<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="dso-write">
<need>(prop,dso_key) (prop,isAdd)</need>
<need default="./">(prop,dsos_offset)</need>
<spirit act="open" id="dsos_spirit_tc" xml="(file,dsos)"/>
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,dsos_offset),/)">
<prop id="offset2" x="(f,substring,(prop,dsos_offset),0,(f,sub,(f,len,(prop,dsos_offset)),1))"/>
</when>
<otherwise>
<prop id="offset2" x="(prop,dsos_offset)"/>
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="dsos_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;dso row="(prop,dso_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsos_spirit_tc" where="(prop,dsos_offset)dso[@row='(prop,dso_key)']" attribute="objekttyp" value="(f,vob,prop,dso_objekttyp)"/>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsos_spirit_tc" where="(prop,dsos_offset)dso[@row='(prop,dso_key)']" attribute="name" value="(f,vob,prop,dso_name)"/>
<spirit act="close" flag="save pretty" id="dsos_spirit_tc"/>
</job>
