<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="appconf-write">
<need>(prop,appconf_key) (prop,isAdd)</need>
<spirit act="open" id="appconfs_spirit_tc" xml="(file,appconfs)"/>
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,appconfs_offset),/)">
<prop id="offset2" x="(f,substring,(prop,appconfs_offset),0,(f,sub,(f,len,(prop,appconfs_offset)),1))"/>
</when>
<otherwise>
<prop id="offset2" x="(prop,appconfs_offset)"/>
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="appconfs_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;appconf row="(prop,appconf_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="app" value="(f,vob,prop,appconf_app)"/>
