<ti test="(f,has,(loop,appconf_loop,@login))" type="text" x="(loop,appconf_loop,@login)"/>
<ti test="(f,not,(f,has,(loop,appconf_loop,@login)))"/>
<ti test="(f,has,(loop,appconf_loop,@rule_base))" type="text" x="(f,when,(f,has_flag,(loop,appconf_loop,@rule_base),STANDARD),STANDARD(e:s),)(f,when,(f,has_flag,(loop,appconf_loop,@rule_base),OVERWRITE_ALL),OVERWRITE_ALL(e:s),)(f,when,(f,has_flag,(loop,appconf_loop,@rule_base),OVERWRITE_SOME),OVERWRITE_SOME(e:s),)"/>
<ti test="(f,not,(f,has,(loop,appconf_loop,@rule_base)))"/>
<ti type="call_job" explain="Edit" job="appconf-edit">
<prop id="appconf_key">(loop,appconf_loop,@row)</prop>
<file id="appconfs">(file,appconfs)</file>
<prop id="appconfs_offset">(prop,appconfs_offset)</prop>
