<prop id="appconfs_where">(prop,appconfs_where)</prop>
<prop id="appconfs_return_job">(prop,appconfs_return_job)</prop>
</ti>
<ti test="(f,has,(loop,appconf_loop,@public))" type="text" x="(loop,appconf_loop,@public)"/>
<ti test="(f,not,(f,has,(loop,appconf_loop,@public)))"/>
<ti test="(f,has,(loop,appconf_loop,@apps))" type="text" x="(f,tk_sel_translate,(loop,appconf_loop,@apps),(dir,pro)app-selector-gui.xml)"/>
