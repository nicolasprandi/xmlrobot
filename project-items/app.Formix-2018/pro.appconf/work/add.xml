<?xml version="1.0" encoding="UTF-8"?><job id="appconf-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="appconf-editor"/>
<prop id="appconf_key">1</prop>
<when test="(f,not,(f,exists,prop,appconfs_offset_new_key))">
<prop id="appconfs_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,appconfs)" sort="@row" number="@row" xpath="(prop,appconfs_offset_new_key)appconf">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="appconf_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new AppConf: #(prop,appconf_key)</i>
<call_job job="appconf-write"/>
<ti align="right" x="Did add AppConf '(prop,appconf_displayname)'"/>
<choose>
<when test="(f,has,prop,post_add_script_appconf)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_appconf)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<remove type="file" id="formix-posting"/>
<remove type="file" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="appconf-see-all"/>
</otherwise>
</choose>
</job>
