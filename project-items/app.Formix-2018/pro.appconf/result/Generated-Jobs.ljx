<need>(prop,appconf_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="appconf-read" />
<prop id="isAdd">0</prop>
<call_job job="appconf-editor" />
<call_job job="appconf-write" />
<ti align="right" x="Did update AppConf '(prop,appconf_displayname)'" />
<call_job job="appconf-see-all" />
</job><job role="hidden" id="appconf-del">
<need>(prop,appconf_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="appconf-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting AppConf [ (prop,appconf_displayname) (prop,appconfs_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,appconfs)" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" />
<tp>Deleted (prop,appconf_displayname) #(prop,appconf_key)</tp>
<ti label="Did delete AppConf:" x="(f,html,bold,open)(f,html,bold,open)(prop,appconf_displayname)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="appconf-see-all" />
</job><job role="hidden" id="appconf-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new AppConf(prop,appconfs_offset_label)" />
<prop x="sum" id="appconfs_tk_control" />
</when>
<otherwise>
<need>(prop,appconf_key)</need>
<prop id="label" x="AppConf [(prop,appconf_displayname)](prop,appconfs_offset_label)" />
<prop x="sum_only" id="appconfs_tk_control" />
</otherwise>
</choose>
<call_job job="appconf-tk" />
</job><job id="appconf-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="appconf-editor" />
<prop id="appconf_key">1</prop>
<when test="(f,not,(f,exists,prop,appconfs_offset_new_key))">
<prop id="appconfs_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,appconfs)" sort="@row" number="@row" xpath="(prop,appconfs_offset_new_key)appconf">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="appconf_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new AppConf: #(prop,appconf_key)</i>
<call_job job="appconf-write" />
<ti align="right" x="Did add AppConf '(prop,appconf_displayname)'" />
<choose>
<when test="(f,has,prop,post_add_script_appconf)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_appconf)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="file" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="appconf-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="appconf-write">
<need>(prop,appconf_key) (prop,isAdd)</need>
<spirit act="open" id="appconfs_spirit_tc" xml="(file,appconfs)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,appconfs_offset),/)">
<prop id="offset2" x="(f,substring,(prop,appconfs_offset),0,(f,sub,(f,len,(prop,appconfs_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,appconfs_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="appconfs_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;appconf row="(prop,appconf_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="app" value="(f,vob,prop,appconf_app)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="displayname" value="(f,vob,prop,appconf_displayname)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="eclipseproject" value="(f,vob,prop,appconf_eclipseproject)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="login" value="(f,vob,prop,appconf_login)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="public" value="(f,vob,prop,appconf_public)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="apps" value="(f,vob,prop,appconf_apps)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="desc" value="(f,vob,prop,appconf_desc)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="rule_base" value="(f,vob,prop,appconf_rule_base)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="project_dir" value="(f,vob,prop,appconf_project_dir)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="clone_project_dir_on" value="(f,vob,prop,appconf_clone_project_dir_on)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="css" value="(f,vob,prop,appconf_css)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="firstjob" value="(f,vob,prop,appconf_firstjob)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="header" value="(f,vob,prop,appconf_header)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="header_job" value="(f,vob,prop,appconf_header_job)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="footer" value="(f,vob,prop,appconf_footer)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="footer_job" value="(f,vob,prop,appconf_footer_job)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="trace_on" value="(f,vob,prop,appconf_trace_on)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="role" value="(f,vob,prop,appconf_role)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="bits" value="(f,vob,prop,appconf_bits)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_wf_bits" value="(f,vob,prop,appconf_uri_wf_bits)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_wf_prov_pro" value="(f,vob,prop,appconf_uri_wf_prov_pro)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_rf_bits" value="(f,vob,prop,appconf_uri_rf_bits)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_rf_prov_app" value="(f,vob,prop,appconf_uri_rf_prov_app)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_rf_prov_pro" value="(f,vob,prop,appconf_uri_rf_prov_pro)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_wd_bits" value="(f,vob,prop,appconf_uri_wd_bits)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_wd_prov_pro" value="(f,vob,prop,appconf_uri_wd_prov_pro)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_rd_bits" value="(f,vob,prop,appconf_uri_rd_bits)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_rd_prov_app" value="(f,vob,prop,appconf_uri_rd_prov_app)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="appconfs_spirit_tc" where="(prop,appconfs_offset)appconf[@row='(prop,appconf_key)']" attribute="uri_rd_prov_pro" value="(f,vob,prop,appconf_uri_rd_prov_pro)" />
<spirit act="close" flag="save pretty" id="appconfs_spirit_tc" />
</job></jobs>
