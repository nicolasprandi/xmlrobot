<?xml version="1.0" encoding="UTF-8"?><job id="sqli-add" level="ws" role="hidden">
    <prop id="isAdd">1</prop>
    <need default="1">(prop,do_return_job)</need>
    <call_job job="sqli-editor"/>
    <prop id="sqli_key">1</prop>
    <when test="(f,not,(f,exists,prop,sqlis_offset_new_key))">
        <prop id="sqlis_offset_new_key">//</prop>
    </when>
    <loop id="max" limit="1" flag="back" xml="(file,sqlis)" sort="@row" number="@row" xpath="(prop,sqlis_offset_new_key)sqli">
        <trace>max key=(loop,max,@row)</trace>
        <trace>i=(loop,max,#i)</trace>
        <prop id="sqli_key">(f,add,(loop,max,@row),1)</prop>
    </loop>
    <i>Generated Key for new (prop,_sl_sqli): #(prop,sqli_key)</i>
    <call_job job="sqli-write"/>
    <ti_break class_table="tabNavigator"/>
    <ti type="rec">
        <ti align="right" x="+ (prop,_sl_sqli) '(prop,sqli_name)'"/>
    </ti>
    <choose>
        <when test="(f,has,prop,post_add_script_sqli)">
            <file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
            <prop id="formix-posting-code" x="(f,random_text,16)"/>
            <create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_sqli)</create_file>
            <include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
            <delete file="(file,formix-posting)"/>
            <remove type="file" id="formix-posting"/>
            <remove type="prop" id="formix-posting-code"/>
        </when>
        <otherwise>
            <call_job job="sqli_event_post_update"/>
        </otherwise>
    </choose>
</job>
