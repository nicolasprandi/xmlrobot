<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="rezpic-write">
<need>(prop,rezpic_key) (prop,isAdd)</need>
<spirit act="open" id="rezpics_spirit_tc" xml="(file,rezpics)"/>
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,rezpics_offset),/)">
<prop id="offset2" x="(f,substring,(prop,rezpics_offset),0,(f,sub,(f,len,(prop,rezpics_offset)),1))"/>
</when>
<otherwise>
<prop id="offset2" x="(prop,rezpics_offset)"/>
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="rezpics_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;rezpic row="(prop,rezpic_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<file id="jack-in" x="(file,rezpic_pic)"/>
<prop id="jack-result-prop" x="(f,random_text,5)"/>
<prop id="jack-result-did-prop" x="(f,random_text,5)"/>
<call_service job="go-jack-do-file" flag="silent">
<file id="jack-in" x="(file,jack-in)"/>
<prop id="jack-result-prop" x="(prop,jack-result-prop)"/>
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)"/>
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)"/>
<spirit act="xml_update" how="set_attribute" flag="remove" id="rezpics_spirit_tc" where="(prop,rezpics_offset)rezpic[@row='(prop,rezpic_key)']" attribute="pic" value="(prop,jack-result)"/>
<spirit act="xml_update" how="set_attribute" flag="remove" id="rezpics_spirit_tc" where="(prop,rezpics_offset)rezpic[@row='(prop,rezpic_key)']" attribute="bez" value="(f,vob,prop,rezpic_bez)"/>
<spirit act="xml_update" how="set_attribute" flag="remove" id="rezpics_spirit_tc" where="(prop,rezpics_offset)rezpic[@row='(prop,rezpic_key)']" attribute="max_x_px" value="(f,vob,prop,rezpic_max_x_px)"/>
<spirit act="xml_update" how="set_attribute" flag="remove" id="rezpics_spirit_tc" where="(prop,rezpics_offset)rezpic[@row='(prop,rezpic_key)']" attribute="max_y_px" value="(f,vob,prop,rezpic_max_y_px)"/>
<spirit act="close" flag="save pretty" id="rezpics_spirit_tc"/>
</job>
