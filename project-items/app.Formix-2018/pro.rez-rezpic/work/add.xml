<?xml version="1.0" encoding="UTF-8"?><job id="rezpic-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="rezpic-editor"/>
<prop id="rezpic_key">1</prop>
<when test="(f,not,(f,exists,prop,rezpics_offset_new_key))">
<prop id="rezpics_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,rezpics)" sort="@row" number="@row" xpath="(prop,rezpics_offset_new_key)rezpic">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="rezpic_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Rezept-Pic: #(prop,rezpic_key)</i>
<call_job job="rezpic-write"/>
<ti align="right" x="Did add Rezept-Pic '(f,text,cut_nice,(prop,rezpic_bez),20)'"/>
<choose>
<when test="(f,has,prop,post_add_script_rezpic)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_rezpic)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="rez-see"/>
</otherwise>
</choose>
</job>
