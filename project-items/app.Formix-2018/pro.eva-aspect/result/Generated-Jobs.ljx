</job><job role="hidden" id="aspect-see-more">
<need>(prop,aspect_key)</need>
<call_job job="aspect-read" />
<prop x="print_only print_with_tips print_all_fields" id="aspects_tk_control" />
<prop id="label" x="(f,html,bold,open)(prop,aspect_titel)(f,html,bold,close)(f,when,(f,has,(prop,aspects_offset_label)), - (prop,aspects_offset_label),)" />
<call_job job="aspect-tk" />
<ti_hr />
