</job><job role="hidden" id="aspect-edit">
<need>(prop,aspect_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="aspect-read" />
<prop id="isAdd">0</prop>
<call_job job="aspect-editor" />
<call_job job="aspect-write" />
<ti align="right" x="Did update Aspect '(prop,aspect_titel)'" />
<call_job job="aspect-see-all" />
</job><job role="hidden" id="aspect-del">
<need>(prop,aspect_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="aspect-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Aspect [ (prop,aspect_titel) (prop,aspects_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,aspects)" where="(prop,aspects_offset)aspect[@row='(prop,aspect_key)']" />
<tp>Deleted (prop,aspect_titel) #(prop,aspect_key)</tp>
<ti label="Did delete Aspect:" x="(f,html,bold,open)(f,html,bold,open)(prop,aspect_titel)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="aspect-see-all" />
</job><job role="hidden" id="aspect-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Aspect(prop,aspects_offset_label)" />
<prop x="sum" id="aspects_tk_control" />
</when>
<otherwise>
<need>(prop,aspect_key)</need>
<prop id="label" x="Aspect [(prop,aspect_titel)](prop,aspects_offset_label)" />
<prop x="sum_only" id="aspects_tk_control" />
</otherwise>
</choose>
<call_job job="aspect-tk" />
</job><job id="aspect-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="aspect-editor" />
<prop id="aspect_key">1</prop>
<when test="(f,not,(f,exists,prop,aspects_offset_new_key))">
<prop id="aspects_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,aspects)" sort="@row" number="@row" xpath="(prop,aspects_offset_new_key)aspect">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="aspect_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Aspect: #(prop,aspect_key)</i>
<call_job job="aspect-write" />
<ti align="right" x="Did add Aspect '(prop,aspect_titel)'" />
<choose>
<when test="(f,has,prop,post_add_script_aspect)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_aspect)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="aspect-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="aspect-write">
<need>(prop,aspect_key) (prop,isAdd)</need>
<spirit act="open" id="aspects_spirit_tc" xml="(file,aspects)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,aspects_offset),/)">
<prop id="offset2" x="(f,substring,(prop,aspects_offset),0,(f,sub,(f,len,(prop,aspects_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,aspects_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="aspects_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;aspect row="(prop,aspect_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="aspects_spirit_tc" where="(prop,aspects_offset)aspect[@row='(prop,aspect_key)']" attribute="titel" value="(f,vob,prop,aspect_titel)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="aspects_spirit_tc" where="(prop,aspects_offset)aspect[@row='(prop,aspect_key)']" attribute="explain" value="(f,vob,prop,aspect_explain)" />
<spirit act="close" flag="save pretty" id="aspects_spirit_tc" />
</job></jobs>
