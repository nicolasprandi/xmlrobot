</job><job role="hidden" id="search-edit">
<need>(prop,search_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="search-read" />
<prop id="isAdd">0</prop>
<call_job job="search-editor" />
<call_job job="search-write" />
<ti align="right" x="Did update Search '(prop,search_techname)'" />
<call_job job="search-see" />
</job><job role="hidden" id="search-del">
<need>(prop,search_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="search-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Search [ (prop,search_techname) (prop,searches_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,searches)" where="(prop,searches_offset)search[@row='(prop,search_key)']" />
<tp>Deleted (prop,search_techname) #(prop,search_key)</tp>
<ti label="Did delete Search:" x="(f,html,bold,open)(f,html,bold,open)(prop,search_techname)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="search-see-all" />
</job><job role="hidden" id="search-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Search(prop,searches_offset_label)" />
<prop x="sum" id="searches_tk_control" />
</when>
<otherwise>
<need>(prop,search_key)</need>
<prop id="label" x="Search [(prop,search_techname)](prop,searches_offset_label)" />
<prop x="sum_only" id="searches_tk_control" />
</otherwise>
</choose>
<call_job job="search-tk" />
</job><job id="search-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="search-editor" />
<prop id="search_key">1</prop>
<when test="(f,not,(f,exists,prop,searches_offset_new_key))">
<prop id="searches_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,searches)" sort="@row" number="@row" xpath="(prop,searches_offset_new_key)search">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="search_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Search: #(prop,search_key)</i>
<call_job job="search-write" />
<ti align="right" x="Did add Search '(prop,search_techname)'" />
<choose>
<when test="(f,has,prop,post_add_script_search)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_search)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="search-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="search-write">
<need>(prop,search_key) (prop,isAdd)</need>
<spirit act="open" id="searches_spirit_tc" xml="(file,searches)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,searches_offset),/)">
<prop id="offset2" x="(f,substring,(prop,searches_offset),0,(f,sub,(f,len,(prop,searches_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,searches_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="searches_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;search row="(prop,search_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="searches_spirit_tc" where="(prop,searches_offset)search[@row='(prop,search_key)']" attribute="search" value="(f,vob,prop,search_search)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="searches_spirit_tc" where="(prop,searches_offset)search[@row='(prop,search_key)']" attribute="type" value="(f,vob,prop,search_type)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="searches_spirit_tc" where="(prop,searches_offset)search[@row='(prop,search_key)']" attribute="desc" value="(f,vob,prop,search_desc)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="searches_spirit_tc" where="(prop,searches_offset)search[@row='(prop,search_key)']" attribute="techname" value="(f,vob,prop,search_techname)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="searches_spirit_tc" where="(prop,searches_offset)search[@row='(prop,search_key)']" attribute="before" value="(f,vob,prop,search_before)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="searches_spirit_tc" where="(prop,searches_offset)search[@row='(prop,search_key)']" attribute="after" value="(f,vob,prop,search_after)" />
<spirit act="close" flag="save pretty" id="searches_spirit_tc" />
</job></jobs>
