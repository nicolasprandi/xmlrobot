<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="search-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Search(prop,searches_offset_label)"/>
<prop x="sum" id="searches_tk_control"/>
</when>
<otherwise>
<need>(prop,search_key)</need>
<prop id="label" x="Search [(prop,search_techname)](prop,searches_offset_label)"/>
<prop x="sum_only" id="searches_tk_control"/>
</otherwise>
</choose>
<call_job job="search-tk"/>
</job>
