<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Option [ (f,text,cut_nice,(prop,opt_bez),30) (prop,opts_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,opts)" where="(prop,opts_offset)opt[@row='(prop,opt_key)']" />
<tp>Deleted (f,text,cut_nice,(prop,opt_bez),30) #(prop,opt_key)</tp>
<ti label="Did delete Option:" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,opt_bez),30)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="zut-see" />
</job><job role="hidden" id="opt-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Option(prop,opts_offset_label)" />
<prop x="sum" id="opts_tk_control" />
</when>
<otherwise>
<need>(prop,opt_key)</need>
<prop id="label" x="Option [(f,text,cut_nice,(prop,opt_bez),30)](prop,opts_offset_label)" />
<prop x="sum_only" id="opts_tk_control" />
</otherwise>
</choose>
<call_job job="opt-tk" />
</job><job id="opt-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="opt-editor" />
<prop id="opt_key">1</prop>
<when test="(f,not,(f,exists,prop,opts_offset_new_key))">
<prop id="opts_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,opts)" sort="@row" number="@row" xpath="(prop,opts_offset_new_key)opt">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="opt_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Option: #(prop,opt_key)</i>
<call_job job="opt-write" />
<ti align="right" x="Did add Option '(f,text,cut_nice,(prop,opt_bez),30)'" />
<choose>
<when test="(f,has,prop,post_add_script_opt)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_opt)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="zut-see" />
</otherwise>
</choose>
</job><job role="hidden" id="opt-write">
<need>(prop,opt_key) (prop,isAdd)</need>
<spirit act="open" id="opts_spirit_tc" xml="(file,opts)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,opts_offset),/)">
<prop id="offset2" x="(f,substring,(prop,opts_offset),0,(f,sub,(f,len,(prop,opts_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,opts_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="opts_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;opt row="(prop,opt_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="opts_spirit_tc" where="(prop,opts_offset)opt[@row='(prop,opt_key)']" attribute="bez" value="(f,vob,prop,opt_bez)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="opts_spirit_tc" where="(prop,opts_offset)opt[@row='(prop,opt_key)']" attribute="besch" value="(f,vob,prop,opt_besch)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="opts_spirit_tc" where="(prop,opts_offset)opt[@row='(prop,opt_key)']" attribute="klasse" value="(f,vob,prop,opt_klasse)" />
<spirit act="close" flag="save pretty" id="opts_spirit_tc" />
</job></jobs>
