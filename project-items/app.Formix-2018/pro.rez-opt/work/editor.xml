<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="opt-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Option(prop,opts_offset_label)"/>
<prop x="sum" id="opts_tk_control"/>
</when>
<otherwise>
<need>(prop,opt_key)</need>
<prop id="label" x="Option [(f,text,cut_nice,(prop,opt_bez),30)](prop,opts_offset_label)"/>
<prop x="sum_only" id="opts_tk_control"/>
</otherwise>
</choose>
<call_job job="opt-tk"/>
</job>
