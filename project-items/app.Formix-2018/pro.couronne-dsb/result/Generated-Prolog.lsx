<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="dsbs">(dir,pro)dsbs.xml</file>
<when test="(f,not,(f,exists_file,(file,dsbs)))">
<create_file out="(file,dsbs)">&lt;dsbs/&gt;</create_file>
<i>Created: (file,dsbs)</i>
</when>
<prop id="dsbs_offset">./</prop>
<prop id="dsbs_offset_label"/>
<prop id="dsbs_offset_new_key">//</prop>
<prop id="dsbs_sort_attribute"/>
<prop id="dsbs_sort_number"/>
<prop id="dsbs_sort_ignore_case"/>
<prop id="dsbs_sort_desc"/>
<prop id="dsbs_where"/>
<prop id="dsbs_return_job">dsb-see-all</prop>
</prolog>
