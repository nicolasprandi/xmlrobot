<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="dsb-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="dsb_default_label_class" x="+ (prop,_sl_dsb)"/>
<prop id="dsb_default_label_name" x="(f,when,(f,has,(prop,dsbs_offset_label)), | (prop,dsbs_offset_label),)"/>
<prop id="dsbs_tk_control" x="sum"/>
</when>
<otherwise>
<need>(prop,dsb_key)</need>
<prop id="dsb_default_label_class" x="(prop,_sl_dsb)"/>
<prop id="dsb_default_label_name" x="(f,text,cut_nice,(prop,dsb_name),50)(f,when,(f,has,(prop,dsbs_offset_label)), - (prop,dsbs_offset_label),)"/>
<prop id="dsbs_tk_control" x="sum_only"/>
</otherwise>
</choose>
<call_job job="dsb-tk"/>
</job>
