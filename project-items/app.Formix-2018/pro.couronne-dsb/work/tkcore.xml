<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="dsb-tk">
<call_job job="tr_dsb"/>
<need default="">(prop,dsbs_tk_control)</need>
<when test="(f,has_flag,(prop,dsbs_tk_control),print_only)">
<choose>
<when test="(f,has_flag,(prop,dsbs_tk_control),print_all_fields)">
<ti label="(prop,dsb_default_label_class) (prop,dsb_default_label_name)"/>
</when>
<otherwise>
<ti label=" " x="(f,html,b,o)(prop,dsb_default_label_class)(f,html,b,c)"/>
</otherwise>
</choose>
</when>
<when test="(f,not,(f,has_flag,(prop,dsbs_tk_control),print_only))">
<when test="(f,not,(prop,isAdd))">
<tk label="(prop,_dsb_from_l)" id="dsb_dso_from_row" x="" test_first="1" tip="(prop,_dsb_from_t)" html_type ="number" html_inputmode="numeric"   cols="10" flag=" "/>
<tk label="(prop,_dsb_to_l)" id="dsb_dso_to_row" x="" test_first="1" tip="(prop,_dsb_to_t)" html_type ="number" html_inputmode="numeric" cols="10" flag=" "/>
</when>
</when>
<tk label="(f,when,(f,has_flag,(prop,dsbs_tk_control),print_only),,(prop,dsb_default_label_class)(f,when,(f,has,prop,dsb_default_label_name), (prop,dsb_default_label_name),))" tip="(prop,_dsb_t)" tk_id="12" flag="(prop,dsbs_tk_control) wrap ">
<tk label="(prop,_dsb_btyp_l)" id="dsb_beztyp" x="" test_first="1" tip="(prop,_dsb_btyp_t)" type="sel" follow_job="hook_dsb_follow_beztyp" flag=" " xml="(file,pdi-sel-bez)"/>
<tk label="(prop,_dsb_from_l)" id="dsb_dso_from_row" x="" test_first="1" tip="(prop,_dsb_from_t)" html_type ="number" html_inputmode="numeric"   cols="10" flag=" "/>
<tk label="(prop,_dsb_to_l)" id="dsb_dso_to_row" x="" test_first="1" tip="(prop,_dsb_to_t)" html_type ="number" html_inputmode="numeric" cols="10" flag=" "/>
<tk label="(prop,_dsb_doku_l)" x="(prop,_dsb_doku_l)" test_first="0" type="msg" flag=" "/>
<tk label="(prop,_dsb_name_l)" id="dsb_name" x="" test_first="1" tip="(prop,_dsb_name_t)" type="text" cols="40" flag=" "/>
</tk>
</job>