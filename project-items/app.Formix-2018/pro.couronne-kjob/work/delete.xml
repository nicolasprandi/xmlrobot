<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="kjob-del">
<need>(prop,kjob_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="kjob-read"/>
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting (prop,_sl_kjob) [ (f,text,cut_nice,(prop,kjob_id),30) (prop,kjobs_offset_label)] ?" x="Do you really want to delete that?&#10;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()"/>
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,kjobs)" where="(prop,kjobs_offset)kjob[@row='(prop,kjob_key)']"/>
<tp>Deleted (f,text,cut_nice,(prop,kjob_id),30) #(prop,kjob_key)</tp>
<ti label="- (prop,_sl_kjob):" x="(f,html,bold,open)(f,html,bold,open)(f,text,cut_nice,(prop,kjob_id),30)(f,html,bold,close)(f,html,bold,close)"/>
<ti_hr/>
<when test="(prop,do_return_job)"/>
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="kjob-see-all"/>
</job>
