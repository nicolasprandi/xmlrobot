<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="dsi-write">
<need>(prop,dsi_key) (prop,isAdd)</need>
<need default="./">(prop,dsis_offset)</need>
<spirit act="open" id="dsis_spirit_tc" xml="(file,dsis)"/>
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,dsis_offset),/)">
<prop id="offset2" x="(f,substring,(prop,dsis_offset),0,(f,sub,(f,len,(prop,dsis_offset)),1))"/>
</when>
<otherwise>
<prop id="offset2" x="(prop,dsis_offset)"/>
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="dsis_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;dsi row="(prop,dsi_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsis_spirit_tc" where="(prop,dsis_offset)dsi[@row='(prop,dsi_key)']" attribute="name" value="(f,vob,prop,dsi_name)"/>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsis_spirit_tc" where="(prop,dsis_offset)dsi[@row='(prop,dsi_key)']" attribute="docu" value="(f,vob,prop,dsi_docu)"/>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsis_spirit_tc" where="(prop,dsis_offset)dsi[@row='(prop,dsi_key)']" attribute="cat" value="(f,vob,prop,dsi_cat)"/>
<spirit act="xml_update" how="set_attribute" flag="remove" id="dsis_spirit_tc" where="(prop,dsis_offset)dsi[@row='(prop,dsi_key)']" attribute="status" value="(f,vob,prop,dsi_status)"/>
<spirit act="close" flag="save pretty" id="dsis_spirit_tc"/>
</job>
