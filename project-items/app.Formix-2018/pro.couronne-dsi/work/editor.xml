<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="dsi-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="dsi_default_label_class" x="+ (prop,_sl_dsi)"/>
<prop id="dsi_default_label_name" x="(f,when,(f,has,(prop,dsis_offset_label)), | (prop,dsis_offset_label),)"/>
<prop id="dsis_tk_control" x="sum"/>
</when>
<otherwise>
<need>(prop,dsi_key)</need>
<prop id="dsi_default_label_class" x="(prop,_sl_dsi)"/>
<prop id="dsi_default_label_name" x="(f,text,cut_nice,(prop,dsi_name),30)(f,when,(f,has,(prop,dsis_offset_label)), - (prop,dsis_offset_label),)"/>
<prop id="dsis_tk_control" x="sum_only"/>
</otherwise>
</choose>
<call_job job="dsi-tk"/>
</job>
