<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="dsi-tk">
<call_job job="tr_dsi"/>
<need default="">(prop,dsis_tk_control)</need>
<when test="(f,has_flag,(prop,dsis_tk_control),print_only)">
<choose>
<when test="(f,has_flag,(prop,dsis_tk_control),print_all_fields)">
<ti label="(prop,dsi_default_label_class) (prop,dsi_default_label_name)"/>
</when>
<otherwise>
<ti label=" " x="(f,html,b,o)(prop,dsi_default_label_class)(f,html,b,c)"/>
</otherwise>
</choose>
</when>
<tk label="(f,when,(f,has_flag,(prop,dsis_tk_control),print_only),,(prop,dsi_default_label_class)(f,when,(f,has,prop,dsi_default_label_name), (prop,dsi_default_label_name),))" tip="(prop,_dsi_t)" tk_id="13" flag="(prop,dsis_tk_control) wrap ">
<tk label="(prop,_dsi_name_l)" id="dsi_name" x="" test_first="1" tip="(prop,_dsi_name_t)" type="text" cols="30" flag=" "/>
<tk label="(prop,_dsi_docu_l)" id="dsi_docu" x="" test_first="0" tip="(prop,_dsi_docu_t)" type="textblock" cols="30" flag=" "/>
<tk label="(prop,_dsi_cat_l)" id="dsi_cat" x="" test_first="0" tip="(prop,_dsi_cat_t)" type="text" cols="30" flag=" "/>
<tk label="(prop,_dsi_stat_l)" id="dsi_status" x="" test_first="0" tip="(prop,_dsi_stat_t)" type="text" cols="30" flag=" "/>
</tk>
</job>
