<?xml version="1.0" encoding="UTF-8"?><prolog>
<!--Copyright © 2015-2019 Nicolas Prandstaetter. All rights reserved.-->
<file id="pgas">(dir,pro)pgas.xml</file>
<when test="(f,not,(f,exists_file,(file,pgas)))">
<create_file out="(file,pgas)">&lt;pgas/&gt;</create_file>
<i>Created: (file,pgas)</i>
</when>
<prop id="pgas_offset">./</prop>
<prop id="pgas_offset_label"/>
<prop id="pgas_offset_new_key">//</prop>
<prop id="pgas_sort_attribute"/>
<prop id="pgas_sort_number"/>
<prop id="pgas_sort_ignore_case"/>
<prop id="pgas_sort_desc"/>
<prop id="pgas_where"/>
<prop id="pgas_return_job">pga-see-all</prop>
</prolog>
