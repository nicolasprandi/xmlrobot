<?xml version="1.0" encoding="UTF-8"?><job id="pga-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<prop id="parent-objekttyp">(f,xpath,(file,pgas),pgo[@row=(prop,pgo_key)],@objekttyp)</prop>
<file id="pdi-sel-attr">(dir,repo)ot-(prop,parent-objekttyp)-asel-(prop,tip-term-class).xml</file>
<remove id="parent-objekttyp" type="prop"/>
<call_job job="pga-editor"/>
<prop id="pga_key">1</prop>
<when test="(f,not,(f,exists,prop,pgas_offset_new_key))">
<prop id="pgas_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,pgas)" sort="@row" number="@row" xpath="(prop,pgas_offset_new_key)pga">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="pga_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new (prop,_sl_pga): #(prop,pga_key)</i>
<call_job job="pga-write"/>
<ti_break class_table="tabNavigator"/>
<ti type="rec">
<ti align="right" x="+ (prop,_sl_pga) '(f,tk_sel_translate,(prop,pga_attributtyp),(file,pdi-sel-attr))'"/>
</ti>
<choose>
<when test="(f,has,prop,post_add_script_pga)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_pga)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="pgo-see"/>
</otherwise>
</choose>
</job>