<?xml version="1.0" encoding="UTF-8"?><job id="pgo-see-all" level="ws" role="hidden">
    <need default="">(prop,pgos_sort_attribute)</need>
    <need default="">(prop,pgos_sort_number)</need>
    <need default="">(prop,pgos_sort_ignore_case)</need>
    <need default="">(prop,pgos_sort_desc)</need>
    <need default="">(prop,pgos_where)</need>
    <need default="">(prop,pgos_offset_label)</need>
    <need default="./">(prop,pgos_offset)</need>
    <need default="">(prop,pgos_return_job)</need>
    <need default="//">(prop,pgos_offset_new_key)</need>
    <need default="0">(prop,pgos_no_header)</need>
    <call_job job="tr_pgo"/>
    <try_catch>
        <try>
            <call_job job="hook_pgo_view_begin"/>
        </try>
        <catch>
            <ti label="Hook must be implemented: pgo-view: begin.0">
                <ti> hook_job=hook_pgo_view_begin hook=begin page=view station=0 object=pgo</ti>
            </ti>
            <tk type="msg" x="You have to implement the hook!"/>
            <throw_again/>
        </catch>
    </try_catch>
    <prop id="nothing">(f,not,(prop,pgos_no_header))</prop>
    <loop missing_strategy="empty" id="pgo_loop" xml="(file,pgos)" xpath="(prop,pgos_offset)pgo(prop,pgos_where)" sort="(prop,pgos_sort_attribute)" number="(prop,pgos_sort_number)" ignore_case="(prop,pgos_sort_ignore_case)" desc="(prop,pgos_sort_desc)">
        <when test="(prop,nothing)">
            <when test="(f,gt,(f,len,(prop,pgos_offset_label)),0)">
                <ti label="(prop,pgos_offset_label)"/>
            </when>
            <prop id="nothing">0</prop>
        </when>
        <ti type="rec">
            <ti isFromAction="1" type="call_job" page="view" flag="button" class="fb fbAction fbActionPgoeditieren" explain="(prop,_x_edit)" job="pgo-edit">
                <prop id="greetings_from_page">view</prop>
                <prop id="greetings_from_action">editieren</prop>
                <prop page="view" id="pgo_key">(loop,pgo_loop,@row)</prop>
                <file id="pgos">(file,pgos)</file>
                <prop id="pgos_offset">(prop,pgos_offset)</prop>
                <prop id="pgos_offset_label">(prop,pgos_offset_label)</prop>
                <prop id="pgos_offset_new_key">(prop,pgos_offset_new_key)</prop>
                <prop id="pgos_sort_attribute">(prop,pgos_sort_attribute)</prop>
                <prop id="pgos_sort_number">(prop,pgos_sort_number)</prop>
                <prop id="pgos_sort_ignore_case">(prop,pgos_sort_ignore_case)</prop>
                <prop id="pgos_sort_desc">(prop,pgos_sort_desc)</prop>
                <prop id="pgos_where">(prop,pgos_where)</prop>
                <prop id="pgos_return_job">(prop,pgos_return_job)</prop>
            </ti>
            <ti flag="" type="call_job" prefix="  " explain="(f,html,bold,open)(f,tk_sel_translate,(loop,pgo_loop,@objekttyp),(dir,repo)osel-(prop,tip-term-class).xml)(f,html,bold,close)" job="pgo-see">
                <prop id="pgo_key">(loop,pgo_loop,@row)</prop>
                <file id="pgos">(file,pgos)</file>
                <prop id="pgos_offset">(prop,pgos_offset)</prop>
                <prop id="pgos_offset_label">(prop,pgos_offset_label)</prop>
                <prop id="pgos_offset_new_key">(prop,pgos_offset_new_key)</prop>
                <prop id="pgos_sort_attribute">(prop,pgos_sort_attribute)</prop>
                <prop id="pgos_sort_number">(prop,pgos_sort_number)</prop>
                <prop id="pgos_sort_ignore_case">(prop,pgos_sort_ignore_case)</prop>
                <prop id="pgos_sort_desc">(prop,pgos_sort_desc)</prop>
                <prop id="pgos_where">(prop,pgos_where)</prop>
                <prop id="pgos_return_job">(prop,pgos_return_job)</prop>
            </ti>
            <ti test="(f,has,(loop,pgo_loop,@detail))" type="textblock" x="(f,text,cut_nice,(loop,pgo_loop,@detail),26)"/>
            <ti test="(f,not,(f,has,(loop,pgo_loop,@detail)))"/>
        </ti>
    </loop>
    <when test="(prop,nothing)">
        <ti type="rec">
            <ti span="1"> </ti>
            <ti flag="wrap_word">(prop,_pgo_nothing_l)</ti>
        </ti>
    </when>
    <when test="(f,not,(f,contains,(prop,pgos_offset),node(e:o)(e:c)))">
        <ti type="rec" label=" ">
            <ti type="menu" span="10">
                <ti label=" " type="call_job" explain_nix="pgo-add" flag="button " class="fb fbAdd fbAddPgo" explain="+ (prop,_sl_pgo)" job="pgo-add">
                    <file id="pgos">(file,pgos)</file>
                    <prop id="pgos_offset">(prop,pgos_offset)</prop>
                    <prop id="pgos_offset_label">(prop,pgos_offset_label)</prop>
                    <prop id="pgos_offset_new_key">(prop,pgos_offset_new_key)</prop>
                    <prop id="pgos_sort_attribute">(prop,pgos_sort_attribute)</prop>
                    <prop id="pgos_sort_number">(prop,pgos_sort_number)</prop>
                    <prop id="pgos_sort_ignore_case">(prop,pgos_sort_ignore_case)</prop>
                    <prop id="pgos_sort_desc">(prop,pgos_sort_desc)</prop>
                    <prop id="pgos_where">(prop,pgos_where)</prop>
                    <prop id="pgos_return_job">(prop,pgos_return_job)</prop>
                </ti>
                <ti test="(f,not,(prop,nothing))" label=" " type="call_job" flag="button" class="fb fbOrg fbOrgPgo" explain="(prop,_x_organize)" job="do-org-me">
                    <file id="orga">(file,pgos)</file>
                    <prop id="orga_where">(prop,pgos_where)</prop>
                    <prop id="orga_view_loop_id">pgo_loop</prop>
                    <prop id="orga_finished_job">ready-and-done-pgo</prop>
                    <prop id="orga_offset">(prop,pgos_offset)</prop>
                    <prop id="orga_offset_label">(prop,pgos_offset_label)</prop>
                    <prop id="orga_offset_new_key">(prop,pgos_offset_new_key)</prop>
                    <prop id="orga_segment_plural">pgos</prop>
                    <prop id="orga_segment_singular">pgo</prop>
                    <prop id="orga_segment_plural_label">(prop,_pl_pgo)</prop>
                    <prop id="orga_segment_singular_label">(prop,_sl_pgo)</prop>
                    <prop id="orga_sort_attribute">(prop,pgos_sort_attribute)</prop>
                    <prop id="orga_sort_number">(prop,pgos_sort_number)</prop>
                    <prop id="orga_where">(prop,pgos_where)</prop>
                    <prop id="orga_name_expression_loop">()(f,tk_sel_translate,(loop,pgo_loop,@objekttyp),(dir,repo)osel-(prop,tip-term-class).xml)()</prop>
                    <prop id="orga_desc_expression_loop">()()</prop>
                    <prop id="orga_tr_job">tr_pgo</prop>
                </ti>
            </ti>
        </ti>
    </when>
    <when test="(f,has_flag,debug trace all,(f,interpreter,level))">
        <ti_hr/>
        <ti label="Debug Information">
            <ti label="File:" type="file">(file,pgos)</ti>
            <ti label="Xml-Offset:" test="(f,gt_num,(f,len,(prop,pgos_offset)),0)">(prop,pgos_offset)</ti>
        </ti>
    </when>
    <try_catch>
        <try>
            <call_job job="hook_pgo_view_end"/>
        </try>
        <catch>
            <ti label="Hook must be implemented: pgo-view: end.0">
                <ti> hook_job=hook_pgo_view_end hook=end page=view station=0 object=pgo</ti>
            </ti>
            <tk type="msg" x="You have to implement the hook!"/>
            <throw_again/>
        </catch>
    </try_catch>
</job>
