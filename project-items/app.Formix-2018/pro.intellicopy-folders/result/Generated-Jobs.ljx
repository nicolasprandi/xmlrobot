</job><job role="hidden" id="folder-see-more">
<need>(prop,folder_key)</need>
<call_job job="folder-read" />
<prop x="print_only print_with_tips print_all_fields" id="folders_tk_control" />
<prop id="label" x="(f,html,bold,open)(prop,folder_name)(f,html,bold,close)(f,when,(f,has,(prop,folders_offset_label)), - (prop,folders_offset_label),)" />
<call_job job="folder-tk" />
<ti_hr />
<ti type="rec" test="(f,role,user)">
<ti type="call_job" explain="[ Edit ]" job="folder-edit">
<prop id="folder_key">(prop,folder_key)</prop>
<file id="folders">(file,folders)</file>
<prop id="folders_offset">(prop,folders_offset)</prop>
<prop id="folders_offset_label">(prop,folders_offset_label)</prop>
<prop id="folders_offset_new_key">(prop,folders_offset_new_key)</prop>
<prop id="folders_sort_attribute">(prop,folders_sort_attribute)</prop>
<prop id="folders_sort_number">(prop,folders_sort_number)</prop>
