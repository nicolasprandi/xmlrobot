</when>
<ti type="rec" xlabel=" ">
<ti x=" " />
<ti x="From Folder" />
<ti x="To Folder" />
<ti />
<ti x=" " />
</ti>
<prop id="nothing">0</prop>
</when>
<dir flag="cool" z="b" id="folder_from_temp_var_formix" x="(loop,folder_loop,@from)" />
<unescape id="folder_from_temp_var_formix" type="dir" />
<translate id="folder_from_temp_var_formix" type="dir" />
<dir flag="cool" z="b" id="folder_to_temp_var_formix" x="(loop,folder_loop,@to)" />
<unescape id="folder_to_temp_var_formix" type="dir" />
<translate id="folder_to_temp_var_formix" type="dir" />
<ti type="rec">
