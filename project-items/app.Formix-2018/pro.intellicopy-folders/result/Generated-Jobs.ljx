</job><job role="hidden" id="folder-edit">
<need>(prop,folder_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="folder-read" />
<prop id="isAdd">0</prop>
<call_job job="folder-editor" />
<call_job job="folder-write" />
<ti align="right" x="Did update Folder '(prop,folder_name)'" />
<call_job job="folder-see-all" />
</job><job role="hidden" id="folder-del">
<need>(prop,folder_key)</need>
<need default="1">(prop,do_return_job)</need>
<call_job job="folder-read" />
<tk type="accept" id="delete-it-1" label_accept="Delete" label_decline="Forget it" width="300" height="150" label="Sure about deleting Folder [ (prop,folder_name) (prop,folders_offset_label)] ?" x="Do you really want to delete that?&#xA;()If you are not sure, make a backup of the ()project.">
<q id="delete-it-2" label="()Yes, I know that the record will be gone forever()" />
</tk>
<choose>
<when test="(f,and,(prop,delete-it-1),(prop,delete-it-2))">
<xml_update how="remove" what="(file,folders)" where="(prop,folders_offset)folder[@row='(prop,folder_key)']" />
<tp>Deleted (prop,folder_name) #(prop,folder_key)</tp>
<ti label="Did delete Folder:" x="(f,html,bold,open)(f,html,bold,open)(prop,folder_name)(f,html,bold,close)(f,html,bold,close)" />
<ti_hr />
<when test="(prop,do_return_job)" />
</when>
<otherwise>
<tp>No delete performed.</tp>
<ti>No delete performed.</ti>
</otherwise>
</choose>
<call_job job="folder-see-all" />
</job><job role="hidden" id="folder-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Folder(prop,folders_offset_label)" />
<prop x="sum" id="folders_tk_control" />
</when>
<otherwise>
<need>(prop,folder_key)</need>
<prop id="label" x="Folder [(prop,folder_name)](prop,folders_offset_label)" />
<prop x="sum_only" id="folders_tk_control" />
</otherwise>
</choose>
<call_job job="folder-tk" />
</job><job id="folder-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="folder-editor" />
<prop id="folder_key">1</prop>
<when test="(f,not,(f,exists,prop,folders_offset_new_key))">
<prop id="folders_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,folders)" sort="@row" number="@row" xpath="(prop,folders_offset_new_key)folder">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="folder_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Folder: #(prop,folder_key)</i>
<call_job job="folder-write" />
<ti align="right" x="Did add Folder '(prop,folder_name)'" />
<choose>
<when test="(f,has,prop,post_add_script_folder)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)" />
<prop id="formix-posting-code" x="(f,random_text,16)" />
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_folder)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)" />
<delete file="(file,formix-posting)" />
<remove type="file" id="formix-posting" />
<remove type="prop" id="formix-posting-code" />
</when>
<otherwise>
<call_job job="folder-see-all" />
</otherwise>
</choose>
</job><job role="hidden" id="folder-write">
<need>(prop,folder_key) (prop,isAdd)</need>
<spirit act="open" id="folders_spirit_tc" xml="(file,folders)" />
<when test="(prop,isAdd)">
<choose>
<when test="(f,ends_with,(prop,folders_offset),/)">
<prop id="offset2" x="(f,substring,(prop,folders_offset),0,(f,sub,(f,len,(prop,folders_offset)),1))" />
</when>
<otherwise>
<prop id="offset2" x="(prop,folders_offset)" />
</otherwise>
</choose>
<spirit act="xml_update" how="insert_in" id="folders_spirit_tc" where="(prop,offset2)">
<inline attribute="with">&lt;folder row="(prop,folder_key)" /&gt;</inline>
</spirit>
<i>Added a new record</i>
</when>
<dir id="jack-in" x="(dir,folder_from)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-dir" flag="silent">
<dir id="jack-in" x="(dir,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="folders_spirit_tc" where="(prop,folders_offset)folder[@row=(f,xpath_string,(prop,folder_key))]" attribute="from" value="(prop,jack-result)" />
<dir id="jack-in" x="(dir,folder_to)" />
<prop id="jack-result-prop" x="(f,random_text,5)" />
<prop id="jack-result-did-prop" x="(f,random_text,5)" />
<call_service job="go-jack-do-dir" flag="silent">
<dir id="jack-in" x="(dir,jack-in)" />
<prop id="jack-result-prop" x="(prop,jack-result-prop)" />
<prop id="jack-result-did-prop" x="(prop,jack-result-did-prop)" />
</call_service>
<global act="get" as_id="jack-result" id="(prop,jack-result-prop)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="folders_spirit_tc" where="(prop,folders_offset)folder[@row=(f,xpath_string,(prop,folder_key))]" attribute="to" value="(prop,jack-result)" />
<spirit act="xml_update" how="set_attribute" flag="remove" id="folders_spirit_tc" where="(prop,folders_offset)folder[@row='(prop,folder_key)']" attribute="name" value="(f,vob,prop,folder_name)" />
<spirit act="close" flag="save pretty" id="folders_spirit_tc" />
</job></jobs>
