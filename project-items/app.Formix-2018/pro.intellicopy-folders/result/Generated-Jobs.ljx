<call_job job="prolog" /><job role="hidden" id="folder-tk">
<need default="">(prop,folders_tk_control)</need>
<need default="">(prop,label)</need>
<tk label="(prop,label)" tip="Ein Rezept ist ein Beschreibung eines Kochvorganges dervin einem Endresultat muendet. &#xA;Zum einen gibt es Grund-Zutaten fuer das gesamte Rezept. &#xA;Weiters kann ein Rezept in Teilprodukte gegliedert werden - diese werden Komponenten genannt;&#xA;Innerhalb jeder Komponente kann aus den Grund-Zutaten auswgewaet werden um diese zu verarbeiten. ie Verarbeitungsschritte &#xA;Wwerden dokumentiert. " flag="(prop,folders_tk_control) wrap ">
<tk label="From Folder" id="folder_from" x="" test_first="1" tip="Source" type="dir" flag=" nono " />
<tk label="To Folder" id="folder_to" x="" test_first="1" tip="Target" type="dir" flag=" nono " />
<tk label="Name" id="folder_name" x="" test_first="1" type="text" flag=" " />
</tk>
</job><job id="folder-see-all" level="ws" role="hidden" tip="Lists all Folders">
<prop id="nothing">1</prop>
<loop missing_strategy="empty" id="folder_loop" xml="(file,folders)" xpath="(prop,folders_offset)folder(prop,folders_where)" sort="(prop,folders_sort_attribute)" number="(prop,folders_sort_number)" ignore_case="(prop,folders_sort_ignore_case)" desc="(prop,folders_sort_desc)">
<when test="(prop,nothing)">
<ti>
<ti />
</ti>
<when test="(f,gt,(f,len,(prop,folders_offset_label)),0)">
