<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="bit-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="label" x="Add a new Bit(prop,bits_offset_label)"/>
<prop x="sum" id="bits_tk_control"/>
</when>
<otherwise>
<need>(prop,bit_key)</need>
<prop id="label" x="Bit [(prop,bit_bit)](prop,bits_offset_label)"/>
<prop x="sum_only" id="bits_tk_control"/>
</otherwise>
</choose>
<call_job job="bit-tk"/>
</job>
