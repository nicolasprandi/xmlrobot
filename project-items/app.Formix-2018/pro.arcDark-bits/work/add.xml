<?xml version="1.0" encoding="UTF-8"?><job id="bit-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="bit-editor"/>
<prop id="bit_key">1</prop>
<when test="(f,not,(f,exists,prop,bits_offset_new_key))">
<prop id="bits_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,bits)" sort="@row" number="@row" xpath="(prop,bits_offset_new_key)bit">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="bit_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Bit: #(prop,bit_key)</i>
<call_job job="bit-write"/>
<ti align="right" x="Did add Bit '(prop,bit_bit)'"/>
<choose>
<when test="(f,has,prop,post_add_script_bit)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_bit)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="bit-see-all"/>
</otherwise>
</choose>
</job>
