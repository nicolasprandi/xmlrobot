<?xml version="1.0" encoding="UTF-8"?><job role="hidden" id="zblock-editor">
<need>(prop,isAdd)</need>
<choose>
<when test="(prop,isAdd)">
<prop id="zblock_default_label" x="+ ZelixBlock(prop,zblocks_offset_label)"/>
<prop x="sum" id="zblocks_tk_control"/>
</when>
<otherwise>
<need>(prop,zblock_key)</need>
<prop id="zblock_default_label" x="ZelixBlock [(prop,zblock_titel)](prop,zblocks_offset_label)"/>
<prop x="sum_only" id="zblocks_tk_control"/>
</otherwise>
</choose>
<call_job job="zblock-tk"/>
</job>
