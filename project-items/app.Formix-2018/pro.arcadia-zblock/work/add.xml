<?xml version="1.0" encoding="UTF-8"?><job id="zblock-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="zblock-editor"/>
<prop id="zblock_key">1</prop>
<when test="(f,not,(f,exists,prop,zblocks_offset_new_key))">
<prop id="zblocks_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,zblocks)" sort="@row" number="@row" xpath="(prop,zblocks_offset_new_key)zblock">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="zblock_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new ZelixBlock: #(prop,zblock_key)</i>
<call_job job="zblock-write"/>
<ti align="right" x="+ ZelixBlock '(prop,zblock_titel)'"/>
<choose>
<when test="(f,has,prop,post_add_script_zblock)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_zblock)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="zblock-see-all"/>
</otherwise>
</choose>
</job>
