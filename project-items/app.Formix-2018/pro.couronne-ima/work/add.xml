<?xml version="1.0" encoding="UTF-8"?><job id="ima-add" level="ws" role="hidden">
x<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="ima-editor"/>
<prop id="ima_key">1</prop>
<when test="(f,not,(f,exists,prop,imas_offset_new_key))">
<prop id="imas_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,imas)" sort="@row" number="@row" xpath="(prop,imas_offset_new_key)ima">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="ima_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new Statement: #(prop,ima_key)</i>
<call_job job="ima-write"/>
<ti_break class_table="tabNavigator"/>
<ti type="rec">
<ti align="right" x="+ Statement '(f,text,cut_nice,(prop,ima_cmd),100)'"/>
</ti>
<choose>
<when test="(f,has,prop,post_add_script_ima)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_ima)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="imp-see"/>
</otherwise>
</choose>
</job>
