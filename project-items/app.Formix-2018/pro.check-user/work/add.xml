<?xml version="1.0" encoding="UTF-8"?><job id="user-add" level="ws" role="hidden">
<prop id="isAdd">1</prop>
<need default="1">(prop,do_return_job)</need>
<call_job job="user-editor"/>
<prop id="user_key">1</prop>
<when test="(f,not,(f,exists,prop,users_offset_new_key))">
<prop id="users_offset_new_key">//</prop>
</when>
<loop id="max" limit="1" flag="back" xml="(file,users)" sort="@row" number="@row" xpath="(prop,users_offset_new_key)user">
<trace>max key=(loop,max,@row)</trace>
<trace>i=(loop,max,#i)</trace>
<prop id="user_key">(f,add,(loop,max,@row),1)</prop>
</loop>
<i>Generated Key for new User: #(prop,user_key)</i>
<call_job job="user-write"/>
<ti align="right" x="Did add User '(prop,user_userid)'"/>
<choose>
<when test="(f,has,prop,post_add_script_user)">
<file id="formix-posting" x="(dir,temp)(f,random_text,5)"/>
<prop id="formix-posting-code" x="(f,random_text,16)"/>
<create_file file="(file,formix-posting)" code="(prop,formix-posting-code)">(prop,post_add_script_user)</create_file>
<include file="(file,formix-posting)" code="(prop,formix-posting-code)"/>
<delete file="(file,formix-posting)"/>
<remove type="file" id="formix-posting"/>
<remove type="prop" id="formix-posting-code"/>
</when>
<otherwise>
<call_job job="user-see"/>
</otherwise>
</choose>
</job>
